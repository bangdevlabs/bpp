// bpp_regalloc.bsm — RegAlloc v2: real liveness-based register allocation.
//
// Today's B3 (bpp_codegen.bsm's cg_b3_walk + each chip's _<chip>_b3_select)
// ranks local variables by total reference count and promotes the top N
// into callee-saved registers. It has no notion of WHEN a variable is
// alive — two variables that never coexist (one dies before the other is
// born) compete for the same promotion budget as if they were rivals,
// when they could safely share one physical register. Closing that gap
// needs a real liveness-based allocator: explicit control-flow graph,
// liveness dataflow, live intervals, linear-scan assignment, coalescing.
// See docs/plans/compiler_boost_roadmap.md (section F.2) for the full
// staged design and the measured evidence that motivates it (tl_bench's
// flat/oracle gap persisting after every call and accumulator shuttle is
// gone; games/rts2/rts2_combat.bsm's _combat_step needing more
// simultaneously-live registers than even the widened B3 pool provides).
//
// Stage A (this file, today): AST-to-CFG construction only. Builds an
// explicit basic-block graph per function. Pure read-only analysis —
// nothing in codegen consumes its output yet; later stages (liveness,
// intervals, linear-scan, the eventual swap into cg_var_promote) are
// future increments, each verified before touching anything live.
//
// A T_SWITCH is modelled as a CHAIN of 2-way branches (one per arm, in
// declaration order, falling through to "else" last) rather than a
// single N-way block — mirrors exactly how bpp_dispatch.bsm's
// _inline_normalize_switch_ret already treats this same node shape as a
// sequence of binary comparisons. Keeps every CfgBlock at a uniform "at
// most 2 successors" shape, so no later stage (liveness, intervals)
// needs to special-case an N-way construct.

import "bpp_defs.bsm";
import "bpp_array.bsm";
import "bpp_arr.bsm";
// _inline_pack_mangled_name / _inline_find_nested_calls etc — the
// inliner's own id/slot scheme this module's "see through an inlined
// call site" mechanism reuses verbatim (never reinvents).
import "bpp_dispatch.bsm";
// make_node — synthesizing the small per-parameter bind nodes the
// inline-expansion below needs (NOT cloning the callee's body; see
// the header comment on _rg_expand_inline_straightline).
import "bpp_internal.bsm";

// One basic block: a maximal straight-line statement sequence with a
// single entry and at most two successors. An unconditional fallthrough
// or jump uses succ_a only (succ_b stays -1); a real branch (the two
// arms of an if, a loop's continue-or-exit test, one switch arm's
// pass/fail) uses both; a block ending in T_RET — or an unreachable
// tail right after T_BREAK/T_CONTINUE/T_RET — uses neither.
// use_bits/def_bits/live_in/live_out are Stage B's liveness fields —
// 0 until regalloc_compute_liveness runs. Each is a single-word bitset
// (bit vi = variable index vi), capping tracked variables per function
// at 64 — the largest function measured during this whole arc's
// motivating investigation (games/rts2/rts2_combat.bsm's _combat_step,
// 14 simultaneously-live integers) is comfortably under that, and nine
// elsewhere checked the same day topped out lower still; revisit with a
// real multi-word bitset only if a function is ever found that needs
// it, not speculatively.
struct CfgBlock {
    stmts,      // arr_new()-style growable array of statement-node pointers
    succ_a,     // -1 if none
    succ_b,     // -1 if none
    dead,       // 1 if unreachable BY CONSTRUCTION (the tail allocated
                // right after a T_RET/T_BREAK/T_CONTINUE) -- never link
                // ANY successor to it, even though it starts with the
                // same succ_a<0 && succ_b<0 shape a genuinely open block
                // has. See _rg_link_fallthrough's own comment for the
                // phantom-edge bug this field exists to prevent.
    use_bits,   // read in this block before any def in the SAME block
    def_bits,   // written somewhere in this block
    live_in,    // live at block entry
    live_out    // live at block exit
}

// Per-function CFG-under-construction state. Reset at the top of every
// regalloc_build_cfg call (mirrors cg_vars / cg_var_promote's own
// per-function reset convention in bpp_codegen.bsm) — nothing here
// persists across functions.
global rg_blocks;          // arr_struct of CfgBlock for the function currently being built
global rg_cur_block;       // index of the block statements are currently appended to
global rg_break_stack;     // arr_new() of block indices (break targets)
global rg_continue_stack;  // arr_new() of block indices (continue targets)

// The inline-translation stack — supports "seeing through" an inlined
// call site without ever cloning a tree (see bpp_regalloc.bsm's own
// header comment, the "RegAlloc v2 sees through inlined call sites"
// arc). Each entry is one callee's callsite id (the same id
// `_inline_register_callsite_slots`/`_inline_register_nested` in
// bpp_dispatch.bsm already stamped onto the T_CALL node and used to
// pre-register that callee's `_inl<id>_<param>` mangled slots in the
// CALLER's frame). A single word per frame is enough — no struct
// needed for a one-field record. Pushed when the walker starts
// expanding an inlined call site's body in place, popped when it's
// done; supports nesting (moog_slope inlines moog_taps inlines
// flt_onepole_tick, two levels deep in the real DSP chain today).
// Only the TOP entry is ever consulted when resolving a name — by
// construction, whatever body the walker is CURRENTLY inside belongs
// to exactly one callee at a time, so there is never a need to search
// deeper than the top.
global rg_inline_stack;

// Parallel to rg_inline_stack: how many of the current frame's own
// nested inlined calls have already been consumed. A NESTED call's
// T_CALL node NEVER carries a real id in `.e` — `_inline_register_nested`
// (bpp_dispatch.bsm) explicitly never stamps the shared callee body,
// only the splice-time CLONE does. Pre-reg instead recorded the
// sequence of nested ids in `_inline_nested_ids[outer_id]`, in the
// exact left-to-right discovery order `_inline_find_nested_calls`
// walks the body — the same protocol `_cg_inline_splice_prelude`/
// `_inline_stamp_nested` already consume positionally at emission
// time, reused verbatim here rather than reinvented. See
// _rg_callsite_id_for's own comment for the consumer.
global rg_inline_nk_stack;

// Parallel to rg_inline_stack: where a T_RET encountered WHILE this
// frame is active should land. Two arrays (a "struct of arrays" over
// the same stack depth, since arr_push only ever stores one word per
// entry) rather than packing both into one word — dest_cnt is small
// (1 or N) and dest_arr is a real pointer, no value range to exploit
// for packing that would be worth the unpacking cost on every T_RET.
// dest_arr == 0 is the one special case: it means "this frame's
// expansion sits directly under the CALLER's own trailing return"
// (moon_process's `return moog_slope(...);` shape) — a T_RET hit here
// synthesizes a FRESH T_RET (of the function actually being analysed)
// instead of an assignment into named targets.
global rg_inline_dest_arr_stack;
global rg_inline_dest_cnt_stack;

// Parallel to rg_inline_stack: the block every path through the
// CURRENT frame's expansion must reach. Pushed once, right before
// _rg_build_body walks the callee's statements — every T_RET inside
// (at any depth of if/switch nesting within this SAME frame) links to
// this exact block via the ordinary _rg_link_fallthrough every other
// CFG construction site already uses; the surrounding control flow
// (an enclosing if/switch arm in the callee being expanded) decides
// what happens to flow that reaches it, exactly as it would for a
// plain fallthrough in any ordinary function today.
global rg_inline_join_stack;

// Parallel to rg_inline_stack: which of the CURRENT frame's own
// parameters were SUBSTITUTED directly in place rather than bound to
// a real mangled slot — _inline_param_needs_bind (bpp_codegen.bsm) is
// the single source of truth for this decision, shared with the real
// splice so the two can never disagree about which shape a callsite
// takes (see that function's own header comment for the bug this
// closes — RegAlloc v2 used to assume every parameter was always
// bound, which silently corrupted register state for any parameter
// the real splice substitutes instead).
//
// Each entry is itself an arr_new() of (orig_name, subst_node) pairs
// — packed as two parallel arrays, rg_inline_subst_names_stack[top]
// and rg_inline_subst_nodes_stack[top] — for the CURRENT frame only.
// `subst_node` is the ARGUMENT already cloned+translated through
// whatever frame was active BEFORE this one was pushed (the same
// translation _rg_expand_inline_straightline already performs for
// every bound parameter) — looked up and re-cloned (never shared
// directly — see _rg_clone_subst_lookup) every time a T_VAR inside
// this frame's body references that parameter's name.
global rg_inline_subst_names_stack;
global rg_inline_subst_nodes_stack;

// Every mangled name (`_inl<id>_<param>`) any expansion this function
// ever substituted, across the WHOLE function — unlike the per-frame
// stacks above, this accumulates and is never popped mid-function;
// only reset at the top of regalloc_build_cfg. Needed because
// regalloc_has_uncovered_mangled_promoted (Stage E's own gate) runs
// AFTER every frame has already been pushed and popped, with no
// per-frame state left to consult — yet it still needs to tell a
// genuinely uncovered mangled slot (Stage A's analysis really can't
// see it) apart from a KNOWN-substituted one (Stage A correctly
// expanded right through it, and it simply has no interval because it
// was never bound to a real slot in the first place).
//
// Why this is the right gate and not "fewer false positives": pre-reg
// (_inline_register_callsite_slots, bpp_codegen.bsm) always registers
// `_inl<id>_<param>` in cg_vars and computes its cg_var_refs from the
// callee's ORIGINAL body — independent of bind_needed, which is only
// decided later. B3 ranks purely by that ref count, so it can promote
// a substituted parameter's slot even though the real splice never
// emits a single reference to it (every reference was rewritten to
// the caller's own argument expression instead). The promoted
// register is reserved but genuinely untouched by B3 itself in that
// case — Stage E's linear-scan is free to hand the same physical
// register to one of its own variables with no real collision,
// because nothing B3 emits ever touches the substituted slot.
global rg_known_substituted_names;

// Initialize the regalloc module. Call once at startup, mirroring
// init_dispatch()'s own convention — the real per-function state is set
// fresh by regalloc_build_cfg every time, so this just establishes safe
// defaults before the first function is ever compiled.
void init_regalloc() {
    rg_blocks = 0;
    rg_cur_block = -1;
    rg_break_stack = arr_new();
    rg_continue_stack = arr_new();
    rg_inline_stack = arr_new();
    rg_inline_nk_stack = arr_new();
    rg_inline_dest_arr_stack = arr_new();
    rg_inline_dest_cnt_stack = arr_new();
    rg_inline_join_stack = arr_new();
    rg_inline_subst_names_stack = arr_new();
    rg_inline_subst_nodes_stack = arr_new();
    rg_known_substituted_names = arr_new();
}

// Allocate a fresh, empty block in the function currently under
// construction. Returns its index.
static _rg_new_block() {
    auto idx, b: CfgBlock;
    idx = arr_struct_alloc(rg_blocks);
    b = arr_struct_at(rg_blocks, idx);
    b.stmts = arr_new();
    b.succ_a = -1;
    b.succ_b = -1;
    b.dead = 0;
    b.use_bits = 0;
    b.def_bits = 0;
    b.live_in = 0;
    b.live_out = 0;
    return idx;
}

// Allocate the "unreachable tail" block that follows a T_RET/T_BREAK/
// T_CONTINUE. Execution can never actually fall into it (the statement
// right before it always transfers control away unconditionally), so
// it is marked dead immediately — _rg_link_fallthrough must never wire
// a real edge to it, even though right after allocation it has the
// exact same succ_a<0 && succ_b<0 shape a genuinely still-open block
// has. Found by hand-tracing stb/stbdraw.bsm's blend_px (four
// sequential early-return ifs): without this, _rg_link_fallthrough
// linked each dead tail to the NEXT if's join block, fabricating a
// phantom edge that made every later variable look live across the
// whole chain — corrupting liveness for the rest of the function, not
// just at that one tail.
static _rg_new_dead_block() {
    auto idx, b: CfgBlock;
    idx = _rg_new_block();
    b = arr_struct_at(rg_blocks, idx);
    b.dead = 1;
    return idx;
}

// Append a statement-node pointer to the currently-open block.
static void _rg_emit(nd) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, rg_cur_block);
    b.stmts = arr_push(b.stmts, nd);
}

// Unconditionally set a block's successors — used at the exact points a
// branch/jump/return is known explicitly (a condition's two arms, a
// break, a continue, a return, a loop's back-edge). Never used for
// "falls through to whatever comes next" — that path is
// _rg_link_fallthrough below, which respects a block that already
// terminated itself via a nested return/break/continue.
static void _rg_set_succ(blk, a, b_) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, blk);
    b.succ_a = a;
    b.succ_b = b_;
}

// Link a block to `target` ONLY if it has no explicit successor yet. A
// nested T_RET/T_BREAK/T_CONTINUE inside an if/while/switch arm already
// set succ_a via _rg_set_succ — that decision must never be overwritten
// by the generic "falls through to the join block" edge the caller adds
// once the whole construct's shape is known.
static void _rg_link_fallthrough(blk, target) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, blk);
    if (b.dead == 0 && b.succ_a < 0 && b.succ_b < 0) { b.succ_a = target; }
}

// ── Seeing through an inlined call site ─────────────────────────────
//
// The inliner's real splice (cg_emit_inline_multi, bpp_codegen.bsm)
// only clones the callee's body at EMISSION time — well after this
// module's whole analysis has already run on the caller's un-spliced
// body. Any inlined call site's mangled slots (_inl<id>_<param>,
// pre-registered by _inline_register_callsite_slots /
// _inline_register_nested in bpp_dispatch.bsm) are therefore invisible
// to Stage A's walker by default, which is exactly why
// regalloc_has_mangled_promoted (bpp_codegen.bsm) exists: refuse the
// swap entirely rather than let linear-scan collide with a register
// B3 already gave a slot it cannot see.
//
// This section closes that gap WITHOUT cloning the callee's full body
// tree: when the walker meets an inlined T_CALL whose callee body is
// a simple "straight line of statements ending in one return" shape,
// it binds each (param, arg) pair as a small SYNTHESIZED T_ASSIGN
// (make_node — the exact mechanism _inline_normalize_switch_ret
// already uses to synthesize a ternary, never a new pattern), then
// clones+translates the callee's trailing return expression
// (_rg_clone_translate) into a final assignment.
//
// Why clone the return expression but not the whole body: the
// callee's own AST nodes are SHARED (used standalone, and by every
// other inliner of the same function) and carry the callee's NATIVE
// param/local names. A node that ends up stored in a block's stmts
// array is only ever resolved later, during Stage B/C/D — by which
// point Stage A has long finished and rg_inline_stack is back to
// empty. So every node that gets stored MUST already carry its FINAL
// name baked in at the moment it is built, not a name to be
// translated later (there is no "later" for rg_inline_stack — see
// _rg_translate_name's own comment for the bug this fixes, found by
// hand-tracing a real interval dump). _rg_clone_translate does exactly
// that: walk the shared expression once, translating each T_VAR
// through the CURRENTLY active frame as it goes, producing a fresh
// expression tree of nodes that need no further translation, ever.
//
// Scoped narrowly for now (see docs/plans's "RegAlloc v2 sees through
// inlined call sites" arc): only a STRAIGHT-LINE callee body (no
// T_IF/T_WHILE/T_SWITCH, no T_CALL anywhere — nesting is a later
// increment of the same arc) ending in a single-value T_RET, assigned
// into a plain T_VAR target (`a = callee(...)`) — exactly the
// flt_onepole_tick shape. Anything outside this shape falls through
// to today's behavior (the call site is NOT expanded, B3's
// mangled-promotion gate still protects it).

// Clone an expression, translating every T_VAR through
// _rg_translate_name as it goes. Only the node shapes that can appear
// inside a straight-line callee's return expression need handling
// here (mirrors _rg_expr_uses' own case list one level up, expression
// nodes only — no statement shapes, since this stage's eligibility
// check already rejects anything with control flow or nested calls).
static _rg_clone_translate(nd) {
    auto orig: Node, cl: Node, t, _subst;
    if (nd == 0) { return 0; }
    orig = nd;
    t = orig.ntype;
    if (t == T_VAR) {
        // A name matching one of the CURRENT frame's substituted
        // (bind_needed==0) parameters resolves to a fresh clone of the
        // caller's own argument expression — never a mangled T_VAR at
        // all, since the real splice never creates a slot for it
        // either. See _rg_clone_subst_lookup's own comment.
        //
        // _rg_clone_PLAIN, not _rg_clone_translate, on the substitute:
        // `_subst` was already fully translated at bind time, through
        // whichever frame was active BEFORE this one was pushed — it
        // needs cloning (so two references to the same parameter don't
        // share one mutable node), never a second translation pass.
        // Recursing back into _rg_clone_translate here was an infinite
        // loop waiting to happen whenever a parameter's own name
        // matched its argument's name (e.g. `vec2_add(out, ...)`
        // substituting its own `out` parameter with the caller's
        // variable ALSO named `out`): every re-entry would look up
        // "out" against this SAME frame's substitution map, find the
        // SAME entry, and recurse forever — found via `lldb`/a crash
        // bootstrapping the compiler against its own large `vec2_add`-
        // shaped call sites, 78000+ stacked _rg_clone_translate frames.
        _subst = _rg_clone_subst_lookup(orig.a);
        if (_subst != 0) { return _rg_clone_plain(_subst); }
        cl = make_node(T_VAR);
        cl.a = _rg_translate_name(orig.a);
        return cl;
    }
    if (t == T_LIT) { return orig; }   // immutable, content-only — safe to share
    if (t == T_BINOP) {
        cl = make_node(T_BINOP);
        cl.a = orig.a;
        cl.b = _rg_clone_translate(orig.b);
        cl.c = _rg_clone_translate(orig.c);
        return cl;
    }
    if (t == T_UNARY) {
        cl = make_node(T_UNARY);
        cl.a = orig.a;
        cl.b = _rg_clone_translate(orig.b);
        return cl;
    }
    if (t == T_MEMLD) {
        cl = make_node(T_MEMLD);
        cl.a = _rg_clone_translate(orig.a);
        cl.b = orig.b;
        return cl;
    }
    if (t == T_ADDR) {
        cl = make_node(T_ADDR);
        cl.a = _rg_clone_translate(orig.a);
        return cl;
    }
    if (t == T_TERNARY) {
        cl = make_node(T_TERNARY);
        cl.a = _rg_clone_translate(orig.a);
        cl.b = _rg_clone_translate(orig.b);
        cl.c = _rg_clone_translate(orig.c);
        return cl;
    }
    return orig;   // unreachable given the straightline + no-T_CALL gate
}

// Clone an expression with NO translation at all — every name is
// copied verbatim. Used exactly once: re-cloning a substituted
// parameter's argument node (_rg_clone_translate's own T_VAR case),
// which was already fully translated through the CORRECT (outer)
// frame at bind time and must never be re-resolved against the
// CURRENT (inner) frame's own substitution map — see that case's own
// comment for the infinite-recursion bug this prevents. Mirrors
// _rg_clone_translate's case list exactly, minus the lookup.
static _rg_clone_plain(nd) {
    auto orig: Node, cl: Node, t;
    if (nd == 0) { return 0; }
    orig = nd;
    t = orig.ntype;
    if (t == T_VAR) {
        cl = make_node(T_VAR);
        cl.a = orig.a;
        return cl;
    }
    if (t == T_LIT) { return orig; }
    if (t == T_BINOP) {
        cl = make_node(T_BINOP);
        cl.a = orig.a;
        cl.b = _rg_clone_plain(orig.b);
        cl.c = _rg_clone_plain(orig.c);
        return cl;
    }
    if (t == T_UNARY) {
        cl = make_node(T_UNARY);
        cl.a = orig.a;
        cl.b = _rg_clone_plain(orig.b);
        return cl;
    }
    if (t == T_MEMLD) {
        cl = make_node(T_MEMLD);
        cl.a = _rg_clone_plain(orig.a);
        cl.b = orig.b;
        return cl;
    }
    if (t == T_ADDR) {
        cl = make_node(T_ADDR);
        cl.a = _rg_clone_plain(orig.a);
        return cl;
    }
    if (t == T_TERNARY) {
        cl = make_node(T_TERNARY);
        cl.a = _rg_clone_plain(orig.a);
        cl.b = _rg_clone_plain(orig.b);
        cl.c = _rg_clone_plain(orig.c);
        return cl;
    }
    return orig;
}

// Does every path through `body_arr` return, using only shapes this
// stage understands, given the call site assigns into
// `expected_arity` targets (1 for a plain single-target assignment, N
// for `a,b,c,d = callee(...)`)? Thin wrapper around
// _rg_stmts_all_paths_return's tri-state result (see its own header
// comment for what each value means) — this caller only cares about
// "definitely terminates" (1); both "falls through" (0, only legal
// for a STATEMENT-LIST slice that's allowed to not return, namely an
// if-arm — never legal for a whole callee body, which the call site
// is relying on for its result) and "invalid" (-1) reject identically
// here.
//
// `expected_arity == 0` is the one exception: a VOID callee (a plain
// statement-level call site with no assignment at all, the
// lfo_set_rate-inside-rotary_tick shape — see _rg_is_void_call_expandable)
// is EXPECTED to fall through without ever returning (the real
// inliner's own fn_void_inlineable classifier already rejects any
// void candidate whose body contains a T_RET at all — Stage A's own
// T_RET case below mirrors that same rule), so "falls through" (0) is
// the SUCCESS case here, not "invalid, no value to use."
static _rg_body_all_paths_return(body_arr, body_cnt, expected_arity) {
    auto result;
    result = _rg_stmts_all_paths_return(body_arr, body_cnt, 0, expected_arity);
    if (expected_arity == 0) { return (result >= 0) ? 1 : 0; }
    return (result == 1) ? 1 : 0;
}

// Walks body_arr[start_idx..body_cnt), classifying every path through
// THAT SLICE using only shapes this stage understands. Returns -1 if
// ANY statement is invalid or unsupported (the call site must be
// rejected outright — no partial credit), 1 if every path
// definitely returns (a valid path TERMINATOR), or 0 if the slice is
// internally valid but falls off the end without an explicit return
// (a valid NON-terminator — only meaningful for an if-arm; the slice
// representing a whole callee body is rejected by
// _rg_body_all_paths_return's wrapper, since the call site needs an
// actual value from somewhere).
//
// Distinguishing 0 from -1 matters: an if-arm with NO return at all
// (tl_channel_process's `if (tk.flt_on != 0) { wet =
// moon_process(tk.flt, wet); }`, Phase 6c's shape) is a valid
// conditional update (0) — but an arm whose trailing T_RET exists yet
// is itself invalid (wrong arity, or a call buried in a larger
// expression) must propagate as -1, NOT be silently treated the same
// as "no return here, keep walking" the way a single boolean would.
//
// Every check must pass BEFORE any node is emitted — once one
// statement is appended to the current block, there is no clean way
// to "undo" a partial expansion if a later statement disqualifies it.
//
// T_DECL/T_MEMST/T_ASSIGN (the callee's own locals, or a nested
// expandable call) never terminate a path — walk past them. A local's
// RHS may itself be a T_CALL at the EXPRESSION ROOT
// (`a = flt_onepole_tick(...)`, moog_taps's own shape) as long as THAT
// call is itself recursively expandable (_rg_is_expandable_inline_assign,
// mutual recursion with this function — bounded by the inliner's own
// finite nesting depth, never a real function-recursion cycle since
// the inliner already rejects recursive functions outright). A call
// buried deeper inside a larger expression (`x + flt_onepole_tick(...)`)
// is still rejected — that shape needs splicing a sub-expression's
// result mid-expression, a separate increment from "the whole RHS IS
// the call".
//
// T_RET terminates the path here if its own arity matches
// `expected_arity` (the actual call site this stage is for
// moog_taps's own shape, multi-value T_RET, n.c == expected_arity == 4,
// not a nested local assignment — single-target locals inside a
// callee's body are still validated at expected_arity 1, regardless
// of the OUTER call's own arity) — invalid otherwise.
//
// T_SWITCH (only as the LAST statement — a switch in the middle,
// followed by more code, isn't motivated by any real shape yet) keeps
// its existing all-arms-return validation (_rg_switch_of_returns_ok).
//
// T_IF: recurse into both arms via _rg_if_terminates (see its own
// header comment — Phase 6c's plain conditional update and Phase 6d's
// early return are now both accepted there). If the if terminates
// every path through it, the whole if is itself a path terminator —
// anything textually after it would be dead code (not reasoned
// about, just not expected in practice). Otherwise keep walking
// statements after it.
//
// Anything else (T_WHILE, T_BREAK, T_CONTINUE) — reject. Loops stay
// explicitly out of scope; no real target shape needs one yet.
static _rg_stmts_all_paths_return(body_arr, body_cnt, start_idx, expected_arity) {
    auto i, n: Node, if_term;
    i = start_idx;
    while (i < body_cnt) {
        n = body_arr[i];
        if (n == 0) { return -1; }
        if (n.ntype == T_RET) {
            if (expected_arity == 0) { return -1; }   // a void callee must never contain a return at all
            return _rg_return_arity_ok(n, expected_arity) ? 1 : -1;
        }
        if (n.ntype == T_DECL) { i++; continue; }
        if (n.ntype == T_MEMST) {
            // A struct-field write (moog_taps's own `mm.s1 = a;`
            // shape) — both the address expression and the value are
            // call-free and translate like any other expression; no
            // mangled slot of its own to register (it writes THROUGH
            // an existing pointer, never declares a new local).
            if (_rg_expr_has_call(n.a) || _rg_expr_has_call(n.b)) { return -1; }
            i++;
            continue;
        }
        if (n.ntype == T_ASSIGN) {
            if (n.b != 0 && n.b.ntype == T_CALL) {
                // Recursing FROM here means this statement belongs to
                // some OTHER callee's body — always a nested context,
                // by definition. See _rg_is_expandable_inline_assign's
                // own comment for why this matters (.e is meaningless
                // here). The nested local's OWN target arity matches
                // the nested call's own return arity — moog_slope's
                // own `a,b,c,d = moog_taps(m,in);` is exactly this
                // shape (n.d == 4). _rg_is_expandable_inline_assign
                // validates the target shape itself.
                if (_rg_is_expandable_inline_assign(n, 1, (n.d > 1) ? n.d : 1) == 0) { return -1; }
            } else {
                if (n.d > 1) { return -1; }    // multi-target without a matching nested call — no real shape
                if (n.a == 0 || n.a.ntype != T_VAR) { return -1; }
                if (_rg_expr_has_call(n.b)) { return -1; }
            }
            i++;
            continue;
        }
        if (n.ntype == T_IF) {
            if_term = _rg_if_terminates(n, expected_arity);
            if (if_term < 0) { return -1; }
            if (if_term == 1) { return 1; }
            i++;
            continue;
        }
        if (n.ntype == T_SWITCH) {
            if (i != body_cnt - 1) { return -1; }
            return _rg_switch_of_returns_ok(n, expected_arity) ? 1 : -1;
        }
        return -1;   // T_WHILE, T_BREAK, T_CONTINUE, etc — not yet supported
    }
    return 0;   // fell off the end without returning — valid, but not a terminator
}

// Does `n` (a T_IF) terminate every path through it? Returns -1 if
// the if's shape isn't one this stage recognizes at all (a call in
// the condition, or either arm itself invalid — see
// _rg_stmts_all_paths_return's own header comment for why "invalid"
// must never be conflated with "valid, falls through"), 1 if every
// path through the if definitely returns, 0 otherwise (a path falls
// through to whatever follows the if — Phase 6c's plain conditional
// update, where NEITHER arm returns, and Phase 6d's early return,
// where EXACTLY ONE arm returns and the other falls through, both
// land here; either way the caller still needs to validate the
// statements after the if).
static _rg_if_terminates(n: Node, expected_arity) {
    auto then_r, else_r;
    if (_rg_expr_has_call(n.a)) { return -1; }
    then_r = _rg_stmts_all_paths_return(n.b, n.c, 0, expected_arity);
    if (then_r < 0) { return -1; }
    if (n.e == 0) {
        // No else: the "condition false" path always falls through to
        // whatever follows the if, regardless of whether the then-arm
        // terminates (rotary_tick's own
        // `if (r.mode == ROTARY_OFF && r.cur == 0.0) { return l, r_in; }`
        // shape, Phase 6d) — so the if as a WHOLE never terminates here.
        return 0;
    }
    else_r = _rg_stmts_all_paths_return(n.d, n.e, 0, expected_arity);
    if (else_r < 0) { return -1; }
    if (then_r == 1 && else_r == 1) { return 1; }
    return 0;   // neither, or exactly one, terminates — either way the if itself doesn't
}

// Does `ret` (a T_RET node) have a usable, call-free value matching
// `expected_arity`? n.c is the MULTI-value count only — the parser
// leaves it at 0 for a plain single-value `return x;` (the value
// lives in n.a, not n.b/n.c at all), so arity 1 must accept n.c <= 1,
// never require it to literally equal 1.
static _rg_return_arity_ok(ret: Node, expected_arity) {
    auto n: Node, i;
    n = ret;
    if (expected_arity == 1) {
        if (n.c > 1) { return 0; }
        if (n.a == 0) { return 0; }      // void return has no value to bind
        if (_rg_expr_has_call(n.a)) {
            // A call buried inside a larger expression is still
            // rejected — only `return callee(...);` directly (the
            // moon_process shape) is recognized. Recurse as a NESTED
            // check (is_nested=1): whether THIS particular return is
            // reached at the top level or already inside another
            // expansion, the call itself, if it qualifies at all,
            // qualifies the same way a nested call always does — its
            // own `.e` is never meaningful here either way (top-level
            // callers detect and expand `return callee(...);` BEFORE
            // ever reaching this validation; by the time this runs,
            // it's always validating a callee's own body).
            if (n.a.ntype != T_CALL) { return 0; }
            return _rg_call_is_expandable(n.a, 1, 1);
        }
        return 1;
    }
    if (n.c != expected_arity) { return 0; }
    if (n.b == 0) { return 0; }
    i = 0;
    while (i < expected_arity) {
        if (_rg_expr_has_call(n.b[i])) { return 0; }
        i++;
    }
    return 1;
}

// Does `sw` (a T_SWITCH that is the LAST statement of a callee body)
// describe the moog_slope shape: a value-dispatch switch, mandatory
// else, where EVERY arm — including else — is a single statement that
// is itself a valid, call-free return of the right arity? This is a
// narrow, deliberately specific shape (not "any control flow that
// returns eventually") — it's exactly what real callees like
// moog_slope need, and validating "every path returns" in general
// would be a much bigger, separately-scoped analysis. The switch's
// own condition must also be call-free (it's evaluated once, outside
// any arm, same as any other expression this stage clones+translates).
static _rg_switch_of_returns_ok(sw: Node, expected_arity) {
    auto arm_bodies, arm_count, k, ab, bc, stmt: Node;
    if (_rg_expr_has_call(sw.a)) { return 0; }
    if (sw.d == 0 || sw.e != 1) { return 0; }   // mandatory, single-stmt else
    if (_rg_return_arity_ok(sw.d[0], expected_arity) == 0) { return 0; }
    arm_bodies = sw.src_tok;
    arm_count = sw.c;
    k = 0;
    while (k < arm_count) {
        bc = arm_bodies[k * 2 + 1];
        if (bc != 1) { return 0; }
        ab = arm_bodies[k * 2];
        stmt = ab[0];
        if (stmt == 0 || stmt.ntype != T_RET) { return 0; }
        if (_rg_return_arity_ok(stmt, expected_arity) == 0) { return 0; }
        k++;
    }
    return 1;
}

// Does this expression contain a T_CALL anywhere? Mirrors
// _rg_expr_uses' own case list (expression nodes only — this is only
// ever called on a callee's single return expression, never a
// statement). Used to reject nested inlined calls for this increment
// (see _rg_body_all_paths_return's own comment for why).
static _rg_expr_has_call(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_CALL) { return 1; }
    if (t == T_BINOP) { return _rg_expr_has_call(n.b) || _rg_expr_has_call(n.c); }
    if (t == T_UNARY) { return _rg_expr_has_call(n.b); }
    if (t == T_MEMLD) { return _rg_expr_has_call(n.a); }
    if (t == T_ADDR) { return _rg_expr_has_call(n.a); }
    if (t == T_TERNARY) { return _rg_expr_has_call(n.a) || _rg_expr_has_call(n.b) || _rg_expr_has_call(n.c); }
    return 0;
}

// Build the array of synthesized `dest[i] = <translated value>`
// assignments a T_RET turns into when it's encountered while an
// expansion is active — called directly from _rg_build_stmt's own
// T_RET case now (see its header comment), regardless of how deep
// inside if/switch nesting that T_RET lives within the callee being
// walked. Caller has already confirmed (_rg_return_arity_ok) that
// `ret`'s arity matches dest_cnt.
static _rg_ret_to_assign_array(ret: Node, dest_arr, dest_cnt) {
    auto out, final_n: Node, i;
    out = buf_word(dest_cnt);
    if (dest_cnt == 1) {
        final_n = make_node(T_ASSIGN);
        final_n.a = dest_arr[0];
        final_n.b = _rg_clone_translate(ret.a);
        final_n.d = 0;
        out[0] = final_n;
    } else {
        i = 0;
        while (i < dest_cnt) {
            final_n = make_node(T_ASSIGN);
            final_n.a = dest_arr[i];
            final_n.b = _rg_clone_translate(ret.b[i]);
            final_n.d = 0;
            out[i] = final_n;
            i++;
        }
    }
    return out;
}

// Expand ONE inlined call site in place: bind every (param, arg) pair,
// then walk the callee's ENTIRE body via _rg_build_body — every
// T_DECL/T_MEMST/T_ASSIGN inside translates as it's stored, every
// T_IF/T_SWITCH builds real blocks exactly as it would for an
// ordinary function, and every T_RET (at ANY depth of nesting within
// THIS frame) synthesizes the assignment(s) into `dest_arr` (the
// T_VAR(s) the original call's result(s) were being assigned to — a
// 1-element array for a plain `a = callee(...)`, an N-element array
// for moog_taps's own `a,b,c,d = callee(...)` shape) instead of
// ending the function — see _rg_build_stmt's own T_RET case. Caller
// (_rg_build_stmt or this same function, recursing for a nested call)
// has already confirmed eligibility via _rg_body_all_paths_return and
// resolved `id` — the caller's job, never this function's, since a
// TOP-LEVEL call site's id lives in call_node.e while a NESTED one
// never does (see _rg_callsite_id_for's own comment for why) — this
// function does not care which source it came from.
static void _rg_expand_inline_straightline(call_node, dest_arr, dest_cnt, id) {
    auto fidx, fn_rec, params, pcnt, body_arr, body_cnt;
    auto args, argc, i, param_name, mangled, slot_var: Node, arg_expr, translated_arg;
    auto bind_n: Node, join_blk, needs_bind, subst_names, subst_nodes;
    fidx = find_func_idx(call_node.a);
    fn_rec = funcs[fidx];
    params = *(fn_rec + FN_PARS);
    pcnt = *(fn_rec + FN_PCNT);
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    args = call_node.b;
    argc = call_node.c;

    // Per-param bind-vs-substitute strategy: _inline_param_needs_bind
    // (bpp_codegen.bsm) is THE single source of truth for this
    // decision — the same function the real splice itself calls — so
    // this can never silently diverge from what the real emission
    // actually does again (see that function's own header comment for
    // the bug this closes: a parameter the real splice substitutes
    // directly, with no slot ever created, used to be assumed bound
    // here, corrupting register state for any callee body with more
    // than one statement standing between the substituted parameter's
    // "phantom bind point" and its real use).
    //
    // A BOUND parameter behaves exactly as before: emit
    // `_inl<id>_<param> = <arg expr>` once, translated through
    // whatever frame was ALREADY active (rg_inline_stack's state from
    // before this call — exactly how a real call's arguments evaluate
    // in the CALLER's own scope, before control ever reaches the
    // callee's body).
    //
    // A SUBSTITUTED parameter emits NOTHING — instead, its name and
    // its already-translated argument node are recorded into this
    // frame's own substitution map (subst_names/subst_nodes, pushed
    // below), so every reference to it inside the callee's body
    // resolves straight to a fresh clone of the argument expression
    // (_rg_clone_subst_lookup, consulted from _rg_clone_translate's
    // own T_VAR case) — never to a mangled slot that the real
    // emission never actually creates.
    subst_names = arr_new();
    subst_nodes = arr_new();
    i = 0;
    while (i < pcnt) {
        param_name = params[i];
        arg_expr = (i < argc) ? args[i] : 0;
        translated_arg = _rg_clone_translate(arg_expr);
        needs_bind = (arg_expr == 0) ? 1 : _inline_param_needs_bind(fidx, i, arg_expr, body_arr, body_cnt, params);
        if (needs_bind) {
            mangled = _inline_pack_mangled_name(id, param_name);
            slot_var = make_node(T_VAR);
            slot_var.a = mangled;
            bind_n = make_node(T_ASSIGN);
            bind_n.a = slot_var;
            bind_n.b = translated_arg;
            bind_n.d = 0;
            _rg_emit(bind_n);
        } else {
            subst_names = arr_push(subst_names, param_name);
            subst_nodes = arr_push(subst_nodes, translated_arg);
            // Record the slot pre-reg still registered in cg_vars for
            // this substituted parameter (_inline_register_callsite_slots
            // always registers it, independent of bind_needed — see
            // rg_known_substituted_names's own header comment) so Stage
            // E's gate can recognize it as known-safe instead of
            // genuinely uncovered.
            rg_known_substituted_names = arr_push(rg_known_substituted_names, _inline_pack_mangled_name(id, param_name));
        }
        i++;
    }

    // Walk the callee's ENTIRE body with the new frame active, via the
    // SAME _rg_build_body every ordinary function's CFG is built with
    // — every T_DECL/T_MEMST/T_ASSIGN/T_IF/T_SWITCH inside is handled
    // by the existing, already-correct machinery; T_ASSIGN's own
    // expandable-call check (above, in _rg_build_stmt) fires again
    // recursively for any nested call, and T_RET (also in
    // _rg_build_stmt) synthesizes the destination assignment(s) and
    // links to `join_blk` instead of ending the function — this is
    // the actual generalization this phase exists for: no new
    // control-flow logic written here at all.
    join_blk = _rg_new_block();
    rg_inline_stack = arr_push(rg_inline_stack, id);
    rg_inline_nk_stack = arr_push(rg_inline_nk_stack, 0);
    rg_inline_dest_arr_stack = arr_push(rg_inline_dest_arr_stack, dest_arr);
    rg_inline_dest_cnt_stack = arr_push(rg_inline_dest_cnt_stack, dest_cnt);
    rg_inline_join_stack = arr_push(rg_inline_join_stack, join_blk);
    rg_inline_subst_names_stack = arr_push(rg_inline_subst_names_stack, subst_names);
    rg_inline_subst_nodes_stack = arr_push(rg_inline_subst_nodes_stack, subst_nodes);

    _rg_build_body(body_arr, body_cnt);

    arr_pop(rg_inline_stack);
    arr_pop(rg_inline_nk_stack);
    arr_pop(rg_inline_dest_arr_stack);
    arr_pop(rg_inline_dest_cnt_stack);
    arr_pop(rg_inline_join_stack);
    arr_pop(rg_inline_subst_names_stack);
    arr_pop(rg_inline_subst_nodes_stack);

    // A body that falls off the end without an explicit return
    // shouldn't happen for a non-void callee (_rg_body_all_paths_return
    // already rejected anything that doesn't return on every path) —
    // this fallthrough link is the same safety net ordinary T_IF/
    // T_SWITCH construction already keeps for the analogous case.
    _rg_link_fallthrough(rg_cur_block, join_blk);
    rg_cur_block = join_blk;
}

// Resolve the callsite id to use for expanding `call_node`, or -1 if
// it isn't (or can no longer be confirmed as) an inlined call site at
// all. At the TOP level (rg_inline_stack empty), the id is whatever
// the caller's own real AST already carries in call_node.e —
// _inline_register_callsite stamped it directly, since the caller's
// body is never shared with anyone else.
//
// Inside an active expansion, call_node IS a node from a callee's
// SHARED canonical body (read from funcs[fidx], never cloned) — and
// _inline_register_nested explicitly never stamps `.e` there (only a
// splice-time CLONE gets that treatment, via _inline_stamp_nested).
// So `.e` is always 0 here, useless for detection. Instead: confirm
// this T_CALL genuinely qualifies as a registered nested call (the
// EXACT eligibility test _inline_find_nested_calls itself applies —
// fn_inlineable plus the same "multi-stmt or tier-2" gate), then
// consume the next id from the current frame's own sequence
// (_rg_next_nested_id) — the same `_inline_nested_ids[outer_id]`
// positional-consumption protocol _cg_inline_splice_prelude/
// _inline_stamp_nested already use at emission time, never
// reinvented. The order this function is called in, across one
// callee's body, MUST match _inline_find_nested_calls' own
// left-to-right discovery order — true today because Phase 3b only
// recognizes a call at a statement's RHS root, processed in the same
// order the body's own statements are walked.
static _rg_callsite_id_for(call_node) {
    auto fidx, fn_rec2, callee_bcnt2;
    if (arr_len(rg_inline_stack) == 0) {
        return (call_node.e > 0) ? call_node.e : -1;
    }
    fidx = find_func_idx(call_node.a);
    if (fidx < 0 || arr_get(fn_inlineable, fidx) == 0) { return -1; }
    fn_rec2 = funcs[fidx];
    callee_bcnt2 = *(fn_rec2 + FN_BCNT);
    if (callee_bcnt2 <= 1 && arr_get(fn_inlineable, fidx) != 2) { return -1; }
    return _rg_next_nested_id();
}

// Consume and return the current (topmost) frame's next nested-call
// id, or -1 if its sequence is exhausted (shouldn't happen if
// _rg_callsite_id_for's own eligibility check agrees with what
// pre-reg actually discovered — both walk the same shared body with
// the same case list, so they can't disagree).
static _rg_next_nested_id() {
    auto top_idx, outer_id, nk, nested_ids, result;
    top_idx = arr_len(rg_inline_stack) - 1;
    outer_id = arr_get(rg_inline_stack, top_idx);
    nk = arr_get(rg_inline_nk_stack, top_idx);
    if (outer_id >= arr_len(_inline_nested_ids)) { return -1; }
    nested_ids = arr_get(_inline_nested_ids, outer_id);
    if (nested_ids == 0 || nk >= arr_len(nested_ids)) { return -1; }
    result = arr_get(nested_ids, nk);
    arr_set(rg_inline_nk_stack, top_idx, nk + 1);
    return result;
}

// Is `nd` a T_ASSIGN (target arity == `expected_arity`) whose RHS is
// directly an inlined call site this stage knows how to expand — the
// shape every real flt_onepole_tick-style (arity 1) or moog_taps-style
// (arity 4, multi-return) call site takes?
//
// `is_nested` distinguishes the two contexts this is called from
// (mirrors _rg_callsite_id_for's own split, but at VALIDATION time,
// before any frame is pushed and before any nested-id is consumed):
//   0 — _rg_build_stmt, validating a TOP-LEVEL call site against the
//       caller's own real (never shared) AST — `.e` is meaningful and
//       required here: it's the real inliner's own confirmation that
//       THIS exact call site was chosen for inlining (a function can
//       be fn_inlineable yet still NOT have every call site of it
//       actually registered, e.g. a tier-3 hot-only callee at a cold
//       site never gets a callsite_id at all).
//   1 — recursing from _rg_body_all_paths_return, validating a
//       statement that lives inside some OTHER callee's shared body.
//       `.e` is ALWAYS 0 there (_inline_register_nested never stamps
//       the shared body) — so this checks the same fn_inlineable +
//       size-tier test _inline_find_nested_calls itself applies,
//       which is what actually determines whether pre-reg registered
//       this exact call as a nested one (and therefore whether
//       _rg_next_nested_id will find a real id for it later, at
//       expansion time).
static _rg_is_expandable_inline_assign(nd, is_nested, expected_arity) {
    auto n: Node, i, tnode: Node;
    n = nd;
    if (n.ntype != T_ASSIGN) { return 0; }
    if (expected_arity == 1) {
        if (n.d > 1) { return 0; }
        if (n.a == 0 || n.a.ntype != T_VAR) { return 0; }
    } else {
        if (n.d != expected_arity) { return 0; }
        i = 0;
        while (i < expected_arity) {
            tnode = n.c[i];
            if (tnode == 0 || tnode.ntype != T_VAR) { return 0; }
            i++;
        }
    }
    return _rg_call_is_expandable(n.b, is_nested, expected_arity);
}

// The call-site half of _rg_is_expandable_inline_assign, with no
// opinion at all about what (if anything) receives the result —
// shared by T_ASSIGN's own check above (which validates the target
// shape FIRST, then delegates here) and T_RET's `return callee(...);`
// detection (Phase 6b — moon_process's shape has no target node to
// validate at all, the value flows straight into the CALLER's own
// return).
static _rg_call_is_expandable(call_node, is_nested, expected_arity) {
    auto rhs: Node, fidx, fn_rec, body_arr, body_cnt, callee_bcnt;
    rhs = call_node;
    if (rhs == 0 || rhs.ntype != T_CALL) { return 0; }
    fidx = find_func_idx(rhs.a);
    if (fidx < 0) { return 0; }
    if (is_nested == 0) {
        if (rhs.e == 0) { return 0; }            // not a call site the real inliner chose
    } else {
        if (arr_get(fn_inlineable, fidx) == 0) { return 0; }
        fn_rec = funcs[fidx];
        callee_bcnt = *(fn_rec + FN_BCNT);
        if (callee_bcnt <= 1 && arr_get(fn_inlineable, fidx) != 2) { return 0; }
    }
    fn_rec = funcs[fidx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    return _rg_body_all_paths_return(body_arr, body_cnt, expected_arity);
}

// Is `call_node` a plain STATEMENT-level call (no assignment, no
// return — `lfo_set_rate(r.lfo, r.cur);` inside rotary_tick's own
// body) whose target is the real inliner's VOID-inlineable tier
// (fn_void_inlineable, bpp_dispatch.bsm — a DIFFERENT classifier from
// fn_inlineable, registered the same way via _inline_register_callsite
// but never carrying a value)? Mirrors _rg_call_is_expandable's own
// shape exactly, just against the void classifier and with
// expected_arity pinned to 0 — _rg_body_all_paths_return's own
// expected_arity==0 branch (above) is what actually accepts "falls
// through without a return" as success here, instead of rejecting it.
// Only the TOP-LEVEL case (is_nested==0) is wired up — a void call
// nested inside another callee's own body isn't reached by anything
// real yet (_inline_find_nested_calls, bpp_dispatch.bsm, doesn't walk
// a callee's PLAIN statement list looking for a bare T_CALL either —
// only inside an expression), so there's nothing this stage could
// recurse into even if it tried.
static _rg_is_void_call_expandable(call_node, is_nested) {
    auto rhs: Node, fidx, fn_rec, body_arr, body_cnt;
    rhs = call_node;
    if (rhs == 0 || rhs.ntype != T_CALL) { return 0; }
    fidx = find_func_idx(rhs.a);
    if (fidx < 0) { return 0; }
    if (arr_get(fn_void_inlineable, fidx) == 0) { return 0; }
    if (is_nested == 0) {
        if (rhs.e == 0) { return 0; }            // not a call site the real inliner chose
    } else {
        return 0;                                // not yet motivated by any real shape
    }
    fn_rec = funcs[fidx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    return _rg_body_all_paths_return(body_arr, body_cnt, 0);
}

// Build the CFG for one statement, updating rg_cur_block to whatever
// block is open once it returns. Mirrors cg_emit_stmt's own per-node
// dispatch shape (bpp_codegen.bsm) — only the CONTROL-FLOW shape
// matters here; any statement that doesn't split blocks is just
// appended to whatever block is currently open.
static _rg_build_stmt(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;

    if (t == T_IF) {
        auto cond_blk, if_entry, else_entry, if_exit, else_exit, join_blk, has_else;
        cond_blk = rg_cur_block;
        _rg_emit(n.a);
        has_else = (n.e > 0);
        if_entry = _rg_new_block();
        if (has_else) {
            else_entry = _rg_new_block();
            _rg_set_succ(cond_blk, if_entry, else_entry);
        } else {
            else_entry = -1;
        }
        rg_cur_block = if_entry;
        _rg_build_body(n.b, n.c);
        if_exit = rg_cur_block;
        if (has_else) {
            rg_cur_block = else_entry;
            _rg_build_body(n.d, n.e);
            else_exit = rg_cur_block;
        } else {
            else_exit = -1;
        }
        join_blk = _rg_new_block();
        if (has_else == 0) { _rg_set_succ(cond_blk, if_entry, join_blk); }
        _rg_link_fallthrough(if_exit, join_blk);
        if (has_else) { _rg_link_fallthrough(else_exit, join_blk); }
        rg_cur_block = join_blk;
        return 0;
    }

    if (t == T_WHILE) {
        auto prev_blk, header_blk, body_entry, exit_blk, continue_blk, body_exit, step_node;
        step_node = n.e;
        prev_blk = rg_cur_block;
        header_blk = _rg_new_block();
        _rg_link_fallthrough(prev_blk, header_blk);
        rg_cur_block = header_blk;
        _rg_emit(n.a);

        body_entry = _rg_new_block();
        exit_blk = _rg_new_block();
        continue_blk = _rg_new_block();
        _rg_set_succ(header_blk, body_entry, exit_blk);

        rg_break_stack = arr_push(rg_break_stack, exit_blk);
        rg_continue_stack = arr_push(rg_continue_stack, continue_blk);

        rg_cur_block = body_entry;
        _rg_build_body(n.b, n.c);
        body_exit = rg_cur_block;
        _rg_link_fallthrough(body_exit, continue_blk);

        arr_pop(rg_break_stack);
        arr_pop(rg_continue_stack);

        rg_cur_block = continue_blk;
        if (step_node != 0) { _rg_emit(step_node); }
        _rg_set_succ(continue_blk, header_blk, -1);

        rg_cur_block = exit_blk;
        return 0;
    }

    if (t == T_BREAK) {
        _rg_emit(nd);
        if (arr_len(rg_break_stack) > 0) {
            _rg_set_succ(rg_cur_block, arr_last(rg_break_stack), -1);
        }
        // Dead tail, kept so a statement after `break;` in the same
        // arm still has somewhere safe to land — but never linkable
        // (see _rg_new_dead_block's own comment).
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_CONTINUE) {
        _rg_emit(nd);
        if (arr_len(rg_continue_stack) > 0) {
            _rg_set_succ(rg_cur_block, arr_last(rg_continue_stack), -1);
        }
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_RET) {
        if (arr_len(rg_inline_stack) > 0) {
            // The callee currently being walked may ITSELF return
            // directly from another expandable call (moon_process's
            // own shape, one level deeper than wherever the outer
            // expansion started — `return moog_slope(...);` lives
            // inside moon_process's body, reached here while
            // moon_process's own frame is active). The result flows
            // straight through to whatever destination the CURRENT
            // frame already has (an assignment array, or another
            // level of "this is really the caller's own return") —
            // recurse with that SAME destination instead of
            // synthesizing anything here; the recursive call pushes
            // its own nested frame and pops back to this one when done.
            auto _rg_top0, _rg_dest_arr0, _rg_dest_cnt0, _rg_cs_id3;
            if (n.c <= 1 && n.a != 0 && n.a.ntype == T_CALL) {
                _rg_top0 = arr_len(rg_inline_join_stack) - 1;
                _rg_dest_arr0 = arr_get(rg_inline_dest_arr_stack, _rg_top0);
                _rg_dest_cnt0 = arr_get(rg_inline_dest_cnt_stack, _rg_top0);
                if (_rg_call_is_expandable(n.a, 1, _rg_dest_cnt0)) {
                    _rg_cs_id3 = _rg_callsite_id_for(n.a);
                    if (_rg_cs_id3 >= 0) {
                        _rg_expand_inline_straightline(n.a, _rg_dest_arr0, _rg_dest_cnt0, _rg_cs_id3);
                        return 0;
                    }
                }
            }
            auto _rg_top, _rg_dest_arr2, _rg_dest_cnt2, _rg_join, _rg_assigns, _rg_ai;
            _rg_top = arr_len(rg_inline_join_stack) - 1;
            _rg_dest_arr2 = arr_get(rg_inline_dest_arr_stack, _rg_top);
            _rg_dest_cnt2 = arr_get(rg_inline_dest_cnt_stack, _rg_top);
            if (_rg_dest_arr2 == 0) {
                // The moon_process shape: this expansion sits directly
                // under the CALLER's own `return callee(...);` — the
                // function actually being analysed terminates HERE,
                // for real, not at this frame's join block (which is
                // pushed but never reached in this case). Synthesize
                // a FRESH T_RET from the translated value(s) instead
                // of an assignment.
                auto _rg_fresh_ret: Node, _rg_vals, _rg_vi;
                _rg_fresh_ret = make_node(T_RET);
                if (_rg_dest_cnt2 == 1) {
                    _rg_fresh_ret.a = _rg_clone_translate(n.a);
                } else {
                    _rg_vals = buf_word(_rg_dest_cnt2);
                    _rg_vi = 0;
                    while (_rg_vi < _rg_dest_cnt2) {
                        _rg_vals[_rg_vi] = _rg_clone_translate(n.b[_rg_vi]);
                        _rg_vi++;
                    }
                    _rg_fresh_ret.b = _rg_vals;
                    _rg_fresh_ret.c = _rg_dest_cnt2;
                }
                _rg_emit(_rg_fresh_ret);
                _rg_set_succ(rg_cur_block, -1, -1);
                rg_cur_block = _rg_new_dead_block();
                return 0;
            }
            // Inside an active expansion that DOES assign into named
            // targets: synthesize the assignment(s), then link the
            // current block to the expansion's own join block — never
            // "no successor" — the SAME _rg_link_fallthrough-driven
            // convergence every ordinary if/switch already relies on.
            _rg_join = arr_get(rg_inline_join_stack, _rg_top);
            _rg_assigns = _rg_ret_to_assign_array(n, _rg_dest_arr2, _rg_dest_cnt2);
            _rg_ai = 0;
            while (_rg_ai < _rg_dest_cnt2) { _rg_emit(_rg_assigns[_rg_ai]); _rg_ai++; }
            _rg_set_succ(rg_cur_block, _rg_join, -1);
            rg_cur_block = _rg_new_dead_block();
            return 0;
        }
        // Top level: `return callee(...);` directly (no intermediate
        // assignment — moon_process's own shape) expands in place
        // exactly like `a = callee(...)` does, just with dest_arr=0
        // (handled above on the NEXT time this case fires, once
        // inside the pushed frame) telling the recursive call to
        // synthesize a fresh return instead of an assignment. Only
        // the single-value shape is recognized for now — a multi-
        // value return whose call lives in n.a is not how the parser
        // shapes that (n.a is unused, n.b/n.c carry the values), and a
        // call hiding inside ONE of several multi-return values
        // (`return x, callee(...);`) is a different, not-yet-motivated
        // shape, left unrecognized.
        if (n.c <= 1 && n.a != 0 && n.a.ntype == T_CALL) {
            auto _rg_cs_id2;
            if (_rg_call_is_expandable(n.a, 0, 1)) {
                _rg_cs_id2 = _rg_callsite_id_for(n.a);
                if (_rg_cs_id2 >= 0) {
                    _rg_expand_inline_straightline(n.a, 0, 1, _rg_cs_id2);
                    return 0;
                }
            }
        }
        _rg_emit(nd);
        _rg_set_succ(rg_cur_block, -1, -1);
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_SWITCH) {
        // Layout (bpp_parser.bsm's parse_switch): n.a=condition,
        // n.b=arm_values (interleaved [vals_arr, vcnt] per arm),
        // n.c=arm_count, n.d/n.e=else body/count,
        // n.src_tok=arm_bodies (interleaved [body_arr, bcnt] per arm).
        auto arm_values, arm_bodies, arm_count, k, join_blk, test_blk, body_blk, next_test;
        auto exits, ei, ab, bc;
        arm_values = n.b; arm_bodies = n.src_tok; arm_count = n.c;
        exits = arr_new();
        test_blk = rg_cur_block;
        _rg_emit(n.a);

        k = 0;
        while (k < arm_count) {
            body_blk = _rg_new_block();
            next_test = _rg_new_block();
            _rg_set_succ(test_blk, body_blk, next_test);
            rg_cur_block = body_blk;
            ab = arm_bodies[k * 2]; bc = arm_bodies[k * 2 + 1];
            _rg_build_body(ab, bc);
            exits = arr_push(exits, rg_cur_block);
            test_blk = next_test;
            k++;
        }
        if (n.e > 0) {
            rg_cur_block = test_blk;
            _rg_build_body(n.d, n.e);
            exits = arr_push(exits, rg_cur_block);
        } else {
            exits = arr_push(exits, test_blk);   // no else: falls straight to join
        }
        join_blk = _rg_new_block();
        ei = 0;
        while (ei < arr_len(exits)) {
            _rg_link_fallthrough(arr_get(exits, ei), join_blk);
            ei++;
        }
        rg_cur_block = join_blk;
        return 0;
    }

    if (t == T_BLOCK) {
        _rg_build_body(n.b, n.c);
        return 0;
    }

    // `a = <inlined call>` or `a,b,c,d = <inlined call>` where the
    // callee's body has all paths returning (see "Seeing through an
    // inlined call site" above) — expand it in place instead of
    // treating the call as an opaque statement. This fires identically
    // whether `nd` is a TOP-LEVEL statement or one being walked INSIDE
    // an active expansion (rg_inline_stack non-empty) — _rg_is_nested
    // and _rg_callsite_id_for both already distinguish the two
    // contexts internally, so this site needs no separate case for
    // either. The destination is cloned+translated through whatever
    // frame is currently active (a no-op at the top level, where the
    // stack is empty and translation falls through to the name
    // unchanged). Every other shape (control flow this stage doesn't
    // recognize, a call buried deeper inside an expression, or simply
    // not an inlined call at all) falls through unchanged to the
    // plain-statement case below.
    if (t == T_ASSIGN && n.b != 0 && n.b.ntype == T_CALL) {
        auto _rg_arity, _rg_dest_arr, _rg_is_nested, _rg_cs_id, _rg_di;
        _rg_arity = (n.d > 1) ? n.d : 1;
        _rg_is_nested = (arr_len(rg_inline_stack) > 0) ? 1 : 0;
        if (_rg_is_expandable_inline_assign(nd, _rg_is_nested, _rg_arity)) {
            _rg_cs_id = _rg_callsite_id_for(n.b);
            if (_rg_cs_id >= 0) {
                _rg_dest_arr = buf_word(_rg_arity);
                if (_rg_arity == 1) {
                    _rg_dest_arr[0] = _rg_clone_translate(n.a);
                } else {
                    _rg_di = 0;
                    while (_rg_di < _rg_arity) {
                        _rg_dest_arr[_rg_di] = _rg_clone_translate(n.c[_rg_di]);
                        _rg_di++;
                    }
                }
                _rg_expand_inline_straightline(n.b, _rg_dest_arr, _rg_arity, _rg_cs_id);
                return 0;
            }
        }
    }

    // A plain STATEMENT-level call with no assignment and no return at
    // all (`lfo_set_rate(r.lfo, r.cur);` inside rotary_tick's own body)
    // — the void-inlineable counterpart of the T_ASSIGN case just
    // above. Only recognized at the TOP level (rg_inline_stack empty —
    // see _rg_is_void_call_expandable's own comment for why a nested
    // occurrence isn't handled). dest_arr=0/dest_cnt=0 tells
    // _rg_expand_inline_straightline there is no result to bind
    // anywhere — safe because a void callee's own body is guaranteed
    // (by _rg_body_all_paths_return's expected_arity==0 check) to
    // never contain a T_RET that would need a destination at all.
    if (t == T_CALL && arr_len(rg_inline_stack) == 0) {
        auto _rg_void_cs_id;
        if (_rg_is_void_call_expandable(nd, 0)) {
            _rg_void_cs_id = _rg_callsite_id_for(nd);
            if (_rg_void_cs_id >= 0) {
                _rg_expand_inline_straightline(nd, 0, 0, _rg_void_cs_id);
                return 0;
            }
        }
    }

    // Plain statement (T_ASSIGN, T_MEMST, T_DECL, expression-statement,
    // etc.) — none of these split blocks, just append. Outside any
    // expansion (the common case — every ordinary function the
    // compiler has ever analysed), `nd` is stored as-is, same as
    // always. INSIDE an active expansion, this statement belongs to
    // the callee currently being walked and carries its NATIVE
    // param/local names — it must be cloned+translated before
    // storage, for the exact same reason _rg_clone_translate's own
    // header comment gives for expressions: there is no "later" for
    // rg_inline_stack, Stage B/C only ever see this node after Stage A
    // has long finished and every frame is back to empty.
    if (arr_len(rg_inline_stack) > 0) {
        auto _rg_translated_stmt;
        _rg_translated_stmt = _rg_clone_translate_stmt(nd);
        if (_rg_translated_stmt != 0) { _rg_emit(_rg_translated_stmt); }
        return 0;
    }
    _rg_emit(nd);
    return 0;
}

// Clone+translate a STATEMENT (as opposed to _rg_clone_translate,
// which only ever handles expression nodes) for storage while inside
// an active expansion. Only the shapes _rg_body_all_paths_return
// accepts as a callee local need handling here — T_DECL needs no
// translation at all (its mangled slot already exists from pre-reg;
// emitting a fresh declaration would add nothing, so this returns 0 —
// _rg_emit already no-ops on a 0 node, mirrored from
// _rg_build_stmt's own `if (nd == 0) { return 0; }` guard).
static _rg_clone_translate_stmt(nd) {
    auto n: Node, cl: Node;
    if (nd == 0) { return 0; }
    n = nd;
    if (n.ntype == T_DECL) { return 0; }
    if (n.ntype == T_ASSIGN) {
        cl = make_node(T_ASSIGN);
        cl.a = _rg_clone_translate(n.a);
        cl.b = _rg_clone_translate(n.b);
        cl.d = 0;
        return cl;
    }
    if (n.ntype == T_MEMST) {
        cl = make_node(T_MEMST);
        cl.a = _rg_clone_translate(n.a);
        cl.b = _rg_clone_translate(n.b);
        return cl;
    }
    return nd;   // unreachable given _rg_body_all_paths_return's own gate
}

static _rg_build_body(arr, cnt) {
    auto i;
    i = 0;
    while (i < cnt) {
        _rg_build_stmt(arr[i]);
        i++;
    }
    return 0;
}

// Build the CFG for one whole function body. Resets per-function state,
// allocates the entry block, walks the body, and returns the `rg_blocks`
// handle (an arr_struct of CfgBlock) for the caller to keep, dump, or
// (future stages) analyse further. Falling off the end of the body with
// no explicit T_RET (a void function, or one whose last statement is
// plain code) leaves the final block's successors at (-1,-1) by
// construction — exactly the same "no successor" shape an explicit
// T_RET produces, since function exit either way has nothing after it.
regalloc_build_cfg(body_arr, body_cnt) -> ptr {
    rg_blocks = arr_struct_new(sizeof(CfgBlock), 16);
    rg_break_stack = arr_new();
    rg_continue_stack = arr_new();
    rg_inline_stack = arr_new();
    rg_inline_nk_stack = arr_new();
    rg_inline_dest_arr_stack = arr_new();
    rg_inline_dest_cnt_stack = arr_new();
    rg_inline_join_stack = arr_new();
    rg_inline_subst_names_stack = arr_new();
    rg_inline_subst_nodes_stack = arr_new();
    rg_known_substituted_names = arr_new();
    rg_cur_block = _rg_new_block();
    _rg_build_body(body_arr, body_cnt);
    return rg_blocks;
}

// Debug dump: prints block count + per-block statement count and
// successor edges. The verification tool for this stage — nothing in
// codegen consumes the CFG yet, so this is how its correctness gets
// checked (by a human reading the dump, or a test script grepping it).
// Mirrors --show-deps's own diag_str/diag_int/diag_newline self-printing
// convention (bpp.bpp). `fn_name` is the function's packed name
// (offset+length into vbuf, same representation FN_NAME always carries)
// — printed via diag_buf exactly like --show-deps prints module names.
void regalloc_dump_cfg(blocks, fn_name) {
    auto n, i, b: CfgBlock;
    n = arr_struct_count(blocks);
    diag_str("CFG ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" blocks");
    diag_newline();
    i = 0;
    while (i < n) {
        b = arr_struct_at(blocks, i);
        diag_str("  block ");
        diag_int(i);
        diag_str(": ");
        diag_int(arr_len(b.stmts));
        diag_str(" stmts, succ=(");
        diag_int(b.succ_a);
        diag_str(",");
        diag_int(b.succ_b);
        diag_str(")");
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with the debug-dump trigger prefix
// "__rg_dump_"? A function named this way gets its CFG printed (via
// regalloc_dump_cfg) the moment it's built — the test-facing hook for
// this stage, since nothing else observes the CFG yet. Avoids adding a
// new CLI flag + a persistent cross-function CFG table purely for
// verification purposes; a future stage that wires the CFG into real
// codegen decisions will need that persistence anyway, at which point
// this hook stays exactly as useful without having pre-built unneeded
// plumbing today.
regalloc_name_wants_dump(fn_name) {
    auto pfx_len;
    pfx_len = 10;   // length of "__rg_dump_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_dump_", pfx_len);
}

// ── Stage B — liveness analysis ─────────────────────────────────────
//
// Classic backward dataflow over Stage A's CFG: for each block, compute
// live_in/live_out (which LOCAL variables — globals are never B3/regalloc
// candidates, so they're not tracked at all) are live, iterating until
// nothing changes. Per-block working sets are a single 64-bit word
// (bit vi = variable index vi, from the SAME cg_var_idx every other
// codegen pass already uses) — see CfgBlock's own field comment for why
// one word is enough for every function measured so far.

// The bit for variable index `vi`, or 0 if vi is untracked (not a local
// at all — cg_var_idx returns -1 for globals/unknowns — or past the
// 64-variable cap this single-word bitset enforces).
static _rg_var_bit(vi) {
    if (vi < 0 || vi >= 64) { return 0; }
    return 1 << vi;
}

// Does `name_p` match one of the CURRENT (topmost) frame's substituted
// parameters — a parameter _inline_param_needs_bind decided gets no
// real mangled slot at all, because the real splice substitutes the
// caller's own argument expression directly in its place? Returns the
// (already cloned+translated, at bind time) argument node if so, 0
// otherwise — checked BEFORE _rg_translate_name's mangled-name lookup
// in _rg_clone_translate, since a substituted parameter has no
// mangled slot for that lookup to ever find anyway. Only the topmost
// frame is consulted, mirroring rg_inline_stack's own "exactly one
// level of currently-active translation context" invariant — see its
// header comment.
static _rg_clone_subst_lookup(name_p) {
    auto top_idx, names, nodes, n, i;
    top_idx = arr_len(rg_inline_subst_names_stack) - 1;
    if (top_idx < 0) { return 0; }
    names = arr_get(rg_inline_subst_names_stack, top_idx);
    nodes = arr_get(rg_inline_subst_nodes_stack, top_idx);
    n = arr_len(names);
    i = 0;
    while (i < n) {
        if (packed_eq(arr_get(names, i), name_p)) { return arr_get(nodes, i); }
        i++;
    }
    return 0;
}

// Resolve a packed name to whatever it should ACTUALLY refer to right
// now, given the inline-translation stack's current top frame —
// returns a (possibly different) packed name, not an index. This is
// the one and only thing rg_inline_stack is for: it is consulted
// exclusively DURING Stage A's construction, inside
// _rg_clone_translate below, while cloning an inlined callee's body
// statement by statement. By the time Stage B/C/D ever run, Stage A
// has already finished — every node sitting in a block's stmts array
// was either copied verbatim from the caller's own source (needs no
// translation) or produced by _rg_clone_translate with its FINAL name
// already burned in. There is deliberately no translation step
// anywhere in Stage B/C's own walkers (_rg_expr_uses /
// _rg_stmt_use_def) — they call plain cg_var_idx, exactly like every
// other codegen pass, because by the time they run there is nothing
// left to translate.
//
// (First version of this mechanism tried to defer translation to
// Stage B/C by consulting the stack from inside _rg_expr_uses itself —
// wrong: the stack had already been popped back to empty by the time
// those walkers ran, since they only run AFTER the whole CFG is built.
// Found by hand-tracing a real interval dump that showed a mangled
// slot's interval missing its actual use entirely.)
static _rg_translate_name(name_p) {
    auto top_id, mangled;
    if (arr_len(rg_inline_stack) > 0) {
        top_id = arr_last(rg_inline_stack);
        mangled = _inline_pack_mangled_name(top_id, name_p);
        if (cg_var_idx(mangled) >= 0) { return mangled; }
    }
    return name_p;
}

// Every local variable an EXPRESSION reads, as a bitset. Expressions
// never define a variable on their own (only T_ASSIGN's target, T_MEMST's
// address/value being assignment-adjacent statements handle that) — this
// is pure use-side, recursing into every expression-shaped node type the
// AST has.
static _rg_expr_uses(nd) {
    auto n: Node, t, bits, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_VAR) { return _rg_var_bit(cg_var_idx(n.a)); }
    if (t == T_BINOP) { return _rg_expr_uses(n.b) | _rg_expr_uses(n.c); }
    if (t == T_UNARY) { return _rg_expr_uses(n.b); }
    if (t == T_MEMLD) { return _rg_expr_uses(n.a); }
    // &x — address-taken. cg_b3_eligible already excludes address-taken
    // locals from promotion entirely (their value must live at a stable
    // frame address), so this stage doesn't need to do anything special
    // with the bit beyond recording the read for completeness.
    if (t == T_ADDR) { return _rg_expr_uses(n.a); }
    if (t == T_TERNARY) { return _rg_expr_uses(n.a) | _rg_expr_uses(n.b) | _rg_expr_uses(n.c); }
    if (t == T_CALL) {
        arr = n.b; cnt = n.c; bits = 0;
        i = 0;
        while (i < cnt) { bits = bits | _rg_expr_uses(arr[i]); i++; }
        return bits;
    }
    return 0;   // T_LIT, T_DECL, T_NOP, T_BREAK, T_CONTINUE: no reads
}

// One statement's own (use, def) bit pair. The use side reflects every
// variable READ by this statement regardless of what it also defines —
// `x = x + 1` both uses and defines x, and the read must count since
// x's incoming value matters. T_ASSIGN.a is always a plain T_VAR (or,
// for a multi-target assignment, T_ASSIGN.c is an array of plain T_VAR —
// confirmed directly in bpp_parser.bsm's parse_assign: any LHS that is
// itself a T_MEMLD becomes a T_MEMST instead, so T_ASSIGN's own target
// side is never a complex address).
static _rg_stmt_use_def(nd) {
    auto n: Node, t, use_bits, def_bits, vi, arr, cnt, i, tnode: Node;
    use_bits = 0; def_bits = 0;
    if (nd == 0) { return use_bits, def_bits; }
    n = nd; t = n.ntype;

    if (t == T_ASSIGN) {
        use_bits = _rg_expr_uses(n.b);
        if (n.d > 1) {
            arr = n.c; cnt = n.d;
            i = 0;
            while (i < cnt) {
                tnode = arr[i];
                if (tnode != 0 && tnode.ntype == T_VAR) {
                    def_bits = def_bits | _rg_var_bit(cg_var_idx(tnode.a));
                }
                i++;
            }
        } else if (n.a != 0 && n.a.ntype == T_VAR) {
            def_bits = _rg_var_bit(cg_var_idx(n.a.a));
        }
        return use_bits, def_bits;
    }
    // A store THROUGH an address — the base var is read (the address is
    // computed FROM it), never written; only what it points to changes,
    // which liveness over LOCAL VARIABLES has no bit for.
    if (t == T_MEMST) {
        use_bits = _rg_expr_uses(n.a) | _rg_expr_uses(n.b);
        return use_bits, def_bits;
    }
    if (t == T_RET) {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            i = 0;
            while (i < cnt) { use_bits = use_bits | _rg_expr_uses(arr[i]); i++; }
        } else {
            use_bits = _rg_expr_uses(n.a);
        }
        return use_bits, def_bits;
    }
    if (t == T_DECL || t == T_BREAK || t == T_CONTINUE || t == T_NOP) {
        return use_bits, def_bits;
    }
    // A bare expression-statement (e.g. a void-returning T_CALL used in
    // statement position) or a control-flow condition node this stage
    // hands directly to _rg_emit (T_IF/T_WHILE/T_SWITCH's own n.a) —
    // pure use, no def.
    use_bits = _rg_expr_uses(nd);
    return use_bits, def_bits;
}

// Computes block `blk`'s own use_bits/def_bits from its statement list,
// in order — a read only counts as a block-level "use" if no EARLIER
// statement in the same block already defined that variable (the
// classic kill-then-gen sequencing liveness needs to be exact).
static void _rg_compute_block_use_def(blocks, blk) {
    auto b: CfgBlock, i, n, su, sd, killed, use_acc, def_acc;
    b = arr_struct_at(blocks, blk);
    n = arr_len(b.stmts);
    killed = 0; use_acc = 0; def_acc = 0;
    i = 0;
    while (i < n) {
        su, sd = _rg_stmt_use_def(arr_get(b.stmts, i));
        use_acc = use_acc | (su & ~killed);
        killed = killed | sd;
        def_acc = def_acc | sd;
        i++;
    }
    b.use_bits = use_acc;
    b.def_bits = def_acc;
}

// Computes live_in/live_out for every block in `blocks` (a handle
// returned by regalloc_build_cfg). Backward dataflow to a fixpoint —
// no block's live set can shrink once grown (a variable, once proven
// live, stays live until the iteration that correctly narrows it), so
// a simple "did anything change this pass" loop converges to the exact
// answer, same fixpoint-to-convergence shape classify_inlineable's own
// Inc 6 loop already uses (bpp_dispatch.bsm). Pure analysis — still
// nothing in codegen reads live_in/live_out yet; Stage C (live
// intervals) is the first consumer.
void regalloc_compute_liveness(blocks) {
    auto n, i, changed, b: CfgBlock, sb: CfgBlock, new_out, new_in;
    n = arr_struct_count(blocks);
    i = 0;
    while (i < n) {
        _rg_compute_block_use_def(blocks, i);
        i++;
    }
    changed = 1;
    while (changed) {
        changed = 0;
        i = 0;
        while (i < n) {
            b = arr_struct_at(blocks, i);
            new_out = 0;
            if (b.succ_a >= 0) { sb = arr_struct_at(blocks, b.succ_a); new_out = new_out | sb.live_in; }
            if (b.succ_b >= 0) { sb = arr_struct_at(blocks, b.succ_b); new_out = new_out | sb.live_in; }
            new_in = b.use_bits | (new_out & ~b.def_bits);
            if (new_out != b.live_out || new_in != b.live_in) {
                b.live_out = new_out;
                b.live_in = new_in;
                changed = 1;
            }
            i++;
        }
    }
}

// Debug dump for Stage B — prints each block's use/def/live-in/live-out
// bitsets as decimal integers (a 64-bit word, one bit per tracked
// variable index — bit vi set means variable index vi).
// Same verification role regalloc_dump_cfg plays for Stage A: nothing
// in codegen reads liveness yet, so a human (or a test script grepping
// this output) is the only consumer. Called instead of
// regalloc_dump_cfg when the function name carries the
// "__rg_live_" prefix (see regalloc_name_wants_live_dump) — kept
// separate from the Stage A dump so a test fixture can opt into
// whichever stage's output it actually wants to check.
void regalloc_dump_liveness(blocks, fn_name) {
    auto n, i, b: CfgBlock;
    n = arr_struct_count(blocks);
    diag_str("LIVE ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" blocks");
    diag_newline();
    i = 0;
    while (i < n) {
        b = arr_struct_at(blocks, i);
        diag_str("  block ");
        diag_int(i);
        diag_str(": use=");
        diag_int(b.use_bits);
        diag_str(" def=");
        diag_int(b.def_bits);
        diag_str(" live_in=");
        diag_int(b.live_in);
        diag_str(" live_out=");
        diag_int(b.live_out);
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with "__rg_live_"? Mirrors
// regalloc_name_wants_dump exactly, for Stage B's own dump trigger.
regalloc_name_wants_live_dump(fn_name) {
    auto pfx_len;
    pfx_len = 10;   // length of "__rg_live_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_live_", pfx_len);
}

// ── RPO (Reverse Postorder) — Stage C's prerequisite sidequest ──────
//
// Stage C needs a LINEAR ORDER over the blocks that's faithful to real
// emission order, to flatten per-block liveness into per-variable
// position ranges. A block's own ALLOCATION index (the order
// _rg_new_block was called in) is NOT that order: any construct whose
// FIRST arm contains its own nested control flow allocates blocks for
// the inner construct with indices past blocks ALREADY allocated for
// what comes after the outer construct's own first arm. Concretely —
// confirmed by hand-tracing before writing this, not assumed —
// `while (c) { if (x) { while (y) { ... } } }`: the outer while's
// continue-block is allocated BEFORE its body is built (so the inner
// while's header/body/exit/continue all get LARGER indices), yet the
// inner while's body falls through back to that already-allocated,
// lower-indexed continue block at the end of every outer iteration —
// a real, non-cyclic edge from a higher index to a lower one, with no
// loop or back-edge involved at all.
//
// RPO is the standard fix (Poletto & Sarkar 1999's own linear-scan
// allocator uses exactly this) — it guarantees every block reachable
// via a forward (non-back) edge appears before its successor,
// regardless of allocation order. Computed via standard 3-colour DFS:
// a successor already ON THE CURRENT PATH (IN_PROGRESS) is a back-edge
// (the defining feature of a loop) and is never recursed into — this
// is what keeps the DFS terminating on a cyclic graph at all. A
// successor already FINISHED (DONE) was reached via a different path
// already (e.g. an if-arm and an else-arm both falling through to the
// same join block) and isn't re-visited either. RPO = postorder
// reversed.
//
// A block unreachable from the entry (the always-allocated-but-never-
// linked "tail" right after a T_BREAK/T_CONTINUE/T_RET) is correctly
// ABSENT from the result — dead code has no business in a linear
// order, and Stage C's interval construction only walks blocks RPO
// actually lists.
const _RG_NOTSEEN = 0; const _RG_INPROG = 1; const _RG_DONE = 2;

static _rg_rpo_visit(blocks, blk, state, postorder) {
    auto b: CfgBlock, s;
    arr_set(state, blk, _RG_INPROG);
    b = arr_struct_at(blocks, blk);
    if (b.succ_a >= 0) {
        s = arr_get(state, b.succ_a);
        if (s == _RG_NOTSEEN) { postorder = _rg_rpo_visit(blocks, b.succ_a, state, postorder); }
    }
    if (b.succ_b >= 0) {
        s = arr_get(state, b.succ_b);
        if (s == _RG_NOTSEEN) { postorder = _rg_rpo_visit(blocks, b.succ_b, state, postorder); }
    }
    arr_set(state, blk, _RG_DONE);
    postorder = arr_push(postorder, blk);
    return postorder;
}

// Returns an arr_new()-style array of block indices in RPO order,
// starting from block 0 (the function's entry, always allocated first
// by regalloc_build_cfg).
regalloc_compute_rpo(blocks) {
    auto n, state, postorder, i, rpo, k;
    n = arr_struct_count(blocks);
    state = arr_new();
    i = 0;
    while (i < n) { state = arr_push(state, _RG_NOTSEEN); i++; }
    postorder = arr_new();
    postorder = _rg_rpo_visit(blocks, 0, state, postorder);
    rpo = arr_new();
    k = arr_len(postorder) - 1;
    while (k >= 0) {
        rpo = arr_push(rpo, arr_get(postorder, k));
        k--;
    }
    return rpo;
}

// Debug dump for the RPO sidequest — prints the block indices in RPO
// order, one line. Verification tool, same role as the Stage A/B
// dumps: triggered by the "__rg_rpo_" function-name prefix.
void regalloc_dump_rpo(rpo, fn_name) {
    auto n, i;
    n = arr_len(rpo);
    diag_str("RPO ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": [");
    i = 0;
    while (i < n) {
        diag_int(arr_get(rpo, i));
        if (i < n - 1) { diag_str(","); }
        i++;
    }
    diag_str("]");
    diag_newline();
}

regalloc_name_wants_rpo_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_rpo_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_rpo_", pfx_len);
}

// ── Stage C — live-interval construction ────────────────────────────
//
// Flattens per-block liveness (Stage B) into one [start_pos, end_pos]
// range per variable, in STATEMENT-LEVEL position units: a monotonic
// counter that advances once per STATEMENT, walking blocks in RPO
// order and each block's own statements in source order — not one
// position per BLOCK. A long straight-line block with many sequential
// definitions and no branching (e.g. stb/stbdraw.bsm's blend_px: 13
// assignments in one block) would otherwise collapse every one of
// those variables onto the SAME shared position, making the linear-
// scan stage see them as all simultaneously live when most never
// coexist — found as a real false-regression in blend_px (B3 promoted
// x/y/src_color; linear-scan spilled them because the "spill furthest"
// heuristic picked them as the worst-end-pos victims once 16 unrelated
// variables all looked equally and simultaneously alive).
//
// Within one block, the liveness BETWEEN two statements is
// reconstructed backward from the block's own live_out (Stage B's
// already-correct per-block answer): walk the block's statements in
// REVERSE, tracking what's live immediately after each one (a
// statement's own use/def transforms that set exactly like the
// block-level dataflow equation does, just at one-statement
// granularity instead of one-block), then tag each variable's
// interval forward in increasing position order.
//
// Live-range SPLITTING: a variable can get MORE THAN ONE LiveInterval.
// `touched(k)` (computed in regalloc_compute_intervals below) already
// incorporates full liveness at position k, not just literal use/def
// at that one statement — so if a variable is absent from touched(k)
// for some k strictly between two positions where it IS present, it
// is genuinely dead there (the analysis already proved it, this isn't
// a guess), and the two sides become separate intervals instead of
// one wide one spanning the gap.
//
// This matters at instruction granularity specifically because of how
// RPO orders mutually-exclusive branches: the DFS that builds RPO
// (regalloc_compute_rpo) fully explores one arm (including anything
// nested inside it) before backtracking to a sibling arm, so a sibling
// that's a SHORT, mutually-exclusive alternative to a long nested
// branch can land far away in linear-position terms even though the
// two never execute together. Found in stb/stbdraw.bsm's blend_px: an
// early `if (sa==255) { put_px(x,y,src_color); return; }` and the
// function's final straight-line block both use x/y/src_color, but
// the early-return arm's RPO position falls AFTER the final block's —
// a single contiguous interval for x would (and, before splitting,
// did) span both, making linear-scan see x as alive across a stretch
// where it's actually dead. Splitting on detected gaps fixes this
// without needing to reorder RPO itself.
struct LiveInterval {
    var_idx,
    start_pos,   // statement-level position of first touch (this interval)
    end_pos      // statement-level position of last touch (this interval)
}

// Per-variable splitting state, tracked across the whole forward scan.
// open == 0 means no interval is currently open for this variable.
struct _RgSplitState {
    open,
    start_pos,
    last_pos     // the most recent position this variable was touched at
}

// Folds variable `vi` being touched at position `pos` into its
// splitting state, emitting (allocating into `intervals`) a finished
// LiveInterval whenever a gap is detected (this touch is not
// immediately adjacent to the last one) before opening the next one.
static void _rg_touch_interval(states, intervals, vi, pos) {
    auto st: _RgSplitState, it: LiveInterval;
    st = arr_struct_at(states, vi);
    if (st.open == 0) {
        st.open = 1;
        st.start_pos = pos;
        st.last_pos = pos;
        return;
    }
    if (pos == st.last_pos + 1) {
        st.last_pos = pos;
        return;
    }
    // Gap detected -- close the interval that just ended, open a new
    // one starting here.
    it = arr_struct_at(intervals, arr_struct_alloc(intervals));
    it.var_idx = vi;
    it.start_pos = st.start_pos;
    it.end_pos = st.last_pos;
    st.start_pos = pos;
    st.last_pos = pos;
}

// Closes every variable's still-open interval at the end of the scan
// (called once, after every position has been touched).
static void _rg_close_all_intervals(states, intervals) {
    auto vi, st: _RgSplitState, it: LiveInterval;
    vi = 0;
    while (vi < 64) {
        st = arr_struct_at(states, vi);
        if (st.open != 0) {
            it = arr_struct_at(intervals, arr_struct_alloc(intervals));
            it.var_idx = vi;
            it.start_pos = st.start_pos;
            it.end_pos = st.last_pos;
        }
        vi++;
    }
}

// Computes live intervals for every variable touched anywhere in
// `blocks`, walking `rpo` (regalloc_compute_rpo's own output) in
// block order and each block's own statement list in source order.
// Returns an arr_struct of LiveInterval (possibly several per
// variable — see the live-range-splitting comment above) — Stage D
// (linear-scan) is the first consumer; still nothing in codegen reads
// this.
regalloc_compute_intervals(blocks, rpo) {
    auto states, i, blk, b: CfgBlock, vi, intervals, n;
    auto k, nstmts, su, sd, cur, live_after, su_cache, sd_cache, pos, touched;
    auto st: _RgSplitState;
    n = arr_len(rpo);
    states = arr_struct_new(sizeof(_RgSplitState), 64);
    vi = 0;
    while (vi < 64) {
        st = arr_struct_at(states, arr_struct_alloc(states));
        st.open = 0;
        vi++;
    }
    intervals = arr_struct_new(sizeof(LiveInterval), 8);

    pos = 0;
    i = 0;
    while (i < n) {
        blk = arr_get(rpo, i);
        b = arr_struct_at(blocks, blk);
        nstmts = arr_len(b.stmts);

        // Pass 1 (backward): reconstruct each statement's own
        // "live immediately after" set from the block's live_out, and
        // cache each statement's own use/def alongside it (computed
        // once here, reused in pass 2 below instead of recomputing).
        live_after = arr_new(); su_cache = arr_new(); sd_cache = arr_new();
        k = 0;
        while (k < nstmts) {
            live_after = arr_push(live_after, 0);
            su_cache = arr_push(su_cache, 0);
            sd_cache = arr_push(sd_cache, 0);
            k++;
        }
        cur = b.live_out;
        k = nstmts - 1;
        while (k >= 0) {
            su, sd = _rg_stmt_use_def(arr_get(b.stmts, k));
            arr_set(live_after, k, cur);
            arr_set(su_cache, k, su);
            arr_set(sd_cache, k, sd);
            cur = su | (cur & ~sd);
            k--;
        }

        // Pass 2 (forward): touch each variable at its OWN statement's
        // global position, not the block's.
        k = 0;
        while (k < nstmts) {
            touched = arr_get(su_cache, k) | arr_get(sd_cache, k) | arr_get(live_after, k);
            vi = 0;
            while (vi < 64) {
                if ((touched & (1 << vi)) != 0) { _rg_touch_interval(states, intervals, vi, pos + k); }
                vi++;
            }
            k++;
        }
        pos = pos + nstmts;
        i++;
    }

    _rg_close_all_intervals(states, intervals);
    return intervals;
}

// Debug dump for Stage C — prints each variable's [start_pos, end_pos]
// interval, one per line, in increasing var_idx order (the loop above
// already walks vi from 0 to 63). Same verification role as every
// earlier stage's dump.
void regalloc_dump_intervals(intervals, fn_name) {
    auto n, i, it: LiveInterval;
    n = arr_struct_count(intervals);
    diag_str("IVL ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" intervals");
    diag_newline();
    i = 0;
    while (i < n) {
        it = arr_struct_at(intervals, i);
        diag_str("  var ");
        diag_int(it.var_idx);
        diag_str(": [");
        diag_int(it.start_pos);
        diag_str(",");
        diag_int(it.end_pos);
        diag_str("]");
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with "__rg_ivl_"? Mirrors the other stages'
// dump-trigger checks exactly.
regalloc_name_wants_ivl_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_ivl_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_ivl_", pfx_len);
}

// ── Stage D — linear-scan allocation (SHADOW MODE — not wired) ──────
//
// Poletto & Sarkar's own linear-scan algorithm (1999), the standard
// real allocators use: sort intervals by start position, scan left to
// right keeping a pool of free LOGICAL slots, assign a free slot to
// each new interval, release slots whose interval has expired, and
// spill (no slot) when the pool runs out — preferring to spill
// whichever interval (active or incoming) has the FURTHEST end_pos,
// since that frees a slot for the longest future stretch.
//
// Deliberately CHIP-AGNOSTIC: this only ever talks about a slot COUNT
// (`budget`, a plain integer the caller passes — e.g. 10 for the a64
// non-leaf integer pool today), never a physical register name. The
// translation from logical slot to physical register stays where B3
// already keeps it (_a64_b3_reg_at and its x64 sibling) — this stage
// only decides WHICH variable gets WHICH slot number, exactly the
// boundary Tonify's spine/chip split draws everywhere else in this
// compiler.
//
// SHADOW MODE: this stage's output isn't wired into cg_var_promote or
// anything else codegen reads yet. Before that swap (a future Stage E
// increment), its decisions need side-by-side validation against B3
// across the real test suite + real production code
// (games/rts2/rts2_combat.bsm's _combat_step) — not assumed correct
// just because the algorithm is textbook-standard.
struct RegAssign {
    var_idx,
    slot   // -1 = spilled (no register); >=0 = logical slot index
}

struct _RgActive {
    var_idx,
    end_pos,
    slot,
    dead   // 1 once expired — arr_struct has no remove, so expired
           // entries are marked dead and skipped rather than compacted
}

// Returns an arr_new()-style array of indices into `intervals`, in
// ascending start_pos order. Selection sort — interval counts are
// single digits to low tens per function, so O(n^2) is irrelevant;
// ties keep their original (var_idx-ascending) relative order, since
// the inner swap only fires on a STRICT `<`.
static _rg_sort_order_by_start(intervals) {
    auto n, order, i, j, tmp, a: LiveInterval, b: LiveInterval;
    n = arr_struct_count(intervals);
    order = arr_new();
    i = 0;
    while (i < n) { order = arr_push(order, i); i++; }
    i = 0;
    while (i < n) {
        j = i + 1;
        while (j < n) {
            a = arr_struct_at(intervals, arr_get(order, i));
            b = arr_struct_at(intervals, arr_get(order, j));
            if (b.start_pos < a.start_pos) {
                tmp = arr_get(order, i);
                arr_set(order, i, arr_get(order, j));
                arr_set(order, j, tmp);
            }
            j++;
        }
        i++;
    }
    return order;
}

// Finds `var_idx`'s entries in `assigns` (built earlier in the same
// scan, one entry per interval already processed) and forces ALL of
// them to -1 — used when an already-assigned active interval loses
// its slot to a later, longer-lived spill decision. A live-range-
// split variable can already own SEVERAL entries by this point (one
// per sub-interval already decided via the "decided != -2" reuse path
// in regalloc_linear_scan) — stopping at the first match would leave
// every earlier sub-interval's entry pointing at a slot this victim
// no longer holds (the incoming interval just took it), producing two
// live variables sharing one physical register. Visiting every match
// keeps every sub-interval's recorded slot consistent with the single
// decision now living in var_decided.
static void _rg_force_spill(assigns, var_idx) {
    auto n, i, asn: RegAssign;
    n = arr_struct_count(assigns);
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.var_idx == var_idx) { asn.slot = -1; }
        i++;
    }
}

// Computes a register assignment for every interval in `intervals`
// (Stage C's own output), against a logical slot budget of `budget`.
// Returns an arr_struct of RegAssign, one entry per interval — for a
// variable with NO live-range splitting that's the same as one entry
// per variable; for a SPLIT variable (more than one LiveInterval
// sharing a var_idx) every entry is guaranteed to carry the IDENTICAL
// slot (or all spill together) — see the envelope-reservation comment
// below for why and how. This guarantee is what lets Stage E's apply
// step (_a64_regalloc_apply / _a64_regalloc_apply_float,
// a64_codegen.bsm — ONE physical register per var_idx for the WHOLE
// function, no mechanism to change it mid-function) safely commit a
// split variable's swap: from Stage E's perspective a split variable
// is indistinguishable from one that was never split at all.
regalloc_linear_scan(intervals, budget) {
    auto order, n, i, idx, cur: LiveInterval, active, k, act: _RgActive;
    auto assigns, asn: RegAssign, free_slots, slot;
    auto worst_k, worst_end, worst_var;
    auto envelope_end, var_decided, vi2, cur2: LiveInterval, decided;

    // Precompute each var_idx's ENVELOPE end_pos — the max end_pos
    // across every LiveInterval entry sharing that var_idx. A split
    // variable is the SAME logical variable reused across two (or
    // more) non-overlapping sub-intervals; instead of letting the
    // FIRST sub-interval's slot go free the instant ITS OWN end_pos
    // passes (today's bug — regalloc_has_any_split exists precisely
    // because that could let something else claim the slot during the
    // gap, then collide when the variable's later sub-interval needs
    // it back), the slot is held through the entire envelope. The gap
    // between sub-intervals is treated as still "spoken for," exactly
    // as if Stage C had never split the interval in the first place.
    envelope_end = buf_word(64);
    vi2 = 0;
    while (vi2 < 64) { *(envelope_end + vi2 * 8) = -1; vi2++; }
    i = 0;
    while (i < arr_struct_count(intervals)) {
        cur2 = arr_struct_at(intervals, i);
        if (cur2.end_pos > *(envelope_end + cur2.var_idx * 8)) {
            *(envelope_end + cur2.var_idx * 8) = cur2.end_pos;
        }
        i++;
    }

    order = _rg_sort_order_by_start(intervals);
    n = arr_len(order);
    active = arr_struct_new(sizeof(_RgActive), 8);
    assigns = arr_struct_new(sizeof(RegAssign), n);
    free_slots = arr_new();
    slot = budget - 1;
    while (slot >= 0) { free_slots = arr_push(free_slots, slot); slot--; }

    // Per-var_idx decision cache: -2 ("not yet seen this scan") is a
    // sentinel distinct from every real outcome (a slot index, always
    // >= 0, or -1 for spill). The FIRST sub-interval of a var_idx runs
    // the full expire/allocate/spill logic below and records its
    // outcome here; every LATER sub-interval of the SAME var_idx skips
    // straight to that recorded outcome — this is what guarantees
    // every sub-interval of a split variable agrees.
    var_decided = buf_word(64);
    vi2 = 0;
    while (vi2 < 64) { *(var_decided + vi2 * 8) = -2; vi2++; }

    i = 0;
    while (i < n) {
        idx = arr_get(order, i);
        cur = arr_struct_at(intervals, idx);

        decided = *(var_decided + cur.var_idx * 8);
        if (decided != -2) {
            // A later sub-interval of a variable already decided —
            // the envelope reservation above already protects this
            // slot through this exact point, so no fresh allocation,
            // no expire/spill bookkeeping, just repeat the decision.
            asn = arr_struct_at(assigns, arr_struct_alloc(assigns));
            asn.var_idx = cur.var_idx;
            asn.slot = decided;
            i++;
            continue;
        }

        // EXPIRE: release any live active entry whose end_pos already
        // precedes this interval's start -- its slot is free again.
        k = 0;
        while (k < arr_struct_count(active)) {
            act = arr_struct_at(active, k);
            if (act.dead == 0 && act.end_pos < cur.start_pos) {
                free_slots = arr_push(free_slots, act.slot);
                act.dead = 1;
            }
            k++;
        }

        asn = arr_struct_at(assigns, arr_struct_alloc(assigns));
        asn.var_idx = cur.var_idx;

        if (arr_len(free_slots) > 0) {
            slot = arr_pop(free_slots);
            asn.slot = slot;
            act = arr_struct_at(active, arr_struct_alloc(active));
            act.var_idx = cur.var_idx;
            act.end_pos = *(envelope_end + cur.var_idx * 8);
            act.slot = slot;
            act.dead = 0;
        } else {
            // No free slot: spill whichever interval (the incoming one,
            // or one currently active) has the FURTHEST end_pos.
            worst_k = -1; worst_end = cur.end_pos; worst_var = -1;
            k = 0;
            while (k < arr_struct_count(active)) {
                act = arr_struct_at(active, k);
                if (act.dead == 0 && act.end_pos > worst_end) {
                    worst_end = act.end_pos; worst_k = k; worst_var = act.var_idx;
                }
                k++;
            }
            if (worst_k < 0) {
                // The incoming interval itself is the worst -- it spills,
                // every active assignment is untouched.
                asn.slot = -1;
            } else {
                // The active one at worst_k spills; the incoming interval
                // takes over its slot (and its place in `active`).
                act = arr_struct_at(active, worst_k);
                asn.slot = act.slot;
                _rg_force_spill(assigns, worst_var);
                *(var_decided + worst_var * 8) = -1;   // a later sub-interval of the SAME victim must also see spill
                act.var_idx = cur.var_idx;
                act.end_pos = *(envelope_end + cur.var_idx * 8);
            }
        }
        *(var_decided + cur.var_idx * 8) = asn.slot;
        i++;
    }

    return assigns;
}

// Debug dump for Stage D — prints each variable's slot assignment (or
// "spill"), in increasing var_idx order for a stable, comparable dump
// (RegAssign entries are built in start_pos-scan order, not var_idx
// order). Walks every possible variable index (0..63, the same single-
// word-bitset cap every earlier stage uses) and looks up its entry by
// linear search — n is tiny (single digits to low tens per function),
// so this is simpler and safer than sorting in place, and it never
// mutates `assigns` (display is read-only; a future stage may still
// need these exact values afterward). Same verification role as every
// earlier stage's dump.
void regalloc_dump_assignments(assigns, fn_name) {
    auto n, i, vi, asn: RegAssign;
    n = arr_struct_count(assigns);
    diag_str("ASN ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" vars");
    diag_newline();
    vi = 0;
    while (vi < 64) {
        i = 0;
        while (i < n) {
            asn = arr_struct_at(assigns, i);
            if (asn.var_idx == vi) {
                diag_str("  var ");
                diag_int(asn.var_idx);
                diag_str(": ");
                if (asn.slot < 0) { diag_str("spill"); } else { diag_str("slot "); diag_int(asn.slot); }
                diag_newline();
            }
            i++;
        }
        vi++;
    }
}

// Does `fn_name` start with "__rg_asn_"? Mirrors the other stages'
// dump-trigger checks exactly.
regalloc_name_wants_asn_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_asn_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_asn_", pfx_len);
}

// Does `fn_name` start with "__rg_swap_"? Stage E's own dump trigger —
// reports the four gate outcomes (B3-regression check, uncovered-
// mangled-slot check, live-range-split check, for each register
// class) PLUS whether the swap was actually applied, since none of
// the earlier dumps (CFG/liveness/RPO/intervals/assignments) show
// Stage E's final decision. Mirrors the other stages' prefix check
// exactly; see regalloc_dump_swap below for the printed shape.
regalloc_name_wants_swap_dump(fn_name) {
    auto pfx_len;
    pfx_len = 10;   // length of "__rg_swap_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_swap_", pfx_len);
}

// Print Stage E's full gate outcome for one function: whether linear-
// scan ever regressed against B3 (int/float separately), whether any
// B3-promoted mangled slot is still uncovered by Stage A's analysis,
// whether either register class needed live-range splitting, and
// whether the swap was actually applied for each class. This is the
// one piece of Stage E's reasoning none of the other dump stages
// (CFG/liveness/RPO/intervals/assignments) ever show on their own —
// a function can have perfectly clean intervals and assignments yet
// still fall back to B3 for a reason only visible here.
void regalloc_dump_swap(fn_name, worse, worse_flt, mangled, split, split_flt, applied_int, applied_flt) {
    diag_str("SWAP ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": worse=");
    diag_int(worse);
    diag_str(" worse_flt=");
    diag_int(worse_flt);
    diag_str(" mangled=");
    diag_int(mangled);
    diag_str(" split=");
    diag_int(split);
    diag_str(" split_flt=");
    diag_int(split_flt);
    diag_str(" applied_int=");
    diag_int(applied_int);
    diag_str(" applied_flt=");
    diag_int(applied_flt);
    diag_newline();
}

// ── Stage D validation — systematic comparison against B3 ───────────
//
// Before Stage E can read linear-scan's decisions for anything real,
// the plan's own gate requires confirming it is never WORSE than B3 —
// not just internally consistent. This runs unconditionally (every
// function, every compile) so the full test suite + every real game
// sweeps it for free, instead of checking a handful of hand-picked
// functions.

// Returns the slot Stage D assigned to variable `vi`, or -1 if it was
// spilled (or never touched — same thing for comparison purposes).
// Live-range splitting (Stage C) means variable `vi` may now own
// SEVERAL entries in `assigns` — one per split sub-interval, each with
// its own independently-decided slot. Returns the first slot >= 0
// found across all of them (preferring "got a real slot somewhere"
// over the first entry specifically) — -1 only if every sub-interval
// for `vi` spilled. Good enough for this comparison's purpose
// (B3 has no notion of split intervals at all, so the fairest
// comparison is "did linear-scan get vi into SOME register at all").
static _rg_assign_slot_for(assigns, vi) {
    auto n, i, asn: RegAssign, found;
    n = arr_struct_count(assigns);
    found = -1;
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.var_idx == vi && asn.slot >= 0) { return asn.slot; }
        if (asn.var_idx == vi) { found = asn.slot; }
        i++;
    }
    return found;
}

// Does variable `vi`'s name (looked up in `var_names`, the same
// cg_vars array B3 itself reads) start with the inliner's mangled-slot
// prefix "_inl"? Those slots (e.g. "_inl1_packed") are pre-registered
// by _inline_register_callsite_slots (bpp_dispatch.bsm) BEFORE the
// callee's body is actually spliced into the caller's tree — B3 reads
// their reference count from a number the inliner injects directly
// into cg_var_refs from a static analysis of the CALLEE's body, never
// from walking the caller's own AST. RegAlloc v2's CFG is built from
// the caller's REAL body (still un-spliced at this point in the
// pipeline — splicing happens later, during emission), so it
// genuinely cannot see these variables' uses yet — not a bug in this
// arc, a pipeline-ordering gap. Excluded from the comparison below
// until a future increment moves this analysis after inline splicing
// (or splices first, then analyses) instead of before it.
static _rg_is_mangled_inline_slot(var_names, vi) {
    auto nm;
    nm = arr_get(var_names, vi);
    if (unpack_l(nm) < 4) { return 0; }
    return buf_eq(vbuf + unpack_s(nm), "_inl", 4);
}

// Does `vi` appear as the var_idx of any LiveInterval in `intervals`?
// Linear scan — intervals per function are few enough that this is
// cheap, and it only runs once per mangled-promoted variable, not per
// statement.
static _rg_var_in_intervals(intervals, vi) {
    auto n, i, it: LiveInterval;
    n = arr_struct_count(intervals);
    i = 0;
    while (i < n) {
        it = arr_struct_at(intervals, i);
        if (it.var_idx == vi) { return 1; }
        i++;
    }
    return 0;
}

// Does `var_names[vi]`'s mangled name match one this function's
// expansions already KNOW was substituted in place rather than ever
// bound to a real slot (rg_known_substituted_names, accumulated
// across the whole function by _rg_expand_inline_straightline — see
// its own header comment)? A linear scan over a handful of entries —
// same cost class as _rg_var_in_intervals just above, and called from
// the exact same site, right after it.
static _rg_is_known_substituted(var_names, vi) {
    auto nm, n, i;
    nm = arr_get(var_names, vi);
    n = arr_len(rg_known_substituted_names);
    i = 0;
    while (i < n) {
        if (packed_eq(arr_get(rg_known_substituted_names, i), nm)) { return 1; }
        i++;
    }
    return 0;
}

// Stage E's own extra gate, beyond regalloc_compare_vs_b3. The
// original (now superseded — git log has its own header for the full
// story) version refused the swap whenever B3 promoted ANY mangled
// inline slot at all, full stop: RegAlloc v2's CFG/intervals used to
// be built only from the caller's un-spliced body, so a mangled
// slot's register was completely invisible to the linear-scan that
// ran — it could (and, on stb/stbfilter.bsm's moog_taps, did) pick
// the SAME physical register for one of its own variables, because
// nothing told it that slot was already spoken for. Found via
// `bug --disasm`: corrupted output (0.0 instead of a real filtered
// value), no crash, no diagnostic — just silently wrong.
//
// The "RegAlloc v2 sees through inlined call sites" arc (this file's
// own top header) has since taught Stage A to recursively expand a
// wide and growing set of real inlined-call shapes (straight-line,
// multi-statement, nested, multi-return, struct writes, switch-of-
// returns) directly into real intervals for those mangled slots — so
// the blanket refusal became needlessly conservative; most of the
// real DSP chain's mangled slots ARE covered today. This function
// refuses the swap only when a mangled slot B3 promoted genuinely has
// NO interval anywhere in this function's analysis (neither pool) AND
// is not a KNOWN-substituted slot (_rg_is_known_substituted) — the
// actual signature of "this shape is still invisible to Stage A," not
// merely "this function happens to contain a mangled slot at all." A
// mangled slot that DOES have a real interval was reached by one of
// the expansion shapes this arc supports, and its liveness is exactly
// as trustworthy as any native local's. A mangled slot Stage A KNOWS
// was substituted (bind_needed==0 — _inline_param_needs_bind,
// bpp_codegen.bsm) has no interval for an entirely different, equally
// safe reason: pre-reg always registers it in cg_vars (and computes
// its cg_var_refs from the callee's ORIGINAL body, before bind_needed
// is even decided), so B3 can rank and promote it purely on that stale
// ref count — but the real splice never emits a single reference to
// it, every one was rewritten to the caller's own argument instead.
// The "promoted" register is reserved yet genuinely untouched by B3,
// so linear-scan handing that same physical register to one of its
// own variables collides with nothing real.
regalloc_has_uncovered_mangled_promoted(b3_promote, var_names, ivl_int, ivl_flt) {
    auto n, vi;
    n = arr_len(b3_promote);
    vi = 0;
    while (vi < n) {
        if (arr_get(b3_promote, vi) >= 0 && _rg_is_mangled_inline_slot(var_names, vi) != 0) {
            if (_rg_var_in_intervals(ivl_int, vi) == 0 && _rg_var_in_intervals(ivl_flt, vi) == 0) {
                if (_rg_is_known_substituted(var_names, vi) == 0) { return 1; }
            }
        }
        vi++;
    }
    return 0;
}

// Compares Stage D's assignment against B3's actual decision
// (`b3_promote` is cg_var_promote itself — arr_get(b3_promote, vi) >= 0
// means B3 promoted vi to a register). Prints one REGRESSION line per
// offending variable and returns the count: a variable B3 promoted
// that linear-scan spilled is the ONE outcome Stage E must never
// introduce when it eventually replaces B3's decision with this one.
// The reverse (linear-scan promotes something B3 spilled, or two
// variables sharing a slot) is the whole POINT of this arc, not a
// regression — only checked in the b3-promoted -> linear-scan-spilled
// direction. `var_names` (cg_vars) is consulted to skip the inliner's
// mangled slots — see _rg_is_mangled_inline_slot's own comment for why
// those are a known, out-of-scope gap rather than a real regression.
// `var_forced_ty` (cg_var_forced_ty) + `want_float` restrict the sweep
// to variables of ONE register class — int and float promotions live
// in disjoint physical pools (x19..x28 vs d8..d15) and are computed by
// two SEPARATE linear-scan runs (different budgets, different
// intervals), so `assigns` here only ever covers one class at a time.
// Without this filter, comparing a float-only `assigns` against the
// full b3_promote (which also holds B3's int picks) would report
// every B3-promoted int as a false "linear-scan spilled it" — it was
// never asked to consider that variable at all.
regalloc_compare_vs_b3(assigns, b3_promote, var_names, var_forced_ty, want_float, fn_name) {
    auto n, vi, b3_slot, ls_slot, worse, is_flt;
    n = arr_len(b3_promote);
    worse = 0;
    vi = 0;
    while (vi < n) {
        b3_slot = arr_get(b3_promote, vi);
        is_flt = is_float_type(arr_get(var_forced_ty, vi));
        if (b3_slot >= 0 && is_flt == want_float && _rg_is_mangled_inline_slot(var_names, vi) == 0) {
            ls_slot = _rg_assign_slot_for(assigns, vi);
            if (ls_slot < 0) {
                diag_str("REGRESSION ");
                diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
                diag_str(": B3 promoted var ");
                diag_int(vi);
                diag_str(" but linear-scan spilled it");
                diag_newline();
                worse = worse + 1;
            }
        }
        vi++;
    }
    return worse;
}

// Returns a NEW arr_struct of LiveInterval containing only the
// entries whose variable matches `want_float` (1 = float, 0 =
// everything else) — int and float promotion are two separate
// physical pools, so Stage D's linear-scan must run once per class
// with its own intervals and its own budget, never mixed.
regalloc_filter_intervals_by_type(intervals, var_forced_ty, want_float) {
    auto n, i, it: LiveInterval, out, out_it: LiveInterval, is_flt;
    n = arr_struct_count(intervals);
    out = arr_struct_new(sizeof(LiveInterval), 8);
    i = 0;
    while (i < n) {
        it = arr_struct_at(intervals, i);
        is_flt = is_float_type(arr_get(var_forced_ty, it.var_idx));
        if (is_flt == want_float) {
            out_it = arr_struct_at(out, arr_struct_alloc(out));
            out_it.var_idx = it.var_idx;
            out_it.start_pos = it.start_pos;
            out_it.end_pos = it.end_pos;
        }
        i++;
    }
    return out;
}

// ── Stage E support — is this function safe to wire up? ────────────
//
// A variable with live-range splitting can own several LiveInterval
// entries (different sub-intervals, never overlapping in time).
// regalloc_linear_scan's own envelope-reservation scheme (see its
// header comment) now GUARANTEES every sub-interval of a split
// variable lands on the identical slot (or all spill together) — the
// chip-side swap (regalloc_apply) writes ONE physical register per
// variable into cg_var_promote for the WHOLE function, and a split
// variable is now indistinguishable from one that was never split at
// all from Stage E's point of view. So this is no longer the primary
// mechanism that makes the swap safe — it's a SAFETY NET: takes
// Stage D's own output (`assigns`, NOT the raw intervals) and flags
// only a genuine inconsistency, two RegAssign entries for the same
// var_idx with DIFFERENT slots. With the envelope fix in place this
// should never fire in practice; keeping the check means a future
// regression in that logic still gets caught here instead of
// silently corrupting output, the same defense-in-depth Stage E's
// other gates (regalloc_compare_vs_b3,
// regalloc_has_uncovered_mangled_promoted) already follow.
regalloc_has_any_split(assigns) {
    auto n, i, asn: RegAssign, seen_slot, vi;
    n = arr_struct_count(assigns);
    seen_slot = buf_word(64);
    vi = 0;
    while (vi < 64) { *(seen_slot + vi * 8) = -2; vi++; }   // -2 = not seen yet
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (*(seen_slot + asn.var_idx * 8) == -2) {
            *(seen_slot + asn.var_idx * 8) = asn.slot;
        } else if (*(seen_slot + asn.var_idx * 8) != asn.slot) {
            return 1;
        }
        i++;
    }
    return 0;
}
