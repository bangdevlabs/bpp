// bpp_regalloc.bsm — RegAlloc v2: real liveness-based register allocation.
//
// Today's B3 (bpp_codegen.bsm's cg_b3_walk + each chip's _<chip>_b3_select)
// ranks local variables by total reference count and promotes the top N
// into callee-saved registers. It has no notion of WHEN a variable is
// alive — two variables that never coexist (one dies before the other is
// born) compete for the same promotion budget as if they were rivals,
// when they could safely share one physical register. Closing that gap
// needs a real liveness-based allocator: explicit control-flow graph,
// liveness dataflow, live intervals, linear-scan assignment, coalescing.
// See docs/plans/compiler_boost_roadmap.md (section F.2) for the full
// staged design and the measured evidence that motivates it (tl_bench's
// flat/oracle gap persisting after every call and accumulator shuttle is
// gone; games/rts2/rts2_combat.bsm's _combat_step needing more
// simultaneously-live registers than even the widened B3 pool provides).
//
// Stage A (this file, today): AST-to-CFG construction only. Builds an
// explicit basic-block graph per function. Pure read-only analysis —
// nothing in codegen consumes its output yet; later stages (liveness,
// intervals, linear-scan, the eventual swap into cg_var_promote) are
// future increments, each verified before touching anything live.
//
// A T_SWITCH is modelled as a CHAIN of 2-way branches (one per arm, in
// declaration order, falling through to "else" last) rather than a
// single N-way block — mirrors exactly how bpp_dispatch.bsm's
// _inline_normalize_switch_ret already treats this same node shape as a
// sequence of binary comparisons. Keeps every CfgBlock at a uniform "at
// most 2 successors" shape, so no later stage (liveness, intervals)
// needs to special-case an N-way construct.

import "bpp_defs.bsm";
import "bpp_array.bsm";
import "bpp_arr.bsm";

// One basic block: a maximal straight-line statement sequence with a
// single entry and at most two successors. An unconditional fallthrough
// or jump uses succ_a only (succ_b stays -1); a real branch (the two
// arms of an if, a loop's continue-or-exit test, one switch arm's
// pass/fail) uses both; a block ending in T_RET — or an unreachable
// tail right after T_BREAK/T_CONTINUE/T_RET — uses neither.
// use_bits/def_bits/live_in/live_out are Stage B's liveness fields —
// 0 until regalloc_compute_liveness runs. Each is a single-word bitset
// (bit vi = variable index vi), capping tracked variables per function
// at 64 — the largest function measured during this whole arc's
// motivating investigation (games/rts2/rts2_combat.bsm's _combat_step,
// 14 simultaneously-live integers) is comfortably under that, and nine
// elsewhere checked the same day topped out lower still; revisit with a
// real multi-word bitset only if a function is ever found that needs
// it, not speculatively.
struct CfgBlock {
    stmts,      // arr_new()-style growable array of statement-node pointers
    succ_a,     // -1 if none
    succ_b,     // -1 if none
    dead,       // 1 if unreachable BY CONSTRUCTION (the tail allocated
                // right after a T_RET/T_BREAK/T_CONTINUE) -- never link
                // ANY successor to it, even though it starts with the
                // same succ_a<0 && succ_b<0 shape a genuinely open block
                // has. See _rg_link_fallthrough's own comment for the
                // phantom-edge bug this field exists to prevent.
    use_bits,   // read in this block before any def in the SAME block
    def_bits,   // written somewhere in this block
    live_in,    // live at block entry
    live_out    // live at block exit
}

// Per-function CFG-under-construction state. Reset at the top of every
// regalloc_build_cfg call (mirrors cg_vars / cg_var_promote's own
// per-function reset convention in bpp_codegen.bsm) — nothing here
// persists across functions.
global rg_blocks;          // arr_struct of CfgBlock for the function currently being built
global rg_cur_block;       // index of the block statements are currently appended to
global rg_break_stack;     // arr_new() of block indices (break targets)
global rg_continue_stack;  // arr_new() of block indices (continue targets)

// Initialize the regalloc module. Call once at startup, mirroring
// init_dispatch()'s own convention — the real per-function state is set
// fresh by regalloc_build_cfg every time, so this just establishes safe
// defaults before the first function is ever compiled.
void init_regalloc() {
    rg_blocks = 0;
    rg_cur_block = -1;
    rg_break_stack = arr_new();
    rg_continue_stack = arr_new();
}

// Allocate a fresh, empty block in the function currently under
// construction. Returns its index.
static _rg_new_block() {
    auto idx, b: CfgBlock;
    idx = arr_struct_alloc(rg_blocks);
    b = arr_struct_at(rg_blocks, idx);
    b.stmts = arr_new();
    b.succ_a = -1;
    b.succ_b = -1;
    b.dead = 0;
    b.use_bits = 0;
    b.def_bits = 0;
    b.live_in = 0;
    b.live_out = 0;
    return idx;
}

// Allocate the "unreachable tail" block that follows a T_RET/T_BREAK/
// T_CONTINUE. Execution can never actually fall into it (the statement
// right before it always transfers control away unconditionally), so
// it is marked dead immediately — _rg_link_fallthrough must never wire
// a real edge to it, even though right after allocation it has the
// exact same succ_a<0 && succ_b<0 shape a genuinely still-open block
// has. Found by hand-tracing stb/stbdraw.bsm's blend_px (four
// sequential early-return ifs): without this, _rg_link_fallthrough
// linked each dead tail to the NEXT if's join block, fabricating a
// phantom edge that made every later variable look live across the
// whole chain — corrupting liveness for the rest of the function, not
// just at that one tail.
static _rg_new_dead_block() {
    auto idx, b: CfgBlock;
    idx = _rg_new_block();
    b = arr_struct_at(rg_blocks, idx);
    b.dead = 1;
    return idx;
}

// Append a statement-node pointer to the currently-open block.
static void _rg_emit(nd) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, rg_cur_block);
    b.stmts = arr_push(b.stmts, nd);
}

// Unconditionally set a block's successors — used at the exact points a
// branch/jump/return is known explicitly (a condition's two arms, a
// break, a continue, a return, a loop's back-edge). Never used for
// "falls through to whatever comes next" — that path is
// _rg_link_fallthrough below, which respects a block that already
// terminated itself via a nested return/break/continue.
static void _rg_set_succ(blk, a, b_) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, blk);
    b.succ_a = a;
    b.succ_b = b_;
}

// Link a block to `target` ONLY if it has no explicit successor yet. A
// nested T_RET/T_BREAK/T_CONTINUE inside an if/while/switch arm already
// set succ_a via _rg_set_succ — that decision must never be overwritten
// by the generic "falls through to the join block" edge the caller adds
// once the whole construct's shape is known.
static void _rg_link_fallthrough(blk, target) {
    auto b: CfgBlock;
    b = arr_struct_at(rg_blocks, blk);
    if (b.dead == 0 && b.succ_a < 0 && b.succ_b < 0) { b.succ_a = target; }
}

// Build the CFG for one statement, updating rg_cur_block to whatever
// block is open once it returns. Mirrors cg_emit_stmt's own per-node
// dispatch shape (bpp_codegen.bsm) — only the CONTROL-FLOW shape
// matters here; any statement that doesn't split blocks is just
// appended to whatever block is currently open.
static _rg_build_stmt(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;

    if (t == T_IF) {
        auto cond_blk, if_entry, else_entry, if_exit, else_exit, join_blk, has_else;
        cond_blk = rg_cur_block;
        _rg_emit(n.a);
        has_else = (n.e > 0);
        if_entry = _rg_new_block();
        if (has_else) {
            else_entry = _rg_new_block();
            _rg_set_succ(cond_blk, if_entry, else_entry);
        } else {
            else_entry = -1;
        }
        rg_cur_block = if_entry;
        _rg_build_body(n.b, n.c);
        if_exit = rg_cur_block;
        if (has_else) {
            rg_cur_block = else_entry;
            _rg_build_body(n.d, n.e);
            else_exit = rg_cur_block;
        } else {
            else_exit = -1;
        }
        join_blk = _rg_new_block();
        if (has_else == 0) { _rg_set_succ(cond_blk, if_entry, join_blk); }
        _rg_link_fallthrough(if_exit, join_blk);
        if (has_else) { _rg_link_fallthrough(else_exit, join_blk); }
        rg_cur_block = join_blk;
        return 0;
    }

    if (t == T_WHILE) {
        auto prev_blk, header_blk, body_entry, exit_blk, continue_blk, body_exit, step_node;
        step_node = n.e;
        prev_blk = rg_cur_block;
        header_blk = _rg_new_block();
        _rg_link_fallthrough(prev_blk, header_blk);
        rg_cur_block = header_blk;
        _rg_emit(n.a);

        body_entry = _rg_new_block();
        exit_blk = _rg_new_block();
        continue_blk = _rg_new_block();
        _rg_set_succ(header_blk, body_entry, exit_blk);

        rg_break_stack = arr_push(rg_break_stack, exit_blk);
        rg_continue_stack = arr_push(rg_continue_stack, continue_blk);

        rg_cur_block = body_entry;
        _rg_build_body(n.b, n.c);
        body_exit = rg_cur_block;
        _rg_link_fallthrough(body_exit, continue_blk);

        arr_pop(rg_break_stack);
        arr_pop(rg_continue_stack);

        rg_cur_block = continue_blk;
        if (step_node != 0) { _rg_emit(step_node); }
        _rg_set_succ(continue_blk, header_blk, -1);

        rg_cur_block = exit_blk;
        return 0;
    }

    if (t == T_BREAK) {
        _rg_emit(nd);
        if (arr_len(rg_break_stack) > 0) {
            _rg_set_succ(rg_cur_block, arr_last(rg_break_stack), -1);
        }
        // Dead tail, kept so a statement after `break;` in the same
        // arm still has somewhere safe to land — but never linkable
        // (see _rg_new_dead_block's own comment).
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_CONTINUE) {
        _rg_emit(nd);
        if (arr_len(rg_continue_stack) > 0) {
            _rg_set_succ(rg_cur_block, arr_last(rg_continue_stack), -1);
        }
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_RET) {
        _rg_emit(nd);
        _rg_set_succ(rg_cur_block, -1, -1);
        rg_cur_block = _rg_new_dead_block();
        return 0;
    }

    if (t == T_SWITCH) {
        // Layout (bpp_parser.bsm's parse_switch): n.a=condition,
        // n.b=arm_values (interleaved [vals_arr, vcnt] per arm),
        // n.c=arm_count, n.d/n.e=else body/count,
        // n.src_tok=arm_bodies (interleaved [body_arr, bcnt] per arm).
        auto arm_values, arm_bodies, arm_count, k, join_blk, test_blk, body_blk, next_test;
        auto exits, ei, ab, bc;
        arm_values = n.b; arm_bodies = n.src_tok; arm_count = n.c;
        exits = arr_new();
        test_blk = rg_cur_block;
        _rg_emit(n.a);

        k = 0;
        while (k < arm_count) {
            body_blk = _rg_new_block();
            next_test = _rg_new_block();
            _rg_set_succ(test_blk, body_blk, next_test);
            rg_cur_block = body_blk;
            ab = arm_bodies[k * 2]; bc = arm_bodies[k * 2 + 1];
            _rg_build_body(ab, bc);
            exits = arr_push(exits, rg_cur_block);
            test_blk = next_test;
            k++;
        }
        if (n.e > 0) {
            rg_cur_block = test_blk;
            _rg_build_body(n.d, n.e);
            exits = arr_push(exits, rg_cur_block);
        } else {
            exits = arr_push(exits, test_blk);   // no else: falls straight to join
        }
        join_blk = _rg_new_block();
        ei = 0;
        while (ei < arr_len(exits)) {
            _rg_link_fallthrough(arr_get(exits, ei), join_blk);
            ei++;
        }
        rg_cur_block = join_blk;
        return 0;
    }

    if (t == T_BLOCK) {
        _rg_build_body(n.b, n.c);
        return 0;
    }

    // Plain statement (T_ASSIGN, T_MEMST, T_DECL, expression-statement,
    // etc.) — none of these split blocks, just append.
    _rg_emit(nd);
    return 0;
}

static _rg_build_body(arr, cnt) {
    auto i;
    i = 0;
    while (i < cnt) {
        _rg_build_stmt(arr[i]);
        i++;
    }
    return 0;
}

// Build the CFG for one whole function body. Resets per-function state,
// allocates the entry block, walks the body, and returns the `rg_blocks`
// handle (an arr_struct of CfgBlock) for the caller to keep, dump, or
// (future stages) analyse further. Falling off the end of the body with
// no explicit T_RET (a void function, or one whose last statement is
// plain code) leaves the final block's successors at (-1,-1) by
// construction — exactly the same "no successor" shape an explicit
// T_RET produces, since function exit either way has nothing after it.
regalloc_build_cfg(body_arr, body_cnt) -> ptr {
    rg_blocks = arr_struct_new(sizeof(CfgBlock), 16);
    rg_break_stack = arr_new();
    rg_continue_stack = arr_new();
    rg_cur_block = _rg_new_block();
    _rg_build_body(body_arr, body_cnt);
    return rg_blocks;
}

// Debug dump: prints block count + per-block statement count and
// successor edges. The verification tool for this stage — nothing in
// codegen consumes the CFG yet, so this is how its correctness gets
// checked (by a human reading the dump, or a test script grepping it).
// Mirrors --show-deps's own diag_str/diag_int/diag_newline self-printing
// convention (bpp.bpp). `fn_name` is the function's packed name
// (offset+length into vbuf, same representation FN_NAME always carries)
// — printed via diag_buf exactly like --show-deps prints module names.
void regalloc_dump_cfg(blocks, fn_name) {
    auto n, i, b: CfgBlock;
    n = arr_struct_count(blocks);
    diag_str("CFG ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" blocks");
    diag_newline();
    i = 0;
    while (i < n) {
        b = arr_struct_at(blocks, i);
        diag_str("  block ");
        diag_int(i);
        diag_str(": ");
        diag_int(arr_len(b.stmts));
        diag_str(" stmts, succ=(");
        diag_int(b.succ_a);
        diag_str(",");
        diag_int(b.succ_b);
        diag_str(")");
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with the debug-dump trigger prefix
// "__rg_dump_"? A function named this way gets its CFG printed (via
// regalloc_dump_cfg) the moment it's built — the test-facing hook for
// this stage, since nothing else observes the CFG yet. Avoids adding a
// new CLI flag + a persistent cross-function CFG table purely for
// verification purposes; a future stage that wires the CFG into real
// codegen decisions will need that persistence anyway, at which point
// this hook stays exactly as useful without having pre-built unneeded
// plumbing today.
regalloc_name_wants_dump(fn_name) {
    auto pfx_len;
    pfx_len = 10;   // length of "__rg_dump_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_dump_", pfx_len);
}

// ── Stage B — liveness analysis ─────────────────────────────────────
//
// Classic backward dataflow over Stage A's CFG: for each block, compute
// live_in/live_out (which LOCAL variables — globals are never B3/regalloc
// candidates, so they're not tracked at all) are live, iterating until
// nothing changes. Per-block working sets are a single 64-bit word
// (bit vi = variable index vi, from the SAME cg_var_idx every other
// codegen pass already uses) — see CfgBlock's own field comment for why
// one word is enough for every function measured so far.

// The bit for variable index `vi`, or 0 if vi is untracked (not a local
// at all — cg_var_idx returns -1 for globals/unknowns — or past the
// 64-variable cap this single-word bitset enforces).
static _rg_var_bit(vi) {
    if (vi < 0 || vi >= 64) { return 0; }
    return 1 << vi;
}

// Every local variable an EXPRESSION reads, as a bitset. Expressions
// never define a variable on their own (only T_ASSIGN's target, T_MEMST's
// address/value being assignment-adjacent statements handle that) — this
// is pure use-side, recursing into every expression-shaped node type the
// AST has.
static _rg_expr_uses(nd) {
    auto n: Node, t, bits, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_VAR) { return _rg_var_bit(cg_var_idx(n.a)); }
    if (t == T_BINOP) { return _rg_expr_uses(n.b) | _rg_expr_uses(n.c); }
    if (t == T_UNARY) { return _rg_expr_uses(n.b); }
    if (t == T_MEMLD) { return _rg_expr_uses(n.a); }
    // &x — address-taken. cg_b3_eligible already excludes address-taken
    // locals from promotion entirely (their value must live at a stable
    // frame address), so this stage doesn't need to do anything special
    // with the bit beyond recording the read for completeness.
    if (t == T_ADDR) { return _rg_expr_uses(n.a); }
    if (t == T_TERNARY) { return _rg_expr_uses(n.a) | _rg_expr_uses(n.b) | _rg_expr_uses(n.c); }
    if (t == T_CALL) {
        arr = n.b; cnt = n.c; bits = 0;
        i = 0;
        while (i < cnt) { bits = bits | _rg_expr_uses(arr[i]); i++; }
        return bits;
    }
    return 0;   // T_LIT, T_DECL, T_NOP, T_BREAK, T_CONTINUE: no reads
}

// One statement's own (use, def) bit pair. The use side reflects every
// variable READ by this statement regardless of what it also defines —
// `x = x + 1` both uses and defines x, and the read must count since
// x's incoming value matters. T_ASSIGN.a is always a plain T_VAR (or,
// for a multi-target assignment, T_ASSIGN.c is an array of plain T_VAR —
// confirmed directly in bpp_parser.bsm's parse_assign: any LHS that is
// itself a T_MEMLD becomes a T_MEMST instead, so T_ASSIGN's own target
// side is never a complex address).
static _rg_stmt_use_def(nd) {
    auto n: Node, t, use_bits, def_bits, vi, arr, cnt, i, tnode: Node;
    use_bits = 0; def_bits = 0;
    if (nd == 0) { return use_bits, def_bits; }
    n = nd; t = n.ntype;

    if (t == T_ASSIGN) {
        use_bits = _rg_expr_uses(n.b);
        if (n.d > 1) {
            arr = n.c; cnt = n.d;
            i = 0;
            while (i < cnt) {
                tnode = arr[i];
                if (tnode != 0 && tnode.ntype == T_VAR) {
                    def_bits = def_bits | _rg_var_bit(cg_var_idx(tnode.a));
                }
                i++;
            }
        } else if (n.a != 0 && n.a.ntype == T_VAR) {
            def_bits = _rg_var_bit(cg_var_idx(n.a.a));
        }
        return use_bits, def_bits;
    }
    // A store THROUGH an address — the base var is read (the address is
    // computed FROM it), never written; only what it points to changes,
    // which liveness over LOCAL VARIABLES has no bit for.
    if (t == T_MEMST) {
        use_bits = _rg_expr_uses(n.a) | _rg_expr_uses(n.b);
        return use_bits, def_bits;
    }
    if (t == T_RET) {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            i = 0;
            while (i < cnt) { use_bits = use_bits | _rg_expr_uses(arr[i]); i++; }
        } else {
            use_bits = _rg_expr_uses(n.a);
        }
        return use_bits, def_bits;
    }
    if (t == T_DECL || t == T_BREAK || t == T_CONTINUE || t == T_NOP) {
        return use_bits, def_bits;
    }
    // A bare expression-statement (e.g. a void-returning T_CALL used in
    // statement position) or a control-flow condition node this stage
    // hands directly to _rg_emit (T_IF/T_WHILE/T_SWITCH's own n.a) —
    // pure use, no def.
    use_bits = _rg_expr_uses(nd);
    return use_bits, def_bits;
}

// Computes block `blk`'s own use_bits/def_bits from its statement list,
// in order — a read only counts as a block-level "use" if no EARLIER
// statement in the same block already defined that variable (the
// classic kill-then-gen sequencing liveness needs to be exact).
static void _rg_compute_block_use_def(blocks, blk) {
    auto b: CfgBlock, i, n, su, sd, killed, use_acc, def_acc;
    b = arr_struct_at(blocks, blk);
    n = arr_len(b.stmts);
    killed = 0; use_acc = 0; def_acc = 0;
    i = 0;
    while (i < n) {
        su, sd = _rg_stmt_use_def(arr_get(b.stmts, i));
        use_acc = use_acc | (su & ~killed);
        killed = killed | sd;
        def_acc = def_acc | sd;
        i++;
    }
    b.use_bits = use_acc;
    b.def_bits = def_acc;
}

// Computes live_in/live_out for every block in `blocks` (a handle
// returned by regalloc_build_cfg). Backward dataflow to a fixpoint —
// no block's live set can shrink once grown (a variable, once proven
// live, stays live until the iteration that correctly narrows it), so
// a simple "did anything change this pass" loop converges to the exact
// answer, same fixpoint-to-convergence shape classify_inlineable's own
// Inc 6 loop already uses (bpp_dispatch.bsm). Pure analysis — still
// nothing in codegen reads live_in/live_out yet; Stage C (live
// intervals) is the first consumer.
void regalloc_compute_liveness(blocks) {
    auto n, i, changed, b: CfgBlock, sb: CfgBlock, new_out, new_in;
    n = arr_struct_count(blocks);
    i = 0;
    while (i < n) {
        _rg_compute_block_use_def(blocks, i);
        i++;
    }
    changed = 1;
    while (changed) {
        changed = 0;
        i = 0;
        while (i < n) {
            b = arr_struct_at(blocks, i);
            new_out = 0;
            if (b.succ_a >= 0) { sb = arr_struct_at(blocks, b.succ_a); new_out = new_out | sb.live_in; }
            if (b.succ_b >= 0) { sb = arr_struct_at(blocks, b.succ_b); new_out = new_out | sb.live_in; }
            new_in = b.use_bits | (new_out & ~b.def_bits);
            if (new_out != b.live_out || new_in != b.live_in) {
                b.live_out = new_out;
                b.live_in = new_in;
                changed = 1;
            }
            i++;
        }
    }
}

// Debug dump for Stage B — prints each block's use/def/live-in/live-out
// bitsets as decimal integers (a 64-bit word, one bit per tracked
// variable index — bit vi set means variable index vi).
// Same verification role regalloc_dump_cfg plays for Stage A: nothing
// in codegen reads liveness yet, so a human (or a test script grepping
// this output) is the only consumer. Called instead of
// regalloc_dump_cfg when the function name carries the
// "__rg_live_" prefix (see regalloc_name_wants_live_dump) — kept
// separate from the Stage A dump so a test fixture can opt into
// whichever stage's output it actually wants to check.
void regalloc_dump_liveness(blocks, fn_name) {
    auto n, i, b: CfgBlock;
    n = arr_struct_count(blocks);
    diag_str("LIVE ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" blocks");
    diag_newline();
    i = 0;
    while (i < n) {
        b = arr_struct_at(blocks, i);
        diag_str("  block ");
        diag_int(i);
        diag_str(": use=");
        diag_int(b.use_bits);
        diag_str(" def=");
        diag_int(b.def_bits);
        diag_str(" live_in=");
        diag_int(b.live_in);
        diag_str(" live_out=");
        diag_int(b.live_out);
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with "__rg_live_"? Mirrors
// regalloc_name_wants_dump exactly, for Stage B's own dump trigger.
regalloc_name_wants_live_dump(fn_name) {
    auto pfx_len;
    pfx_len = 10;   // length of "__rg_live_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_live_", pfx_len);
}

// ── RPO (Reverse Postorder) — Stage C's prerequisite sidequest ──────
//
// Stage C needs a LINEAR ORDER over the blocks that's faithful to real
// emission order, to flatten per-block liveness into per-variable
// position ranges. A block's own ALLOCATION index (the order
// _rg_new_block was called in) is NOT that order: any construct whose
// FIRST arm contains its own nested control flow allocates blocks for
// the inner construct with indices past blocks ALREADY allocated for
// what comes after the outer construct's own first arm. Concretely —
// confirmed by hand-tracing before writing this, not assumed —
// `while (c) { if (x) { while (y) { ... } } }`: the outer while's
// continue-block is allocated BEFORE its body is built (so the inner
// while's header/body/exit/continue all get LARGER indices), yet the
// inner while's body falls through back to that already-allocated,
// lower-indexed continue block at the end of every outer iteration —
// a real, non-cyclic edge from a higher index to a lower one, with no
// loop or back-edge involved at all.
//
// RPO is the standard fix (Poletto & Sarkar 1999's own linear-scan
// allocator uses exactly this) — it guarantees every block reachable
// via a forward (non-back) edge appears before its successor,
// regardless of allocation order. Computed via standard 3-colour DFS:
// a successor already ON THE CURRENT PATH (IN_PROGRESS) is a back-edge
// (the defining feature of a loop) and is never recursed into — this
// is what keeps the DFS terminating on a cyclic graph at all. A
// successor already FINISHED (DONE) was reached via a different path
// already (e.g. an if-arm and an else-arm both falling through to the
// same join block) and isn't re-visited either. RPO = postorder
// reversed.
//
// A block unreachable from the entry (the always-allocated-but-never-
// linked "tail" right after a T_BREAK/T_CONTINUE/T_RET) is correctly
// ABSENT from the result — dead code has no business in a linear
// order, and Stage C's interval construction only walks blocks RPO
// actually lists.
const _RG_NOTSEEN = 0; const _RG_INPROG = 1; const _RG_DONE = 2;

static _rg_rpo_visit(blocks, blk, state, postorder) {
    auto b: CfgBlock, s;
    arr_set(state, blk, _RG_INPROG);
    b = arr_struct_at(blocks, blk);
    if (b.succ_a >= 0) {
        s = arr_get(state, b.succ_a);
        if (s == _RG_NOTSEEN) { postorder = _rg_rpo_visit(blocks, b.succ_a, state, postorder); }
    }
    if (b.succ_b >= 0) {
        s = arr_get(state, b.succ_b);
        if (s == _RG_NOTSEEN) { postorder = _rg_rpo_visit(blocks, b.succ_b, state, postorder); }
    }
    arr_set(state, blk, _RG_DONE);
    postorder = arr_push(postorder, blk);
    return postorder;
}

// Returns an arr_new()-style array of block indices in RPO order,
// starting from block 0 (the function's entry, always allocated first
// by regalloc_build_cfg).
regalloc_compute_rpo(blocks) {
    auto n, state, postorder, i, rpo, k;
    n = arr_struct_count(blocks);
    state = arr_new();
    i = 0;
    while (i < n) { state = arr_push(state, _RG_NOTSEEN); i++; }
    postorder = arr_new();
    postorder = _rg_rpo_visit(blocks, 0, state, postorder);
    rpo = arr_new();
    k = arr_len(postorder) - 1;
    while (k >= 0) {
        rpo = arr_push(rpo, arr_get(postorder, k));
        k--;
    }
    return rpo;
}

// Debug dump for the RPO sidequest — prints the block indices in RPO
// order, one line. Verification tool, same role as the Stage A/B
// dumps: triggered by the "__rg_rpo_" function-name prefix.
void regalloc_dump_rpo(rpo, fn_name) {
    auto n, i;
    n = arr_len(rpo);
    diag_str("RPO ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": [");
    i = 0;
    while (i < n) {
        diag_int(arr_get(rpo, i));
        if (i < n - 1) { diag_str(","); }
        i++;
    }
    diag_str("]");
    diag_newline();
}

regalloc_name_wants_rpo_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_rpo_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_rpo_", pfx_len);
}

// ── Stage C — live-interval construction ────────────────────────────
//
// Flattens per-block liveness (Stage B) into one [start_pos, end_pos]
// range per variable, in STATEMENT-LEVEL position units: a monotonic
// counter that advances once per STATEMENT, walking blocks in RPO
// order and each block's own statements in source order — not one
// position per BLOCK. A long straight-line block with many sequential
// definitions and no branching (e.g. stb/stbdraw.bsm's blend_px: 13
// assignments in one block) would otherwise collapse every one of
// those variables onto the SAME shared position, making the linear-
// scan stage see them as all simultaneously live when most never
// coexist — found as a real false-regression in blend_px (B3 promoted
// x/y/src_color; linear-scan spilled them because the "spill furthest"
// heuristic picked them as the worst-end-pos victims once 16 unrelated
// variables all looked equally and simultaneously alive).
//
// Within one block, the liveness BETWEEN two statements is
// reconstructed backward from the block's own live_out (Stage B's
// already-correct per-block answer): walk the block's statements in
// REVERSE, tracking what's live immediately after each one (a
// statement's own use/def transforms that set exactly like the
// block-level dataflow equation does, just at one-statement
// granularity instead of one-block), then tag each variable's
// interval forward in increasing position order.
//
// Live-range SPLITTING: a variable can get MORE THAN ONE LiveInterval.
// `touched(k)` (computed in regalloc_compute_intervals below) already
// incorporates full liveness at position k, not just literal use/def
// at that one statement — so if a variable is absent from touched(k)
// for some k strictly between two positions where it IS present, it
// is genuinely dead there (the analysis already proved it, this isn't
// a guess), and the two sides become separate intervals instead of
// one wide one spanning the gap.
//
// This matters at instruction granularity specifically because of how
// RPO orders mutually-exclusive branches: the DFS that builds RPO
// (regalloc_compute_rpo) fully explores one arm (including anything
// nested inside it) before backtracking to a sibling arm, so a sibling
// that's a SHORT, mutually-exclusive alternative to a long nested
// branch can land far away in linear-position terms even though the
// two never execute together. Found in stb/stbdraw.bsm's blend_px: an
// early `if (sa==255) { put_px(x,y,src_color); return; }` and the
// function's final straight-line block both use x/y/src_color, but
// the early-return arm's RPO position falls AFTER the final block's —
// a single contiguous interval for x would (and, before splitting,
// did) span both, making linear-scan see x as alive across a stretch
// where it's actually dead. Splitting on detected gaps fixes this
// without needing to reorder RPO itself.
struct LiveInterval {
    var_idx,
    start_pos,   // statement-level position of first touch (this interval)
    end_pos      // statement-level position of last touch (this interval)
}

// Per-variable splitting state, tracked across the whole forward scan.
// open == 0 means no interval is currently open for this variable.
struct _RgSplitState {
    open,
    start_pos,
    last_pos     // the most recent position this variable was touched at
}

// Folds variable `vi` being touched at position `pos` into its
// splitting state, emitting (allocating into `intervals`) a finished
// LiveInterval whenever a gap is detected (this touch is not
// immediately adjacent to the last one) before opening the next one.
static void _rg_touch_interval(states, intervals, vi, pos) {
    auto st: _RgSplitState, it: LiveInterval;
    st = arr_struct_at(states, vi);
    if (st.open == 0) {
        st.open = 1;
        st.start_pos = pos;
        st.last_pos = pos;
        return;
    }
    if (pos == st.last_pos + 1) {
        st.last_pos = pos;
        return;
    }
    // Gap detected -- close the interval that just ended, open a new
    // one starting here.
    it = arr_struct_at(intervals, arr_struct_alloc(intervals));
    it.var_idx = vi;
    it.start_pos = st.start_pos;
    it.end_pos = st.last_pos;
    st.start_pos = pos;
    st.last_pos = pos;
}

// Closes every variable's still-open interval at the end of the scan
// (called once, after every position has been touched).
static void _rg_close_all_intervals(states, intervals) {
    auto vi, st: _RgSplitState, it: LiveInterval;
    vi = 0;
    while (vi < 64) {
        st = arr_struct_at(states, vi);
        if (st.open != 0) {
            it = arr_struct_at(intervals, arr_struct_alloc(intervals));
            it.var_idx = vi;
            it.start_pos = st.start_pos;
            it.end_pos = st.last_pos;
        }
        vi++;
    }
}

// Computes live intervals for every variable touched anywhere in
// `blocks`, walking `rpo` (regalloc_compute_rpo's own output) in
// block order and each block's own statement list in source order.
// Returns an arr_struct of LiveInterval (possibly several per
// variable — see the live-range-splitting comment above) — Stage D
// (linear-scan) is the first consumer; still nothing in codegen reads
// this.
regalloc_compute_intervals(blocks, rpo) {
    auto states, i, blk, b: CfgBlock, vi, intervals, n;
    auto k, nstmts, su, sd, cur, live_after, su_cache, sd_cache, pos, touched;
    auto st: _RgSplitState;
    n = arr_len(rpo);
    states = arr_struct_new(sizeof(_RgSplitState), 64);
    vi = 0;
    while (vi < 64) {
        st = arr_struct_at(states, arr_struct_alloc(states));
        st.open = 0;
        vi++;
    }
    intervals = arr_struct_new(sizeof(LiveInterval), 8);

    pos = 0;
    i = 0;
    while (i < n) {
        blk = arr_get(rpo, i);
        b = arr_struct_at(blocks, blk);
        nstmts = arr_len(b.stmts);

        // Pass 1 (backward): reconstruct each statement's own
        // "live immediately after" set from the block's live_out, and
        // cache each statement's own use/def alongside it (computed
        // once here, reused in pass 2 below instead of recomputing).
        live_after = arr_new(); su_cache = arr_new(); sd_cache = arr_new();
        k = 0;
        while (k < nstmts) {
            live_after = arr_push(live_after, 0);
            su_cache = arr_push(su_cache, 0);
            sd_cache = arr_push(sd_cache, 0);
            k++;
        }
        cur = b.live_out;
        k = nstmts - 1;
        while (k >= 0) {
            su, sd = _rg_stmt_use_def(arr_get(b.stmts, k));
            arr_set(live_after, k, cur);
            arr_set(su_cache, k, su);
            arr_set(sd_cache, k, sd);
            cur = su | (cur & ~sd);
            k--;
        }

        // Pass 2 (forward): touch each variable at its OWN statement's
        // global position, not the block's.
        k = 0;
        while (k < nstmts) {
            touched = arr_get(su_cache, k) | arr_get(sd_cache, k) | arr_get(live_after, k);
            vi = 0;
            while (vi < 64) {
                if ((touched & (1 << vi)) != 0) { _rg_touch_interval(states, intervals, vi, pos + k); }
                vi++;
            }
            k++;
        }
        pos = pos + nstmts;
        i++;
    }

    _rg_close_all_intervals(states, intervals);
    return intervals;
}

// Debug dump for Stage C — prints each variable's [start_pos, end_pos]
// interval, one per line, in increasing var_idx order (the loop above
// already walks vi from 0 to 63). Same verification role as every
// earlier stage's dump.
void regalloc_dump_intervals(intervals, fn_name) {
    auto n, i, it: LiveInterval;
    n = arr_struct_count(intervals);
    diag_str("IVL ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" intervals");
    diag_newline();
    i = 0;
    while (i < n) {
        it = arr_struct_at(intervals, i);
        diag_str("  var ");
        diag_int(it.var_idx);
        diag_str(": [");
        diag_int(it.start_pos);
        diag_str(",");
        diag_int(it.end_pos);
        diag_str("]");
        diag_newline();
        i++;
    }
}

// Does `fn_name` start with "__rg_ivl_"? Mirrors the other stages'
// dump-trigger checks exactly.
regalloc_name_wants_ivl_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_ivl_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_ivl_", pfx_len);
}

// ── Stage D — linear-scan allocation (SHADOW MODE — not wired) ──────
//
// Poletto & Sarkar's own linear-scan algorithm (1999), the standard
// real allocators use: sort intervals by start position, scan left to
// right keeping a pool of free LOGICAL slots, assign a free slot to
// each new interval, release slots whose interval has expired, and
// spill (no slot) when the pool runs out — preferring to spill
// whichever interval (active or incoming) has the FURTHEST end_pos,
// since that frees a slot for the longest future stretch.
//
// Deliberately CHIP-AGNOSTIC: this only ever talks about a slot COUNT
// (`budget`, a plain integer the caller passes — e.g. 10 for the a64
// non-leaf integer pool today), never a physical register name. The
// translation from logical slot to physical register stays where B3
// already keeps it (_a64_b3_reg_at and its x64 sibling) — this stage
// only decides WHICH variable gets WHICH slot number, exactly the
// boundary Tonify's spine/chip split draws everywhere else in this
// compiler.
//
// SHADOW MODE: this stage's output isn't wired into cg_var_promote or
// anything else codegen reads yet. Before that swap (a future Stage E
// increment), its decisions need side-by-side validation against B3
// across the real test suite + real production code
// (games/rts2/rts2_combat.bsm's _combat_step) — not assumed correct
// just because the algorithm is textbook-standard.
struct RegAssign {
    var_idx,
    slot   // -1 = spilled (no register); >=0 = logical slot index
}

struct _RgActive {
    var_idx,
    end_pos,
    slot,
    dead   // 1 once expired — arr_struct has no remove, so expired
           // entries are marked dead and skipped rather than compacted
}

// Returns an arr_new()-style array of indices into `intervals`, in
// ascending start_pos order. Selection sort — interval counts are
// single digits to low tens per function, so O(n^2) is irrelevant;
// ties keep their original (var_idx-ascending) relative order, since
// the inner swap only fires on a STRICT `<`.
static _rg_sort_order_by_start(intervals) {
    auto n, order, i, j, tmp, a: LiveInterval, b: LiveInterval;
    n = arr_struct_count(intervals);
    order = arr_new();
    i = 0;
    while (i < n) { order = arr_push(order, i); i++; }
    i = 0;
    while (i < n) {
        j = i + 1;
        while (j < n) {
            a = arr_struct_at(intervals, arr_get(order, i));
            b = arr_struct_at(intervals, arr_get(order, j));
            if (b.start_pos < a.start_pos) {
                tmp = arr_get(order, i);
                arr_set(order, i, arr_get(order, j));
                arr_set(order, j, tmp);
            }
            j++;
        }
        i++;
    }
    return order;
}

// Finds `var_idx`'s own entry in `assigns` (built earlier in the same
// scan, one entry per interval already processed) and forces it to -1
// — used when an already-assigned active interval loses its slot to a
// later, longer-lived spill decision.
static void _rg_force_spill(assigns, var_idx) {
    auto n, i, asn: RegAssign;
    n = arr_struct_count(assigns);
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.var_idx == var_idx) { asn.slot = -1; return; }
        i++;
    }
}

// Computes a register assignment for every interval in `intervals`
// (Stage C's own output), against a logical slot budget of `budget`.
// Returns an arr_struct of RegAssign, one entry per variable. SHADOW
// MODE — see this section's own header comment; nothing reads this
// yet.
regalloc_linear_scan(intervals, budget) {
    auto order, n, i, idx, cur: LiveInterval, active, k, act: _RgActive;
    auto assigns, asn: RegAssign, free_slots, slot;
    auto worst_k, worst_end, worst_var;

    order = _rg_sort_order_by_start(intervals);
    n = arr_len(order);
    active = arr_struct_new(sizeof(_RgActive), 8);
    assigns = arr_struct_new(sizeof(RegAssign), n);
    free_slots = arr_new();
    slot = budget - 1;
    while (slot >= 0) { free_slots = arr_push(free_slots, slot); slot--; }

    i = 0;
    while (i < n) {
        idx = arr_get(order, i);
        cur = arr_struct_at(intervals, idx);

        // EXPIRE: release any live active entry whose end_pos already
        // precedes this interval's start -- its slot is free again.
        k = 0;
        while (k < arr_struct_count(active)) {
            act = arr_struct_at(active, k);
            if (act.dead == 0 && act.end_pos < cur.start_pos) {
                free_slots = arr_push(free_slots, act.slot);
                act.dead = 1;
            }
            k++;
        }

        asn = arr_struct_at(assigns, arr_struct_alloc(assigns));
        asn.var_idx = cur.var_idx;

        if (arr_len(free_slots) > 0) {
            slot = arr_pop(free_slots);
            asn.slot = slot;
            act = arr_struct_at(active, arr_struct_alloc(active));
            act.var_idx = cur.var_idx;
            act.end_pos = cur.end_pos;
            act.slot = slot;
            act.dead = 0;
        } else {
            // No free slot: spill whichever interval (the incoming one,
            // or one currently active) has the FURTHEST end_pos.
            worst_k = -1; worst_end = cur.end_pos; worst_var = -1;
            k = 0;
            while (k < arr_struct_count(active)) {
                act = arr_struct_at(active, k);
                if (act.dead == 0 && act.end_pos > worst_end) {
                    worst_end = act.end_pos; worst_k = k; worst_var = act.var_idx;
                }
                k++;
            }
            if (worst_k < 0) {
                // The incoming interval itself is the worst -- it spills,
                // every active assignment is untouched.
                asn.slot = -1;
            } else {
                // The active one at worst_k spills; the incoming interval
                // takes over its slot (and its place in `active`).
                act = arr_struct_at(active, worst_k);
                asn.slot = act.slot;
                _rg_force_spill(assigns, worst_var);
                act.var_idx = cur.var_idx;
                act.end_pos = cur.end_pos;
            }
        }
        i++;
    }
    return assigns;
}

// Debug dump for Stage D — prints each variable's slot assignment (or
// "spill"), in increasing var_idx order for a stable, comparable dump
// (RegAssign entries are built in start_pos-scan order, not var_idx
// order). Walks every possible variable index (0..63, the same single-
// word-bitset cap every earlier stage uses) and looks up its entry by
// linear search — n is tiny (single digits to low tens per function),
// so this is simpler and safer than sorting in place, and it never
// mutates `assigns` (display is read-only; a future stage may still
// need these exact values afterward). Same verification role as every
// earlier stage's dump.
void regalloc_dump_assignments(assigns, fn_name) {
    auto n, i, vi, asn: RegAssign;
    n = arr_struct_count(assigns);
    diag_str("ASN ");
    diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
    diag_str(": ");
    diag_int(n);
    diag_str(" vars");
    diag_newline();
    vi = 0;
    while (vi < 64) {
        i = 0;
        while (i < n) {
            asn = arr_struct_at(assigns, i);
            if (asn.var_idx == vi) {
                diag_str("  var ");
                diag_int(asn.var_idx);
                diag_str(": ");
                if (asn.slot < 0) { diag_str("spill"); } else { diag_str("slot "); diag_int(asn.slot); }
                diag_newline();
            }
            i++;
        }
        vi++;
    }
}

// Does `fn_name` start with "__rg_asn_"? Mirrors the other stages'
// dump-trigger checks exactly.
regalloc_name_wants_asn_dump(fn_name) {
    auto pfx_len;
    pfx_len = 9;   // length of "__rg_asn_"
    if (unpack_l(fn_name) < pfx_len) { return 0; }
    return buf_eq(vbuf + unpack_s(fn_name), "__rg_asn_", pfx_len);
}

// ── Stage D validation — systematic comparison against B3 ───────────
//
// Before Stage E can read linear-scan's decisions for anything real,
// the plan's own gate requires confirming it is never WORSE than B3 —
// not just internally consistent. This runs unconditionally (every
// function, every compile) so the full test suite + every real game
// sweeps it for free, instead of checking a handful of hand-picked
// functions.

// Returns the slot Stage D assigned to variable `vi`, or -1 if it was
// spilled (or never touched — same thing for comparison purposes).
// Live-range splitting (Stage C) means variable `vi` may now own
// SEVERAL entries in `assigns` — one per split sub-interval, each with
// its own independently-decided slot. Returns the first slot >= 0
// found across all of them (preferring "got a real slot somewhere"
// over the first entry specifically) — -1 only if every sub-interval
// for `vi` spilled. Good enough for this comparison's purpose
// (B3 has no notion of split intervals at all, so the fairest
// comparison is "did linear-scan get vi into SOME register at all").
static _rg_assign_slot_for(assigns, vi) {
    auto n, i, asn: RegAssign, found;
    n = arr_struct_count(assigns);
    found = -1;
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.var_idx == vi && asn.slot >= 0) { return asn.slot; }
        if (asn.var_idx == vi) { found = asn.slot; }
        i++;
    }
    return found;
}

// Does variable `vi`'s name (looked up in `var_names`, the same
// cg_vars array B3 itself reads) start with the inliner's mangled-slot
// prefix "_inl"? Those slots (e.g. "_inl1_packed") are pre-registered
// by _inline_register_callsite_slots (bpp_dispatch.bsm) BEFORE the
// callee's body is actually spliced into the caller's tree — B3 reads
// their reference count from a number the inliner injects directly
// into cg_var_refs from a static analysis of the CALLEE's body, never
// from walking the caller's own AST. RegAlloc v2's CFG is built from
// the caller's REAL body (still un-spliced at this point in the
// pipeline — splicing happens later, during emission), so it
// genuinely cannot see these variables' uses yet — not a bug in this
// arc, a pipeline-ordering gap. Excluded from the comparison below
// until a future increment moves this analysis after inline splicing
// (or splices first, then analyses) instead of before it.
static _rg_is_mangled_inline_slot(var_names, vi) {
    auto nm;
    nm = arr_get(var_names, vi);
    if (unpack_l(nm) < 4) { return 0; }
    return buf_eq(vbuf + unpack_s(nm), "_inl", 4);
}

// Compares Stage D's assignment against B3's actual decision
// (`b3_promote` is cg_var_promote itself — arr_get(b3_promote, vi) >= 0
// means B3 promoted vi to a register). Prints one REGRESSION line per
// offending variable and returns the count: a variable B3 promoted
// that linear-scan spilled is the ONE outcome Stage E must never
// introduce when it eventually replaces B3's decision with this one.
// The reverse (linear-scan promotes something B3 spilled, or two
// variables sharing a slot) is the whole POINT of this arc, not a
// regression — only checked in the b3-promoted -> linear-scan-spilled
// direction. `var_names` (cg_vars) is consulted to skip the inliner's
// mangled slots — see _rg_is_mangled_inline_slot's own comment for why
// those are a known, out-of-scope gap rather than a real regression.
regalloc_compare_vs_b3(assigns, b3_promote, var_names, fn_name) {
    auto n, vi, b3_slot, ls_slot, worse;
    n = arr_len(b3_promote);
    worse = 0;
    vi = 0;
    while (vi < n) {
        b3_slot = arr_get(b3_promote, vi);
        if (b3_slot >= 0 && _rg_is_mangled_inline_slot(var_names, vi) == 0) {
            ls_slot = _rg_assign_slot_for(assigns, vi);
            if (ls_slot < 0) {
                diag_str("REGRESSION ");
                diag_buf(vbuf + unpack_s(fn_name), unpack_l(fn_name));
                diag_str(": B3 promoted var ");
                diag_int(vi);
                diag_str(" but linear-scan spilled it");
                diag_newline();
                worse = worse + 1;
            }
        }
        vi++;
    }
    return worse;
}

// ── Stage E support — is this function safe to wire up? ────────────
//
// A variable with live-range splitting can own several LiveInterval
// entries (different sub-intervals, possibly different slots, never
// overlapping in time). The chip-side swap (regalloc_apply) writes ONE
// physical register per variable into cg_var_promote — there is no
// codegen support today for moving a value between two different
// registers at a split boundary. Rather than build that (separable
// future work — Stage F territory, the same shape as coalescing),
// Stage E simply refuses the swap for any function where splitting
// happened at all, falling back to B3 entirely for that function.
// Conservative, but correct: B3 never had this problem in the first
// place (it has no notion of split ranges), so refusing is always
// SAFE, only ever a missed opportunity.
regalloc_has_any_split(intervals) {
    auto n, i, it: LiveInterval, seen, vi;
    n = arr_struct_count(intervals);
    seen = arr_new();
    vi = 0;
    while (vi < 64) { seen = arr_push(seen, 0); vi++; }
    i = 0;
    while (i < n) {
        it = arr_struct_at(intervals, i);
        if (arr_get(seen, it.var_idx) != 0) { return 1; }
        arr_set(seen, it.var_idx, 1);
        i++;
    }
    return 0;
}
