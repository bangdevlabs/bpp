// x64_primitives.bsm — x86_64 implementation of the
// chip_primitives contract consumed by `cg_prim` in bpp_codegen.bsm.
//
// Each primitive is the smallest unit of chip-specific instruction
// emission. The portable spine in bpp_codegen.bsm calls them
// through `cg_prim.<slot> = fn_ptr(_x64_<slot>)` populated in
// `init_codegen_x86_64()`. Primitives stay dumb: no AST awareness,
// no register allocation, no decision logic — just emit the
// instruction bytes for the requested operation.
//
// Asymmetry with a64: x86_64 only emits binary; there is no
// `_x64_bin_mode` toggle. The asm-text legacy lane lives on a64
// only, so x64 primitives are shorter than their a64 counterparts.
//
// File grows wave by wave during the Phase 3.4 migration. See
// docs/phase_3_4_chip_primitives.md for the contract and order.

import "x64_enc.bsm";

extrn x64_ret_lbl;

// Phase 6.3 v2 — read by `_x64_emit_frame_teardown` to decide
// whether to wrap the epilogue with a `_prof_save_drain` call.
// Set per function in `cg_emit_func`.
extrn cg_cur_fn_has_profile;
extrn _zone_save_drain_p;
extrn x64_fn_lbl;

// ── Move / compare ──

// Set the result register (rax) to zero. `xor rax, rax` is the
// shortest encoding (3 bytes) that also breaks any false
// dependency on rax — chosen by the existing inline path so the
// primitive matches byte-for-byte.
void _x64_emit_mov_zero() {
    x64_enc_xor_zero(0);
}

// Set the result register (rax) to a 64-bit immediate. The
// encoder picks the shortest mov form that fits the value
// (mov r32, imm32 / mov r64, imm64 / xor for zero) — match the
// existing inline path byte-for-byte.
void _x64_emit_mov_imm(val) {
    x64_enc_mov_wide(0, val);
}

// Load the address of a string literal into rax via
// `lea rax, [rip + _str_<sid>]`. The relocation slot is fixed up
// by the linker; type=1 means string-table.
void _x64_emit_load_str_addr(sid) {
    auto dpos;
    dpos = x64_enc_lea_rip(0);
    x64_enc_add_reloc(dpos, sid, 1);
}

// Load a float constant from the const pool into xmm0 via
// `movsd xmm0, [rip + _flt_<fid>]`. Relocation type=2 (float).
void _x64_emit_load_float_const(fid) {
    auto dpos;
    dpos = x64_enc_load_sd_rip(0);
    x64_enc_add_reloc(dpos, fid, 2);
}
// Unreachable: simd_temp_count() == 0 keeps the whole float-CIP gate from
// ever firing on x64, same as every other F.2.c primitive — filled in
// for primitive-table completeness only.
void _x64_emit_fconst_into(dreg, fid) {
    auto dpos;
    dpos = x64_enc_load_sd_rip(dreg);
    x64_enc_add_reloc(dpos, fid, 2);
}

// ── Arithmetic / logical (Wave 4 unary ops) ──

// Negate the integer result register (rax ← -rax).
void _x64_emit_neg() {
    x64_enc_neg(0);
}

// Negate the float result register (xmm0 ← -xmm0). x86_64 lacks
// a dedicated fneg, so the existing pattern uses a scratch xmm:
// xor xmm1, xmm1 (zero) → subsd xmm1, xmm0 (= -xmm0) → movsd
// xmm0, xmm1. Three instructions; matches the inline path.
void _x64_emit_fneg() {
    x64_enc_xorpd(1, 1);
    x64_enc_subsd(1, 0);
    x64_enc_movsd_reg(0, 1);
}

// Bitwise NOT on the integer result register (rax ← ~rax).
void _x64_emit_not() {
    x64_enc_not(0);
}

// ── BINOP arithmetic (Wave 5) ──
// Convention: rax holds LHS (popped from stack), rcx holds RHS,
// result lands in rax. Both registers are fixed by the chip's
// T_BINOP scheduler; the `left_reg` parameter from the contract
// is ignored on x64 because there is no freelist alternative —
// the LHS always ends up in rax via push/pop. The parameter
// stays in the signature for cross-chip uniformity at the spine.

void _x64_emit_add(left_reg) { x64_enc_add_reg(0, 1); }
void _x64_emit_sub(left_reg) { x64_enc_sub_reg(0, 1); }
void _x64_emit_mul(left_reg) { x64_enc_imul(0, 1); }
// Signed division on x86_64: sign-extend rax into rdx via cqo,
// then idiv rcx leaves quotient in rax.
void _x64_emit_div(left_reg) { x64_enc_cqo(); x64_enc_idiv(1); }
// Modulo reuses idiv but reads the remainder out of rdx (reg 2)
// into rax.
void _x64_emit_mod(left_reg) { x64_enc_cqo(); x64_enc_idiv(1); x64_enc_mov_reg(0, 2); }

void _x64_emit_and(left_reg) { x64_enc_and_reg(0, 1); }
void _x64_emit_or(left_reg)  { x64_enc_or_reg(0, 1); }
void _x64_emit_xor(left_reg) { x64_enc_xor_reg(0, 1); }
// Shift count must live in cl (low 8 bits of rcx). The chip
// ensures rcx already holds the RHS by the time we get here.
void _x64_emit_shl(left_reg) { x64_enc_shl_cl(0); }
void _x64_emit_shr(left_reg) { x64_enc_sar_cl(0); }

// Unsigned division on x86_64: zero rdx via xor rdx, rdx; then
// `div rcx` divides RDX:RAX by rcx with quotient in rax. Used
// by the BASE_UWORD smart-dispatch (`: u_word` annotation) to
// avoid sign-extension on the high bits.
void _x64_emit_udiv(left_reg) { x64_enc_xor_reg(2, 2); x64_enc_div(1); }
// Unsigned modulo: same div, then move remainder out of rdx
// (reg 2) into rax.
void _x64_emit_umod(left_reg) { x64_enc_xor_reg(2, 2); x64_enc_div(1); x64_enc_mov_reg(0, 2); }
// Logical shift right (zero-fill). Distinct from _x64_emit_shr
// which uses SAR (sign-fill) on the signed path.
void _x64_emit_lshr(left_reg) { x64_enc_shr_cl(0); }

// Immediate-form shifts of the accumulator (rax): the value is already in rax
// and the count is a compile-time constant, so no cl staging is needed.
// SAR keeps the signed `>>`; SHR is the logical `:u_word` variant.
void _x64_emit_shl_imm(amt)  { x64_enc_shl_imm(0, amt); }
void _x64_emit_shr_imm(amt)  { x64_enc_sar_imm(0, amt); }
void _x64_emit_lshr_imm(amt) { x64_enc_shr_imm(0, amt); }

// Float arithmetic. xmm1 = LHS, xmm0 = RHS. Result in xmm0.
// addsd / mulsd are commutative so they can target xmm0
// directly with xmm1 as src; subsd / divsd need a result-swap
// via subsd into xmm1 then movsd back into xmm0.
void _x64_emit_fadd() { x64_enc_addsd(0, 1); }
void _x64_emit_fsub() { x64_enc_subsd(1, 0); x64_enc_movsd_reg(0, 1); }
void _x64_emit_fmul() { x64_enc_mulsd(0, 1); }
void _x64_emit_fdiv() { x64_enc_divsd(1, 0); x64_enc_movsd_reg(0, 1); }

// ── F.2.c compute-in-place hooks — x86_64 opts OUT BY DESIGN ──
// This is an architectural opt-out for the baseline x86_64 / SysV target,
// not a pending TODO. The F.2.c speed-up came almost entirely from its
// Stage 2 — promoting hot `: float` locals into CALLEE-SAVED d8..d15 so
// they survive the whole loop. SysV AMD64 has ZERO callee-saved xmm
// registers (all xmm0..xmm15 are caller-saved), so that stage has no
// target band here — it cannot be ported. Stage 1 (compute-in-place)
// measured ~0% even on a64, and would be worse on x86's two-operand ISA
// (`c = a OP b` needs movsd + op, vs a64's single 3-operand fadd). So
// simd_temp_count returns 0, the spine's gate (need <= count) never fires,
// and the correct accumulator path stays. A future x86-64-v3 target (with
// a real float allocator) could revisit; the baseline target will not.
void _x64_emit_fload_var_into(dreg, off) { x64_enc_load_sd(dreg, 5, off); }
// Unreachable for the same reason as _x64_emit_fload_var_into above
// (simd_temp_count == 0 keeps the gate from ever firing) — filled in for
// primitive-table completeness, not because x64 exercises it.
void _x64_emit_fload_promoted_into(dreg, base_reg, off) { x64_enc_load_sd(dreg, base_reg, off); }
void _x64_emit_fload_mem_into(dreg, addr_reg) { x64_enc_load_sd(dreg, addr_reg, 0); }
void _x64_emit_fop_into(op_code, dreg, s1, s2) {
    // SSE2 is 2-operand (dreg OP= src). op 0=add 1=sub 2=mul 3=div. Handle
    // dreg == s2 (dest aliases the right operand) like the int path: commutative
    // ops apply s1 in place; sub/div route through the reserved scratch xmm15.
    if (dreg == s2) {
        if (op_code == 0) { x64_enc_addsd(dreg, s1); return 0; }
        if (op_code == 2) { x64_enc_mulsd(dreg, s1); return 0; }
        x64_enc_movsd_reg(15, s1);
        if (op_code == 1) { x64_enc_subsd(15, s2); }
        else { x64_enc_divsd(15, s2); }
        x64_enc_movsd_reg(dreg, 15);
        return 0;
    }
    if (dreg != s1) { x64_enc_movsd_reg(dreg, s1); }
    if (op_code == 1) { x64_enc_subsd(dreg, s2); return 0; }
    if (op_code == 2) { x64_enc_mulsd(dreg, s2); return 0; }
    if (op_code == 3) { x64_enc_divsd(dreg, s2); return 0; }
    x64_enc_addsd(dreg, s2);
    return 0;
}
// x86_64 has no float FMA at BASELINE (SSE2), so by default has_float_fma=0
// gates the fusion off and the CIP decomposes to mulsd + addsd — safe on any
// Linux x86_64. Under --fma (x86-64-v3 / Haswell 2013+) the chip has FMA3, so
// this returns 1 and the fusion turns on, matching a64's single-rounding fmadd.
_x64_has_float_fma() { return flag_fma; }
// FMA3 fused multiply-add (VEX-encoded). dst = a + n*m (op 0) or a - n*m (op 1),
// one IEEE rounding. The addend is usually already in dst (acc = acc + n*m →
// addr_reg == dreg); otherwise move it in first. The multiplicands are distinct
// temps/promoted regs, so that move never clobbers n or m. Only reached under
// --fma (has_float_fma gates the fusion), so pre-Haswell CPUs never see it.
void _x64_emit_fma(op_code, dst, n, m, a) {
    if (dst != a) { x64_enc_movsd_reg(dst, a); }
    if (op_code == 1) { x64_enc_vfma231sd(0xBD, dst, n, m); }   // vfnmadd231sd
    else { x64_enc_vfma231sd(0xB9, dst, n, m); }                // vfmadd231sd
}
// ── Multi-value return banking — the x86_64 register window ──
// b++ multi-value return is a CUSTOM register-window convention, not the
// SysV struct-return rule: both caller and callee are b++ code compiled
// here, so they may agree on any registers that survive the callee
// epilogue. That frees x64 from SysV's two-register return limit and gives
// it the same arity-8 banks the a64 side has. The spine addresses results
// by BANK POSITION (0..7); a64 maps position straight to x0..x7 / d0..d7,
// and here we map the integer positions onto eight caller-saved GP
// registers. Position 0 stays rax / xmm0 so a single-value return lands in
// the conventional register.
//
//   int  pos: 0=rax 1=rdx 2=rcx 3=rsi 4=rdi 5=r8 6=r9 7=r10
//   float pos: position == xmm register number (xmm0..xmm7)
//
// All eight integer registers are caller-saved and untouched by the
// epilogue (which only restores rbx/rbp/r12..r15 and rsp), so the results
// survive the return; the caller reads each before clobbering it.
static _x64_int_bank_reg(pos) {
    if (pos == 0) { return 0; }   // rax
    if (pos == 1) { return 2; }   // rdx
    if (pos == 2) { return 1; }   // rcx
    if (pos == 3) { return 6; }   // rsi
    if (pos == 4) { return 7; }   // rdi
    if (pos == 5) { return 8; }   // r8
    if (pos == 6) { return 9; }   // r9
    return 10;                    // r10  (pos 7)
}

// Move a banked float result into the accumulator's lane. The float bank
// position already IS the xmm register number, so no remap is needed.
// (Also the F.2.c compute-in-place hook, but x64 opts out of that path —
// the only live caller here is the multi-value assignment unpack.)
void _x64_emit_fmov_reg(dst, src) { x64_enc_movsd_reg(dst, src); }

// Move a banked integer result into the accumulator. Both operands are
// bank positions; remap each onto its physical register.
void _x64_emit_mov_reg_reg(dst, src) {
    x64_enc_mov_reg(_x64_int_bank_reg(dst), _x64_int_bank_reg(src));
}
// Move between PHYSICAL x86 register numbers — no return-bank remap. Used for
// B3 promoted-register reads (the promoted regs are physical rbx/r12..r15, not
// bank positions).
void _x64_emit_mov_phys(dst, src) {
    x64_enc_mov_reg(dst, src);
}

// Two-pass placement: pass 1 pushes each result (acc rax / xmm0) to the
// value stack; pass 2 pops them (LIFO, reverse slot order) into each
// slot's bank register. Pass 2 only pops, so it never re-evaluates an
// expression and cannot clobber an already-placed result.
void _x64_emit_bank_push(is_flt) {
    if (is_flt) { x64_emit_vpush(); } else { x64_emit_push(); }
}
void _x64_emit_bank_pop(is_flt, reg) {
    if (is_flt) { x64_emit_vpop(reg); } else { x64_emit_pop(_x64_int_bank_reg(reg)); }
}
// x86_64 now implements multi-value-return banking via the register window
// above (matching the a64 arity-8 banks).
_x64_cap_multi_ret() { return 1; }
// Float CIP temp pool — six caller-saved xmm (xmm8..xmm13). Safe because a
// CIP float expression is call-free (leaves + peekfloat builtins only), so no
// call clobbers them. xmm14/xmm15 are reserved (xmm15 is _x64_emit_fop_into's
// aliasing scratch). Bit i (0..5) free => xmm(8+i) available.
void x64_simd_freelist_reset() { x64_simd_free_mask = 0x7; }   // xmm8..xmm10 free (11..14 = float promotion, 15 = fop scratch)
_x64_simd_temp_alloc() {
    auto i;
    for (i = 0; i < 3; i++) {
        if (x64_simd_free_mask & (1 << i)) {
            x64_simd_free_mask = x64_simd_free_mask & ~(1 << i);
            return 8 + i;
        }
    }
    return 0 - 1;
}
void _x64_simd_temp_free(reg) {
    if (reg >= 8 && reg <= 10) { x64_simd_free_mask = x64_simd_free_mask | (1 << (reg - 8)); }
}
_x64_simd_temp_count() {
    auto i, n; n = 0;
    for (i = 0; i < 3; i++) { if (x64_simd_free_mask & (1 << i)) { n++; } }
    return n;
}

// ── Integer compute-in-place — x86_64 opts out (DEFERRED) ──
// The spine (cg_emit_int_into) is complete and runs on both backends; these
// chip stubs are no-ops and _x64_int_temp_count returns -1, so the gate
// never fires and the accumulator path stays. Low priority: SysV's 1-deep
// GP freelist makes it register-pressure-bound (see docs/manual/
// backend_parity.md). TO IMPLEMENT, fill the four below:
//   emit_iop_into(op,dreg,s1,s2): 2-operand ISA — if dreg!=s1 emit
//     `mov dreg,s1`, then in-place `OP dreg,s2` (add/sub/imul/and/or/xor).
//     In the CIP dreg!=s2 always holds, so no operand-aliasing fixup.
//   emit_iconst_into(dreg,val): mov dreg, imm64.
//   emit_iload_var_into(dreg,off): load the rbp-relative frame slot.
//   emit_iload_mem_into(dreg): mov dreg, [dreg].
//   emit_ishl_imm_into(dreg,src,amt): mov dreg,src (if dreg!=src) then shl dreg,amt.
// Then give _x64_int_temp_count a real free count + temp pool.
void _x64_emit_iload_var_into(dreg, off) { x64_enc_load(dreg, 5, off); }
// Real (not a CIP stub): the constant-promotion materialisation (emit_func
// step 12b) loads each promoted constant into its callee-saved register, and
// that path is backend-agnostic. dreg is a physical x86 register number.
void _x64_emit_iconst_into(dreg, val) { x64_enc_mov_wide(dreg, val); }
void _x64_emit_iop_into(op_code, dreg, s1, s2) {
    if (op_code == 3) {
        auto save_rax, save_rdx;
        save_rax = dreg != 0; save_rdx = dreg != 2;
        if (save_rax) { x64_enc_push(0); }
        if (save_rdx) { x64_enc_push(2); }
        x64_enc_mov_reg(0, s1); x64_enc_cqo(); x64_enc_idiv(s2);
        x64_enc_mov_reg(dreg, 0);
        if (save_rdx) { x64_enc_pop(2); }
        if (save_rax) { x64_enc_pop(0); }
        return 0;
    }
    // Destination aliases the RIGHT operand (dreg == s2). x86's 2-operand ISA
    // cannot `mov dreg, s1` first — it would clobber s2 before the op reads it.
    // a64's 3-operand emit is immune, so the spine's int assign-into-dest does
    // not guard this; x64 must. Commutative ops just apply s1 in place
    // (s2 OP s1 == s1 OP s2); subtraction negates then adds (s1 - s2).
    if (dreg == s2) {
        if (op_code == 1) { x64_enc_neg(dreg); x64_enc_add_reg(dreg, s1); return 0; }
        if (op_code == 2) { x64_enc_imul(dreg, s1);    return 0; }
        if (op_code == 4) { x64_enc_and_reg(dreg, s1); return 0; }
        if (op_code == 5) { x64_enc_or_reg(dreg, s1);  return 0; }
        if (op_code == 6) { x64_enc_xor_reg(dreg, s1); return 0; }
        x64_enc_add_reg(dreg, s1);
        return 0;
    }
    if (dreg != s1) { x64_enc_mov_reg(dreg, s1); }
    if (op_code == 1) { x64_enc_sub_reg(dreg, s2); return 0; }
    if (op_code == 2) { x64_enc_imul(dreg, s2);    return 0; }
    if (op_code == 4) { x64_enc_and_reg(dreg, s2); return 0; }
    if (op_code == 5) { x64_enc_or_reg(dreg, s2);  return 0; }
    if (op_code == 6) { x64_enc_xor_reg(dreg, s2); return 0; }
    x64_enc_add_reg(dreg, s2);
    return 0;
}
void _x64_emit_iload_mem_into(dreg) { x64_enc_load(dreg, dreg, 0); }
void _x64_emit_ishl_imm_into(dreg, src, amt) {
    if (dreg != src) { x64_enc_mov_reg(dreg, src); }
    x64_enc_shl_imm(dreg, amt);
}
// x86_64 has no integer multiply-accumulate, so a real port would emit
// `imul tmp,n,m; lea/add dst,a,tmp`; left as a stub while x64 stays on the
// accumulator path (int_temp_count -1, so this is never reached).
void _x64_emit_imadd(op_code, dst, n, m, a) { }
_x64_has_int_madd() { return 0; }
// Induction pointer walk: x86 has no post-index addressing mode (it is an ARM
// feature), so iv_supported returns 0 and the spine never fires the walk on
// x64 — the loop keeps its normal index-arithmetic codegen. The emit_iv_*
// stubs are therefore never reached.
void _x64_emit_iv_load(dreg, base_reg) { }
void _x64_emit_iv_store(base_reg) { }
void _x64_emit_iv_advance(base_reg) { }
void _x64_emit_iv_setup(base_reg, idx_reg) { }
_x64_iv_supported() { return 0; }

// Self-update with an immediate: reg += imm / reg -= imm (physical reg number).
void _x64_emit_self_op_imm(reg, imm, is_sub) {
    if (is_sub) { x64_enc_sub_imm(reg, imm); }
    else { x64_enc_add_imm(reg, imm); }
}
_x64_int_temp_alloc() { return x64_gp_alloc(); }
void _x64_int_temp_free(reg) { x64_gp_free(reg); }
// -1 (not 0): an int tree of two B3-promoted leaves needs 0 temps, and on
// x64 int locals CAN be promoted (unlike floats), so a 0 count would let
// `need(0) <= count(0)` fire CIP on these no-op stubs. -1 makes the spine's
// `need <= count` gate fail for every tree, fully opting x64 out.
_x64_int_temp_count() {
    auto i, n, c;
    n = _x64_freelist_depth();
    c = 0;
    for (i = 0; i < n; i++) {
        if (x64_gp_free_mask & (1 << i)) { c = c + 1; }
    }
    return c;
}

// ── BINOP comparisons (Wave 6) ──
//
// Map portable CG_CC_* to x86_64 condition codes (defined in
// x64_enc.bsm). Integer uses signed CC_E/NE/L/LE/G/GE; float
// uses the unsigned variants because UCOMISD sets flags via
// the unsigned-style CF/PF/ZF rather than the signed OF/SF.
static _x64_cc_int(cond_id) {
    if (cond_id == CG_CC_EQ) { return CC_E;  }
    if (cond_id == CG_CC_NE) { return CC_NE; }
    if (cond_id == CG_CC_LT) { return CC_L;  }
    if (cond_id == CG_CC_LE) { return CC_LE; }
    if (cond_id == CG_CC_GT) { return CC_G;  }
    if (cond_id == CG_CC_GE) { return CC_GE; }
    if (cond_id == CG_CC_LO) { return CC_B;  }   // unsigned <
    if (cond_id == CG_CC_LS) { return CC_BE; }   // unsigned <=
    if (cond_id == CG_CC_HI) { return CC_A;  }   // unsigned >
    if (cond_id == CG_CC_HS) { return CC_AE; }   // unsigned >=
    return CC_E;
}
// Only GT / GE map through this table — the ABOVE family is the one
// pair of condition codes that is already false when UCOMISD reports
// unordered (a NaN operand sets ZF = PF = CF = 1). EQ / NE / LT / LE
// need dedicated sequences in _x64_emit_cmp_flt below; routing them
// through a bare setcc silently mis-answered every NaN comparison
// (NaN == NaN read as 1, NaN != NaN as 0, NaN < x as 1) — found
// 2026-07-03 when the DSP hostile-parameter test hung on x64 only.
static _x64_cc_flt(cond_id) {
    if (cond_id == CG_CC_GT) { return CC_A;  }
    if (cond_id == CG_CC_GE) { return CC_AE; }
    return CC_A;
}

// Integer compare: rax := (rax <cond> rcx) ? 1 : 0.
// Three instructions: cmp + setcc al + movzx rax, al.
// The left_reg parameter is unused on x64 (rcx is fixed).
void _x64_emit_cmp_int(cond_id, left_reg) {
    x64_enc_cmp_reg(0, 1);
    x64_enc_setcc(_x64_cc_int(cond_id), 0);
    x64_enc_movzx8(0, 0);
}

// Compare and branch directly (no setcc/movzx): branch to `lbl` when the
// condition is FALSE — the inverse jump code (cc ^ 1, valid for x86's
// e/ne, l/ge, le/g pairs). Mirrors _x64_emit_cmp_int's cmp.
void _x64_emit_cmp_branch(cond_id, left_reg, lbl) {
    x64_enc_cmp_reg(0, 1);
    x64_enc_jcc_label(_x64_cc_int(cond_id) ^ 1, lbl);
}

// Compare two registers directly and branch — operands already in registers.
// _x64_emit_cmp_int does cmp_reg(0,1) = cmp(rax=LEFT, reg1=RIGHT), so the
// direct form is cmp(lreg, rreg) (dst = left, src = right).
void _x64_emit_cmp_branch_rr(cond_id, lreg, rreg, lbl) {
    x64_enc_cmp_reg(lreg, rreg);
    x64_enc_jcc_label(_x64_cc_int(cond_id) ^ 1, lbl);
}

// Float compare: rax := (xmm1 <cond> xmm0) ? 1 : 0.
//
// IEEE-correct under UCOMISD's unordered result (any NaN operand sets
// ZF = PF = CF = 1) — the same lowering gcc/clang use:
//   LT / LE — swap the operand order and use the ABOVE family: CC_A /
//             CC_AE read CF (and ZF) as zero, so unordered yields 0.
//   GT / GE — ABOVE family directly, unordered yields 0 already.
//   EQ      — ZF alone is a lie for NaN (unordered sets it): the true
//             answer is ZF AND NOT PF, built from two setcc + an AND.
//   NE      — the complement: NOT ZF OR PF, two setcc + an OR. This is
//             what makes the `x != x` NaN idiom work on x64 — a64's
//             FCMP gets it right by ISA design, and the DSP totality
//             guards (sin_f/exp_f) depend on it on every backend.
// rcx is the designated scratch register (same convention as the int
// compare's right operand), free at this point in the accumulator flow.
void _x64_emit_cmp_flt(cond_id) {
    if (cond_id == CG_CC_LT) {
        x64_enc_ucomisd(0, 1);            // flags = xmm0 ? xmm1 (right vs left)
        x64_enc_setcc(CC_A, 0);           // left < right  ==  right > left
        x64_enc_movzx8(0, 0);
        return;
    }
    if (cond_id == CG_CC_LE) {
        x64_enc_ucomisd(0, 1);
        x64_enc_setcc(CC_AE, 0);
        x64_enc_movzx8(0, 0);
        return;
    }
    if (cond_id == CG_CC_EQ) {
        x64_enc_ucomisd(1, 0);
        x64_enc_setcc(CC_E, 0);           // al = ZF
        x64_enc_setcc(CC_NP, 1);          // cl = !PF (0 when unordered)
        x64_enc_movzx8(0, 0);
        x64_enc_movzx8(1, 1);
        x64_enc_and_reg(0, 1);            // rax = ZF && !PF
        return;
    }
    if (cond_id == CG_CC_NE) {
        x64_enc_ucomisd(1, 0);
        x64_enc_setcc(CC_NE, 0);          // al = !ZF
        x64_enc_setcc(CC_P, 1);           // cl = PF (1 when unordered)
        x64_enc_movzx8(0, 0);
        x64_enc_movzx8(1, 1);
        x64_enc_or_reg(0, 1);             // rax = !ZF || PF
        return;
    }
    x64_enc_ucomisd(1, 0);                // GT / GE — unordered-safe as-is
    x64_enc_setcc(_x64_cc_flt(cond_id), 0);
    x64_enc_movzx8(0, 0);
}
// Unreachable: cg_try_float_cmp's budget check always fails when
// simd_temp_count() == 0 (x64 opts out of the whole float-CIP gate, same
// as every other F.2.c primitive) — filled in for primitive-table
// completeness, not because x64 exercises it.
void _x64_emit_cmp_flt_into(dst_int_reg, l_freg, r_freg, cond_id) { }
// Unreachable for the same reason as _x64_emit_cmp_flt_into above.
void _x64_emit_cmp_flt_branch(cond_id, l_freg, r_freg, lbl) { }

// ── Control flow (Wave 7) ──

_x64_emit_new_label() { return x64_enc_new_label(); }
void _x64_emit_label(id) { x64_enc_def_label(id); }
void _x64_emit_jump(id) { x64_enc_jmp_label(id); }

// Branch to label if rax is zero. Two instructions: test + jcc.
// (x86_64 has no single test-and-branch like a64's cbz.)
void _x64_emit_branch_if_zero(id) {
    x64_enc_test_reg(0, 0);
    x64_enc_jcc_label(CC_E, id);
}

// Normalize float result (xmm0) to int truth (rax). Four
// instructions: zero scratch xmm, ucomisd, setne al, movzx.
void _x64_emit_fcond_to_int_truth() {
    x64_enc_xorpd(1, 1);
    x64_enc_ucomisd(0, 1);
    x64_enc_setcc(CC_NE, 0);
    x64_enc_movzx8(0, 0);
}

void _x64_emit_promote_int_to_flt() { x64_enc_cvtsi2sd(0, 0); }
void _x64_emit_demote_flt_to_int() { x64_enc_cvttsd2si(0, 0); }
void _x64_emit_jump_to_epilogue() { x64_enc_jmp_label(x64_ret_lbl); }

// ── Memory access (Wave 8) ──
// Convention: addr in rax. For T_MEMST, value already pre-staged
// in rcx by the chip's eval+push+eval+pop sequence. fh encodes
// slice + (for bit-packed) bit offset.

// `cg_addr_const_off` (spine global, bpp_codegen.bsm): 0 normally (rax
// already holds the full address). Non-zero when the spine's T_MEMLD
// recognized a base+const-offset address and emitted ONLY the base into
// rax — folding the offset into this load's own ModRM+disp instead of a
// separate `add` to compute the full address first.
//
// `cg_addr_const_base`: -1 normally (address sits in rax, encoded as x64
// register index 0). >= 0 when the base was ALREADY a B3-promoted
// register and the spine skipped copying it into rax entirely.
_x64_emit_memld_load(fh) {
    auto sl, bo, bw, mask, coff, cbase;
    coff = cg_addr_const_off;
    cbase = cg_addr_const_base;
    if (cbase < 0) { cbase = 0; }
    // Float field: load into the XMM file and return the float ety so the
    // caller treats the value as a float, not raw bits. Without this branch
    // a `: float` field (SL_FULL) fell through to x64_enc_load — an 8-byte
    // INTEGER load — so `p.x` came back as the IEEE bits reinterpreted as an
    // int. Mirror of the a64 `_a64_emit_memld_load` float path.
    if (is_float_type(fh)) {
        sl = ty_slice(fh);
        if (sl == SL_DOUBLE) {           // 128-bit SIMD field — movups
            x64_enc_movups_load(0, cbase, coff);
            return 2;
        }
        if (sl == SL_HALF) {             // 32-bit f32 — load single, widen to f64
            x64_enc_load_ss(0, cbase, coff);
            x64_enc_cvtss2sd(0, 0);
            return 1;
        }
        // 64-bit f64 (SL_FULL). SL_QUARTER/f16 has no native x86_64 load
        // (sub-word float is aarch64-only surface today) and lands here.
        x64_enc_load_sd(0, cbase, coff);        // movsd xmm0, [rax]
        return 1;
    }
    sl = ty_slice(fh);
    if (sl >= SL_BIT && sl <= SL_BIT7) {
        bo = (fh / 256) & 7;
        bw = sl - 3;
        mask = (1 << bw) - 1;
        x64_enc_loadb(0, cbase, coff);
        if (bo > 0) { x64_enc_shr_imm(0, bo); }
        x64_enc_and_imm(0, mask);
        return 0;
    }
    if (sl == SL_BYTE)         { x64_enc_loadb(0, cbase, coff);  }
    else if (sl == SL_QUARTER) { x64_enc_loadh(0, cbase, coff);  }
    else if (sl == SL_HALF)    { x64_enc_load_sw(0, cbase, coff); }
    else                       { x64_enc_load(0, cbase, coff);    }
    return 0;
}

// x64 has no freelist for the store-side value reg, so val_reg
// is always 1 (rcx). Keeping the parameter in the signature
// for cross-chip uniformity at the spine call site.
// `cg_addr_const_off` / `cg_addr_const_base`: same convention as
// `_x64_emit_memld_load` — 0 / -1 normally (address in rax), overridden
// when the spine's cg_emit_addr folded a base+const-offset address.
void _x64_emit_memst_store(fh, val_reg) {
    auto sl, bo, bw, mask, clear_mask, coff, cbase;
    coff = cg_addr_const_off;
    cbase = cg_addr_const_base;
    if (cbase < 0) { cbase = 0; }
    sl = ty_slice(fh);
    if (sl >= SL_BIT && sl <= SL_BIT7) {
        bo = (fh / 256) & 7;
        bw = sl - 3;
        mask = (1 << bw) - 1;
        clear_mask = 255 ^ (mask << bo);
        x64_enc_loadb(2, cbase, coff);
        x64_enc_and_imm(2, clear_mask);
        x64_enc_and_imm(val_reg, mask);
        if (bo > 0) { x64_enc_shl_imm(val_reg, bo); }
        x64_enc_or_reg(2, val_reg);
        x64_enc_storeb(2, cbase, coff);
        return;
    }
    if (sl == SL_BYTE)         { x64_enc_storeb(val_reg, cbase, coff); }
    else if (sl == SL_QUARTER) { x64_enc_storeh(val_reg, cbase, coff); }
    else if (sl == SL_HALF)    { x64_enc_store_w(val_reg, cbase, coff); }
    else                       { x64_enc_store(val_reg, cbase, coff); }
}

// Address-of a stack-frame local. rbp = reg 5 on x64.
void _x64_emit_addr_local(off) { x64_enc_lea(0, 5, off); }

// Address-of a global. lea_rip + reloc 0 (global symbol).
void _x64_emit_addr_global(packed_name) {
    auto dpos;
    dpos = x64_enc_lea_rip(0);
    x64_enc_add_reloc(dpos, packed_name, 0);
}

// ── T_CALL ABI scaffolding (Wave 9) ──
//
// All 14 primitives wired into cg_prim but the spine
// cg_emit_node T_CALL branch is NOT yet active — chip's
// inline T_CALL body in x64_emit_node continues to handle
// every call. These primitives become live in Wave 9b.

// SystemV: rdi rsi rdx rcx r8 r9 (6 int) + xmm0..xmm7 (8 fp).
_x64_arg_reg_int(i) {
    if (i == 0) { return 7; }   // rdi
    if (i == 1) { return 6; }   // rsi
    if (i == 2) { return 2; }   // rdx
    if (i == 3) { return 1; }   // rcx
    if (i == 4) { return 8; }   // r8
    if (i == 5) { return 9; }   // r9
    return -1;
}
_x64_arg_reg_flt(i) { if (i < 8) { return i; } return -1; }
_x64_arg_reg_count_int() { return 6; }
_x64_arg_reg_count_flt() { return 8; }

// Move rax → r{dst} (or store to [rsp + off] if spilling).
void _x64_emit_push_arg_int(dst_or_off, is_spill) {
    if (is_spill != 0) { x64_enc_store(0, 4, dst_or_off); return; }
    if (dst_or_off == 0) { return; }
    x64_enc_mov_reg(dst_or_off, 0);
}

// Move xmm0 → xmm{dst} (or store to stack if spilling).
void _x64_emit_push_arg_flt(dst_or_off, is_spill) {
    if (is_spill != 0) { x64_enc_store_sd(0, 4, dst_or_off); return; }
    if (dst_or_off == 0) { return; }
    x64_enc_movsd_reg(dst_or_off, 0);
}

// Pre-call alignment: SystemV requires rsp aligned to 16
// before the CALL instruction (CALL pushes 8 bytes of return
// addr, leaving 16+8=24 inside callee — its prologue typically
// pushes rbp making 16+8+8=32, properly aligned).
_x64_emit_pre_call_align(stack_args) {
    auto pad;
    pad = stack_args * 8;
    if (pad % 16 != 0) { pad += 8; }
    if (pad > 0) { x64_enc_sub_imm(4, pad); }
    return pad;
}

void _x64_emit_post_call_unalign(pad_bytes) {
    if (pad_bytes > 0) { x64_enc_add_imm(4, pad_bytes); }
}

void _x64_emit_call_direct(target_lbl) { x64_enc_call_label(target_lbl); }

// Extern (FFI) call — mirrors the inline pattern from the
// extracted x64_emit_call helper. Emits the call-rel32
// placeholder (0xE8 + 4-byte rel) with reloc type 4, then
// saves xmm0/xmm1 to the rbp-relative scratch slots so
// float_ret() / float_ret2() builtins can recover FFI float
// returns. Assumes ex_idx maps to the name the linker resolves.
void _x64_emit_call_extern(ex_idx) {
    auto name_p;
    name_p = arr_get(cg_ex_name, ex_idx);
    x64_enc_add_reloc(x64_enc_pos + 1, name_p, 4);
    x64_enc_emit8(0xE8);
    x64_enc_emit32(0);
    x64_enc_store_sd(0, 5, 0 - 16);
    x64_enc_store_sd(1, 5, 0 - 24);
}

// Return value already in rax (int) or xmm0 (float) per SystemV.
_x64_emit_copy_ret_int() { return 0; }
_x64_emit_copy_ret_flt() { return 0; }

// Caller-saved spill — placeholder, see Wave 9b.
void _x64_emit_save_caller_saved_int() { }
void _x64_emit_restore_caller_saved_int() { }

// ── Phase 3.5/4 scaffolding (Waves 13-17) ──
// Stub bodies. Real implementations land in followup session.

void _x64_emit_fn_entry_label(name_p, fn_lbl_id) { }
void _x64_emit_frame_setup(frame_size) { }
void _x64_emit_save_callee_saved(regs_arr, count, base_off) { }

// Fat prologue: entry label + ret_lbl alloc + push rbp / mov rbp,rsp
// + sub rsp, frame + spill promoted regs. Reads x64_promoted_regs
// and x64_b3_spill_off (set by caller before this invocation).
void _x64_emit_prologue(name_p, fn_lbl_id, frame_size) {
    auto i, n, reg, off;
    x64_enc_def_label(fn_lbl_id);
    x64_ret_lbl = x64_enc_new_label();
    x64_enc_push(5);
    x64_enc_mov_reg(5, 4);
    if (frame_size > 0) { x64_enc_sub_imm(4, frame_size); }
    n = arr_len(x64_promoted_regs);
    for (i = 0; i < n; i++) {
        reg = arr_get(x64_promoted_regs, i);
        off = x64_b3_spill_off - (i + 1) * 8;
        x64_enc_store(reg, 5, off);
    }
}
// Constant promotion (Stage 2a) runs on both backends now. _x64_b3_select_const
// (in x64_codegen.bsm) mirrors the a64 one over x64's free callee-saved pool
// (rbx/r12..r15) left after the local pass; it rides the accumulator path (no
// freelist pressure), which is why it lands even though x64 integer-CIP stays
// deferred. The spine const machinery (loop-weighted table, prologue
// materialise, the cg_emit_lit use-site via emit_mov_phys) is backend-agnostic.
void _x64_b3_select_prim() { _x64_b3_select(); _x64_b3_select_float(); _x64_b3_select_const(); }

// ── Wave 20 statement orchestration primitives ──
//
// The spine's cg_emit_stmt owns the 11 statement cases directly; the
// primitives below are the chip-uniform pieces of T_ASSIGN / T_SWITCH
// that resolve per backend. The previous `_x64_emit_stmt_full` fat
// delegator was retired with the chip walker.

// Copy one 64-bit word from [rax + src_off] into [rbp + dst_off].
// Used by T_ASSIGN stack-struct copy (identical in shape to aarch64
// but rbp-relative with negative offsets).
void _x64_emit_struct_copy_word(src_off, dst_off) {
    x64_enc_load(1, 0, src_off);
    x64_enc_store(1, 5, dst_off);
}

// T_SWITCH sparse-value form: peek [rsp + 0] into rcx.
void _x64_emit_peek_cond() {
    x64_enc_load(1, 4, 0);
}

// cmp rcx, rax — flags reflect scratch vs acc. x86 cmp is dst - src.
void _x64_emit_cmp_scratch_acc() {
    x64_enc_cmp_reg(1, 0);
}

// Branch to `label_id` when rax != 0 (test rax,rax; jne lbl).
void _x64_emit_branch_if_nonzero(label_id) {
    x64_enc_test_reg(0, 0);
    x64_enc_jcc_label(CC_NE, label_id);
}

// ── Wave 21 emit_node orchestration primitives (scaffolding) ──

void _x64_emit_store_var_typed(vi, off, rty) {
    x64_emit_store_var(vi, off, rty);
}

void _x64_emit_switch_jtbl(nd, sw_end_lbl) {
    x64_emit_switch_jtbl(nd, sw_end_lbl);
}

void _x64_emit_branch_eq(label_id) {
    x64_enc_jcc_label(CC_E, label_id);
}
void _x64_emit_branch_ne(label_id) {
    x64_enc_jcc_label(CC_NE, label_id);
}

// Drop one stack-top word. x86_64 pops into rcx (the scratch reg),
// matching the pre-lift chip-local emission.
void _x64_emit_pop_discard() {
    x64_enc_pop(1);
    cg_depth--;
}

// Phase B1 register freelist for x86_64 (parity with a64's x9..x15 pool).
// A single caller-saved register, r11. r11 is otherwise touched only on the
// indirect-call path (`pop r11; call r11`), and the freelist is used only when
// there is NO call on the right of a T_BINOP — so r11 is guaranteed free across
// the RHS evaluation, the same caller-saved discipline a64 relies on. One reg
// covers the common non-nested binop; a nested binop sees alloc == -1 and falls
// back to the always-correct stack path. Reset per function (belt-and-suspenders;
// save_left/resolve are balanced so the mask returns to all-free per binop).
static auto x64_gp_free_mask;
void x64_freelist_reset() { x64_gp_free_mask = 0x7; }   // bits 0..2 = r11,r8,r9
// Float CIP xmm freelist (xmm8..xmm13), declared here alongside the GP one.
static auto x64_simd_free_mask;

// Leaf-aware int freelist. Base register r11 is always available. In a LEAF
// function (no calls, so the caller-saved arg registers are free once the
// prologue has copied the incoming arguments to their frame slots) the pool
// extends to r8 and r9 — a deeper CIP temp supply, moving toward a64's x9..x15
// band. Non-leaf keeps r11 only, because r8/r9 may still carry a call's
// outgoing arguments. r8/r9 are the safe pair: their only other uses are the
// call-argument window (positions 5/6, gated by T_CALL → never in a leaf) and
// the multi-return bank (only for 6+ value returns, and by then expression temps
// are already freed). rsi/rdi are excluded (rep-movs style builtins), r10 too
// (lea_rip const-load scratch), rax/rcx/rdx (accumulator / shift / mul-div).
_x64_freelist_reg(i) {
    if (i == 0) { return 11; }
    if (i == 1) { return 8; }
    return 9;
}
_x64_freelist_depth() {
    if (cg_fn_leaf) { return 3; }
    return 1;
}
x64_gp_alloc() {
    auto i, n;
    n = _x64_freelist_depth();
    for (i = 0; i < n; i++) {
        if (x64_gp_free_mask & (1 << i)) {
            x64_gp_free_mask = x64_gp_free_mask & ~(1 << i);
            return _x64_freelist_reg(i);
        }
    }
    return 0 - 1;
}
void x64_gp_free(reg) {
    auto b;
    b = 0;
    if (reg == 8) { b = 1; }
    if (reg == 9) { b = 2; }
    x64_gp_free_mask = x64_gp_free_mask | (1 << b);
}

// Current byte offset in the code buffer. x86_64 only ever emits binary (no
// asm-text mode), so this is always a real offset. Mirrors _a64_cur_text_pos;
// used by the spine inline splicer to record .bug inline ranges.
_x64_cur_text_pos() { return x64_enc_pos; }

// Save the left operand of a T_BINOP. Returns save_token:
//   -1 → pushed on float stack, -2 → on GP stack, >=0 → freelist reg (r11).
_x64_emit_binop_save_left(has_call_right, lty) {
    auto alloc_reg;
    if (lty == 1) { x64_emit_fpush(); return -1; }
    if (has_call_right) { x64_emit_push(); return 0 - 2; }
    alloc_reg = x64_gp_alloc();
    if (alloc_reg >= 0) {
        x64_enc_mov_reg(alloc_reg, 0);   // r11 = rax (save LHS in register)
        return alloc_reg;
    }
    x64_emit_push();
    return 0 - 2;
}

_x64_emit_binop_resolve(save_token, use_flt, lty, rty) {
    if (use_flt) {
        if (rty == 0) { x64_enc_cvtsi2sd(0, 0); }
        if (save_token == -1) {
            x64_emit_fpop(1);
        } else if (save_token >= 0) {
            x64_enc_mov_reg(0, save_token);   // rax = LHS (from r11)
            x64_gp_free(save_token);
            x64_enc_cvtsi2sd(1, 0);           // xmm1 = (double)LHS
        } else {
            x64_emit_pop(0);
            x64_enc_cvtsi2sd(1, 0);
        }
        return 0;
    }
    if (rty == 1) { x64_enc_cvttsd2si(0, 0); }
    if (save_token == -1) {
        x64_enc_mov_reg(1, 0);
        x64_emit_fpop(0);
        x64_enc_cvttsd2si(0, 0);
    } else if (save_token >= 0) {
        x64_enc_mov_reg(1, 0);            // rcx = RHS (rax)
        x64_enc_mov_reg(0, save_token);   // rax = LHS (from r11)
        x64_gp_free(save_token);
    } else {
        x64_enc_mov_reg(1, 0);            // rcx = RHS
        x64_emit_pop(0);                   // rax = LHS (from GP stack)
    }
    return 1;
}

void _x64_emit_addr_stack_struct(frame_off) {
    // lea rax, [rbp + frame_off]  (frame_off is a negative literal)
    x64_enc_lea(0, 5, frame_off);
}

// Return the chip-local label id for function `fi`. x86_64 stores
// these in x64_fn_lbl, parallel to cg_fn_name.
_x64_fn_label_for(fi) {
    return arr_get(x64_fn_lbl, fi);
}

// Fat prologue wrapper for x86_64.
void _x64_emit_prologue_full(name_p, fn_lbl_id, frame_size) {
    _x64_emit_prologue(name_p, fn_lbl_id, frame_size);
}

// Reset chip-specific function state. x86_64 does not have the
// aarch64 freelist allocator; only the promoted-reg array needs
// clearing at function entry.
void _x64_fn_reset_chip_state() {
    arr_clear(x64_promoted_regs);
    x64_freelist_reset();
    x64_simd_freelist_reset();
}

// Record B3 spill base and reserve N*8 bytes for promoted-reg spills.
// Returns the new total-bytes value. On x86_64 offsets grow DOWN
// from rbp, so the spill base is the negative absolute magnitude
// (-(24 + total)).
_x64_fn_reserve_spill(total) {
    x64_b3_spill_off = 0 - (24 + total);
    return total + arr_len(x64_promoted_regs) * 8;
}

// Pre-register body variables for x86_64 layout. Thin wrapper.
void _x64_fn_pre_reg_vars(body_arr, body_cnt) {
    x64_pre_reg_vars(body_arr, body_cnt);
}

// Compute per-variable frame offsets for x86_64 and fill cg_var_off.
// Returns total variable bytes. x86_64 uses NEGATIVE offsets from
// rbp (growing down) with the hidden scratch area at [rbp-8..rbp-24]
// (scratch + two xmm save slots). SIMD locals round the absolute
// magnitude to 16 for MOVUPS / MOVAPS alignment.
_x64_fn_compute_offsets() {
    auto i, n_vars, total, _fty, abs_mag, sz;
    total = 0;
    n_vars = arr_len(cg_vars);
    for (i = 0; i < n_vars; i++) {
        _fty = arr_get(cg_var_forced_ty, i);
        abs_mag = 24 + total;
        if (slice_width(ty_slice(_fty)) == 128) {
            abs_mag = (abs_mag + 15) / 16 * 16;
            total = abs_mag - 24 + 16;
            arr_set(cg_var_off, i, 0 - abs_mag - 16);
        } else if (arr_get(cg_var_stack, i)) {
            sz = (get_struct_size(arr_get(cg_var_struct_idx, i)) + 7) / 8 * 8;
            total += sz;
            arr_set(cg_var_off, i, 0 - (24 + total));
        } else {
            total += 8;
            arr_set(cg_var_off, i, 0 - (24 + total));
        }
    }
    return total;
}

// x86_64 does not encode sub-word float params yet (SL_HALF /
// SL_QUARTER are aarch64-only surface today). Stub so the spine
// can still call through a uniform slot.
void _x64_emit_narrow_float_params(par_cnt) { }

// Save argc / argv / envp from the current function's incoming arg
// registers (rdi / rsi / rdx on x86_64 Linux) into the runtime-global
// slots _bpp_argc / _bpp_argv / _bpp_envp. The _start stub below
// populates rdi/rsi/rdx from the kernel stack so main() sees the
// standard `(int argc, char **argv, char **envp)` contract even
// though Linux passes them via the stack at process entry.
void _x64_save_main_runtime_globals() {
    auto dpos;
    dpos = x64_enc_lea_rip(10);
    x64_enc_add_reloc(dpos, cg_argc_sym, 0);
    x64_enc_store(7, 10, 0);
    dpos = x64_enc_lea_rip(10);
    x64_enc_add_reloc(dpos, cg_argv_sym, 0);
    x64_enc_store(6, 10, 0);
    dpos = x64_enc_lea_rip(10);
    x64_enc_add_reloc(dpos, cg_envp_sym, 0);
    x64_enc_store(2, 10, 0);
}
// Copy incoming int arg from System V ABI reg to frame slot (or
// directly into B3-promoted callee-saved reg). Args come in
// rdi/rsi/rdx/rcx/r8/r9 by slot index — x64_arg_reg maps this.
// Copy incoming int arg from its System V source register to its
// frame slot (or directly into a B3-promoted callee-saved reg if
// hot). `var_idx` selects the variable for the promotion lookup;
// `abi_seq_idx` is the position in the int register sequence
// (rdi rsi rdx rcx r8 r9) — independent from `var_idx` because
// float params advance their own xmm counter without consuming an
// int slot.
void _x64_emit_arg_copy_int(var_idx, abi_seq_idx, frame_off) {
    auto preg, abi_reg;
    preg = arr_get(cg_var_promote, var_idx);
    abi_reg = x64_arg_reg(abi_seq_idx);
    if (preg >= 0) {
        x64_enc_mov_reg(preg, abi_reg);
    } else {
        x64_enc_store(abi_reg, 5, frame_off);
    }
}

// Copy incoming float arg from System V xmm source register to its
// frame slot. xmm0..xmm7 carry the first eight float args under
// SysV; abi_seq_idx is the float-bank position. B3 promotion of
// float params into callee-saved regs is not yet supported on
// x86_64 either — falls through to frame-slot storage.
void _x64_emit_arg_copy_flt(var_idx, abi_seq_idx, frame_off) {
    x64_enc_store_sd(abi_seq_idx, 5, frame_off);
}
// Phase 6.3 v2 — emit a call to `_prof_save_drain` while keeping
// the function's int + float return values (rax, xmm0) intact.
// Called from `_x64_emit_frame_teardown` between the epilogue
// label definition and the frame restore.
//
// Stack discipline: at the epilogue label, rsp ≡ 8 mod 16 (push
// rbp + frame). Reserve 24 bytes — 16 for {rax, xmm0} saves at
// [rsp] / [rsp+8], 8 for alignment. After `sub $24, %rsp` the
// rsp is 0 mod 16, the CALL pushes 8 of return addr making it
// 8 mod 16 inside the callee (whose own prologue's `push rbp`
// realigns). Standard SysV pattern.
//
// Skipped silently when cg_find_fn(_zone_save_drain_p) returns
// -1: that means the user reached this primitive without
// importing stbprofile.bsm, which would already be a link
// failure for `_prof_zone_enter` itself. Belt-and-suspenders.
void _x64_emit_drain_call_preserve_ret() {
    auto fi, lbl;
    fi = cg_find_fn(_zone_save_drain_p);
    if (fi < 0) { return 0; }
    lbl = arr_get(x64_fn_lbl, fi);
    x64_enc_sub_imm(4, 24);          // sub rsp, 24
    x64_enc_store(0, 4, 0);          // mov [rsp], rax
    x64_enc_store_sd(0, 4, 8);       // movsd [rsp + 8], xmm0
    x64_enc_call_label(lbl);
    x64_enc_load(0, 4, 0);           // mov rax, [rsp]
    x64_enc_load_sd(0, 4, 8);        // movsd xmm0, [rsp + 8]
    x64_enc_add_imm(4, 24);          // add rsp, 24
}

// Epilogue: define return label, optionally drain open @profile
// zones (Phase 6.3 v2), restore promoted regs from frame spill
// slots (negative offsets from x64_b3_spill_off), restore rbp,
// ret. Reads x64_promoted_regs and x64_b3_spill_off directly;
// caller only passes frame_size (unused currently but kept for
// signature consistency with a64).
void _x64_emit_frame_teardown(frame_size) {
    auto i, n, reg, off;
    x64_enc_def_label(x64_ret_lbl);
    if (cg_cur_fn_has_profile != 0) {
        _x64_emit_drain_call_preserve_ret();
    }
    n = arr_len(x64_promoted_regs);
    for (i = 0; i < n; i++) {
        reg = arr_get(x64_promoted_regs, i);
        off = x64_b3_spill_off - (i + 1) * 8;
        x64_enc_load(reg, 5, off);
    }
    x64_enc_mov_reg(4, 5);   // mov rsp, rbp
    x64_enc_pop(5);          // pop rbp
    x64_enc_ret();
}
void _x64_emit_module_setup() { }
void _x64_emit_module_finalize() { }
void _x64_alloc_fn_labels() { }
void _x64_emit_prelude() { }
void _x64_emit_global_data() { }
void _x64_emit_postlude() { }

// Store result reg into global *(<name>). Uses r10 as scratch
// for the lea_rip + relocation, then store_sd (float) or
// store (int) of result reg through the scratch base.
void _x64_emit_store_global(packed_name, is_float) {
    auto dpos;
    dpos = x64_enc_lea_rip(10);
    x64_enc_add_reloc(dpos, packed_name, 0);
    if (is_float) { x64_enc_store_sd(0, 10, 0); }
    else          { x64_enc_store(0, 10, 0); }
}

// ── Memory ──

// Load a local variable into rax (or xmm0 for floats / wider
// regs for SIMD). Delegates to the chip's existing
// x64_emit_load_var which owns the B3 promoted-register
// short-circuit and the sub-word dispatch matrix. Returns the
// type-id of the value loaded.
_x64_emit_load_local(vi, off) {
    return x64_emit_load_var(vi, off);
}

// Load a global variable's value into rax (int) or xmm0 (float).
// Uses lea_rip to compute the symbol address, then load. The
// linker resolves reloc type 0 (global symbol).
_x64_emit_load_global(packed_name, is_float) {
    auto dpos;
    if (is_float) {
        dpos = x64_enc_lea_rip(10);
        x64_enc_add_reloc(dpos, packed_name, 0);
        x64_enc_load_sd(0, 10, 0);
        return;
    }
    dpos = x64_enc_lea_rip(10);
    x64_enc_add_reloc(dpos, packed_name, 0);
    x64_enc_load(0, 10, 0);
}

// ── Wave 18 primitives (inline builtin dispatch) ──
//
// See a64_primitives.bsm for the contract. Spine calls these from
// cg_builtin_dispatch once peek / poke / etc are lifted there.

// Load `width` bytes from [rax] into rax. Width ∈ {1, 2, 4, 8}.
void _x64_emit_mem_read(width) {
    if (width == 1) { x64_enc_loadb(0, 0, 0); return; }
    if (width == 2) { x64_enc_loadh(0, 0, 0); return; }
    if (width == 4) { x64_enc_load_w(0, 0, 0); return; }
    if (width == 8) { x64_enc_load(0, 0, 0); return; }
}

// Coerce xmm0 (float accumulator) into rax (int accumulator).
// cvttsd2si performs the truncating-toward-zero conversion the
// B++ int-from-float semantic expects.
void _x64_emit_coerce_float_to_int() {
    x64_enc_cvttsd2si(0, 0);
}

// Floor xmm0 toward minus infinity, then convert to integer in rax.
// Excalibur Feature 2 `floor_int(x: float): word` builtin lowers to
// this. ROUNDSD with imm=0x01 selects floor; CVTTSD2SI then snaps
// the already-rounded float to the integer slot. Requires SSE4.1
// (Penryn and later — Apple Intel + every modern Linux Intel).
void _x64_emit_floor_to_int() {
    x64_enc_roundsd(0, 0, 0x01);
    x64_enc_cvttsd2si(0, 0);
}

// Round xmm0 to nearest, ties to even, then convert to integer in
// rax. Excalibur Feature 2 `round_int` builtin. CVTSD2SI uses the
// MXCSR rounding mode, which defaults to round-to-nearest-even —
// matching ARM's FRINTN behavior bit-for-bit on every value the
// integer slot can hold.
void _x64_emit_round_to_int() {
    x64_enc_cvtsd2si(0, 0);
}

// Convert integer accumulator (rax) to float accumulator (xmm0).
void _x64_emit_coerce_int_to_float() {
    x64_enc_cvtsi2sd(0, 0);
}

// Store float register val_reg at [rax].
// SL_FULL (64-bit double): bitcast the xmm bits through movq and store 8 bytes.
// SL_HALF (32-bit single): convert double → single with cvtsd2ss first, so the
// low 32 bits hold the real f32 (not the low half of the double's bit pattern),
// then store those 4 bytes. Mirrors the a64 `fcvt s, d; str s` path.
void _x64_emit_float_store_scalar(fh_sl, val_reg) {
    auto coff, cbase;
    coff = cg_addr_const_off;
    cbase = cg_addr_const_base;
    if (cbase < 0) { cbase = 0; }
    if (fh_sl == SL_HALF) {
        x64_enc_cvtsd2ss(val_reg, val_reg);     // double → single (f32 in low 32 bits)
        x64_enc_movq_from_xmm(val_reg, val_reg);
        x64_enc_store_w(val_reg, cbase, coff);  // mov dword [rax+off], r{val_reg}d
        return;
    }
    x64_enc_movq_from_xmm(val_reg, val_reg);   // bitcast xmm{val_reg} → r{val_reg}
    x64_enc_store(val_reg, cbase, coff);        // mov qword [rax+off], r{val_reg}
}

// Push rax onto the stack (Wave 18 dispatch helper).
void _x64_emit_push_acc() {
    x64_emit_push();
}

// Pop stack top into rcx (scratch register).
void _x64_emit_pop_scratch() {
    x64_emit_pop(1);
}

// Logical right shift for the `shr` builtin. x86 SHR uses CL (low
// byte of RCX = reg 1) as shift amount.
void _x64_emit_shift_right_logical() {
    x64_enc_shr_cl(0);
}

// 32-bit variable rotate right — value in EAX, count in CL.
// Emits `ROR EAX, CL`. The 32-bit operation zero-extends into
// RAX automatically (Intel SDM). Matches the ARM64 RORV-W path —
// both chips agree on "low-32 ROR, zero-extended" without an
// explicit mask. Operand layout (acc=value, scratch=count)
// matches `emit_shift_right_logical` so the spine drives both
// chips through the same push/pop_scratch sequence.
void _x64_emit_ror32() {
    x64_enc_ror32_cl(0);
}

// Load float return slot N (0 or 1) into xmm0. Frame layout is
// chip-specific — on x64, xmm0 save lives at [rbp - 16], xmm1 at
// [rbp - 24]. See _a64_emit_load_float_ret for the ARM analog.
void _x64_emit_load_float_ret(slot) {
    auto off;
    off = slot == 0 ? 0 - 16 : 0 - 24;
    x64_enc_load_sd(0, 5, off);
}

// Memory barrier. x86 emits MFENCE (0F AE F0). Zeros rax by convention.
void _x64_emit_mem_barrier() {
    x64_enc_emit8(0x0F);
    x64_enc_emit8(0xAE);
    x64_enc_emit8(0xF0);
    x64_enc_xor_zero(0);
}

// Abort with INT3 when the accumulator is zero. Used by the
// assert(cond) builtin — spine arranges the cond in rax (coercing
// from xmm0 first when needed) and this primitive does the
// test-and-branch. Label allocation is chip-local so the spine
// stays ignorant of which label pool is active.
void _x64_emit_trap_if_zero() {
    auto lbl_ok;
    lbl_ok = x64_enc_new_label();
    x64_enc_test_reg(0, 0);
    x64_enc_jcc_label(CC_NE, lbl_ok);
    x64_enc_emit8(0xCC);   // INT3
    x64_enc_def_label(lbl_ok);
}

// (`_x64_emit_load_runtime_global` and `_x64_emit_index_word` used to
// live here as chip primitives consumed exclusively by the argv_get /
// envp_get builtin dispatch. Retired 2026-05-13 alongside that
// dispatch — the spine now reads the runtime globals via plain B++
// source functions in src/bpp_args.bsm that compile through the
// normal function machinery with no chip-specific primitive needed.)

// Map a portable CG_SYS_* identifier (defined in bpp_codegen.bsm) to
// the Linux/x86_64 BSYS_* syscall number. Same rationale as the
// aarch64 helper: the spine never touches BSYS_* directly. Aborts
// with a diagnostic if the ID does not resolve, so an untranslated
// request fails loud instead of silently emitting a wrong syscall.
static _x64_sys_num(cg_id) {
    if (cg_id == CG_SYS_EXIT)     { return BSYS_LINUX_EXIT; }
    if (cg_id == CG_SYS_READ)     { return BSYS_LINUX_READ; }
    if (cg_id == CG_SYS_WRITE)    { return BSYS_LINUX_WRITE; }
    if (cg_id == CG_SYS_OPEN)     { return BSYS_LINUX_OPEN; }
    if (cg_id == CG_SYS_CLOSE)    { return BSYS_LINUX_CLOSE; }
    if (cg_id == CG_SYS_FORK)     { return BSYS_LINUX_FORK; }
    if (cg_id == CG_SYS_EXECVE)   { return BSYS_LINUX_EXECVE; }
    if (cg_id == CG_SYS_WAIT4)    { return BSYS_LINUX_WAIT4; }
    if (cg_id == CG_SYS_GETDENTS) { return BSYS_LINUX_GETDENTS; }
    if (cg_id == CG_SYS_UNLINK)   { return BSYS_LINUX_UNLINK; }
    if (cg_id == CG_SYS_PTRACE)   { return BSYS_LINUX_PTRACE; }
    if (cg_id == CG_SYS_LSEEK)    { return BSYS_LINUX_LSEEK; }
    if (cg_id == CG_SYS_FCHMOD)   { return BSYS_LINUX_FCHMOD; }
    if (cg_id == CG_SYS_SOCKET)   { return BSYS_LINUX_SOCKET; }
    if (cg_id == CG_SYS_CONNECT)  { return BSYS_LINUX_CONNECT; }
    if (cg_id == CG_SYS_MKDIR)    { return BSYS_LINUX_MKDIR; }
    if (cg_id == CG_SYS_MMAP)     { return BSYS_LINUX_MMAP; }
    if (cg_id == CG_SYS_MUNMAP)   { return BSYS_LINUX_MUNMAP; }
    if (cg_id == CG_SYS_SELECT)   { return BSYS_LINUX_SELECT; }
    if (cg_id == CG_SYS_STAT)     { return BSYS_LINUX_STAT; }
    diag_str("internal error: CG_SYS id ");
    diag_int(cg_id);
    diag_str(" not mapped on x86_64/Linux\n");
    sys_exit(2);
    return 0;
}

// Wave 18 emit_syscall primitive. Final instruction for every lifted
// sys_* builtin on Linux x86_64. The spine has already evaluated the
// last argument into rax and pushed any earlier arguments onto the
// stack in REVERSE order (so the top of the stack is arg 1). This
// primitive moves rax into rdi (the x86_64 Linux syscall ABI's first
// argument register — the tree walker's own convention is rax), pops
// subsequent arguments into rsi / rdx / r10 / r8 / r9 per the ABI,
// optionally pre-loads a literal value into a fixed register (covers
// sys_open's mode=493 in rdx), loads the syscall number into rax,
// and traps. Linux returns negative errnos directly, so no csneg
// normalisation is required after the syscall returns.
void _x64_emit_syscall(cg_id, arg_count, extra_slot, extra_val) {
    auto num;
    // Move arg 0 from rax (tree walker convention) into rdi (syscall ABI).
    if (arg_count >= 1) { x64_enc_mov_reg(7, 0); }
    // Pop remaining args from the stack into rsi, rdx, r10, r8, r9.
    if (arg_count >= 2) { x64_enc_pop(6);  cg_depth--; }
    if (arg_count >= 3) { x64_enc_pop(2);  cg_depth--; }
    if (arg_count >= 4) { x64_enc_pop(10); cg_depth--; }
    if (arg_count >= 5) { x64_enc_pop(8);  cg_depth--; }
    if (arg_count >= 6) { x64_enc_pop(9);  cg_depth--; }
    if (extra_slot >= 0) {
        x64_enc_mov_wide(extra_slot, extra_val);
    }
    num = _x64_sys_num(cg_id);
    x64_enc_mov_wide(0, num);
    x64_enc_syscall();
}

// ── Wave 19 function-frame primitives ──
//
// Hidden scratch area size in x86_64 frames: 24 bytes covering rbp
// at 0 and two 8-byte float-return save slots at -16 / -24 used by
// call()'s post-call xmm0/xmm1 save.
_x64_fn_scratch_base() { return 24; }

// Fallthrough implicit-return instruction on x86_64: xor rax, rax
// leaves rax=0 with shorter encoding than mov rax, #0.
void _x64_emit_implicit_ret_zero() {
    x64_enc_xor_zero(0);
}

// Body delegation — the chip's x64_emit_body keeps its current
// implementation through Wave 19. The wrapper lets the spine
// orchestrator call through a uniform slot.
void _x64_emit_body_prim(body_arr, body_cnt) {
    x64_emit_body(body_arr, body_cnt);
}

// Load the runtime address of function index `fi` into rax. LEA
// RIP-relative with a disp32=0 placeholder that the linker patches
// using the function's emitter label id from x64_fn_lbl. The fixup
// slot recording is identical to the pre-lift chip-local behaviour
// verbatim — resolve-time fixup uses the dpos from lea_rip, not
// x64_enc_pos (which has moved past the disp32 by the time the
// patch would apply).
void _x64_emit_fn_ptr(fi) {
    auto dpos;
    dpos = x64_enc_lea_rip(0);
    x64_enc_add_fixup(arr_get(x64_fn_lbl, fi));
    arr_set(x64_enc_fix_pos, arr_len(x64_enc_fix_pos) - 1, dpos);
}

// Linux-side syscall returns already use negative errno convention,
// so error normalisation is a no-op here. The primitive exists so
// the spine stays chip-agnostic when the a64 path's csneg is
// required.
void _x64_emit_syscall_norm_err() {
    // intentionally empty — Linux syscall ABI needs no fixup.
}

// Load `width` bytes from [rax + rcx] into rax (str_peek-style
// indexed byte access). x86 needs an explicit add_reg before the
// load since it doesn't have a two-register indexed load in one
// instruction (SIB would require a lea first, then load).
void _x64_emit_mem_read_indexed(width) {
    x64_enc_add_reg(0, 1);  // rax += rcx
    if (width == 1) { x64_enc_loadb(0, 0, 0); return; }
    if (width == 2) { x64_enc_loadh(0, 0, 0); return; }
    if (width == 4) { x64_enc_load_w(0, 0, 0); return; }
    if (width == 8) { x64_enc_load(0, 0, 0); return; }
}

// Store `width` bytes from val_reg into [rax]. Width ∈ {1, 2, 4, 8}.
void _x64_emit_mem_write(val_reg, width) {
    if (width == 1) { x64_enc_storeb(val_reg, 0, 0); return; }
    if (width == 2) { x64_enc_storeh(val_reg, 0, 0); return; }
    if (width == 4) { x64_enc_store_w(val_reg, 0, 0); return; }
    if (width == 8) { x64_enc_store(val_reg, 0, 0); return; }
}


// Phase 6.2c — caller_pc(n). On entry, n is in rax. On exit, the
// chosen frame's PC is in rax, or 0 when the FP chain ended before
// depth n was reached. The null-FP check at the top of the walk
// loop makes the primitive safe to drive from a panic-style loop
// that walks the chain incrementally and stops on the first 0.
//
// Layout:
//   n == 0 → LEA rax, [RIP + 0] (rax = address right after the LEA)
//   n >= 1 → walk (n-1) frames up the FP chain via [rbp], then
//            mov rax, [rcx + 8] for that frame's saved return address
//   walked off → return 0
//
// Asm shape (binary mode):
//
//     test rax, rax
//     jz   .Lzero            ; n==0 → current PC path
//     mov  rcx, rbp           ; walk start
//   .Lwalk:
//     test rcx, rcx
//     jz   .Lwalk_off         ; null FP at any step → 0
//     sub  rax, 1
//     test rax, rax
//     jz   .Ltake_lr          ; reached chosen frame
//     mov  rcx, [rcx]         ; previous rbp
//     jmp  .Lwalk
//   .Ltake_lr:
//     mov  rax, [rcx + 8]     ; return address at that frame
//     jmp  .Ldone
//   .Lzero:
//     lea  rax, [rip]         ; rax = address right after the lea
//     jmp  .Ldone
//   .Lwalk_off:
//     xor  eax, eax           ; rax = 0
//   .Ldone:
//
// RBP preservation is guaranteed by B++ x64 codegen prologue.
void _x64_emit_caller_pc() {
    auto walk_lbl, take_lbl, zero_lbl, done_lbl, walkoff_lbl;
    walk_lbl    = x64_enc_new_label();
    take_lbl    = x64_enc_new_label();
    zero_lbl    = x64_enc_new_label();
    done_lbl    = x64_enc_new_label();
    walkoff_lbl = x64_enc_new_label();

    // test rax, rax
    x64_enc_test_reg(0, 0);
    // jz .Lzero
    x64_enc_jcc_label(CC_E, zero_lbl);
    // mov rcx, rbp  (rcx=1, rbp=5)
    x64_enc_mov_reg(1, 5);
    // .Lwalk:
    x64_enc_def_label(walk_lbl);
    // test rcx, rcx — null FP guard for graceful end-of-chain.
    x64_enc_test_reg(1, 1);
    // jz .Lwalk_off
    x64_enc_jcc_label(CC_E, walkoff_lbl);
    // sub rax, 1
    x64_enc_sub_imm(0, 1);
    // test rax, rax
    x64_enc_test_reg(0, 0);
    // jz .Ltake_lr
    x64_enc_jcc_label(CC_E, take_lbl);
    // mov rcx, [rcx]  (load 8 bytes from [rcx + 0])
    x64_enc_load(1, 1, 0);
    // jmp .Lwalk
    x64_enc_jmp_label(walk_lbl);
    // .Ltake_lr:
    x64_enc_def_label(take_lbl);
    // mov rax, [rcx + 8]
    x64_enc_load(0, 1, 8);
    // jmp .Ldone
    x64_enc_jmp_label(done_lbl);
    // .Lzero:
    x64_enc_def_label(zero_lbl);
    // lea rax, [rip + 0] (return value is disp_pos; we ignore it
    // because no relocation is needed — the disp32 stays 0 and the
    // CPU computes rax = next_instruction_address at runtime).
    x64_enc_lea_rip(0);
    // jmp .Ldone
    x64_enc_jmp_label(done_lbl);
    // .Lwalk_off:
    x64_enc_def_label(walkoff_lbl);
    // xor eax, eax  — clears rax to 0 (32-bit zero extends).
    x64_enc_xor_reg(0, 0);
    // .Ldone:
    x64_enc_def_label(done_lbl);
}
