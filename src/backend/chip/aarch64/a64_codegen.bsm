// bpp_codegen_arm64.bsm — ARM64 code generator for the unified B++ compiler.
// Reads AST data from the parser's in-memory structures (no JSON).
// Writes ARM64 assembly (macOS Apple Silicon) to stdout.
//
// Usage: import this module into bpp.bpp, then call emit_all_arm64()
// after run_types()/run_dispatch() to emit assembly instead of C.

import "bpp_defs.bsm";
import "bpp_array.bsm";
import "bpp_internal.bsm";
import "bpp_parser.bsm";
import "bpp_types.bsm";
import "a64_enc.bsm";
// ARM64 codegen always targets macOS (the chip+OS coupling B++ has today).
// Import the macOS syscall table and runtime startup globals directly,
// not via target-suffix — this codegen cannot target any other OS.
import "_bsys_macos.bsm";
// bpp_codegen holds the cross-chip globals and (eventually) the
// portable passes shared with x64. During Phase 1 of the MAX-plan
// split it contains only the shared globals; Phase 2+ add the
// tree-walking and analysis functions.
import "bpp_codegen.bsm";
import "a64_primitives.bsm";

// ── Emitter-owned globals ──────────────────────────────────

// String buffer (cg_sbuf) now lives in bpp_codegen.bsm — shared
// with x64. Set once by cg_bridge_data below.

// Function table (parallel dynamic arrays, deduplicated from parser).
// cg_fn_fidx maps emitter index → parser func_cnt index for type queries.
// Function table (cg_fn_name, cg_fn_par, cg_fn_pcnt, cg_fn_body,
// cg_fn_bcnt, cg_fn_fidx) lives in bpp_codegen.bsm.

// Global variable list (dynamic array).
// cg_gl_name lives in bpp_codegen.bsm.

// FFI extern table: parallel dynamic arrays for type-aware external calls.
// Extern table (cg_ex_name, cg_ex_ret, cg_ex_args, cg_ex_acnt)
// lives in bpp_codegen.bsm.

// Variable-table globals (cg_vars, cg_var_stack, cg_var_struct_idx,
// cg_var_off, cg_var_forced_ty, cg_var_refs, cg_var_addr_taken,
// cg_var_promote) + var_add/var_idx/var_find helpers live in
// bpp_codegen.bsm — shared with x64.

// Phase B3 — local register allocation. a64_promoted_regs holds
// actual ARM register numbers assigned by the B3 pass; it stays
// chip-specific. a64_b3_spill_base is an ARM-specific frame
// offset.
extrn a64_promoted_regs;  // Array pointer stable; contents cleared by a64_primitives.
global a64_b3_spill_base; // Assigned by a64_primitives (a64_emit_func_prologue).
// F.2.c Stage 2: float B3 promotes hot `: float` locals to callee-saved
// d8..d15. a64_promoted_fregs holds those d-register numbers (8..15);
// a64_b3_fspill_base is where they are saved in the frame (right after
// the integer B3 spill band).
extrn a64_promoted_fregs;
global a64_b3_fspill_base;

// Shared per-function state (cg_flt_tbl, cg_str_tbl, cg_lbl_cnt,
// cg_depth, cg_break_stack, cg_continue_stack, cg_cur_fn_name,
// cg_cur_fn_idx) lives in bpp_codegen.bsm.

// Binary mode: 0 = text assembly (default), 1 = binary encoding
// via bpp_enc_arm64.bsm. a64-only because x64 is always binary.
global a64_bin_mode; // Set from bpp.bpp (command-line mode selection).

// Inline-splice ranges for the .bug debug map. When a function body is spliced
// into a caller (S4 value-inline or VI void-inline), the inlined instructions
// live in the caller's text range, so a PC there would be mis-attributed to the
// caller. These parallel arrays record [start, end) text offsets + the callee
// fidx of every splice so bpp_bug can emit an INLINE section and the debugger
// can resolve a PC back to the inlined function. enc_pos is the absolute text
// offset (same coordinate as the address map), so the ranges are directly
// comparable to function offsets. Populated only in binary mode.
// The bug_inl_* range arrays + _bug_inl_record + the inline-multi splicer now
// live in the spine (bpp_codegen.bsm) so both chips share one implementation;
// this chip only provides cur_text_pos below.

// Current byte offset in the code buffer, or -1 in asm-text mode where enc_pos
// is not a real text offset. The spine inline splicer uses this to record .bug
// inline ranges chip-agnostically, replacing the old a64_bin_mode dependency.
_a64_cur_text_pos() {
    if (a64_bin_mode == 0) { return 0 - 1; }
    return enc_pos;
}

// Binary mode: function entry labels (dynamic array mapping fn index → label ID).
extrn a64_fn_lbl; // Array pointer stable; read from bpp.bpp, bpp_bo.bsm, bpp_bug.bsm.

// Binary mode: return label for the current function (set in a64_emit_func).
global a64_ret_lbl; // Assigned each function by a64_primitives prologue.

// Sentinel packed names for hidden argc/argv/envp globals.
// These use negative values that can never collide with real packed names.
// cg_argc_sym, cg_argv_sym, cg_envp_sym live in bpp_codegen.bsm.

// ── Phase B1 register freelists ──────────────────────────────
//
// Two pools from day one. gp_freelist backs B1-B3 (integer / pointer
// temps). simd_freelist is allocated empty and activated by B4, where
// `: double` variables bind to it. Keeping both pools present now means
// B4 does not have to touch B1-B3 code.
//
// GP pool = x9..x15 (7 temps). Bit i set = reg (9+i) is free.
// SIMD pool = v0..v15 (16 regs). Bit i set = reg i is free.
static auto a64_gp_free_mask;
static auto a64_simd_free_mask;


// ── Initialization ─────────────────────────────────────────

// Phase 3.4 — install this chip's primitives into the spine's
// fn_ptr dispatch table. Called both at startup (init_codegen_arm64)
// AND at the top of emit_module_arm64 to guarantee the right chip
// owns cg_prim regardless of init order in bpp.bpp (the x86_64
// init runs after arm64's at startup, so without the per-module
// re-install the table would always carry x64 fn_ptrs and arm64
// emission would write into the wrong encoder buffer).
void cg_install_arm64_primitives() {
    auto p: ChipPrimitives;
    cg_prim_alloc();
    cg_init_cc();
    cg_init_sys_ids();
    p = cg_prim;
    p.emit_mov_zero         = fn_ptr(_a64_emit_mov_zero);
    p.emit_mov_imm          = fn_ptr(_a64_emit_mov_imm);
    p.emit_load_str_addr    = fn_ptr(_a64_emit_load_str_addr);
    p.emit_load_float_const = fn_ptr(_a64_emit_load_float_const);
    p.emit_fconst_into      = fn_ptr(_a64_emit_fconst_into);
    p.emit_load_local       = fn_ptr(_a64_emit_load_local);
    p.emit_load_global      = fn_ptr(_a64_emit_load_global);
    p.emit_neg              = fn_ptr(_a64_emit_neg);
    p.emit_fneg             = fn_ptr(_a64_emit_fneg);
    p.emit_not              = fn_ptr(_a64_emit_not);
    p.emit_add              = fn_ptr(_a64_emit_add);
    p.emit_sub              = fn_ptr(_a64_emit_sub);
    p.emit_mul              = fn_ptr(_a64_emit_mul);
    p.emit_div              = fn_ptr(_a64_emit_div);
    p.emit_udiv             = fn_ptr(_a64_emit_udiv);
    p.emit_mod              = fn_ptr(_a64_emit_mod);
    p.emit_umod             = fn_ptr(_a64_emit_umod);
    p.emit_and              = fn_ptr(_a64_emit_and);
    p.emit_or               = fn_ptr(_a64_emit_or);
    p.emit_xor              = fn_ptr(_a64_emit_xor);
    p.emit_shl              = fn_ptr(_a64_emit_shl);
    p.emit_shr              = fn_ptr(_a64_emit_shr);
    p.emit_lshr             = fn_ptr(_a64_emit_lshr);
    p.emit_shl_imm          = fn_ptr(_a64_emit_shl_imm);
    p.emit_shr_imm          = fn_ptr(_a64_emit_shr_imm);
    p.emit_lshr_imm         = fn_ptr(_a64_emit_lshr_imm);
    p.emit_fadd             = fn_ptr(_a64_emit_fadd);
    p.emit_fsub             = fn_ptr(_a64_emit_fsub);
    p.emit_fmul             = fn_ptr(_a64_emit_fmul);
    p.emit_fdiv             = fn_ptr(_a64_emit_fdiv);
    p.emit_fload_var_into   = fn_ptr(_a64_emit_fload_var_into);
    p.emit_fload_promoted_into = fn_ptr(_a64_emit_fload_promoted_into);
    p.emit_fload_mem_into   = fn_ptr(_a64_emit_fload_mem_into);
    p.emit_fop_into         = fn_ptr(_a64_emit_fop_into);
    p.emit_fma              = fn_ptr(_a64_emit_fma);
    p.emit_fmov_reg         = fn_ptr(_a64_emit_fmov_reg);
    p.emit_mov_reg_reg      = fn_ptr(_a64_emit_mov_reg_reg);
    p.emit_mov_phys         = fn_ptr(_a64_emit_mov_phys);
    p.emit_bank_push        = fn_ptr(_a64_emit_bank_push);
    p.emit_bank_pop         = fn_ptr(_a64_emit_bank_pop);
    p.cap_multi_ret         = fn_ptr(_a64_cap_multi_ret);
    p.simd_temp_alloc       = fn_ptr(_a64_simd_temp_alloc);
    p.simd_temp_free        = fn_ptr(_a64_simd_temp_free);
    p.simd_temp_count       = fn_ptr(_a64_simd_temp_count);
    p.emit_iload_var_into   = fn_ptr(_a64_emit_iload_var_into);
    p.emit_iconst_into      = fn_ptr(_a64_emit_iconst_into);
    p.emit_iop_into         = fn_ptr(_a64_emit_iop_into);
    p.emit_iload_mem_into   = fn_ptr(_a64_emit_iload_mem_into);
    p.emit_ishl_imm_into    = fn_ptr(_a64_emit_ishl_imm_into);
    p.emit_imadd            = fn_ptr(_a64_emit_imadd);
    p.emit_iv_load          = fn_ptr(_a64_emit_iv_load);
    p.emit_iv_store         = fn_ptr(_a64_emit_iv_store);
    p.emit_iv_advance       = fn_ptr(_a64_emit_iv_advance);
    p.emit_iv_setup         = fn_ptr(_a64_emit_iv_setup);
    p.iv_supported          = fn_ptr(_a64_iv_supported);
    p.has_int_madd          = fn_ptr(_a64_has_int_madd);
    p.has_float_fma         = fn_ptr(_a64_has_float_fma);
    p.emit_self_op_imm      = fn_ptr(_a64_emit_self_op_imm);
    p.emit_cmp_branch       = fn_ptr(_a64_emit_cmp_branch);
    p.emit_cmp_branch_rr    = fn_ptr(_a64_emit_cmp_branch_rr);
    p.emit_cmp_flt_branch   = fn_ptr(_a64_emit_cmp_flt_branch);
    p.int_temp_alloc        = fn_ptr(_a64_int_temp_alloc);
    p.int_temp_free         = fn_ptr(_a64_int_temp_free);
    p.int_temp_count        = fn_ptr(_a64_int_temp_count);
    p.emit_cmp_int          = fn_ptr(_a64_emit_cmp_int);
    p.emit_cmp_flt          = fn_ptr(_a64_emit_cmp_flt);
    p.emit_cmp_flt_into     = fn_ptr(_a64_emit_cmp_flt_into);
    p.emit_new_label        = fn_ptr(_a64_emit_new_label);
    p.emit_label            = fn_ptr(_a64_emit_label);
    p.cur_text_pos          = fn_ptr(_a64_cur_text_pos);
    p.emit_jump             = fn_ptr(_a64_emit_jump);
    p.emit_branch_if_zero   = fn_ptr(_a64_emit_branch_if_zero);
    p.emit_fcond_to_int_truth = fn_ptr(_a64_emit_fcond_to_int_truth);
    p.emit_promote_int_to_flt = fn_ptr(_a64_emit_promote_int_to_flt);
    p.emit_demote_flt_to_int  = fn_ptr(_a64_emit_demote_flt_to_int);
    p.emit_jump_to_epilogue   = fn_ptr(_a64_emit_jump_to_epilogue);
    p.emit_memld_load         = fn_ptr(_a64_emit_memld_load);
    p.emit_memst_store        = fn_ptr(_a64_emit_memst_store);
    p.emit_addr_local         = fn_ptr(_a64_emit_addr_local);
    p.emit_addr_global        = fn_ptr(_a64_emit_addr_global);
    p.emit_store_global       = fn_ptr(_a64_emit_store_global);
    // Wave 9 scaffolding — wired but spine not yet calling these.
    p.arg_reg_int                  = fn_ptr(_a64_arg_reg_int);
    p.arg_reg_flt                  = fn_ptr(_a64_arg_reg_flt);
    p.arg_reg_count_int            = fn_ptr(_a64_arg_reg_count_int);
    p.arg_reg_count_flt            = fn_ptr(_a64_arg_reg_count_flt);
    p.emit_push_arg_int            = fn_ptr(_a64_emit_push_arg_int);
    p.emit_push_arg_flt            = fn_ptr(_a64_emit_push_arg_flt);
    p.emit_pre_call_align          = fn_ptr(_a64_emit_pre_call_align);
    p.emit_post_call_unalign       = fn_ptr(_a64_emit_post_call_unalign);
    p.emit_call_direct             = fn_ptr(_a64_emit_call_direct);
    p.emit_call_extern             = fn_ptr(_a64_emit_call_extern);
    p.emit_copy_ret_int            = fn_ptr(_a64_emit_copy_ret_int);
    p.emit_copy_ret_flt            = fn_ptr(_a64_emit_copy_ret_flt);
    p.emit_save_caller_saved_int   = fn_ptr(_a64_emit_save_caller_saved_int);
    p.emit_restore_caller_saved_int= fn_ptr(_a64_emit_restore_caller_saved_int);
    // Phase 3.5/4 scaffolding — wired but spine inactive.
    p.b3_select              = fn_ptr(_a64_b3_select_prim);
    p.regalloc_apply         = fn_ptr(_a64_regalloc_apply);
    p.regalloc_apply_float   = fn_ptr(_a64_regalloc_apply_float);
    p.emit_arg_copy_int      = fn_ptr(_a64_emit_arg_copy_int);
    p.emit_arg_copy_flt      = fn_ptr(_a64_emit_arg_copy_flt);
    p.emit_frame_teardown    = fn_ptr(_a64_emit_frame_teardown);
    p.emit_module_setup      = fn_ptr(_a64_emit_module_setup);
    p.emit_module_finalize   = fn_ptr(_a64_emit_module_finalize);
    p.alloc_fn_labels        = fn_ptr(_a64_alloc_fn_labels);
    p.emit_prelude           = fn_ptr(_a64_emit_prelude);
    p.emit_global_data       = fn_ptr(_a64_emit_global_data);
    p.emit_postlude          = fn_ptr(_a64_emit_postlude);
    // Wave 9b A.3/A.4: fat-primitive wraps chip's extracted
    // emit_call. Spine cg_emit_call dispatches through this.
    p.emit_call_full         = fn_ptr(a64_emit_call);
    // Commit B: fat-primitive wraps chip's emit_func. Spine
    // cg_emit_func dispatches through this.
    p.emit_func_full         = fn_ptr(cg_emit_func);
    // Wave 18: inline builtin dispatch primitives. Consumed by
    // cg_builtin_dispatch when peek / poke / etc. lift from chip
    // ladders into the spine.
    p.emit_node                  = fn_ptr(cg_emit_node);
    p.emit_mem_read              = fn_ptr(_a64_emit_mem_read);
    p.emit_mem_read_indexed      = fn_ptr(_a64_emit_mem_read_indexed);
    p.emit_mem_write             = fn_ptr(_a64_emit_mem_write);
    p.emit_push_acc              = fn_ptr(_a64_emit_push_acc);
    p.emit_pop_scratch           = fn_ptr(_a64_emit_pop_scratch);
    p.emit_coerce_float_to_int   = fn_ptr(_a64_emit_coerce_float_to_int);
    p.emit_floor_to_int          = fn_ptr(_a64_emit_floor_to_int);
    p.emit_round_to_int          = fn_ptr(_a64_emit_round_to_int);
    p.emit_mem_barrier           = fn_ptr(_a64_emit_mem_barrier);
    p.emit_shift_right_logical   = fn_ptr(_a64_emit_shift_right_logical);
    p.emit_ror32                 = fn_ptr(_a64_emit_ror32);
    p.emit_load_float_ret        = fn_ptr(_a64_emit_load_float_ret);
    p.emit_trap_if_zero          = fn_ptr(_a64_emit_trap_if_zero);
    p.emit_syscall               = fn_ptr(_a64_emit_syscall);
    p.emit_syscall_norm_err      = fn_ptr(_a64_emit_syscall_norm_err);
    p.emit_fn_ptr                = fn_ptr(_a64_emit_fn_ptr);
    // Wave 19 trivial function-frame primitives (wired; spine
    // takeover of emit_func happens in batch 6 of the wave).
    p.fn_scratch_base            = fn_ptr(_a64_fn_scratch_base);
    p.emit_implicit_ret_zero     = fn_ptr(_a64_emit_implicit_ret_zero);
    p.emit_body                  = fn_ptr(_a64_emit_body_prim);
    p.save_main_runtime_globals  = fn_ptr(_a64_save_main_runtime_globals);
    p.emit_narrow_float_params   = fn_ptr(_a64_emit_narrow_float_params);
    p.fn_pre_reg_vars            = fn_ptr(_a64_fn_pre_reg_vars);
    p.fn_compute_offsets         = fn_ptr(_a64_fn_compute_offsets);
    p.fn_reset_chip_state        = fn_ptr(_a64_fn_reset_chip_state);
    p.fn_reserve_spill           = fn_ptr(_a64_fn_reserve_spill);
    p.fn_label_for               = fn_ptr(_a64_fn_label_for);
    p.emit_prologue_full         = fn_ptr(_a64_emit_prologue_full);
    // Wave 20 statement orchestration primitives.
    p.emit_struct_copy_word      = fn_ptr(_a64_emit_struct_copy_word);
    p.emit_peek_cond             = fn_ptr(_a64_emit_peek_cond);
    p.emit_cmp_scratch_acc       = fn_ptr(_a64_emit_cmp_scratch_acc);
    p.emit_branch_if_nonzero     = fn_ptr(_a64_emit_branch_if_nonzero);
    // Wave 21 emit_node scaffolding.
    p.emit_binop_save_left       = fn_ptr(_a64_emit_binop_save_left);
    p.emit_binop_resolve         = fn_ptr(_a64_emit_binop_resolve);
    p.emit_addr_stack_struct     = fn_ptr(_a64_emit_addr_stack_struct);
    p.emit_store_var_typed       = fn_ptr(_a64_emit_store_var_typed);
    p.emit_memst_float_simd      = fn_ptr(_a64_emit_memst_float_simd);
    p.emit_memst_float_scalar    = fn_ptr(_a64_emit_memst_float_scalar);
    p.emit_memst_int             = fn_ptr(_a64_emit_memst_int);
    p.emit_switch_jtbl           = fn_ptr(_a64_emit_switch_jtbl);
    p.emit_pop_discard           = fn_ptr(_a64_emit_pop_discard);
    p.emit_branch_eq             = fn_ptr(_a64_emit_branch_eq);
    p.emit_branch_ne             = fn_ptr(_a64_emit_branch_ne);
    p.emit_coerce_int_to_float   = fn_ptr(_a64_emit_coerce_int_to_float);
    p.emit_float_store_scalar    = fn_ptr(_a64_emit_float_store_scalar);
    p.emit_fpush                 = fn_ptr(a64_emit_fpush);
    p.emit_fpop                  = fn_ptr(a64_emit_fpop);
    // Phase 6.2c — caller_pc(n) FP-chain walk.
    p.emit_caller_pc             = fn_ptr(_a64_emit_caller_pc);
}

void init_codegen_arm64() {
    cg_install_arm64_primitives();

    init_bug_inl();   // reset shared .bug inline-range arrays (spine)
    cg_fn_name = arr_new(); cg_fn_par = arr_new();
    cg_fn_pcnt = arr_new(); cg_fn_body = arr_new();
    cg_fn_bcnt = arr_new(); cg_fn_fidx = arr_new();
    cg_gl_name = arr_new();
    cg_ex_name = arr_new(); cg_ex_ret = arr_new();
    cg_ex_args = arr_new(); cg_ex_acnt = arr_new();
    cg_vars = arr_new();
    cg_var_stack = arr_new();
    cg_var_struct_idx = arr_new();
    cg_var_off = arr_new();
    cg_var_forced_ty = arr_new();
    cg_var_refs = arr_new();
    cg_var_addr_taken = arr_new();
    cg_var_promote = arr_new();
    cg_const_val = arr_new();
    cg_const_wt = arr_new();
    cg_const_reg = arr_new();
    a64_promoted_regs = arr_new();
    a64_promoted_fregs = arr_new();
    cg_flt_tbl = arr_new();
    cg_str_tbl = arr_new();
    cg_lbl_cnt = 0; cg_depth = 0;
    cg_break_stack = arr_new();
    cg_continue_stack = arr_new();
    a64_bin_mode = 0;
    a64_fn_lbl = arr_new();
    a64_ret_lbl = 0;
    // Initialized to 0 (invalid packed name). Real values are assigned
    // by cg_bind_startup_syms() once brt0.bsm has been parsed.
    cg_argc_sym = 0;
    cg_argv_sym = 0;
    cg_envp_sym = 0;
    a64_gp_free_mask = 0;
    a64_simd_free_mask = 0;
}

// ── Phase B1 register freelist helpers ──────────────────────
//
// Reset both pools to fully-free at the start of every function. GP
// pool covers x9..x15 (bit i = reg 9+i free). SIMD pool covers v0..v15
// (bit i = reg i free). Fallbacks to push/pop are unconditional — if
// the freelist is full, the caller must emit the old stack-save path
// so no code path ever runs out of options.

void a64_freelist_reset() {
    a64_gp_free_mask = 0x7F;     // bits 0..6 set = x9..x15 all free
    a64_simd_free_mask = 0xFFFF; // bits 0..15 set = v0..v15 all free
}

// Allocate a free GP temp. Returns register number (9..15) on success
// or -1 when the pool is exhausted. Callers must fall back to
// a64_emit_push / a64_emit_pop on -1.
a64_gp_alloc() {
    auto i, m;
    for (i = 0; i < 7; i++) {
        m = 1 << i;
        if (a64_gp_free_mask & m) {
            a64_gp_free_mask = a64_gp_free_mask & ~m;
            return 9 + i;
        }
    }
    return -1;
}

// Return a previously-allocated GP reg to the pool. No-op if reg is
// outside the x9..x15 range — freeing a permanent reg (x0-x8) would
// corrupt the mask bookkeeping. Double-free is silent (bit stays set).
void a64_gp_free(reg) {
    auto m;
    if (reg < 9 || reg > 15) { return; }
    m = 1 << (reg - 9);
    a64_gp_free_mask = a64_gp_free_mask | m;
}

// Number of GP temps currently free (popcount of the free mask). The
// integer compute-in-place gate uses this so a tree only takes the
// destination-driven path when enough registers are actually available.
a64_gp_free_count() {
    auto m, c;
    m = a64_gp_free_mask; c = 0;
    while (m != 0) { c = c + (m & 1); m = m >> 1; }
    return c;
}

// Allocate a free SIMD reg. Returns register number (0..15) or -1.
// The SIMD pool is reserved from day one for Phase B4 (: double slice)
// so its existence does not become a B1-B3 refactor later.
static a64_simd_alloc() {
    auto i, m;
    for (i = 0; i < 16; i++) {
        m = 1 << i;
        if (a64_simd_free_mask & m) {
            a64_simd_free_mask = a64_simd_free_mask & ~m;
            return i;
        }
    }
    return -1;
}

// Return a SIMD reg to the pool. Bounds-checked the same way as GP.
// Public (like a64_gp_free) — the T_BINOP resolve in a64_primitives frees
// the SIMD scratch it parked the float left operand in.
void a64_simd_free(reg) {
    auto m;
    if (reg < 0 || reg > 15) { return; }
    m = 1 << reg;
    a64_simd_free_mask = a64_simd_free_mask | m;
}

// Allocate a SIMD scratch for a float binop's left operand. Restricts to
// caller-saved v2..v7 — skipping v0 (the accumulator) and v1 (the d1
// "left" slot that resolve writes into), and the callee-saved v8..v15
// (which would need a prologue spill). Returns the reg number, or -1 when
// none is free (the caller then falls back to the float value-stack).
// Public — the T_BINOP save/resolve in a64_primitives reaches it (the
// general a64_simd_alloc is static, reserved for the : double pool).
a64_simd_alloc_temp() {
    auto i, m;
    for (i = 2; i < 8; i++) {
        m = 1 << i;
        if (a64_simd_free_mask & m) {
            a64_simd_free_mask = a64_simd_free_mask & ~m;
            return i;
        }
    }
    return -1;
}

// Return 1 if the given subtree contains any T_CALL node. Used by the
// T_BINOP freelist path to decide whether a register save via mov is
// safe across the right-side emission. ARM64 treats x9..x15 as caller-
// saved, so a BL instruction anywhere in the right-side expression
// would clobber a value we parked there — in that case we must fall
// back to the stack-save path.
//
// Pure tree scan, no side effects — eligible for `: base`.
static _a64_has_call(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    switch (t) {
    T_CALL { return 1; }
    T_BINOP {
        if (_a64_has_call(n.b)) { return 1; }
        return _a64_has_call(n.c);
    }
    T_TERNARY {
        if (_a64_has_call(n.a)) { return 1; }
        if (_a64_has_call(n.b)) { return 1; }
        return _a64_has_call(n.c);
    }
    T_ASSIGN, T_MEMST {
        if (_a64_has_call(n.a)) { return 1; }
        return _a64_has_call(n.b);
    }
    T_UNARY { return _a64_has_call(n.b); }
    T_MEMLD, T_ADDR, T_RET { return _a64_has_call(n.a); }
    else { return 0; }
    }
}

// Look up the packed names of brt0's hidden globals (_bpp_argc, _bpp_argv,
// _bpp_envp) from the globals array. Must be called AFTER brt0.bsm has been
// parsed (any time during module 0 emission). The packed names are then
// used as relocation targets for argc_get/argv_get/envp_get builtins and
// for the argc/argv/envp save in main()'s prologue.
// cg_bind_startup_syms lives in bpp_codegen.bsm.

// ── Bridge: copy parser data into emitter parallel arrays ──
// Same pattern as bpp_emitter.bsm:bridge_data().

// cg_bridge_data lives in bpp_codegen.bsm.

// ── String utilities ───────────────────────────────────────

// Find an extern function by packed name. Returns first match index or -1.
// cg_find_ext, cg_find_ext_by_argc, cg_ext_ret_is_float live in
// bpp_codegen.bsm.

// cg_str_eq, cg_str_eq_packed live in bpp_codegen.bsm.

// Print a packed string to stdout.
// Public so a64_primitives.bsm can use the same packed-name
// printer when emitting global-relocation operands in asm mode.
void a64_print_p(p) {
    print_buf(cg_sbuf + unpack_s(p), unpack_l(p));
}

// ── Helper functions ───────────────────────────────────────

// Print a decimal integer to stdout. Used for assembly immediates.
// Public so a64_primitives.bsm can reuse the same decimal printer
// when emitting asm-mode operands.
void a64_print_dec(n) {
    auto buf, len, i;
    if (n < 0) { putchar('-'); n = 0 - n; }
    if (n == 0) { putchar('0'); return; }
    buf = malloc(20); len = 0;
    while (n > 0) {
        poke(buf + len, '0' + n % 10);
        len++;
        n /= 10;
    }
    for (i = len - 1; i >= 0; i--) {
        putchar(peek(buf + i));
    }
}

// ── Variable tracking for current function ─────────────────

// Add a variable to the current scope. Returns its slot index.
// cg_var_add, cg_var_idx live in bpp_codegen.bsm.

// ── Phase B3 — local register allocation ──────────────────

// cg_b3_eligible, cg_b3_walk live in bpp_codegen.bsm.

// Promotion-register sequence. Slots 0..9 are the callee-saved pool
// x19..x28 (always safe, in ANY function — AAPCS64 reserves all ten as
// plain general-purpose callee-saved with no special platform meaning;
// only x18 carries a platform-register reservation on Apple targets,
// and it is never touched here). Widened from x19..x24 (6 regs) to
// x19..x28 (10 regs) — found re-examining games/rts2/rts2_combat.bsm's
// `_combat_step` auto-acquire loop (14 simultaneously-live integers,
// only 6 of which fit the old budget, spilling 8 to the frame every
// iteration of a 13x13 grid scan) while scoping RegAlloc v2: a real,
// currently-unclaimed 4-register lever that needs zero liveness / CFG
// architecture, just claiming AAPCS64 registers this backend never
// used. In a LEAF function (no calls) slots 10..13 extend FURTHER into
// the caller-saved x9..x12 — nothing can clobber them mid-function —
// widening the leaf budget to 14. x13..x15 stay reserved as expression
// / CIP temps regardless. Returns the physical register for `slot`,
// or -1 past the budget.
static _a64_b3_reg_at(slot) {
    if (slot < 10) { return 19 + slot; }
    if (cg_fn_leaf) {
        if (slot < 14) { return 9 + (slot - 10); }
    }
    return -1;
}

// When a caller-saved register (x9..x15) is claimed for promotion it must
// leave the expression-temp freelist so it is not handed out as a temp too.
static _a64_b3_claim_freelist(reg) {
    if (reg <= 15) { a64_gp_free_mask = a64_gp_free_mask & ~(1 << (reg - 9)); }
}

void _a64_b3_select() {
    auto used, vi, n, best_vi, best_refs, reg;
    n = arr_len(cg_vars);
    arr_clear(a64_promoted_regs);
    used = 0;
    while (1) {
        reg = _a64_b3_reg_at(used);
        if (reg < 0) { return; }
        best_vi = -1;
        best_refs = 1;
        for (vi = 0; vi < n; vi++) {
            if (arr_get(cg_var_promote, vi) >= 0) { continue; }
            if (cg_b3_eligible(vi) == 0) { continue; }
            if (arr_get(cg_var_refs, vi) > best_refs) {
                best_refs = arr_get(cg_var_refs, vi);
                best_vi = vi;
            }
        }
        if (best_vi < 0) { return; }
        arr_set(cg_var_promote, best_vi, reg);
        a64_promoted_regs = arr_push(a64_promoted_regs, reg);
        _a64_b3_claim_freelist(reg);
        used++;
    }
}

// RegAlloc v2 Stage E — replaces _a64_b3_select's own integer-local
// decision (already run, already populated cg_var_promote and
// a64_promoted_regs) with the linear-scan one. Refuses (returns 0,
// leaving B3's decision untouched) when:
//   - the linear-scan wants to promote a variable B3 itself would
//     never have considered (cg_b3_eligible == 0 — address-taken,
//     stack-struct, float, or sub-word-sliced). regalloc_linear_scan's
//     intervals come from touched-bits, which track every
//     cg_var_idx-resolvable local regardless of B3 eligibility, so
//     this check is NOT redundant with anything upstream;
//   - any assigned slot doesn't map to a real register (a budget
//     mismatch — should not happen if the caller passed the right
//     budget, but fail closed, not open).
// Validates everything FIRST, with zero mutation, so a refused swap
// always leaves B3's own decision completely intact — only once every
// check passes does pass 2 touch any shared state.
//
// On success: resets cg_var_promote + a64_promoted_regs, rebuilds both
// from `assigns` via _a64_b3_reg_at (the SAME table _a64_b3_select
// itself reads — no new register policy, just a different SELECTOR
// feeding the same physical pool), re-claims the freelist for every
// newly-promoted register (mirrors _a64_b3_select's own per-pick
// _a64_b3_claim_freelist call), and re-runs constant promotion
// (_a64_b3_select_const) since it claims whatever budget the local
// pass leaves over — that budget just changed.
_a64_regalloc_apply(assigns) {
    auto n, i, asn: RegAssign, reg, nc, slot_seen, j;
    n = arr_struct_count(assigns);

    // Pass 1 (validate ONLY — no mutation yet).
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.slot >= 0) {
            if (cg_b3_eligible(asn.var_idx) == 0) { return 0; }
            if (_a64_b3_reg_at(asn.slot) < 0) { return 0; }
        }
        i++;
    }

    // Pass 2 (apply). cg_var_promote is SHARED with float promotion
    // (disjoint value ranges, x19..x28/x9..x12 vs d8..d15, but the
    // same array) — reset only the entries `assigns` actually covers
    // (every variable the int linear-scan considered, B3 or not),
    // never the whole array, or this would wipe out
    // _a64_b3_select_float's picks (or, if Stage E's own float swap
    // already ran first, ITS picks too). a64_promoted_regs is the
    // int-only save list, safe to clear and rebuild from scratch.
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        arr_set(cg_var_promote, asn.var_idx, -1);
        i++;
    }
    arr_clear(a64_promoted_regs);

    // `slot_seen` tracks which logical slots have already contributed
    // their physical register to a64_promoted_regs. Slot-sharing is
    // the WHOLE POINT of this arc — several variables legitimately
    // share one slot, each with its own `assigns` entry — but the
    // prologue/epilogue save list must list each PHYSICAL REGISTER
    // exactly once. Pushing it once per variable instead (the first
    // version of this function did) double-saves/double-restores a
    // shared register, corrupting the frame layout — caught via
    // `bug --disasm` on stb/stbfilter.bsm's moog_taps (d8 and d10 each
    // appeared twice in the prologue/epilogue once enough locals
    // shared those slots), silently wrong output (0.0 instead of the
    // real filtered value), not even a crash.
    slot_seen = arr_new();
    j = 0;
    while (j < 64) { slot_seen = arr_push(slot_seen, 0); j++; }
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.slot >= 0) {
            reg = _a64_b3_reg_at(asn.slot);
            arr_set(cg_var_promote, asn.var_idx, reg);
            if (arr_get(slot_seen, asn.slot) == 0) {
                arr_set(slot_seen, asn.slot, 1);
                a64_promoted_regs = arr_push(a64_promoted_regs, reg);
            }
            _a64_b3_claim_freelist(reg);
        }
        i++;
    }

    // Constant promotion (Stage 2a) claims budget left over AFTER
    // locals — cg_const_reg already holds B3's own picks from before
    // this swap; clear them back to "unpromoted" so the re-run
    // considers the NEW remaining budget fresh, not B3's old one.
    nc = arr_len(cg_const_reg);
    i = 0;
    while (i < nc) { arr_set(cg_const_reg, i, -1); i++; }
    _a64_b3_select_const();
    return 1;
}

// RegAlloc v2 Stage E, FLOAT side — mirrors _a64_regalloc_apply exactly,
// over the disjoint float pool (d8..d15, slot N -> register 8+N, fixed
// width 8 regardless of leaf/non-leaf — float promotion has no leaf
// widening the way int does) and cg_b3_eligible_float instead of
// cg_b3_eligible. Same reset-only-what-assigns-covers discipline:
// cg_var_promote is shared with int promotion (disjoint value ranges,
// same array), so this must never touch entries outside `assigns`.
// a64_promoted_fregs is the float-only save list, safe to clear and
// rebuild from scratch. No constant-promotion re-run here — Stage 2a
// only ever claims INTEGER budget left over after int locals; nothing
// analogous exists for float.
_a64_regalloc_apply_float(assigns) {
    auto n, i, asn: RegAssign, reg, slot_seen, j;
    n = arr_struct_count(assigns);

    // Pass 1 (validate ONLY — no mutation yet).
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.slot >= 0) {
            if (cg_b3_eligible_float(asn.var_idx) == 0) { return 0; }
            if (asn.slot >= 8) { return 0; }   // budget mismatch — fail closed
        }
        i++;
    }

    // Pass 2 (apply).
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        arr_set(cg_var_promote, asn.var_idx, -1);
        i++;
    }
    arr_clear(a64_promoted_fregs);

    // `slot_seen` — see _a64_regalloc_apply's own comment for why this
    // exists: a shared slot must contribute its physical register to
    // a64_promoted_fregs exactly once, never once per variable that
    // shares it (the bug that corrupted stb/stbfilter.bsm's moog_taps
    // — d8/d10 each saved and restored twice, silently wrong output).
    slot_seen = arr_new();
    j = 0;
    while (j < 8) { slot_seen = arr_push(slot_seen, 0); j++; }
    i = 0;
    while (i < n) {
        asn = arr_struct_at(assigns, i);
        if (asn.slot >= 0) {
            reg = 8 + asn.slot;
            arr_set(cg_var_promote, asn.var_idx, reg);
            if (arr_get(slot_seen, asn.slot) == 0) {
                arr_set(slot_seen, asn.slot, 1);
                a64_promoted_fregs = arr_push(a64_promoted_fregs, reg);
            }
        }
        i++;
    }
    return 1;
}

// Stage 2a — promote the hottest loop-invariant constants into whatever
// callee-saved registers (x19..x28) the local pass left free. Each chosen
// constant is recorded in cg_const_reg and its register pushed to
// a64_promoted_regs, so the existing prologue/epilogue save-restore and
// frame-spill reservation cover it for free. Only constants that appeared
// inside a loop (weight >= 1000) are worth a register; straight-line
// constants stay inline.
void _a64_b3_select_const() {
    auto slot, n, best_idx, best_wt, ci, reg, pi, pn, _taken;
    // `arr_len(a64_promoted_regs)` used to stand in for "next free
    // slot" back when every promotion claimed slots 0, 1, 2, ...
    // strictly in order (B3's own one-pick-per-slot policy never
    // skips one). RegAlloc v2's slot-sharing breaks that invariant:
    // a variable's slot is decided by start_pos order, not by slot
    // number, so a64_promoted_regs can legitimately contain (say)
    // slots 0, 3, 1 with slot 2 never claimed at all. Treating its
    // LENGTH as "the next numeric slot" would then hand out slot 2's
    // physical register as if it were free when slot 3 is the one
    // actually still open — colliding with whichever variable already
    // holds it. Walk the slot space directly and skip any slot whose
    // physical register is already in the promoted list.
    slot = 0;
    n = arr_len(cg_const_val);
    while (1) {
        reg = _a64_b3_reg_at(slot);
        while (reg >= 0) {
            _taken = 0;
            pn = arr_len(a64_promoted_regs);
            for (pi = 0; pi < pn; pi++) {
                if (arr_get(a64_promoted_regs, pi) == reg) { _taken = 1; pi = pn; }
            }
            if (_taken == 0) { break; }
            slot++;
            reg = _a64_b3_reg_at(slot);
        }
        if (reg < 0) { return; }
        best_idx = -1;
        best_wt = 999;                   // threshold: only loop constants (>= 1000)
        for (ci = 0; ci < n; ci++) {
            if (arr_get(cg_const_reg, ci) >= 0) { continue; }
            if (arr_get(cg_const_wt, ci) > best_wt) {
                best_wt = arr_get(cg_const_wt, ci);
                best_idx = ci;
            }
        }
        if (best_idx < 0) { return; }
        arr_set(cg_const_reg, best_idx, reg);
        a64_promoted_regs = arr_push(a64_promoted_regs, reg);
        _a64_b3_claim_freelist(reg);
        slot++;
    }
}

// F.2.c Stage 2 — float B3. Promote the hottest `: float` locals into the
// callee-saved d8..d15 band (8 registers). Mirrors _a64_b3_select but
// over cg_b3_eligible_float, recording the chosen d-register numbers
// (8..15) in cg_var_promote and a64_promoted_fregs (used by the prologue
// spill). Runs alongside the integer pass: the two pools never overlap
// (x19..x28 vs d8..d15), so a var is promoted by at most one of them.
void _a64_b3_select_float() {
    auto budget, used, vi, n, best_vi, best_refs, reg;
    budget = 8;
    n = arr_len(cg_vars);
    arr_clear(a64_promoted_fregs);
    used = 0;
    while (used < budget) {
        best_vi = -1;
        best_refs = 1;
        for (vi = 0; vi < n; vi++) {
            if (arr_get(cg_var_promote, vi) >= 0) { continue; }
            if (cg_b3_eligible_float(vi) == 0) { continue; }
            if (arr_get(cg_var_refs, vi) > best_refs) {
                best_refs = arr_get(cg_var_refs, vi);
                best_vi = vi;
            }
        }
        if (best_vi < 0) { return; }
        reg = 8 + used;
        arr_set(cg_var_promote, best_vi, reg);
        a64_promoted_fregs = arr_push(a64_promoted_fregs, reg);
        used++;
    }
}


// Walk a function body and register all declared variables (for frame sizing).
// S4 P3b-2: top-level entry also walks the body for inlineable multi-stmt
// T_CALL sites and pre-registers `_inl<N>_<orig>` slots for each callee's
// params + locals. The walk happens AFTER the regular T_DECL registration
// because nested-body recursion (T_IF/T_WHILE/T_BLOCK/T_SWITCH branches)
// pre_reg_vars itself recurses through the same function — without the
// outer-only guard we'd walk inline sites multiple times. The `arr` ==
// caller's body top check uses a static reentry flag.
static auto _a64_pre_reg_depth;

void a64_pre_reg_vars(arr, cnt) {
    auto i, j;
    auto n: Node;
    _a64_pre_reg_depth++;
    i = 0;
    while (i < cnt) {
        n = *(arr + i * 8);
        if (n != 0) {
            if (n.ntype == T_DECL) {
                j = 0;
                while (j < n.b) {
                    auto vi;
                    vi = cg_var_add(*(n.a + j * 8));
                    // Mark stack struct variables (var keyword: n.d == 1).
                    if (n.d == 1) {
                        arr_set(cg_var_stack, vi, 1);
                        arr_set(cg_var_struct_idx, vi, get_var_type(*(n.a + j * 8)));
                    }
                    // Record the explicit primitive type hint PER DECLARATOR
                    // (n.e[j], not the statement-wide n.c) — see cg_decl_var_hint.
                    auto _vh;
                    _vh = cg_decl_var_hint(n, j);
                    if (_vh > 0) {
                        arr_set(cg_var_forced_ty, vi, _vh);
                    }
                    j++;
                }
            }
            if (n.ntype == T_IF) {
                a64_pre_reg_vars(n.b, n.c);
                if (n.e > 0) { a64_pre_reg_vars(n.d, n.e); }
            }
            if (n.ntype == T_WHILE) { a64_pre_reg_vars(n.b, n.c); }
            // T_BLOCK wraps a statement list inside a single node —
            // produced by dead-code-elimination collapsing if/else
            // and by Phase 6.3's @profile lowering. Both can carry
            // auto declarations that need to land in the function's
            // local table; without this recursion the codegen falls
            // back to "global", and the linker errors with
            // `internal error: global '<name>' not found in data
            // section` because the symbol was never allocated.
            if (n.ntype == T_BLOCK) { a64_pre_reg_vars(n.b, n.c); }
            if (n.ntype == T_SWITCH) {
                // Recurse into each switch arm body to find auto declarations.
                auto sw_bodies, sw_cnt2, si2, sb_arr2, sb_cnt2;
                sw_bodies = n.src_tok;
                sw_cnt2 = n.c;
                for (si2 = 0; si2 < sw_cnt2; si2++) {
                    sb_arr2 = sw_bodies[si2 * 2];
                    sb_cnt2 = sw_bodies[si2 * 2 + 1];
                    a64_pre_reg_vars(sb_arr2, sb_cnt2);
                }
                if (n.d != 0) { a64_pre_reg_vars(n.d, n.e); }
            }
        }
        i++;
    }
    // S4 P3b-2: at the top-level exit (recursion depth == 1),
    // walk the entire body for inlineable multi-stmt T_CALL sites
    // and pre-register `_inl<N>_<orig>` slots. Doing this AFTER
    // the regular T_DECL pass means the caller's own locals are
    // already counted in cg_vars when mangled slots get appended.
    // Doing it only at depth == 1 prevents duplicate registration
    // when recursive calls from T_IF/T_WHILE/etc above re-enter.
    _a64_pre_reg_depth--;
    if (_a64_pre_reg_depth == 0) {
        _inline_pre_reg_walk_body(arr, cnt);
    }
}

// ── Literal helpers ────────────────────────────────────────
// cg_parse_int, cg_is_float_lit live in bpp_codegen.bsm.

// ── Type query helpers ─────────────────────────────────────
// cg_var_type and cg_var_is_float live in bpp_codegen.bsm.

// Emit a sized load from [x29, #off] into x0/w0 based on the variable's
// explicit type annotation. Only uses sub-word ops when the programmer
// declared a type hint. Inferred types always use 64-bit load.
// Returns 1 if result is in d0 (float), 0 if in x0 (integer).
// Public — Phase 3.4 Wave 3 wraps this as `_a64_emit_load_local`
// inside a64_primitives.bsm. Keeps the B3 promoted-reg
// short-circuit and the SL_DOUBLE/HALF/QUARTER + sub-word
// dispatch chip-private; the spine just calls through.
a64_emit_load_var(vi, off) {
    auto fty, sl, _preg;
    // Phase B3: promoted local — emit register move, skip stack load.
    _preg = arr_get(cg_var_promote, vi);
    if (_preg >= 0) {
        // F.2.c Stage 2: a promoted FLOAT local lives in d8..d15; bring it
        // into the d0 accumulator with fmov (not a GP mov) and report the
        // float result type.
        if (cg_var_is_float(vi)) {
            if (a64_bin_mode) { enc_fmov(0, _preg); }
            else { out("  fmov d0, d"); a64_print_dec(_preg); putchar(10); }
            return 1;
        }
        if (a64_bin_mode) { enc_add_imm(0, _preg, 0); }
        else { out("  mov x0, x"); a64_print_dec(_preg); putchar(10); }
        return 0;
    }
    fty = arr_get(cg_var_forced_ty, vi);
    sl = ty_slice(fty);
    // `: double` — 128-bit SIMD local. Value lives on the stack as a
    // 16-byte slot; LDR Q pulls it straight into V0 for the caller.
    if (sl == SL_DOUBLE) {
        if (a64_bin_mode) { enc_ldr_q_uoff(0, 29, off); }
        else { out("  ldr q0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 2;
    }
    // Float sub-types: FLOAT_H loads s-register, FLOAT_Q loads h-register.
    // All widen to d0 (double) for computation.
    if (cg_var_is_float(vi)) {
        if (sl == SL_HALF) {
            if (a64_bin_mode) { enc_ldr_s_uoff(0, 29, off); }
            if (a64_bin_mode) { enc_fcvt_d_s(0, 0); }
            if (a64_bin_mode == 0) { out("  ldr s0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
            if (a64_bin_mode == 0) { out("  fcvt d0, s0"); putchar(10); }
            return 1;
        }
        if (sl == SL_QUARTER) {
            if (a64_bin_mode) { enc_ldr_h_uoff(0, 29, off); }
            if (a64_bin_mode) { enc_fcvt_d_h(0, 0); }
            if (a64_bin_mode == 0) { out("  ldr h0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
            if (a64_bin_mode == 0) { out("  fcvt d0, h0"); putchar(10); }
            return 1;
        }
        if (a64_bin_mode) { enc_ldr_d_uoff(0, 29, off); }
        if (a64_bin_mode == 0) { out("  ldr d0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 1;
    }
    // Sub-word loads only when explicitly annotated by the programmer.
    if (sl == SL_BYTE) {
        if (a64_bin_mode) { enc_ldrb_uoff(0, 29, off); }
        else { out("  ldrb w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    if (sl == SL_QUARTER) {
        if (a64_bin_mode) { enc_ldrh_uoff(0, 29, off); }
        else { out("  ldrh w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    if (sl == SL_HALF) {
        if (a64_bin_mode) { enc_ldr_w_uoff(0, 29, off); }
        else { out("  ldr w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    // Default: 64-bit load.
    if (a64_bin_mode) { enc_ldr_uoff(0, 29, off); }
    else { out("  ldr x0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
}

// Emit a sized store from x0/d0 into [x29, #off] based on the variable's
// explicit type annotation. Only uses sub-word ops when the programmer
// declared a type hint. rty: 0 = integer in x0, 1 = float in d0.
void a64_emit_store_var(vi, off, rty) {
    auto fty, sl, _preg;
    _preg = arr_get(cg_var_promote, vi);
    if (_preg >= 0) {
        // F.2.c Stage 2: a promoted FLOAT local lives in d8..d15. Keep the
        // float bits (fmov), widening an integer RHS with scvtf first —
        // never the fcvtzs int-coercion used for promoted int locals.
        if (cg_var_is_float(vi)) {
            if (rty == 0) {
                if (a64_bin_mode) { enc_scvtf(0, 0); } else { out("  scvtf d0, x0"); putchar(10); }
            }
            if (a64_bin_mode) { enc_fmov(_preg, 0); }
            else { out("  fmov d"); a64_print_dec(_preg); out(", d0"); putchar(10); }
            return 0;
        }
        if (rty == 1) {
            if (a64_bin_mode) { enc_fcvtzs(0, 0); } else { out("  fcvtzs x0, d0"); putchar(10); }
        }
        if (a64_bin_mode) { enc_add_imm(_preg, 0, 0); }
        else { out("  mov x"); a64_print_dec(_preg); out(", x0"); putchar(10); }
        return 0;
    }
    fty = arr_get(cg_var_forced_ty, vi);
    sl = ty_slice(fty);
    // `: double` — 128-bit SIMD. Incoming value is expected in V0 (rty=2);
    // STR Q writes the whole 16-byte slot back to the stack.
    if (sl == SL_DOUBLE) {
        if (rty != 2) {
            diag_error(231);
            diag_str("cannot assign non-SIMD value to ': double' local");
            diag_newline();
        }
        if (a64_bin_mode) { enc_str_q_uoff(0, 29, off); }
        else { out("  str q0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    // Guard: SIMD value assigned to a non-SIMD local is a type error.
    // B3 may have promoted the target to a GPR — writing V0's bits to
    // X0 / a callee-saved reg produces silent garbage.
    if (rty == 2) {
        diag_error(231);
        diag_str("cannot assign SIMD value to non-':double' local (declare it ': double')");
        diag_newline();
    }
    // Float sub-types: convert int→double if needed, then narrow for sub-types.
    if (cg_var_is_float(vi)) {
        if (rty == 0) {
            if (a64_bin_mode) { enc_scvtf(0, 0); }
            if (a64_bin_mode == 0) { out("  scvtf d0, x0"); putchar(10); }
        }
        if (sl == SL_HALF) {
            if (a64_bin_mode) { enc_fcvt_s_d(0, 0); }
            if (a64_bin_mode) { enc_str_s_uoff(0, 29, off); }
            if (a64_bin_mode == 0) { out("  fcvt s0, d0"); putchar(10); }
            if (a64_bin_mode == 0) { out("  str s0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
            return 0;
        }
        if (sl == SL_QUARTER) {
            if (a64_bin_mode) { enc_fcvt_h_d(0, 0); }
            if (a64_bin_mode) { enc_str_h_uoff(0, 29, off); }
            if (a64_bin_mode == 0) { out("  fcvt h0, d0"); putchar(10); }
            if (a64_bin_mode == 0) { out("  str h0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
            return 0;
        }
        if (a64_bin_mode) { enc_str_d_uoff(0, 29, off); }
        if (a64_bin_mode == 0) { out("  str d0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    // Integer path: convert float to int if source is float.
    if (rty == 1) {
        if (a64_bin_mode) { enc_fcvtzs(0, 0); } else { out("  fcvtzs x0, d0"); putchar(10); }
    }
    // Sub-word stores only when explicitly annotated by the programmer.
    if (sl == SL_BYTE) {
        if (a64_bin_mode) { enc_strb_uoff(0, 29, off); }
        else { out("  strb w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    if (sl == SL_QUARTER) {
        if (a64_bin_mode) { enc_strh_uoff(0, 29, off); }
        else { out("  strh w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    if (sl == SL_HALF) {
        if (a64_bin_mode) { enc_str_w_uoff(0, 29, off); }
        else { out("  str w0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
        return 0;
    }
    // Default: 64-bit store.
    if (a64_bin_mode) { enc_str_uoff(0, 29, off); }
    else { out("  str x0, [x29, #"); a64_print_dec(off); out("]"); putchar(10); }
}

// cg_find_fn lives in bpp_codegen.bsm.

// ── ARM64 emission primitives ──────────────────────────────

// Generate a unique label number.
// cg_new_lbl lives in bpp_codegen.bsm.

// Load a 64-bit immediate into x0 using movz/movk sequence.
// Public — Phase 3.4 Wave 2 wraps this as `_a64_emit_mov_imm`
// inside a64_primitives.bsm, while existing inline callers in this
// file keep using a64_emit_mov directly until those sites migrate
// in their own waves (cf. switch jump-table emission in
// a64_emit_switch_jtbl).
void a64_emit_mov(val) {
    auto lo, hi;
    if (a64_bin_mode) { enc_mov_wide(0, val); return 0; }
    if (val >= 0) {
        if (val < 65536) {
            out("  mov x0, #"); a64_print_dec(val); putchar('\n');
            return 0;
        }
    }
    // Use movz/movk for larger values.
    lo = val & 0xFFFF;
    out("  movz x0, #"); a64_print_dec(lo); putchar('\n');
    hi = (val >> 16) & 0xFFFF;
    if (hi > 0) { out("  movk x0, #"); a64_print_dec(hi); out(", lsl #16"); putchar('\n'); }
    hi = (val >> 32) & 0xFFFF;
    if (hi > 0) { out("  movk x0, #"); a64_print_dec(hi); out(", lsl #32"); putchar('\n'); }
    hi = (val >> 48) & 0xFFFF;
    if (hi > 0) { out("  movk x0, #"); a64_print_dec(hi); out(", lsl #48"); putchar('\n'); }
}

// ── Switch jump-table analysis ───────────────────────────────
//
// A switch is eligible for jump-table emission when all arm values are
// compile-time integer literals (T_LIT nodes) AND the range is dense
// enough to make the table small. Results are stored in these globals
// so callers read them without handling out-parameters.

// Switch-analysis globals moved to bpp_codegen.bsm (cg_sw_min,
// cg_sw_max, cg_sw_total) — shared with x64, imported above.

// Return 1 when the switch is eligible for a jump table, 0 otherwise.
// On success, cg_sw_min/max/total hold the observed range and count.
// Density rule: range (max - min) must be under 2 * total, and the
// range must fit in 512 table entries — keeps worst-case table size
// bounded (2 KB of code). Fewer than 3 distinct values use the plain
// comparison chain — a branch table saves nothing at that size.
// cg_switch_is_dense lives in bpp_codegen.bsm.

// Emit an ARM64 jump table for a dense Form-1 switch.
// Layout:
//   <cond eval + normalize + bounds check + adr + add + br>
//   table_lbl:
//     b arm_label_0
//     b arm_label_1
//     ... one slot per value in [min..max]; gaps target else.
//   arm_label_0: body_0 + b sw_end
//   arm_label_1: body_1 + b sw_end
//   ...
//   else_lbl: else_body
//   sw_end_lbl:
//
// Saves O(N) comparison instructions per switch execution at the cost
// of a single indirect branch plus (range+1) words of branch-table code.
void a64_emit_switch_jtbl(nd, sw_end_lbl) {
    auto n: Node;
    auto node: Node;
    auto sw_arms, sw_bodies, sw_cnt, range;
    auto arm_labels, else_lbl, table_lbl;
    auto si, sk, sv_arr, sv_cnt, sb_arr, sb_cnt, i, target, val;
    auto pp: ChipPrimitives;
    pp = cg_prim;

    n = nd;
    sw_arms = n.b;
    sw_bodies = n.src_tok;
    sw_cnt = n.c;
    range = cg_sw_max - cg_sw_min;

    // Allocate one match label per arm plus the else label.
    arm_labels = buf_word(sw_cnt);
    for (si = 0; si < sw_cnt; si++) {
        arm_labels[si] = enc_new_label();
    }
    else_lbl = enc_new_label();
    table_lbl = enc_new_label();

    // Evaluate condition into x0.
    call(pp.emit_node, n.a);

    // Normalize to 0-based index by subtracting min_val.
    // Small positive min: 12-bit sub immediate; otherwise load via mov+sub.
    if (cg_sw_min != 0) {
        if (cg_sw_min > 0) {
            if (cg_sw_min < 0x1000) {
                enc_sub_imm(0, 0, cg_sw_min);
            } else {
                a64_emit_mov(cg_sw_min);
                enc_sub_reg(0, 0, 0);
            }
        } else {
            // Negative min: add |min| via load.
            a64_emit_push();
            a64_emit_mov(cg_sw_min);
            enc_mov_reg(1, 0);
            a64_emit_pop(0);
            enc_sub_reg(0, 0, 1);
        }
    }

    // Bounds check: x0 > range ? go to else (unsigned comparison catches
    // negatives too — they wrap to huge unsigned values).
    enc_cmp_imm(0, range);
    enc_b_cond_label(8, else_lbl);  // B.HI = unsigned higher than

    // Indirect branch: x1 = table_base + (x0 << 2); br x1.
    enc_adr_label(1, table_lbl);
    enc_add_reg_shift(1, 1, 0, 2);
    enc_br(1);

    // Emit the branch table: one `b` instruction per slot in [min..max].
    enc_def_label(table_lbl);
    for (i = 0; i <= range; i++) {
        target = else_lbl;
        for (si = 0; si < sw_cnt; si++) {
            sv_arr = sw_arms[si * 2];
            sv_cnt = sw_arms[si * 2 + 1];
            for (sk = 0; sk < sv_cnt; sk++) {
                node = sv_arr[sk];
                val = cg_parse_int(node.a);
                if (val == cg_sw_min + i) { target = arm_labels[si]; }
            }
        }
        enc_b_label(target);
    }

    // Emit arm bodies. Each body ends with a branch to sw_end.
    for (si = 0; si < sw_cnt; si++) {
        enc_def_label(arm_labels[si]);
        sb_arr = sw_bodies[si * 2];
        sb_cnt = sw_bodies[si * 2 + 1];
        for (sk = 0; sk < sb_cnt; sk++) { cg_emit_stmt(sb_arr[sk]); }
        enc_b_label(sw_end_lbl);
    }

    // Else body.
    enc_def_label(else_lbl);
    if (n.d != 0) {
        auto ek;
        for (ek = 0; ek < n.e; ek++) { cg_emit_stmt(n.d[ek]); }
    }

    enc_def_label(sw_end_lbl);
    free(arm_labels);
    return;
}

// Push x0 onto the stack. Maintains 16-byte alignment.
void a64_emit_push() {
    if (a64_bin_mode) { enc_str_pre(0, 31, -16); } else { out("  str x0, [sp, #-16]!"); putchar('\n'); }
    cg_depth++; return 0;
}

// Pop from the stack into a register (0=x0, 1=x1, etc.).
void a64_emit_pop(r) {
    if (a64_bin_mode) { enc_ldr_post(r, 31, 16); } else { out("  ldr x"); a64_print_dec(r); out(", [sp], #16"); putchar('\n'); }
    cg_depth--; return 0;
}

// Push d0 onto the stack (float value).
void a64_emit_fpush() {
    if (a64_bin_mode) { enc_str_d_pre(0, 31, -16); } else { out("  str d0, [sp, #-16]!"); putchar('\n'); }
    cg_depth++; return 0;
}

// Pop from the stack into a float register (0=d0, 1=d1, etc.).
void a64_emit_fpop(r) {
    if (a64_bin_mode) { enc_ldr_d_post(r, 31, 16); } else { out("  ldr d"); a64_print_dec(r); out(", [sp], #16"); putchar('\n'); }
    cg_depth--; return 0;
}

// Push v0 onto the stack as a 16-byte SIMD value (Phase B4). cg_depth
// tracks 16-byte slots one unit at a time so SIMD push matches scalar
// push for depth bookkeeping.
static void a64_emit_vpush() {
    if (a64_bin_mode) { enc_str_q_pre(0, 31, 0 - 16); }
    else { out("  str q0, [sp, #-16]!"); putchar('\n'); }
    cg_depth++;
}

// Pop a 16-byte SIMD value from the stack into the given V register.
static void a64_emit_vpop(r) {
    if (a64_bin_mode) { enc_ldr_q_post(r, 31, 16); }
    else { out("  ldr q"); a64_print_dec(r); out(", [sp], #16"); putchar('\n'); }
    cg_depth--;
}

// Phase B4: emit a two-operand SIMD builtin through a single helper.
// All six packed-float ops (add/sub/mul/div/min/max) share the same
// spill-right/reload-left choreography — only the NEON opcode and the
// asm mnemonic differ. Caller passes both so the bin and asm paths
// emit in sync.
static void _a64_vec_binop(n: Node, opcode, mnemonic) {
    auto arr;
    auto pp: ChipPrimitives;
    pp = cg_prim;
    arr = n.b;
    call(pp.emit_node, *(arr + 0));   // left  → v0
    a64_emit_vpush();
    call(pp.emit_node, *(arr + 8));   // right → v0
    a64_emit_vpop(1);             // v1 = left
    if (a64_bin_mode) { enc_neon_vvv(opcode, 0, 1, 0); }
    else {
        out("  "); out(mnemonic); out(" v0.4s, v1.4s, v0.4s"); putchar('\n');
    }
}

// ── Expression emission ────────────────────────────────────
// Emits ARM64 code for an expression node.
// Returns 0 if result is integer (in x0), 1 if float (in d0).

a64_emit_call(n) { return 0; }

// Phase 3.4 Wave 9b step A.1 — chip-local extraction of T_CALL
// from a64_emit_node. Pure refactor; byte-identity preserved.
// Later steps will flip production through the portable spine.
a64_emit_call(nd) {
    auto n: Node;
    auto t, op_s, op_l, c0, c1, arr, cnt, i, off, lbl, lbl2, vi, lty, rty;
    auto lit_s, lit_l, sid, str_p, fid, use_flt, is_io, uty, ety, fidx_c, fi, fn_name: Node;
    auto pp: ChipPrimitives;
    pp = cg_prim;
    n = nd; t = n.ntype;
        // (putchar, putchar_err, getchar removed as builtins — they live
        // in bpp_io.bsm as B++ functions that call sys_write/sys_read.)
        // (malloc, free, realloc, memcpy removed as builtins — they live
        // in backend/os/<target>/_bmem_<target>.bsm as B++ functions
        // that call sys_mmap/sys_munmap directly. Auto-injected via
        // bpp_mem.bsm for every user program.)
        // peek dispatch moved to cg_builtin_dispatch in bpp_codegen.bsm.
        // Wave 18 lifts this branch into the spine — chip just exposes
        // emit_mem_read + emit_coerce_float_to_int primitives.
        // poke dispatch moved to cg_builtin_dispatch in bpp_codegen.bsm.
        // Wave 18 lift.
        // Built-in: float_ret() — read the first float return value saved after the last extern call.
        // Loads d0 from the hidden d0_save slot at [x29, #24].
        // float_ret / float_ret2 dispatch moved to cg_builtin_dispatch (Wave 18).
        // shr dispatch moved to cg_builtin_dispatch (Wave 18).
        // assert dispatch moved to cg_builtin_dispatch (Wave 18).
        // str_peek dispatch moved to cg_builtin_dispatch (Wave 18).
        // sys_write / sys_read / sys_open / sys_close dispatch moved to
        // cg_builtin_dispatch (Wave 18 batch 3).
        // sys_mkdir dispatch moved to cg_builtin_dispatch (Wave 18 batch 4).
        // Built-in: sys_fork() — fork the process. Returns child pid to parent, 0 to child.
        if (cg_str_eq(n.a, "sys_fork", 8)) {
            if (a64_bin_mode) {
                enc_mov_wide(16, BSYS_MACOS_FORK);
                enc_svc(0x80);
                enc_csneg(0, 0, 0, 3);
                lbl = enc_new_label();
                enc_cbz_label(1, lbl);
                enc_mov_wide(0, 0);
                enc_def_label(lbl);
            } else {
                out("  mov x16, #2"); putchar('\n');
                out("  svc #0x80"); putchar('\n');
                out("  csneg x0, x0, x0, cc"); putchar('\n');
                out("  cbz x1, 8"); putchar('\n');
                out("  mov x0, #0"); putchar('\n');
            }
            return 0;
        }
        // Built-in: sys_execve(path, argv, envp) — replace process image.
        if (cg_str_eq(n.a, "sys_execve", 10)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0)); a64_emit_push();
            call(pp.emit_node, *(arr + 8)); a64_emit_push();
            call(pp.emit_node, *(arr + 16));
            a64_emit_pop(1);
            a64_emit_pop(2);
            // Swap: x0=path(was x2), x1=argv(was x1), x2=envp(was x0)
            // Actually after pops: x2=path, x1=argv, x0=envp. Need x0=path, x1=argv, x2=envp.
            if (a64_bin_mode) {
                enc_mov_reg(3, 0);  // x3 = envp
                enc_mov_reg(0, 2);  // x0 = path
                enc_mov_reg(2, 3);  // x2 = envp
                enc_mov_wide(16, BSYS_MACOS_EXECVE);
                enc_svc(0x80);
                enc_csneg(0, 0, 0, 3);
            } else {
                out("  mov x3, x0"); putchar('\n');
                out("  mov x0, x2"); putchar('\n');
                out("  mov x2, x3"); putchar('\n');
                out("  mov x16, #59"); putchar('\n');
                out("  svc #0x80"); putchar('\n');
                out("  csneg x0, x0, x0, cc"); putchar('\n');
            }
            return 0;
        }
        // Built-in: sys_waitpid(pid) — wait for child process to exit.
        if (cg_str_eq(n.a, "sys_waitpid", 11)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));
            if (a64_bin_mode) {
                enc_mov_wide(1, 0);  // status = NULL
                enc_mov_wide(2, 0);  // options = 0
                enc_mov_wide(3, 0);  // rusage = NULL
                enc_mov_wide(16, BSYS_MACOS_WAIT4);
                enc_svc(0x80);
                enc_csneg(0, 0, 0, 3);
            } else {
                out("  mov x1, #0"); putchar('\n');
                out("  mov x2, #0"); putchar('\n');
                out("  mov x3, #0"); putchar('\n');
                out("  mov x16, #7"); putchar('\n');
                out("  svc #0x80"); putchar('\n');
                out("  csneg x0, x0, x0, cc"); putchar('\n');
            }
            return 0;
        }
        // sys_ptrace / sys_wait4 / sys_mmap / sys_munmap dispatch moved to
        // cg_builtin_dispatch (Wave 18 batch 4).
        // Built-in: sys_usleep(us) — sleep for N microseconds.
        // Uses select(0,0,0,0,&timeval) — macOS syscall 93.
        // Assumes us < 1000000 so tv_sec=0, tv_usec=us.
        if (cg_str_eq(n.a, "sys_usleep", 10)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));
            if (a64_bin_mode) {
                // x0 = microseconds. Build timeval {0, x0} on stack.
                enc_mov_wide(1, 0);
                enc_stp_pre(1, 0, 31, 0 - 16);  // push {tv_sec=0, tv_usec=x0}
                enc_add_imm(4, 31, 0);   // x4 = sp (pointer to timeval)
                enc_mov_wide(0, 0);      // nfds = 0
                enc_mov_wide(1, 0);      // readfds = NULL
                enc_mov_wide(2, 0);      // writefds = NULL
                enc_mov_wide(3, 0);      // exceptfds = NULL
                enc_mov_wide(16, BSYS_MACOS_SELECT);
                enc_svc(0x80);
                enc_csneg(0, 0, 0, 3);
                enc_add_imm(31, 31, 16); // restore stack
            }
            return 0;
        }
        // Built-in: mem_barrier() — full bidirectional memory fence.
        // Emits ARM64 DMB ISH (Data Memory Barrier, Inner Shareable),
        // encoded as 0xD5033BBF. Used by stbjob to order producer
        // writes against consumer reads on the SPSC queues. This is a
        // full fence, which is overkill compared to release/acquire,
        // but acquire/release primitives can wait until a real audio
        // hot loop proves they matter. Returns 0 by convention.
        // mem_barrier dispatch moved to cg_builtin_dispatch (Wave 18).
        // sys_socket / sys_connect / sys_unlink dispatch moved to
        // cg_builtin_dispatch (Wave 18 batch 4).
        // Built-in: sys_getdents(fd, buf, bufsize) — read directory entries.
        // macOS: getdirentries64 (syscall 344). Returns bytes read, 0 at end.
        if (cg_str_eq(n.a, "sys_getdents", 12)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 16)); a64_emit_push();
            call(pp.emit_node, *(arr + 8)); a64_emit_push();
            call(pp.emit_node, *(arr + 0));
            a64_emit_pop(1); a64_emit_pop(2);
            if (a64_bin_mode) {
                // getdirentries64 needs a 4th arg (basep) = NULL.
                enc_mov_wide(3, 0);
                enc_mov_wide(16, BSYS_MACOS_GETDENTS); enc_svc(0x80); enc_csneg(0, 0, 0, 3);
            } else { out("  mov x3, #0\n  mov x16, #344\n  svc #0x80\n  csneg x0, x0, x0, cc\n"); }
            return 0;
        }
        // Built-in: sys_lseek(fd, offset, whence) — reposition file offset.
        // macOS syscall 199. Returns new offset or -1 on error.
        if (cg_str_eq(n.a, "sys_lseek", 9)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 16)); a64_emit_push();
            call(pp.emit_node, *(arr + 8)); a64_emit_push();
            call(pp.emit_node, *(arr + 0));
            a64_emit_pop(1); a64_emit_pop(2);
            if (a64_bin_mode) { enc_mov_wide(16, BSYS_MACOS_LSEEK); enc_svc(0x80); enc_csneg(0, 0, 0, 3); }
            else { out("  mov x16, #199\n  svc #0x80\n  csneg x0, x0, x0, cc\n"); }
            return 0;
        }
        // sys_fchmod dispatch moved to cg_builtin_dispatch (Wave 18 batch 4).
        // sys_exit dispatch moved to cg_builtin_dispatch (Wave 18 batch 2).

        // fn_ptr dispatch moved to cg_builtin_dispatch (Wave 18 batch 5).

        // Built-in: call(fn_ptr, arg0, arg1, ...) — indirect function call.
        // First argument is the function address, remaining are passed to it.
        //
        // True AAPCS64: integer and float args occupy independent
        // register banks (x0..x7 and d0..d7), each with its own counter.
        // `(int, float, int)` lands at (x0, d0, x1) — float sits in
        // its own d-reg sequence regardless of the int args around it.
        //
        // First pass: emit each arg, capture its compile-time return
        // type (0 = int, 1 = float) into a per-arg buffer, push onto
        // its typed half of the stack (a64_emit_push for int / fpush
        // for float — both 16-byte slots). Second pass: pop in LIFO
        // order, routing each arg to its AAPCS64 register slot using
        // separate int_seq / flt_seq counters walked over the recorded
        // types.
        if (cg_str_eq(n.a, "call", 4)) {
            auto types_buf, t;
            arr = n.b; cnt = n.c;
            types_buf = buf_byte(cnt);
            i = 0;
            while (i < cnt) {
                t = call(pp.emit_node, *(arr + i * 8));
                poke(types_buf + i, t);
                if (t == 1) { a64_emit_fpush(); }
                else        { a64_emit_push();  }
                i++;
            }
            // Pop real args (indices 1..cnt-1). Each arg's destination
            // register slot is the count of same-type args preceding
            // it in [1, i) — see cg_count_tags in the spine.
            i = cnt - 1;
            while (i >= 1) {
                t = peek(types_buf + i);
                if (t == 1) { a64_emit_fpop(cg_count_tags(types_buf, 1, i, 1)); }
                else        { a64_emit_pop(cg_count_tags(types_buf, 1, i, 0));  }
                i--;
            }
            a64_emit_pop(9);
            free(types_buf);
            // Indirect call. Save d0/d1 for float_ret() / float_ret2().
            if (a64_bin_mode) {
                enc_blr(9);
                enc_str_d_uoff(0, 29, 24);
                enc_str_d_uoff(1, 29, 32);
            } else {
                out("  blr x9"); putchar('\n');
                out("  str d0, [x29, #24]"); putchar('\n');
                out("  str d1, [x29, #32]"); putchar('\n');
            }
            return 0;
        }

        // ── Phase B4: SIMD builtins (4-wide float32) ──
        // Each builtin lowers to NEON V-register ops. Binary ops route
        // through _a64_vec_binop with the encoder opcode + asm mnemonic;
        // the spill/reload dance for the left operand is shared. Result
        // lands in V0 for return; return type 2 signals SIMD, 1 signals
        // scalar float (used by vec_dot4 / vec_get4).
        if (cg_str_eq(n.a, "vec_load4", 9)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));
            if (a64_bin_mode) { enc_ldr_q_uoff(0, 0, 0); }
            else { out("  ldr q0, [x0]"); putchar('\n'); }
            return 2;
        }
        if (cg_str_eq(n.a, "vec_store4", 10)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 8));   // value → v0
            a64_emit_vpush();
            call(pp.emit_node, *(arr + 0));   // ptr → x0
            a64_emit_vpop(1);             // v1 = value
            if (a64_bin_mode) { enc_str_q_uoff(1, 0, 0); }
            else { out("  str q1, [x0]"); putchar('\n'); }
            return 0;
        }
        if (cg_str_eq(n.a, "vec_add4", 8)) { _a64_vec_binop(n, 0x4E20D400, "fadd"); return 2; }
        if (cg_str_eq(n.a, "vec_sub4", 8)) { _a64_vec_binop(n, 0x4EA0D400, "fsub"); return 2; }
        if (cg_str_eq(n.a, "vec_mul4", 8)) { _a64_vec_binop(n, 0x6E20DC00, "fmul"); return 2; }
        if (cg_str_eq(n.a, "vec_div4", 8)) { _a64_vec_binop(n, 0x6E20FC00, "fdiv"); return 2; }
        if (cg_str_eq(n.a, "vec_min4", 8)) { _a64_vec_binop(n, 0x4EA0F400, "fmin"); return 2; }
        if (cg_str_eq(n.a, "vec_max4", 8)) { _a64_vec_binop(n, 0x4E20F400, "fmax"); return 2; }
        if (cg_str_eq(n.a, "vec_splat4", 10)) {
            arr = n.b;
            ety = call(pp.emit_node, *(arr + 0));
            if (ety == 1) {
                // Float scalar in d0: convert double→single, broadcast from S0.
                if (a64_bin_mode) { enc_fcvt_s_d(0, 0); enc_dup_v_4s_from_s(0, 0); }
                else { out("  fcvt s0, d0"); putchar('\n'); out("  dup v0.4s, v0.s[0]"); putchar('\n'); }
            } else {
                // Integer in x0: broadcast W0 to all 4 lanes.
                if (a64_bin_mode) { enc_dup_v_4s(0, 0); }
                else { out("  dup v0.4s, w0"); putchar('\n'); }
            }
            return 2;
        }
        if (cg_str_eq(n.a, "vec_dot4", 8)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));
            if (a64_bin_mode) { enc_str_q_pre(0, 31, 0 - 16); }
            else { out("  str q0, [sp, #-16]!"); putchar('\n'); }
            call(pp.emit_node, *(arr + 8));
            // Horizontal sum via two FADDPs — matches LLVM's lowering of
            // `vaddvq_f32` and avoids the single-instruction FADDV path
            // whose encoding is easy to mis-assemble by hand.
            if (a64_bin_mode) {
                enc_ldr_q_post(1, 31, 16);
                enc_fmul_v_4s(0, 1, 0);
                enc_faddp_v_4s(0, 0, 0);
                enc_faddp_s(0, 0);
            } else {
                out("  ldr q1, [sp], #16"); putchar('\n');
                out("  fmul v0.4s, v1.4s, v0.4s"); putchar('\n');
                out("  faddp v0.4s, v0.4s, v0.4s"); putchar('\n');
                out("  faddp s0, v0.2s"); putchar('\n');
            }
            // Result is scalar float in s0; widen to d0 for the float convention.
            if (a64_bin_mode) { enc_fcvt_d_s(0, 0); }
            else { out("  fcvt d0, s0"); putchar('\n'); }
            return 1;
        }
        // vec_get4(v, lane) — extract one float32 lane as a scalar double.
        // Lane index must be a compile-time literal (0..3). Spills the
        // vector to the stack and loads the lane as a 32-bit float,
        // avoiding the need for a specialized scalar-DUP encoder.
        if (cg_str_eq(n.a, "vec_get4", 8)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));
            auto lane_nd: Node, lane_v;
            lane_nd = *(arr + 8);
            lane_v = cg_parse_int(lane_nd.a);
            if (a64_bin_mode) {
                enc_sub_imm(31, 31, 16);
                enc_str_q_uoff(0, 31, 0);
                enc_ldr_s_uoff(0, 31, lane_v * 4);
                enc_add_imm(31, 31, 16);
                enc_fcvt_d_s(0, 0);
            } else {
                out("  sub sp, sp, #16"); putchar('\n');
                out("  str q0, [sp]"); putchar('\n');
                out("  ldr s0, [sp, #"); a64_print_dec(lane_v * 4); out("]"); putchar('\n');
                out("  add sp, sp, #16"); putchar('\n');
                out("  fcvt d0, s0"); putchar('\n');
            }
            return 1;
        }

        // ── Byte-wide SIMD (16 × uint8) — group-scan kit for memchr,
        // string search and swiss-style hashing. vec_load16b / splat /
        // cmeq leave a vector in V0 (return 2, same as the 4×f32 ops);
        // vec_movemask collapses a lane vector to a plain 16-bit integer
        // bitmask in the accumulator (return 0).
        if (cg_str_eq(n.a, "vec_load16b", 11)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));   // byte pointer → x0
            if (a64_bin_mode) { enc_ldr_q_uoff(0, 0, 0); }
            else { out("  ldr q0, [x0]"); putchar('\n'); }
            return 2;
        }
        if (cg_str_eq(n.a, "vec_splat_byte", 14)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));   // byte value → x0 (low 8 bits used)
            if (a64_bin_mode) { enc_dup_v_16b(0, 0); }
            else { out("  dup v0.16b, w0"); putchar('\n'); }
            return 2;
        }
        if (cg_str_eq(n.a, "vec_cmeq_byte", 13)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 8));   // second operand → v0
            a64_emit_vpush();
            call(pp.emit_node, *(arr + 0));   // first operand → v0
            a64_emit_vpop(1);                 // v1 = second operand
            if (a64_bin_mode) { enc_cmeq_v_16b(0, 0, 1); }
            else { out("  cmeq v0.16b, v0.16b, v1.16b"); putchar('\n'); }
            return 2;
        }
        if (cg_str_eq(n.a, "vec_movemask", 12)) {
            arr = n.b;
            call(pp.emit_node, *(arr + 0));   // lane vector → v0
            // Reduce 16 high-bits (one per byte lane) to a 16-bit integer
            // mask, bit i set when lane i's high bit is set. SRA tree —
            // the constant-free NEON equivalent of x86 PMOVMSKB.
            if (a64_bin_mode) {
                enc_ushr_v_16b(0, 0, 7);
                enc_usra_v_8h(0, 0, 7);
                enc_usra_v_4s(0, 0, 14);
                enc_usra_v_2d(0, 0, 28);
                enc_umov_w_b(0, 0, 0);        // w0 = lanes 0..7
                enc_umov_w_b(1, 0, 8);        // w1 = lanes 8..15
                enc_orr_w_lsl(0, 0, 1, 8);    // x0 = w0 | (w1 << 8)
            } else {
                out("  ushr v0.16b, v0.16b, #7"); putchar('\n');
                out("  usra v0.8h, v0.8h, #7");   putchar('\n');
                out("  usra v0.4s, v0.4s, #14");  putchar('\n');
                out("  usra v0.2d, v0.2d, #28");  putchar('\n');
                out("  umov w0, v0.b[0]");        putchar('\n');
                out("  umov w1, v0.b[8]");        putchar('\n');
                out("  orr w0, w0, w1, lsl #8");  putchar('\n');
            }
            return 0;
        }

        // Regular B++ function call.
        // Query bpp_types.bsm for callee's parameter and return types.
        fidx_c = find_func_idx(n.a);
        // Inline splice (Phase B2 + S4 P3b unified). Single-T_RET
        // trivial bodies take the existing substitute-and-emit
        // fast path; multi-statement bodies dispatch to the shared
        // spine helper `cg_emit_inline_multi` (bpp_codegen.bsm), which
        // builds the binding prologue, emits the prelude statements with
        // alpha-renamed locals, and finally emits the return
        // expression. Both paths leave the call's value in acc
        // (or d0 for floats) just like a regular `bl callee`.
        if (fidx_c >= 0 && arr_get(fn_inlineable, fidx_c)) {
            auto inl_callee, inl_body, inl_bcnt, inl_ret: Node, inl_expr;
            auto inl_params, inl_pcnt, inl_cloned;
            inl_callee = funcs[fidx_c];
            inl_body = *(inl_callee + FN_BODY);
            inl_bcnt = *(inl_callee + FN_BCNT);
            // Only tier 1 (thin single-return) takes the fast substitute path.
            // Tier 2 (multi-use param) and tier 3 (hot-only, control-flow-
            // normalised) both re-evaluate side-effecting args under substitute,
            // so they fall to the binding splice below (gated on n.e > 0).
            if (inl_bcnt == 1 && arr_get(fn_inlineable, fidx_c) == 1) {
                inl_ret = inl_body[0];
                inl_expr = inl_ret.a;
                inl_params = *(inl_callee + FN_PARS);
                inl_pcnt = *(inl_callee + FN_PCNT);
                inl_cloned = ast_clone_subst(inl_expr, inl_params, inl_pcnt, n.b);
                // Record the inlined range for the .bug map (debugger PC attribution).
                auto _inl_s, _inl_ety;
                _inl_s = call(pp.cur_text_pos);
                _inl_ety = call(pp.emit_node, inl_cloned);
                _bug_inl_record(_inl_s, call(pp.cur_text_pos), fidx_c);
                return _inl_ety;
            }
            // body_cnt > 1: only inline if the pre_reg walker
            // stamped a callsite_id on this T_CALL. A 0 .e means
            // the call wasn't seen during pre_reg (synth call
            // emitted post-pre_reg, or a path the walker didn't
            // reach yet). Fall through to a normal call in that
            // case rather than risk emitting an unmangled body.
            if (n.e > 0) {
                return cg_emit_inline_multi(n, fidx_c);
            }
        } else if (fidx_c >= 0 && arr_get(fn_void_inlineable, fidx_c)) {
            // VI-2: void / statement-context callee — splice its statements in
            // place of the call with NO value (the call sits in statement
            // position). Reuses the multi-statement splicer, which detects the
            // void shape (last statement is not a T_RET) and emits every
            // statement. Requires the pre_reg walker's callsite_id; n.e == 0
            // means the call was not seen during pre_reg, so fall through to a
            // normal call rather than risk an unmangled body.
            if (n.e > 0) {
                return cg_emit_inline_multi(n, fidx_c);
            }
        }
        arr = n.b; cnt = n.c;
        // Typed push/pop — same pattern the call() builtin already uses
        // (a64_emit_call's "call" case above, mirrored on x64): record
        // each argument's FINAL type (post-conversion) into a small
        // types_buf, push through the type-matched stack primitive, then
        // pop in reverse order routing each one directly into its real
        // AAPCS64 bank slot via cg_count_tags — no bit-reinterpretation,
        // no separate rearrange pass. Looked up before the loop (was
        // after) since final_t needs it per-argument during evaluation.
        auto exi, types_buf, final_t;
        exi = cg_find_ext_by_argc(n.a, cnt);
        types_buf = buf_byte(cnt);
        i = 0;
        while (i < cnt) {
            ety = call(pp.emit_node, *(arr + i * 8));
            final_t = ety;
            if (fidx_c >= 0) {
                vi = is_float_type(get_fn_par_type(fidx_c, i));
                if (ety == 1) {
                    if (vi == 1) {
                        // float arg, float param: already the right type,
                        // no conversion needed.
                    } else {
                        if (a64_bin_mode) { enc_fcvtzs(0, 0); } else { out("  fcvtzs x0, d0"); putchar('\n'); }
                    }
                } else {
                    if (vi == 1) {
                        if (a64_bin_mode) { enc_scvtf(0, 0); } else { out("  scvtf d0, x0"); putchar('\n'); }
                    }
                }
                final_t = vi;
            }
            // FFI (exi >= 0) and truly-unknown targets both route by the
            // argument's own natural type (final_t already defaulted to
            // ety above) — no implicit numeric conversion for FFI
            // (existing contract), and deliberately NOT consulting the
            // extern's declared param type at all. cg_find_ext_by_argc
            // matches by name+argc only, which is genuinely ambiguous
            // when an FFI symbol has multiple same-arity overloads with
            // different float shapes (objc_msgSend is the real case: a
            // 6-arg all-double overload collides with a 6-arg
            // ptr/ptr/int/ptr/ptr/int one). Trusting the declared type
            // there silently misrouted a real pointer argument into a
            // float register — found via a Cocoa event-loop crash
            // (NSDate argument reinterpreted as a double). Every real
            // call site already passes explicitly-typed literals
            // matching the intended param (0.0, not 0, for a double
            // slot), so ety always already matches the TRUE intended
            // type — routing by it is strictly safer than trusting a
            // lookup that can pick the wrong overload.
            poke(types_buf + i, final_t);
            if (final_t == 1) { a64_emit_fpush(); } else { a64_emit_push(); }
            i++;
        }
        // Pop in reverse order, routing each argument directly into its
        // final ABI register — cg_count_tags counts same-type args
        // preceding position i, which IS that bank's sequence number.
        i = cnt - 1;
        while (i >= 0) {
            if (peek(types_buf + i) == 1) { a64_emit_fpop(cg_count_tags(types_buf, 0, i, 1)); }
            else                          { a64_emit_pop(cg_count_tags(types_buf, 0, i, 0));  }
            i--;
        }
        free(types_buf);

        if (a64_bin_mode) {
            fi = cg_find_fn(n.a);
            if (fi >= 0) {
                enc_bl_label(arr_get(a64_fn_lbl, fi));
            } else if (cg_find_ext(n.a) >= 0) {
                // External function: load address from GOT and call indirectly.
                // Save d0/d1 after the call for float_ret() / float_ret2().
                enc_add_reloc(enc_pos, n.a, 3);
                enc_adrp(16);
                enc_ldr_uoff(16, 16, 0);
                enc_blr(16);
                enc_str_d_uoff(0, 29, 24);
                enc_str_d_uoff(1, 29, 32);
            } else {
                // Cross-module B++ function: BL placeholder with type 4 relocation.
                enc_add_reloc(enc_pos, n.a, 4);
                enc_emit32(0x94000000);
            }
        } else {
            out("  bl _"); a64_print_p(n.a); putchar('\n');
            // Save float return registers after extern calls for float_ret() / float_ret2().
            if (exi >= 0) {
                out("  str d0, [x29, #24]"); putchar('\n');
                out("  str d1, [x29, #32]"); putchar('\n');
            }
        }
        // Check if callee returns float (B++ functions or FFI).
        if (fidx_c >= 0) {
            if (is_float_type(get_fn_ret_type(fidx_c))) { return 1; }
        }
        if (exi >= 0) {
            if (cg_ext_ret_is_float(exi)) { return 1; }
        }
        return 0;
}


// ── Statement emission ─────────────────────────────────────

void a64_emit_body(arr, cnt) {
    auto i;
    auto n: Node;
    i = 0;
    while (i < cnt) {
        n = *(arr + i * 8);
        if (n != 0) { cg_emit_stmt(n); }
        i++;
    }
}


// ── Function emission ──────────────────────────────────────

// a64_emit_func was deleted after Wave 19 batch 6 — the spine's
// cg_emit_func is now the sole entry point, wired straight into
// p.emit_func_full above.

// ── Wave 20 stage 3: T_MEMST per-path primitives ──
//
// Three sibling primitives cover the three shapes a `*(ptr) = val`
// store can take. The spine picks one based on the field-type hint
// stored in n.c (SIMD / scalar-float / int) and passes the T_MEMST
// node to the matching primitive, which runs the full eval-push-
// eval-pop-store sequence with the chip's register file.

// `: double` (SIMD, 128-bit). Evaluates value into v0, spills to
// the SIMD push slot, evaluates the pointer into x0, reloads into
// v1, stores 16 bytes.
void _a64_emit_memst_float_simd(nd) {
    auto n: Node, ety, fh, coff, cbase;
    auto pp: ChipPrimitives;
    pp = cg_prim;
    n = nd;
    fh = n.c;
    ety = call(pp.emit_node, n.b);
    if (ety != 2) {
        diag_error(231);
        diag_str("cannot store non-SIMD value through a ': double' field");
        diag_newline();
    }
    a64_emit_vpush();
    cg_emit_addr(n.a, fh);
    a64_emit_vpop(1);
    coff = cg_addr_const_off; cbase = cg_addr_const_base;
    if (cbase < 0) { cbase = 0; }
    if (a64_bin_mode) { enc_str_q_uoff(1, cbase, coff); }
    else { out("  str q1, [x"); a64_print_dec(cbase); out(", #"); a64_print_dec(coff); out("]"); putchar('\n'); }
    cg_addr_const_off = 0; cg_addr_const_base = -1;
}

// `: half` / `: quarter` / `: full` scalar float. Coerces int→double
// first if the RHS came back as int. Pushes the scalar via the FP
// stack, evaluates pointer, pops into d1, narrows per slice width,
// and stores the narrowed half/single/double at [x0].
void _a64_emit_memst_float_scalar(nd, fh_sl) {
    auto n: Node, ety, fh, coff, cbase;
    auto pp: ChipPrimitives;
    pp = cg_prim;
    n = nd;
    fh = n.c;
    ety = call(pp.emit_node, n.b);
    if (ety == 0) {
        if (a64_bin_mode) { enc_scvtf(0, 0); }
        else { out("  scvtf d0, x0"); putchar('\n'); }
    }
    a64_emit_fpush();
    cg_emit_addr(n.a, fh);
    a64_emit_fpop(1);
    coff = cg_addr_const_off; cbase = cg_addr_const_base;
    if (cbase < 0) { cbase = 0; }
    if (fh_sl == SL_HALF) {
        if (a64_bin_mode) { enc_fcvt_s_d(1, 1); enc_str_s_uoff(1, cbase, coff); }
        else {
            out("  fcvt s1, d1"); putchar('\n');
            out("  str s1, [x"); a64_print_dec(cbase); out(", #"); a64_print_dec(coff); out("]"); putchar('\n');
        }
    }
    if (fh_sl == SL_QUARTER) {
        if (a64_bin_mode) { enc_fcvt_h_d(1, 1); enc_str_h_uoff(1, cbase, coff); }
        else {
            out("  fcvt h1, d1"); putchar('\n');
            out("  str h1, [x"); a64_print_dec(cbase); out(", #"); a64_print_dec(coff); out("]"); putchar('\n');
        }
    }
    if (fh_sl == SL_FULL) {
        if (a64_bin_mode) { enc_str_d_uoff(1, cbase, coff); }
        else { out("  str d1, [x"); a64_print_dec(cbase); out(", #"); a64_print_dec(coff); out("]"); putchar('\n'); }
    }
    cg_addr_const_off = 0; cg_addr_const_base = -1;
}

// Integer stores. Evaluates the value, coerces float-to-int if
// needed, then saves the value — in a freelist register when the
// pointer expression is call-free, or on the stack otherwise.
// Evaluates the pointer, retrieves the value, and hands both to the
// chip's emit_memst_store primitive which owns the sub-word dispatch.
void _a64_emit_memst_int(nd, fh) {
    auto n: Node, ety, alloc_reg_st, val_reg;
    auto pp: ChipPrimitives;
    pp = cg_prim;
    n = nd;
    alloc_reg_st = -1;
    val_reg = 1;
    ety = call(pp.emit_node, n.b);
    if (ety == 1) {
        // Float RHS going into integer destination: convert with
        // fcvtzs (truncate toward zero), do NOT bitcast with fmov.
        // The bitcast path silently corrupted every
        // `int_slot = float_expr` store — `*(buf) = 0.5 * 1000` would
        // write the IEEE bits of 500.0 (0x407F400000000000) instead
        // of the integer 500. Surfaced 2026-05-23 as snake particles
        // teleporting outside the framebuffer (load/import P6 made
        // ecs_physics inline through this primitive; pre-P6 the call
        // frame around ecs_physics masked it).
        // Test: tests/test_memst_float_to_int.bpp
        if (a64_bin_mode) { enc_fcvtzs(0, 0); }
        else { out("  fcvtzs x0, d0"); putchar('\n'); }
    }
    if (cg_has_call(n.a)) {
        a64_emit_push();
    } else {
        alloc_reg_st = a64_gp_alloc();
        if (alloc_reg_st >= 0) {
            if (a64_bin_mode) { enc_mov_reg(alloc_reg_st, 0); }
            else { out("  mov x"); a64_print_dec(alloc_reg_st); out(", x0"); putchar('\n'); }
        } else {
            a64_emit_push();
        }
    }
    cg_emit_addr(n.a, fh);
    if (alloc_reg_st >= 0) {
        val_reg = alloc_reg_st;
        a64_gp_free(alloc_reg_st);
    } else {
        a64_emit_pop(1);
    }
    call(pp.emit_memst_store, fh, val_reg);
    cg_addr_const_off = 0; cg_addr_const_base = -1;
}

// ── Per-module emission (for incremental compilation) ──────

// Initialize the encoder and global tables for per-module codegen.
// Call once before the per-module loop. Populates globals and externs
// from the parser so that all modules share the same data tables.
void a64_mod_init() {
    auto i, rec, name_p, idx, j;
    cg_sbuf = vbuf;

    // Reset encoder state for a fresh build.
    enc_pos = 0;
    enc_lbl_max = 0;
    arr_clear(enc_lbl_off);
    enc_fix_cnt = 0;
    arr_clear(enc_fix_pos); arr_clear(enc_fix_lbl); arr_clear(enc_fix_ty);
    arr_clear(enc_rel_pos); arr_clear(enc_rel_sym); arr_clear(enc_rel_ty);

    // Clear function tables (will be populated per-module).
    arr_clear(cg_fn_name); arr_clear(cg_fn_par); arr_clear(cg_fn_pcnt);
    arr_clear(cg_fn_body); arr_clear(cg_fn_bcnt); arr_clear(cg_fn_fidx);
    arr_clear(a64_fn_lbl);

    // Copy ALL globals with deduplication (shared across all modules).
    arr_clear(cg_gl_name);
    i = 0;
    while (i < glob_cnt) {
        name_p = *(globals + i * 8);
        idx = -1;
        j = 0;
        while (j < arr_len(cg_gl_name)) {
            if (cg_str_eq_packed(name_p, arr_get(cg_gl_name, j))) { idx = j; }
            j++;
        }
        if (idx < 0) { cg_gl_name = arr_push(cg_gl_name, name_p); }
        i++;
    }
    // Hidden runtime globals (_bpp_argc/argv/envp) come in via brt0.bsm
    // as regular entries in globals[], so the loop above already includes them.

    // Externs are refreshed per-module in emit_module_arm64() instead of here,
    // because in the incremental pipeline modules are parsed one at a time.
    arr_clear(cg_ex_name); arr_clear(cg_ex_ret);
    arr_clear(cg_ex_args); arr_clear(cg_ex_acnt);

}

// Emit code for a single module. Functions accumulate in cg_fn_name
// across calls. Cross-module calls emit type 4 relocations.
// Returns the byte offset where this module's code starts in enc_buf.
void emit_module_arm64(mi) {
    auto fn_start, code_start, i, rec, name_p, idx, j;

    // Phase 3.4: re-install this chip's primitives so emission
    // dispatches through the correct fn_ptrs even when both
    // chips' init_codegen_<chip> ran at startup.
    cg_install_arm64_primitives();

    // Record where new functions will start in the accumulated table.
    fn_start = arr_len(cg_fn_name);

    // Add functions from this module only, with forward-declaration override.
    // Lazy emit: skip unreachable functions when the pass has run.
    i = 0;
    while (i < func_cnt) {
        if (_lazy_emit_ready) {
            if (arr_get(fn_reachable, i) == 0) { i++; continue; }
        }
        if (arr_get(func_mods, i) == mi) {
            rec = *(funcs + i * 8);
            name_p = *(rec + FN_NAME);
            idx = -1;
            j = 0;
            while (j < arr_len(cg_fn_name)) {
                if (cg_str_eq_packed(name_p, arr_get(cg_fn_name, j))) { idx = j; }
                j++;
            }
            if (idx < 0) {
                idx = arr_len(cg_fn_name);
                cg_fn_name = arr_push(cg_fn_name, name_p);
                cg_fn_par  = arr_push(cg_fn_par,  *(rec + FN_PARS));
                cg_fn_pcnt = arr_push(cg_fn_pcnt, *(rec + FN_PCNT));
                cg_fn_body = arr_push(cg_fn_body, *(rec + FN_BODY));
                cg_fn_bcnt = arr_push(cg_fn_bcnt, *(rec + FN_BCNT));
                cg_fn_fidx = arr_push(cg_fn_fidx, i);
            } else {
                arr_set(cg_fn_name, idx, name_p);
                arr_set(cg_fn_par,  idx, *(rec + FN_PARS));
                arr_set(cg_fn_pcnt, idx, *(rec + FN_PCNT));
                arr_set(cg_fn_body, idx, *(rec + FN_BODY));
                arr_set(cg_fn_bcnt, idx, *(rec + FN_BCNT));
                arr_set(cg_fn_fidx, idx, i);
            }
        }
        i++;
    }

    // Assign labels for new functions only.
    i = fn_start;
    while (i < arr_len(cg_fn_name)) {
        a64_fn_lbl = arr_push(a64_fn_lbl, enc_new_label());
        i++;
    }

    // Refresh externs from parser state (may have grown from previous modules).
    arr_clear(cg_ex_name); arr_clear(cg_ex_ret);
    arr_clear(cg_ex_args); arr_clear(cg_ex_acnt);
    i = 0;
    while (i < ext_cnt) {
        rec = *(externs + i * 8);
        cg_ex_name = arr_push(cg_ex_name, *(rec + EX_NAME));
        cg_ex_ret  = arr_push(cg_ex_ret,  *(rec + EX_RET));
        cg_ex_args = arr_push(cg_ex_args, *(rec + EX_ARGS));
        cg_ex_acnt = arr_push(cg_ex_acnt, *(rec + EX_ACNT));
        i++;
    }

    // Clear per-module fixups. Labels and relocations accumulate.
    enc_fix_cnt = 0;
    arr_clear(enc_fix_pos); arr_clear(enc_fix_lbl); arr_clear(enc_fix_ty);

    // Record code start and emit new functions only.
    code_start = enc_pos;
    i = fn_start;
    while (i < arr_len(cg_fn_name)) {
        cg_emit_func(i);
        i++;
    }

    // Resolve internal branch fixups for this module.
    enc_resolve_fixups();

    return code_start;
}

// ── Top-level emission ─────────────────────────────────────

// Run all ARM64 emission stages in order.
void emit_all_arm64() {
    auto i, sp, ss, sl, j, ch, fp, fs, fl;

    cg_bridge_data();

    if (a64_bin_mode) {
        // Hidden runtime globals come in via brt0.bsm (auto-injected).

        // Binary mode: allocate a label for each function, emit code, resolve fixups.
        enc_pos = 0;
        enc_lbl_max = 0;
        arr_clear(enc_lbl_off);
        enc_fix_cnt = 0;
        arr_clear(enc_fix_pos); arr_clear(enc_fix_lbl); arr_clear(enc_fix_ty);
        arr_clear(enc_rel_pos); arr_clear(enc_rel_sym); arr_clear(enc_rel_ty);

        // Allocate a label for each function.
        arr_clear(a64_fn_lbl);
        i = 0;
        while (i < arr_len(cg_fn_name)) {
            a64_fn_lbl = arr_push(a64_fn_lbl, enc_new_label());
            i++;
        }

        // Emit all functions into the code buffer.
        i = 0;
        while (i < arr_len(cg_fn_name)) { cg_emit_func(i); i++; }

        // Resolve all forward branch fixups.
        enc_resolve_fixups();

        // Code is now in enc_buf[0..enc_pos). The caller decides whether
        // to write it to stdout or pass it to the Mach-O writer.
    } else {
        // Text assembly mode.
        out(".section __TEXT,__text,regular,pure_instructions"); putchar('\n');
        putchar('\n');

        // Emit all functions.
        i = 0;
        while (i < arr_len(cg_fn_name)) { cg_emit_func(i); i++; }

        // Emit global variables in data section.
        out(".section __DATA,__data"); putchar('\n');
        // Hidden globals for argc/argv/envp access.
        out(".p2align 3"); putchar('\n');
        out("_bpp_argc: .quad 0"); putchar('\n');
        out("_bpp_argv: .quad 0"); putchar('\n');
        out("_bpp_envp: .quad 0"); putchar('\n');
        i = 0;
        while (i < arr_len(cg_gl_name)) {
            out(".globl _"); a64_print_p(arr_get(cg_gl_name, i)); putchar('\n');
            out(".p2align 3"); putchar('\n');
            out("_"); a64_print_p(arr_get(cg_gl_name, i)); out(":"); putchar('\n');
            out("  .quad 0"); putchar('\n');
            i++;
        }
        putchar('\n');

        // Emit string literals in a read-only data section.
        if (arr_len(cg_str_tbl) > 0) {
            out(".section __TEXT,__cstring,cstring_literals"); putchar('\n');
            i = 0;
            while (i < arr_len(cg_str_tbl)) {
                sp = arr_get(cg_str_tbl, i);
                ss = unpack_s(sp); sl = unpack_l(sp);
                out("_str_"); a64_print_dec(i); out(":"); putchar('\n');
                out("  .asciz "); putchar('"');
                j = 0;
                while (j < sl) {
                    ch = peek(cg_sbuf + ss + j);
                    if (ch == '\n') { putchar('\\'); putchar('n'); }
                    else { if (ch == '"') { putchar('\\'); putchar('"'); }
                    else { if (ch == '\\') { putchar('\\'); putchar('\\'); }
                    else { putchar(ch); } } }
                    j++;
                }
                putchar('"'); putchar('\n');
                i++;
            }
            putchar('\n');
        }

        // Emit float literal constants in a read-only data section.
        if (arr_len(cg_flt_tbl) > 0) {
            out(".section __DATA,__const"); putchar('\n');
            i = 0;
            while (i < arr_len(cg_flt_tbl)) {
                fp = arr_get(cg_flt_tbl, i);
                fs = unpack_s(fp); fl = unpack_l(fp);
                out(".p2align 3"); putchar('\n');
                out("_flt_"); a64_print_dec(i); out(":"); putchar('\n');
                out("  .double ");
                j = 0;
                while (j < fl) { putchar(peek(cg_sbuf + fs + j)); j++; }
                putchar('\n');
                i++;
            }
            putchar('\n');
        }
    }

}
