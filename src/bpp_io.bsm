// bpp_io.bsm — Standard B I/O library.
// Built on syscall primitives (sys_write, sys_read). Self-contained —
// no external dependencies, I/O is fundamental to B++.

// Write a single byte to stdout via sys_write.
// The local `buf` holds the byte in its low 8 bits; `&buf` gives the
// stack address passed to the kernel. Little-endian layout on both
// ARM64 and x86_64 means the LSB is at the lowest address.
void putchar(ch) {
    auto buf;
    buf = ch & 0xFF;
    sys_write(1, &buf, 1);
}

// Write a single byte to stderr. Same pattern as putchar but fd=2.
void putchar_err(ch) {
    auto buf;
    buf = ch & 0xFF;
    sys_write(2, &buf, 1);
}

// The sentinel getchar returns at end-of-input (and on read error). It
// is -1 — a full machine word (0xFFFF...FF) that can never collide with a
// real byte, because getchar masks success values to 0..255. Compare
// against EOF, not a bare -1, so input loops read as intent:
//     c = getchar(); while (c != EOF) { ...; c = getchar(); }
// Keep the byte in a plain `auto` (a signed word). Annotating it `: byte`
// (255 != -1, the loop never ends) or `: u_word` (-1 becomes a huge
// unsigned value and the ordering tests flip) silently breaks the check.
const EOF = -1;

// Read a single byte from stdin. Returns the byte value (0..255) or
// EOF (-1) at end-of-input / on error.
getchar() {
    auto buf;
    buf = 0;
    if (sys_read(0, &buf, 1) > 0) { return buf & 0xFF; }
    return EOF;
}

// Print a null-terminated string to stdout WITHOUT a trailing newline.
// Use when composing output inline (labels + values on the same line).
// For output with newline, use putmsg.
void putstr(s) {
    sys_write(1, s, str_len(s));
}

// Rule 3: side-effect only → void. Recursive, no return needed.
// Print the sign, then the magnitude as an UNSIGNED value. Computing the
// magnitude in a `: u_word` local is what makes INT64_MIN print correctly:
// `0 - INT64_MIN` overflows back to itself as a signed word, but the same
// bit-pattern read as u_word is exactly 2^63 — the true magnitude. The
// `m >= 10`, `m / 10`, `m % 10` steps then run unsigned (the u_word
// ordering-comparison and division paths), so the recursion handles 2^63
// instead of printing the old "-(" garbage.
void putnum(n) {
    auto m: u_word;
    if (n < 0) {
        putchar('-');
        m = 0 - n;
    } else {
        m = n;
    }
    if (m >= 10) {
        putnum(m / 10);
    }
    putchar('0' + (m % 10));
}

// Rule 3: side-effect only → void.
void putline() {
    putchar('\n');
}

// Rule 3: side-effect only → void.
void putmsg(s) {
    putstr(s);
    putchar('\n');
}

// -- stderr mirrors ----------------------------------------------
// Same shape as putnum / putline / putmsg above, but every
// byte goes to fd 2. Debug traces and diagnostics that must stand
// apart from program output use these. The naming mirrors the
// stdout helpers so swapping stdout for stderr in an existing call
// site is a single letter (`putnum` -> `putnum_err`).

// stderr mirror of putnum — same INT64_MIN-safe unsigned magnitude.
void putnum_err(n) {
    auto m: u_word;
    if (n < 0) {
        putchar_err('-');
        m = 0 - n;
    } else {
        m = n;
    }
    if (m >= 10) {
        putnum_err(m / 10);
    }
    putchar_err('0' + (m % 10));
}

void putline_err() {
    putchar_err('\n');
}

void putstr_err(s) {
    sys_write(2, s, str_len(s));
}

// Print a pointer value in `0x<hex>` form to stderr. Useful for the
// "what address did the compiler pick for this string?" moments that
// show up during codegen investigations.
void puthex_err(n) {
    auto i, d;
    putchar_err('0'); putchar_err('x');
    for (i = 60; i >= 0; i -= 4) {
        d = (n >> i) & 0xF;
        if (d < 10) { putchar_err('0' + d); }
        else        { putchar_err('a' + d - 10); }
    }
}

// Print a float to stdout in decimal form (4 decimal places).
// int_p/dig/i are word, frac is float — declared separately to avoid E232.
void putfloat(f: float) {
    auto (int_p, dig, i): word;
    auto frac: float;
    if (f < 0.0) { putchar('-'); f = 0.0 - f; }
    int_p = f;
    putnum(int_p);
    putchar('.');
    frac = f - int_p;
    for (i = 0; i < 4; i++) {
        frac *= 10.0;
        dig = frac;
        putchar('0' + dig);
        frac -= dig;
    }
}

void putfloat_err(f: float) {
    auto (int_p, dig, i): word;
    auto frac: float;
    if (f < 0.0) { putchar_err('-'); f = 0.0 - f; }
    int_p = f;
    putnum_err(int_p);
    putchar_err('.');
    frac = f - int_p;
    for (i = 0; i < 4; i++) {
        frac *= 10.0;
        dig = frac;
        putchar_err('0' + dig);
        frac -= dig;
    }
}

// Smart dispatch: the compiler rewrites put(x) → putstr/putnum/putfloat
// based on the inferred type of x. These stubs are the validator's anchor
// and the fallback for TY_UNK arguments (treated as integer).
//
// Variadic: `put(a, b, c, ...)` with two or more arguments is expanded by the
// parser into one single-arg put per argument, in order, each independently
// type-dispatched — so `put("count: ", n, "\n")` prints the label, the number,
// then the newline. No format string, no separator, no auto-newline. The
// per-arg W032 ambiguity warning is suppressed for these (a value in a put-list
// is unambiguously meant to print); single-arg `put(word)` still warns. See
// `_expand_put_variadic` in bpp_parser.bsm. `put_err` is the stderr mirror.
void put(x) { putnum(x); }
void put_err(x) { putnum_err(x); }

// Look up an environment variable by name and return a pointer to its value.
// Rule 4: reads only, no global writes. But calls envp_get (builtin) and
// peek (builtin) — these are pure reads. The function itself is pure.
// Calls builtins (envp_get, str_peek, peek) — classifier treats as impure.
// No : base annotation. Pure in practice but can't be proven by the analyzer.
getenv(name) {
    auto i, j, ep, ch_e, ch_n, matched;
    i = 0;
    while (1) {
        ep = envp_get(i);
        if (ep == 0) { return 0; }
        j = 0;
        matched = 1;
        while (matched) {
            ch_n = str_peek(name, j);
            if (ch_n == 0) {
                if (peek(ep + j) == '=') { return ep + j + 1; }
                matched = 0;
            } else {
                ch_e = peek(ep + j) & 0xFF;
                if (ch_e != ch_n) { matched = 0; }
                j++;
            }
        }
        i++;
    }
    return 0;
}
