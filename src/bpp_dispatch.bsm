// bpp_dispatch.bsm — Dispatch analysis engine for the unified B++ compiler.

import "bpp_defs.bsm";
import "bpp_array.bsm";
import "bpp_arr.bsm";
//
// Dispatch codes:
//   DSP_SEQ   = 0   Sequential execution (side effects, dependencies)
//   DSP_PAR   = 1   CPU parallel (independent iterations, no side effects)
//   DSP_GPU   = 2   GPU candidate (strided memory, no side effects)
//   DSP_SPLIT = 3   Split candidate (mix of pure and impure)

// ── Dispatch result codes ──────────────────────────────────
const DSP_SEQ = 0; const DSP_PAR = 1; const DSP_GPU = 2; const DSP_SPLIT = 3;

// ── Per-function purity classification ─────────────────────
//
// Three values describe a function's classification at runtime:
//   PHASE_AUTO  (0)  Not yet classified (default before pass runs)
//   PHASE_BASE  (1)  Pure — no global writes, no impure calls.
//                    Safe to dispatch to a worker thread.
//   PHASE_SOLO  (2)  Has side effects (direct or transitive). Must
//                    run on the main thread.
//
// The classification is computed by classify_all_functions() via
// double-buffered fixpoint iteration over the call graph built by
// call_graph_build(). Lattice has height 1 (BASE → SOLO is the only
// transition, no upgrade), so fixpoint converges to the EXACT result
// in O(call-chain-depth) passes — not approximate.
const PHASE_AUTO = 0; const PHASE_BASE = 1; const PHASE_SOLO = 2;
const PHASE_REALTIME = 3; const PHASE_IO = 4; const PHASE_GPU = 5;
const PHASE_HEAP = 6; const PHASE_PANIC = 7;
// PHASE_SAFE (8): the canonical user-facing safety annotation as of
// the 2026-05-11 collapse. Semantically identical to PHASE_REALTIME
// (rejects malloc / IO / GPU / SOLO through transitive call graph)
// but named for the broader use case: audio callbacks, worker entry
// points, and any bounded path that must stay bounded. The enforcement
// path treats SAFE and REALTIME identically; SAFE is the new name.
// `@safe` is the ONLY annotation the parser still accepts and it lands
// at PHASE_REALTIME here; the legacy spellings (`@time` included) have
// been E260-rejected since the 2026-05-11 phase collapse — no migration
// window remains.
const PHASE_SAFE = 8;

// Per-function arrays parallel to funcs[]. Built by call_graph_build()
// and consumed by classify_all_functions() and (later) codegen.
static auto fn_phase;            // arr<int>: PHASE_* per function (read by codegen)
static auto fn_phase_next;       // arr<int>: double-buffer for fixpoint iteration
static auto fn_calls;            // arr<arr<int>>: direct callees per function
static auto fn_address_taken;    // arr<int>: 1 if fn_ptr(name) appears anywhere
static auto fn_locally_impure;   // arr<int>: 1 if body has non-call side effects
extrn fn_reachable;        // arr<int>: 1 if reachable from main() via call graph
global fn_phase_hint;       // arr<int>: 0=auto, 1=base, 2=solo, 3=realtime, 4=io, 5=gpu (from annotation)
global fn_ret_hint;         // arr<int>: TY_* code per function from explicit `: type` annotation between `)` and `{`. 0 = no hint, type checker infers.
global fn_ret_arity;        // arr<int>: number of return values per function (1 normally; >1 for multi-value-return `-> (t1, t2, …)`).
global fn_ret_types;        // arr<ptr>: per function, a small arr<TY_*> of the declared multi-return slot types (0 when single-value). Drives int/float banking.
// Per-function location table for the bug debugger. Entry `i` is a
// pointer to a buf_byte block of `fn_vt_cnts[i] * 8` bytes, with
// each 8-byte slot holding `kind` (1 byte) + `detail` (4 bytes LE)
// for one variable. Kind 0 = "value lives in GDB register `detail`"
// (the codegen promoted this local into a callee-saved register).
// Kind 1 = "value lives at fp + detail" (a real stack slot). Without
// this, the bug reads stack for every local — only correct for the
// minority that did not get promoted. The codegen populates the
// block at the end of emit_func, after the b3 register-allocation
// pass has settled cg_var_promote.
global fn_vt_locs;
static auto fn_effect;           // arr<int>: PHASE_* per function — finest-grained classification (Level 4 sub-step B)
static auto fn_effect_next;      // arr<int>: double-buffer for the effect fixpoint pass

// Per-function fn_ptr origin tracking (V3 Session 2). Parallel arrays
// keyed by packed local-name; resolved target function index (-1 =
// poison: a non-fn_ptr value overwrote a prior origin). Last-write in
// TEXTUAL source order wins — `_cgb_walk` is linear, so branchy
// assignments resolve to "last position in the source" rather than last
// in execution order. Acceptable v1 trade-off; fixed-point refinement
// is future work.
static auto _fn_origin_names;    // arr<arr<packed>>: per-fi list of var names
static auto _fn_origin_targets;  // arr<arr<int>>:    per-fi parallel list of target fidx

// Registration helper detection (V3 Session 4 Pass A). A function fi
// is a "registration helper" when one of its params flows directly
// into a global via `_global = param;`. Per-fi parallel arrays:
//   _fn_reg_param[fi][k]  = parameter index that flows
//   _fn_reg_global[fi][k] = packed name of the destination global
// The maestro_register_solo(name, cb) pattern is the canonical case.
static auto _fn_reg_param;       // arr<arr<int>>:    per-fi list of param indices
static auto _fn_reg_global;      // arr<arr<packed>>: per-fi parallel list of globals

// Inverse call graph (V3 Session 4 Pass B). Built by `_dsp_build_callers`
// from `fn_calls[]` AFTER Pass A finishes. `_fn_callers[fi]` is the
// list of function indices that call fi directly. Used to walk caller
// sites of registration helpers without requiring callers to register
// themselves explicitly during Pass A.
static auto _fn_callers;         // arr<arr<int>>: callers per callee

// S4 hotness propagation (Inc 8, docs/plans/inliner_arc.md). The
// existing S4 threshold heuristics (_inline_caller_fanout, the call
// site's own `n.d` loop depth) are both SHALLOW — one hop. They miss
// exactly the shape a real-time DSP chain has: `sf_render`'s per-sample
// loop calls `sf_channel_process`, which calls `zener_process`, which
// calls `comp_process`, which calls `db_to_amp_f`, which calls `exp_f`
// — the loop is 5 calls away from `exp_f`, so neither shallow signal
// ever sees it. `fn_max_call_loop_depth[fi]` is the max `n.d` (T_CALL's
// own parser-stamped loop-depth field, S4 P0a) among every DIRECT call
// site anywhere in the program that calls fi — built for free inside
// `_cgb_walk`'s existing T_CALL discovery (same node, same pass, no new
// walk). `fn_hot_transitive[fi]` is the propagated result: 1 if fi is
// called directly from inside a loop, OR fi is called by some function
// that is itself hot — computed via a fixpoint over `_fn_callers`
// (capped passes, same shape as classify_inlineable's own fixpoint).
static auto fn_max_call_loop_depth;  // arr<int>: max loop depth among direct call sites
static auto fn_hot_transitive;       // arr<int>: 1 if hot, directly or transitively

// Per-global registered origins (V3 Session 4 Pass B). Captures every
// `fn_ptr(name)` literal that any caller passes to a registration
// helper at the corresponding param_idx. `_glob_origin_names` is a
// flat list of globals that have at least one entry; `_glob_origin_targets`
// is the parallel list of target_fidx arrays.
static auto _glob_origin_names;   // arr<packed>:    globals with recorded origins
static auto _glob_origin_targets; // arr<arr<int>>:  parallel, target_fidx lists
extrn fn_inlineable;       // arr<int>: inline tier for each function —
                          //   0 = not inlineable
                          //   1 = thin single-return: fast substitute path, EVERY call site
                          //   2 = single-return, multi-use param: binding splice, EVERY call site
                          //   3 = HOT-ONLY (bigger / control-flow-normalised body): binding
                          //       splice, but only at IN-LOOP call sites so a widely-used
                          //       accessor (arr_struct_at) does not bloat cold sites. Inc 3.
                          //   4 = OVERSIZED, COST-GATED (Inc 8, S4 wiring): body exceeds the
                          //       free node cap (INLINE_BODY_NODE_CAP/_MULTIRET) but is under
                          //       the absolute backstop and otherwise shape-eligible. Binding
                          //       splice, but only when _inline_pre_reg_walk's per-callsite
                          //       _inline_cost <= _inline_threshold check clears — a function
                          //       like exp_f (bpp_math.bsm, cost 78) splices at a call site
                          //       proven hot via fn_hot_transitive (a real-time DSP chain
                          //       several calls deep) and falls through to a real `bl` at a
                          //       cold one, same call site, same function, different outcome.
                          // Tiers 2 + 3 + 4 all route through cg_emit_inline_multi gated on the
                          // pre-reg-stamped callsite id (n.e > 0); the difference is which
                          // call sites the pre-reg walk registers at all (tier 3: only in-loop;
                          // tier 4: only cost-cleared; both fall through to a real `bl` at any
                          // call site they don't register). The chips' fast-path gate is
                          // therefore `fn_inlineable == 1` (tiers 2/3/4 all fall to binding).
// Loop-nesting depth tracked by the inline pre-reg walk so the hotness gate can
// tell an in-loop (hot) call site from a cold one. Spine-owned, reset per
// function in _inline_pre_reg_walk_body; both backends drive the same walk, so
// the hotness gate is backend-agnostic (no per-chip state). Mirrors the
// cg_b3_loop_depth pattern used by B3 loop-weighted promotion.
global cg_inline_loop_depth;
extrn fn_void_inlineable;  // arr<int>: 1 if a void / statement-context callee is
                          // splice-eligible. VI-1 populates this; NOTHING reads it
                          // yet (the walker + a64 splice start consuming it in VI-2).
                          // Kept separate from fn_inlineable so the pre-reg walker
                          // (which stamps every fn_inlineable callsite into the var
                          // table) does not pollute frames before the void splice
                          // exists. See docs/plans/legacy/sidequest_void_inline.md.
extrn _lazy_emit_ready;    // 1 after mark_reachable has populated fn_reachable.
                          // Codegen checks this before filtering — if 0, emit everything.
extrn cg_cur_fn_idx;       // funcs[] index of the function pre_reg_vars is currently
                          // walking — Inc 8's tier-4 cost-vs-threshold check in
                          // _inline_pre_reg_walk reads this as the call site's caller_idx.

// ── Per-global use-def tracking (smart promotion) ──────────
// Built by call_graph_build() during the same AST walk that populates
// the per-function arrays above. Each parallel to globals[].
//
// glob_writers[i]   — arr<int> of function indices that assign to global i
// glob_readers[i]   — arr<int> of function indices that read global i
// glob_writes_pre[i]  — count of writes to global i in main() BEFORE
//                       the first call to maestro_run/job_init/maestro_configure
// glob_writes_post[i] — count of writes to global i in main() AFTER the freeze
static auto glob_writers;
static auto glob_readers;
static auto glob_writes_pre;
static auto glob_writes_post;

// --fma enables FMA3 fused multiply-add on x86_64 (x86-64-v3 / Haswell+). Off by
// default because FMA3 is not baseline SSE2 (SIGILLs on pre-2013 CPUs). a64 has
// fmadd unconditionally, so this flag only affects x64 — turning it on makes the
// two backends agree bit-for-bit on FMA'd kernels (both round once).
global flag_fma;

// Index of the main() function in funcs[], or -1 if not found.
// Resolved by call_graph_build for use by promote_globals.
static auto _dsp_main_idx;

// 1 if _dsp_walk_main_for_freeze found at least one freeze-point call
// (maestro_run / maestro_configure / job_init). If 0, no freeze point
// exists and no globals are promoted to extrn — programs without a
// maestro/job lifecycle don't benefit from the write-once distinction.
static auto _dsp_has_freeze;

// Promoter output: per-global string ("extrn" / "global" / "" if no change).
// Read by --show-promotions to print human-readable diagnostics.
static auto glob_promote_reason;

// Extern purity table: packed names of known-pure extern functions.
// Any extern not in this table is assumed to have side effects.
static auto pure_ext;

// `@safe`-suggestion sinks (Task 4 of phase annotation collapse arc).
// Builtins whose fn_ptr argument MUST be annotated `@safe` for the
// compiler to verify the safety contract. When `_cgb_walk` sees a
// T_CALL to one of these names with a `fn_ptr(target)` literal in
// the args, it looks up `fn_phase_hint[target]` and emits W031 if
// the target is not `@safe`. Killer use cases: worker-thread dispatch
// (`job_submit`, `job_parallel_for`) where the fn argument runs in
// a worker pool with bounded-time / no-malloc expectations.
//
// `maestro_register_*` are NOT on this list. They register main-thread
// phase callbacks (base / solo / render) that maestro_run() calls
// directly via `call(_ms_cb_*, ...)` inside the main loop, not from a
// worker. Phase callbacks routinely orchestrate workers via job_submit
// (which can block on sys_usleep when a queue is full); marking them
// `@safe` would trigger W026 by construction. The bounded-worker
// contract belongs on the fn passed to job_submit, not on the
// dispatcher that issued the submit.
static auto _safe_sinks;

// Extern effect table for Level 4 sub-step B. Parallel arrays mapping
// each known builtin name to a finer-grained effect code (PHASE_BASE,
// PHASE_IO, PHASE_GPU, PHASE_REALTIME, or PHASE_SOLO). The plain
// pure_ext list still answers "is this builtin worker-safe?" for the
// existing smart-dispatch classifier; the effect table answers "what
// kind of side effect does it have?" for the realtime / io / gpu
// propagation in sub-step B and the call-site enforcement in sub-step
// C. Unregistered externs default to PHASE_SOLO (catch-all,
// conservative — the classifier never assumes more purity than it
// can prove).
static auto ext_names;
static auto ext_effects;

// Strided variable set for the current loop analysis.
static auto stride_vars;

// Local variable set for the current function scope.
static auto dsp_local_vars;

// Index of the function currently being analysed. Set by run_dispatch()
// before calling analyze_body so that classify_loop can query element types
// from the persistent fn_vt_data store without a signature change.
static auto _dsp_cur_func_idx;

// Initialize the dispatch engine. Call once at startup.
void init_dispatch() {
    flag_fma = 0;
    // Level 4 sub-step A — parser accepts the new annotations and stores
    // the codes here. Sub-step B turns them into propagation rules; until
    // then they are inert tags on fn_phase_hint, ignored by the W013 and
    // dispatch logic that still only consults BASE/SOLO.
    // PHASE_HEAP = transient allocation. Lives BELOW IO/GPU/SOLO in the
    // lattice but ABOVE BASE/REALTIME — you can build an IO or GPU
    // function on top of malloc, but a realtime callback still cannot
    // touch the heap. Added 2026-04-16 when `: io` audio setup
    // (malloc + FFI) reached SOLO by propagation and W026 screamed at
    // honest annotations. The plan's table had `heap (currently SOLO;
    // eventually distinct)` as a TODO — this makes it distinct.
    // PHASE_PANIC = never-returns abort path (sys_exit). Bottom element
    // of the lattice: PANIC ∨ X = X for any X. If a function reaches
    // sys_exit, the process is dead — no observable effect survives.
    // The function's effect is whatever it does WHEN IT RETURNS, and
    // sys_exit never returns. Formally identical to Rust's `!` / Never
    // type or C++'s [[noreturn]] in effect analysis. Only sys_exit
    // gets this seed explicitly; other abort paths (diag_fatal, assert
    // wrappers) inherit IO + PANIC = IO via transitive propagation,
    // which is correct — they print before dying, so the IO is real.
    fn_phase = arr_new();
    fn_phase_next = arr_new();
    fn_calls = arr_new();
    fn_address_taken = arr_new();
    fn_locally_impure = arr_new();
    fn_reachable = arr_new();
    fn_phase_hint = arr_new();
    fn_ret_hint   = arr_new();
    fn_ret_arity  = arr_new();
    fn_ret_types  = arr_new();
    fn_vt_locs    = arr_new();
    fn_effect = arr_new();
    fn_effect_next = arr_new();
    fn_inlineable = arr_new();
    fn_void_inlineable = arr_new();
    // S9 — sentinel for the lazy func-name hash. -1 forces a build
    // on the first `_dsp_find_func_idx` call (after parser finishes
    // populating funcs[]); subsequent stale-count rebuilds handle
    // smart-dispatch's worker-synth growth.
    _dsp_func_hash = 0;
    _dsp_func_hash_count = 0 - 1;
    init_fn_origins();
    init_fn_reg();
    init_glob_origins();
    _lazy_emit_ready = 0;
    glob_writers = arr_new();
    glob_readers = arr_new();
    glob_writes_pre = arr_new();
    glob_writes_post = arr_new();
    glob_promote_reason = arr_new();
    _dsp_main_idx = -1;
    _dsp_has_freeze = 0;
    pure_ext = arr_new();
    ext_names = arr_new();
    ext_effects = arr_new();
    _safe_sinks = arr_new();
    stride_vars = arr_new();
    dsp_local_vars = arr_new();

    // Seed the `@safe`-suggestion sinks. Each name registered here
    // turns into a W031 warning whenever the compiler sees a
    // `fn_ptr(target)` argument and `target` is not annotated `@safe`.
    // The set covers worker-pool dispatch sinks where the fn argument
    // runs on a worker thread under bounded-time / no-malloc
    // expectations. Phase callbacks (maestro_register_*) are NOT
    // here — they run on the main thread and may block on worker
    // dispatch by design. See the `_safe_sinks` declaration block above
    // for the full rationale.
    _safe_sinks = arr_push(_safe_sinks, _dsp_pack_cstr("job_submit"));
    _safe_sinks = arr_push(_safe_sinks, _dsp_pack_cstr("job_parallel_for"));
    // ecs_query_each_parallel: the parallel sibling of ecs_query_each
    // in stbecs. Its `fn_ptr(callback)` argument is dispatched to
    // workers; the callback must be `@safe`. Same W031 contract as
    // the job_submit / job_parallel_for pair.
    _safe_sinks = arr_push(_safe_sinks, _dsp_pack_cstr("ecs_query_each_parallel"));

    // Seed the pure-extern set with builtins the compiler emits inline
    // and that have no observable side effect. Without this seed the
    // classifier is pessimistic about any function that touches raw
    // memory, which downgrades genuinely pure helpers (e.g. string
    // length, packed field readers) all the way to PHASE_SOLO and
    // triggers a spurious W013 wave on the `: base` annotations that
    // those helpers legitimately carry.
    //
    // Members of the set must be read-only: they may compute over
    // arguments and read memory through explicit pointers, but they
    // must not write through any pointer, allocate, block, or call a
    // syscall. Today that narrows the list to the single-byte loaders.
    //   peek(p)           — read 8 bytes at p. Pure.
    //   str_peek(s, i)    — read byte s[i] of a C-string. Pure.
    // Expand with care: `poke` writes memory and therefore stays out.
    add_pure_extern(_dsp_pack_name("peek", 4));
    add_pure_extern(_dsp_pack_name("str_peek", 8));
    add_pure_extern(_dsp_pack_name("mem_barrier", 11));
    // Excalibur Feature 2 cast builtins. Pure: rounding + integer
    // conversion of a single float argument, no memory effects, safe
    // to call from `@safe` contexts (e.g. inside an audio callback
    // that needs an integer index from a float phase counter).
    add_pure_extern(_dsp_pack_name("floor_int", 9));
    add_pure_extern(_dsp_pack_name("trunc_int", 9));
    add_pure_extern(_dsp_pack_name("round_int", 9));
    add_extern_effect(_dsp_pack_cstr("peek"),           PHASE_BASE);
    add_extern_effect(_dsp_pack_cstr("str_peek"),       PHASE_BASE);
    add_extern_effect(_dsp_pack_cstr("mem_barrier"),    PHASE_BASE);
    add_extern_effect(_dsp_pack_cstr("fn_ptr"),         PHASE_BASE);
    add_extern_effect(_dsp_pack_cstr("putchar"),        PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("putchar_err"),    PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("getchar"),        PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_write"),      PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_read"),       PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_open"),       PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_close"),      PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("malloc"),         PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("free"),           PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("realloc"),        PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("memcpy"),         PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("sys_lseek"),      PHASE_IO);
    // Broader syscall classification. Everything that blocks, touches
    // the filesystem, or reads wall time is PHASE_IO. Process-lifecycle
    // syscalls and anything that reshapes the address space are
    // PHASE_SOLO — they have effects the effect lattice cannot
    // compensate for on a worker thread.
    add_extern_effect(_dsp_pack_cstr("sys_unlink"),       PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_usleep"),       PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_nanosleep"),    PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_clock_gettime"),PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_mkdir"),        PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_fchmod"),       PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_ioctl"),        PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_getdents"),     PHASE_IO);
    add_extern_effect(_dsp_pack_cstr("sys_mmap"),         PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("sys_munmap"),       PHASE_HEAP);
    add_extern_effect(_dsp_pack_cstr("sys_exit"),         PHASE_PANIC);
    add_extern_effect(_dsp_pack_cstr("sys_fork"),         PHASE_SOLO);
    add_extern_effect(_dsp_pack_cstr("sys_execve"),       PHASE_SOLO);
    add_extern_effect(_dsp_pack_cstr("sys_waitpid"),      PHASE_SOLO);
    add_extern_effect(_dsp_pack_cstr("sys_wait4"),        PHASE_SOLO);
    add_extern_effect(_dsp_pack_cstr("sys_ptrace"),       PHASE_SOLO);
    add_extern_effect(_dsp_pack_cstr("malloc_aligned"),   PHASE_HEAP);
    // `call` is intentionally NOT seeded. It is opaque at compile time
    // — the effect is whatever the function pointer's target has, and
    // we cannot know that statically. Registering it as PHASE_SOLO
    // would force every FFI-using function to SOLO through the
    // fixpoint, which drowns the Rule 4 signal in false positives.
    // Leaving it unregistered means the lookup returns -1, which the
    // walker maps to PHASE_AUTO — the lattice no-op. The caller's
    // annotation remains the contract.
}

// ── Global lookup helper ───────────────────────────────────
// Returns the index of name_p in globals[], or -1 if not found.
// Uses string-content comparison (packed_eq) because the declaration
// site and the reference site often have different packed values even
// for the same identifier — they were scanned at different points in
// the merged source.
dsp_find_global(name_p) {
    auto i, gp;
    for (i = 0; i < glob_cnt; i++) {
        gp = arr_get(globals, i);
        if (gp == name_p) { return i; }
        if (packed_eq(gp, name_p)) { return i; }
    }
    return -1;
}

// Register a pure extern function (no side effects). Call during setup,
// typically from init_dispatch for compiler-known builtins or from
// library code that wraps FFI calls it has audited as side-effect-free.
void add_pure_extern(name_p) {
    pure_ext = arr_push(pure_ext, name_p);
}

// Return 1 if `name_p` is registered as a `@safe`-suggestion sink
// (e.g. `job_submit`, `job_parallel_for`). Used by `_cgb_walk` to
// decide whether to scan the call's arguments for fn_ptr literals
// whose target should be `@safe`. Content comparison (packed_eq)
// handles the same-identifier-different-vbuf-offset case.
_is_safe_sink(name_p) {
    auto i, v;
    for (i = 0; i < arr_len(_safe_sinks); i++) {
        v = arr_get(_safe_sinks, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
    }
    return 0;
}

// Return 1 if a packed name matches any registered pure extern, 0
// otherwise. Uses content comparison (packed_eq) because the same
// identifier can be interned at different vbuf offsets at the seed
// site (init_dispatch) and the call sites the compiler scans later.
is_pure_extern(name_p) {
    auto i, v;
    for (i = 0; i < arr_len(pure_ext); i++) {
        v = arr_get(pure_ext, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
    }
    return 0;
}

// Register an extern with a specific effect class. Call during init for
// compiler-known builtins, or from FFI wrappers that have been audited.
void add_extern_effect(name_p, effect) {
    ext_names   = arr_push(ext_names,   name_p);
    ext_effects = arr_push(ext_effects, effect);
}

// Look up an extern's registered effect. Returns the effect code on
// match, or -1 if the name is not in the table. Sub-step B's classifier
// uses -1 as the "unknown — assume PHASE_SOLO" sentinel.
extern_effect(name_p) {
    auto i, v;
    for (i = 0; i < arr_len(ext_names); i++) {
        v = arr_get(ext_names, i);
        if (v == name_p) { return arr_get(ext_effects, i); }
        if (packed_eq(v, name_p)) { return arr_get(ext_effects, i); }
    }
    return -1;
}

// Join two effect codes according to the Level 4 lattice:
//   BASE < REALTIME < HEAP < {IO, GPU} < SOLO
// IO and GPU are incomparable, so a function that touches both lands
// at SOLO (the top of the lattice). HEAP is the transient-allocation
// class — malloc / free / realloc / memcpy / sys_mmap / sys_munmap —
// and is subsumed by IO or GPU (both IO and GPU functions routinely
// allocate scaffolding). Annotation enforcement consults this
// ordering via _dsp_eff_permits below. PHASE_AUTO (0) is the "unknown"
// bottom and is absorbed by any real value.
_dsp_eff_join(a, b) {
    // PANIC is the lattice bottom (⊥). Absorbed by everything.
    if (a == PHASE_PANIC) { return b; }
    if (b == PHASE_PANIC) { return a; }
    if (a == PHASE_SOLO) { return PHASE_SOLO; }
    if (b == PHASE_SOLO) { return PHASE_SOLO; }
    if (a == PHASE_AUTO) { return b; }
    if (b == PHASE_AUTO) { return a; }
    if (a == PHASE_BASE) { return b; }
    if (b == PHASE_BASE) { return a; }
    if (a == b) { return a; }
    // REALTIME combined with anything non-BASE escalates to that thing:
    // REALTIME + IO = IO (REALTIME is a constraint, not an effect).
    if (a == PHASE_REALTIME) { return b; }
    if (b == PHASE_REALTIME) { return a; }
    // HEAP is subsumed by IO / GPU — a function that both allocates
    // and does IO is simply an IO function; the fact that it also
    // touches the heap is an implementation detail the IO annotation
    // already permits.
    if (a == PHASE_HEAP) { return b; }
    if (b == PHASE_HEAP) { return a; }
    // Only case left: one is IO, the other is GPU. Incomparable → SOLO.
    return PHASE_SOLO;
}

// Register a local variable for the current function scope.
void dsp_add_local(name_p) {
    dsp_local_vars = arr_push(dsp_local_vars, name_p);
}

// Reset local variables for a new function scope.
void dsp_reset_locals() {
    arr_clear(dsp_local_vars);
}

// Check if a packed name is a local variable.
dsp_is_local(name_p) {
    auto i, v;
    for (i = 0; i < arr_len(dsp_local_vars); i++) {
        v = arr_get(dsp_local_vars, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
    }
    return 0;
}

// Check if a packed name is a strided variable in the current loop.
is_strided(name_p) {
    auto i;
    for (i = 0; i < arr_len(stride_vars); i++) {
        if (arr_get(stride_vars, i) == name_p) { return 1; }
    }
    return 0;
}

// Check if an expression tree contains a reference to a specific variable.
contains_var(nd, name_p) {
    auto n: Node;
    auto t, i, arr, cnt;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_VAR) {
        if (n.a == name_p) { return 1; }
        return 0;
    }
    if (t == T_BINOP) {
        if (contains_var(n.b, name_p)) { return 1; }
        return contains_var(n.c, name_p);
    }
    if (t == T_TERNARY) {
        if (contains_var(n.a, name_p)) { return 1; }
        if (contains_var(n.b, name_p)) { return 1; }
        return contains_var(n.c, name_p);
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (contains_var(arr[i], name_p)) { return 1; }
        }
        return 0;
    }
    if (t == T_UNARY) { return contains_var(n.b, name_p); }
    if (t == T_CALL) {
        arr = n.b;
        cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (contains_var(arr[i], name_p)) { return 1; }
        }
        return 0;
    }
    if (t == T_MEMLD) { return contains_var(n.a, name_p); }
    if (t == T_ADDR) { return contains_var(n.a, name_p); }
    if (t == T_ASSIGN) {
        if (contains_var(n.a, name_p)) { return 1; }
        return contains_var(n.b, name_p);
    }
    return 0;
}

// Find the loop induction variable from the body.
// Looks for "i = i + N" as the last assignment. Returns packed name or 0.
find_loop_var(body_arr, body_cnt) {
    auto i;
    auto (stmt, left, right, binop_left): Node;
    i = body_cnt - 1;
    while (i >= 0) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (stmt.ntype == T_ASSIGN) {
                left = stmt.a;
                right = stmt.b;
                if (left.ntype == T_VAR) {
                    if (right.ntype == T_BINOP) {
                        if (right.a == pack(43, 1)) {
                            binop_left = right.b;
                            if (binop_left.ntype == T_VAR) {
                                if (binop_left.a == left.a) {
                                    return left.a;
                                }
                            }
                        }
                    }
                }
            }
        }
        i--;
    }
    return 0;
}

// Find strided variables in the loop body.
// Pattern: var = base + (loop_var * stride). Populates stride_vars.
void find_strided(body_arr, body_cnt, loop_var_p) {
    auto i;
    auto (stmt, left, right): Node;
    auto r_right: Node;
    arr_clear(stride_vars);
    if (loop_var_p == 0) { return; }
    for (i = 0; i < body_cnt; i++) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (stmt.ntype == T_ASSIGN) {
                left = stmt.a;
                right = stmt.b;
                if (left.ntype == T_VAR) {
                    if (right.ntype == T_BINOP) {
                        r_right = right.c;
                        if (r_right != 0) {
                            if (r_right.ntype == T_BINOP) {
                                if (contains_var(r_right, loop_var_p)) {
                                    stride_vars = arr_push(stride_vars, left.a);
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}

// Forward declaration.
has_side_effects(nd) { return 0; }

// Check if an AST node has observable side effects.
has_side_effects(nd) {
    auto (n, p, base): Node;
    auto t, i, arr, cnt, name_p;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;

    // Function call: side effect if the target is not pure.
    if (t == T_CALL) {
        name_p = n.a;
        if (is_pure_extern(name_p) == 0) { return 1; }
        arr = n.b;
        cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (has_side_effects(arr[i])) { return 1; }
        }
        return 0;
    }

    // Assignment to a non-local variable is a global write.
    if (t == T_ASSIGN) {
        p = n.a;
        if (p.ntype == T_VAR) {
            name_p = p.a;
            if (dsp_is_local(name_p) == 0) {
                if (is_strided(name_p) == 0) {
                    return 1;
                }
            }
        }
        return has_side_effects(n.b);
    }

    // Memory store: safe only if pointer base is a strided variable.
    if (t == T_MEMST) {
        p = n.a;
        if (p.ntype == T_BINOP) {
            base = p.b;
            if (base.ntype == T_VAR) {
                if (is_strided(base.a)) {
                    return has_side_effects(n.b);
                }
            }
        }
        return 1;
    }

    // Recurse into child nodes.
    if (t == T_BINOP) {
        if (has_side_effects(n.b)) { return 1; }
        return has_side_effects(n.c);
    }
    if (t == T_TERNARY) {
        // Conservative: any of the three children with effects taints the whole.
        if (has_side_effects(n.a)) { return 1; }
        if (has_side_effects(n.b)) { return 1; }
        return has_side_effects(n.c);
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (has_side_effects(arr[i])) { return 1; }
        }
        return 0;
    }
    if (t == T_UNARY) { return has_side_effects(n.b); }
    if (t == T_MEMLD) { return has_side_effects(n.a); }
    if (t == T_ADDR) { return has_side_effects(n.a); }
    if (t == T_RET) { return has_side_effects(n.a); }

    if (t == T_IF) {
        if (has_side_effects(n.a)) { return 1; }
        arr = n.b;
        cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (has_side_effects(arr[i])) { return 1; }
        }
        if (n.e > 0) {
            arr = n.d;
            cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (has_side_effects(arr[i])) { return 1; }
            }
        }
        return 0;
    }

    if (t == T_WHILE) {
        if (has_side_effects(n.a)) { return 1; }
        arr = n.b;
        cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (has_side_effects(arr[i])) { return 1; }
        }
        if (n.e != 0) { if (has_side_effects(n.e)) { return 1; } }
        return 0;
    }

    return 0;
}

// Classify a while-loop node for dispatch.
// Writes the dispatch code to the node's dispatch field.
classify_loop(wh) {
    auto w: Node;
    auto body_arr, body_cnt, loop_var_p;
    auto i, pure_cnt, impure_cnt, dsp;
    w = wh;

    // Dispatch is decided HERE, automatically, from what the body does —
    // there is no programmer hint surface. (A dead hint check lived here
    // until the 2026-07-07 cleanup: it compared w.d against 1/2/3, but the
    // parser stored the raw packed annotation token there, which never
    // equals a small int, so no `@seq`/`@par`/`@gpu` ever matched. The
    // parser now rejects unknown statement annotations with E268 and
    // always writes w.d = 0.)

    body_arr = w.b;
    body_cnt = w.c;

    // Step 1: find the induction variable.
    loop_var_p = find_loop_var(body_arr, body_cnt);

    // Step 2: find strided variables.
    find_strided(body_arr, body_cnt, loop_var_p);

    // Step 3: add strided vars and loop var to local scope.
    if (loop_var_p != 0) { dsp_add_local(loop_var_p); }
    for (i = 0; i < arr_len(stride_vars); i++) {
        dsp_add_local(arr_get(stride_vars, i));
    }

    // Step 4: count pure and impure statements.
    pure_cnt = 0;
    impure_cnt = 0;
    for (i = 0; i < body_cnt; i++) {
        if (has_side_effects(body_arr[i])) {
            impure_cnt++;
        } else {
            pure_cnt++;
        }
    }

    // Step 5: classify.
    // For pure loops with strided variables: GPU if the strided array holds
    // float elements (SIMD-friendly), PAR otherwise (word/byte arrays).
    dsp = DSP_SEQ;
    if (impure_cnt == 0) {
        if (arr_len(stride_vars) > 0) {
            auto sv_elem;
            sv_elem = get_fn_elem_type(_dsp_cur_func_idx, arr_get(stride_vars, 0));
            if (is_float_type(sv_elem)) {
                dsp = DSP_GPU;
            } else {
                dsp = DSP_PAR;
            }
        } else {
            dsp = DSP_PAR;
        }
    } else {
        if (arr_len(stride_vars) > 0) {
            if (pure_cnt > 0) {
                dsp = DSP_SPLIT;
            }
        }
    }

    w.dispatch = dsp;
    return dsp;
}

// Analyze all loops in a function body (recursive for nesting).
void analyze_body(body_arr, body_cnt) {
    auto i;
    auto stmt: Node;
    for (i = 0; i < body_cnt; i++) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (stmt.ntype == T_WHILE) {
                classify_loop(stmt);
                analyze_body(stmt.b, stmt.c);
            }
            if (stmt.ntype == T_IF) {
                analyze_body(stmt.b, stmt.c);
                if (stmt.e > 0) {
                    analyze_body(stmt.d, stmt.e);
                }
            }
        }
    }
}

// ── Function lookup helper ─────────────────────────────────

// Find a function index by packed name. O(1) via hash with rebuild-
// on-stale-count semantics so smart-dispatch's late synth-fn
// additions (bpp_dispatch.bsm:3252 grows funcs[] after
// call_graph_build) stay visible — see `_dsp_build_func_hash`.
//
// Mirrors the val_find_func pattern from bpp_validate.bsm:421 +
// shares the same `+1/-1` dance to distinguish "absent" (hash_get
// returns 0) from "idx 0". Hot path: this function shows ~8% in
// `bench_compile.sh --sample`, dominated by the linear scan +
// packed_eq calls — see docs/plans/legacy/sidequest_compiler_hotpath_opt.md.
static auto _dsp_func_hash;            // hash_str: name → (idx + 1)
static auto _dsp_func_hash_count;      // func_cnt at last build; -1 = unbuilt

static void _dsp_build_func_hash() {
    auto i, rec, name_p;
    if (_dsp_func_hash == 0) { _dsp_func_hash = hash_str_new(256); }
    hash_str_clear(_dsp_func_hash);
    for (i = 0; i < func_cnt; i++) {
        rec = funcs[i];
        name_p = *(rec + FN_NAME);
        hash_str_set(_dsp_func_hash,
                     vbuf + unpack_s(name_p), unpack_l(name_p),
                     i + 1);
    }
    _dsp_func_hash_count = func_cnt;
}

static _dsp_find_func_idx(name_p) {
    auto v;
    // Lazy build + stale-count rebuild. Smart-dispatch's worker
    // synthesizer grows funcs[] after the initial call_graph_build
    // pass; comparing against `_dsp_func_hash_count` catches that
    // without exposing the table boundary to callers.
    if (_dsp_func_hash_count != func_cnt) { _dsp_build_func_hash(); }
    v = hash_str_get(_dsp_func_hash,
                     vbuf + unpack_s(name_p), unpack_l(name_p));
    if (v == 0) { return -1; }
    return v - 1;
}

// ── Call graph build ────────────────────────────────────────
//
// Walks every parsed function once, extracting:
//   fn_calls[i]          — list of function indices that function i calls directly
//   fn_address_taken[i]  — 1 if function i's address is taken via fn_ptr() anywhere
//   fn_locally_impure[i] — 1 if function i's body has any non-call side effect
//                          (write to non-local var, T_MEMST without strided base,
//                          call to impure extern)
//
// Cached functions (body_arr == 0) get default values: empty fn_calls,
// fn_address_taken=0, fn_locally_impure=0. Their actual classification
// will be loaded from the .bo cache once the format extension lands.
//
// The result feeds classify_all_functions() which iterates a fixpoint
// over the call graph to assign each function a PHASE_BASE/PHASE_SOLO
// label.

// Walk a single AST node looking for call graph entries (callees,
// fn_ptr captures), local impurity, and per-global use-def edges.
// Mutates per-function tracking state via globals.
static auto _cgb_calls;             // arr<int>: callees being collected for the current function
static auto _cgb_impure;            // 1 if the current function has local impurity
static auto _cgb_ext_eff;           // joined effect of externs called by the current function (Level 4 sub-step B)
static auto _cgb_addr_taken_set;    // arr<int>: function indices whose address was taken anywhere
static auto _cgb_current_fn_idx;    // function index currently being walked (so the
                             // walker can attribute global accesses to it)

// V3 Session 2 — fn_ptr origin tracking lifecycle.
//
// Allocate the outer arrays. Called once from init_dispatch (same
// file → Rule 2 static). Inner per-function slots are lazily
// allocated on first record.
static void init_fn_origins() {
    _fn_origin_names   = arr_new();
    _fn_origin_targets = arr_new();
}

// Ensure the per-function origin slots exist for index fi.
static void _fn_origin_grow(fi) {
    while (arr_len(_fn_origin_names) <= fi) {
        _fn_origin_names   = arr_push(_fn_origin_names,   0);
        _fn_origin_targets = arr_push(_fn_origin_targets, 0);
    }
    if (arr_get(_fn_origin_names, fi) == 0) {
        arr_set(_fn_origin_names,   fi, arr_new());
        arr_set(_fn_origin_targets, fi, arr_new());
    }
}

// Reset origin tracking for a single function. Called at the start of
// each function walk so re-runs do not see stale entries.
static void _fn_origin_clear_for(fi) {
    auto names_arr, targets_arr;
    if (arr_len(_fn_origin_names) <= fi) { return; }
    names_arr   = arr_get(_fn_origin_names,   fi);
    targets_arr = arr_get(_fn_origin_targets, fi);
    if (names_arr   != 0) { arr_clear(names_arr); }
    if (targets_arr != 0) { arr_clear(targets_arr); }
}

// Record (or overwrite) a fn_ptr origin for variable `name_p` inside
// function fi. target_fidx is the resolved callee index, or -1 to
// poison the slot (a non-fn_ptr value clobbered any prior origin).
// Last-write-in-source-order wins.
//
// arr_push may relocate; the canonical B++ idiom is
// `arr_set(outer, idx, arr_push(arr_get(outer, idx), val))` so the
// outer slot keeps pointing at the live buffer after relocation.
static void _fn_origin_record(fi, name_p, target_fidx) {
    auto names_arr, targets_arr, n, i;
    _fn_origin_grow(fi);
    names_arr   = arr_get(_fn_origin_names,   fi);
    targets_arr = arr_get(_fn_origin_targets, fi);
    n = arr_len(names_arr);
    for (i = 0; i < n; i++) {
        if (packed_eq(arr_get(names_arr, i), name_p)) {
            arr_set(targets_arr, i, target_fidx);
            return;
        }
    }
    arr_set(_fn_origin_names,   fi, arr_push(names_arr,   name_p));
    arr_set(_fn_origin_targets, fi, arr_push(targets_arr, target_fidx));
}

// Resolve the first arg of a `call(fp, ...)` site to a target function
// index, using whatever fn_ptr origin information is available at the
// moment of the walk. Two paths:
//   - Direct: `call(fn_ptr(name), ...)` — find name in funcs[].
//   - Indirect: `call(local, ...)` — look up local's recorded origin
//     in `_fn_origin_*`. The walker runs in textual source order so
//     the most recent assignment up to this point wins.
// Returns target_fidx (>= 0) or -1 (unresolved).
static _cgb_resolve_call_target(fp_nd) {
    auto fp: Node, name_p, args_arr, target_node: Node;
    if (fp_nd == 0) { return -1; }
    fp = fp_nd;
    if (fp.ntype == T_CALL) {
        name_p = fp.a;
        if (unpack_l(name_p) != 6) { return -1; }
        if (buf_eq(vbuf + unpack_s(name_p), "fn_ptr", 6) == 0) { return -1; }
        if (fp.c < 1) { return -1; }
        args_arr = fp.b;
        target_node = args_arr[0];
        if (target_node.ntype != T_VAR) { return -1; }
        return _dsp_find_func_idx(target_node.a);
    }
    if (fp.ntype == T_VAR) {
        return dsp_fn_origin_get(_cgb_current_fn_idx, fp.a);
    }
    return -1;
}

// Inspect an AST node and extract the target function index when the
// node is a `fn_ptr(name)` call referring to a known user function.
// Returns target_fidx (>= 0) on success, -1 otherwise — used as the
// "poison" marker by `_fn_origin_record` so any non-fn_ptr RHS clears
// a previously-recorded origin slot.
static _cgb_extract_fn_ptr_target(rhs_nd) {
    auto rhs: Node, name_p, args_arr, arg0: Node;
    if (rhs_nd == 0) { return -1; }
    rhs = rhs_nd;
    if (rhs.ntype != T_CALL) { return -1; }
    name_p = rhs.a;
    if (unpack_l(name_p) != 6) { return -1; }
    if (buf_eq(vbuf + unpack_s(name_p), "fn_ptr", 6) == 0) { return -1; }
    if (rhs.c < 1) { return -1; }
    args_arr = rhs.b;
    arg0 = args_arr[0];
    if (arg0.ntype != T_VAR) { return -1; }
    return _dsp_find_func_idx(arg0.a);
}

// V3 Session 4 — registration-helper bookkeeping lifecycle.
//
// Allocate the outer arrays. Called once from init_dispatch (same
// file → Rule 2 static). Inner per-function slots are lazily
// allocated on first record.
static void init_fn_reg() {
    _fn_reg_param  = arr_new();
    _fn_reg_global = arr_new();
}

// Ensure the per-function slot for fi exists.
static void _fn_reg_grow(fi) {
    while (arr_len(_fn_reg_param) <= fi) {
        _fn_reg_param  = arr_push(_fn_reg_param,  0);
        _fn_reg_global = arr_push(_fn_reg_global, 0);
    }
    if (arr_get(_fn_reg_param, fi) == 0) {
        arr_set(_fn_reg_param,  fi, arr_new());
        arr_set(_fn_reg_global, fi, arr_new());
    }
}

// Reset registration entries for a single function, called at the
// start of each function walk so re-walks do not see stale data.
static void _fn_reg_clear_for(fi) {
    auto p_arr, g_arr;
    if (arr_len(_fn_reg_param) <= fi) { return; }
    p_arr = arr_get(_fn_reg_param,  fi);
    g_arr = arr_get(_fn_reg_global, fi);
    if (p_arr != 0) { arr_clear(p_arr); }
    if (g_arr != 0) { arr_clear(g_arr); }
}

// Record a (param_idx, global_name) registration pair for function fi.
// Called from `_cgb_walk` when it spots `T_ASSIGN(global, T_VAR(param))`.
// Multiple distinct (param_idx, global) pairs per function are allowed —
// useful for helpers that store more than one callback into more than
// one global slot.
static void _fn_reg_record_pair(fi, param_idx, global_p) {
    auto p_arr, g_arr, n, i;
    _fn_reg_grow(fi);
    p_arr = arr_get(_fn_reg_param,  fi);
    g_arr = arr_get(_fn_reg_global, fi);
    // Dedupe — exact pair already known.
    n = arr_len(p_arr);
    for (i = 0; i < n; i++) {
        if (arr_get(p_arr, i) == param_idx) {
            if (packed_eq(arr_get(g_arr, i), global_p)) { return; }
        }
    }
    arr_set(_fn_reg_param,  fi, arr_push(p_arr, param_idx));
    arr_set(_fn_reg_global, fi, arr_push(g_arr, global_p));
}

// Public — returns 1 if function fi has at least one registered pair.
dsp_is_reg_helper(fi) {
    auto p_arr;
    if (arr_len(_fn_reg_param) <= fi) { return 0; }
    p_arr = arr_get(_fn_reg_param, fi);
    if (p_arr == 0) { return 0; }
    if (arr_len(p_arr) == 0) { return 0; }
    return 1;
}

// Public — number of registration entries for function fi.
dsp_reg_helper_count(fi) {
    auto p_arr;
    if (arr_len(_fn_reg_param) <= fi) { return 0; }
    p_arr = arr_get(_fn_reg_param, fi);
    if (p_arr == 0) { return 0; }
    return arr_len(p_arr);
}

// Public — k-th param index registered by function fi.
dsp_reg_helper_param_at(fi, k) {
    return arr_get(arr_get(_fn_reg_param, fi), k);
}

// Public — packed name of the global at slot k of function fi.
dsp_reg_helper_global_at(fi, k) {
    return arr_get(arr_get(_fn_reg_global, fi), k);
}

// V3 Session 4 — Pass B lifecycle.
//
// Allocate the global-origin tables. Called once from init_dispatch
// (same file → static).
static void init_glob_origins() {
    _glob_origin_names   = arr_new();
    _glob_origin_targets = arr_new();
    _fn_callers          = arr_new();
    fn_max_call_loop_depth = arr_new();
    fn_hot_transitive      = arr_new();
}

// Find the slot index for a given global packed name. Returns the
// index when present, -1 otherwise. Linear scan — Sessions 2-5 keep
// the global registry size small (handful of registries per program).
static _glob_origins_find(global_p) {
    auto i, n;
    n = arr_len(_glob_origin_names);
    for (i = 0; i < n; i++) {
        if (packed_eq(arr_get(_glob_origin_names, i), global_p)) { return i; }
    }
    return -1;
}

// Append a target_fidx to the origin list for `global_p`, creating
// the slot if needed. Dedupes — repeated identical registrations of
// the same target through the same global are recorded once.
static void _glob_origins_record(global_p, target_fidx) {
    auto idx, targets, n, i;
    idx = _glob_origins_find(global_p);
    if (idx < 0) {
        _glob_origin_names = arr_push(_glob_origin_names, global_p);
        targets = arr_new();
        targets = arr_push(targets, target_fidx);
        _glob_origin_targets = arr_push(_glob_origin_targets, targets);
        return;
    }
    targets = arr_get(_glob_origin_targets, idx);
    n = arr_len(targets);
    for (i = 0; i < n; i++) {
        if (arr_get(targets, i) == target_fidx) { return; }
    }
    arr_set(_glob_origin_targets, idx, arr_push(targets, target_fidx));
}

// Public — list of target_fidx values registered into `global_p`, or
// 0 when no caller has registered anything (silent: validator falls
// through to other resolution paths).
dsp_glob_origins(global_p) {
    auto idx;
    idx = _glob_origins_find(global_p);
    if (idx < 0) { return 0; }
    return arr_get(_glob_origin_targets, idx);
}

// Build `_fn_callers` from `fn_calls[]`. Linear inversion — each
// element of `fn_calls[fi]` becomes an entry in `_fn_callers[callee]`.
// Runs in `call_graph_build` after Pass A is fully complete. Cleans
// stale state from previous bootstrap rounds.
static void _dsp_build_callers() {
    auto i, j, callees, callee_idx, n, m;
    while (arr_len(_fn_callers) < func_cnt) {
        _fn_callers = arr_push(_fn_callers, arr_new());
    }
    for (i = 0; i < func_cnt; i++) {
        arr_clear(arr_get(_fn_callers, i));
    }
    for (i = 0; i < func_cnt; i++) {
        callees = arr_get(fn_calls, i);
        if (callees == 0) { continue; }
        n = arr_len(callees);
        for (j = 0; j < n; j++) {
            callee_idx = arr_get(callees, j);
            if (callee_idx < 0) { continue; }
            if (callee_idx >= func_cnt) { continue; }
            arr_set(_fn_callers, callee_idx,
                    arr_push(arr_get(_fn_callers, callee_idx), i));
        }
    }
}

// S4 hotness propagation (Inc 8) — must run AFTER `_dsp_build_callers`
// (it walks `_fn_callers`, the inverse call graph that function just
// built). Seeds `fn_hot_transitive[fi] = 1` for any fi with a direct
// call site inside a loop (`fn_max_call_loop_depth[fi] > 0`), then
// propagates down the call graph: if G is hot and G calls F, F is hot
// too — a real-time DSP chain five calls deep (`sf_render`'s per-sample
// loop -> ... -> `exp_f`) all become hot, not just the one direct call
// site that happens to sit textually inside a loop. Fixpoint capped at
// 8 passes, same shape and same cap as `classify_inlineable`'s own
// fixpoint (eligibility only ever grows — comparing a simple sum across
// passes is a rigorous "nothing changed" test here too).
static void _dsp_build_hot_transitive() {
    auto i, j, callers, n, changed, sum_before, sum_after, iter;
    for (i = 0; i < func_cnt; i++) {
        if (arr_get(fn_max_call_loop_depth, i) > 0) {
            arr_set(fn_hot_transitive, i, 1);
        }
    }
    sum_before = -1;
    changed = 1;
    iter = 0;
    while (changed && iter < 8) {
        for (i = 0; i < func_cnt; i++) {
            if (arr_get(fn_hot_transitive, i)) { continue; }
            callers = arr_get(_fn_callers, i);
            if (callers == 0) { continue; }
            n = arr_len(callers);
            for (j = 0; j < n; j++) {
                if (arr_get(fn_hot_transitive, arr_get(callers, j))) {
                    arr_set(fn_hot_transitive, i, 1);
                    break;
                }
            }
        }
        sum_after = 0;
        for (i = 0; i < func_cnt; i++) { sum_after += arr_get(fn_hot_transitive, i); }
        changed = (sum_after != sum_before);
        sum_before = sum_after;
        iter++;
    }
}

// Recursively scan an AST node for direct calls to `helper_fi` and
// record every fn_ptr literal at `param_idx` of those calls into the
// origin slot for `global_p`. The walker is targeted: it only
// recurses through control-flow nodes, never re-entering function
// bodies it should not.
static void _glob_origins_walk_node(nd, helper_fi, param_idx, global_p) {
    auto n: Node, t, name_p, args_arr, arg_at: Node, target_fi, i, cnt, sub_arr;
    if (nd == 0) { return; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        name_p = n.a;
        target_fi = _dsp_find_func_idx(name_p);
        if (target_fi == helper_fi) {
            if (n.c > param_idx) {
                args_arr = n.b;
                arg_at = args_arr[param_idx];
                if (arg_at != 0) {
                    auto cap_target;
                    cap_target = _cgb_extract_fn_ptr_target(arg_at);
                    if (cap_target >= 0) {
                        _glob_origins_record(global_p, cap_target);
                    }
                }
            }
        }
        // Recurse into args anyway — nested calls might still match.
        cnt = n.c;
        args_arr = n.b;
        for (i = 0; i < cnt; i++) {
            _glob_origins_walk_node(args_arr[i], helper_fi, param_idx, global_p);
        }
        return;
    }
    if (t == T_ASSIGN) {
        _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p);
        _glob_origins_walk_node(n.b, helper_fi, param_idx, global_p);
        return;
    }
    if (t == T_BINOP) {
        _glob_origins_walk_node(n.b, helper_fi, param_idx, global_p);
        _glob_origins_walk_node(n.c, helper_fi, param_idx, global_p);
        return;
    }
    if (t == T_TERNARY) {
        _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p);
        _glob_origins_walk_node(n.b, helper_fi, param_idx, global_p);
        _glob_origins_walk_node(n.c, helper_fi, param_idx, global_p);
        return;
    }
    if (t == T_BLOCK) {
        sub_arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            _glob_origins_walk_node(sub_arr[i], helper_fi, param_idx, global_p);
        }
        return;
    }
    if (t == T_UNARY) { _glob_origins_walk_node(n.b, helper_fi, param_idx, global_p); return; }
    if (t == T_MEMLD) { _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p); return; }
    if (t == T_MEMST) {
        _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p);
        _glob_origins_walk_node(n.b, helper_fi, param_idx, global_p);
        return;
    }
    if (t == T_ADDR) { _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p); return; }
    if (t == T_RET)  { _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p); return; }
    if (t == T_IF) {
        _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p);
        sub_arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            _glob_origins_walk_node(sub_arr[i], helper_fi, param_idx, global_p);
        }
        if (n.e > 0) {
            sub_arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                _glob_origins_walk_node(sub_arr[i], helper_fi, param_idx, global_p);
            }
        }
        return;
    }
    if (t == T_WHILE) {
        _glob_origins_walk_node(n.a, helper_fi, param_idx, global_p);
        sub_arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            _glob_origins_walk_node(sub_arr[i], helper_fi, param_idx, global_p);
        }
        if (n.e != 0) { _glob_origins_walk_node(n.e, helper_fi, param_idx, global_p); }
        return;
    }
}

// Capture all fn_ptr origins flowing through registration helper fi.
// For each (param_idx, global_p) pair fi has registered, walk every
// caller's body looking for `T_CALL fi(args)` and record args[param_idx]
// when it is a fn_ptr literal. Strict policy: every distinct origin
// gets recorded; later validation against `dsp_glob_origins` checks
// args against ALL origins (Estrita conflict resolution).
static void _glob_origins_capture(fi) {
    auto k, n, callers, m, c, caller_fi, fn_rec, body_arr, body_cnt, j;
    auto param_idx, global_p;
    n = dsp_reg_helper_count(fi);
    if (n == 0) { return; }
    if (arr_len(_fn_callers) <= fi) { return; }
    callers = arr_get(_fn_callers, fi);
    if (callers == 0) { return; }
    m = arr_len(callers);
    for (k = 0; k < n; k++) {
        param_idx = dsp_reg_helper_param_at(fi, k);
        global_p  = dsp_reg_helper_global_at(fi, k);
        for (c = 0; c < m; c++) {
            caller_fi = arr_get(callers, c);
            if (caller_fi < 0 || caller_fi >= func_cnt) { continue; }
            fn_rec = funcs[caller_fi];
            body_arr = *(fn_rec + FN_BODY);
            body_cnt = *(fn_rec + FN_BCNT);
            for (j = 0; j < body_cnt; j++) {
                _glob_origins_walk_node(body_arr[j], fi, param_idx, global_p);
            }
        }
    }
}

// Find a parameter index by packed name in function fi. Pure lookup —
// returns the index (0..param_cnt-1) or -1 if name is not a param.
static _cgb_param_idx_of(fi, name_p) {
    auto fn_rec, params_arr, param_cnt, i;
    fn_rec = funcs[fi];
    params_arr = *(fn_rec + FN_PARS);
    param_cnt  = *(fn_rec + FN_PCNT);
    for (i = 0; i < param_cnt; i++) {
        if (packed_eq(params_arr[i], name_p)) { return i; }
    }
    return -1;
}

// Public lookup. Returns target_fidx (>= 0) when origin resolves to a
// known function, -1 when the slot is poisoned or the variable was not
// tracked at all.
dsp_fn_origin_get(fi, name_p) {
    auto names_arr, targets_arr, n, i;
    if (arr_len(_fn_origin_names) <= fi) { return -1; }
    names_arr   = arr_get(_fn_origin_names,   fi);
    targets_arr = arr_get(_fn_origin_targets, fi);
    if (names_arr == 0) { return -1; }
    n = arr_len(names_arr);
    for (i = 0; i < n; i++) {
        if (packed_eq(arr_get(names_arr, i), name_p)) {
            return arr_get(targets_arr, i);
        }
    }
    return -1;
}

static _cgb_walk(nd) {
    auto (n, p, base): Node;
    auto t, i, arr, cnt, name_p, callee_idx;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;

    // Function call: record edge to callee. Special-case fn_ptr() — its
    // first argument is the name of a function whose address is taken.
    if (t == T_CALL) {
        name_p = n.a;
        arr = n.b;
        cnt = n.c;
        // fn_ptr(name): mark the named function as address-taken.
        // Detect by name comparison against the literal "fn_ptr".
        if (cnt == 1) {
            auto fp_target: Node;
            // The argument should be a T_VAR whose .a is the target function's name.
            // We mark address-taken at the SET level here; classification consults
            // it via fn_address_taken[].
            fp_target = arr[0];
            if (fp_target != 0) {
                if (fp_target.ntype == T_VAR) {
                    callee_idx = _dsp_find_func_idx(fp_target.a);
                    if (callee_idx >= 0) {
                        _cgb_addr_taken_set = arr_push(_cgb_addr_taken_set, callee_idx);
                    }
                }
            }
        }
        // V3 Session 2 — for `call(fp, ...)` builtin, snapshot the
        // resolved fp target into n.e so the validator can fire W028
        // without re-resolving against a stale origin map. Stored as
        // `target_fi + 1` (0 = absent / unresolved). The walk runs in
        // textual source order, so the origin lookup here sees the
        // most recent assignment up to this point — which is what
        // execution sees when control reaches this call.
        if (cnt >= 1) {
            if (unpack_l(name_p) == 4) {
                if (buf_eq(vbuf + unpack_s(name_p), "call", 4)) {
                    auto _resolved;
                    _resolved = _cgb_resolve_call_target(arr[0]);
                    if (_resolved >= 0) { n.e = _resolved + 1; }
                }
            }
        }
        // W031 — `@safe`-suggestion. When the call target is a
        // worker-dispatch sink (job_submit, job_parallel_for), scan
        // the args for `fn_ptr(target)` literals and check that
        // `target` is annotated `@safe`. The annotation is the only
        // way the compiler can verify the bounded-time / no-malloc
        // contract for the worker callback; without it, a worker
        // thread that grows a malloc later goes undetected until it
        // manifests as a race under load.
        if (_is_safe_sink(name_p)) {
            auto _ws_i, _ws_arg: Node, _ws_fp: Node, _ws_fp_name;
            auto _ws_target: Node, _ws_target_idx;
            for (_ws_i = 0; _ws_i < cnt; _ws_i++) {
                _ws_arg = arr[_ws_i];
                if (_ws_arg == 0) { continue; }
                if (_ws_arg.ntype != T_CALL) { continue; }
                _ws_fp_name = _ws_arg.a;
                if (unpack_l(_ws_fp_name) != 6) { continue; }
                if (buf_eq(vbuf + unpack_s(_ws_fp_name), "fn_ptr", 6) == 0) {
                    continue;
                }
                if (_ws_arg.c != 1) { continue; }
                _ws_fp = _ws_arg.b;
                _ws_target = _ws_fp[0];
                if (_ws_target == 0) { continue; }
                if (_ws_target.ntype != T_VAR) { continue; }
                _ws_target_idx = _dsp_find_func_idx(_ws_target.a);
                if (_ws_target_idx < 0) { continue; }
                if (arr_get(fn_phase_hint, _ws_target_idx) == PHASE_SAFE) {
                    continue;
                }
                diag_warn(31);
                diag_str("'");
                diag_packed(_ws_target.a);
                diag_str("' registered via '");
                diag_packed(name_p);
                diag_str("' without '@safe' annotation");
                diag_newline();
                diag_loc(*(funcs[_ws_target_idx] + FN_SRC_TOK));
                diag_show_line(*(funcs[_ws_target_idx] + FN_SRC_TOK));
                diag_str("  = note: worker callbacks must be bounded-time / no-malloc / no-IO");
                diag_newline();
                diag_str("          @safe is the contract the compiler verifies (W026)");
                diag_newline();
                diag_str("  = help: annotate the function `(...)@safe { ... }`");
                diag_newline();
                diag_str("  = see:  docs/manual/tonify_checklist.md Rule 4");
                diag_newline();
            }
        }
        // Direct call to a user function: record edge.
        callee_idx = _dsp_find_func_idx(name_p);
        if (callee_idx >= 0) {
            _cgb_calls = arr_push(_cgb_calls, callee_idx);
            // S4 hotness (Inc 8): n.d is THIS call site's own parser-
            // stamped loop depth (S4 P0a) — already sitting on the node
            // we're visiting, no separate walk needed. Track the max
            // across every direct call site anywhere in the program.
            if (n.d > arr_get(fn_max_call_loop_depth, callee_idx)) {
                arr_set(fn_max_call_loop_depth, callee_idx, n.d);
            }
        } else {
            // Not a user function — must be an extern or builtin. If it's
            // not a known-pure extern, treat as local impurity (call could
            // do anything). Builtins like malloc/free/sys_* are NOT in the
            // pure set, so they all count as impure for now.
            if (is_pure_extern(name_p) == 0) {
                _cgb_impure = 1;
            }
            // Level 4 sub-step B — record the called extern's effect so
            // the effect fixpoint can propagate it. Unknown externs map
            // to PHASE_AUTO (no-op in the join lattice). This makes the
            // Rule 4 enforcement gradual: W026 fires only when the call
            // graph KNOWS the callee has an incompatible effect, which
            // keeps the ext_effects seed table the single source of
            // truth. Extending coverage just means adding more
            // add_extern_effect lines.
            auto _ee;
            _ee = extern_effect(name_p);
            if (_ee < 0) { _ee = PHASE_AUTO; }
            _cgb_ext_eff = _dsp_eff_join(_cgb_ext_eff, _ee);
        }
        // Walk argument expressions (they may have side effects too).
        for (i = 0; i < cnt; i++) {
            _cgb_walk(arr[i]);
        }
        return 0;
    }

    // Assignment to a non-local variable is a global write; assignment
    // to a local with `fn_ptr(name)` RHS records the origin (V3 S2).
    if (t == T_ASSIGN) {
        p = n.a;
        if (p.ntype == T_VAR) {
            name_p = p.a;
            if (dsp_is_local(name_p) == 0) {
                // Module-private data: rewrite a colliding static's write target
                // to its mangled name (no-op when the program has no collisions).
                auto _wrp;
                _wrp = _mpg_resolve(name_p);
                if (_wrp != name_p) { p.a = _wrp; name_p = _wrp; }
                if (is_strided(name_p) == 0) {
                    _cgb_impure = 1;
                }
                // Record the use-def edge: this function writes to the
                // global. The promoter consumes this in promote_globals().
                auto _gi;
                _gi = dsp_find_global(name_p);
                if (_gi >= 0) {
                    arr_set(glob_writers, _gi,
                            arr_push(arr_get(glob_writers, _gi), _cgb_current_fn_idx));
                }
                // V3 Session 4 Pass A — registration helper detection.
                // Recognise `_global = some_param;` and remember (fi,
                // param_idx, global) so Pass B can later capture the
                // fn_ptr origins flowing through this helper's callers.
                if (n.b != 0) {
                    auto _rhs_node: Node, _param_idx;
                    _rhs_node = n.b;
                    if (_rhs_node.ntype == T_VAR) {
                        _param_idx = _cgb_param_idx_of(_cgb_current_fn_idx, _rhs_node.a);
                        if (_param_idx >= 0) {
                            _fn_reg_record_pair(_cgb_current_fn_idx, _param_idx, name_p);
                        }
                    }
                }
            } else {
                // V3 Session 2 — fn_ptr origin tracking. Either RHS is
                // a `fn_ptr(name)` literal (record target_fidx) or
                // anything else (poison: -1 invalidates any prior origin).
                _fn_origin_record(_cgb_current_fn_idx, name_p,
                                  _cgb_extract_fn_ptr_target(n.b));
            }
        }
        // Walk the RHS — its T_VAR nodes count as reads.
        _cgb_walk(n.b);
        return 0;
    }

    // Variable reference: if it's a global, record a read edge.
    if (t == T_VAR) {
        name_p = n.a;
        if (dsp_is_local(name_p) == 0) {
            // Module-private data: rewrite a colliding static's read to its
            // mangled name (no-op when the program has no collisions).
            auto _rrp;
            _rrp = _mpg_resolve(name_p);
            if (_rrp != name_p) { n.a = _rrp; name_p = _rrp; }
            auto _gi;
            _gi = dsp_find_global(name_p);
            if (_gi >= 0) {
                arr_set(glob_readers, _gi,
                        arr_push(arr_get(glob_readers, _gi), _cgb_current_fn_idx));
            }
        }
        return 0;
    }

    // Memory store: classify purity from the pointer-base shape, but
    // ALWAYS recurse into both the pointer expression and the RHS so
    // nested fn_ptr/fn_calls inside e.g. `h.field = fn_ptr(name)` get
    // their address-taken bookkeeping. Skipping the RHS used to leave
    // some_handler unseeded for mark_reachable, producing a hard
    // "internal error: fn_ptr target not found after validate" at
    // codegen time.
    if (t == T_MEMST) {
        auto _strided;
        _strided = 0;
        p = n.a;
        if (p.ntype == T_BINOP) {
            base = p.b;
            if (base.ntype == T_VAR) {
                if (is_strided(base.a)) { _strided = 1; }
            }
        }
        if (_strided == 0) { _cgb_impure = 1; }
        _cgb_walk(n.a);
        _cgb_walk(n.b);
        return 0;
    }

    // Recurse into children.
    if (t == T_BINOP) {
        _cgb_walk(n.b);
        _cgb_walk(n.c);
        return 0;
    }
    if (t == T_TERNARY) {
        _cgb_walk(n.a);
        _cgb_walk(n.b);
        _cgb_walk(n.c);
        return 0;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _cgb_walk(arr[i]); }
        return 0;
    }
    if (t == T_UNARY) { _cgb_walk(n.b); return 0; }
    if (t == T_MEMLD) { _cgb_walk(n.a); return 0; }
    if (t == T_ADDR)  { _cgb_walk(n.a); return 0; }
    if (t == T_RET)   { _cgb_walk(n.a); return 0; }

    if (t == T_IF) {
        _cgb_walk(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _cgb_walk(arr[i]); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { _cgb_walk(arr[i]); }
        }
        return 0;
    }

    if (t == T_WHILE) {
        _cgb_walk(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _cgb_walk(arr[i]); }
        if (n.e != 0) { _cgb_walk(n.e); }
        return 0;
    }

    return 0;
}

// Default worker count for the auto-injected job_init call (used by
// both the early prescan below and the late post-hoc check further
// down). Mirrors `_MS_DEFAULT_WORKERS` in bpp_maestro.bsm (same
// number, duplicated for the same reason `_DSP_MAP_MIN_N` duplicates
// `_OUTLINE_MIN_N` — this module reasons about the user program's
// AST, it does not import the runtime module whose constant it
// mirrors). Declared here, ahead of its first use — unlike a
// function name, a `const` is plain textual substitution and must be
// declared before the point it is used in the same module.
const _DSP_DEFAULT_WORKERS = 4;

// ── Early freeze-point prescan (closes the "auto job_init" loop) ────
//
// `_dsp_auto_init_job_pool` (further down, called from
// `rewrite_dispatch_loops`) only helps a captureless MAP candidate
// that `promote_globals` already accepted via Rule 4 (a PHASE_BASE
// reader or writer) — rare, because most loop bodies with side
// effects aren't PHASE_BASE. The far more common shape — a global
// written ONLY by main() (Rule 3's "all writers are main, pre>0,
// post==0" eligibility) — never reaches that point at all: Rule 3 is
// gated on `_dsp_has_freeze`, which only becomes true once an
// EXISTING literal call to job_init / maestro_run / maestro_configure
// is found in main()'s body. Chicken-and-egg: the whole point of this
// feature is to make that call unnecessary, but Rule 3 cannot promote
// the global the candidate needs until the call already exists.
//
// This prescan runs BEFORE `call_graph_build` (and therefore before
// its own freeze walk, `_dsp_walk_main_for_freeze`): a loose,
// body-safety-free shape check — does ANY `@safe` function contain a
// top-level ascending for-loop with a literal-step / `i < bound`
// condition? If so, and main() does not already manage its own freeze
// point, inject `job_init(_DSP_DEFAULT_WORKERS)` as the literal first
// statement of main() right now. By the time `_dsp_walk_main_for_freeze`
// runs moments later, it sees a real freeze marker and Rule 3 promotes
// normally — no special-casing needed anywhere else downstream.
//
// Deliberately conservative in the SAFE direction, not the strict one:
// a false positive here (an `@safe` loop that looks dispatchable but
// later fails the real body-safety walk in `_fdc_try_candidate`) costs
// nothing but 4 idle worker threads for the program's lifetime — every
// real safety gate downstream (`promote_globals`, `_fdc_subtree_safe`,
// the floor guards) still runs exactly as before and can reject
// anything this loose scan let through. There is no correctness risk
// in firing this prescan "too often," only a tiny, bounded, one-time
// startup cost when it fires and nothing downstream actually uses it.

// Pure loop-header shape check — step `i = i + K` (K > 0 literal) and
// condition `i < bound` — with NO body inspection. Mirrors
// `_fdc_try_candidate`'s steps A/B/C (further down) minus the parts
// that need globals already classified, which is exactly what this
// prescan runs before.
static _dsp_prescan_loop_shape_ok(wh_p) {
    auto (wh, cond, step): Node;
    auto (cond_lhs, cond_rhs): Node;
    auto (step_lhs, step_rhs, step_rhs_l, step_rhs_r): Node;
    wh = wh_p;
    if (wh.e == 0) { return 0; }
    step = wh.e;
    if (step.ntype != T_ASSIGN) { return 0; }
    step_lhs = step.a;
    if (step_lhs.ntype != T_VAR) { return 0; }
    step_rhs = step.b;
    if (step_rhs.ntype != T_BINOP) { return 0; }
    if (_fdc_op_char(step_rhs.a) != '+') { return 0; }
    step_rhs_l = step_rhs.b;
    step_rhs_r = step_rhs.c;
    if (step_rhs_l.ntype != T_VAR) { return 0; }
    if (step_rhs_r.ntype != T_LIT) { return 0; }
    if (_fdc_is_int_lit(step_rhs_r.a) == 0) { return 0; }
    if (parse_int_lit_value(step_rhs_r.a) <= 0) { return 0; }
    cond = wh.a;
    if (cond.ntype != T_BINOP) { return 0; }
    if (_fdc_op_char(cond.a) != '<') { return 0; }
    cond_lhs = cond.b;
    cond_rhs = cond.c;
    if (cond_lhs.ntype != T_VAR) { return 0; }
    if (cond_rhs.ntype != T_LIT) {
        if (cond_rhs.ntype != T_VAR) { return 0; }
    }
    if (_dsp_prescan_body_has_nested_loop(wh)) { return 0; }
    return 1;
}

// True if `nd`'s subtree contains a T_WHILE or T_SWITCH anywhere
// inside it. A nested loop inside a dispatch candidate's body is a
// KNOWN, documented MVP limitation (how_to_dev_b++.md §5.6: "The body
// has no nested loops...") — `_fdc_subtree_safe` (further down)
// unconditionally rejects it via its own `T_WHILE, T_SWITCH { return
// 0; }` case. Mirrored here so both the prescan and the W033 warning
// below treat it the same documented way: never a candidate, never a
// surprise worth a diagnostic. `mixer_fill` (stb/stbmixer.bsm) is the
// worked example — its outer per-sample loop wraps an inner
// per-voice loop, by design, and was never going to qualify.
static _dsp_subtree_has_nested_loop(nd) {
    auto (n): Node;
    auto t, i, arr, cnt;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_WHILE) { return 1; }
    if (t == T_SWITCH) { return 1; }
    if (t == T_IF) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_has_nested_loop(arr[i])) { return 1; }
        }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (_dsp_subtree_has_nested_loop(arr[i])) { return 1; }
            }
        }
        return 0;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_has_nested_loop(arr[i])) { return 1; }
        }
        return 0;
    }
    return 0;
}

// Walks `wh_p`'s (a T_WHILE node) own body statements for a nested
// loop — see `_dsp_subtree_has_nested_loop` above for why this
// disqualifies a candidate unconditionally.
static _dsp_prescan_body_has_nested_loop(wh_p) {
    auto (wh): Node;
    auto i, body_arr, body_cnt;
    wh = wh_p;
    body_arr = wh.b;
    body_cnt = wh.c;
    for (i = 0; i < body_cnt; i++) {
        if (_dsp_subtree_has_nested_loop(body_arr[i])) { return 1; }
    }
    return 0;
}

// Returns the funcs[] index of the first `@safe` function containing
// a top-level loop matching the shape above, or -1 if none qualifies.
// `fn_phase_hint` is populated by the PARSER at parse time (the
// `@safe` annotation itself), so it is already valid here — no
// analysis pass has to run first. The caller needs the INDEX (not
// just a yes/no) so it can find where main() first calls this
// specific host and inject the freeze marker right there — see
// `prescan_inject_job_init`'s own header comment for why position
// matters.
static _dsp_prescan_find_safe_loop_host() {
    auto i, fn_rec, body_arr, body_cnt, j, stmt: Node;
    for (i = 0; i < func_cnt; i++) {
        if (arr_get(fn_phase_hint, i) != PHASE_SAFE) { continue; }
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);
        if (body_arr == 0) { continue; }
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) {
                if (stmt.ntype == T_WHILE) {
                    if (_dsp_prescan_loop_shape_ok(stmt)) { return i; }
                }
            }
        }
    }
    return -1;
}

// True if `nd`'s expression subtree contains a direct call to the
// function named `target_name_p`, anywhere within it — covers a bare
// expression-statement call, a call nested inside an assignment's
// right-hand side, inside a binop, inside a condition, etc. Used to
// find the first top-level statement in main() that actually invokes
// a dispatch-candidate host, so the injected job_init lands right
// before real usage starts instead of before the program's own setup
// work (see `prescan_inject_job_init`).
static _dsp_subtree_calls_fn(nd, target_name_p) {
    auto (n): Node;
    auto t, i, arr, cnt;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        if (packed_eq(n.a, target_name_p)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_calls_fn(arr[i], target_name_p)) { return 1; }
        }
        return 0;
    }
    if (t == T_ASSIGN) {
        if (_dsp_subtree_calls_fn(n.a, target_name_p)) { return 1; }
        return _dsp_subtree_calls_fn(n.b, target_name_p);
    }
    if (t == T_BINOP) {
        if (_dsp_subtree_calls_fn(n.b, target_name_p)) { return 1; }
        return _dsp_subtree_calls_fn(n.c, target_name_p);
    }
    if (t == T_TERNARY) {
        if (_dsp_subtree_calls_fn(n.a, target_name_p)) { return 1; }
        if (_dsp_subtree_calls_fn(n.b, target_name_p)) { return 1; }
        return _dsp_subtree_calls_fn(n.c, target_name_p);
    }
    if (t == T_UNARY) { return _dsp_subtree_calls_fn(n.b, target_name_p); }
    if (t == T_MEMLD) { return _dsp_subtree_calls_fn(n.a, target_name_p); }
    if (t == T_MEMST) {
        if (_dsp_subtree_calls_fn(n.a, target_name_p)) { return 1; }
        return _dsp_subtree_calls_fn(n.b, target_name_p);
    }
    if (t == T_ADDR) { return _dsp_subtree_calls_fn(n.a, target_name_p); }
    if (t == T_RET)  { return _dsp_subtree_calls_fn(n.a, target_name_p); }
    if (t == T_IF) {
        if (_dsp_subtree_calls_fn(n.a, target_name_p)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_calls_fn(arr[i], target_name_p)) { return 1; }
        }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (_dsp_subtree_calls_fn(arr[i], target_name_p)) { return 1; }
            }
        }
        return 0;
    }
    if (t == T_WHILE) {
        if (_dsp_subtree_calls_fn(n.a, target_name_p)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_calls_fn(arr[i], target_name_p)) { return 1; }
        }
        if (n.e != 0) { return _dsp_subtree_calls_fn(n.e, target_name_p); }
        return 0;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_dsp_subtree_calls_fn(arr[i], target_name_p)) { return 1; }
        }
        return 0;
    }
    return 0;
}

// True if `main_idx`'s CURRENT body already contains a top-level call
// to maestro_run / maestro_configure / job_init — the program manages
// its own freeze point and this prescan must leave it alone. job_init
// is idempotent, but injecting AHEAD of a deliberate non-default
// `job_init(N)` / `maestro_configure(...)` call would silently make
// OUR call win the race and discard the program's own worker-count
// choice.
static _dsp_main_already_has_freeze_call(main_idx) {
    auto fn_rec, body_arr, body_cnt, j, stmt: Node, name_p, l;
    fn_rec = funcs[main_idx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    if (body_arr == 0) { return 0; }
    for (j = 0; j < body_cnt; j++) {
        stmt = body_arr[j];
        if (stmt != 0) {
            if (stmt.ntype == T_CALL) {
                name_p = stmt.a;
                l = unpack_l(name_p);
                if (l == 11) {
                    if (buf_eq(vbuf + unpack_s(name_p), "maestro_run", 11)) { return 1; }
                }
                if (l == 17) {
                    if (buf_eq(vbuf + unpack_s(name_p), "maestro_configure", 17)) { return 1; }
                }
                if (l == 8) {
                    if (buf_eq(vbuf + unpack_s(name_p), "job_init", 8)) { return 1; }
                }
            }
        }
    }
    return 0;
}

// Finds main()'s funcs[] slot independently of `_dsp_main_idx` (which
// `call_graph_build`, called right after this prescan, has not set
// yet — this prescan must run standalone, before anything else).
static _dsp_prescan_find_main_idx() {
    auto i, fname;
    for (i = 0; i < func_cnt; i++) {
        fname = *(funcs[i] + FN_NAME);
        if (unpack_l(fname) == 4) {
            if (buf_eq(vbuf + unpack_s(fname), "main", 4)) { return i; }
        }
    }
    return -1;
}

// The T_CALL node the prescan injected into main, so the end of
// dispatch can NEUTRALIZE it (flip to T_NOP) when no candidate ever
// turned into a worker-pool call. The prescan's own gate (any @safe
// loop host exists) is deliberately weaker than the real outline
// gates that run later, so a binary full of @safe DSP helpers that
// outlines NOTHING used to start 4 worker threads it never submits
// to — pure waste on macOS and a startup crash on the Linux target,
// whose thread infra is the documented not-yet-ported piece (the
// "concurrency-infra-macos-only" suite-skip family; found hunting
// test_dsp_param_safety's nondeterministic x64/Rosetta segfault).
// 0 = prescan injected nothing (user has an explicit freeze call, or
// no @safe host exists).
global _dsp_prescan_ji_node;

// Entry point — called once, right before `call_graph_build`, from
// both the modular and monolithic pipelines in bpp.bpp.
void prescan_inject_job_init() {
    auto main_idx, ji_idx, ji_name, fn_rec, body_arr, body_cnt, new_body, i;
    auto call_node: Node, args_arr, lit_n: Node;
    auto host_idx, host_name, insert_at, stmt: Node;

    main_idx = _dsp_prescan_find_main_idx();
    if (main_idx < 0) { return; }
    if (_dsp_main_already_has_freeze_call(main_idx)) { return; }

    host_idx = _dsp_prescan_find_safe_loop_host();
    if (host_idx < 0) { return; }

    ji_name = _dsp_pack_name("job_init", 8);
    ji_idx = _dsp_find_func_idx(ji_name);
    if (ji_idx < 0) { return; }   // bpp_job.bsm somehow absent — nothing to call

    lit_n = _dsp_make_int_lit(_DSP_DEFAULT_WORKERS);
    args_arr = malloc(8);
    *(args_arr) = lit_n;
    call_node = make_node(T_CALL);
    call_node.a = ji_name;
    call_node.b = args_arr;
    call_node.c = 1;

    fn_rec = funcs[main_idx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);

    // Find the first top-level statement in main() that calls the
    // dispatch-candidate host (directly, or nested inside an
    // expression), and insert job_init immediately BEFORE it — not
    // before everything. promote_globals's Rule 3 needs main()'s own
    // setup writes (allocations, etc.) that run earlier to still
    // count as "pre-freeze"; injecting at position 0 unconditionally
    // would push those writes into the "post-freeze" bucket instead
    // and defeat the exact promotion this feature exists to unlock.
    // Falls back to position 0 only when the host is never called
    // from a top-level statement in main (called indirectly, nested
    // deeper, via fn_ptr, or unreachable from main directly) — still
    // strictly better than not injecting at all.
    host_name = *(funcs[host_idx] + FN_NAME);
    insert_at = 0;
    for (i = 0; i < body_cnt; i++) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (_dsp_subtree_calls_fn(stmt, host_name)) {
                insert_at = i;
                i = body_cnt;
            }
        }
    }

    new_body = malloc((body_cnt + 1) * 8);
    for (i = 0; i < insert_at; i++) {
        *(new_body + i * 8) = body_arr[i];
    }
    *(new_body + insert_at * 8) = call_node;
    for (i = insert_at; i < body_cnt; i++) {
        *(new_body + (i + 1) * 8) = body_arr[i];
    }
    *(fn_rec + FN_BODY) = new_body;
    *(fn_rec + FN_BCNT) = body_cnt + 1;
    // Remember the injected node so the end of dispatch can neutralize
    // it when nothing ever outlines (see _dsp_prescan_ji_node's header).
    _dsp_prescan_ji_node = call_node;
    // No fn_calls edge-wiring here on purpose: call_graph_build's own
    // per-function walk (which runs right after this returns) will
    // visit the injected call naturally while it walks main()'s body
    // for the first time, exactly as if the programmer had written it.
}

// Build the call graph for every parsed function. Populates fn_calls[],
// fn_address_taken[], fn_locally_impure[] in lockstep with funcs[].
// ALSO populates the per-global use-def arrays (glob_writers, glob_readers)
// from the same AST walk so the promoter has everything it needs.
// Cached functions get default empty entries — their classification will
// come from the .bo cache.
call_graph_build() {
    auto i, j, k, fn_rec, params_arr, param_cnt, body_arr, body_cnt;
    auto stmt: Node, darr, dcnt, addr_idx, fname;

    // Grow per-function arrays to match func_cnt.
    while (arr_len(fn_phase) < func_cnt) {
        fn_phase = arr_push(fn_phase, PHASE_AUTO);
        fn_phase_next = arr_push(fn_phase_next, PHASE_AUTO);
        fn_calls = arr_push(fn_calls, 0);
        fn_address_taken = arr_push(fn_address_taken, 0);
        fn_locally_impure = arr_push(fn_locally_impure, 0);
        fn_reachable = arr_push(fn_reachable, 0);
        fn_phase_hint = arr_push(fn_phase_hint, 0);
        fn_ret_hint   = arr_push(fn_ret_hint, 0);
        fn_ret_arity  = arr_push(fn_ret_arity, 1);
        fn_ret_types  = arr_push(fn_ret_types, 0);
        fn_vt_locs    = arr_push(fn_vt_locs, 0);
        fn_effect = arr_push(fn_effect, PHASE_AUTO);
        fn_effect_next = arr_push(fn_effect_next, PHASE_AUTO);
        fn_max_call_loop_depth = arr_push(fn_max_call_loop_depth, 0);
        fn_hot_transitive = arr_push(fn_hot_transitive, 0);
    }
    // Reset for re-runs (bootstrap recompiles call_graph_build more than
    // once) — direct call-site loop depth is read fresh from `_cgb_walk`
    // below every time, so stale max-from-a-previous-run must not linger.
    for (i = 0; i < func_cnt; i++) {
        arr_set(fn_max_call_loop_depth, i, 0);
        arr_set(fn_hot_transitive, i, 0);
    }

    // Grow per-global arrays to match glob_cnt. Each slot is its own arr<int>.
    while (arr_len(glob_writers) < glob_cnt) {
        glob_writers = arr_push(glob_writers, arr_new());
        glob_readers = arr_push(glob_readers, arr_new());
        glob_writes_pre = arr_push(glob_writes_pre, 0);
        glob_writes_post = arr_push(glob_writes_post, 0);
        glob_promote_reason = arr_push(glob_promote_reason, 0);
    }
    // Reset use-def edges for re-runs (but keep allocated arr objects).
    for (i = 0; i < glob_cnt; i++) {
        arr_clear(arr_get(glob_writers, i));
        arr_clear(arr_get(glob_readers, i));
        arr_set(glob_writes_pre, i, 0);
        arr_set(glob_writes_post, i, 0);
        arr_set(glob_promote_reason, i, 0);
    }

    // Reset address-taken accumulator. Populated during the per-function walks.
    if (_cgb_addr_taken_set == 0) { _cgb_addr_taken_set = arr_new(); }
    else { arr_clear(_cgb_addr_taken_set); }

    // Find main()'s function index for the freeze-point analysis below.
    _dsp_main_idx = -1;
    for (i = 0; i < func_cnt; i++) {
        fname = *(funcs[i] + FN_NAME);
        if (unpack_l(fname) == 4) {
            if (peek(vbuf + unpack_s(fname) + 0) == 'm') {
                if (peek(vbuf + unpack_s(fname) + 1) == 'a') {
                    if (peek(vbuf + unpack_s(fname) + 2) == 'i') {
                        if (peek(vbuf + unpack_s(fname) + 3) == 'n') {
                            _dsp_main_idx = i;
                        }
                    }
                }
            }
        }
    }

    for (i = 0; i < func_cnt; i++) {
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);

        // Skip cached functions — they have no AST to walk. Their
        // classification will be loaded from the .bo cache.
        if (body_arr == 0) {
            arr_set(fn_calls, i, 0);
            arr_set(fn_locally_impure, i, 0);
            continue;
        }

        params_arr = *(fn_rec + FN_PARS);
        param_cnt = *(fn_rec + FN_PCNT);

        // Set up locals scope for this function: parameters + auto declarations.
        dsp_reset_locals();
        for (j = 0; j < param_cnt; j++) {
            dsp_add_local(params_arr[j]);
        }
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) {
                if (stmt.ntype == T_DECL) {
                    darr = stmt.a;
                    dcnt = stmt.b;
                    for (k = 0; k < dcnt; k++) {
                        dsp_add_local(darr[k]);
                    }
                }
            }
        }

        // Initialize per-function accumulators for this walk.
        _cgb_calls = arr_new();
        _cgb_impure = 0;
        _cgb_ext_eff = PHASE_BASE;
        _cgb_current_fn_idx = i;
        _fn_origin_clear_for(i);
        _fn_reg_clear_for(i);

        // Walk every statement in the body.
        for (j = 0; j < body_cnt; j++) {
            _cgb_walk(body_arr[j]);
        }

        arr_set(fn_calls, i, _cgb_calls);
        arr_set(fn_locally_impure, i, _cgb_impure);

        // (A dead "annotation-driven GPU seed" lived here until the
        // 2026-07-07 cleanup: it read fn_phase_hint looking for
        // PHASE_GPU, but since the 2026-05-11 phase collapse the parser
        // only ever produces 0 or the `@safe` hint, so the branch could
        // not fire. GPU effects remain internal lattice values seeded by
        // registered extern names, never by annotation.)
        arr_set(fn_effect, i, _cgb_ext_eff);
    }

    // Apply the address-taken set to fn_address_taken[].
    for (i = 0; i < arr_len(_cgb_addr_taken_set); i++) {
        addr_idx = arr_get(_cgb_addr_taken_set, i);
        if (addr_idx >= 0) {
            arr_set(fn_address_taken, addr_idx, 1);
        }
    }

    // V3 Session 4 Pass B — cross-function flow capture. Pass A (the
    // per-function `_cgb_walk` loop above) populated `_fn_reg_*` for
    // every registration helper. Pass B inverts `fn_calls` into
    // `_fn_callers`, then for each registration helper walks all its
    // callers' bodies to record `fn_ptr` origins flowing through.
    // The order is locked: Pass B never starts until Pass A finishes
    // for ALL functions, so no helper is examined before all its
    // own registrations have been recorded.
    _dsp_build_callers();
    _dsp_build_hot_transitive();
    for (i = 0; i < func_cnt; i++) {
        if (dsp_is_reg_helper(i)) { _glob_origins_capture(i); }
    }

    // Second pass: walk main()'s body sequentially to detect writes
    // before vs after the freeze point (first call to maestro_run /
    // maestro_configure / job_init). Conservative: only top-level
    // statements in main are inspected, helpers are not traced.
    if (_dsp_main_idx >= 0) {
        _dsp_walk_main_for_freeze();
    }

    return 0;
}

// ── Freeze-point walker for main() ────────────────────────
//
// Walks the top-level statements of main() in source order, flipping a
// freeze flag the first time we see a call to maestro_run/maestro_configure/
// job_init. For every assignment to a global, we count it as either a
// "pre-freeze" or "post-freeze" write. The promoter then uses this to
// decide whether a global is eligible for extrn promotion.
//
// Conservative scope: only TOP-LEVEL statements of main are traced. Writes
// inside helper functions called from main are NOT counted here — those
// helpers run their own _cgb_walk pass that records into glob_writers but
// without freeze position info. The promoter conservatively rejects extrn
// promotion in those cases (any helper writer = stay auto).
static void _dsp_walk_main_for_freeze() {
    auto fn_rec, body_arr, body_cnt, j, stmt: Node, lhs: Node;
    auto frozen, gi, name_p, ts;
    fn_rec = funcs[_dsp_main_idx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    frozen = 0;
    for (j = 0; j < body_cnt; j++) {
        stmt = body_arr[j];
        if (stmt == 0) { continue; }
        // Detect freeze point: a top-level T_CALL whose name is one of
        // maestro_run / maestro_configure / job_init.
        if (stmt.ntype == T_CALL) {
            name_p = stmt.a;
            if (unpack_l(name_p) == 11) {
                ts = vbuf + unpack_s(name_p);
                if (peek(ts) == 'm') {
                    if (peek(ts + 1) == 'a') {
                        if (peek(ts + 2) == 'e') {
                            // maestro_run
                            frozen = 1;
                            _dsp_has_freeze = 1;
                        }
                    }
                }
            }
            if (unpack_l(name_p) == 17) {
                ts = vbuf + unpack_s(name_p);
                if (peek(ts) == 'm') {
                    if (peek(ts + 1) == 'a') {
                        if (peek(ts + 2) == 'e') {
                            // maestro_configure
                            frozen = 1;
                            _dsp_has_freeze = 1;
                        }
                    }
                }
            }
            if (unpack_l(name_p) == 8) {
                ts = vbuf + unpack_s(name_p);
                if (peek(ts) == 'j') {
                    if (peek(ts + 1) == 'o') {
                        if (peek(ts + 2) == 'b') {
                            if (peek(ts + 3) == '_') {
                                if (peek(ts + 4) == 'i') {
                                    // job_init
                                    frozen = 1;
                                    _dsp_has_freeze = 1;
                                }
                            }
                        }
                    }
                }
            }
        }
        // Detect a top-level assignment to a global.
        if (stmt.ntype == T_ASSIGN) {
            lhs = stmt.a;
            if (lhs != 0) {
                if (lhs.ntype == T_VAR) {
                    gi = dsp_find_global(lhs.a);
                    if (gi >= 0) {
                        auto wbucket;
                        wbucket = frozen ? glob_writes_post : glob_writes_pre;
                        arr_set(wbucket, gi, arr_get(wbucket, gi) + 1);
                    }
                }
            }
        }
    }
}

// ── Per-function purity classification (fixpoint) ──────────
//
// Double-buffered fixpoint iteration over the call graph. Each pass
// reads fn_phase[] and writes fn_phase_next[], then swaps. Convergence
// is guaranteed in O(call-chain-depth) passes because the lattice has
// height 1: PHASE_BASE → PHASE_SOLO is the only transition, no upgrade.
//
// Initial state: every function starts at PHASE_BASE (optimistic).
// On each pass, a function is downgraded to PHASE_SOLO if either:
//   - it has local impurity (locally_impure[i] == 1), or
//   - any callee is currently PHASE_SOLO
// Mutual recursion stays at PHASE_BASE if neither member has local
// impurity. Address-taken functions are NOT automatically downgraded —
// the loop classifier handles indirect-call safety separately.
//
// Cached functions (body_arr == 0) keep their current fn_phase[] value
// — set elsewhere by .bo loading once that format extension lands.
classify_all_functions() {
    auto i, j, callees, n_callees, callee_idx;
    auto changed, iter, max_iter, fn_rec, body_arr;

    // Init: all fresh-parsed functions start at PHASE_BASE. Cached
    // functions keep whatever fn_phase[] already holds (PHASE_AUTO if
    // the cache extension isn't live yet).
    for (i = 0; i < func_cnt; i++) {
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        if (body_arr != 0) {
            arr_set(fn_phase, i, PHASE_BASE);
        }
    }

    // Fixpoint loop. Cap iterations at func_cnt+1 as a safety net —
    // convergence is guaranteed faster than that, but the cap prevents
    // an infinite loop if the call graph somehow has a bug.
    max_iter = func_cnt + 1;
    iter = 0;
    changed = 1;
    while (changed != 0) {
        if (iter >= max_iter) { return 0; }
        iter++;
        changed = 0;

        // Pass: write to fn_phase_next based on current fn_phase.
        for (i = 0; i < func_cnt; i++) {
            fn_rec = funcs[i];
            body_arr = *(fn_rec + FN_BODY);
            // Cached function: copy through, don't touch.
            if (body_arr == 0) {
                arr_set(fn_phase_next, i, arr_get(fn_phase, i));
                continue;
            }
            // Local impurity → SOLO. No need to look at callees.
            if (arr_get(fn_locally_impure, i) != 0) {
                arr_set(fn_phase_next, i, PHASE_SOLO);
                continue;
            }
            // No callees → trivially BASE.
            callees = arr_get(fn_calls, i);
            if (callees == 0) {
                arr_set(fn_phase_next, i, PHASE_BASE);
                continue;
            }
            // Otherwise, check if any callee is currently SOLO.
            n_callees = arr_len(callees);
            auto found_solo;
            found_solo = 0;
            for (j = 0; j < n_callees; j++) {
                callee_idx = arr_get(callees, j);
                if (arr_get(fn_phase, callee_idx) == PHASE_SOLO) {
                    found_solo = 1;
                    j = n_callees;
                }
            }
            arr_set(fn_phase_next, i, found_solo != 0 ? PHASE_SOLO : PHASE_BASE);
        }

        // Swap buffers and check for changes.
        for (i = 0; i < func_cnt; i++) {
            if (arr_get(fn_phase, i) != arr_get(fn_phase_next, i)) {
                changed = 1;
            }
            arr_set(fn_phase, i, arr_get(fn_phase_next, i));
        }
    }

    // W013 (`@base` mismatch) was retired in the 2026-05-11 phase
    // collapse. The parser no longer accepts `@base`, so phase_hint
    // can never equal PHASE_BASE — the diagnostic block that lived
    // here was dead code. Internal BASE/SOLO classification still
    // runs (the fixpoint above) for inline / parallel-candidate
    // decisions; it just doesn't drive a user-facing warning.

    // Level 4 sub-step B — effect lattice fixpoint. fn_effect[i] was
    // seeded during call_graph_build with the joined effect of the
    // externs that i calls directly. This pass propagates callee
    // effects up the call graph until the lattice stabilizes, so
    // every function's fn_effect reflects the worst thing it can
    // eventually reach. No enforcement yet — sub-step C turns this
    // into call-site warnings.
    changed = 1;
    iter = 0;
    while (changed != 0) {
        if (iter >= max_iter) { iter = max_iter; changed = 0; }
        else {
            iter++;
            changed = 0;
            for (i = 0; i < func_cnt; i++) {
                auto eff, callees2, nc2, k, ce;
                eff = arr_get(fn_effect, i);
                callees2 = arr_get(fn_calls, i);
                if (callees2 != 0) {
                    nc2 = arr_len(callees2);
                    for (k = 0; k < nc2; k++) {
                        ce = arr_get(fn_effect, arr_get(callees2, k));
                        eff = _dsp_eff_join(eff, ce);
                    }
                }
                arr_set(fn_effect_next, i, eff);
            }
            for (i = 0; i < func_cnt; i++) {
                if (arr_get(fn_effect, i) != arr_get(fn_effect_next, i)) {
                    changed = 1;
                }
                arr_set(fn_effect, i, arr_get(fn_effect_next, i));
            }
        }
    }

    // W026 — `@safe` contract enforcement. The annotation claims the
    // function is bounded-time and side-effect-free (no malloc, no IO,
    // no GPU, no syscall). The fixpoint above computed `fn_effect[i]`
    // — the worst effect reachable through the call graph. If the
    // effect lands anywhere above BASE in the lattice, the contract
    // is broken.
    //
    // Killer use case: audio callbacks (e.g. `_aud_square_cb` in
    // `_stb_audio_macos.bsm`) and worker thread entry points — places
    // where a latent malloc or syscall would manifest as an audible
    // glitch or a race. The `@safe` annotation turns "I trust the
    // programmer wrote this carefully" into "the compiler proved it."
    //
    // The legacy `@time` / `@io` / `@gpu` enforcement clauses that
    // lived here were retired in the 2026-05-11 phase collapse. The
    // parser no longer produces those phase_hint values.
    for (i = 0; i < func_cnt; i++) {
        auto _h, _e, _name;
        _h = arr_get(fn_phase_hint, i);
        if (_h != PHASE_SAFE) { continue; }
        _e = arr_get(fn_effect, i);
        if (_e == PHASE_BASE) { continue; }
        if (_e == PHASE_REALTIME) { continue; }
        if (_e == PHASE_AUTO) { continue; }
        _name = _e == PHASE_IO   ? "IO"
              : _e == PHASE_GPU  ? "GPU"
              : _e == PHASE_HEAP ? "HEAP"
              : _e == PHASE_SOLO ? "SOLO"
              : "BASE";
        diag_warn(26);
        diag_str("'");
        diag_packed(*(funcs[i] + FN_NAME));
        diag_str("' annotated '@safe' but reaches ");
        diag_str(_name);
        diag_str(" through its call graph");
        diag_newline();
        diag_loc(*(funcs[i] + FN_SRC_TOK));
        diag_show_line(*(funcs[i] + FN_SRC_TOK));
    }

    return 0;
}

// ── Lazy emit: mark reachable functions ─────────────────────
//
// BFS from main() over fn_calls[] edges. A function is reachable if
// main (transitively) calls it or takes its address via fn_ptr().
// After this pass, fn_reachable[i] == 1 for every function the binary
// actually needs. The codegen bridge skips unreachable functions,
// producing a smaller binary without dead auto-injected module code.
mark_reachable() {
    auto queue, head, tail, i, j, fi, callees, n;
    if (_dsp_main_idx < 0) { return 0; }

    // Reset all to unreachable.
    for (i = 0; i < func_cnt; i++) {
        arr_set(fn_reachable, i, 0);
    }

    // BFS queue (max size = func_cnt).
    queue = buf_word(func_cnt);
    head = 0; tail = 0;

    // Seed: main is reachable.
    arr_set(fn_reachable, _dsp_main_idx, 1);
    queue[tail] = _dsp_main_idx;
    tail++;

    // Also seed all address-taken functions — they may be called
    // indirectly via fn_ptr and there's no call edge to follow.
    for (i = 0; i < func_cnt; i++) {
        if (arr_get(fn_address_taken, i) != 0) {
            if (arr_get(fn_reachable, i) == 0) {
                arr_set(fn_reachable, i, 1);
                queue[tail] = i;
                tail++;
            }
        }
    }

    // BFS: follow fn_calls edges.
    while (head < tail) {
        fi = queue[head];
        head++;
        callees = arr_get(fn_calls, fi);
        if (callees != 0) {
            n = arr_len(callees);
            for (j = 0; j < n; j++) {
                i = arr_get(callees, j);
                if (arr_get(fn_reachable, i) == 0) {
                    arr_set(fn_reachable, i, 1);
                    queue[tail] = i;
                    tail++;
                }
            }
        }
    }

    free(queue);
    _lazy_emit_ready = 1;

    return 0;
}

// ── Smart promotion (auto → extrn / global) ────────────────
//
// For every top-level `auto x;` declaration, decide whether the compiler
// can safely promote it to a more specific storage class. The decision
// is conservative: any uncertainty falls back to legacy serialized auto.
//
// Promotion rules:
//   1. Skip if user already wrote `global x;` or `extrn x;` (glob_class[i] != GLOB_AUTO).
//   2. Promote to GLOB_EXTRN when:
//      - All writers are inside main() (no helper writes), AND
//      - There is at least one write before the freeze point in main(), AND
//      - There are zero writes after the freeze point.
//      Conservative: misses init helpers like `init_world()` called from main.
//      The user can always fall back to explicit `extrn x;` for those.
//   3. Promote to GLOB_GLOBAL when:
//      - Any writer or reader is inside a function classified as PHASE_BASE
//        (the function runs on a worker thread), AND
//      - The variable was not eligible for extrn (mutually exclusive choice).
//   4. Otherwise: leave as GLOB_AUTO.
//
// The promoter writes a string code into glob_promote_reason[i] for the
// --show-promotions flag to print. Empty string means no promotion.
promote_globals() {
    auto i, j, writers, n_writers, w_idx, all_in_main;
    auto pre, post, total, helper_writes;
    auto readers, n_readers, r_idx, found_base;
    auto _pg_promoted;
    _pg_promoted = 0;


    for (i = 0; i < glob_cnt; i++) {
        // Rule 1: skip already-explicit storage classes. (The old
        // `: serial` pin — Rule 1 until the 2026-07-07 storage
        // cleanup — had zero uses and was removed; explicit `global`
        // / `extrn` are the ways to opt out of promotion.)
        if (arr_get(glob_class, i) != GLOB_AUTO) { continue; }

        writers = arr_get(glob_writers, i);
        readers = arr_get(glob_readers, i);
        n_writers = arr_len(writers);
        n_readers = arr_len(readers);
        pre = arr_get(glob_writes_pre, i);
        post = arr_get(glob_writes_post, i);

        // Rule 3: extrn eligibility — all writes in main, before freeze.
        // Only applies if the program HAS a freeze point (maestro_run/job_init).
        // Without one, every write is trivially "pre-freeze" → false positives.
        if (_dsp_main_idx >= 0) {
            if (_dsp_has_freeze == 0) { all_in_main = 0; }
            if (_dsp_has_freeze != 0) { all_in_main = 1; }
            helper_writes = 0;
            for (j = 0; j < n_writers; j++) {
                w_idx = arr_get(writers, j);
                // Check if this writer is a main() function (compare by name,
                // not index, because B++ can have multiple main entries in funcs[]
                // from forward-declaration overrides in different modules).
                auto _wfn, _wn;
                _wfn = funcs[w_idx];
                _wn = *(_wfn + FN_NAME);
                if (packed_eq(_wn, *(funcs[_dsp_main_idx] + FN_NAME)) == 0) {
                    all_in_main = 0;
                    helper_writes++;
                }
            }
            if (all_in_main != 0) {
                if (pre > 0) {
                    if (post == 0) {
                        arr_set(glob_class, i, GLOB_EXTRN);
                        arr_set(glob_promote_reason, i, 1);
                        _pg_promoted++;
                        continue;
                    }
                }
            }
        }

        // Rule 4: global eligibility — any worker function reads or writes.
        found_base = 0;
        for (j = 0; j < n_writers; j++) {
            w_idx = arr_get(writers, j);
            if (w_idx >= 0) {
                if (arr_get(fn_phase, w_idx) == PHASE_BASE) { found_base = 1; }
            }
        }
        for (j = 0; j < n_readers; j++) {
            r_idx = arr_get(readers, j);
            if (r_idx >= 0) {
                if (arr_get(fn_phase, r_idx) == PHASE_BASE) { found_base = 1; }
            }
        }
        if (found_base != 0) {
            arr_set(glob_class, i, GLOB_GLOBAL);
            arr_set(glob_promote_reason, i, 2);
            _pg_promoted++;
            continue;
        }

        // Rule 5: stay auto.
    }

    // W014: deferred — needs investigation. The check crashes the self-host
    // even when _dsp_has_freeze is 0 (which should skip the block). Possibly
    // a variable scope or initialization order issue in promote_globals.
    // The show_promotions diagnostic already shows pre/post counts so the
    // programmer can manually verify freeze violations for now.

    return _pg_promoted;
}

// ── Module-private data: distinct slots for same-named `static` globals ──
//
// `static` on a top-level variable promises "private to my module". The
// codegen resolves and dedups globals BY NAME (cg_bridge_data, emit_*_global),
// so two same-named globals in different modules would otherwise share one data
// slot — a silent alias, the shape of the cross-target constant bug of the past.
// To honour the privacy promise, a `static` global whose name COLLIDES with a
// different-module global is given a unique mangled name, and every reference to
// it WITHIN its own module is rewritten to that name (references from other
// modules cannot see it — that is the privacy). Non-colliding statics are left
// untouched, so a program with no collisions is byte-identical.
//
// Parallel map over the colliding statics only: original name, defining module,
// the globals[] index, and the mangled unique name.
static auto _mpg_orig;      // arr: original packed name
static auto _mpg_mod;       // arr: defining module index
static auto _mpg_idx;       // arr: index into globals[]
static auto _mpg_mangled;   // arr: mangled packed name

// Build a mangled packed name `<orig>__mp<mod>` in vbuf. C-safe (only
// [A-Za-z0-9_]) so the C emitter can use it as an identifier, and the `__mp`
// infix keeps it out of hand-written namespaces (like `__synth_`).
static _mpg_make_name(orig, mod) {
    auto start, olen, osrc, i, tmp, digits;
    start = vbuf_pos;
    olen = unpack_l(orig);
    osrc = vbuf + unpack_s(orig);
    for (i = 0; i < olen; i++) { poke(vbuf + vbuf_pos, peek(osrc + i)); vbuf_pos++; }
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'm'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'p'); vbuf_pos++;
    tmp = mod;
    if (tmp == 0) {
        poke(vbuf + vbuf_pos, '0'); vbuf_pos++;
    } else {
        digits = 0;
        while (tmp > 0) { digits++; tmp /= 10; }
        vbuf_pos += digits;
        tmp = mod;
        for (i = 0; i < digits; i++) {
            poke(vbuf + vbuf_pos - 1 - i, '0' + tmp % 10);
            tmp /= 10;
        }
    }
    return pack(start, vbuf_pos - start);
}

// Detect module-private globals whose name collides with a different-module
// global, mangle their DEFINITIONS, and record the mapping for reference
// rewriting. Runs once BEFORE call_graph_build (which rewrites the references
// as it walks). Two phases so collisions are detected on the ORIGINAL names
// before any name is mutated: both sides of a static-vs-static collision get
// mangled. O(n^2) but one-shot; the common case (no collisions) exits with
// three empty arrays and the resolver below short-circuits.
mangle_private_globals() {
    auto i, j, collides;
    _mpg_orig = arr_new(); _mpg_mod = arr_new();
    _mpg_idx = arr_new();  _mpg_mangled = arr_new();
    // Phase 1: detect (on original names, no mutation yet).
    for (i = 0; i < glob_cnt; i++) {
        if (arr_get(glob_static, i) == 0) { continue; }
        collides = 0;
        for (j = 0; j < glob_cnt; j++) {
            if (j == i) { continue; }
            if (packed_eq(arr_get(globals, i), arr_get(globals, j)) == 0) { continue; }
            if (arr_get(glob_mods, j) == arr_get(glob_mods, i)) { continue; }
            collides = 1;
            break;
        }
        if (collides == 0) { continue; }
        _mpg_orig    = arr_push(_mpg_orig,    arr_get(globals, i));
        _mpg_mod     = arr_push(_mpg_mod,     arr_get(glob_mods, i));
        _mpg_idx     = arr_push(_mpg_idx,     i);
        _mpg_mangled = arr_push(_mpg_mangled, _mpg_make_name(arr_get(globals, i), arr_get(glob_mods, i)));
    }
    // Phase 2: rewrite the definitions to the mangled names.
    for (i = 0; i < arr_len(_mpg_idx); i++) {
        arr_set(globals, arr_get(_mpg_idx, i), arr_get(_mpg_mangled, i));
    }
    return 0;
}

// Reference resolver, called from _cgb_walk at each global-reference site. If
// `name_p` names a colliding module-private global DEFINED in the current
// function's module, return its mangled name (the caller rewrites the AST node);
// otherwise return `name_p` unchanged. The fast path (no collisions in the whole
// program) is a single length check.
_mpg_resolve(name_p) {
    auto k, mod;
    if (_mpg_orig == 0) { return name_p; }
    if (arr_len(_mpg_orig) == 0) { return name_p; }
    mod = arr_get(func_mods, _cgb_current_fn_idx);
    for (k = 0; k < arr_len(_mpg_orig); k++) {
        if (arr_get(_mpg_mod, k) != mod) { continue; }
        if (packed_eq(arr_get(_mpg_orig, k), name_p)) { return arr_get(_mpg_mangled, k); }
    }
    return name_p;
}

// Print a human-readable summary of the auto-promotion decisions to stderr.
// Only emits non-empty reasons. Called by bpp.bpp when --show-promotions is set.
// Print a detailed breakdown of the smart promotion pass to stderr.
// Two sections:
//   1. Scan summary: how many globals, which are writable, pre/post counts.
//      Helps diagnose "why wasn't my variable promoted?".
//   2. Promotion results: which globals were promoted and to what class.
show_promotions() {
    auto i, reason, name_p, writers, n_writers, pre, post;

    // Section 1: scan summary. Lists every GLOB_AUTO variable that has
    // any writers, with their pre/post freeze counts. Variables with no
    // writers are pure reads and can't be promoted to extrn (nothing to freeze).
    // Count reachable functions for the diagnostic.
    auto _r_cnt, _t;
    _r_cnt = 0;
    for (_t = 0; _t < func_cnt; _t++) {
        if (arr_get(fn_reachable, _t)) { _r_cnt++; }
    }
    diag_str("[lazy] ");
    diag_int(_r_cnt);
    diag_str("/");
    diag_int(func_cnt);
    diag_str(" functions reachable");
    diag_newline();
    diag_str("[promote] ");
    diag_int(glob_cnt);
    diag_str(" globals, main_idx=");
    diag_int(_dsp_main_idx);
    diag_newline();
    for (i = 0; i < glob_cnt; i++) {
        // Show auto globals with at least one writer — those are the
        // candidates the promoter evaluated.
        if (arr_get(glob_class, i) == GLOB_AUTO) {
            writers = arr_get(glob_writers, i);
            n_writers = arr_len(writers);
            if (n_writers > 0) {
                pre = arr_get(glob_writes_pre, i);
                post = arr_get(glob_writes_post, i);
                diag_str("  ");
                diag_packed(arr_get(globals, i));
                diag_str(": writers=");
                diag_int(n_writers);
                diag_str(" [");
                auto _wi;
                for (_wi = 0; _wi < n_writers; _wi++) {
                    if (_wi > 0) { diag_str(","); }
                    diag_int(arr_get(writers, _wi));
                }
                diag_str("] pre=");
                diag_int(pre);
                diag_str(" post=");
                diag_int(post);
                diag_newline();
            }
        }
    }

    // Section 2: promotion results. Only emits lines for globals that
    // were actually promoted (reason != 0). This is the TL;DR the user
    // looks at first — the scan summary above is for debugging surprises.
    for (i = 0; i < glob_cnt; i++) {
        reason = arr_get(glob_promote_reason, i);
        if (reason == 0) { continue; }
        diag_str("  ");
        diag_packed(arr_get(globals, i));
        diag_str(" -> ");
        if (reason == 1) { diag_str("extrn"); }
        if (reason == 2) { diag_str("global"); }
        diag_newline();
    }
    return 0;
}

// ── Phase 2: smart dispatch loop synthesis (Stage 1 scanner) ──
//
// After classify_all_functions() and promote_globals() finish, this
// pass walks every parsed function body looking for `for` loops that
// qualify for transparent parallel dispatch through job_parallel_for.
//
// A loop is a candidate if ALL of the following hold:
//   A. It is a desugared `for` loop — a T_WHILE whose step expression
//      is stashed in node.e (pure `while` loops carry node.e == 0).
//   B. The step expression has the form `i++` (MVP: stride 1).
//   C. The condition has the form `i < N` where N is either an
//      integer literal or a reference to a global variable whose
//      glob_class[] is GLOB_EXTRN or GLOB_GLOBAL. Globals still at
//      GLOB_AUTO are main-thread-only, so using one as the bound
//      would be unsafe to observe from a worker thread.
//   D. The body reads and writes ONLY:
//        - the induction variable,
//        - `auto` declarations made inside the body (loop-locals),
//        - globals whose class is GLOB_EXTRN or GLOB_GLOBAL.
//   E. Every T_CALL in the body targets either a known-pure extern
//      function or a user function already classified PHASE_BASE by
//      classify_all_functions().
//   F. The body contains no T_BREAK, T_CONTINUE, or T_RET. Those
//      cannot cross the boundary of the synthesized worker function.
//
// Stage 1 is read-only. It populates dispatch_candidates[] with the
// eligible loops so the programmer can inspect the analysis with the
// `--dispatch` flag. Stage 2 will synthesize the worker function;
// Stage 3 will rewrite the loop into a call to job_parallel_for and
// validate on snake_maestro.
//
// Why GLOB_EXTRN is considered safe even though workers may read it:
// GLOB_EXTRN means "assigned before the freeze point and never after",
// so every worker observes a stable post-init snapshot. GLOB_GLOBAL
// is the programmer's explicit opt-in to shared mutable state. Only
// GLOB_AUTO carries no ordering guarantee, and is always rejected.

// Parallel arrays, one slot per candidate loop found this pass.
static auto dispatch_candidates;      // arr<Node*>:  the T_WHILE node itself
static auto dispatch_cand_fn_idx;     // arr<int>:    index of the enclosing fn
static auto dispatch_cand_loop_var;   // arr<int>:    packed name of induction var
static auto dispatch_cand_bound;      // arr<Node*>:  the cond RHS (the N expr)
static auto dispatch_cand_synth_idx;  // arr<int>:    funcs[] slot of the synth fn
static auto dispatch_cand_synth_name; // arr<int>:    packed name of the synth fn
// Sprint 1 (multicore Gap 3 + Gap 4): non-zero start and stride.
// Each candidate records the loop's literal start value (from the
// `i = K` init that immediately precedes the T_WHILE) and stride
// (from the step `i = i + K`). Candidates with start != 0 OR
// stride != 1 are recognised by the scanner and listed by
// --dispatch but stay serial — the synthesiser and rewriter skip
// them because runtime job_parallel_for_range support is a
// separate sprint. Detection-only here unlocks pathfind / platform
// for visibility today; the parallelisation lands when the
// runtime helper does.
static auto dispatch_cand_start;      // arr<int>:    loop start value
static auto dispatch_cand_stride;     // arr<int>:    step stride value

// Sprint 2a (multicore Gap 2): reduction detection. When a loop
// rejects under the MAP rules but contains exactly one
// `acc = acc OP val` shape with an associative OP (+, *, &, |, ^),
// the scanner records (acc_packed_name, op_char) so --dispatch
// reports the loop as a REDUCTION candidate. Sprint 2b adds the
// synthesiser + runtime to actually parallelise it via tree
// reduction; until then the rewriter skips reduction candidates
// the same way it skips non-default start / stride.
static auto dispatch_cand_reduce_var; // arr<packed>: 0 = map, else acc name
static auto dispatch_cand_reduce_op;  // arr<packed>: op name (`+`, `*`, `<<`, ...)
// Scratch outputs for _fdc_find_reduction; module-level globals
// because B++ lacks struct-by-value returns and threading two
// outputs through an out-parameter pair would clutter the call
// site. _fdc_red_op carries the full packed operator (the literal
// op string from vbuf) so the display can print `<<` / `>>` as
// well as the single-character ops.
static auto _fdc_red_acc;
static auto _fdc_red_op;

// Scratch set of packed names declared via `auto` at the top level of
// the candidate body. Rebuilt per candidate by _fdc_try_candidate.
static auto _fdc_loop_locals;

// Names that the candidate body WRITES — directly via T_ASSIGN
// LHS or indirectly by exposing their address via T_ADDR. Free
// variables in this set CANNOT be captured for outlining (the
// worker's copy would diverge from the caller's, or the
// pointer-exposed slot could be mutated through an alias). The
// write-set is rebuilt per candidate and consulted by
// `_fdc_collect_captures` to filter the candidate captures
// against the read-only invariant.
static auto _fdc_write_set;

// Free-variable capture list — names referenced inside the loop body
// that are NOT the loop variable, NOT body-local declarations, and
// NOT known globals. These are the names whose values live in the
// caller's frame and must be captured into an outlining struct so the
// synth worker function can access them. Rebuilt per candidate.
//
// P1 of the smart-dispatch outlining sidequest — pure data
// collection. The capture struct synthesis, AST rewriting, and
// runtime publish happen in later phases (P2-P5). Until then, this
// list is computed but not consumed; the existing scanner gates 5
// and 6 still reject loops whose body uses these names.
//
// Mode inference (by-value vs by-reference, mirror of OpenMP
// `firstprivate` vs `shared`) is deferred to P2 when the capture
// struct type is synthesised — that's when we have the variable's
// declared type readily available via the parser's vt_block.
static auto _fdc_captures;
// Parallel to _fdc_captures: each capture's inferred type (`n.itype` at the
// reference site). The capture struct fields are typed from this so a FLOAT
// invariant (e.g. `dt`) is stored/read as float bits — not int-converted on
// publish, which silently turned the autovec multiply into multiply-by-zero.
static auto _fdc_capture_types;

// ── Autovec P2 (2026-05-22) ──────────────────────────────────
// Per-candidate scoreboard for the autovectorization
// transformation. Mirrors the smart-dispatch outlining shape:
// pre-walk classifies each candidate as autovec-eligible, P5
// (code emission) will consume the classification.
//
// `_av_pattern[i]` — pattern ordinal for `dispatch_candidates[i]`:
//   0 = not autovec-eligible
//   1 = P1: arr[i] = arr[i] OP literal_or_loop_invariant
//       (single-pointer, single body statement, op is one of
//        +/-/*/min/max, RHS is a constant or a name proven
//        read-only by the existing write-set pre-walk)
// Higher pattern ordinals reserved for P3 (multi-pointer)
// and later phases.
//
// The matcher today scans only the simplest single-statement
// shape. Anything else stays at pattern 0 (no autovec).
static auto _av_pattern;

// Monotonic counter for capture struct types. Each outlining call
// site gets its own `_capture_K` struct. Reset would happen between
// program-level compile units, but since smart-dispatch runs once
// per `bpp` invocation the counter just grows monotonically.
static auto _outline_capture_counter;

// Parallel array slot per dispatch candidate: the synthesised capture
// struct's index in `sd_*`, or -1 when no captures are needed (current
// state: always -1 because the scanner rejects loops with free vars
// at gate 6; P6 flips that). Indexed in lockstep with the other
// `dispatch_cand_*` arrays. Initialised in `find_dispatch_candidates`.
static auto dispatch_cand_capture_idx;

// Return the one-character operator stored inside a packed identifier,
// or 0 if the packed value is not exactly a one-character name. Used
// to recognize `+` and `<` without relying on pointer-identity compare,
// because the parser may allocate several vbuf slots for the same op.
static _fdc_op_char(packed) {
    if (unpack_l(packed) != 1) { return 0; }
    return peek(vbuf + unpack_s(packed));
}

// Walk a loop body subtree and add every directly-mutated name to
// `_fdc_write_set`. A name is "directly mutated" when it appears
// as the LHS of `T_ASSIGN` with `lhs.ntype == T_VAR`, OR when its
// address is taken via `T_ADDR(T_VAR(name))` (the address could
// be followed by writes through a pointer the scanner cannot
// trace). Writes through indirect addresses (`T_MEMST` whose
// address subexpression mentions the name) do NOT count — those
// modify the memory the name points at, not the name itself, and
// the disjoint-index argument keeps such writes safe for
// outlining.
static _fdc_collect_writes(nd) {
    auto n: Node, t, arr, cnt, i;
    auto lhs: Node;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_ASSIGN) {
        lhs = n.a;
        if (lhs != 0) {
            if (lhs.ntype == T_VAR) {
                _fdc_write_set = arr_push(_fdc_write_set, lhs.a);
            } else {
                _fdc_collect_writes(n.a);
            }
        }
        _fdc_collect_writes(n.b);
        return 0;
    }
    if (t == T_ADDR) {
        lhs = n.a;
        if (lhs != 0 && lhs.ntype == T_VAR) {
            _fdc_write_set = arr_push(_fdc_write_set, lhs.a);
        } else {
            _fdc_collect_writes(n.a);
        }
        return 0;
    }
    switch (t) {
    T_BINOP   { _fdc_collect_writes(n.b); _fdc_collect_writes(n.c); }
    T_UNARY   { _fdc_collect_writes(n.b); }
    T_MEMLD   { _fdc_collect_writes(n.a); }
    T_MEMST   { _fdc_collect_writes(n.a); _fdc_collect_writes(n.b); }
    T_TERNARY { _fdc_collect_writes(n.a); _fdc_collect_writes(n.b); _fdc_collect_writes(n.c); }
    T_RET     { _fdc_collect_writes(n.a); }
    T_CALL    {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_writes(arr[i]); i++; }
    }
    T_IF      {
        _fdc_collect_writes(n.a);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_writes(arr[i]); i++; }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            i = 0;
            while (i < cnt) { _fdc_collect_writes(arr[i]); i++; }
        }
    }
    T_WHILE   {
        _fdc_collect_writes(n.a);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_writes(arr[i]); i++; }
    }
    T_BLOCK   {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_writes(arr[i]); i++; }
    }
    else { }
    }
    return 0;
}

// Return 1 if `name_p` is present in the write-set.
static _fdc_in_write_set(name_p) {
    auto i, v;
    i = 0;
    while (i < arr_len(_fdc_write_set)) {
        v = arr_get(_fdc_write_set, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
        i++;
    }
    return 0;
}

// Walk a loop body subtree and add every free-variable name to
// `_fdc_captures`. A free variable is a `T_VAR` reference where the
// name is NOT the loop variable, NOT a body-local declaration, and
// NOT a known global. Those are the names that, with outlining,
// must be carried from the caller's frame into a capture struct so
// the worker can access them.
//
// Deduplicates — the same name referenced N times in the body
// produces one capture entry. Linear scan of the existing list per
// match (capture lists are small, < 10 entries typically).
//
// P1 of the outlining sidequest. The list is collected per
// candidate but not yet consumed; P2 synthesises the capture struct
// type from it, P3 rewrites the synth body to reference struct
// fields, P4 emits the publish code on the caller side, P5 extends
// the runtime to pass the capture pointer.
static _fdc_collect_captures(nd, loop_var_p) {
    auto n: Node, t, arr, cnt, i;
    auto name_p, gi, v, already;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_VAR) {
        name_p = n.a;
        if (name_p == loop_var_p) { return 0; }
        if (packed_eq(name_p, loop_var_p)) { return 0; }
        i = 0;
        while (i < arr_len(_fdc_loop_locals)) {
            v = arr_get(_fdc_loop_locals, i);
            if (v == name_p) { return 0; }
            if (packed_eq(v, name_p)) { return 0; }
            i++;
        }
        gi = dsp_find_global(name_p);
        if (gi >= 0) { return 0; }
        // Free variable. Skip if the body mutates it directly —
        // capture-by-value would diverge from caller's slot, and
        // address-taken aliases could be modified through pointer.
        // Only read-only free vars are safe to capture into the
        // outlining struct.
        if (_fdc_in_write_set(name_p)) { return 0; }
        // Deduplicate against existing capture list.
        already = 0;
        i = 0;
        while (i < arr_len(_fdc_captures)) {
            v = arr_get(_fdc_captures, i);
            if (v == name_p) { already = 1; i = arr_len(_fdc_captures); }
            else if (packed_eq(v, name_p)) { already = 1; i = arr_len(_fdc_captures); }
            else { i++; }
        }
        if (already == 0) {
            if (_fdc_capture_types == 0) { _fdc_capture_types = arr_new(); }
            _fdc_captures = arr_push(_fdc_captures, name_p);
            // Record the reference's inferred type, kept index-parallel.
            _fdc_capture_types = arr_push(_fdc_capture_types, n.itype);
        }
        return 0;
    }
    switch (t) {
    T_BINOP   { _fdc_collect_captures(n.b, loop_var_p); _fdc_collect_captures(n.c, loop_var_p); }
    T_UNARY   { _fdc_collect_captures(n.b, loop_var_p); }
    T_MEMLD   { _fdc_collect_captures(n.a, loop_var_p); }
    T_MEMST   { _fdc_collect_captures(n.a, loop_var_p); _fdc_collect_captures(n.b, loop_var_p); }
    T_ADDR    { _fdc_collect_captures(n.a, loop_var_p); }
    T_TERNARY { _fdc_collect_captures(n.a, loop_var_p); _fdc_collect_captures(n.b, loop_var_p); _fdc_collect_captures(n.c, loop_var_p); }
    T_ASSIGN  { _fdc_collect_captures(n.a, loop_var_p); _fdc_collect_captures(n.b, loop_var_p); }
    T_RET     { _fdc_collect_captures(n.a, loop_var_p); }
    T_CALL    {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_captures(arr[i], loop_var_p); i++; }
    }
    T_IF      {
        _fdc_collect_captures(n.a, loop_var_p);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_captures(arr[i], loop_var_p); i++; }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            i = 0;
            while (i < cnt) { _fdc_collect_captures(arr[i], loop_var_p); i++; }
        }
    }
    T_WHILE   {
        _fdc_collect_captures(n.a, loop_var_p);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_captures(arr[i], loop_var_p); i++; }
    }
    T_BLOCK   {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _fdc_collect_captures(arr[i], loop_var_p); i++; }
    }
    else { }
    }
    return 0;
}

// Build a packed name of the form `_capture_K` (mirror of the synth
// function's `_synth_make_name`) by writing to vbuf and packing.
// Used by `_outline_synth_capture_struct` to give each outlining call
// site a unique struct type.
static _outline_make_capture_name() {
    auto start, n, tmp, digits, i;
    start = vbuf_pos;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'c'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'a'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'p'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 't'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'u'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'r'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'e'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    n = _outline_capture_counter;
    if (n == 0) {
        poke(vbuf + vbuf_pos, '0'); vbuf_pos++;
    } else {
        tmp = n;
        digits = 0;
        while (tmp > 0) { digits++; tmp /= 10; }
        vbuf_pos += digits;
        tmp = n;
        for (i = 0; i < digits; i++) {
            poke(vbuf + vbuf_pos - 1 - i, '0' + tmp % 10);
            tmp /= 10;
        }
    }
    _outline_capture_counter++;
    return pack(start, vbuf_pos - start);
}

// Synthesise a `_capture_K` struct type from the current
// `_fdc_captures` list, one field per captured name. Returns the
// struct index in `sd_*` for the caller to record in
// `dispatch_cand_capture_idx`. Field hints default to TY_WORD —
// proper mode inference (by-value scalar vs by-reference pointer)
// is deferred to P3 when we have the variable's vt_block type
// readily available via `get_var_type`. TY_WORD covers the common
// case (pointers and ints are both word-sized).
//
// MUST be called only when `_fdc_captures` is non-empty AND the
// candidate has otherwise passed the safety gates. Returns -1 when
// the list is empty (no struct needed).
//
// Called by `_fdc_try_candidate` in P6 when the gate-6 relax accepts
// caller-frame refs. Today (P2): defined but uncalled — pure
// infrastructure waiting for P6 wire-up.
static _outline_synth_capture_struct() {
    auto cap_name, sidx, i, fname;
    if (arr_len(_fdc_captures) == 0) { return 0 - 1; }
    cap_name = _outline_make_capture_name();
    sidx = add_struct_def(cap_name);
    i = 0;
    while (i < arr_len(_fdc_captures)) {
        fname = arr_get(_fdc_captures, i);
        // Type the field by the capture's inferred type. A FLOAT capture
        // MUST keep its float type: otherwise the publish stores it via
        // `fcvtzs` (float -> int) and the synth splats that integer's bits
        // as an f32 — a near-zero denormal — so the autovec loop silently
        // multiplies by ~0. Pointers / words / unknowns keep the safe
        // 8-byte word slot (TY_WORD = 0x02).
        auto fty, cap_ty;
        fty = 0x02;
        if (_fdc_capture_types != 0) {
            if (i < arr_len(_fdc_capture_types)) {
                cap_ty = arr_get(_fdc_capture_types, i);
                if (is_float_type(cap_ty)) { fty = cap_ty; }
            }
        }
        add_struct_field(sidx, fname, fty);
        i++;
    }
    return sidx;
}

// ── Autovec P2 helpers — pattern P1 matcher ──────────────────
//
// Pattern P1 (the simplest autovec-able shape):
//
//     arr[i] = arr[i] OP literal_or_loop_invariant
//
// In B++ AST that's:
//
//     T_MEMST(
//         .a = T_BINOP(+, T_VAR(arr), <loop-var-index-expression>),
//         .b = T_BINOP(OP,
//             T_MEMLD(SAME-shape-as-.a, hint),
//             T_LIT | T_VAR(loop-invariant)),
//         .c = hint
//     )
//
// Where `OP` is one of +, -, *, /, & (bitwise), | (bitwise),
// ^ (bitwise). min/max not supported via T_BINOP; will be
// recognised separately when needed.

// Return 1 if `a` and `b` are structurally identical T_VAR
// nodes (same packed name), 0 otherwise. Used to verify the
// load address and store address reference the same array.
static _av_node_same_var(a, b) {
    auto (na, nb): Node;
    if (a == 0 || b == 0) { return 0; }
    na = a;
    nb = b;
    if (na.ntype != T_VAR) { return 0; }
    if (nb.ntype != T_VAR) { return 0; }
    if (na.a == nb.a) { return 1; }
    if (packed_eq(na.a, nb.a)) { return 1; }
    return 0;
}

// Walk two address expressions and return 1 if they have the
// same structural shape (same operator chain, same operand
// identity). Recursion mirrors the parser's address-expression
// builder; only T_BINOP / T_VAR / T_LIT nodes appear in
// addr-of-array-slot trees.
static _av_addr_same(a, b) {
    auto (na, nb): Node;
    if (a == 0 || b == 0) { return a == b; }
    na = a;
    nb = b;
    if (na.ntype != nb.ntype) { return 0; }
    if (na.ntype == T_VAR) {
        return _av_node_same_var(a, b);
    }
    if (na.ntype == T_LIT) {
        // Numeric literals — compare the packed text.
        if (na.a == nb.a) { return 1; }
        if (packed_eq(na.a, nb.a)) { return 1; }
        return 0;
    }
    if (na.ntype == T_BINOP) {
        // Operator + both sides must match. Address arithmetic
        // is built left-leaning so we don't try commuting.
        if (packed_eq(na.a, nb.a) == 0) { return 0; }
        if (_av_addr_same(na.b, nb.b) == 0) { return 0; }
        return _av_addr_same(na.c, nb.c);
    }
    return 0;
}

// Return 1 if `op_p` is a packed one-character operator that
// pattern P1 considers SIMD-friendly. Mirrors the eight ops
// the existing `vec_*` family supports: +/-/*//. Bitwise &|^
// are also acceptable on integer arrays (SSE2 PAND/POR/PXOR,
// NEON VAND/VORR/VEOR) but the current `vec_*` builtin set
// targets floats only; integer-array autovec is deferred.
static _av_op_is_simd_friendly(op_p) {
    auto op_l, op_ch;
    op_l = unpack_l(op_p);
    if (op_l != 1) { return 0; }
    op_ch = peek(vbuf + unpack_s(op_p));
    if (op_ch == '+') { return 1; }
    if (op_ch == '-') { return 1; }
    if (op_ch == '*') { return 1; }
    if (op_ch == '/') { return 1; }
    return 0;
}

// Return 1 if `nd` is a loop-invariant operand for pattern P1:
// a literal, OR a name not in the write-set, not equal to the
// loop variable, and not a body-local. Captures (caller-frame
// reads via outlining) also count as invariant — they don't
// change during the loop.
static _av_is_loop_invariant(nd, loop_var_p) {
    auto n: Node, name_p, i, v;
    if (nd == 0) { return 0; }
    n = nd;
    if (n.ntype == T_LIT) { return 1; }
    if (n.ntype != T_VAR) { return 0; }
    name_p = n.a;
    if (name_p == loop_var_p) { return 0; }
    if (packed_eq(name_p, loop_var_p)) { return 0; }
    if (_fdc_in_write_set(name_p)) { return 0; }
    // Body locals are scratch — values may change between iters.
    i = 0;
    while (i < arr_len(_fdc_loop_locals)) {
        v = arr_get(_fdc_loop_locals, i);
        if (v == name_p) { return 0; }
        if (packed_eq(v, name_p)) { return 0; }
        i++;
    }
    return 1;
}

// Recognise pattern P1 on a single statement. Returns the
// pattern ordinal (1) on match, 0 on miss. Caller invokes once
// per body statement; the loop is P1-eligible only when EVERY
// statement matches (and body_cnt > 0).
//
// Type gate: the SIMD lowering target uses `vec_*_ps` packed
// floats (4 × 32-bit float per register on SSE2 / NEON). To
// qualify, the store hint must encode BASE_FLOAT and the slice
// must be SL_HALF (32-bit element width). 64-bit word slots
// (default `: word` / no annotation) would need separate
// integer-SIMD builtins (PADDQ family on SSE2, VADDQ on NEON)
// which the current `vec_*` family doesn't cover. Bytes /
// quarters / sub-word floats are also outside the current
// vector width.
//
// The type info comes from B++'s existing slice + base
// inference — programmer doesn't add new annotations; declaring
// `: half` on the pointer or field flows the hint into the
// T_MEMST.c slot the parser fills.
static _av_match_p1_stmt(stmt, loop_var_p) {
    auto (st, rhs, ld): Node;
    auto hint;
    if (stmt == 0) { return 0; }
    st = stmt;
    if (st.ntype != T_MEMST) { return 0; }
    rhs = st.b;
    if (rhs == 0) { return 0; }
    if (rhs.ntype != T_BINOP) { return 0; }
    if (_av_op_is_simd_friendly(rhs.a) == 0) { return 0; }
    ld = rhs.b;
    if (ld == 0) { return 0; }
    if (ld.ntype != T_MEMLD) { return 0; }
    // Store address must structurally equal load address.
    if (_av_addr_same(st.a, ld.a) == 0) { return 0; }
    // Other operand must be loop-invariant.
    if (_av_is_loop_invariant(rhs.c, loop_var_p) == 0) { return 0; }
    // Type gate: store hint must be 32-bit float (BASE_FLOAT +
    // SL_HALF) — the element type that the existing `vec_*_ps`
    // family targets.
    hint = st.c;
    if (is_float_type(hint) == 0) { return 0; }
    if (ty_slice(hint) != SL_HALF) { return 0; }
    return 1;
}

// ── Autovec P6 Phase 1 — range-synth body builder ───────────
//
// Lazy-init packed name for the synth function's `_end` parameter.
// Each outlined synth function takes `(loop_var, _end)` where
// `loop_var` is the iteration index (initialised to `start`) and
// `_end` is the upper bound. The chunk_worker calls
// `call(fn, start, end)` and AAPCS64 places those in x0 / x1
// matching the param order.
static auto _av_end_param_name;
static _av_get_end_param_name() {
    if (_av_end_param_name == 0) {
        _av_end_param_name = _dsp_pack_cstr("_end");
    }
    return _av_end_param_name;
}

// Wrap the original loop body in `while (loop_var < _end) {
// body; loop_var = loop_var + 1; }`. Returns a single-statement
// body_ptr (one T_WHILE) that the synth function can use.
static _av_make_range_synth_body(loop_var_p, body_arr, body_cnt) {
    auto (wh, cond, step): Node;
    auto stmts;
    cond = _dsp_make_binop('<',
        _dsp_make_var(loop_var_p),
        _dsp_make_var(_av_get_end_param_name()));
    step = _dsp_make_assign(_dsp_make_var(loop_var_p),
        _dsp_make_binop('+', _dsp_make_var(loop_var_p),
                        _outline_make_int_lit(1)));
    wh = make_node(T_WHILE);
    wh.a = cond;
    wh.b = body_arr;
    wh.c = body_cnt;
    wh.d = 0;
    wh.e = step;
    stmts = malloc(8);
    *stmts = wh;
    return stmts;
}

// ── Autovec P5 — code emission helpers ──────────────────────
//
// Map a single-char arithmetic op to the corresponding `vec_*`
// builtin name. Used by the lowering rule that turns a scalar
// `arr[i] OP arr[i]` into `vec_OP4(vec_load4(arr+i*4), ...)`.
// Returns packed name or 0 if the op isn't SIMD-friendly.
static _av_op_to_vec_name(op_p) {
    auto op_l, op_ch;
    op_l = unpack_l(op_p);
    if (op_l != 1) { return 0; }
    op_ch = peek(vbuf + unpack_s(op_p));
    if (op_ch == '+') { return _dsp_pack_name("vec_add4", 8); }
    if (op_ch == '-') { return _dsp_pack_name("vec_sub4", 8); }
    if (op_ch == '*') { return _dsp_pack_name("vec_mul4", 8); }
    if (op_ch == '/') { return _dsp_pack_name("vec_div4", 8); }
    return 0;
}

// Pluck the base pointer name from an address expression. The
// canonical shape parsers emit for `arr[i]` is
// `T_BINOP(+, T_VAR(arr), <index_expr>)`. Returns the packed
// name on success, 0 on miss.
static _av_addr_base_name(addr) {
    auto (n, lhs): Node;
    if (addr == 0) { return 0; }
    n = addr;
    if (n.ntype != T_BINOP) { return 0; }
    lhs = n.b;
    if (lhs == 0) { return 0; }
    if (lhs.ntype != T_VAR) { return 0; }
    return lhs.a;
}

// Recognise pattern P2 on a single statement: three-pointer
// element-wise op of the shape
//
//     dst[i] = src1[i] OP src2[i]
//
// where dst, src1, src2 reference different base-pointer
// names AND the index expressions are structurally identical
// across all three accesses. Same type gate as P1
// (BASE_FLOAT + SL_HALF).
//
// Name-disjoint is a heuristic, not a proof — programmers
// CAN alias by passing the same array under two names. The
// doctrine (Q2 of `docs/plans/sidequest_autovec_b4_completion.md`)
// is "compiler proves OR stays scalar" — but real proof
// requires either type-disjointness (rare in B++ today) or
// dependency analysis we're not building. Name-disjoint is
// the same trade GCC and LLVM make without `__restrict__`:
// accept the shape, document the aliasing assumption, leave
// the escape hatch to explicit `vec_*` builtins for cases
// the programmer needs guaranteed correctness on.
static _av_match_p2_stmt(stmt, loop_var_p) {
    auto (st, rhs, ld1, ld2): Node;
    auto hint, dst_name, src1_name, src2_name;
    if (stmt == 0) { return 0; }
    st = stmt;
    if (st.ntype != T_MEMST) { return 0; }
    rhs = st.b;
    if (rhs == 0) { return 0; }
    if (rhs.ntype != T_BINOP) { return 0; }
    if (_av_op_is_simd_friendly(rhs.a) == 0) { return 0; }
    ld1 = rhs.b;
    ld2 = rhs.c;
    if (ld1 == 0 || ld2 == 0) { return 0; }
    if (ld1.ntype != T_MEMLD) { return 0; }
    if (ld2.ntype != T_MEMLD) { return 0; }
    // Index expressions must structurally match across all
    // three accesses (store + 2 loads). Differing index =
    // potential gather/scatter, outside P2 scope.
    if (_av_addr_same(st.a, ld1.a) == 0) {
        // Store addr and ld1 addr might differ in base name
        // but share the same index. We accept that — what we
        // really want is "different base, same index".
    }
    // Extract base names. All three must be distinct so we
    // get reasonable confidence the arrays don't alias.
    dst_name = _av_addr_base_name(st.a);
    src1_name = _av_addr_base_name(ld1.a);
    src2_name = _av_addr_base_name(ld2.a);
    if (dst_name == 0 || src1_name == 0 || src2_name == 0) { return 0; }
    if (packed_eq(dst_name, src1_name)) { return 0; }
    if (packed_eq(dst_name, src2_name)) { return 0; }
    if (packed_eq(src1_name, src2_name)) { return 0; }
    // Type gate — same shape as P1.
    hint = st.c;
    if (is_float_type(hint) == 0) { return 0; }
    if (ty_slice(hint) != SL_HALF) { return 0; }
    return 2;
}

// Predicate: is `stmt` a body-local-setup T_ASSIGN whose RHS
// touches only the loop var, loop-invariants, or other
// body-locals? If yes, it can precede a SIMD-able T_MEMST
// without breaking the autovec transformation (the local
// setup happens once per iteration but doesn't affect the
// SIMD store's correctness).
//
// Loose: returns 1 for any T_ASSIGN whose LHS is a T_VAR and
// the var is in `_fdc_loop_locals`. Doesn't fully analyse the
// RHS for side-effects — relying on the outer `_fdc_subtree_safe`
// gate to have already rejected side-effecting expressions.
static _av_is_local_setup_assign(stmt) {
    auto (st, lhs): Node;
    auto i, name_p, v;
    if (stmt == 0) { return 0; }
    st = stmt;
    if (st.ntype != T_ASSIGN) { return 0; }
    lhs = st.a;
    if (lhs == 0) { return 0; }
    if (lhs.ntype != T_VAR) { return 0; }
    name_p = lhs.a;
    // LHS must be a body-local — the standard "loose
    // pre-statement" condition that authorises pre-amble code
    // before the SIMD T_MEMST.
    i = 0;
    while (i < arr_len(_fdc_loop_locals)) {
        v = arr_get(_fdc_loop_locals, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
        i++;
    }
    return 0;
}

// Is `nd` the loop induction variable?
static _av_is_loop_var_node(nd, loop_var_p) {
    auto n: Node;
    if (nd == 0) { return 0; }
    n = nd;
    if (n.ntype != T_VAR) { return 0; }
    if (n.a == loop_var_p) { return 1; }
    return packed_eq(n.a, loop_var_p);
}

// Find `loop_var * K` (or `K * loop_var`) in an address-arithmetic tree
// and return K — the per-iteration BYTE stride. Returns 0 when no such
// product is present. `vec_load4` reads 4 CONTIGUOUS elements, so the
// autovec is only correct when the stride equals the element width; a
// larger stride (an AoS struct field) would pull adjacent fields into
// lanes 1..3 and corrupt them. This lets the matcher reject those.
static _av_loop_var_mult(nd, loop_var_p) {
    auto n: Node, lit: Node, op_s, op_l, c0, c1, r;
    if (nd == 0) { return 0; }
    n = nd;
    if (n.ntype != T_BINOP) { return 0; }
    op_s = unpack_s(n.a); op_l = unpack_l(n.a);
    c0 = peek(vbuf + op_s);
    c1 = 0; if (op_l > 1) { c1 = peek(vbuf + op_s + 1); }
    // `loop_var * K` or `K * loop_var`.
    if (op_l == 1 && c0 == '*') {
        if (_av_is_loop_var_node(n.b, loop_var_p) && is_int_lit_node(n.c)) {
            lit = n.c; return parse_int_lit_value(lit.a);
        }
        if (_av_is_loop_var_node(n.c, loop_var_p) && is_int_lit_node(n.b)) {
            lit = n.b; return parse_int_lit_value(lit.a);
        }
    }
    // `loop_var << K` — the parser strength-reduces `* 2^K` to a shift, so a
    // stride of 4 reaches here as `i << 2` and 16 as `i << 4`.
    if (op_l == 2 && c0 == '<' && c1 == '<') {
        if (_av_is_loop_var_node(n.b, loop_var_p) && is_int_lit_node(n.c)) {
            lit = n.c; return 1 << parse_int_lit_value(lit.a);
        }
    }
    r = _av_loop_var_mult(n.b, loop_var_p);
    if (r != 0) { return r; }
    return _av_loop_var_mult(n.c, loop_var_p);
}

// Run the autovec matcher on a candidate body. Returns the
// pattern ordinal:
//   0 = not eligible
//   1 = pattern P1 (single-pointer arr[i] = arr[i] OP literal)
//   2 = pattern P2 (multi-pointer dst[i] = a[i] OP b[i])
//
// Body acceptance rule (P3 loosening, 2026-05-22):
//   * EXACTLY ONE T_MEMST in the body — the SIMD-able store.
//   * That T_MEMST matches either P1 or P2.
//   * Every OTHER statement is a body-local-setup T_ASSIGN
//     (programmer's pre-amble computing pointer offsets
//     before the store).
//
// This loosening is required to cover the canonical B++
// shape `c = arr + i*N; c.v = c.v OP ...` which lowers to
// two statements (T_ASSIGN + T_MEMST). The strict
// every-statement-matches form rejected those bodies.
static _av_classify_body(body_arr, body_cnt, loop_var_p) {
    auto i, p, memst_count, memst_pattern, found_stride, m;
    auto stmt: Node;
    if (body_cnt <= 0) { return 0; }
    memst_count = 0;
    memst_pattern = 0;
    found_stride = 0;
    i = 0;
    while (i < body_cnt) {
        stmt = body_arr[i];
        if (stmt == 0) { i++; continue; }
        if (stmt.ntype == T_MEMST) {
            memst_count++;
            if (memst_count > 1) { return 0; }
            // Try P1 first (single-pointer), then P2.
            p = _av_match_p1_stmt(stmt, loop_var_p);
            if (p == 0) {
                p = _av_match_p2_stmt(stmt, loop_var_p);
            }
            if (p == 0) { return 0; }
            memst_pattern = p;
            // Direct `arr[i]`-shaped store address carries the stride.
            m = _av_loop_var_mult(stmt.a, loop_var_p);
            if (m != 0) { found_stride = m; }
        } else if (stmt.ntype == T_ASSIGN) {
            if (_av_is_local_setup_assign(stmt) == 0) { return 0; }
            // `c = base + i*STRIDE` pre-amble carries the stride.
            m = _av_loop_var_mult(stmt.b, loop_var_p);
            if (m != 0) { found_stride = m; }
        } else if (stmt.ntype == T_DECL) {
            // Body-local declarations are pre-walked into
            // `_fdc_loop_locals` already; the T_DECL node
            // itself has no side effects at runtime.
        } else {
            // Any other statement type breaks autovec.
            return 0;
        }
        i++;
    }
    if (memst_count != 1) { return 0; }
    // Contiguity gate: the matcher only accepts SL_HALF (4-byte) stores, so a
    // correct vectorisable access advances 4 bytes per iteration. A larger
    // stride means an AoS struct field (e.g. `cooldown` inside a 40-byte
    // entity) — vec_load4 would read the neighbouring fields as lanes 1..3
    // and corrupt them. Reject; the loop stays scalar (Rule 39: strided
    // access needs gather/scatter, which the autovectoriser does not do).
    if (found_stride != 0 && found_stride != 4) { return 0; }
    return memst_pattern;
}

// Build a generic T_CALL node for builtins.
static _av_make_call(name_p, args_arr, argc) {
    auto node: Node;
    node = make_node(T_CALL);
    node.a = name_p;
    node.b = args_arr;
    node.c = argc;
    return node;
}

// Lower the matched T_MEMST into the SIMD-equivalent T_CALL
// expression. Returns the new T_MEMST node whose RHS is the
// vec_*4 chain. The store address is kept verbatim — what
// the original wrote, the SIMD version writes too — but the
// RHS now does vec_load4(ld_addr1) [vec_OP4 vec_load4(ld_addr2)
// | vec_splat4(literal)] depending on pattern.
//
// Single-arg variant (vec_store4 inside another expression) is
// also emitted at the parser-recognised builtin so codegen
// already handles it.
// `splat_name`: when non-zero (P1 only), the loop-invariant splat is
// hoisted ONCE before the loop into that local, so this lowering just
// references it instead of recomputing `vec_splat4(invariant)` every
// iteration (LICM). Zero keeps the original inline-splat behaviour.
static _av_lower_stmt(orig_memst, pattern, splat_name) {
    auto (orig, rhs, ld1, ld2_or_rhs): Node;
    auto vec_op_name, ld_args1, ld_args2, splat_args;
    auto vec_load_name, vec_splat_name, vec_store_name;
    auto (load1, load2_or_splat, vec_op): Node;
    auto vec_op_args;
    auto store_call: Node, store_args;
    orig = orig_memst;
    rhs = orig.b;
    ld1 = rhs.b;
    ld2_or_rhs = rhs.c;
    vec_op_name = _av_op_to_vec_name(rhs.a);
    vec_load_name = _dsp_pack_name("vec_load4", 9);
    vec_splat_name = _dsp_pack_name("vec_splat4", 10);
    vec_store_name = _dsp_pack_name("vec_store4", 10);
    // First operand of OP is always a load.
    ld_args1 = malloc(8);
    *ld_args1 = ld1.a;
    load1 = _av_make_call(vec_load_name, ld_args1, 1);
    // Second operand: load (P2) or splat (P1).
    if (pattern == 2) {
        ld_args2 = malloc(8);
        *ld_args2 = ld2_or_rhs.a;
        load2_or_splat = _av_make_call(vec_load_name, ld_args2, 1);
    } else if (splat_name != 0) {
        // Hoisted: reference the splat local computed once before the loop.
        load2_or_splat = _dsp_make_var(splat_name);
    } else {
        splat_args = malloc(8);
        *splat_args = ld2_or_rhs;
        load2_or_splat = _av_make_call(vec_splat_name, splat_args, 1);
    }
    // Combine via vec_OP4.
    vec_op_args = malloc(16);
    *vec_op_args = load1;
    *(vec_op_args + 8) = load2_or_splat;
    vec_op = _av_make_call(vec_op_name, vec_op_args, 2);
    // Store result.
    store_args = malloc(16);
    *store_args = orig.a;
    *(store_args + 8) = vec_op;
    store_call = _av_make_call(vec_store_name, store_args, 2);
    return store_call;
}

// Build the SIMD version of the loop body. Walks the original
// body, copies pre-amble T_DECL / T_ASSIGN statements, and
// replaces the single T_MEMST with the lowered vec_store4 call.
static _av_build_simd_body(body_arr, body_cnt, pattern, simd_body_out, simd_cnt_out, splat_name) {
    auto i, out_i;
    auto stmt: Node;
    out_i = 0;
    i = 0;
    while (i < body_cnt) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (stmt.ntype == T_MEMST) {
                *(simd_body_out + out_i * 8) = _av_lower_stmt(stmt, pattern, splat_name);
            } else {
                // T_DECL / T_ASSIGN pre-amble — keep verbatim.
                // Cloning avoids sharing nodes between vector
                // and scalar tail.
                *(simd_body_out + out_i * 8) = ast_clone_subst(stmt, 0, 0, 0);
            }
            out_i++;
        }
        i++;
    }
    *simd_cnt_out = out_i;
}

// Build a fresh T_WHILE node that wraps `body_arr` as the
// vector loop. cond is `i + 4 <= bound_n`, step is `i += 4`.
static _av_build_vector_loop(loop_var_p, bound_n, body_arr, body_cnt) {
    auto (wh, cond, step): Node;
    auto (iv1, iv2, iv3): Node;
    auto lit4: Node, plus_op, le_op;
    iv1 = _dsp_make_var(loop_var_p);
    lit4 = _dsp_make_int_lit(4);
    plus_op = _outline_make_op_char('+');
    iv2 = make_node(T_BINOP);
    iv2.a = plus_op;
    iv2.b = iv1;
    iv2.c = lit4;
    // cond: (i + 4) <= bound_n  — packed two-char "<=".
    le_op = pack(vbuf_pos, 2);
    poke(vbuf + vbuf_pos, '<'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '='); vbuf_pos++;
    cond = make_node(T_BINOP);
    cond.a = le_op;
    cond.b = iv2;
    cond.c = bound_n;
    // step: i = i + 4
    iv3 = _dsp_make_var(loop_var_p);
    step = _dsp_make_assign(_dsp_make_var(loop_var_p),
        _dsp_make_binop('+', iv3, _outline_make_int_lit(4)));
    wh = make_node(T_WHILE);
    wh.a = cond;
    wh.b = body_arr;
    wh.c = body_cnt;
    wh.d = 0;
    wh.e = step;
    return wh;
}

// Build a fresh T_WHILE that re-runs the original body from
// the index where the vector loop left off through `bound_n`.
// Body is a clone of the original so the vector + tail don't
// share AST nodes. cond is `i < bound_n`, step is `i += 1`
// (matches original scalar shape exactly).
static _av_build_scalar_tail(loop_var_p, bound_n, orig_body_arr, orig_body_cnt) {
    auto (wh, cond, step): Node;
    auto (iv1, iv2): Node;
    auto cloned, i;
    // Clone body so the tail has its own nodes.
    cloned = malloc(orig_body_cnt * 8);
    i = 0;
    while (i < orig_body_cnt) {
        *(cloned + i * 8) = ast_clone_subst(orig_body_arr[i], 0, 0, 0);
        i++;
    }
    iv1 = _dsp_make_var(loop_var_p);
    cond = _dsp_make_binop('<', iv1, bound_n);
    iv2 = _dsp_make_var(loop_var_p);
    step = _dsp_make_assign(_dsp_make_var(loop_var_p),
        _dsp_make_binop('+', iv2, _outline_make_int_lit(1)));
    wh = make_node(T_WHILE);
    wh.a = cond;
    wh.b = cloned;
    wh.c = orig_body_cnt;
    wh.d = 0;
    wh.e = step;
    return wh;
}

// Mutate a T_WHILE into a T_BLOCK containing the vector loop
// followed by a scalar tail. Same in-place pattern outlining
// uses — the enclosing function's body still sees the same
// node at the same position.
static _av_rewrite_loop(wh, loop_var_p, bound_n, body_arr, body_cnt, pattern) {
    auto (wh_node, vec_loop, tail_loop): Node;
    auto simd_body, simd_cnt_p, simd_cnt;
    auto stmts;
    wh_node = wh;
    simd_body = malloc(body_cnt * 8);
    simd_cnt_p = malloc(8);
    *simd_cnt_p = 0;
    // In-place path keeps the inline splat (splat_name = 0) — the hoist
    // is wired only on the outlined/synth path below.
    _av_build_simd_body(body_arr, body_cnt, pattern, simd_body, simd_cnt_p, 0);
    simd_cnt = *simd_cnt_p;
    vec_loop = _av_build_vector_loop(loop_var_p, bound_n, simd_body, simd_cnt);
    tail_loop = _av_build_scalar_tail(loop_var_p, bound_n, body_arr, body_cnt);
    stmts = malloc(16);
    *stmts = vec_loop;
    *(stmts + 8) = tail_loop;
    wh_node.ntype = T_BLOCK;
    wh_node.a = 0;
    wh_node.b = stmts;
    wh_node.c = 2;
    wh_node.d = 0;
    wh_node.e = 0;
    wh_node.dispatch = 0;
    return 1;
}

// Reserved name for the capture-struct pointer parameter in
// synthesised worker functions. All outlining sites share the same
// parameter name (each synth function has its own slot, just one
// name in source). Lazy-initialised at first use to avoid touching
// vbuf at startup before the parser has run.
static auto _outline_cap_ptr_name;

static _outline_get_cap_ptr_name() {
    if (_outline_cap_ptr_name == 0) {
        // Resolved as a global (declared in bpp_job.bsm) — workers
        // read this slot to recover the capture struct pointer that
        // job_parallel_for_data published before the dispatch.
        // Single global slot, single capture-pointer at a time;
        // the worker-recursion guard in job_parallel_for_data
        // prevents nested overlap.
        _outline_cap_ptr_name = _dsp_pack_cstr("_outline_cap_ptr");
    }
    return _outline_cap_ptr_name;
}

// Build a T_LIT node for an integer value by writing the decimal
// digits to vbuf and packing. Mirror of parser's static
// `make_int_lit` — replicated here because the parser keeps it
// private. Returns a fresh node.
static _outline_make_int_lit(val) {
    auto start, tmp, digit, i, j, t;
    auto node: Node;
    start = vbuf_pos;
    if (val == 0) {
        poke(vbuf + vbuf_pos, '0');
        vbuf_pos++;
    } else {
        tmp = val;
        while (tmp > 0) {
            digit = tmp % 10;
            poke(vbuf + vbuf_pos, '0' + digit);
            vbuf_pos++;
            tmp /= 10;
        }
        // Reverse the digits in place.
        i = start;
        j = vbuf_pos - 1;
        while (i < j) {
            t = peek(vbuf + i);
            poke(vbuf + i, peek(vbuf + j));
            poke(vbuf + j, t);
            i++;
            j--;
        }
    }
    node = make_node(T_LIT);
    node.a = pack(start, vbuf_pos - start);
    node.b = SHAPE_INT;
    return node;
}

// Build a one-character packed operator. Mirror of parser's
// `make_plus_op` (also static there). Lazy-cached single-char
// operators land in vbuf at the first call and the same packed
// reference is reused — but the parser allocates a new entry each
// time it builds an op, so duplicating the bytes here is consistent
// with the existing convention (the codegen compares operators
// byte-wise via `_fdc_op_char`, not pointer-wise).
static _outline_make_op_char(ch) {
    auto start;
    start = vbuf_pos;
    poke(vbuf + vbuf_pos, ch);
    vbuf_pos++;
    return pack(start, 1);
}

// Build a synthetic `T_MEMLD(*(_cap_ptr + offset_of(field)))` node
// that — when emit_node sees it — produces a load from the
// capture-struct field. Used as the substitution target when
// `ast_clone_subst` rewrites the synth body.
//
// Shape mirrors the parser's `resolve_dot` (bpp_parser.bsm:2928)
// output exactly so codegen treats this no differently from a
// hand-written `cap.field` source-level access.
static _outline_make_field_access(sidx, field_p) {
    auto offset, op_plus, off_node, ptr_node: Node, mem_node: Node;
    auto var_node: Node;
    offset = get_field_offset(sidx, field_p);
    if (offset < 0) { return 0; }

    var_node = make_node(T_VAR);
    var_node.a = _outline_get_cap_ptr_name();

    off_node = _outline_make_int_lit(offset);

    op_plus = _outline_make_op_char('+');
    ptr_node = make_node(T_BINOP);
    ptr_node.a = op_plus;
    ptr_node.b = var_node;
    ptr_node.c = off_node;

    mem_node = make_node(T_MEMLD);
    mem_node.a = ptr_node;
    // Carry the field's real type so a captured float reads back as float
    // (matching the float-typed publish), not as a raw word.
    mem_node.b = get_field_type(sidx, field_p);
    return mem_node;
}

// Build the (names, replacements) arrays that `ast_clone_subst`
// consumes. For each captured name, the replacement is a freshly-
// minted `T_MEMLD(_cap_ptr + offset)` node. Caller pre-allocates
// the two output buffers (sized to `arr_len(_fdc_captures)`).
//
// Each (name, mem_node) pair is independent — the cloner shares the
// mem_node across every reference to the captured name in the body,
// but emit_node only reads node fields so multi-reference is safe.
static _outline_build_subst_map(sidx, params_out, args_out) {
    auto i, name, mem_node;
    i = 0;
    while (i < arr_len(_fdc_captures)) {
        name = arr_get(_fdc_captures, i);
        mem_node = _outline_make_field_access(sidx, name);
        *(params_out + i * 8) = name;
        *(args_out + i * 8) = mem_node;
        i++;
    }
    return arr_len(_fdc_captures);
}

// Repopulate `_fdc_captures` from the capture struct's fields. Called
// from Stage 2 (`synthesize_loop_fn`) and Stage 3
// (`_outline_rewrite_with_captures`) — both run AFTER
// `_fdc_try_candidate` cleared the captures scratch for the next
// candidate. The struct fields are the canonical record of which
// names this candidate captured, in the order they were added.
static _outline_restore_captures_from_struct(sidx) {
    auto recs: Arr, fc, i, r: FieldRec;
    arr_clear(_fdc_captures);
    if (sidx < 0) { return; }
    recs = arr_get(sd_fields, sidx);
    fc = arr_get(sd_fcounts, sidx);
    i = 0;
    while (i < fc) {
        r = arr_struct_at(recs, i);
        _fdc_captures = arr_push(_fdc_captures, r.field_p);
        i++;
    }
}

// Clone every statement in a body array, substituting captured names
// with the corresponding capture-struct field access. Returns a new
// body_arr that the synth function can use as its `FN_BODY`. Allocates
// a fresh body_arr buffer; the caller owns it.
//
// When `sidx < 0` (no captures), returns the original `body_arr`
// untouched — saves the clone work for the common path.
//
// P3 of the outlining sidequest. Synth-time use; not invoked until
// P6 wires the gate-6 relax that produces non-empty `_fdc_captures`
// for accepted candidates.
static _outline_clone_body_with_captures(body_arr, body_cnt, sidx) {
    auto params_buf, args_buf, pcnt, i;
    auto cloned_body, stmt;
    if (sidx < 0) { return body_arr; }
    if (arr_len(_fdc_captures) == 0) { return body_arr; }

    params_buf = buf_word(arr_len(_fdc_captures) + 1);
    args_buf = buf_word(arr_len(_fdc_captures) + 1);
    pcnt = _outline_build_subst_map(sidx, params_buf, args_buf);

    cloned_body = buf_word(body_cnt + 1);
    i = 0;
    while (i < body_cnt) {
        stmt = body_arr[i];
        if (stmt == 0) {
            cloned_body[i] = 0;
        } else {
            cloned_body[i] = ast_clone_subst(stmt, params_buf, pcnt, args_buf);
        }
        i++;
    }
    return cloned_body;
}

// Return 1 if the packed name refers to a safe target inside a
// candidate loop body: the induction variable, a loop-local auto, or
// a global whose storage class is GLOB_EXTRN / GLOB_GLOBAL. Function
// parameters and outer function-locals are rejected because the worker
// has no access to the main thread's stack frame, and GLOB_AUTO
// globals are rejected by contract.
static _fdc_name_is_safe(name_p, loop_var_p) {
    auto i, v, gi, cls;
    if (name_p == loop_var_p) { return 1; }
    if (packed_eq(name_p, loop_var_p)) { return 1; }
    for (i = 0; i < arr_len(_fdc_loop_locals); i++) {
        v = arr_get(_fdc_loop_locals, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
    }
    gi = dsp_find_global(name_p);
    if (gi >= 0) {
        cls = arr_get(glob_class, gi);
        if (cls == GLOB_EXTRN) { return 1; }
        if (cls == GLOB_GLOBAL) { return 1; }
    }
    // Outlining (P6 wire-up): accept caller-frame names that the
    // pre-walk added to `_fdc_captures`. The capture-collection
    // pass already filtered against the write-set, so anything in
    // this list is provably read-only during the loop. Stage 2 +
    // Stage 3 take care of publishing the value through the
    // capture struct so the worker can access it.
    for (i = 0; i < arr_len(_fdc_captures); i++) {
        v = arr_get(_fdc_captures, i);
        if (v == name_p) { return 1; }
        if (packed_eq(v, name_p)) { return 1; }
    }
    return 0;
}

// Return 1 if the packed value looks like a decimal or hex integer
// literal. Rejects strings (leading `"`) and float literals (any `.`).
// Inline here so the dispatch module does not need to reach into
// parser internals — parse_int_lit_value / is_int_lit_node are static.
static _fdc_is_int_lit(packed) {
    auto s, l, i;
    s = unpack_s(packed);
    l = unpack_l(packed);
    if (l == 0) { return 0; }
    if (peek(vbuf + s) == '"') { return 0; }
    for (i = 0; i < l; i++) {
        if (peek(vbuf + s + i) == '.') { return 0; }
    }
    return 1;
}

// Walk an AST subtree verifying that every reference, call, and
// statement inside it is dispatch-safe. Returns 1 when the subtree
// can run on a worker thread, 0 when anything unsafe appears.
//
// The checker is stricter than has_side_effects() above: it is not
// enough for an expression to be pure — every storage location it
// reads or writes must also be legal for a worker thread to touch.
//
// Self-recursive; no forward declaration needed (same pattern as
// contains_var above).
static _fdc_subtree_safe(nd, loop_var_p) {
    auto (n, p): Node;
    auto t, i, arr, cnt, name_p, callee_idx;
    if (nd == 0) { return 1; }
    n = nd;
    t = n.ntype;

    switch (t) {
    T_LIT, T_NOP, T_DECL { return 1; }
    T_BREAK, T_CONTINUE, T_RET { return 0; }
    T_VAR { return _fdc_name_is_safe(n.a, loop_var_p); }
    T_ASSIGN {
        p = n.a;
        if (p != 0) {
            if (p.ntype == T_VAR) {
                if (_fdc_name_is_safe(p.a, loop_var_p) == 0) { return 0; }
            } else {
                if (_fdc_subtree_safe(n.a, loop_var_p) == 0) { return 0; }
            }
        }
        return _fdc_subtree_safe(n.b, loop_var_p);
    }
    T_CALL {
        name_p = n.a;
        callee_idx = _dsp_find_func_idx(name_p);
        if (callee_idx >= 0) {
            // Accept callees that are EITHER:
            //   1. Compiler-classified PHASE_BASE (pure helper —
            //      lattice proved zero side effects)
            //   2. User-annotated `@safe` (programmer-claimed
            //      worker-safe — W026 already verified the call
            //      graph doesn't reach malloc/IO/GPU/blocking)
            //
            // Both are equivalent worker-safety signals. The first
            // is automatic, the second is opt-in. Together they
            // let game devs write natural `for (i ...)` loops over
            // `@safe` workers and get auto-parallelization without
            // hand-writing `job_parallel_for(N, fn_ptr(...))`.
            // The same @safe annotation that gates W026 verification
            // now ALSO unlocks smart-dispatch eligibility — no new
            // annotation invented (Rule 4 + Rule 28).
            auto _cp, _ch;
            _cp = arr_get(fn_phase, callee_idx);
            _ch = arr_get(fn_phase_hint, callee_idx);
            if (_cp != PHASE_BASE && _ch != PHASE_SAFE) { return 0; }
        } else {
            if (is_pure_extern(name_p) == 0) { return 0; }
        }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_fdc_subtree_safe(arr[i], loop_var_p) == 0) { return 0; }
        }
        return 1;
    }
    T_BINOP {
        if (_fdc_subtree_safe(n.b, loop_var_p) == 0) { return 0; }
        return _fdc_subtree_safe(n.c, loop_var_p);
    }
    T_TERNARY {
        if (_fdc_subtree_safe(n.a, loop_var_p) == 0) { return 0; }
        if (_fdc_subtree_safe(n.b, loop_var_p) == 0) { return 0; }
        return _fdc_subtree_safe(n.c, loop_var_p);
    }
    T_UNARY { return _fdc_subtree_safe(n.b, loop_var_p); }
    T_MEMLD { return _fdc_subtree_safe(n.a, loop_var_p); }
    T_ADDR  { return _fdc_subtree_safe(n.a, loop_var_p); }
    T_MEMST {
        if (_fdc_subtree_safe(n.a, loop_var_p) == 0) { return 0; }
        return _fdc_subtree_safe(n.b, loop_var_p);
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_fdc_subtree_safe(arr[i], loop_var_p) == 0) { return 0; }
        }
        return 1;
    }
    T_IF {
        if (_fdc_subtree_safe(n.a, loop_var_p) == 0) { return 0; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_fdc_subtree_safe(arr[i], loop_var_p) == 0) { return 0; }
        }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (_fdc_subtree_safe(arr[i], loop_var_p) == 0) { return 0; }
            }
        }
        return 1;
    }
    T_WHILE, T_SWITCH { return 0; }
    else { return 0; }
    }
    return 0;
}

// Sprint 2a: scan a body for a single `acc = acc OP val` reduction
// shape. Returns 1 on success and writes (_fdc_red_acc, _fdc_red_op);
// returns 0 when no reduction shape is present, the accumulator
// would be the loop variable, or more than one accumulator updates
// inside the body. The function does NOT verify the rest of the
// body — the caller temporarily admits the accumulator into the
// loop-locals set and re-runs `_fdc_subtree_safe` so the standard
// purity rules apply to everything except the accumulator's read /
// write.
//
// Recognised operators include `<<` and `>>` because the parser's
// Phase D strength reduction rewrites `acc * 2^k` into `acc << k`
// before this scanner runs — without admitting the shift form,
// `prod = prod * 2` would silently fall off the reduction radar.
// Sprint 2b's tree-reduce will translate the shift back to its
// multiplicative semantics when synthesising the worker.
static _fdc_find_reduction(body_arr, body_cnt, loop_var_p) {
    auto i, stmt: Node, lhs: Node, rhs: Node, rl: Node;
    auto op_ch, op_l, op_s, op_c1, found_count;
    found_count = 0;
    _fdc_red_acc = 0;
    _fdc_red_op  = 0;
    for (i = 0; i < body_cnt; i++) {
        stmt = body_arr[i];
        if (stmt == 0) { continue; }
        if (stmt.ntype != T_ASSIGN) { continue; }
        lhs = stmt.a;
        if (lhs.ntype != T_VAR) { continue; }
        rhs = stmt.b;
        if (rhs.ntype != T_BINOP) { continue; }
        // Accept single-char associative ops AND the two-char
        // shifts produced by the parser's strength-reduction pass.
        op_l  = unpack_l(rhs.a);
        op_s  = unpack_s(rhs.a);
        op_ch = peek(vbuf + op_s);
        if (op_l == 1) {
            if (op_ch != '+' && op_ch != '*' && op_ch != '&'
                && op_ch != '|' && op_ch != '^') { continue; }
        } else if (op_l == 2) {
            op_c1 = peek(vbuf + op_s + 1);
            if ((op_ch != '<' || op_c1 != '<')
                && (op_ch != '>' || op_c1 != '>')) { continue; }
        } else {
            continue;
        }
        rl = rhs.b;
        if (rl.ntype != T_VAR) { continue; }
        // The accumulator must appear on both sides of the assign
        // and must NOT be the loop induction variable.
        if (lhs.a != rl.a) {
            if (packed_eq(lhs.a, rl.a) == 0) { continue; }
        }
        if (lhs.a == loop_var_p) { continue; }
        if (packed_eq(lhs.a, loop_var_p)) { continue; }
        // Multiple accumulators reject — Sprint 2b's tree-reduce
        // runtime takes one identity per call.
        if (found_count > 0) {
            if (lhs.a != _fdc_red_acc) {
                if (packed_eq(lhs.a, _fdc_red_acc) == 0) { return 0; }
            }
        }
        _fdc_red_acc = lhs.a;
        _fdc_red_op  = rhs.a;
        found_count++;
    }
    return found_count > 0 ? 1 : 0;
}

// Evaluate a single T_WHILE node against every candidacy criterion.
// If every check passes, push the loop into the dispatch_candidates[]
// arrays. Side-effect only — caller treats it as void.
//
// `prev_stmt` is the statement immediately preceding the T_WHILE in
// its enclosing block; the scanner uses it to recover the for-loop
// init `i = K` and capture a non-zero start value (Gap 4). Pass 0
// when the T_WHILE is the first statement of the block.
static void _fdc_try_candidate(wh_p, fn_idx, prev_stmt) {
    auto (wh, cond, step): Node;
    auto (cond_lhs, cond_rhs): Node;
    auto (step_lhs, step_rhs, step_rhs_l, step_rhs_r): Node;
    auto body_arr, body_cnt, i, loop_var_p, bound_n;
    auto stmt: Node, darr, dcnt, k;
    auto start_val, stride_val;

    wh = wh_p;

    // A. Desugared for: node.e carries the step expression.
    if (wh.e == 0) { return; }
    step = wh.e;
    if (step.ntype != T_ASSIGN) { return; }

    // B. Step shape: i = i + K with K an integer literal. K = 1 is
    // the legacy fast path that the synthesiser actually parallelises
    // today; K > 1 lands in dispatch_candidates for visibility but
    // the rewriter / synthesiser skip them until job_parallel_for
    // grows a stride parameter.
    step_lhs = step.a;
    if (step_lhs.ntype != T_VAR) { return; }
    loop_var_p = step_lhs.a;
    step_rhs = step.b;
    if (step_rhs.ntype != T_BINOP) { return; }
    if (_fdc_op_char(step_rhs.a) != '+') { return; }
    step_rhs_l = step_rhs.b;
    step_rhs_r = step_rhs.c;
    if (step_rhs_l.ntype != T_VAR) { return; }
    if (step_rhs_l.a != loop_var_p) {
        if (packed_eq(step_rhs_l.a, loop_var_p) == 0) { return; }
    }
    if (step_rhs_r.ntype != T_LIT) { return; }
    if (_fdc_is_int_lit(step_rhs_r.a) == 0) { return; }
    stride_val = parse_int_lit_value(step_rhs_r.a);
    if (stride_val <= 0) { return; }

    // C. Condition shape: i < N with a safe N.
    cond = wh.a;
    if (cond.ntype != T_BINOP) { return; }
    if (_fdc_op_char(cond.a) != '<') { return; }
    cond_lhs = cond.b;
    cond_rhs = cond.c;
    if (cond_lhs.ntype != T_VAR) { return; }
    if (cond_lhs.a != loop_var_p) {
        if (packed_eq(cond_lhs.a, loop_var_p) == 0) { return; }
    }
    if (cond_rhs.ntype == T_LIT) {
        if (_fdc_is_int_lit(cond_rhs.a) == 0) { return; }
        bound_n = cond_rhs;
    } else {
        if (cond_rhs.ntype != T_VAR) { return; }
        if (_fdc_name_is_safe(cond_rhs.a, loop_var_p) == 0) { return; }
        bound_n = cond_rhs;
    }

    // D/E/F. Collect top-level loop-locals first so forward references
    // resolve as safe, then verify every statement is dispatch-safe.
    // Loop-locals declared in nested blocks are not collected, which
    // keeps the MVP conservative — such loops will simply be rejected.
    arr_clear(_fdc_loop_locals);
    arr_clear(_fdc_write_set);
    arr_clear(_fdc_captures);
    if (_fdc_capture_types != 0) { arr_clear(_fdc_capture_types); }
    body_arr = wh.b;
    body_cnt = wh.c;
    for (i = 0; i < body_cnt; i++) {
        stmt = body_arr[i];
        if (stmt != 0) {
            if (stmt.ntype == T_DECL) {
                darr = stmt.a; dcnt = stmt.b;
                for (k = 0; k < dcnt; k++) {
                    _fdc_loop_locals = arr_push(_fdc_loop_locals, darr[k]);
                }
            }
        }
    }
    // Outlining pre-walk: compute the write-set (names mutated
    // directly in the body) and the captures list (free vars not
    // mutated, that the outlining transformation will carry across
    // worker frames via a capture struct). Both must be computed
    // BEFORE the safety walk, because `_fdc_name_is_safe` consults
    // the captures list as a positive acceptance signal.
    for (i = 0; i < body_cnt; i++) {
        _fdc_collect_writes(body_arr[i]);
    }
    for (i = 0; i < body_cnt; i++) {
        _fdc_collect_captures(body_arr[i], loop_var_p);
    }
    // Outlining is only feasible when the runtime helper
    // `job_parallel_for_data` is available — that requires the
    // program to import `bpp_job.bsm` (which also defines the
    // `_outline_cap_ptr` global the synth body references). If the
    // helper isn't available, clear the captures list so the
    // safety walk reverts to the original parent-frame-strict
    // behaviour (rejects loops that need outlining). The candidate
    // simply stays serial without producing an unresolvable
    // synth function.
    if (arr_len(_fdc_captures) > 0) {
        if (_dsp_find_func_idx(_dsp_pack_name("job_parallel_for_data", 21)) < 0) {
            arr_clear(_fdc_captures);
        }
    }
    // First trial: MAP candidate — every statement must be
    // dispatch-safe under the standard purity rules.
    auto is_map_safe;
    is_map_safe = 1;
    for (i = 0; i < body_cnt; i++) {
        if (_fdc_subtree_safe(body_arr[i], loop_var_p) == 0) {
            is_map_safe = 0;
            i = body_cnt;
        }
    }

    auto reduce_var, reduce_op_ch;
    reduce_var   = 0;
    reduce_op_ch = 0;

    if (is_map_safe == 0) {
        // Second trial: REDUCTION. Find the accumulator, admit it
        // to the loop-locals set, and re-run the safety check so
        // the rest of the body is held to the same rules. Pop the
        // accumulator off the set whether or not the trial passes,
        // so the next candidate scan starts clean.
        if (_fdc_find_reduction(body_arr, body_cnt, loop_var_p) == 0) { return; }
        _fdc_loop_locals = arr_push(_fdc_loop_locals, _fdc_red_acc);
        auto red_safe;
        red_safe = 1;
        for (i = 0; i < body_cnt; i++) {
            if (_fdc_subtree_safe(body_arr[i], loop_var_p) == 0) {
                red_safe = 0;
                i = body_cnt;
            }
        }
        // Pop the accumulator back off so subsequent candidates do
        // not inherit it as a "safe" name.
        arr_pop(_fdc_loop_locals);
        if (red_safe == 0) { return; }
        // Outlining is only supported on the MAP path. The reduction
        // synthesiser generates a custom body (`_dsp_build_red_body`)
        // that doesn't go through the capture-rewrite plumbing, so
        // reduction candidates that ALSO need captures would emit
        // synth bodies referencing caller-frame names with no
        // backing slot. Reject the candidate entirely until reduction
        // outlining is a separate sidequest.
        if (arr_len(_fdc_captures) > 0) { return; }
        reduce_var   = _fdc_red_acc;
        reduce_op_ch = _fdc_red_op;
    }

    // Recover the loop's start value from the init that preceded
    // the T_WHILE: `i = K`. Default 0 when the init is missing,
    // non-literal, or assigns to a different variable. Storing the
    // start lets --dispatch tell the user the loop is recognised
    // even if the rewriter has to pass on the actual parallel
    // promotion until runtime support lands.
    start_val = 0;
    if (prev_stmt != 0) {
        auto (init, init_lhs, init_rhs): Node;
        init = prev_stmt;
        if (init.ntype == T_ASSIGN) {
            init_lhs = init.a;
            init_rhs = init.b;
            if (init_lhs.ntype == T_VAR) {
                if (init_lhs.a == loop_var_p
                    || packed_eq(init_lhs.a, loop_var_p)) {
                    if (init_rhs.ntype == T_LIT) {
                        if (_fdc_is_int_lit(init_rhs.a)) {
                            start_val = parse_int_lit_value(init_rhs.a);
                        }
                    }
                }
            }
        }
    }

    // Outlining (capture-driven) gate: the loop has caller-frame
    // captures, so emitting a dispatch worker requires capturing
    // them in a struct and passing the address. The host function
    // must be `@safe`-annotated to opt into this transformation —
    // otherwise the host might be reached from a signal-handler /
    // interrupt context where job_parallel_for_data cannot legally
    // spawn workers (e.g. SIGPROF handlers in bpp_runtime).
    // Capture-driven outlining gate (a6fa70a) + MAP gate extension
    // (this commit): both flavors of dispatch now require the host
    // function to be `@safe`-annotated. Without that, the matcher's
    // existing body-call check (PHASE_BASE / PHASE_SAFE on callees)
    // is insufficient — it accepts T_MEMST stores to globals that
    // produce indexed writes (safe per-iter) but the SURROUNDING
    // module state (allocator, GPU pipeline, audio ring, font
    // glyph atlas, etc.) gets touched indirectly through the same
    // host fn's other call sites. Game adoption observed regressions
    // (snake yellow dot, fps magenta overlay) when stb hot loops
    // started running parallel without their hosts being @safe-
    // audited. Tightening this to `host must be @safe` makes the
    // doctrine consistent — the annotation is the explicit
    // programmer contract for "worker-pool-safe at the function
    // level", not just the loop level.
    if (arr_get(fn_phase_hint, fn_idx) != PHASE_SAFE) {
        arr_clear(_fdc_captures);
        return;
    }

    // W032 retired (2026-05-25). The diagnostic existed to surface
    // every parallelized loop for programmer audit, but the strict
    // @safe gate above (`if (... != PHASE_SAFE) { return; }`) IS the
    // audit gate: only hosts that explicitly opt in via `@safe` reach
    // this point, and the annotation is the programmer's contract
    // for "worker-pool-safe at the function level". Firing a build-
    // time warning on every accepted candidate added noise (e.g.
    // FPS's `wolf_ai_tick_cooldowns @safe` shouted a warning on every
    // build) without catching any new bug class. Use `--dispatch`
    // for an explicit candidate dump when investigating.

    // All criteria met — record the candidate.
    dispatch_candidates = arr_push(dispatch_candidates, wh_p);
    dispatch_cand_fn_idx = arr_push(dispatch_cand_fn_idx, fn_idx);
    dispatch_cand_loop_var = arr_push(dispatch_cand_loop_var, loop_var_p);
    dispatch_cand_bound = arr_push(dispatch_cand_bound, bound_n);
    dispatch_cand_start = arr_push(dispatch_cand_start, start_val);
    dispatch_cand_stride = arr_push(dispatch_cand_stride, stride_val);
    dispatch_cand_reduce_var = arr_push(dispatch_cand_reduce_var, reduce_var);
    dispatch_cand_reduce_op  = arr_push(dispatch_cand_reduce_op,  reduce_op_ch);
    // Outlining capture struct index — synth the struct from
    // `_fdc_captures` if any free vars survived the write-set
    // filter, otherwise -1 (no outlining for this candidate).
    auto _cap_sidx;
    _cap_sidx = 0 - 1;
    if (arr_len(_fdc_captures) > 0) {
        _cap_sidx = _outline_synth_capture_struct();
    }
    dispatch_cand_capture_idx = arr_push(dispatch_cand_capture_idx, _cap_sidx);
    // Autovec P2 (2026-05-22) — classify the candidate's body
    // against the pattern matcher and store the pattern ordinal
    // in the parallel array. P5 (code emission) reads this
    // ordinal to decide whether to emit a SIMD vector loop +
    // scalar tail in place of the original body.
    auto _av_p;
    _av_p = _av_classify_body(body_arr, body_cnt, loop_var_p);
    _av_pattern = arr_push(_av_pattern, _av_p);
}

// Scan every parsed function body and record every top-level for-loop
// that qualifies for smart dispatch. Must run AFTER promote_globals()
// so glob_class[] reflects the final storage-class decisions.
void find_dispatch_candidates() {
    auto i, fn_rec, body_arr, body_cnt, j;
    auto stmt: Node;

    if (dispatch_candidates == 0) { dispatch_candidates = arr_new(); }
    else { arr_clear(dispatch_candidates); }
    if (dispatch_cand_fn_idx == 0) { dispatch_cand_fn_idx = arr_new(); }
    else { arr_clear(dispatch_cand_fn_idx); }
    if (dispatch_cand_loop_var == 0) { dispatch_cand_loop_var = arr_new(); }
    else { arr_clear(dispatch_cand_loop_var); }
    if (dispatch_cand_bound == 0) { dispatch_cand_bound = arr_new(); }
    else { arr_clear(dispatch_cand_bound); }
    if (dispatch_cand_synth_idx == 0) { dispatch_cand_synth_idx = arr_new(); }
    else { arr_clear(dispatch_cand_synth_idx); }
    if (dispatch_cand_synth_name == 0) { dispatch_cand_synth_name = arr_new(); }
    else { arr_clear(dispatch_cand_synth_name); }
    if (dispatch_cand_start == 0) { dispatch_cand_start = arr_new(); }
    else { arr_clear(dispatch_cand_start); }
    if (dispatch_cand_stride == 0) { dispatch_cand_stride = arr_new(); }
    else { arr_clear(dispatch_cand_stride); }
    if (dispatch_cand_reduce_var == 0) { dispatch_cand_reduce_var = arr_new(); }
    else { arr_clear(dispatch_cand_reduce_var); }
    if (dispatch_cand_reduce_op == 0) { dispatch_cand_reduce_op = arr_new(); }
    else { arr_clear(dispatch_cand_reduce_op); }
    if (_fdc_loop_locals == 0) { _fdc_loop_locals = arr_new(); }
    if (_fdc_captures == 0) { _fdc_captures = arr_new(); }
    if (_fdc_write_set == 0) { _fdc_write_set = arr_new(); }
    if (dispatch_cand_capture_idx == 0) { dispatch_cand_capture_idx = arr_new(); }
    else { arr_clear(dispatch_cand_capture_idx); }
    if (_av_pattern == 0) { _av_pattern = arr_new(); }
    else { arr_clear(_av_pattern); }

    for (i = 0; i < func_cnt; i++) {
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);
        // Cached functions carry no AST to inspect.
        if (body_arr == 0) { continue; }
        // MVP scope: only top-level for-loops in the function body.
        // Nested fors inside branches stay serial until the MVP proves
        // the architecture on snake_maestro.
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) {
                if (stmt.ntype == T_WHILE) {
                    auto prev;
                    prev = j > 0 ? body_arr[j - 1] : 0;
                    _fdc_try_candidate(stmt, i, prev);
                }
            }
        }
    }
}

// True if `wh_p` (a T_WHILE node) is one of the accepted entries in
// `dispatch_candidates`. Linear scan — the candidate list is small
// (a handful of loops per program, not thousands), so this is cheap
// relative to the AST walk that built it.
static _dsp_while_in_candidates(wh_p) {
    auto k, n;
    n = arr_len(dispatch_candidates);
    for (k = 0; k < n; k++) {
        if (arr_get(dispatch_candidates, k) == wh_p) { return 1; }
    }
    return 0;
}

// W033 — an `@safe` function contains a loop shaped for auto-dispatch
// (same loose, body-safety-free shape check as the prescan above:
// ascending `i = i + K` with K > 0 literal, condition `i < bound`)
// that never made it into `dispatch_candidates` at all. The `@safe`
// annotation promised "this loop can run on a worker"; something in
// the body (a global `promote_globals` did not promote, an impure
// call, an unsupported sub-shape) silently kept it serial, and
// without this warning the only way to learn that was to already know
// to pass `--dispatch` — exactly the trap `bench_autovec_compute.bpp`
// fell into (`[dispatch] 0 candidate loop(s)`, discovered only by
// disassembly, not by any compiler feedback).
//
// Deliberately does NOT fire for a loop that WAS accepted into
// `dispatch_candidates` and a later stage chose to keep it serial on
// purpose — the N-below-floor guards in `rewrite_dispatch_loops`
// (`_DSP_MAP_MIN_N`, `_OUTLINE_MIN_N`) are the compiler correctly
// deciding dispatch isn't worth it for a small trip count, not a bug
// to report. Only "never became a candidate at all" is in scope —
// per Tonify Rule 28, a diagnostic earns its keep by catching one
// specific, well-understood class of surprise, not by flagging every
// loop the optimizer declined to touch.
//
// ALSO skips any function whose address is taken (`fn_address_taken`)
// — that means it's already registered as a callback / job target
// elsewhere (CoreAudio's `fn_ptr(_aud_square_cb)`, `job_submit(fn_ptr
// (particle_base_job), ...)`), so `@safe` there is doing the W026
// bounded-contract job, not promising "this loop gets auto-dispatched."
// Real, audited examples this exclusion was written FOR: both
// `_stb_audio_macos.bsm` callbacks and `games/snake/particles.bsm`'s
// `particle_base_job` — confirmed false positives during this
// feature's own verification pass, not a hypothetical.
void warn_unfired_safe_loops() {
    auto i, fn_rec, body_arr, body_cnt, j, stmt: Node;
    for (i = 0; i < func_cnt; i++) {
        if (arr_get(fn_phase_hint, i) != PHASE_SAFE) { continue; }
        if (arr_get(fn_address_taken, i) != 0) { continue; }
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);
        if (body_arr == 0) { continue; }
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) {
                if (stmt.ntype == T_WHILE) {
                    if (_dsp_prescan_loop_shape_ok(stmt)) {
                        if (_dsp_while_in_candidates(stmt) == 0) {
                            diag_warn(33);
                            diag_str("'@safe' function '");
                            diag_packed(*(fn_rec + FN_NAME));
                            diag_str("' has a loop shaped for auto-dispatch but it never qualified");
                            diag_newline();
                            diag_loc(*(fn_rec + FN_SRC_TOK));
                            diag_show_line(*(fn_rec + FN_SRC_TOK));
                            diag_str("  = note: the loop's step/condition shape matched, but its body");
                            diag_newline();
                            diag_str("          was rejected (an unpromoted global, an impure call, or");
                            diag_newline();
                            diag_str("          an unsupported sub-shape)");
                            diag_newline();
                            diag_str("  = help: run `bpp --dispatch` for the full candidate list and");
                            diag_newline();
                            diag_str("          `--show-promotions` to see which global blocked it");
                            diag_newline();
                            diag_str("  = see:  docs/manual/how_to_dev_b++.md Section 5.6 (outlining)");
                            diag_newline();
                        }
                    }
                }
            }
        }
    }
}

// Print the dispatch-candidate list to stderr. Triggered by the flag
// `--dispatch`. Pure visibility for Stage 1 — no code generation
// changes, the programmer simply sees which loops Stage 2 will
// synthesize and Stage 3 will rewrite into job_parallel_for calls.
void show_dispatch_candidates() {
    auto n, i, wh: Node, fi, fname, bound: Node;

    n = arr_len(dispatch_candidates);
    diag_str("[dispatch] ");
    diag_int(n);
    diag_str(" candidate loop(s)");
    diag_newline();

    for (i = 0; i < n; i++) {
        wh = arr_get(dispatch_candidates, i);
        fi = arr_get(dispatch_cand_fn_idx, i);
        fname = *(funcs[fi] + FN_NAME);
        bound = arr_get(dispatch_cand_bound, i);
        auto sv, st;
        sv = arr_get(dispatch_cand_start,  i);
        st = arr_get(dispatch_cand_stride, i);
        diag_str("  ");
        diag_packed(fname);
        diag_str(": for (");
        diag_packed(arr_get(dispatch_cand_loop_var, i));
        diag_str(" = "); diag_int(sv); diag_str("; ");
        diag_packed(arr_get(dispatch_cand_loop_var, i));
        diag_str(" < ");
        diag_packed(bound.a);
        diag_str("; ");
        diag_packed(arr_get(dispatch_cand_loop_var, i));
        diag_str(" = ");
        diag_packed(arr_get(dispatch_cand_loop_var, i));
        diag_str(" + "); diag_int(st); diag_str(")");
        // Note when the candidate is detection-only — runtime
        // job_parallel_for handles the [0, N) stride-1 MAP case today.
        auto rv, rop;
        rv  = arr_get(dispatch_cand_reduce_var, i);
        rop = arr_get(dispatch_cand_reduce_op,  i);
        if (rv != 0) {
            // Sprint 2b parallelises the additive op end-to-end via
            // job_parallel_reduce; non-additive ops detect but stay
            // serial until the synthesiser learns their identity element.
            auto rop_l, rop_ch;
            rop_l = unpack_l(rop);
            rop_ch = peek(vbuf + unpack_s(rop));
            diag_str("  [REDUCTION acc=");
            diag_packed(rv);
            diag_str(" op=");
            diag_packed(rop);
            if (rop_l == 1 && rop_ch == '+') {
                diag_str(" — parallel: tree-reduce via job_parallel_reduce]");
            } else {
                diag_str(" — serial: only `+` parallelises in Sprint 2b]");
            }
        } else if (sv != 0 || st != 1) {
            diag_str("  [serial: runtime stride/start support pending]");
        }
        diag_newline();
    }
}

// ── Phase 2: Stage 2 — worker function synthesis ──────────
//
// For every candidate recorded by find_dispatch_candidates(), create
// a fresh top-level function whose body is the loop body and whose
// single parameter is the induction variable. Register the new
// function in funcs[] and extend every parallel array used by the
// codegen pipeline.
//
// Stage 2 does NOT rewrite the original loop yet. The synthesized
// function is orphaned — fn_reachable[] stays 0 so the emitter will
// not produce code for it, and fn_address_taken[] is 1 so Stage 3
// can safely call fn_ptr() on it. Running Stage 2 in isolation is
// therefore a no-op at runtime: funcs[] grows but nothing new gets
// emitted, and the bootstrap must still produce byte-identical output.
//
// The loop body array is SHARED, not deep-copied. Every AST node
// lives in the global AST arena and persists for the lifetime of the
// compiler process. Stage 3 will replace the original T_WHILE node
// with a T_CALL to job_parallel_for, at which point the body array
// is effectively donated to the synthesized function. No other pass
// depends on the T_WHILE node continuing to exist in its original
// slot.
//
// Why the induction variable does not need rewriting: parameter
// lookup is lexical per function. Once the synthesized function
// declares `i` as its first parameter, every T_VAR node inside the
// body that references `i` resolves against the synth function's
// stack slot at codegen time, regardless of any `auto i;` sitting in
// the enclosing function.

// ── AST helpers for reduction synthesis (Sprint 2b) ──────────
//
// The reduction synthesiser builds a chunk-worker function from
// scratch, and the rewriter replaces the candidate T_WHILE with a
// reduce-and-combine block. Both jobs need raw AST construction
// helpers that the parser keeps file-local. Reproduced here so
// the dispatch module stays self-contained.

// Pack a one-character operator into vbuf and return its packed
// reference. Mirrors `_make_op_char` in bpp_parser.bsm.
static _dsp_op_char(ch) {
    auto p;
    p = pack(vbuf_pos, 1);
    poke(vbuf + vbuf_pos, ch);
    vbuf_pos++;
    return p;
}

// Build a T_VAR node referencing the packed identifier `name_p`.
static _dsp_make_var(name_p) {
    auto n: Node;
    n = make_node(T_VAR);
    n.a = name_p;
    return n;
}

// Build a T_LIT node holding the decimal integer `val`. Negative
// values are wrapped in T_UNARY('-') over the absolute literal,
// matching the parser's `make_int_lit` shape.
static _dsp_make_int_lit(val) {
    auto n: Node, u: Node, start, v, digits, tmp, i;
    if (val < 0) {
        u = make_node(T_UNARY);
        u.a = _dsp_op_char('-');
        u.b = _dsp_make_int_lit(0 - val);
        return u;
    }
    start = vbuf_pos;
    if (val == 0) {
        poke(vbuf + vbuf_pos, '0');
        vbuf_pos++;
    } else {
        v = val;
        digits = 0;
        tmp = v;
        while (tmp > 0) { digits++; tmp /= 10; }
        vbuf_pos += digits;
        tmp = v;
        for (i = 0; i < digits; i++) {
            poke(vbuf + vbuf_pos - 1 - i, '0' + tmp % 10);
            tmp /= 10;
        }
    }
    n = make_node(T_LIT);
    n.a = pack(start, vbuf_pos - start);
    return n;
}

// Build a T_BINOP node with single-character operator `op_ch`.
static _dsp_make_binop(op_ch, lhs, rhs) {
    auto n: Node;
    n = make_node(T_BINOP);
    n.a = _dsp_op_char(op_ch);
    n.b = lhs;
    n.c = rhs;
    return n;
}

// Build a T_BINOP node from an arbitrary packed operator (used to
// preserve the original reduction op verbatim, including `<<`/`>>`).
static _dsp_make_binop_p(op_p, lhs, rhs) {
    auto n: Node;
    n = make_node(T_BINOP);
    n.a = op_p;
    n.b = lhs;
    n.c = rhs;
    return n;
}

// Build a T_ASSIGN node for `lhs_p_or_node = rhs_node`. The lhs
// argument is taken as a Node*, matching the parser convention so
// callers can pass either a fresh T_VAR or a deeper memory store
// expression. For T_MEMST callers should construct that directly.
static _dsp_make_assign(lhs_node, rhs_node) {
    auto n: Node;
    n = make_node(T_ASSIGN);
    n.a = lhs_node;
    n.b = rhs_node;
    return n;
}

// Build a T_MEMLD node for `*(addr_node)`, with no field hint.
static _dsp_make_memld(addr_node) {
    auto n: Node;
    n = make_node(T_MEMLD);
    n.a = addr_node;
    n.b = 0;
    return n;
}

// Build a T_MEMST node for `*(addr_node) = val_node`, no field hint.
static _dsp_make_memst(addr_node, val_node) {
    auto n: Node;
    n = make_node(T_MEMST);
    n.a = addr_node;
    n.b = val_node;
    n.c = 0;
    return n;
}

// Walk an AST subtree and replace every T_VAR with a.packed == old_p
// by a T_VAR with a.packed == new_p. Used to retarget the user's
// accumulator name to a fresh local inside the synthesised worker.
// Mutates in place — the caller must own the subtree (which is true
// for the original loop body once the rewriter detaches it).
static void _dsp_rename_var(nd, old_p, new_p) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return; }
    n = nd;
    t = n.ntype;
    if (t == T_VAR) {
        if (n.a == old_p || packed_eq(n.a, old_p)) {
            n.a = new_p;
        }
        return;
    }
    if (t == T_LIT || t == T_NOP || t == T_BREAK || t == T_CONTINUE) { return; }
    if (t == T_DECL) {
        // Loop-locals inside the body. Renaming the declared name
        // would corrupt the symbol table for shadowed cases. The
        // detector already guarantees the accumulator is not declared
        // here (it lives in the enclosing scope), so this branch is
        // a no-op — leave the declared names alone.
        return;
    }
    if (t == T_ASSIGN || t == T_MEMST) {
        _dsp_rename_var(n.a, old_p, new_p);
        _dsp_rename_var(n.b, old_p, new_p);
        return;
    }
    if (t == T_MEMLD || t == T_ADDR || t == T_UNARY) {
        _dsp_rename_var(n.a, old_p, new_p);
        if (t == T_UNARY) { _dsp_rename_var(n.b, old_p, new_p); }
        return;
    }
    if (t == T_BINOP) {
        _dsp_rename_var(n.b, old_p, new_p);
        _dsp_rename_var(n.c, old_p, new_p);
        return;
    }
    if (t == T_TERNARY) {
        _dsp_rename_var(n.a, old_p, new_p);
        _dsp_rename_var(n.b, old_p, new_p);
        _dsp_rename_var(n.c, old_p, new_p);
        return;
    }
    if (t == T_CALL) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            _dsp_rename_var(arr[i], old_p, new_p);
        }
        return;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            _dsp_rename_var(arr[i], old_p, new_p);
        }
        return;
    }
    if (t == T_IF) {
        _dsp_rename_var(n.a, old_p, new_p);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _dsp_rename_var(arr[i], old_p, new_p); }
        arr = n.d; cnt = n.e;
        for (i = 0; i < cnt; i++) { _dsp_rename_var(arr[i], old_p, new_p); }
        return;
    }
    if (t == T_WHILE) {
        _dsp_rename_var(n.a, old_p, new_p);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _dsp_rename_var(arr[i], old_p, new_p); }
        if (n.e != 0) { _dsp_rename_var(n.e, old_p, new_p); }
        return;
    }
}

// Identity element for the supported reduction operators. Returns 0
// for sums and bitwise-or/xor, 1 for products, and -1 (all bits set)
// for bitwise-and. Sprint 2b parallelises the additive case end-to-end;
// non-additive ops still detect but stay serial until the synthesiser
// learns their shape (tree-reduce shifts, in particular, need extra
// bookkeeping). Returns sentinel `-2` for unsupported ops so the
// caller can fall back gracefully. Pure helper — no side effects.
static _dsp_red_identity_for(op_ch) {
    if (op_ch == '+') { return 0; }
    if (op_ch == '|') { return 0; }
    if (op_ch == '^') { return 0; }
    if (op_ch == '*') { return 1; }
    if (op_ch == '&') { return 0 - 1; }
    return 0 - 2;
}

// Materialise a fresh packed name in vbuf. Used for the synthetic
// locals introduced by the reduction synthesiser (`__racc`, `__rstart`,
// `__rend`, `__rk`, `__cid`). Caller owns the C-string literal.
static _dsp_pack_local(s, l) {
    auto start, i;
    start = vbuf_pos;
    for (i = 0; i < l; i++) {
        poke(vbuf + vbuf_pos, str_peek(s, i));
        vbuf_pos++;
    }
    return pack(start, l);
}

// Monotonic counter used to produce unique synthetic names across all
// candidates discovered in a single compilation.
static auto _synth_counter;

// Lazy-cached packed names for the chunk metadata buffers and the
// partial-result buffer that live in bpp_job.bsm. The synth bodies
// reference these by name; resolved once per compilation so the
// vbuf does not balloon when many reductions land in one program.
// Written exactly once by `_dsp_red_lazy_init` — write-once-after-init
// matches Rule 1's `extrn` storage class.
extrn _dsp_disp_chunk_start_p;
extrn _dsp_disp_chunk_end_p;
extrn _dsp_disp_partials_p;
extrn _dsp_jpr_name_p;
extrn _dsp_red_locals_inited;

// Initialise the cached packed names. Called once on the first
// reduction candidate the synthesiser actually parallelises.
static void _dsp_red_lazy_init() {
    if (_dsp_red_locals_inited != 0) { return; }
    _dsp_disp_chunk_start_p = _dsp_pack_local("_disp_chunk_start", 17);
    _dsp_disp_chunk_end_p   = _dsp_pack_local("_disp_chunk_end",   15);
    _dsp_disp_partials_p    = _dsp_pack_local("_disp_partials",    14);
    _dsp_jpr_name_p         = _dsp_pack_local("job_parallel_reduce", 19);
    _dsp_red_locals_inited = 1;
}

// Build `*(buf_p + idx_var_p * 8)` as a T_MEMLD over a synthesised
// address expression. Used by the reduction synthesiser to read its
// chunk's start / end indices from the metadata buffers.
static _dsp_make_indexed_load(buf_p, idx_var_p) {
    auto addr;
    addr = _dsp_make_binop('+',
        _dsp_make_var(buf_p),
        _dsp_make_binop('*',
            _dsp_make_var(idx_var_p),
            _dsp_make_int_lit(8)));
    return _dsp_make_memld(addr);
}

// Build `*(buf_p + idx_var_p * 8) = val_node` as a T_MEMST. Used by
// the reduction synthesiser to write its partial back to the global
// partials buffer at the slot keyed by the chunk id.
static _dsp_make_indexed_store(buf_p, idx_var_p, val_node) {
    auto addr;
    addr = _dsp_make_binop('+',
        _dsp_make_var(buf_p),
        _dsp_make_binop('*',
            _dsp_make_var(idx_var_p),
            _dsp_make_int_lit(8)));
    return _dsp_make_memst(addr, val_node);
}

// Construct the synth-worker body for an additive reduction. Returns
// a freshly-allocated array of statement Node*s of length `out_cnt`,
// caller stores it as the synth function's body. The original loop
// body is detached from `wh.b` and embedded as the inner T_WHILE's
// body — every reference to `acc_p` inside it is renamed to a fresh
// local accumulator so the worker writes into per-chunk state, not
// the user-visible accumulator.
//
// Layout produced (acc=`__racc`, cid=`__cid`, lv=original loop var):
//
//   T_DECL [__racc, __rstart, __rend, lv]
//   __rstart = *(_disp_chunk_start + __cid * 8)
//   __rend   = *(_disp_chunk_end   + __cid * 8)
//   __racc   = identity_for(op)
//   lv       = __rstart
//   while (lv < __rend) { <renamed body>; lv = lv + 1; }
//   *(_disp_partials + __cid * 8) = __racc
//
// `out_cnt` receives the produced statement count via a small bridge
// global because B++ has no out-parameters; the caller reads it
// immediately after invocation.
static auto _dsp_red_body_cnt;
static _dsp_build_red_body(wh_p, loop_var_p, acc_p, op_ch, cid_p) {
    auto wh: Node, body_arr;
    auto racc_p, rstart_p, rend_p;
    auto decl: Node, decl_arr;
    auto (rstart_assign, rend_assign): Node;
    auto (racc_assign, lv_assign): Node;
    auto (cond, step, inner_while): Node;
    auto write_partial: Node;
    auto stmts;

    wh = wh_p;
    body_arr = wh.b;

    // Rename the user accumulator to a fresh local so worker writes
    // never touch the main thread's variable. Mutates the original
    // body in place — safe because the rewriter is about to replace
    // the source T_WHILE entirely.
    racc_p   = _dsp_pack_local("__racc",   6);
    rstart_p = _dsp_pack_local("__rstart", 8);
    rend_p   = _dsp_pack_local("__rend",   6);
    auto bc, j;
    bc = wh.c;
    for (j = 0; j < bc; j++) {
        _dsp_rename_var(body_arr[j], acc_p, racc_p);
    }

    // T_DECL [__racc, __rstart, __rend, loop_var]. The loop variable
    // is included here even though the source function already
    // declares it — the synth function is its own scope, so the
    // induction var is a fresh local for this body.
    decl_arr = malloc(32);
    *(decl_arr     ) = racc_p;
    *(decl_arr +  8) = rstart_p;
    *(decl_arr + 16) = rend_p;
    *(decl_arr + 24) = loop_var_p;
    decl = make_node(T_DECL);
    decl.a = decl_arr;
    decl.b = 4;
    decl.c = 0;
    decl.d = 0;
    decl.e = 0;

    // __rstart = *(_disp_chunk_start + __cid * 8)
    rstart_assign = _dsp_make_assign(
        _dsp_make_var(rstart_p),
        _dsp_make_indexed_load(_dsp_disp_chunk_start_p, cid_p));

    // __rend = *(_disp_chunk_end + __cid * 8)
    rend_assign = _dsp_make_assign(
        _dsp_make_var(rend_p),
        _dsp_make_indexed_load(_dsp_disp_chunk_end_p, cid_p));

    // __racc = identity_for(op)
    racc_assign = _dsp_make_assign(
        _dsp_make_var(racc_p),
        _dsp_make_int_lit(_dsp_red_identity_for(op_ch)));

    // loop_var = __rstart
    lv_assign = _dsp_make_assign(
        _dsp_make_var(loop_var_p),
        _dsp_make_var(rstart_p));

    // while (loop_var < __rend) { <renamed body>; loop_var = loop_var + 1; }
    cond = _dsp_make_binop('<',
        _dsp_make_var(loop_var_p),
        _dsp_make_var(rend_p));
    step = _dsp_make_assign(
        _dsp_make_var(loop_var_p),
        _dsp_make_binop('+', _dsp_make_var(loop_var_p), _dsp_make_int_lit(1)));
    inner_while = make_node(T_WHILE);
    inner_while.a = cond;
    inner_while.b = body_arr;
    inner_while.c = wh.c;
    inner_while.d = 0;
    inner_while.e = step;

    // *(_disp_partials + __cid * 8) = __racc
    write_partial = _dsp_make_indexed_store(
        _dsp_disp_partials_p, cid_p, _dsp_make_var(racc_p));

    // Pack the seven top-level statements into a heap array the
    // function record can hold via FN_BODY / FN_BCNT.
    stmts = malloc(7 * 8);
    *(stmts     ) = decl;
    *(stmts +  8) = rstart_assign;
    *(stmts + 16) = rend_assign;
    *(stmts + 24) = racc_assign;
    *(stmts + 32) = lv_assign;
    *(stmts + 40) = inner_while;
    *(stmts + 48) = write_partial;

    _dsp_red_body_cnt = 7;
    return stmts;
}

// ── Capture-local name minting ────────────────────────────
// Each Stage 3 rewrite that needs captures introduces a fresh
// stack-allocated variable `_cap_local_K` typed as the matching
// `_capture_K` struct. Counter mirrors `_synth_counter` shape.

static auto _outline_cap_local_counter;

static _outline_make_cap_local_name() {
    auto start, n, tmp, digits, i;
    start = vbuf_pos;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'c'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'a'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'p'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'l'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'o'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'c'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'a'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'l'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    n = _outline_cap_local_counter;
    if (n == 0) {
        poke(vbuf + vbuf_pos, '0'); vbuf_pos++;
    } else {
        tmp = n;
        digits = 0;
        while (tmp > 0) { digits++; tmp /= 10; }
        vbuf_pos += digits;
        tmp = n;
        for (i = 0; i < digits; i++) {
            poke(vbuf + vbuf_pos - 1 - i, '0' + tmp % 10);
            tmp /= 10;
        }
    }
    _outline_cap_local_counter++;
    return pack(start, vbuf_pos - start);
}

// Mutate a T_WHILE node into a T_BLOCK that publishes the captures
// and then calls the outlined worker via `job_parallel_for_data`.
//
// The generated block has the shape:
//
//   {
//       var _cap_local_K: _capture_K;
//       *(_cap_local_K + off_0) = captured_value_0;
//       *(_cap_local_K + off_1) = captured_value_1;
//       ...
//       job_parallel_for_data(N, fn_ptr(synth), &_cap_local_K);
//   }
//
// The struct is stack-allocated (var keyword) so it lives until the
// enclosing block returns — and `job_parallel_for_data` blocks until
// `job_wait_all` returns, so workers always see a live struct.
//
// Each field assignment uses T_MEMST through `_cap_local_K + offset`
// (raw pointer + integer offset) — mirrors the parser's
// dot-assignment lowering and avoids any per-field hint translation.
//
// Returns 1 on success (wh mutated into T_BLOCK), 0 if the runtime
// helper `job_parallel_for_data` is not available (caller falls back
// to the original `job_parallel_for` rewrite without captures).
static _outline_rewrite_with_captures(wh, sidx, synth_name, bound_n, src_fi, jpf_data_idx, jpf_data_name, fnptr_name) {
    auto wh_node: Node;
    auto cap_local_name, captures_cnt, i, off;
    auto cap_name, val_var: Node, cap_var: Node;
    auto plus_op, addr_expr: Node, memst_node: Node;
    auto decl: Node, name_arr;
    auto stmts, stmt_count;
    auto synth_var: Node, inner_args, addr_of_cap: Node;
    auto fnptr_call: Node, outer_args, call_node: Node;
    auto callees;
    wh_node = wh;
    if (jpf_data_idx < 0) { return 0; }
    // `_fdc_captures` was cleared by the next `_fdc_try_candidate`
    // call; recover the captures list from the struct that
    // `_outline_synth_capture_struct` left behind.
    _outline_restore_captures_from_struct(sidx);
    captures_cnt = arr_len(_fdc_captures);
    if (captures_cnt == 0) { return 0; }
    cap_local_name = _outline_make_cap_local_name();
    set_var_type(cap_local_name, sidx);
    // Build T_DECL for the stack struct.
    name_arr = malloc(8);
    *name_arr = cap_local_name;
    decl = make_node(T_DECL);
    decl.a = name_arr;
    decl.b = 1;
    decl.c = 0x08;       // TY_STRUCT
    decl.d = 1;          // var = stack-allocated
    // Allocate statement array: 1 decl + N field-publishes + 1 call.
    stmts = malloc((captures_cnt + 2) * 8);
    *stmts = decl;
    stmt_count = 1;
    // Emit `*(_cap_local + off) = value` per captured name.
    i = 0;
    while (i < captures_cnt) {
        cap_name = arr_get(_fdc_captures, i);
        off = get_field_offset(sidx, cap_name);
        if (off >= 0) {
            val_var = make_node(T_VAR);
            val_var.a = cap_name;
            cap_var = make_node(T_VAR);
            cap_var.a = cap_local_name;
            plus_op = _outline_make_op_char('+');
            addr_expr = make_node(T_BINOP);
            addr_expr.a = plus_op;
            addr_expr.b = cap_var;
            addr_expr.c = _outline_make_int_lit(off);
            memst_node = _dsp_make_memst(addr_expr, val_var);
            // Store hint = the field's real type, so publishing a float
            // capture stores its bit pattern (fcvt + str) instead of an
            // `fcvtzs` int-conversion that destroys the value.
            memst_node.c = get_field_type(sidx, cap_name);
            *(stmts + stmt_count * 8) = memst_node;
            stmt_count++;
        }
        i++;
    }
    // Build `job_parallel_for_data(N, fn_ptr(synth), &_cap_local)`.
    synth_var = make_node(T_VAR);
    synth_var.a = synth_name;
    inner_args = malloc(8);
    *inner_args = synth_var;
    fnptr_call = make_node(T_CALL);
    fnptr_call.a = fnptr_name;
    fnptr_call.b = inner_args;
    fnptr_call.c = 1;
    cap_var = make_node(T_VAR);
    cap_var.a = cap_local_name;
    addr_of_cap = make_node(T_ADDR);
    addr_of_cap.a = cap_var;
    outer_args = malloc(24);
    *outer_args = bound_n;
    *(outer_args + 8) = fnptr_call;
    *(outer_args + 16) = addr_of_cap;
    call_node = make_node(T_CALL);
    call_node.a = jpf_data_name;
    call_node.b = outer_args;
    call_node.c = 3;
    *(stmts + stmt_count * 8) = call_node;
    stmt_count++;
    // Mutate wh into T_BLOCK that wraps the publish + dispatch.
    wh_node.ntype = T_BLOCK;
    wh_node.a = 0;
    wh_node.b = stmts;
    wh_node.c = stmt_count;
    wh_node.d = 0;
    wh_node.e = 0;
    wh_node.dispatch = 0;
    // Record the new call-graph edge so mark_reachable picks the
    // runtime helper up.
    callees = arr_get(fn_calls, src_fi);
    if (callees == 0) { callees = arr_new(); arr_set(fn_calls, src_fi, callees); }
    callees = arr_push(callees, jpf_data_idx);
    arr_set(fn_calls, src_fi, callees);
    return 1;
}

// Build a packed synthetic function name of the form `__synth_N`,
// with N being a monotonic counter. The double-underscore prefix
// keeps the name out of any user program's namespace, so an
// accidental collision with a hand-written function is not possible.
// Returns the packed name.
static _synth_make_name() {
    auto start, n, tmp, digits, i;
    start = vbuf_pos;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 's'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'y'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'n'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 't'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'h'); vbuf_pos++;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    n = _synth_counter;
    if (n == 0) {
        poke(vbuf + vbuf_pos, '0'); vbuf_pos++;
    } else {
        // Count digits first, then write them in place right-to-left.
        tmp = n;
        digits = 0;
        while (tmp > 0) { digits++; tmp /= 10; }
        vbuf_pos += digits;
        tmp = n;
        for (i = 0; i < digits; i++) {
            poke(vbuf + vbuf_pos - 1 - i, '0' + tmp % 10);
            tmp /= 10;
        }
    }
    _synth_counter++;
    return pack(start, vbuf_pos - start);
}

// Create one synthesized worker function per candidate recorded by
// find_dispatch_candidates(). Must run AFTER that scanner and BEFORE
// the first emit_module_* call so the new functions are visible to
// the Stage 3 rewriter, which will then add the T_CALL that actually
// invokes them.
//
// Parallel arrays populated for each new function:
//   funcs[]            — the record itself (malloc'd 72 bytes)
//   func_cnt           — refreshed from arr_len(funcs)
//   func_mods[]        — module index of the enclosing function, so
//                        the synth rides along with it at emit time
//   fn_static[]        — 1, the synth is a compiler internal
//   fn_void[]          — 1, the body discards any returns
//   fn_phase_hint[]    — 0, no user annotation
//   fn_phase[]         — PHASE_BASE, body already proved worker-safe
//   fn_phase_next[]    — matches fn_phase for a clean fixpoint
//   fn_calls[]         — empty, call-graph edges out of the synth
//                        are not needed until Stage 3 rewrites the
//                        invoking loop
//   fn_address_taken[] — 1, Stage 3 will take the address via fn_ptr
//   fn_locally_impure[]— 0, the dispatch predicate already proved it
//   fn_reachable[]     — 0, Stage 2 must not cause any new emission.
//                        Stage 3 flips this to 1 when it wires the
//                        call through job_parallel_for.
void synthesize_loop_fn() {
    auto n, i, wh: Node, src_fi, loop_var_p, src_mod;
    auto fname, params_arr, record, src_tok;
    auto body_ptr, body_cnt, param_p;
    auto sv, st, rv, op_p, op_ch, op_l, identity_val, cid_p;

    _synth_counter = 0;
    n = arr_len(dispatch_candidates);
    for (i = 0; i < n; i++) {
        wh = arr_get(dispatch_candidates, i);
        src_fi = arr_get(dispatch_cand_fn_idx, i);
        loop_var_p = arr_get(dispatch_cand_loop_var, i);
        src_mod = arr_get(func_mods, src_fi);
        src_tok = wh.src_tok;

        sv = arr_get(dispatch_cand_start,      i);
        st = arr_get(dispatch_cand_stride,     i);
        rv = arr_get(dispatch_cand_reduce_var, i);

        // Sprint 1 (non-zero start / non-unit stride) still skipped:
        // job_parallel_for has no chunked variant yet. Sprint 2b
        // parallelises additive reductions end-to-end; non-additive
        // reduction ops (shifts, *, &, |, ^) remain serial until the
        // synthesiser learns their identity element.
        if (sv != 0 || st != 1) {
            dispatch_cand_synth_idx  = arr_push(dispatch_cand_synth_idx,  -1);
            dispatch_cand_synth_name = arr_push(dispatch_cand_synth_name,  0);
            continue;
        }

        if (rv != 0) {
            // REDUCTION path. Only the additive op `+` ships in this
            // sprint. Skip everything else with a placeholder so the
            // candidate stays visible to --dispatch but the loop runs
            // serially at runtime.
            op_p = arr_get(dispatch_cand_reduce_op, i);
            op_l = unpack_l(op_p);
            op_ch = peek(vbuf + unpack_s(op_p));
            identity_val = _dsp_red_identity_for(op_ch);
            if (op_l != 1 || op_ch != '+') {
                dispatch_cand_synth_idx  = arr_push(dispatch_cand_synth_idx,  -1);
                dispatch_cand_synth_name = arr_push(dispatch_cand_synth_name,  0);
                continue;
            }
            _dsp_red_lazy_init();
            cid_p = _dsp_pack_local("__cid", 5);
            param_p = cid_p;
            body_ptr = _dsp_build_red_body(wh, loop_var_p, rv, op_ch, cid_p);
            body_cnt = _dsp_red_body_cnt;
        } else {
            // MAP path — two shapes:
            //
            //   (a) Outlining (capture_idx >= 0): range-synth shape.
            //       Synth takes (loop_var, _end), wraps body in
            //       `while (loop_var < _end) { body; loop_var++; }`.
            //       Runtime `job_parallel_for_data` uses chunked
            //       dispatch — one call per worker, not per iter.
            //
            //   (b) Standard MAP (capture_idx < 0): per-iter shape.
            //       Synth takes (idx), body is the original. Runtime
            //       `job_parallel_for` submits per-iter. UNCHANGED
            //       from the pre-P6-Phase-1 behaviour to keep tests
            //       (test_smart_dispatch, test_job, test_reduce*) green.
            //
            // P6 Phase 2 will fold standard MAP into chunked
            // dispatch once we add a chunked variant of
            // `job_parallel_for` (today it submits per-iter).
            param_p  = loop_var_p;
            auto _cap_idx, _orig_body, _orig_cnt, _av_p;
            _orig_body = wh.b;
            _orig_cnt  = wh.c;
            _cap_idx = arr_get(dispatch_cand_capture_idx, i);
            _av_p = arr_get(_av_pattern, i);
            if (_cap_idx >= 0) {
                _outline_restore_captures_from_struct(_cap_idx);
                if (_av_p > 0) {
                    // P6 Phase 2 (2026-05-22) — COMPOSE outlining +
                    // autovec. Range-synth body becomes a T_BLOCK
                    // with [vector_while, scalar_tail_while]:
                    //
                    //   while (i + 4 <= _end) { vec_body; i += 4; }
                    //   while (i < _end)      { scalar_body; i++; }
                    //
                    // SIMD lowering runs FIRST (on the original
                    // body's T_VAR(arr) refs), then capture
                    // substitution rewrites those refs to
                    // T_MEMLD(_outline_cap_ptr + offset). The
                    // recursion into T_CALL / T_BLOCK in
                    // ast_clone_subst (added 2026-05-22 outlining
                    // P6) handles the vec_* T_CALL nodes that
                    // P5's `_av_lower_stmt` produces.
                    auto _simd_body, _simd_cnt_p, _simd_cnt;
                    auto _vec_while, _tail_while, _block_stmts;
                    auto _block_node: Node, _block_arr;
                    auto _end_var: Node;
                    // LICM: hoist the loop-invariant splat (P1 only) so the
                    // `dup v0.4s` runs once per synth call, not per iteration.
                    // Find the store's invariant operand (the second factor of
                    // `field = field OP invariant`) and pre-compute its splat
                    // into a synth-local; the vector loop then references it.
                    auto _splat_name, _inv, _bi2;
                    auto _st: Node, _st_rhs: Node;
                    auto _splat_decl: Node, _splat_assign: Node;
                    auto _splat_decl_arr, _splat_args, _splat_call: Node;
                    _splat_name = 0;
                    _inv = 0;
                    if (_av_p == 1) {
                        _bi2 = 0;
                        while (_bi2 < wh.c) {
                            _st = wh.b[_bi2];
                            if (_st != 0) {
                                if (_st.ntype == T_MEMST) {
                                    _st_rhs = _st.b;
                                    _inv = _st_rhs.c;
                                }
                            }
                            _bi2++;
                        }
                        if (_inv != 0) { _splat_name = _dsp_pack_name("_av_splat", 9); }
                    }
                    _simd_body = malloc(wh.c * 8);
                    _simd_cnt_p = malloc(8);
                    *_simd_cnt_p = 0;
                    _av_build_simd_body(wh.b, wh.c, _av_p,
                        _simd_body, _simd_cnt_p, _splat_name);
                    _simd_cnt = *_simd_cnt_p;
                    _end_var = _dsp_make_var(_av_get_end_param_name());
                    _vec_while = _av_build_vector_loop(loop_var_p,
                        _end_var, _simd_body, _simd_cnt);
                    _end_var = _dsp_make_var(_av_get_end_param_name());
                    _tail_while = _av_build_scalar_tail(loop_var_p,
                        _end_var, wh.b, wh.c);
                    if (_splat_name != 0) {
                        // Prepend [ auto _av_splat;  _av_splat = vec_splat4(inv); ].
                        _splat_decl_arr = malloc(8);
                        *_splat_decl_arr = _splat_name;
                        _splat_decl = make_node(T_DECL);
                        _splat_decl.a = _splat_decl_arr;
                        _splat_decl.b = 1;
                        _splat_decl.c = 0xB3;   // TY_FLOAT_D — 128-bit SIMD slot
                        _splat_decl.d = 0;
                        _splat_decl.e = 0;
                        _splat_args = malloc(8);
                        *_splat_args = ast_clone_subst(_inv, 0, 0, 0);
                        _splat_call = _av_make_call(
                            _dsp_pack_name("vec_splat4", 10), _splat_args, 1);
                        _splat_assign = _dsp_make_assign(
                            _dsp_make_var(_splat_name), _splat_call);
                        _block_arr = malloc(32);
                        *(_block_arr     ) = _splat_decl;
                        *(_block_arr +  8) = _splat_assign;
                        *(_block_arr + 16) = _vec_while;
                        *(_block_arr + 24) = _tail_while;
                        _block_node = make_node(T_BLOCK);
                        _block_node.b = _block_arr;
                        _block_node.c = 4;
                    } else {
                        _block_arr = malloc(16);
                        *_block_arr = _vec_while;
                        *(_block_arr + 8) = _tail_while;
                        _block_node = make_node(T_BLOCK);
                        _block_node.b = _block_arr;
                        _block_node.c = 2;
                    }
                    // Now apply capture substitution to the whole
                    // block. The cloner recurses into T_BLOCK +
                    // T_WHILE bodies (added P6 outlining fix) and
                    // into T_CALL args (vec_load4 / vec_splat4 /
                    // vec_store4 args contain T_VAR(captures)).
                    _block_stmts = malloc(8);
                    *_block_stmts = _block_node;
                    body_ptr = _outline_clone_body_with_captures(
                        _block_stmts, 1, _cap_idx);
                    body_cnt = 1;
                } else {
                    _orig_body = _outline_clone_body_with_captures(
                        wh.b, wh.c, _cap_idx);
                    body_ptr = _av_make_range_synth_body(
                        loop_var_p, _orig_body, _orig_cnt);
                    body_cnt = 1;
                }
            } else {
                // Standard MAP — original body verbatim, per-iter.
                body_ptr = _orig_body;
                body_cnt = _orig_cnt;
            }
        }

        // Build the function record. Fields match parse_function's
        // registration path so downstream passes see a regular entry.
        //
        // Param count by path:
        //   * Reduction: 1 param (cid_p).
        //   * Outlining MAP: 2 params (loop_var, _end) — range-synth.
        //   * Standard MAP: 1 param (loop_var) — per-iter synth.
        fname = _synth_make_name();
        auto _pcnt, _is_outline_map;
        _is_outline_map = (rv == 0)
            && (arr_get(dispatch_cand_capture_idx, i) >= 0);
        if (_is_outline_map) {
            params_arr = malloc(16);
            *(params_arr) = param_p;
            *(params_arr + 8) = _av_get_end_param_name();
            _pcnt = 2;
        } else {
            params_arr = malloc(8);
            *(params_arr) = param_p;
            _pcnt = 1;
        }
        record = malloc(RECORD_SZ);
        *(record + FN_TYPE) = 22;
        *(record + FN_NAME) = fname;
        *(record + FN_PARS) = params_arr;
        *(record + FN_PCNT) = _pcnt;
        *(record + FN_BODY) = body_ptr;
        *(record + FN_BCNT) = body_cnt;
        *(record + FN_HINTS) = 0;
        *(record + FN_STUB) = 0;
        *(record + FN_SRC_TOK) = src_tok;

        // Register in funcs[] and every parallel array the parser
        // populates for regular user functions.
        funcs = arr_push(funcs, record);
        func_cnt = arr_len(funcs);
        func_mods = arr_push(func_mods, src_mod);
        fn_static = arr_push(fn_static, 1);
        fn_void = arr_push(fn_void, 1);
        fn_phase_hint = arr_push(fn_phase_hint, 0);
        fn_ret_hint   = arr_push(fn_ret_hint, 0);
        fn_ret_arity  = arr_push(fn_ret_arity, 1);
        fn_ret_types  = arr_push(fn_ret_types, 0);
        fn_vt_locs    = arr_push(fn_vt_locs, 0);

        // Extend the dispatch-analysis arrays too. These were sized
        // to the pre-synthesis func_cnt by call_graph_build, so every
        // new function needs an explicit slot.
        fn_phase = arr_push(fn_phase, PHASE_BASE);
        fn_phase_next = arr_push(fn_phase_next, PHASE_BASE);
        fn_calls = arr_push(fn_calls, arr_new());
        fn_address_taken = arr_push(fn_address_taken, 1);
        fn_locally_impure = arr_push(fn_locally_impure, 0);
        fn_reachable = arr_push(fn_reachable, 0);

        // Expose the freshly synthesized function to Stage 3. The
        // rewriter needs the packed name to build the fn_ptr() call
        // and the funcs[] slot to flip fn_reachable when the call is
        // wired through job_parallel_for.
        dispatch_cand_synth_idx = arr_push(dispatch_cand_synth_idx, func_cnt - 1);
        dispatch_cand_synth_name = arr_push(dispatch_cand_synth_name, fname);
    }
}

// ── Phase 2: Stage 3 — loop-to-call rewrite ────────────────
//
// Every eligible loop gets turned in place into a call to
// job_parallel_for(N, fn_ptr(synth)). The T_WHILE node is mutated in
// the AST arena: its ntype flips to T_CALL, .a carries the packed
// name of job_parallel_for, and .b points at a new two-slot argument
// array. Because every other pass refers to the loop through the
// single pointer slot its parent owns, in-place mutation keeps the
// rest of the AST intact.
//
// Reachability: the enclosing function already reached main(), so
// the inserted call to job_parallel_for extends the graph by one
// edge. Appending that edge to fn_calls[] for the enclosing function
// and re-running mark_reachable is enough — job_parallel_for's own
// fn_calls were computed by the original call_graph_build pass, so
// the BFS follows through to job_submit / job_wait_all. The synth
// function is picked up automatically via fn_address_taken[].
//
// If job_parallel_for is not visible (e.g. the user did not import
// bpp_job.bsm), the rewrite is skipped entirely and the synthesized
// functions stay dead — Stage 2 left fn_reachable[] at 0 for them,
// so no emission occurs and the program keeps the original serial
// loop. This is the graceful-fallback contract.

// Copy a C-style string literal into vbuf and return its packed
// handle. Used once per compilation run to materialize the packed
// names `job_parallel_for` and `fn_ptr` that the rewrite injects.
static _dsp_pack_name(s, l) {
    auto start, i;
    start = vbuf_pos;
    for (i = 0; i < l; i++) {
        poke(vbuf + vbuf_pos, str_peek(s, i));
        vbuf_pos++;
    }
    return pack(start, l);
}

// Same as _dsp_pack_name but reads the length from the terminating NUL
// of the C-string argument — no manual character count needed at call
// sites. Prefer this in init code: `_dsp_pack_cstr("putchar")` is less
// bug-prone than `_dsp_pack_name("putchar", 7)` where a mis-count
// silently corrupts the packed reference.
static _dsp_pack_cstr(s) {
    auto start, i, ch;
    start = vbuf_pos;
    i = 0;
    ch = str_peek(s, i);
    while (ch != 0) {
        poke(vbuf + vbuf_pos, ch);
        vbuf_pos++;
        i++;
        ch = str_peek(s, i);
    }
    return pack(start, i);
}

// Cached packed names for the combine-loop scratch globals declared
// in bpp_job.bsm. The rewriter reuses one shared (k, ci) pair across
// every reduction in the program — reductions never overlap on main
// so a single slot is safe. Set once at first call site.
extrn _dsp_red_k_p;
extrn _dsp_red_ci_p;

// Mirrors `_OUTLINE_MIN_N` in src/bpp_job.bsm (keep the two in sync —
// duplicated rather than imported because this module reasons about
// the USER PROGRAM's AST at compile time, not the runtime symbol).
// The captureless MAP rewrite below has no chunked variant: it always
// dispatches through `job_parallel_for`, which submits ONE job PER
// ITERATION (Shape B in bpp_job.bsm's synth contract) — fine for the
// explicit user-facing API where each iteration is substantial work,
// but catastrophic for an auto-detected loop with a small trip count
// called repeatedly (every per-element submit pays full SPSC-queue
// overhead with nothing to amortize it against). Below this floor,
// leave the loop serial instead of rewriting it — exactly the same
// protection `_outline_dispatch` already gives the captured-outlining
// path. Found via bench_autovec_compute.bpp: N=32768, called 6000
// times, ran 51.5s dispatched vs ~135ms serial — a ~380x regression
// from "parallelizing" a loop too small to amortize the dispatch cost.
const _DSP_MAP_MIN_N = 524288;

// Auto-injects `job_init(_DSP_DEFAULT_WORKERS)` as the FIRST statement
// of main() when smart-dispatch rewrote at least one loop into a real
// worker-pool call (job_parallel_for / job_parallel_for_data /
// job_parallel_reduce) but the program never established its own
// freeze point. Without this, `@safe` + an eligible loop compiles to
// a dispatch call that silently runs serial forever (job_init was
// never called, so `_job_inited == 0` and every dispatch helper's own
// fallback kicks in) — correct, but defeats the entire point of
// writing `@safe` in the first place, with zero feedback to the
// programmer. This mirrors what `maestro_run()` already does for
// itself unconditionally (`job_init(_ms_n_workers)`, bpp_maestro.bsm
// :172, spawned before anything else runs) — the same "write @safe
// + a normal loop, the compiler does the rest" principle as `auto`
// for variables and the auto-injected prelude.
//
// Front-loaded as the literal first statement for the same reason
// maestro_run front-loads it: on macOS, NSApplication's single- to
// multi-thread transition breaks if pthread_create runs after
// NSApplication is already up, so workers must spawn before any
// window/GPU/audio init the rest of main() might do.
//
// Caller (`rewrite_dispatch_loops`) only invokes this when
// `_dsp_has_freeze == 0` — if the program already calls job_init /
// maestro_run / maestro_configure itself (perhaps with a deliberately
// non-default worker count), that check skips this entirely. Without
// it, job_init's own idempotency ("calling twice is a no-op") would
// make whichever call runs FIRST win, silently discarding a
// deliberate explicit worker count.
static void _dsp_auto_init_job_pool() {
    auto ji_idx, ji_name, fn_rec, body_arr, body_cnt, new_body, i;
    auto call_node: Node, args_arr, lit_n: Node, callees;

    ji_name = _dsp_pack_name("job_init", 8);
    ji_idx = _dsp_find_func_idx(ji_name);
    if (ji_idx < 0) { return; }   // bpp_job.bsm not imported — nothing to call

    lit_n = _dsp_make_int_lit(_DSP_DEFAULT_WORKERS);
    args_arr = malloc(8);
    *(args_arr) = lit_n;
    call_node = make_node(T_CALL);
    call_node.a = ji_name;
    call_node.b = args_arr;
    call_node.c = 1;

    fn_rec = funcs[_dsp_main_idx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);

    new_body = malloc((body_cnt + 1) * 8);
    *(new_body) = call_node;
    for (i = 0; i < body_cnt; i++) {
        *(new_body + 8 + i * 8) = body_arr[i];
    }
    *(fn_rec + FN_BODY) = new_body;
    *(fn_rec + FN_BCNT) = body_cnt + 1;

    // Wire the new edge so the caller's mark_reachable() (which runs
    // right after this) sees job_init as reachable from main.
    callees = arr_get(fn_calls, _dsp_main_idx);
    if (callees == 0) {
        callees = arr_new();
        arr_set(fn_calls, _dsp_main_idx, callees);
    }
    callees = arr_push(callees, ji_idx);
    arr_set(fn_calls, _dsp_main_idx, callees);
}

// Transform every candidate loop into a call to job_parallel_for and
// wire the new edges so mark_reachable sees the synth function and
// the job runtime as reachable. Runs after synthesize_loop_fn.
void rewrite_dispatch_loops() {
    auto n, i, wh: Node, src_fi, bound_n, synth_idx, synth_name;
    auto jpf_name, fnptr_name, jpf_idx, jpr_idx, runtime_idx;
    auto fnptr_call: Node, synth_var: Node, args_arr, inner_args_arr;
    auto callees, _any_dispatched;
    _any_dispatched = 0;

    n = arr_len(dispatch_candidates);
    if (n == 0) { return; }

    // Materialize the packed names the injected calls will reference.
    jpf_name = _dsp_pack_name("job_parallel_for", 16);
    fnptr_name = _dsp_pack_name("fn_ptr", 6);

    // Look up job_parallel_for in funcs[]. If absent, the program
    // never imported bpp_job.bsm and there is no runtime to dispatch
    // through. Skip the rewrite entirely so the original for-loops
    // remain and the synth entries stay unreachable.
    jpf_idx = _dsp_find_func_idx(jpf_name);
    if (jpf_idx < 0) { return; }

    // Reduction rewrites need job_parallel_reduce instead. It lives in
    // the same module, so its presence implies the user has the runtime
    // available. If absent, fall back to leaving reduction candidates
    // serial (skip the rewrite) without aborting the map-rewrite path.
    _dsp_red_lazy_init();
    jpr_idx = _dsp_find_func_idx(_dsp_jpr_name_p);

    // Lazy-pack the combine-loop scratch global names. Both live in
    // bpp_job.bsm; the rewriter only references them through the
    // packed handles cached here.
    if (_dsp_red_k_p == 0) {
        _dsp_red_k_p  = _dsp_pack_local("_disp_red_k",  11);
        _dsp_red_ci_p = _dsp_pack_local("_disp_red_ci", 12);
    }

    for (i = 0; i < n; i++) {
        // Sprint 1 (non-zero start / non-unit stride) still skipped:
        // job_parallel_for has no chunked variant yet.
        auto sv, st, rv, op_p, op_l, op_ch;
        sv = arr_get(dispatch_cand_start,      i);
        st = arr_get(dispatch_cand_stride,     i);
        rv = arr_get(dispatch_cand_reduce_var, i);
        if (sv != 0 || st != 1) { continue; }

        synth_idx = arr_get(dispatch_cand_synth_idx, i);
        synth_name = arr_get(dispatch_cand_synth_name, i);

        // Synthesiser leaves synth_idx as -1 for any candidate it
        // declined to materialise (non-additive reduction op, etc.).
        // No worker = nothing to call, so leave the loop serial.
        if (synth_idx < 0) { continue; }

        wh = arr_get(dispatch_candidates, i);
        src_fi = arr_get(dispatch_cand_fn_idx, i);
        bound_n = arr_get(dispatch_cand_bound, i);

        // Autovec P5 (2026-05-22) — if the body matches an
        // autovec pattern AND there's no caller-frame capture
        // demanding outlining, lower the loop into a vector +
        // scalar-tail pair. Reductions still go through the
        // reduction path. Composition with outlining (P6) is
        // deferred.
        auto _av_p, _av_cap;
        _av_p = arr_get(_av_pattern, i);
        _av_cap = arr_get(dispatch_cand_capture_idx, i);
        if (rv == 0 && _av_p > 0 && _av_cap < 0) {
            auto _loop_var_av;
            _loop_var_av = arr_get(dispatch_cand_loop_var, i);
            _av_rewrite_loop(wh, _loop_var_av, bound_n, wh.b, wh.c, _av_p);
            continue;
        }

        if (rv != 0) {
            // ── REDUCTION rewrite ────────────────────────────────
            //
            // Replace the T_WHILE with a T_BLOCK that drives the
            // chunked workers and folds the K partials back into
            // the user-visible accumulator using the same operator
            // the source loop used.
            //
            //   {
            //     _disp_red_k = job_parallel_reduce(bound, fn_ptr(synth));
            //     _disp_red_ci = 0;
            //     while (_disp_red_ci < _disp_red_k) {
            //         acc = acc OP *(_disp_partials + _disp_red_ci * 8);
            //         _disp_red_ci = _disp_red_ci + 1;
            //     }
            //   }
            //
            // The two scratch globals live in bpp_job.bsm so no
            // T_DECL has to be threaded into the enclosing function;
            // run_dispatch's per-function local scan only walks the
            // top-level body, and a nested T_DECL would be invisible
            // to it. Reductions never overlap from main, so a single
            // shared (k, ci) pair across the whole program is safe.
            if (jpr_idx < 0) { continue; }

            op_p  = arr_get(dispatch_cand_reduce_op, i);
            op_l  = unpack_l(op_p);
            op_ch = peek(vbuf + unpack_s(op_p));

            auto reduce_call: Node, reduce_args;
            auto (rk_assign, rci_init): Node;
            auto cond: Node, body_arr2, body_step: Node;
            auto (combine_while, partials_load): Node;
            auto (fold_expr, fold_assign): Node;
            auto block_stmts;

            // job_parallel_reduce(bound, fn_ptr(synth_name))
            synth_var = _dsp_make_var(synth_name);
            inner_args_arr = malloc(8);
            *(inner_args_arr) = synth_var;
            fnptr_call = make_node(T_CALL);
            fnptr_call.a = fnptr_name;
            fnptr_call.b = inner_args_arr;
            fnptr_call.c = 1;

            reduce_args = malloc(16);
            *(reduce_args     ) = bound_n;
            *(reduce_args +  8) = fnptr_call;
            reduce_call = make_node(T_CALL);
            reduce_call.a = _dsp_jpr_name_p;
            reduce_call.b = reduce_args;
            reduce_call.c = 2;

            // _disp_red_k = job_parallel_reduce(...)
            rk_assign = _dsp_make_assign(_dsp_make_var(_dsp_red_k_p), reduce_call);

            // _disp_red_ci = 0
            rci_init = _dsp_make_assign(_dsp_make_var(_dsp_red_ci_p), _dsp_make_int_lit(0));

            // acc = acc OP *(_disp_partials + _disp_red_ci * 8)
            partials_load = _dsp_make_indexed_load(_dsp_disp_partials_p, _dsp_red_ci_p);
            fold_expr = _dsp_make_binop_p(op_p, _dsp_make_var(rv), partials_load);
            fold_assign = _dsp_make_assign(_dsp_make_var(rv), fold_expr);

            body_arr2 = malloc(8);
            *(body_arr2) = fold_assign;

            // _disp_red_ci = _disp_red_ci + 1
            body_step = _dsp_make_assign(
                _dsp_make_var(_dsp_red_ci_p),
                _dsp_make_binop('+', _dsp_make_var(_dsp_red_ci_p), _dsp_make_int_lit(1)));

            // while (_disp_red_ci < _disp_red_k) { fold; ci = ci + 1; }
            cond = _dsp_make_binop('<',
                _dsp_make_var(_dsp_red_ci_p),
                _dsp_make_var(_dsp_red_k_p));
            combine_while = make_node(T_WHILE);
            combine_while.a = cond;
            combine_while.b = body_arr2;
            combine_while.c = 1;
            combine_while.d = 0;
            combine_while.e = body_step;

            // Splice the three top-level statements into the block.
            block_stmts = malloc(3 * 8);
            *(block_stmts     ) = rk_assign;
            *(block_stmts +  8) = rci_init;
            *(block_stmts + 16) = combine_while;

            // Mutate the source T_WHILE in place into the new block.
            wh.ntype = T_BLOCK;
            wh.a = 0;
            wh.b = block_stmts;
            wh.c = 3;
            wh.d = 0;
            wh.e = 0;
            wh.dispatch = 0;

            runtime_idx = jpr_idx;
        } else {
            // ── MAP rewrite ──────────────────────────────────────
            // When the candidate has captures (P6 wires this; today
            // capture_idx is always -1 for accepted candidates),
            // route through the outlining variant that publishes the
            // captures before dispatching. Falls back to the plain
            // `job_parallel_for` rewrite if outlining isn't possible
            // (runtime helper absent, no captures, etc.).
            auto _cap_idx, _did_outline, _jpf_data_idx, _jpf_data_name;
            _cap_idx = arr_get(dispatch_cand_capture_idx, i);
            _did_outline = 0;
            if (_cap_idx >= 0) {
                // Route the auto-outlined dispatch through `_outline_dispatch`,
                // the trip-count-guarded entry — small loops run serially as
                // in-place SIMD, only large ones fan out to workers. The
                // explicit `job_parallel_for_data` stays the unguarded path for
                // user / stbecs code that deliberately parallelises heavy work.
                _jpf_data_name = _dsp_pack_name("_outline_dispatch", 17);
                _jpf_data_idx = _dsp_find_func_idx(_jpf_data_name);
                _did_outline = _outline_rewrite_with_captures(
                    wh, _cap_idx, synth_name, bound_n, src_fi,
                    _jpf_data_idx, _jpf_data_name, fnptr_name);
                if (_did_outline) {
                    runtime_idx = _jpf_data_idx;
                }
            }
            if (_did_outline == 0) {
                // Floor guard (see _DSP_MAP_MIN_N above): a literal bound
                // below the floor stays serial — job_parallel_for's
                // per-iteration submit cost is not worth paying when the
                // trip count can't amortize it. Non-literal bounds (a
                // "stable global" per Rule 38) keep today's unguarded
                // behaviour; teaching this path a runtime check too is
                // tracked future work, not part of this fix.
                auto _bn: Node;
                _bn = bound_n;
                if (_bn.ntype == T_LIT) {
                    if (_fdc_is_int_lit(_bn.a)) {
                        if (parse_int_lit_value(_bn.a) < _DSP_MAP_MIN_N) {
                            continue;
                        }
                    }
                }
                // Standard MAP rewrite — no captures.
                synth_var = make_node(T_VAR);
                synth_var.a = synth_name;
                inner_args_arr = malloc(8);
                *(inner_args_arr) = synth_var;
                fnptr_call = make_node(T_CALL);
                fnptr_call.a = fnptr_name;
                fnptr_call.b = inner_args_arr;
                fnptr_call.c = 1;
                args_arr = malloc(16);
                *(args_arr) = bound_n;
                *(args_arr + 8) = fnptr_call;
                wh.ntype = T_CALL;
                wh.a = jpf_name;
                wh.b = args_arr;
                wh.c = 2;
                wh.d = 0;
                wh.e = 0;
                wh.dispatch = 0;
                runtime_idx = jpf_idx;
            }
        }

        // Record the new edge from the enclosing function to the
        // runtime helper that the rewrite injected (job_parallel_for
        // for map, job_parallel_reduce for reduction). mark_reachable
        // follows the edge on re-run to pick the helper up even when
        // the user did not call it directly.
        callees = arr_get(fn_calls, src_fi);
        if (callees == 0) {
            callees = arr_new();
            arr_set(fn_calls, src_fi, callees);
        }
        callees = arr_push(callees, runtime_idx);
        arr_set(fn_calls, src_fi, callees);
        _any_dispatched++;
    }

    // Auto-init the worker pool (see _dsp_auto_init_job_pool's own
    // header comment) when at least one candidate above actually
    // turned into a worker-pool call AND the program never set up
    // its own freeze point. The autovec in-place rewrite (`continue`d
    // before reaching the edge-recording block above) never counts
    // here — it needs no worker pool at all.
    if (_any_dispatched > 0 && _dsp_has_freeze == 0 && _dsp_main_idx >= 0) {
        _dsp_auto_init_job_pool();
    }

    // The prescan injected a job_init(N) into main on a WEAK gate (any
    // @safe loop host exists) so the callgraph would keep the pool
    // reachable. If dispatch just finished and NO candidate actually
    // turned into a worker-pool call, that startup pool would spawn
    // threads nothing ever submits to — neutralize the injected call.
    // (_dsp_has_freeze == 1 whenever the prescan injected, because the
    // freeze detector sees the prescan's own call — so this is the ONLY
    // gate that can retire it.)
    if (_any_dispatched == 0 && _dsp_prescan_ji_node != 0) {
        auto _pji: Node;
        _pji = _dsp_prescan_ji_node;
        _pji.ntype = T_NOP;
    }

    // Rebuild reachability. Seeds include every address-taken
    // function (which now includes the synth entries from Stage 2),
    // and every function called via the freshly appended edges.
    mark_reachable();
}

// ── Phase B1a.1 — Sethi-Ullman temp annotation (chip-agnostic) ──
//
// Every expression subtree has a minimum number of temporary registers
// it needs to evaluate without spilling, computed recursively as:
//
//   leaf (T_LIT, T_VAR):                 0
//   unary (T_UNARY, T_MEMLD, T_ADDR):    child.temps
//   binary (T_BINOP):
//     left == right → left + 1           (one temp to save one side)
//     left != right → max(left, right)   (heavy side uses its own temps,
//                                         light side reuses them)
//
// The "heavier side first" choice is also chip-agnostic: evaluate the
// subtree with more temps first so the lighter side can run without
// spilling what the heavier side produced. The concrete register names,
// spill encoding, and ABI constraints stay in the backend — this pass
// only ANNOTATES, it never emits code.
//
// Storage: T_BINOP nodes get annotations packed into the `.d` field
// (unused by the parser for binary ops). Bit layout:
//   d & 0xFF  = temps_needed (clamped to 255; real values rarely > 20)
//   d & 0x100 = eval_left_first (1 = emit left child first)
//
// Other node types return their temp count but do not persist it —
// their codegen reads the same bit from the T_BINOP that parents them.
//
// B1a.1 is a zero-diff pass: annotations are written but no backend
// reads them yet. Bootstrap sha must match the pre-B1a.1 baseline.
// B1a.2 and later sub-phases flip the backends to consume .d.

// Recursively compute Sethi-Ullman temps for an expression subtree,
// annotating every T_BINOP encountered along the way. Returns the temp
// count at the current subtree so the parent can compare sides.
static _annot_count(nd) {
    auto n: Node, t;
    auto left_t, right_t, then_t, else_t, arg_t, max_t;
    auto i, arr, cnt;
    auto temps, elf;

    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;

    switch (t) {
    T_LIT, T_VAR, T_NOP, T_BREAK, T_CONTINUE, T_DECL { return 0; }
    T_BINOP {
        left_t = _annot_count(n.b);
        right_t = _annot_count(n.c);
        if (left_t == right_t) {
            temps = left_t + 1;
            elf = 1;
        } else {
            if (left_t > right_t) {
                temps = left_t;
                elf = 1;
            } else {
                temps = right_t;
                elf = 0;
            }
        }
        if (temps > 255) { temps = 255; }
        n.d = temps | (elf ? 0x100 : 0);
        return temps;
    }
    T_UNARY { return _annot_count(n.b); }
    T_MEMLD { return _annot_count(n.a); }
    T_ADDR  { return _annot_count(n.a); }
    T_MEMST {
        left_t = _annot_count(n.a);
        right_t = _annot_count(n.b);
        return left_t > right_t ? left_t + 1 : right_t + 1;
    }
    T_ASSIGN {
        _annot_count(n.a);
        return _annot_count(n.b);
    }
    T_TERNARY {
        left_t = _annot_count(n.a);
        then_t = _annot_count(n.b);
        else_t = _annot_count(n.c);
        max_t = then_t > else_t ? then_t : else_t;
        return left_t > max_t ? left_t : max_t;
    }
    T_CALL {
        arr = n.b; cnt = n.c;
        max_t = 0;
        for (i = 0; i < cnt; i++) {
            arg_t = _annot_count(arr[i]);
            if (arg_t > max_t) { max_t = arg_t; }
        }
        return max_t + cnt;
    }
    T_RET { return _annot_count(n.a); }
    T_IF {
        _annot_count(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _annot_count(arr[i]); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { _annot_count(arr[i]); }
        }
        return 0;
    }
    T_WHILE {
        _annot_count(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _annot_count(arr[i]); }
        if (n.e != 0) { _annot_count(n.e); }
        return 0;
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { _annot_count(arr[i]); }
        return 0;
    }
    T_SWITCH { return 0; }
    else { return 0; }
    }
    return 0;
}

// Walk every parsed function body and annotate every T_BINOP node
// with its Sethi-Ullman temp count plus the left-first evaluation
// preference. Called last in the dispatch pipeline so synthesized
// loop-worker bodies and rewritten loops are covered too.
void annotate_temps() {
    auto i, fn_rec, body_arr, body_cnt, j;
    auto stmt: Node;
    for (i = 0; i < func_cnt; i++) {
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);
        if (body_arr == 0) { continue; }
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) { _annot_count(stmt); }
        }
    }
}

// ── Phase B2 — Inline tiny `: base` functions ─────────────
//
// Trivial accessors like `peek`, `arr_get`, `unpack_s`, `is_float_type`
// translate to a 1-2 instruction body wrapped in a ~10 instruction
// call frame. Splicing the body straight into the caller deletes the
// call entirely. Eligibility is decided once, here, so each codegen
// only needs a small T_CALL branch that calls `ast_clone_subst` and
// hands the result to its existing emit_node loop.
//
// Eligibility criteria (all must hold):
//   1. fn_phase[i] == PHASE_BASE  — pure, no side effects.
//   2. body_cnt == 1, body[0] is a `T_RET` returning a real expression.
//   3. The return expression has ≤ 5 AST nodes.
//   4. param_cnt ≤ 3.
//   5. The body contains zero T_CALL (avoids transitive blow-up).
//   6. Each parameter is referenced at most once in the body
//      (so substituting an argument can never duplicate side effects;
//      this lets us skip the bind-to-temp machinery entirely).





// Disqualification sentinel for _inline_count_nodes/_inline_cost. Used
// to be 99 — safe while every real body cost stayed below it, broken
// the day lever 1 made early-return bodies countable (exp_f's real
// cost crossed 99 and read as "disqualified", exactly the
// sentinel-doubling-as-measurement trap Inc 8's own postmortem warned
// about). Now far above every cap so the two can never collide.
const INLINE_DISQ = 99999;

// Budget-aware splice admission (2026-07-11). Two measurements in one
// night showed the same failure: merging register-hungry spliced
// bodies into one caller dilutes its promotion budget until hot values
// fall back to memory (xform 6.8->11.4 ms with the wide-lit refusal
// off; the all-inserts bench 102.9->130.5 ms under a flat leaf bonus).
// Node-count thresholds cannot see this — REGISTER PRESSURE can. The
// account is arr_len(cg_vars) at registration time: the caller's own
// locals plus every already-admitted splice's mangled slots (pre-reg
// appends them there, in this same walk). A LOOP-CARRYING callee (its
// slots are hot by construction) is admitted only while that live
// count plus its own slot need stays within the cap; straightline
// callees (the moog chain, the dB wrappers) stay ungated — their
// slots' heat comes from the callsite, which the tier gates already
// price. 14 = the a64 non-leaf B3 budget (callee-saved 10 + caller
// band 4); x64 is tighter (7) but its dilution is bounded by the same
// splices this cap already refuses. Denial is always safe: the call
// stays a real bl.
const INLINE_PRESSURE_CAP = 14;

// Count AST nodes in a subtree. Originally written for Phase B2's
// expression-only bodies (`body_cnt == 1, body[0] == T_RET`); S4 P1
// extends to statement-typed nodes so the same walker can score
// multi-statement bodies. The `else -> return 99` arm stays as the
// safety net for node shapes the splice cannot emit (T_SWITCH) --
// getting 99 back immediately disqualifies the body. Early returns
// are COUNTED, not disqualified, since lever 1 (see the T_RET case).
static _inline_count_nodes(nd) {
    auto n: Node, t, sum, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    sum = 1;
    switch (t) {
    T_LIT, T_VAR, T_NOP, T_BREAK, T_CONTINUE { return 1; }
    T_BINOP    { sum += _inline_count_nodes(n.b) + _inline_count_nodes(n.c); }
    T_UNARY    { sum += _inline_count_nodes(n.b); }
    // Inc 6: a struct-field / fixed-index load's address is the canonical
    // base+const-offset shape, which folds into ONE load instruction's
    // addressing mode — see _inline_is_const_offset_addr's own comment.
    // Skip straight to the base, leaving the '+' and the offset literal
    // uncounted (they never become separate instructions); count the
    // ADDRESS expression as today for anything else (e.g. a computed
    // index, `*ptr`, or a manually-built address).
    T_MEMLD {
        auto memld_a: Node;
        if (_inline_is_const_offset_addr(n.a)) {
            memld_a = n.a;
            sum += _inline_count_nodes(memld_a.b);
        } else {
            sum += _inline_count_nodes(n.a);
        }
    }
    T_ADDR     { sum += _inline_count_nodes(n.a); }
    T_TERNARY  { sum += _inline_count_nodes(n.a) + _inline_count_nodes(n.b) + _inline_count_nodes(n.c); }
    T_CALL {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_count_nodes(arr[i]); }
    }
    // S4 P1 — statement-typed nodes that appear inside a function
    // body. T_ASSIGN.a = lhs, .b = rhs (cg_b3_walk:1113). T_MEMST.a
    // = addr, .b = value (cg_b3_walk:1114). T_RET.a = return expr.
    // T_DECL stands alone (no child walk in cg_b3_walk:2710).
    // Sibling of the T_RET n.c>1 fix above, for the multi-TARGET case
    // (`a,b,c,d = f()` — n.c is the target array, n.d the count, n.a
    // aliasing target[0] only; bpp_parser.bsm's parse_assign). Needed
    // for the new switch-normalized candidates below (moog_slope's
    // own body opens with exactly this shape) — undercounting a
    // body's true cost could let an oversized candidate slip past
    // INLINE_BODY_NODE_CAP. _inline_has_tcall / _inline_param_refs /
    // _inline_writes_param have the identical n.d>1 blind spot for
    // T_ASSIGN and are NOT fixed here — every multi-target in every
    // current candidate's body is a plain local (never a parameter,
    // never call-containing), so those three stay provably inert;
    // deferred until a real candidate's shape needs them, not fixed
    // speculatively.
    T_ASSIGN {
        sum += _inline_count_nodes(n.a) + _inline_count_nodes(n.b);
        if (n.d > 1) {
            arr = n.c; cnt = n.d;
            for (i = 1; i < cnt; i++) { sum += _inline_count_nodes(arr[i]); }
        }
    }
    // Same const-offset-addressing discount as T_MEMLD above, applied to
    // a struct-field STORE's address (n.a here IS the address directly,
    // not wrapped in another T_MEMLD — a store needs the address, not a
    // loaded value).
    T_MEMST {
        auto memst_a: Node;
        if (_inline_is_const_offset_addr(n.a)) {
            memst_a = n.a;
            sum += _inline_count_nodes(memst_a.b) + _inline_count_nodes(n.b);
        } else {
            sum += _inline_count_nodes(n.a) + _inline_count_nodes(n.b);
        }
    }
    // Inc 5 (multi-value return inlining): a multi-return T_RET stores its
    // expression list in n.b/n.c (n.a aliases n.b[0] — see parse_return,
    // bpp_parser.bsm). Counting only n.a would silently undercount results
    // 2..N, which could mask a real node-count cap violation on a future
    // bigger multi-return candidate (moog_taps itself stays comfortably
    // under the cap either way, but this helper must be correct in
    // general, not just for moog_taps's specific shape).
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) { sum += _inline_count_nodes(arr[i]); }
        } else {
            sum += _inline_count_nodes(n.a);
        }
    }
    T_DECL     { return 1; }
    // An early return inside the body (is_alpha's "if (cond) { return X; }",
    // the transcendental totality guards) is a REAL statement since the
    // lever-1 splice machinery (docs/plans/inliner_frontier_2.md):
    // cg_emit_stmt's T_RET handler detects an active splice frame and
    // emits value + jump-to-end-of-splice instead of the enclosing
    // function's epilogue, so the Inc 7 disqualification is retired and
    // the return simply carries its node cost.
    T_RET {
        auto rt_c, rt_i;
        sum += 1;
        if (n.c > 1) {
            rt_i = 0;
            while (rt_i < n.c) {
                rt_c = _inline_count_nodes(*(n.b + rt_i * 8));
                if (rt_c >= INLINE_DISQ) { return INLINE_DISQ; }
                sum += rt_c;
                rt_i++;
            }
        } else {
            rt_c = _inline_count_nodes(n.a);
            if (rt_c >= INLINE_DISQ) { return INLINE_DISQ; }
            sum += rt_c;
        }
    }
    // Control-flow leaf bodies (2026-06-24, the exp_f/log_f frontier
    // named in docs/plans/inliner_arc.md's "second bl" addendum). T_IF
    // and T_WHILE no longer unconditionally fall to the catch-all
    // sentinel below — ast_clone_subst and cg_emit_stmt already handle
    // both correctly, INCLUDING early returns since lever 1 (see the
    // T_RET case above). T_SWITCH stays on the catch-all below — out of
    // scope until a real candidate needs it (Tonify Rule 28;
    // _inline_normalize_switch_ret already rewrites the one switch
    // shape that needs to inline today).
    T_IF {
        auto if_a, if_b, if_e;
        if_a = _inline_count_nodes(n.a);
        if (if_a >= INLINE_DISQ) { return INLINE_DISQ; }
        if_b = _inline_count_nodes_body(n.b, n.c);
        if (if_b >= INLINE_DISQ) { return INLINE_DISQ; }
        sum += if_a + if_b;
        if (n.e > 0) {
            if_e = _inline_count_nodes_body(n.d, n.e);
            if (if_e >= INLINE_DISQ) { return INLINE_DISQ; }
            sum += if_e;
        }
    }
    T_WHILE {
        auto wh_a, wh_b, wh_e;
        // The 2026-06-24 wide-literal refusal is RETIRED: its true job —
        // keeping register-hungry loop bodies out of budget-constrained
        // callers — is now done directly by the pressure account
        // (_inline_pressure_admit), and the constants themselves are
        // visible to hot-constant promotion via cg_b3_desc_consts.
        // bench_codegen's xform is the standing gate for this class.
        wh_a = _inline_count_nodes(n.a);
        if (wh_a >= INLINE_DISQ) { return INLINE_DISQ; }
        wh_b = _inline_count_nodes_body(n.b, n.c);
        if (wh_b >= INLINE_DISQ) { return INLINE_DISQ; }
        sum += wh_a + wh_b;
        if (n.e != 0) {
            wh_e = _inline_count_nodes(n.e);
            if (wh_e >= INLINE_DISQ) { return INLINE_DISQ; }
            sum += wh_e;
        }
    }
    T_BLOCK {
        auto blk_b;
        blk_b = _inline_count_nodes_body(n.b, n.c);
        if (blk_b >= INLINE_DISQ) { return INLINE_DISQ; }
        sum += blk_b;
    }
    else { return INLINE_DISQ; }
    }
    return sum;
}

// Compare a packed source-range name against a C-string literal, using the
// parse-time source buffer `vbuf` directly. The codegen helper `cg_str_eq`
// reads `cg_sbuf`, which is only set during codegen (`cg_bridge_data`); this
// runs in the ANALYSIS pass (classify), where `cg_sbuf` is still 0 in the
// monolithic / --c pipeline — calling cg_str_eq there dereferenced a null
// buffer and SIGSEGV'd in `bpp --c` (confirmed via `bug`: cg_sbuf == 0).
static _inline_name_eq(name_p, lit, litlen) {
    if (unpack_l(name_p) != litlen) { return 0; }
    return buf_eq(vbuf + unpack_s(name_p), lit, litlen);
}

// Inc 6 — is `nd` the canonical "base + constant offset" address shape
// (`parse_struct_field`, bpp_parser.bsm:3191-3196: T_BINOP('+', base,
// T_LIT(offset))? This is what EVERY struct-field / fixed-array-index
// access compiles down to — base register plus immediate offset folds
// into ONE load/store instruction's addressing mode on both chips, never
// a separate ADD. `_inline_count_nodes` uses this to avoid overstating
// a struct-heavy body's cost (found investigating moog_taps: counting
// the '+' and the offset literal as if they were their own instructions
// made an 11-struct-field-access, single-load-each body look 2x more
// expensive than it actually compiles to).
static _inline_is_const_offset_addr(nd) {
    auto n: Node, c: Node;
    if (nd == 0) { return 0; }
    n = nd;
    if (n.ntype != T_BINOP) { return 0; }
    if (_inline_name_eq(n.a, "+", 1) == 0) { return 0; }
    if (n.c == 0) { return 0; }
    c = n.c;
    return c.ntype == T_LIT;
}

// Inline-instruction builtins: the peek/poke family, each lowering to ONE
// load/store (LDRH, STR D, …), not a real call frame. Keep in sync with
// cg_builtin_dispatch's peek/poke cases (bpp_codegen.bsm ~1605).
static _inline_is_inst_builtin(name_p) {
    if (_inline_name_eq(name_p, "peek", 4))         { return 1; }
    if (_inline_name_eq(name_p, "poke", 4))         { return 1; }
    if (_inline_name_eq(name_p, "peek_q", 6))       { return 1; }
    if (_inline_name_eq(name_p, "poke_q", 6))       { return 1; }
    if (_inline_name_eq(name_p, "peek_h", 6))       { return 1; }
    if (_inline_name_eq(name_p, "poke_h", 6))       { return 1; }
    if (_inline_name_eq(name_p, "peek_w", 6))       { return 1; }
    if (_inline_name_eq(name_p, "poke_w", 6))       { return 1; }
    if (_inline_name_eq(name_p, "peekfloat", 9))    { return 1; }
    if (_inline_name_eq(name_p, "pokefloat", 9))    { return 1; }
    if (_inline_name_eq(name_p, "peekfloat_h", 11)) { return 1; }
    if (_inline_name_eq(name_p, "pokefloat_h", 11)) { return 1; }
    return 0;
}

// Return 1 if the subtree contains a T_CALL to an inline-instruction builtin.
// A thin `peek_q` wrapper is size-neutral to inline; a bigger builtin-using
// body bloats at every call site, so the classifier caps those tighter.
static _inline_has_inst_builtin(nd) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_CALL) {
        if (_inline_is_inst_builtin(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (_inline_has_inst_builtin(arr[i])) { return 1; } }
        return 0;
    }
    switch (t) {
    T_BINOP   { return _inline_has_inst_builtin(n.b) || _inline_has_inst_builtin(n.c); }
    T_UNARY   { return _inline_has_inst_builtin(n.b); }
    T_MEMLD   { return _inline_has_inst_builtin(n.a); }
    T_ADDR    { return _inline_has_inst_builtin(n.a); }
    T_TERNARY { return _inline_has_inst_builtin(n.a) || _inline_has_inst_builtin(n.b) || _inline_has_inst_builtin(n.c); }
    T_ASSIGN  { return _inline_has_inst_builtin(n.a) || _inline_has_inst_builtin(n.b); }
    T_MEMST   { return _inline_has_inst_builtin(n.a) || _inline_has_inst_builtin(n.b); }
    T_RET     { return _inline_has_inst_builtin(n.a); }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes, see its own comment for why this is safe.
    T_IF {
        if (_inline_has_inst_builtin(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (_inline_has_inst_builtin(arr[i])) { return 1; } }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { if (_inline_has_inst_builtin(arr[i])) { return 1; } }
        }
        return 0;
    }
    T_WHILE {
        if (_inline_has_inst_builtin(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (_inline_has_inst_builtin(arr[i])) { return 1; } }
        if (n.e != 0) { return _inline_has_inst_builtin(n.e); }
        return 0;
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (_inline_has_inst_builtin(arr[i])) { return 1; } }
        return 0;
    }
    else { return 0; }
    }
    return 0;
}

// Return 1 if the subtree contains any DISQUALIFYING T_CALL (criterion 5).
// Calls to inline-instruction builtins are NOT disqualifying — only their args
// are scanned for a real nested call. Same statement-node extension as
// `_inline_count_nodes` so S4 can scan multi-statement bodies; the original
// expression-walker callers are unaffected (statement types simply never appear
// in an expression-only AST).
static _inline_has_tcall(nd) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        if (_inline_is_inst_builtin(n.a)) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) {
                if (_inline_has_tcall(arr[i])) { return 1; }
            }
            return 0;
        }
        return 1;
    }
    switch (t) {
    T_BINOP    { return _inline_has_tcall(n.b) || _inline_has_tcall(n.c); }
    T_UNARY    { return _inline_has_tcall(n.b); }
    T_MEMLD    { return _inline_has_tcall(n.a); }
    T_ADDR     { return _inline_has_tcall(n.a); }
    T_TERNARY  { return _inline_has_tcall(n.a) || _inline_has_tcall(n.b) || _inline_has_tcall(n.c); }
    // S4 P1 statement extensions.
    T_ASSIGN   { return _inline_has_tcall(n.a) || _inline_has_tcall(n.b); }
    T_MEMST    { return _inline_has_tcall(n.a) || _inline_has_tcall(n.b); }
    // Inc 5: a multi-return T_RET's results 2..N live in n.b, not n.a
    // (n.a aliases n.b[0] only) — this gate is correctness-critical (a
    // disqualifying call hiding in result 2..N must still disqualify the
    // body), so it cannot just read n.a like the single-return case.
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) {
                if (_inline_has_tcall(arr[i])) { return 1; }
            }
            return 0;
        }
        return _inline_has_tcall(n.a);
    }
    T_DECL     { return 0; }
    else { return 0; }
    }
    return 0;
}

// Inc 6 (nested-inline architecture) — the relaxed sibling of
// `_inline_has_tcall` used by `classify_inlineable`'s fixpoint. A T_CALL
// to a target that is ITSELF already `fn_inlineable` does not disqualify
// the body — it composes (tier 1 via the existing fast-substitute path
// with zero new machinery; multi-statement/tier-2 via the nested
// registration `_inline_register_nested` builds). A call to anything
// else (not yet known inlinable, or never will be) still disqualifies,
// exactly as `_inline_has_tcall` always has. Same structure throughout,
// kept as a separate function rather than a mode flag on the original —
// `_inline_has_tcall` has its own callers with "any call at all"
// semantics (`_inline_count_nodes`'s sibling helpers, the void-inline
// path) that must keep their current behavior unchanged.
static _inline_has_disqualifying_tcall(nd) {
    auto n: Node, t, arr, cnt, i, fidx;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        if (_inline_is_inst_builtin(n.a)) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) {
                if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
            }
            return 0;
        }
        fidx = find_func_idx(n.a);
        if (fidx >= 0 && arr_get(fn_inlineable, fidx)) { return 0; }
        // Lever-1: a call to a VOID-inlineable target composes too — a
        // void call can only ever sit in statement position (validate
        // rejects a void value inside an expression), and the VI splice
        // handles exactly that shape at emit time. Without this,
        // allpass_tick stayed disqualified forever because its
        // `delay_push(...)` statement pointed at a fn_void_inlineable
        // body that fn_inlineable knows nothing about.
        if (fidx >= 0 && arr_get(fn_void_inlineable, fidx)) { return 0; }
        return 1;
    }
    switch (t) {
    T_BINOP    { return _inline_has_disqualifying_tcall(n.b) || _inline_has_disqualifying_tcall(n.c); }
    T_UNARY    { return _inline_has_disqualifying_tcall(n.b); }
    T_MEMLD    { return _inline_has_disqualifying_tcall(n.a); }
    T_ADDR     { return _inline_has_disqualifying_tcall(n.a); }
    T_TERNARY  { return _inline_has_disqualifying_tcall(n.a) || _inline_has_disqualifying_tcall(n.b) || _inline_has_disqualifying_tcall(n.c); }
    T_ASSIGN   { return _inline_has_disqualifying_tcall(n.a) || _inline_has_disqualifying_tcall(n.b); }
    T_MEMST    { return _inline_has_disqualifying_tcall(n.a) || _inline_has_disqualifying_tcall(n.b); }
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) {
                if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
            }
            return 0;
        }
        return _inline_has_disqualifying_tcall(n.a);
    }
    T_DECL     { return 0; }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes, see its own comment for why this is safe.
    T_IF {
        if (_inline_has_disqualifying_tcall(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
        }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
            }
        }
        return 0;
    }
    T_WHILE {
        if (_inline_has_disqualifying_tcall(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
        }
        if (n.e != 0) { return _inline_has_disqualifying_tcall(n.e); }
        return 0;
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_has_disqualifying_tcall(arr[i])) { return 1; }
        }
        return 0;
    }
    else { return 0; }
    }
    return 0;
}

// Count references to packed name `name_p` inside a subtree. Same
// statement-node extension as the two siblings above.
static _inline_param_refs(nd, name_p) {
    auto n: Node, t, arr, cnt, i, sum;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_VAR) { return packed_eq(n.a, name_p) ? 1 : 0; }
    sum = 0;
    switch (t) {
    T_BINOP    { sum = _inline_param_refs(n.b, name_p) + _inline_param_refs(n.c, name_p); }
    T_UNARY    { sum = _inline_param_refs(n.b, name_p); }
    T_MEMLD    { sum = _inline_param_refs(n.a, name_p); }
    T_ADDR     { sum = _inline_param_refs(n.a, name_p); }
    T_TERNARY  { sum = _inline_param_refs(n.a, name_p) + _inline_param_refs(n.b, name_p) + _inline_param_refs(n.c, name_p); }
    T_CALL {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
    }
    // S4 P1 statement extensions.
    T_ASSIGN   { sum = _inline_param_refs(n.a, name_p) + _inline_param_refs(n.b, name_p); }
    T_MEMST    { sum = _inline_param_refs(n.a, name_p) + _inline_param_refs(n.b, name_p); }
    // Inc 5: see the matching comment in _inline_count_nodes — a
    // multi-return T_RET's results 2..N live in n.b, not n.a.
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
        } else {
            sum = _inline_param_refs(n.a, name_p);
        }
    }
    T_DECL     { return 0; }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes, see its own comment for why this is safe.
    T_IF {
        sum = _inline_param_refs(n.a, name_p);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
        }
    }
    T_WHILE {
        sum = _inline_param_refs(n.a, name_p);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
        if (n.e != 0) { sum += _inline_param_refs(n.e, name_p); }
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_param_refs(arr[i], name_p); }
    }
    else { return 0; }
    }
    return sum;
}

// ── S4 P1: body-level cost helpers (call-site bonuses live in P2) ──
//
// Each helper walks a function body (array of statement Node pointers
// + count). Unlike the expression-only helpers above, these are
// statement-aware from day one — they sum over every statement and
// recursively walk via the extended expression helpers.

// Sum `_inline_count_nodes` across every statement in a body. Returns
// 99 if any statement contains an unhandled control-flow type (the
// expression helper's safety net propagates through).
static _inline_count_nodes_body(body_arr, body_cnt) {
    auto i, sum, s;
    sum = 0;
    for (i = 0; i < body_cnt; i++) {
        s = _inline_count_nodes(body_arr[i]);
        if (s >= INLINE_DISQ) { return INLINE_DISQ; }     // unhandled type — disqualify
        sum += s;
    }
    return sum;
}

// Count T_MEMST nodes anywhere in a body. T_MEMST is the parser's
// node for writes through a pointer or subscript (`p[i] = v`,
// `(*p) = v`), which is how every global-write happens in B++ when
// the LHS is a buf_word/buf_byte slot. Direct global assignments
// `glob = v` use T_ASSIGN whose .a is a T_VAR referencing the
// global; those are counted by `_inline_assign_to_global_count`
// below. For the cost formula (Q2) we sum both into
// `global_write_count`.
static _inline_memst_count(nd) {
    auto n: Node, t, arr, cnt, i, sum;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_MEMST) { return 1 + _inline_memst_count(n.a) + _inline_memst_count(n.b); }
    sum = 0;
    switch (t) {
    T_BINOP    { sum = _inline_memst_count(n.b) + _inline_memst_count(n.c); }
    T_UNARY    { sum = _inline_memst_count(n.b); }
    T_MEMLD    { sum = _inline_memst_count(n.a); }
    T_ADDR     { sum = _inline_memst_count(n.a); }
    T_TERNARY  { sum = _inline_memst_count(n.a) + _inline_memst_count(n.b) + _inline_memst_count(n.c); }
    T_CALL {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_memst_count(arr[i]); }
    }
    T_ASSIGN   { sum = _inline_memst_count(n.a) + _inline_memst_count(n.b); }
    T_RET      { sum = _inline_memst_count(n.a); }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes, see its own comment for why this is safe.
    T_IF {
        sum = _inline_memst_count(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_memst_count(arr[i]); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { sum += _inline_memst_count(arr[i]); }
        }
    }
    T_WHILE {
        sum = _inline_memst_count(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_memst_count(arr[i]); }
        if (n.e != 0) { sum += _inline_memst_count(n.e); }
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_memst_count(arr[i]); }
    }
    else { return 0; }
    }
    return sum;
}

// Sum `_inline_memst_count` across every statement.
static _inline_global_write_count(body_arr, body_cnt) {
    auto i, sum;
    sum = 0;
    for (i = 0; i < body_cnt; i++) {
        sum += _inline_memst_count(body_arr[i]);
    }
    return sum;
}

// Indirect call counter. Phase B2 rejects any T_CALL in the body
// entirely (`_inline_has_tcall`), so S4 starts with the same
// posture — any T_CALL = reject. The helper exists so the cost
// formula's `5 × indirect_call_count` term has a well-defined
// callable; when classify_inlineable_v2 lands in P3a it can choose
// to relax the all-or-nothing T_CALL gate (allowing e.g. inlined-
// callee calls to other Phase B2 candidates). For now this counts
// every T_CALL conservatively; the bonus/penalty arithmetic falls
// out clean either way.
static _inline_indirect_call_count_node(nd) {
    auto n: Node, t, arr, cnt, i, sum;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        sum = 1;
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_indirect_call_count_node(arr[i]); }
        return sum;
    }
    sum = 0;
    switch (t) {
    T_BINOP    { sum = _inline_indirect_call_count_node(n.b) + _inline_indirect_call_count_node(n.c); }
    T_UNARY    { sum = _inline_indirect_call_count_node(n.b); }
    T_MEMLD    { sum = _inline_indirect_call_count_node(n.a); }
    T_ADDR     { sum = _inline_indirect_call_count_node(n.a); }
    T_TERNARY  { sum = _inline_indirect_call_count_node(n.a) + _inline_indirect_call_count_node(n.b) + _inline_indirect_call_count_node(n.c); }
    T_ASSIGN   { sum = _inline_indirect_call_count_node(n.a) + _inline_indirect_call_count_node(n.b); }
    T_MEMST    { sum = _inline_indirect_call_count_node(n.a) + _inline_indirect_call_count_node(n.b); }
    T_RET      { sum = _inline_indirect_call_count_node(n.a); }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes, see its own comment for why this is safe.
    T_IF {
        sum = _inline_indirect_call_count_node(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_indirect_call_count_node(arr[i]); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { sum += _inline_indirect_call_count_node(arr[i]); }
        }
    }
    T_WHILE {
        sum = _inline_indirect_call_count_node(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_indirect_call_count_node(arr[i]); }
        if (n.e != 0) { sum += _inline_indirect_call_count_node(n.e); }
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { sum += _inline_indirect_call_count_node(arr[i]); }
    }
    else { return 0; }
    }
    return sum;
}

static _inline_indirect_call_count(body_arr, body_cnt) {
    auto i, sum;
    sum = 0;
    for (i = 0; i < body_cnt; i++) {
        sum += _inline_indirect_call_count_node(body_arr[i]);
    }
    return sum;
}

// ── Call-site bonuses (used by P2 threshold function) ──────
//
// Both helpers below depend on the call-site (args list) rather
// than the callee body. They are defined here so the cost formula
// has a single home; P2 wires them into the per-callsite threshold
// computation.

// Count arguments that are literal constants. Each `T_LIT` arg
// gives the cost model a -10 bonus per Q2 — typical case is
// `peek_byte(buf, 0)` where the index argument is a compile-time
// constant the inlined body can fold away.
static _inline_const_arg_count(args_arr, arg_cnt) {
    auto i, sum, n: Node, t;
    sum = 0;
    for (i = 0; i < arg_cnt; i++) {
        if (args_arr[i] == 0) { continue; }
        n = args_arr[i];
        t = n.ntype;
        if (t == T_LIT) { sum++; }
    }
    return sum;
}

// Dead-branch counter — currently a placeholder returning 0.
// Honest detection requires substituting args into the callee body
// (e.g. T_TERNARY where the condition references a parameter
// becomes constant after substitution) which depends on the P3a
// `ast_clone_subst` extension. Defined here so the cost formula
// compiles; P3a or P3c upgrades this to do real substitution-aware
// analysis. Until then, the 5 × dead_branch_count bonus contributes
// zero, slightly under-rewarding inline candidates with provable
// dead branches.
static _inline_dead_branch_count(body_arr, body_cnt, args_arr, arg_cnt) {
    return 0;
}

// Aggregate body-level cost per the Q2 formula. Reads the callee
// function record (params, body) by index and the call site's args
// array. Returns a positive integer; smaller = cheaper. Compared
// against the per-callsite threshold computed in P2.
//
//   cost = node_count
//        + 5  × indirect_call_count
//        + 10 × global_write_count
//        - 10 × const_arg_count
//        - 5  × dead_branch_count          (P3+ wires real detection)
//
// Not called yet. P3a's `classify_inlineable_v2` is the first
// consumer; for P1 it stays as pure infrastructure so bootstrap
// + suite stay byte-stable.
static _inline_cost(fn_idx, args_arr, arg_cnt) {
    auto fn_rec, body_arr, body_cnt;
    auto nodes, indirect, globals, consts, dead;
    fn_rec = funcs[fn_idx];
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    if (body_arr == 0 || body_cnt == 0) { return INLINE_DISQ; }
    nodes = _inline_count_nodes_body(body_arr, body_cnt);
    if (nodes >= INLINE_DISQ) { return INLINE_DISQ; }        // disqualified body
    indirect = _inline_indirect_call_count(body_arr, body_cnt);
    globals  = _inline_global_write_count(body_arr, body_cnt);
    consts   = _inline_const_arg_count(args_arr, arg_cnt);
    dead     = _inline_dead_branch_count(body_arr, body_cnt, args_arr, arg_cnt);
    return nodes + 5 * indirect + 10 * globals - 10 * consts - 5 * dead;
}

// ── S4 P2: per-callsite threshold function ──────────────────
//
// Companion to `_inline_cost` above. The threshold is computed
// PER-CALLSITE (not per-callee) because the same callee can be
// worth inlining at one site and not worth it at another:
// inside a tight loop the inliner trades a bigger body for the
// saved call-frame on every iteration, while at a one-shot
// startup site the same body is just bloat.
//
// Per Q2 of the S4 design doc, plus Inc 8's hotness-propagation term:
//
//   threshold = INLINE_BASE_THRESHOLD              # default 30
//   if caller in hot path (fanout):     threshold *= 2
//   if callsite in loop (shallow):      threshold *= 1.5
//   if caller is hot TRANSITIVELY:      threshold *= 3      (Inc 8)
//
// Caller hotness = caller has many call sites itself, signalled
// by `arr_len(_fn_callers[caller_idx])`. A heavily-called caller
// is hot transitively, so its own call sites are hot. Threshold
// `INLINE_HOT_FANOUT = 10` is a conservative starting point —
// any caller invoked from 10+ places passes the gate. Adjustable
// post-bench (P6) via the `--inline-threshold` flag landing in
// P5; for now the constant is in source.
//
// Loop-depth signal lives on the T_CALL node's `.d` field
// (S4 P0a), stamped at parse time by parse_while / parse_for.
// Switch arms intentionally do NOT bump the counter — one-shot
// dispatch, not repetition (see commit 5ca27fa rationale).
//
// Both signals above are SHALLOW (one hop: does THIS call site sit in
// a loop; does the caller have many direct callers). Neither sees a
// real-time DSP chain where the loop is several calls away (`sf_render`'s
// per-sample loop -> sf_channel_process -> zener_process -> comp_process
// -> db_to_amp_f -> exp_f — the loop is 5 calls from exp_f). Inc 8's
// `fn_hot_transitive[caller_idx]` (built by `_dsp_build_hot_transitive`,
// propagated over the whole call graph, not just one hop) catches that
// case. ×3 — bigger than either shallow multiplier — because "proven
// reachable from an actual loop, at any depth" is strictly more
// information than "this caller merely has many callers" or "this one
// call site happens to sit in a loop textually"; chosen to clear
// `exp_f`'s measured cost (78) from a cold-looking base (30) once a
// real DSP chain proves it hot, not picked to hit that number exactly —
// re-measure if a second real candidate needs a different value.
//
// First consumer: `_inline_pre_reg_walk`'s per-callsite cost-vs-
// threshold gate (Inc 8) — the second of the two places this comment
// used to say "not called yet."
const INLINE_BASE_THRESHOLD = 30;
const INLINE_HOT_FANOUT     = 10;
const INLINE_HOT_TRANSITIVE_MULT = 3;

static _inline_caller_fanout(caller_idx) {
    auto callers;
    if (caller_idx < 0) { return 0; }
    if (caller_idx >= arr_len(_fn_callers)) { return 0; }
    callers = arr_get(_fn_callers, caller_idx);
    if (callers == 0) { return 0; }
    return arr_len(callers);
}




// Does this body contain ANY T_CALL, at any depth? A callee with none
// is a TRUE LEAF: splicing it can never cascade further bodies in —
// the tier-4 threshold grants leaves extra room (see _inline_threshold).
static _inline_expr_has_any_call(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_CALL) { return 1; }
    if (t == T_BINOP) { return _inline_expr_has_any_call(n.b) || _inline_expr_has_any_call(n.c); }
    if (t == T_UNARY) { return _inline_expr_has_any_call(n.b); }
    if (t == T_MEMLD || t == T_ADDR) { return _inline_expr_has_any_call(n.a); }
    if (t == T_TERNARY) {
        return _inline_expr_has_any_call(n.a) || _inline_expr_has_any_call(n.b) || _inline_expr_has_any_call(n.c);
    }
    return 0;
}
static _inline_body_has_any_call(body_arr, body_cnt) {
    auto i, k, s: Node;
    for (i = 0; i < body_cnt; i++) {
        s = body_arr[i];
        if (s == 0) { continue; }
        if (s.ntype == T_ASSIGN) { if (_inline_expr_has_any_call(s.b)) { return 1; } continue; }
        if (s.ntype == T_MEMST) {
            if (_inline_expr_has_any_call(s.a)) { return 1; }
            if (_inline_expr_has_any_call(s.b)) { return 1; }
            continue;
        }
        if (s.ntype == T_RET) {
            if (s.c > 1) {
                for (k = 0; k < s.c; k++) { if (_inline_expr_has_any_call(*(s.b + k * 8))) { return 1; } }
            } else {
                if (_inline_expr_has_any_call(s.a)) { return 1; }
            }
            continue;
        }
        if (s.ntype == T_IF) {
            if (_inline_expr_has_any_call(s.a)) { return 1; }
            if (_inline_body_has_any_call(s.b, s.c)) { return 1; }
            if (s.e > 0) { if (_inline_body_has_any_call(s.d, s.e)) { return 1; } }
            continue;
        }
        if (s.ntype == T_WHILE) {
            if (_inline_expr_has_any_call(s.a)) { return 1; }
            if (_inline_body_has_any_call(s.b, s.c)) { return 1; }
            if (s.e != 0) { if (_inline_expr_has_any_call(s.e)) { return 1; } }
            continue;
        }
        if (s.ntype == T_BLOCK) {
            if (_inline_body_has_any_call(s.b, s.c)) { return 1; }
            continue;
        }
        if (_inline_expr_has_any_call(s)) { return 1; }
    }
    return 0;
}

static _inline_threshold(callee_idx, caller_idx, call_node) {
    auto n: Node, threshold;
    threshold = INLINE_BASE_THRESHOLD;
    if (_inline_caller_fanout(caller_idx) >= INLINE_HOT_FANOUT) {
        threshold = threshold * 2;
    }
    if (call_node != 0) {
        n = call_node;
        // n.d = loop_depth stamped by parser (S4 P0a). Defaults to
        // 0 for the rare case of a synth-constructed T_CALL that
        // never went through parse_call_expression (no current
        // such site exists; the guard is defensive).
        if (n.d > 0) {
            // Q2 specifies × 1.5; integer-safe as × 3 / 2.
            threshold = threshold * 3 / 2;
        }
    }
    if (caller_idx >= 0 && caller_idx < arr_len(fn_hot_transitive)) {
        if (arr_get(fn_hot_transitive, caller_idx)) {
            threshold = threshold * INLINE_HOT_TRANSITIVE_MULT;
        }
    }
    // Leaf bonus, second landing (2026-07-11): the guarded
    // transcendental family (exp_f 98 / cos_f 101 / log_f 104 /
    // sin_f 106) sits just past the 90 hot ceiling; a TRUE LEAF cannot
    // cascade further bodies in, so its threshold doubles. The first
    // landing (without the pressure account) was refused by the
    // all-inserts bench at +27% — thirty admitted sites diluted the
    // merged callers. The pressure gate now bounds exactly that: a fat
    // host denies the splice, a thin wrapper admits it.
    auto _lf_rec;
    if (callee_idx >= 0) {
        _lf_rec = funcs[callee_idx];
        if (_inline_body_has_any_call(*(_lf_rec + FN_BODY), *(_lf_rec + FN_BCNT)) == 0) {
            threshold = threshold * 2;
        }
    }
    return threshold;
}

// ── S4 P3b-1: multi-statement splice infrastructure (dead code) ──
//
// All of the helpers below are part of the multi-statement
// inline machinery. P3b-1 (this commit) only DEFINES them;
// nothing calls them yet. P3b-2 wires them in:
//   * `_inline_pre_reg_walk_body` invoked from each chip's
//     `pre_reg_vars` so the caller's frame gets `_inl<N>_<orig>`
//     slots for every inlineable multi-stmt callsite.
//   * The splice point in `a64_codegen.bsm:1200+` extended to
//     emit the binding prologue + prelude statements + final
//     T_RET expression for body_cnt > 1 callees.
//
// Bootstrap stays byte-stable for P3b-1 because none of these
// functions are reached from emit code paths.

// Per-function monotonic counter for unique inline call site
// IDs. The first callsite in a function gets ID 1; ID 0 is the
// "not an inline site" sentinel for the T_CALL.e field.
// `cg_emit_func` resets this before each function via
// `_inline_reset_callsite_id()`.
global _inline_callsite_id;

// Inc 6 (nested-inline architecture): per-function, parallel to the
// callsite-id space above. Index = an OUTER callsite id; value = an
// arr_new()-style array of nested callsite ids (0 if none), in the same
// left-to-right depth-first order `_inline_find_nested_calls` always
// visits T_CALL nodes in. Pre-reg time (`_inline_register_nested`)
// populates this by walking the callee's SHARED body read-only and
// registering each nested target's own slots (safe — registration never
// touches any node). Splice time (`_cg_inline_splice_prelude`) walks its
// OWN fresh, structurally-identical clone with the same walker and
// stamps `.e` from this array positionally — the only thing ever
// mutated is the clone, never the shared original, so two different
// outer callers of the same nested-call-containing callee (e.g.
// moog_tick and moog_slope both calling moog_taps) can never collide.
global _inline_nested_ids;

// Cycle guard for the nested-registration recursion below (2026-06-24).
// `_inline_register_callsite_slots` <-> `_inline_register_nested` assumed
// an acyclic call graph among inlinable functions — true by construction
// while only pure single/multi-statement leaves could ever qualify (no
// two of those in this codebase happened to call each other), false the
// instant a loop-bodied PAIR does (found by the compiler hanging on its
// own source once exp_f/log_f-shaped bodies became eligible — two
// mutually-recursive control-flow leaves elsewhere in this codebase hit
// the gap directly). Index = fidx; 1 while that function's OWN
// registration is in progress on the current recursive descent. A
// nested call back to an fidx already on this "in progress" set is a
// genuine cycle, not "called from two different places" (which is fine,
// unguarded, and common — e.g. moog_taps from both moog_tick and
// moog_slope) — skip recursing into THAT occurrence's own nested calls
// one more level (the id is still allocated and the call site still
// gets spliced normally; only ITS nested calls fall through to a real
// `bl`, the same safe-but-not-maximally-optimal degradation already
// documented on `.e`'s reset in ast_clone_subst) instead of recursing
// forever.
static auto _inline_registering;

void _inline_reset_callsite_id() {
    _inline_callsite_id = 0;
    _inline_nested_ids = arr_new();
    _inline_registering = arr_new();
}

// Construct a mangled packed name `_inl<id>_<orig>` by appending
// bytes to vbuf. Returns a packed reference to the new name.
// `id` must be > 0 (the sentinel 0 is "no inline").
//
// Layout of the mangled bytes:
//   "_inl" (4) + decimal digits of id (variable) + "_" (1) + orig
//
// The original name is read from `vbuf + unpack_s(orig_p)` so
// the function is independent of how `orig_p` was constructed.
_inline_pack_mangled_name(id, orig_p) {
    auto start, i, n, digits, orig_len, orig_off, ch, div, d;
    start = vbuf_pos;
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'i'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'n'); vbuf_pos++;
    poke(vbuf + vbuf_pos, 'l'); vbuf_pos++;
    n = id; digits = 0;
    while (n > 0) { digits++; n = n / 10; }
    if (digits == 0) { digits = 1; }
    div = 1;
    i = 1;
    while (i < digits) { div = div * 10; i++; }
    n = id;
    i = 0;
    while (i < digits) {
        d = n / div;
        poke(vbuf + vbuf_pos, d + '0');
        vbuf_pos++;
        n = n - d * div;
        div = div / 10;
        i++;
    }
    poke(vbuf + vbuf_pos, '_'); vbuf_pos++;
    orig_len = unpack_l(orig_p);
    orig_off = unpack_s(orig_p);
    i = 0;
    while (i < orig_len) {
        ch = peek(vbuf + orig_off + i);
        poke(vbuf + vbuf_pos, ch);
        vbuf_pos++;
        i++;
    }
    return pack(start, 4 + digits + 1 + orig_len);
}

// Scan top-level statements of a callee body for T_DECL nodes
// and register a mangled `_inl<id>_<orig>` slot for each local.
// Mirrors the type-metadata copy that `a64_pre_reg_vars` does
// for regular T_DECL nodes (n.c → cg_var_forced_ty, n.d →
// cg_var_stack + cg_var_struct_idx). Without this propagation
// typed locals like `auto m: Hash` lose their forced_ty when
// inlined and the codegen's typed store/load path takes the
// wrong branch for struct-typed slots.
//
// T_DECL.a is either a single packed name (when .b == 1) or a
// word-array of packed names (when .b > 1, for `auto x, y, z;`).
// Walks `scan_arr`/`scan_cnt` for T_DECL — recursing into T_IF/T_WHILE/
// T_BLOCK so a local declared INSIDE a loop/if (the autovec SIMD-
// synthesis targets' per-element `auto c: Cell;` inside their own
// for-loop — tests/test_autovec_compose.bpp) gets registered too, same
// reason and same shape as _inline_collect_locals_walk's own extension.
// `top_body_arr`/`top_body_cnt` stay fixed at the ORIGINAL, outermost
// call's body the whole way down — the per-declarator reference count
// must scan the WHOLE function body (including sibling loops/branches a
// nested declaration's references might also appear in via further
// nesting), not just the scan level the declaration itself was found
// at; _inline_param_refs already recurses into control flow on its own
// (see its own 2026-06-24 extension), so passing it the unchanged
// top-level array is correct regardless of how deep `scan_arr` is.
static _inline_register_callee_locals_walk(scan_arr, scan_cnt, id, top_body_arr, top_body_cnt) {
    auto i, j, vi, k, ref_count;
    auto n: Node;
    auto mangled, orig_name;
    i = 0;
    while (i < scan_cnt) {
        n = scan_arr[i];
        if (n != 0) {
            if (n.ntype == T_DECL) {
                j = 0;
                while (j < n.b) {
                    orig_name = *(n.a + j * 8);
                    mangled = _inline_pack_mangled_name(id, orig_name);
                    vi = cg_var_add(mangled);
                    if (n.d == 1) {
                        arr_set(cg_var_stack, vi, 1);
                        arr_set(cg_var_struct_idx, vi, get_var_type(orig_name));
                    }
                    // Per-declarator hint (n.e[j]); cl.e is copied by value in
                    // ast_clone_subst, so the inlined decl shares the array.
                    auto _vh;
                    _vh = cg_decl_var_hint(n, j);
                    if (_vh > 0) {
                        arr_set(cg_var_forced_ty, vi, _vh);
                    }
                    // Mirror the callee body's reference count onto
                    // the mangled slot so the b3 selector (which
                    // runs BEFORE the inline expansion at emit time)
                    // can decide whether this slot deserves register
                    // promotion. Without this, every inlined local
                    // would default to frame storage and hot inner-
                    // loop work (xorshift64's `s` is the canonical
                    // case) would lose the B3 promotion the original
                    // function got. _inline_param_refs already walks
                    // the statement-typed body shape post-P1.
                    ref_count = 0;
                    k = 0;
                    while (k < top_body_cnt) {
                        ref_count += _inline_param_refs(top_body_arr[k], orig_name);
                        k++;
                    }
                    arr_set(cg_var_refs, vi, ref_count);
                    j++;
                }
            } else if (n.ntype == T_IF) {
                _inline_register_callee_locals_walk(n.b, n.c, id, top_body_arr, top_body_cnt);
                if (n.e > 0) {
                    _inline_register_callee_locals_walk(n.d, n.e, id, top_body_arr, top_body_cnt);
                }
            } else if (n.ntype == T_WHILE) {
                _inline_register_callee_locals_walk(n.b, n.c, id, top_body_arr, top_body_cnt);
            } else if (n.ntype == T_BLOCK) {
                _inline_register_callee_locals_walk(n.b, n.c, id, top_body_arr, top_body_cnt);
            }
        }
        i++;
    }
}

_inline_register_callee_locals(body_arr, body_cnt, id) {
    _inline_register_callee_locals_walk(body_arr, body_cnt, id, body_arr, body_cnt);
}

// Register the slot block for one callsite: assigns the next monotonic
// id, then registers `_inl<id>_<orig>` slots for every callee parameter
// and every callee local in the caller's frame. After this returns,
// `cg_var_idx(mangled_name)` resolves to a valid slot index for use by
// the splice procedure. Returns the assigned id. Does NOT touch any
// T_CALL node — callers decide separately whose `.e` field (if any)
// gets stamped with the returned id (see `_inline_register_callsite`
// Does this body contain a T_WHILE anywhere? A loop-carrying callee's
// locals are hot on their own, so its splice is the pressure-gated
// kind (see INLINE_PRESSURE_CAP above).
static _inline_body_has_loop(body_arr, body_cnt) {
    auto i, s: Node;
    for (i = 0; i < body_cnt; i++) {
        s = body_arr[i];
        if (s == 0) { continue; }
        if (s.ntype == T_WHILE) { return 1; }
        if (s.ntype == T_IF) {
            if (_inline_body_has_loop(s.b, s.c)) { return 1; }
            if (s.e > 0) { if (_inline_body_has_loop(s.d, s.e)) { return 1; } }
        }
        if (s.ntype == T_BLOCK) {
            if (_inline_body_has_loop(s.b, s.c)) { return 1; }
        }
    }
    return 0;
}

// How many caller-frame slots would splicing `fidx` append — its
// parameters plus every local declared anywhere in its body (the same
// set _inline_register_callsite_slots / _register_callee_locals
// create as _inl<id>_* slots).
static _inline_count_decls(body_arr, body_cnt) {
    auto i, cnt, s: Node;
    cnt = 0;
    for (i = 0; i < body_cnt; i++) {
        s = body_arr[i];
        if (s == 0) { continue; }
        if (s.ntype == T_DECL) { cnt += s.b; }
        if (s.ntype == T_IF) {
            cnt += _inline_count_decls(s.b, s.c);
            if (s.e > 0) { cnt += _inline_count_decls(s.d, s.e); }
        }
        if (s.ntype == T_WHILE || s.ntype == T_BLOCK) {
            cnt += _inline_count_decls(s.b, s.c);
        }
    }
    return cnt;
}
static _inline_callee_slot_need(fidx) {
    auto fn_rec;
    fn_rec = funcs[fidx];
    return *(fn_rec + FN_PCNT) + _inline_count_decls(*(fn_rec + FN_BODY), *(fn_rec + FN_BCNT));
}

// The admission decision. Registration-time ONLY: a denial simply
// leaves the callsite id at 0 (top-level: .e never stamped; nested:
// a 0 pushed into nested_ids), and the splice machinery's existing
// `.e == 0 -> real bl` convention does the rest — consumption never
// re-runs this check, so the two phases cannot disagree.
static _inline_pressure_admit(fidx) {
    auto fn_rec, live, need;
    fn_rec = funcs[fidx];
    if (_inline_body_has_loop(*(fn_rec + FN_BODY), *(fn_rec + FN_BCNT)) == 0) { return 1; }
    live = arr_len(cg_vars);
    need = _inline_callee_slot_need(fidx);
    if (live + need <= INLINE_PRESSURE_CAP) { return 1; }
    if (_inl_probe) {
        diag_str("INLPROBE pressure DENY callee=");
        diag_buf(vbuf + unpack_s(*(fn_rec + FN_NAME)), unpack_l(*(fn_rec + FN_NAME)));
        diag_str(" live=");
        diag_int(live);
        diag_str(" need=");
        diag_int(need);
        diag_newline();
    }
    return 0;
}

// below for the top-level case, `_inline_register_nested` for the
// Inc 6 nested case, which deliberately never stamps the SHARED body).
_inline_register_callsite_slots(fidx) {
    auto fn_rec, body_arr, body_cnt, params, pcnt, i, vi, k, ref_count;
    auto orig_p, mangled, id, already_registering;
    while (arr_len(_inline_registering) <= fidx) {
        _inline_registering = arr_push(_inline_registering, 0);
    }
    already_registering = arr_get(_inline_registering, fidx);
    _inline_callsite_id++;
    id = _inline_callsite_id;
    fn_rec = funcs[fidx];
    params = *(fn_rec + FN_PARS);
    pcnt = *(fn_rec + FN_PCNT);
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    i = 0;
    while (i < pcnt) {
        orig_p = *(params + i * 8);
        mangled = _inline_pack_mangled_name(id, orig_p);
        vi = cg_var_add(mangled);
        // Inc 4-revised: a FLOAT param's mangled slot must carry the float type,
        // or the binding store `_inl<id>_<param> = <arg>` would write a float
        // through an int slot → FCVTZS truncation. Type ONLY float params; int /
        // sub-word slots stay untyped (word) as before, so existing tier-2 int
        // candidates are byte-for-byte unchanged.
        if (is_float_type(get_fn_par_type(fidx, i))) {
            arr_set(cg_var_forced_ty, vi, get_fn_par_type(fidx, i));
        }
        // Mirror callee body's reference count to the mangled
        // param slot. The b3 selector consults this to decide
        // promotion, and the splice helper may bind args into
        // this slot (complex args path); promoting hot mangled
        // params keeps the inlined code in registers.
        ref_count = 0;
        k = 0;
        while (k < body_cnt) {
            ref_count += _inline_param_refs(body_arr[k], orig_p);
            k++;
        }
        arr_set(cg_var_refs, vi, ref_count);
        i++;
    }
    _inline_register_callee_locals(body_arr, body_cnt, id);
    // Inc 6: this callee's OWN body may itself call other inlinable
    // functions (e.g. moog_taps calling flt_onepole_tick). Register
    // THEIR slots too, into this same outer frame, right now — before
    // this function (and therefore pre-reg) returns. See
    // _inline_register_nested's own comment for why this must happen
    // here and not later, at splice/emission time.
    //
    // Cycle guard (see _inline_registering's own comment): only descend
    // if fidx is not ALREADY being registered higher up this same
    // recursive call — this callsite's own slots (above) are always
    // registered regardless, so the splice itself is unaffected either
    // way; only a redundant, infinite re-walk of an already-in-progress
    // function's nested calls is skipped.
    if (already_registering == 0) {
        arr_set(_inline_registering, fidx, 1);
        _inline_register_nested(id, body_arr, body_cnt, fidx);
        arr_set(_inline_registering, fidx, 0);
    }
    return id;
}

// Register a single inline call site reached directly from the caller's
// own body (the top-level case — what _inline_pre_reg_walk calls). Stamps
// the assigned id onto `call_node.e`; this is always safe here because
// `call_node` is a node living in the CALLER's own body, which belongs to
// exactly one function and is never shared with any other caller.
void _inline_register_callsite(call_node, fidx) {
    auto cn: Node, id;
    // Budget-aware admission: a pressure denial leaves .e at 0 and the
    // call site stays a real bl (see INLINE_PRESSURE_CAP).
    if (_inline_pressure_admit(fidx) == 0) { return; }
    cn = call_node;
    id = _inline_register_callsite_slots(fidx);
    cn.e = id;
}

// Inc 6 (nested-inline architecture) — pure-discovery walk. Appends
// every T_CALL node (pointer) in `nd` whose target needs the binding
// splice (multi-statement body, or tier 2 — tier 1's fast-substitute
// path needs no pre-registered slot and already composes for free with
// no help from this machinery; tier-3 hot-only nested targets are
// deliberately not handled yet, out of scope) to `out_arr`, in
// deterministic left-to-right depth-first order. VOID-inlineable
// targets ARE handled (nested-VI, 2026-07-05): a statement call like
// `delay_push(...)` inside a clone-substituted body used to survive as
// a real `bl` because the clone's `.e` resets to 0 and only THIS walk
// can re-stamp it — the exact gap lever-1 left open in spring_process
// (4 surviving delay_push bls per sample). Does NOT
// register anything and does NOT touch `.e` — purely read-only. Called
// twice per nested-call-containing callee: once on the callee's SHARED,
// canonical body (pre-reg time, via `_inline_register_nested`, to learn
// what needs registering) and once on each caller's own FRESH,
// structurally-identical clone (splice time, via
// `_cg_inline_splice_prelude`, to learn which clone node gets which
// already-registered id). Because `ast_clone_subst` preserves tree SHAPE
// exactly, both walks visit nodes in identical order by construction —
// this is what lets the two phases agree without any other
// coordination, and why the shared body itself is never mutated.
// `owner_fidx` (Inc 8): the function whose body this AST belongs to —
// needed ONLY for the tier-4 cost-vs-threshold check below (caller_idx
// for `_inline_threshold`). Threaded through every recursive call so
// registration time (`_inline_register_nested`) and splice time
// (`_cg_inline_splice_prelude` / `_inline_stamp_nested`) ALWAYS agree on
// exactly which nested calls qualify — they must find the identical set,
// in the identical order, or the positional `nested_ids[nk]` stamping
// downstream silently reads the wrong id for the wrong call.
_inline_find_nested_calls(nd, out_arr, owner_fidx) {
    auto n: Node, t, arr, cnt, i, fidx, fn_rec2, callee_bcnt2;
    if (nd == 0) { return out_arr; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
        fidx = find_func_idx(n.a);
        if (fidx >= 0 && arr_get(fn_inlineable, fidx)) {
            if (arr_get(fn_inlineable, fidx) == 4) {
                // Inc 8: oversized, cost-gated — same per-callsite check
                // as the top-level walker, just reached through a nested
                // body instead of directly. owner_fidx is the function
                // whose body n lives in (e.g. db_to_amp_f, itself being
                // spliced into comp_process) — fn_hot_transitive[owner_fidx]
                // is what lets exp_f clear here once db_to_amp_f's own
                // hotness has propagated up from the real DSP loop.
                auto _ip_c, _ip_t;
                _ip_c = _inline_cost(fidx, n.b, n.c);
                _ip_t = _inline_threshold(fidx, owner_fidx, n);
                if (_inl_probe) {
                    diag_str("INLPROBE t4-nested callee=");
                    diag_buf(vbuf + unpack_s(n.a), unpack_l(n.a));
                    diag_str(_ip_c <= _ip_t ? " ADMIT" : " DENY");
                    diag_str(" cost=");
                    diag_int(_ip_c);
                    diag_str(" thr=");
                    diag_int(_ip_t);
                    diag_newline();
                }
                if (_ip_c <= _ip_t) {
                    out_arr = arr_push(out_arr, n);
                }
            } else {
                fn_rec2 = funcs[fidx];
                callee_bcnt2 = *(fn_rec2 + FN_BCNT);
                if (callee_bcnt2 > 1 || arr_get(fn_inlineable, fidx) == 2) {
                    out_arr = arr_push(out_arr, n);
                }
            }
        } else if (fidx >= 0 && arr_get(fn_void_inlineable, fidx)) {
            // Nested-VI (2026-07-05): a void / statement-context callee
            // reached through a spliced body. Admitted unconditionally,
            // mirroring the top-level walker's own VI branch exactly
            // (`_inline_pre_reg_walk` registers VI targets with no cost
            // gate) — registration time and splice time therefore agree
            // on the identical set in the identical order for free,
            // because both sides run through THIS one function.
            out_arr = arr_push(out_arr, n);
        }
        return out_arr;
    }
    switch (t) {
    T_BINOP   { out_arr = _inline_find_nested_calls(n.b, out_arr, owner_fidx); out_arr = _inline_find_nested_calls(n.c, out_arr, owner_fidx); }
    T_UNARY   { out_arr = _inline_find_nested_calls(n.b, out_arr, owner_fidx); }
    T_MEMLD   { out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx); }
    T_ADDR    { out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx); }
    T_TERNARY {
        out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx);
        out_arr = _inline_find_nested_calls(n.b, out_arr, owner_fidx);
        out_arr = _inline_find_nested_calls(n.c, out_arr, owner_fidx);
    }
    T_ASSIGN  { out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx); out_arr = _inline_find_nested_calls(n.b, out_arr, owner_fidx); }
    T_MEMST   { out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx); out_arr = _inline_find_nested_calls(n.b, out_arr, owner_fidx); }
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            i = 0;
            while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
        } else {
            out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx);
        }
    }
    // Control-flow leaf bodies (2026-06-24) — same extension as
    // _inline_count_nodes. Without this, a nested call hiding inside a
    // spliced loop (log_f's `m / exp_f(y)` inside its own Newton
    // for-loop) would never get its callsite id stamped — NOT a
    // correctness bug (ast_clone_subst resets a fresh clone's `.e` to 0,
    // so the un-stamped call just falls through to a real `bl`, exactly
    // as documented above), but it leaves one more `bl` on the table
    // than necessary. Closing it here too so log_f's OWN inlining of
    // exp_f survives one level further out.
    T_IF {
        out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            i = 0;
            while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
        }
    }
    T_WHILE {
        out_arr = _inline_find_nested_calls(n.a, out_arr, owner_fidx);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
        if (n.e != 0) { out_arr = _inline_find_nested_calls(n.e, out_arr, owner_fidx); }
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { out_arr = _inline_find_nested_calls(arr[i], out_arr, owner_fidx); i++; }
    }
    else { }
    }
    return out_arr;
}

// Inc 6 — pre-reg-time half of nested-inline support. `outer_id` is the
// callsite id just assigned to the callee whose body is `body_arr`/
// `body_cnt` (the callee's OWN, shared, canonical body — read-only).
// Finds every nested inlinable call in it and registers each one's own
// slot block (recursing naturally if that nested callee ALSO has nested
// calls — bounded by the actual, acyclic call graph, no artificial depth
// cap needed). Records the resulting ids, in discovery order, in
// `_inline_nested_ids[outer_id]` for splice time to consume positionally.
// Registers; never stamps `.e` on anything — see `_inline_find_nested_calls`.
void _inline_register_nested(outer_id, body_arr, body_cnt, owner_fidx) {
    auto i, found, n: Node, fidx, nested_id, ids, last_stmt: Node, scan_cnt;
    // Scope to exactly the statements splice-time's own per-statement
    // loop will clone+walk: when the body ends in T_RET, that trailing
    // statement is handled separately by each tail (cg_emit_inline_multi/
    // cg_emit_inline_multi_assign) — but it IS now also scanned (see
    // below), via the SAME `_inline_find_nested_calls` call those tails'
    // own post-clone stamping (`_inline_stamp_nested`) consumes from in
    // the identical order. Originally out of scope ("moog_taps's own
    // `return a,b,c,d;` has no calls in it, matching this limit exactly")
    // — found mattering for real re-disassembling moon_filter.bsm's
    // moon_process: `auto pp; pp=p; return moog_slope(pp.flt, in,
    // pp.slope);` hides its ENTIRE nested call inside the trailing
    // return, so the old exclusion meant moog_slope (itself made
    // inlineable by the switch-normalisation above) could never nest
    // into a caller that spliced moon_process in — confirmed via
    // bug --disasm: moon_process always re-appeared as a real `bl
    // moog_slope` inside any outer splice, even though moon_process
    // ITSELF, compiled standalone, already inlined that exact call
    // (the ordinary top-level pre-reg walk DOES descend into a trailing
    // return; only the NESTED path excluded it). A void body with no
    // trailing T_RET has no such tail — splice's loop walks ALL
    // body_cnt statements — so scan all of them, unchanged.
    last_stmt = body_arr[body_cnt - 1];
    if (last_stmt.ntype == T_RET) {
        scan_cnt = body_cnt - 1;
    } else {
        scan_cnt = body_cnt;
    }
    found = arr_new();
    i = 0;
    while (i < scan_cnt) {
        found = _inline_find_nested_calls(body_arr[i], found, owner_fidx);
        i++;
    }
    // _inline_find_nested_calls already has its own correct T_RET case
    // (single AND multi-return) — calling it directly on the trailing
    // statement reuses that, rather than duplicating the n.c>1 branch
    // here a third time.
    if (last_stmt.ntype == T_RET) {
        found = _inline_find_nested_calls(last_stmt, found, owner_fidx);
    }
    if (arr_len(found) == 0) { return 0; }
    ids = arr_new();
    i = 0;
    while (i < arr_len(found)) {
        n = arr_get(found, i);
        fidx = find_func_idx(n.a);
        // Budget-aware admission: a denied nested call keeps its
        // positional slot in `ids` as 0 so splice-time stamping stays
        // aligned — the clone's .e gets 0 and the call emits as a real
        // bl, the exact convention un-stamped calls already follow.
        if (_inline_pressure_admit(fidx) == 0) {
            ids = arr_push(ids, 0);
            i++;
            continue;
        }
        nested_id = _inline_register_callsite_slots(fidx);
        ids = arr_push(ids, nested_id);
        i++;
    }
    while (arr_len(_inline_nested_ids) <= outer_id) {
        _inline_nested_ids = arr_push(_inline_nested_ids, 0);
    }
    arr_set(_inline_nested_ids, outer_id, ids);
    return 0;
}

// AST walker — for every T_CALL anywhere in the caller's AST,
// check whether the target is an inlineable multi-stmt callee.
// If yes, register a callsite slot block via the helpers above.
// Single-statement inlineable callees are left alone — the
// existing Phase B2 trivial splice handles them without any
// per-callsite slot registration.
//
// Recurses through all expression-bearing node types. Switch arms
// not yet covered (callee body would have to contain T_CALL +
// T_SWITCH in a non-rejected combination; the classifier already
// excludes T_CALL anywhere in body so this is moot for now,
// but keeping the function statement-shape complete makes future
// callers reusable).
void _inline_pre_reg_walk(nd) {
    auto n: Node, t, arr, cnt, i, fidx, fn_rec, callee_bcnt;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) {
            _inline_pre_reg_walk(arr[i]);
            i++;
        }
        fidx = find_func_idx(n.a);
        if (fidx >= 0) {
            if (arr_get(fn_inlineable, fidx) == 4) {
                // Inc 8 (S4 wiring): oversized, cost-gated tier — checked
                // BEFORE the generic multi-statement branch below (a
                // tier-4 body is almost always body_cnt > 1, which would
                // otherwise swallow it into the unconditional-splice
                // path and defeat the whole point of gating it). Admit
                // only when this SPECIFIC call site's cost clears its
                // threshold — exp_f (cost 78) clears at a call site
                // proven hot via fn_hot_transitive (threshold -> 90),
                // and stays a real `bl` at any call site that isn't.
                auto _ip2_c, _ip2_t;
                _ip2_c = _inline_cost(fidx, n.b, n.c);
                _ip2_t = _inline_threshold(fidx, cg_cur_fn_idx, n);
                if (_inl_probe) {
                    diag_str("INLPROBE t4-site callee=");
                    diag_buf(vbuf + unpack_s(n.a), unpack_l(n.a));
                    diag_str(_ip2_c <= _ip2_t ? " ADMIT" : " DENY");
                    diag_str(" cost=");
                    diag_int(_ip2_c);
                    diag_str(" thr=");
                    diag_int(_ip2_t);
                    diag_newline();
                }
                if (_ip2_c <= _ip2_t) {
                    _inline_register_callsite(n, fidx);
                }
            } else if (arr_get(fn_inlineable, fidx)) {
                fn_rec = funcs[fidx];
                callee_bcnt = *(fn_rec + FN_BCNT);
                // body_cnt > 1 (multi-stmt) OR fn_inlineable == 2 (a single-
                // return body with a multi-use param) both splice through the
                // binding path, which needs a per-callsite slot block.
                if (callee_bcnt > 1 || arr_get(fn_inlineable, fidx) == 2) {
                    _inline_register_callsite(n, fidx);
                } else if (arr_get(fn_inlineable, fidx) == 3) {
                    // Hot-only tier: splice the body in ONLY when this call site
                    // sits inside a loop. A cold site is left un-registered, so
                    // its T_CALL keeps n.e == 0 and the codegen falls through to
                    // a normal `bl` — no bloat at the hundreds of cold call sites
                    // a widely-used accessor (arr_struct_at) otherwise has.
                    if (cg_inline_loop_depth > 0) { _inline_register_callsite(n, fidx); }
                }
            } else if (arr_get(fn_void_inlineable, fidx)) {
                // VI-2: void / statement-context callee. Register the slot
                // block regardless of body_cnt — even a single-statement void
                // body splices through _a64_emit_inline_multi (which binds args
                // into the mangled slots), not the Phase B2 single-T_RET fast
                // path. This walker runs only from a64_pre_reg_vars, so the
                // x64 / C backends never register these slots.
                _inline_register_callsite(n, fidx);
            }
        }
        return 0;
    }
    switch (t) {
    T_BINOP   { _inline_pre_reg_walk(n.b); _inline_pre_reg_walk(n.c); }
    T_UNARY   { _inline_pre_reg_walk(n.b); }
    T_MEMLD   { _inline_pre_reg_walk(n.a); }
    T_ADDR    { _inline_pre_reg_walk(n.a); }
    T_TERNARY { _inline_pre_reg_walk(n.a); _inline_pre_reg_walk(n.b); _inline_pre_reg_walk(n.c); }
    T_ASSIGN  { _inline_pre_reg_walk(n.a); _inline_pre_reg_walk(n.b); }
    T_MEMST   { _inline_pre_reg_walk(n.a); _inline_pre_reg_walk(n.b); }
    // Inc 6: mirror the n.c > 1 branch already in _inline_has_tcall /
    // _inline_param_refs / _inline_count_nodes / ast_clone_subst (Inc 5) —
    // a multi-return T_RET's results 2..N live in n.b, not n.a (n.a only
    // aliases n.b[0]). Without this, a future candidate with a call hiding
    // in result 2..N of its trailing multi-return would never get that
    // call's callsite registered. Not exploited by moog_taps today (its
    // `return a,b,c,d;` has no calls in it) but the nested-inline
    // flattening this walker is about to be reused for must be correct
    // in general, not just for the one shape in hand.
    T_RET {
        if (n.c > 1) {
            arr = n.b; cnt = n.c;
            i = 0;
            while (i < cnt) { _inline_pre_reg_walk(arr[i]); i++; }
        } else {
            _inline_pre_reg_walk(n.a);
        }
    }
    T_IF      {
        _inline_pre_reg_walk(n.a);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _inline_pre_reg_walk(arr[i]); i++; }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            i = 0;
            while (i < cnt) { _inline_pre_reg_walk(arr[i]); i++; }
        }
    }
    T_WHILE   {
        // Inside a loop: both the condition and the body run per iteration, so
        // any call site here is hot. Bump the depth around the whole construct
        // (for-loops desugar to T_WHILE, so this covers them too).
        cg_inline_loop_depth = cg_inline_loop_depth + 1;
        _inline_pre_reg_walk(n.a);
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _inline_pre_reg_walk(arr[i]); i++; }
        cg_inline_loop_depth = cg_inline_loop_depth - 1;
    }
    T_BLOCK   {
        arr = n.b; cnt = n.c;
        i = 0;
        while (i < cnt) { _inline_pre_reg_walk(arr[i]); i++; }
    }
    else { }
    }
    return 0;
}

// Driver — walks a body array (= function body or block body) of
// statement nodes. Called from each chip's `pre_reg_vars`.
void _inline_pre_reg_walk_body(arr, cnt) {
    auto i;
    // Reset the loop-nesting counter for this function. This driver runs once
    // per function (at pre-reg depth 0), then walks the whole body recursively,
    // so the hotness gate sees a clean depth here.
    cg_inline_loop_depth = 0;
    i = 0;
    while (i < cnt) {
        _inline_pre_reg_walk(arr[i]);
        i++;
    }
}

// Collect packed names of every top-level T_DECL local in a
// callee body into `out_buf`. Writes one packed-name pointer
// per word slot. Returns the count of names written. Used at
// splice time to assemble the rename map.
// Control-flow leaf bodies (2026-06-24) can declare a local INSIDE the
// if/while body, not just at the function's own top level — the
// autovec SIMD-synthesis targets (tests/test_autovec_compose.bpp's
// p1_mul/p1_add/...) declare their per-element `auto c: Cell;` exactly
// this way, inside the for-loop. Without this recursion, such a local
// never gets collected — never gets a mangled `_inl<id>_c` slot — so
// every reference to it inside the cloned loop body falls through
// ast_clone_subst's T_VAR case as an un-renamed, unresolved bare name,
// which the rest of the pipeline then treats as an undeclared extern
// (E264). _inline_count_nodes already disqualifies any body containing
// an early RETURN inside a loop (the corrupted-control-flow class of
// bug); a plain local DECLARATION inside a loop has no such hazard —
// ast_clone_subst's own T_DECL case is already a content-preserving
// no-op clone (`.a` copied by the blanket field copy), so the only
// thing missing was collection, not cloning.
static _inline_collect_locals_walk(body_arr, body_cnt, out_buf, count) {
    auto i, j;
    auto n: Node;
    i = 0;
    while (i < body_cnt) {
        n = body_arr[i];
        if (n != 0) {
            if (n.ntype == T_DECL) {
                j = 0;
                while (j < n.b) {
                    *(out_buf + count * 8) = *(n.a + j * 8);
                    count++;
                    j++;
                }
            } else if (n.ntype == T_IF) {
                count = _inline_collect_locals_walk(n.b, n.c, out_buf, count);
                if (n.e > 0) {
                    count = _inline_collect_locals_walk(n.d, n.e, out_buf, count);
                }
            } else if (n.ntype == T_WHILE) {
                count = _inline_collect_locals_walk(n.b, n.c, out_buf, count);
            } else if (n.ntype == T_BLOCK) {
                count = _inline_collect_locals_walk(n.b, n.c, out_buf, count);
            }
        }
        i++;
    }
    return count;
}

_inline_collect_locals(body_arr, body_cnt, out_buf) {
    return _inline_collect_locals_walk(body_arr, body_cnt, out_buf, 0);
}

// Body-node hard cap (Q4 of S4 sidequest doc). Independent from
// the cost threshold (which is cost-with-bonuses, computed
// per-callsite in `_inline_threshold`). This is the absolute
// ceiling on raw `node_count(body)` — no call site, no caller
// hotness, no const-arg bonus can push a body past it. LLVM
// uses 50 for `OptSizeThreshold`; xorshift64 (the original S4
// anchor) is ~31 nodes. Stays untouched for the single-return case —
// every existing candidate was vetted against this exact number.
const INLINE_BODY_NODE_CAP = 50;
// Separate, deliberately scoped cap for MULTI-RETURN bodies only (Inc 6,
// docs/plans/inliner_arc.md). `moog_taps` (stb/stbfilter.bsm — 4 ladder
// taps computed and returned together, the multi-return ABI doing
// exactly what it's for) measures body_cost=62 after the const-offset-
// addressing counting fix above (was 84 before it) — still over the
// shared 50-node cap. A SCOPED cap, not a global raise: a multi-return
// body inherently does ~N parallel computations in one call (that's the
// whole point of returning N values instead of making N separate calls),
// so it structurally deserves more room than a single-return leaf —
// raising the SHARED cap instead would have widened every single-return
// candidate's blast radius for a problem only multi-return bodies have.
// 70 keeps a small, deliberate margin over the one real, measured
// candidate (62) rather than a round guess at "big enough" — there is
// exactly one consumer driving this number today; revisit it, with its
// own measurement, when a second one needs more room.
const INLINE_MULTIRET_NODE_CAP = 70;
// Tighter cap for bodies that inline a peek/poke builtin: a thin single-
// instruction wrapper (read_u16 ≈ 5 nodes) is size-neutral to inline, but a
// bigger builtin-using body bloats at EVERY call site (measured +13% binary in
// the first attempt — see docs/plans/inliner_arc.md). ~10 admits the thin u8/16/
// 32/64 + float load/store wrappers and rejects multi-peek bodies (read_u16be …).
const INLINE_BUILTIN_NODE_CAP = 10;
// Lever-1 (2026-07-04, docs/plans/inliner_arc.md): a builtin-using body
// OVER the thin-wrapper cap is no longer rejected outright — up to this
// bound it is admitted as TIER 4 (Inc 8's oversized, per-callsite
// cost-gated class). The +13% binary-bloat episode that created the
// thin cap came from UNCONDITIONAL splicing at every call site; tier 4
// only splices where the cost model plus transitive hotness say the
// site is worth it (a cold site keeps its call). 40 admits the DSP
// delay-line leaves (delay_peek 13, delay_push 32) whose calls dominate
// spring_process/allpass chains, plus memcpy-class helpers, while
// keeping genuinely fat bodies (_hash_insert_raw at 58) out.
const INLINE_BUILTIN_TIER4_CAP = 40;
// Inc 8 (S4 wiring) — the ABSOLUTE backstop for tier 4 (oversized,
// cost-gated) candidates. Past the free cap, admission is decided
// per-callsite by cost-vs-threshold (_inline_threshold tops out around
// 90-135 in realistic stacked-multiplier cases, 270 in the all-three
// theoretical max) — this backstop exists purely to avoid wasting a
// cost computation, and an actual splice, on a body no realistic
// threshold would ever clear anyway. 3x the free cap is a round, generous
// multiple, not a measured number — there is no candidate yet that needs
// the exact value tuned; revisit with one if it ever gates something
// real out.
const INLINE_BODY_NODE_CAP_HARD = 150;
const INLINE_MULTIRET_NODE_CAP_HARD = 210;

// Inc 3b — normalise a guard-clause body to a single-return ternary, IN PLACE.
// A body of EXACTLY the shape
//     if (C) { return A; }
//     return B;
// is rewritten to the single statement
//     return C ? A : B;
// which is semantically exact — a ternary evaluates only the taken branch, just
// like the guard's early return — and lets the existing single-return binding
// splice (Inc 2) emit it with NO new early-return machinery. The body array is
// reused: slot 0 becomes the new T_RET and FN_BCNT drops to 1.
//
// The shape is kept deliberately narrow (Rule 28): the first statement must be a
// T_IF whose body is a single T_RET and which has no `else`, and the second
// statement a T_RET. Both returns must carry a real expression (a bare `return;`
// has a == 0 and is rejected). The new wrapper nodes need no `itype` — the
// ternary emit derives its result type from the (already type-annotated) branch
// expressions, never from the wrapper (see bpp_codegen.bsm T_TERNARY emit).
//
// Returns 1 if it rewrote the body, 0 otherwise. Idempotent in practice:
// classify_inlineable runs once per compilation (the two call sites in bpp.bpp
// are the mutually-exclusive modular / monolithic arms), so a rewritten body is
// never re-examined.
static _inline_normalize_guard(fn_rec) {
    auto body_arr, body_cnt, if_body;
    auto (s0, s1, if_ret, tern, new_ret): Node;
    auto cond, then_expr, else_expr;
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    if (body_cnt != 2) { return 0; }
    s0 = body_arr[0];
    if (s0.ntype != T_IF) { return 0; }
    if (s0.e != 0)        { return 0; }   // has an else — out of scope
    if (s0.c != 1)        { return 0; }   // if-body is not exactly one statement
    if_body = s0.b;
    if_ret = if_body[0];
    if (if_ret.ntype != T_RET) { return 0; }
    s1 = body_arr[1];
    if (s1.ntype != T_RET) { return 0; }
    // Multi-value returns are out of scope: a T_RET's `.a` only carries
    // result 1 (results 2..N live in `.b` — the same T_RET-multi blind
    // spot Inc 5/6 fixed elsewhere). Rewriting one into a single-value
    // ternary silently DROPS the other results and classifies the
    // function as a single-return inline candidate; a multi-assign call
    // site then dereferences the rewritten return's null result array
    // (found by tests/test_inline_early_ret.bpp's ordered_pair — the
    // compiler segfaulted in cg_emit_inline_multi_assign).
    if (if_ret.c > 1) { return 0; }
    if (s1.c > 1)     { return 0; }
    cond      = s0.a;
    then_expr = if_ret.a;
    else_expr = s1.a;
    if (cond == 0 || then_expr == 0 || else_expr == 0) { return 0; }
    tern = make_node(T_TERNARY);
    tern.a = cond;
    tern.b = then_expr;
    tern.c = else_expr;
    new_ret = make_node(T_RET);
    new_ret.a = tern;
    body_arr[0] = new_ret;
    *(fn_rec + FN_BCNT) = 1;
    return 1;
}

// Normalise a trailing switch-with-every-arm-returning into a single-
// return nested-ternary chain, IN PLACE — the switch's twin of
// `_inline_normalize_guard` above. Found re-disassembling
// stb/stbfilter.bsm's moog_slope (a single call site, never itself
// inlining):
//     moog_slope(m, in: float, poles) -> float {
//         auto (a,b,c,d): float;
//         a,b,c,d = moog_taps(m, in);
//         switch (poles) {
//             1 { return a; } 2 { return b; } 3 { return c; }
//             else { return d; }
//         }
//     }
// rewrites to a trailing
//     return (poles == 1) ? a : ((poles == 2) ? b : ((poles == 3) ? c : d));
// — semantically exact (a switch tries arms in declaration order, first
// match wins, no fallthrough; the nested ternary tries comparisons in
// the same order) — letting the existing single-return binding splice
// (Inc 2) emit it with no new control-flow-aware splice machinery, the
// same payoff `_inline_normalize_guard` already banked for guard
// clauses.
//
// Kept deliberately narrow (Rule 28), same spirit as the guard
// normaliser:
//   - the switch must be the body's LAST statement (any number of
//     statements may precede it unchanged — moog_slope's own
//     `a,b,c,d = moog_taps(...)` is exactly such a leading statement)
//   - value-dispatch form only (`switch (cond) { ... }`, cond != 0) —
//     the no-expression condition-dispatch form is out of scope
//   - the condition must be a bare T_VAR or T_LIT: the rewrite reads it
//     ONCE PER ARM (as the left side of each `==` comparison), so it
//     must be PROVABLY side-effect-free and repeatable without
//     introducing a synthesized temp — a T_VAR/T_LIT already is (the
//     same idempotency bar this session's earlier inline-substitution
//     work established), anything more complex is rejected rather than
//     risk duplicating a side effect
//   - every arm must have exactly one value (no `1, 2 { ... }` combined
//     arms) and a body of exactly one T_RET with a real expression
//   - an else arm is mandatory (exhaustiveness — there is no safe
//     "value" to fall back to without one) with the same one-T_RET shape
//
// Each arm's VALUE expression is read exactly once (no duplication
// concern there — it occupies exactly one position in the resulting
// tree, same as it occupied exactly one arm in the original switch).
//
// Returns 1 if it rewrote the body, 0 otherwise.
static _inline_normalize_switch_ret(fn_rec) {
    auto body_arr, body_cnt;
    auto last: Node, cond: Node;
    auto arm_values, arm_bodies, arm_count, k, vcnt, bcnt;
    auto arm_body, arm_ret: Node, else_arr, else_stmt: Node;
    auto cmp: Node, tern: Node, new_ret: Node, value, eq_start, eq_op;
    auto arm_vals;
    body_arr = *(fn_rec + FN_BODY);
    body_cnt = *(fn_rec + FN_BCNT);
    if (body_cnt < 1) { return 0; }
    last = body_arr[body_cnt - 1];
    if (last.ntype != T_SWITCH) { return 0; }
    cond = last.a;
    if (cond == 0) { return 0; }                     // condition-dispatch form
    if (cond.ntype != T_VAR && cond.ntype != T_LIT) { return 0; }
    if (last.d == 0 || last.e != 1) { return 0; }     // mandatory, single-stmt else
    else_arr = last.d;
    else_stmt = else_arr[0];
    if (else_stmt.ntype != T_RET || else_stmt.a == 0) { return 0; }
    // Same multi-return guard as _inline_normalize_guard: `.a` only
    // carries result 1, so a multi-value arm cannot be folded into a
    // single-value ternary.
    if (else_stmt.c > 1) { return 0; }
    arm_count = last.c;
    if (arm_count < 1) { return 0; }
    arm_values = last.b;
    arm_bodies = last.src_tok;
    // Validate every arm BEFORE mutating anything — all-or-nothing,
    // same discipline _inline_normalize_guard's own checks use.
    for (k = 0; k < arm_count; k++) {
        vcnt = arm_values[k * 2 + 1];
        if (vcnt != 1) { return 0; }                  // combined-value arm
        bcnt = arm_bodies[k * 2 + 1];
        if (bcnt != 1) { return 0; }
        arm_body = arm_bodies[k * 2];
        arm_ret = arm_body[0];
        if (arm_ret.ntype != T_RET || arm_ret.a == 0) { return 0; }
        if (arm_ret.c > 1) { return 0; }              // multi-return arm (see above)
    }
    // Build the chain right-to-left: the innermost value is the else
    // branch; each arm wraps the accumulated value in
    // `(cond == arm_value) ? arm_return : <accumulated>`.
    value = else_stmt.a;
    eq_start = vbuf_pos;
    poke(vbuf + vbuf_pos, '='); vbuf_pos++;
    poke(vbuf + vbuf_pos, '='); vbuf_pos++;
    eq_op = pack(eq_start, 2);
    for (k = arm_count - 1; k >= 0; k--) {
        arm_body = arm_bodies[k * 2];
        arm_ret = arm_body[0];
        arm_vals = arm_values[k * 2];
        cmp = make_node(T_BINOP);
        cmp.a = eq_op;
        cmp.b = cond;
        cmp.c = arm_vals[0];
        tern = make_node(T_TERNARY);
        tern.a = cmp;
        tern.b = arm_ret.a;
        tern.c = value;
        value = tern;
    }
    new_ret = make_node(T_RET);
    new_ret.a = value;
    body_arr[body_cnt - 1] = new_ret;
    return 1;
}

// Walk the function table and tag every entry that meets the
// inline criteria. Must run after classify_all_functions so
// fn_phase is final. Codegens read fn_inlineable when emitting
// T_CALL.
//
// S4 P3a unification — single classifier covers both the
// Phase B2 single-T_RET trivial case AND the multi-statement
// case targeted by S4. The two used to be conceptually
// separate (v1 = expression body, v2 = multi-stmt) but
// keeping parallel flags violates Tonify Rule 4 — one
// concept, one flag. The codegen splice point carries a
// `body_cnt == 1` guard until P3b lands the multi-stmt
// emitter; the classifier marks multi-stmt candidates today
// and the guard makes them transparently fall through to a
// normal call. P3b removes the guard.
//
// Eligibility (all must hold):
//   1. fn_phase in {PHASE_BASE, PHASE_AUTO}
//        - BASE = pure. AUTO = lattice no-op (writes globals
//          but doesn't transitively reach malloc/IO/GPU). Per
//          Q4, opens "tame impurity" candidates like xorshift64.
//   2. body_arr != 0, body_cnt >= 1
//   3. Last statement is a T_RET (we need a value to use as
//      the call's expression value at the splice point).
//   4. param_cnt ≤ 3
//   5. No floats (return or any param)
//   6. node_count_body(body) ≤ INLINE_BODY_NODE_CAP (Q4 hard cap)
//   7. No T_CALL anywhere in body (avoids transitive blow-up;
//      Phase B2's existing restriction kept verbatim)
//   8. For body_cnt == 1 only: each param referenced at most
//      once (Phase B2's substitute-without-bind invariant; the
//      multi-statement splice in P3b will alpha-rename args
//      into temps and relax this).
// BPP_INLINE_PROBE=1: report each function's inline classification
// (cost / arity / tier) and every tier-4 per-callsite admit/deny with
// the exact cost-vs-threshold numbers — the measurement tool for cap
// and threshold questions (the M3 probe's inliner twin).
global _inl_probe;

void classify_inlineable() {
    auto i, fn_rec, body_arr, body_cnt, params, pcnt;
    auto last_stmt: Node, ret_stmt: Node, ret_expr, j, ok, refs;
    auto phase, body_cost, want_void, want_bind, was_guard, has_float_param;
    auto ret_arity, is_oversized;
    auto fp_changed, fp_iter, fp_sum_before, fp_sum_after, fp_si;
    _inl_probe = 0;
    if (getenv("BPP_INLINE_PROBE") != 0) { _inl_probe = 1; }
    while (arr_len(fn_inlineable) < func_cnt) {
        fn_inlineable = arr_push(fn_inlineable, 0);
    }
    // VI-1 (inert): grow the parallel void-candidate flag alongside
    // fn_inlineable. Populated below, read by nothing yet — VI-2 wires the
    // walker + a64 splice to it. See docs/plans/legacy/sidequest_void_inline.md.
    while (arr_len(fn_void_inlineable) < func_cnt) {
        fn_void_inlineable = arr_push(fn_void_inlineable, 0);
    }
    // Inc 6: a candidate's nested-call gate (just above, in the loop body)
    // reads OTHER functions' fn_inlineable — which, for a callee declared
    // AFTER its caller in source order, isn't known yet on a single pass.
    // Re-run the whole classification to a fixpoint: eligibility only ever
    // grows (a function's OWN shape never changes between passes, and the
    // gate only gets MORE permissive as more callees resolve), so comparing
    // a simple sum across passes is a rigorous "nothing changed" test, not
    // just a heuristic — if any index's value increased, the sum strictly
    // increased too, since no index ever decreases. Capped at 8 passes
    // (generous for any realistic call-depth chain; cheap even if hit
    // every time — classify_inlineable runs once per compilation).
    fp_sum_before = -1;
    fp_iter = 0;
    fp_changed = 1;
    while (fp_changed && fp_iter < 8) {
    for (i = 0; i < func_cnt; i++) {
        arr_set(fn_inlineable, i, 0);
        arr_set(fn_void_inlineable, i, 0);
        phase = arr_get(fn_phase, i);
        // Phase whitelist: BASE / AUTO / SOLO. SOLO is "has direct
        // or transitive side effects, must run on main thread".
        // xorshift64 in `examples/tablah.bpp` is classified SOLO
        // because it writes the `rng_states` global; allowing SOLO
        // here means S4 can inline that style of "tame impurity"
        // worker helper. If a SOLO function is genuinely main-
        // thread-only (Cocoa, GL context, etc.), it would not be
        // called from a worker context to begin with — inlining
        // it into a context that already calls it is semantically
        // identical to the un-inlined call. Reject IO / GPU /
        // HEAP / REALTIME / PANIC / SAFE — those carry stronger
        // contracts (allocator, syscall, real-time deadline,
        // safety verification) that inlining could weaken.
        if (phase != PHASE_BASE && phase != PHASE_AUTO && phase != PHASE_SOLO) { continue; }
        // Multi-value-return functions (Inc 5, docs/plans/inliner_arc.md):
        // the old blanket reject here is gone. A multi-return candidate is
        // allowed through ONLY when its trailing statement is a multi-return
        // T_RET whose arity matches the signature exactly — checked below
        // once last_stmt is available, right where the existing single-
        // return "must end in T_RET" rule already lives. Read fn_ret_arity
        // directly — set at parse time, always present.
        ret_arity = arr_get(fn_ret_arity, i);
        fn_rec = funcs[i];
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);
        if (body_arr == 0) { continue; }
        if (body_cnt < 1) { continue; }
        // Inc 3b: normalise a guard-clause body to a single-return ternary in
        // place, so the checks below (and the binding splice) see a clean
        // single-return body. A normalised body is tagged tier 3 (hot-only) at
        // the end so a widely-used accessor (arr_struct_at) inlines only inside
        // loops. Re-read body_cnt — the rewrite shrinks it from 2 to 1. (A
        // multi-return body never matches this pattern — the normaliser looks
        // for a 2-statement if/return/return shape — so it's a safe no-op here.)
        was_guard = _inline_normalize_guard(fn_rec);
        // Switch-with-every-arm-returning -> nested ternary (this
        // increment's own normaliser, see its docstring above). Runs
        // independently of the guard normaliser — different trailing
        // shape, and (unlike a guard clause) does NOT force tier 3:
        // a switch-normalised body isn't presumed to be a widely-used
        // accessor the way arr_struct_at is, so the hotness gate would
        // wrongly leave a single-cold-call-site candidate like
        // moog_slope un-registered. It falls through the generic tier
        // decision below exactly like any other body would.
        _inline_normalize_switch_ret(fn_rec);
        body_cnt = *(fn_rec + FN_BCNT);
        // Last statement must be T_RET so the splice has an
        // expression value to use.
        last_stmt = body_arr[body_cnt - 1];
        if (last_stmt == 0) { continue; }
        // Criterion 3. The value path needs a trailing T_RET to use as the
        // call's expression value. A void function that falls off the end
        // (no return at all) is the VI void-inline candidate instead — its
        // body splices as plain statements with no value. Any other function
        // that does not end in T_RET is rejected exactly as before.
        want_void = 0;
        if (ret_arity > 1) {
            // Inc 5: a multi-return candidate must end in a matching
            // multi-return T_RET. Anything else (early return, control flow
            // around the return, arity mismatch) is rejected for this
            // increment — narrowly scoped to the one trailing-multi-return
            // shape the splice (Part C below) actually knows how to handle.
            if (last_stmt.ntype != T_RET) { continue; }
            if (last_stmt.c != ret_arity) { continue; }
        } else if (last_stmt.ntype != T_RET) {
            if (arr_get(fn_void, i) == 0) { continue; }
            want_void = 1;
        }
        pcnt = *(fn_rec + FN_PCNT);
        if (pcnt > 3) { continue; }
        // Float types are allowed (matched-type leaves, Inc 4-revised). Float
        // RETURN is safe on either path — the expression-level codegen and the
        // caller's consuming context apply any conversion, exactly as for a real
        // call. A float PARAM, though, must go through the BINDING path: the fast
        // substitute path drops the arg expression in with NO int/float
        // conversion, so a float param is forced to tier >= 2 (has_float_param
        // below). There cg_emit_inline_multi binds it to a float-typed slot
        // (_inline_register_callsite types the slot) and the slot assignment does
        // the conversion — matching what a real call would emit.
        has_float_param = 0;
        for (j = 0; j < pcnt; j++) {
            if (is_float_type(get_fn_par_type(i, j))) { has_float_param = 1; }
        }
        // Body node count (Q4 hard cap). Until 2026-06-24 this also
        // blanket-rejected any body containing T_IF/T_WHILE/nested
        // T_BLOCK ("control-flow inlining is out of scope per Q1") —
        // _inline_count_nodes now recurses into both (ast_clone_subst
        // and cg_emit_stmt already handled them correctly; only the
        // counter was refusing to look), so a loop- or guard-clause-
        // shaped LEAF (no disqualifying calls, single trailing return —
        // exp_f/log_f, bpp_math.bsm) can pass this gate on real cost,
        // same as any other shape. T_SWITCH is still out of scope
        // (_inline_count_nodes's catch-all) until a real candidate needs
        // it — _inline_normalize_switch_ret already rewrites the one
        // switch shape that DOES need to inline today away before this
        // counter ever sees a T_SWITCH node.
        body_cost = _inline_count_nodes_body(body_arr, body_cnt);
        // Inc 6: multi-return bodies get the separate, scoped cap (see
        // its own comment) — single-return bodies are unaffected, exact
        // same threshold as before this increment.
        //
        // Inc 8 (S4 wiring): a body over the free cap is no longer an
        // automatic reject. It becomes tier 4 — "oversized, cost-gated"
        // — ADMITTED ONLY if Inc 8's per-callsite cost-vs-threshold check
        // (_inline_pre_reg_walk) clears it at that SPECIFIC call site;
        // every cold call site still falls through to a real `bl`, same
        // as an ungated tier-3 cold site already does. Tiers 1-3 below
        // are completely unchanged — this only ever ADDS candidates that
        // were previously rejected outright, never changes behavior for
        // anything that already qualified under the free cap. A second,
        // larger backstop (3x the free cap) still hard-rejects anything
        // no realistic threshold would ever admit — avoids wasting a
        // cost computation, and avoids splicing something absurd at the
        // rare callsite with every multiplier stacked.
        // 99 is _inline_count_nodes's SENTINEL ("genuinely disqualified" —
        // T_SWITCH, an early return inside control flow, any other
        // unsupported shape), not a real cost measurement. It happens to
        // be bigger than the OLD caps (50/70) so the old plain `> CAP`
        // check rejected it for free; Inc 8's HARD backstop (150/210) is
        // bigger than 99, so the same check would silently let a sentinel
        // through as "merely oversized" without this explicit guard —
        // caught the hard way: a T_SWITCH body got promoted to tier 4 and
        // crashed `_a64_emit_switch_jtbl` (jump-table emission has never
        // had splice support; switch normalisation is a SEPARATE rewrite
        // earlier in this same function, not a splice-time capability).
        is_oversized = 0;
        if (_inl_probe) {
            diag_str("INLPROBE fn=");
            diag_buf(vbuf + unpack_s(*(fn_rec + FN_NAME)), unpack_l(*(fn_rec + FN_NAME)));
            diag_str(" cost=");
            diag_int(body_cost);
            diag_str(" arity=");
            diag_int(ret_arity);
            diag_newline();
        }
        if (body_cost >= INLINE_DISQ) { continue; }
        if (ret_arity > 1) {
            if (body_cost > INLINE_MULTIRET_NODE_CAP_HARD) { continue; }
            if (body_cost > INLINE_MULTIRET_NODE_CAP) { is_oversized = 1; }
        } else {
            if (body_cost > INLINE_BODY_NODE_CAP_HARD) { continue; }
            if (body_cost > INLINE_BODY_NODE_CAP) { is_oversized = 1; }
        }
        // Inc 6: a T_CALL to a target that is ALREADY fn_inlineable does
        // not disqualify this body (it composes — see
        // _inline_has_disqualifying_tcall's own comment). Everything
        // else about this gate is unchanged: any call to a target that
        // isn't (yet, this pass) inlinable still disqualifies. The
        // surrounding fixpoint (below) is what lets "yet" eventually
        // become "yes" for a callee declared after its caller.
        ok = 1;
        for (j = 0; j < body_cnt; j++) {
            if (_inline_has_disqualifying_tcall(body_arr[j])) { ok = 0; break; }
        }
        if (ok == 0) { continue; }
        // Thin-wrapper size gate: a body that inlines a peek/poke builtin is
        // size-neutral ONLY when it is a thin single-instruction wrapper.
        // Bigger builtin-using bodies bloat when inlined at every call site, so
        // cap them tighter than pure-arithmetic leaves (see INLINE_BUILTIN_NODE_CAP).
        ok = 0;
        for (j = 0; j < body_cnt; j++) {
            if (_inline_has_inst_builtin(body_arr[j])) { ok = 1; break; }
        }
        if (ok && body_cost > INLINE_BUILTIN_NODE_CAP) {
            // Lever-1: admission window instead of a hard reject — see
            // INLINE_BUILTIN_TIER4_CAP's comment for the whole story.
            if (body_cost > INLINE_BUILTIN_TIER4_CAP) { continue; }
            is_oversized = 1;
        }
        if (want_void) {
            // Void candidate: reject if ANY statement is a T_RET. A mid- or
            // early-return would splice into a jump to the CALLER's epilogue.
            // The body is already straight-line (criterion 6 rejects control
            // flow), so this top-level scan catches a trailing / dead return.
            ok = 1;
            for (j = 0; j < body_cnt; j++) {
                ret_stmt = body_arr[j];
                if (ret_stmt.ntype == T_RET) { ok = 0; break; }
            }
            if (ok == 0) { continue; }
            // VI-1: mark the inert flag and skip the value-path tail. Nothing
            // reads fn_void_inlineable yet, so this changes no emitted code —
            // the a64 splice + pre-reg walker get wired to it in VI-2.
            arr_set(fn_void_inlineable, i, 1);
            continue;
        }
        // Param-ref ≤ 1 invariant — only enforced for the
        // single-statement case. Phase B2's substitute-and-emit
        // path drops the arg expression into the body wherever
        // the param appears, so a side-effecting arg used twice
        // would double-evaluate. The S4 P3b-3 multi-statement
        // splice instead binds each arg to a mangled
        // `_inl<N>_<param>` slot once at the splice prologue,
        // then the cloned body references that slot — every
        // subsequent param touch is a pure local load with
        // no re-evaluation, regardless of count.
        // A param referenced more than once cannot use the fast substitute
        // path (it would re-evaluate a side-effecting arg). Mark such single-
        // return bodies with `2` so the codegen routes them through the multi-
        // statement binding splice (cg_emit_inline_multi binds each arg to a
        // temp once) — instead of rejecting them as criterion 8 used to.
        want_bind = 0;
        if (body_cnt == 1) {
            params = *(fn_rec + FN_PARS);
            ret_stmt = body_arr[0];
            ret_expr = ret_stmt.a;
            if (ret_expr == 0) { continue; }
            for (j = 0; j < pcnt; j++) {
                refs = _inline_param_refs(ret_expr, *(params + j * 8));
                if (refs > 1) { want_bind = 1; }
            }
        }
        // Tier 3 (hot-only) for a guard-clause-normalised body: it is bigger than
        // a thin wrapper and typically a widely-used accessor (arr_struct_at), so
        // the pre-reg walk registers — and the codegen inlines — only its in-loop
        // call sites. Otherwise tier 2 (multi-use param) / tier 1 (thin), both
        // inlined at every call site.
        // Inc 8: tier 4 takes priority over every other tier — an
        // oversized body's admission is decided per-callsite by
        // _inline_pre_reg_walk's cost-vs-threshold check (below this
        // function), not by the splice-mechanism concerns (was_guard /
        // want_bind / has_float_param / multi-return) the other tiers
        // exist to route correctly. Those concerns still matter for HOW
        // tier 4 splices once admitted — _inline_pre_reg_walk's tier-4
        // branch always uses the binding splice (cg_emit_inline_multi),
        // which already handles float params / multi-statement bodies
        // / multi-return correctly regardless of tier number.
        if (is_oversized) {
            arr_set(fn_inlineable, i, 4);
        } else if (was_guard) {
            arr_set(fn_inlineable, i, 3);
        } else if (want_bind || has_float_param || ret_arity > 1) {
            // has_float_param forces tier 2 so a float param never takes the
            // fast substitute path (which can't convert the arg) — see the
            // float-gate note above. ret_arity > 1 forces tier 2 for the same
            // reason: the fast substitute path's splice point is structurally
            // single-value (it reads one result, not a result list) — a
            // multi-return body must always go through the binding splice
            // (cg_emit_inline_multi_assign, Part C of Inc 5), even when it
            // would otherwise qualify for tier 1 on every other criterion
            // (e.g. an all-int multi-return leaf with single-use params).
            arr_set(fn_inlineable, i, 2);
        } else {
            arr_set(fn_inlineable, i, 1);
        }
    }
    fp_sum_after = 0;
    for (fp_si = 0; fp_si < func_cnt; fp_si++) {
        fp_sum_after += arr_get(fn_inlineable, fp_si) + arr_get(fn_void_inlineable, fp_si);
    }
    fp_changed = (fp_sum_after != fp_sum_before);
    fp_sum_before = fp_sum_after;
    fp_iter++;
    }
}

// Clone an expression subtree, replacing every T_VAR whose packed name
// matches a parameter with the corresponding argument node. Argument
// nodes are SHARED, not copied — criterion 6 of classify_inlineable
// guarantees no parameter is referenced twice, so each shared arg lands
// in the cloned tree exactly once. Public because both codegens call
// it directly from their T_CALL branches.
ast_clone_subst(nd, params, pcnt, args) {
    auto orig: Node, cl: Node, t, i, arr, cnt, new_arr;
    if (nd == 0) { return 0; }
    orig = nd;
    t = orig.ntype;
    if (t == T_VAR) {
        for (i = 0; i < pcnt; i++) {
            if (packed_eq(orig.a, *(params + i * 8))) { return *(args + i * 8); }
        }
        cl = make_node(T_VAR);
        cl.a = orig.a;
        cl.itype = orig.itype;
        cl.dispatch = orig.dispatch;
        return cl;
    }
    cl = make_node(t);
    cl.a = orig.a; cl.b = orig.b; cl.c = orig.c;
    cl.d = orig.d; cl.e = orig.e;
    cl.itype = orig.itype;
    cl.dispatch = orig.dispatch;
    switch (t) {
    T_BINOP {
        cl.b = ast_clone_subst(orig.b, params, pcnt, args);
        cl.c = ast_clone_subst(orig.c, params, pcnt, args);
    }
    T_UNARY    { cl.b = ast_clone_subst(orig.b, params, pcnt, args); }
    T_MEMLD    { cl.a = ast_clone_subst(orig.a, params, pcnt, args); }
    T_ADDR     { cl.a = ast_clone_subst(orig.a, params, pcnt, args); }
    T_TERNARY {
        cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        cl.b = ast_clone_subst(orig.b, params, pcnt, args);
        cl.c = ast_clone_subst(orig.c, params, pcnt, args);
    }
    // Inc 6: reset `.e` (the callsite id) to 0 rather than inheriting the
    // blanket copy above. `.e` is only ever meaningful WITHIN the specific
    // function compilation that assigned it — before Inc 6's gate
    // relaxation, an inlinable body was GUARANTEED to contain zero T_CALL
    // nodes at all (the old unconditional has-T_CALL reject), so
    // ast_clone_subst never actually cloned a T_CALL node and this case
    // was inert. Now that a tier-1/2 candidate's body CAN contain a call
    // to another inlinable function (e.g. mixer_get_rotary's single
    // statement IS a call to rotary_get_mode, itself a registered,
    // multi-statement callee), that inner call's `orig.e` may already
    // hold an id from whatever context it was LAST pre-reg'd in — stale
    // and meaningless if this clone is headed somewhere else entirely
    // (mixer_get_rotary itself becoming an inline candidate elsewhere,
    // not just a normal call). Re-stamping (`_inline_register_nested` +
    // the consumption walk in `_cg_inline_splice_prelude`) is the only
    // thing that should ever set it again — if nothing re-stamps it,
    // falling through to a real `bl` is correct, if not yet optimal;
    // carrying over a stale id risks reading slots from the wrong frame.
    T_CALL {
        arr = orig.b; cnt = orig.c;
        new_arr = buf_word(cnt);
        for (i = 0; i < cnt; i++) {
            new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
        }
        cl.b = new_arr;
        cl.e = 0;
    }
    // S4 P3a — statement-typed nodes. Walked symmetrically to the
    // expression cases so a multi-statement body clones with full
    // param substitution. T_DECL stands alone (just the declared
    // name in .a) — no recursion needed. Field layouts mirror
    // cg_b3_walk (bpp_codegen.bsm:1113-1117).
    T_ASSIGN {
        cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        cl.b = ast_clone_subst(orig.b, params, pcnt, args);
        // Multi-value assignment `a, b, c, d = f()` — n.c is the array of
        // target T_VAR nodes, n.d the count (bpp_codegen.bsm's T_ASSIGN
        // n.d > 1 handler). Same bug class as the T_RET fix above, never
        // applied here: the blanket `cl.c = orig.c` copy at the top of
        // this function leaves the targets array SHARED, unrenamed — a
        // target that is itself a local of the function now being
        // spliced (e.g. moog_tick's `a,b,c,d = moog_taps(m,in);`, with
        // moog_tick itself getting inlined one level further out) keeps
        // its ORIGINAL name, so cg_var_idx can't find it in the outer
        // frame and the unpack silently falls back to integer semantics
        // (fcvtzs truncating the float result). Confirmed live: this
        // exact shape made examples/moog_demo.bpp render dead silence
        // (peak 0/32767) and the moog_tick test in this session's plan
        // file reproduced it as `chain4` returning 0.0 instead of 6.3125.
        if (orig.d > 1) {
            arr = orig.c; cnt = orig.d;
            new_arr = buf_word(cnt);
            for (i = 0; i < cnt; i++) {
                new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
            }
            cl.c = new_arr;
        }
    }
    T_MEMST {
        cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        cl.b = ast_clone_subst(orig.b, params, pcnt, args);
    }
    // Inc 5: the blanket `cl.b = orig.b` copy above leaves a multi-return
    // T_RET's expression array SHARED, UNSUBSTITUTED, with the original —
    // alpha-renaming/arg-substitution would silently not happen for
    // results 2..N (and result 1, since n.a aliases the ORIGINAL n.b[0],
    // not the freshly-cloned one) while looking like it worked. Clone
    // each element fresh, same shape as the T_CALL args-array clone above.
    T_RET {
        if (orig.c > 1) {
            arr = orig.b; cnt = orig.c;
            new_arr = buf_word(cnt);
            for (i = 0; i < cnt; i++) {
                new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
            }
            cl.b = new_arr;
            cl.a = new_arr[0];   // keep the parser's n.a/n.b[0] aliasing invariant
        } else {
            cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        }
    }
    T_DECL  { }   // standalone, .a already copied above
    // Outlining P6 — control-flow types whose bodies are arrays of
    // statement nodes. Without these branches, the cloned T_IF /
    // T_WHILE / T_BLOCK would SHARE the body array with the
    // original, leaving any T_VAR(captured_name) inside the body
    // un-substituted. The smart-dispatch scanner accepts loops with
    // top-level T_IF (e.g. `for (i = 0; i < n; i++) { if (cond) {
    // touch(i); } }`), and the outlining rewrite must follow the
    // free-var substitution all the way into nested control flow.
    T_IF {
        cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        arr = orig.b; cnt = orig.c;
        new_arr = buf_word(cnt);
        for (i = 0; i < cnt; i++) {
            new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
        }
        cl.b = new_arr;
        if (orig.e > 0) {
            arr = orig.d; cnt = orig.e;
            new_arr = buf_word(cnt);
            for (i = 0; i < cnt; i++) {
                new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
            }
            cl.d = new_arr;
        }
    }
    T_WHILE {
        cl.a = ast_clone_subst(orig.a, params, pcnt, args);
        arr = orig.b; cnt = orig.c;
        new_arr = buf_word(cnt);
        for (i = 0; i < cnt; i++) {
            new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
        }
        cl.b = new_arr;
        if (orig.e != 0) {
            cl.e = ast_clone_subst(orig.e, params, pcnt, args);
        }
    }
    T_BLOCK {
        arr = orig.b; cnt = orig.c;
        new_arr = buf_word(cnt);
        for (i = 0; i < cnt; i++) {
            new_arr[i] = ast_clone_subst(arr[i], params, pcnt, args);
        }
        cl.b = new_arr;
    }
    else { }
    }
    return cl;
}

// ── Orchestrator ───────────────────────────────────────────

// Run dispatch analysis on all parsed functions.
run_dispatch() {
    auto i, fn_rec, params_arr, param_cnt, body_arr, body_cnt, j;
    auto stmt: Node, darr, dcnt, k;

    for (i = 0; i < func_cnt; i++) {
        fn_rec = funcs[i];
        params_arr = *(fn_rec + FN_PARS);
        param_cnt = *(fn_rec + FN_PCNT);
        body_arr = *(fn_rec + FN_BODY);
        body_cnt = *(fn_rec + FN_BCNT);

        // Skip cached functions loaded from .bo files. They have
        // body_arr=0 because the AST is not reconstructed at load
        // time, only the export signature. Their per-loop dispatch
        // decisions were already applied when the .bo was first
        // written, so the cached machine code already reflects them.
        // Re-running analyze_body on a null body would dereference 0
        // and crash. Per-function purity (commit 3 of smart dispatch)
        // will live in fn_phase[] which IS serialized to .bo, so
        // cross-module purity stays intact even with this skip.
        if (body_arr != 0) {

        _dsp_cur_func_idx = i;
        dsp_reset_locals();

        // Register function parameters as local variables.
        for (j = 0; j < param_cnt; j++) {
            dsp_add_local(params_arr[j]);
        }

        // Register declared local variables from auto statements.
        for (j = 0; j < body_cnt; j++) {
            stmt = body_arr[j];
            if (stmt != 0) {
                if (stmt.ntype == T_DECL) {
                    darr = stmt.a;
                    dcnt = stmt.b;
                    for (k = 0; k < dcnt; k++) {
                        dsp_add_local(darr[k]);
                    }
                }
            }
        }

        // Analyze all loops in the function body.
        analyze_body(body_arr, body_cnt);

        }   // end if (body_arr != 0) — cached-function skip
    }

    return 0;
}
