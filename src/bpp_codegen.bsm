// bpp_codegen.bsm — portable codegen logic shared across chip backends.
//
// This file is the target of the MAX-plan bpp_codegen extraction.
// Everything in here is pure AST-level / register-allocation /
// ABI-layout / tree-walking code — no chip-specific instruction
// emission. Each chip backend (a64 / x64 / future riscv / wasm)
// imports this file and implements a small set of `chip_emit_*`
// primitives that bpp_codegen calls.
//
// ── Contract: `chip_primitives` ──
//
// Each chip implements this fixed interface. The numbers next to
// each function are the "slot" in the conceptual Forth-style
// primitives table — a minimal set that any new chip needs to
// provide to receive the full power of the portable passes.
//
//   ─ Arithmetic ─
//    1  chip_emit_add(rd, rs1, rs2, size)
//    2  chip_emit_sub(rd, rs1, rs2, size)
//    3  chip_emit_mul(rd, rs1, rs2, size)
//    4  chip_emit_div(rd, rs1, rs2, size)
//    5  chip_emit_mod(rd, rs1, rs2, size)
//    6  chip_emit_neg(rd, rs, size)
//
//   ─ Logical / bitwise ─
//    7  chip_emit_and(rd, rs1, rs2)
//    8  chip_emit_or (rd, rs1, rs2)
//    9  chip_emit_xor(rd, rs1, rs2)
//   10  chip_emit_shl(rd, rs1, rs2)
//   11  chip_emit_shr(rd, rs1, rs2)
//   12  chip_emit_not(rd, rs)
//
//   ─ Move / compare ─
//   13  chip_emit_mov_imm(rd, imm)
//   14  chip_emit_mov_reg(rd, rs)
//   15  chip_emit_cmp(rs1, rs2, size)
//
//   ─ Memory ─
//   16  chip_emit_load(rd, rbase, off, size, signed)
//   17  chip_emit_store(rsrc, rbase, off, size)
//
//   ─ Control flow ─
//   18  chip_emit_branch_eq(label_id)
//   19  chip_emit_branch_ne(label_id)
//   20  chip_emit_branch_lt(label_id)
//   21  chip_emit_branch_ge(label_id)
//   22  chip_emit_jump(label_id)
//   23  chip_emit_label(label_id)
//   24  chip_emit_call(target_label)
//   25  chip_emit_ret()
//
//   ─ Stack ─
//   26  chip_emit_push(reg)
//   27  chip_emit_pop(reg)
//   28  chip_emit_frame_setup(frame_size)
//   29  chip_emit_frame_teardown(frame_size)
//
//   ─ Syscall ─
//   30  chip_emit_syscall(num_args)
//
//   ─ Register file metadata ─
//   31  chip_reg_count()              → how many GP registers
//   32  chip_arg_reg(i)               → i-th argument register
//   33  chip_arg_reg_count()          → args-in-regs limit
//   34  chip_return_reg()             → return-value register
//   35  chip_sp_reg()                 → stack pointer
//   36  chip_fp_reg()                 → frame pointer
//   37  chip_caller_saved_mask()      → bitmask
//   38  chip_callee_saved_mask()      → bitmask
//   39  chip_word_size()              → 4 or 8
//
// ── Status ──
//
// This module is intentionally empty during Phase 0 (audit).
// See `docs/max_plan_codegen_split.md` for the audit report and
// the per-function migration table.
//
// Subsequent phases move portable logic out of
// `src/backend/chip/<arch>/<arch>_codegen.bsm` into this file,
// function by function, validating byte-identity of the `bpp`
// binary after each move. When extraction is complete, each
// `<arch>_codegen.bsm` shrinks to ~300 lines of pure
// `chip_primitives` implementations.

// Placeholder sentinel so the file is not "empty" and gets
// touched by the linker. Will be replaced with real code during
// Phase 2 of the MAX-plan bpp_codegen extraction.
static bpp_codegen_version() {
    return 0;
}

// ── Phase 3.4: chip_primitives fn_ptr dispatch table ─────────
//
// Every chip implements the 45-slot primitives contract. The
// portable spine in this file calls into the active chip via
// `call(cg_prim.<slot>, ...)`. Init for each chip
// (`init_codegen_arm64()` / `init_codegen_x86_64()`) populates
// the slots with `fn_ptr(_<chip>_emit_<name>)` after allocating
// the struct on first call.
//
// All 45 slots are declared up front so the layout is stable
// across the wave migration. A wave that hasn't migrated a case
// yet leaves its slot at zero (valid in the struct — the chip's
// inline emission still runs for that case, so the slot is never
// read until the spine takes over).
//
// Categories (per docs/phase_3_4_chip_primitives.md §contract):
//   Arithmetic (8), Logical (6), Move/compare (5), Memory (5),
//   Control flow (7), Stack/ABI (6), Syscall (1), Float (2),
//   Register-file metadata (5).

struct ChipPrimitives {
    // ── Arithmetic (10) ──
    // BINOP context: result→reg 0, RHS already in reg 0; LHS in
    // chip's left register (a64: variable left_reg; x64: always
    // rcx=1, primitive ignores the parameter). Wave 5.
    emit_add,           // (left_reg)            int add
    emit_sub,           // (left_reg)            int sub
    emit_mul,           // (left_reg)            int mul
    emit_div,           // (left_reg)            signed int div   (SDIV)
    emit_udiv,          // (left_reg)            unsigned int div (UDIV) — :u_word family
    emit_mod,           // (left_reg)            signed int mod   (SDIV+MSUB)
    emit_umod,          // (left_reg)            unsigned int mod (UDIV+MSUB)
    emit_neg,           // ()                    int negate (Wave 4)
    emit_fadd,          // ()                    float add d0=d1+d0
    emit_fsub,          // ()                    float sub d0=d1-d0
    emit_fmul,          // ()                    float mul d0=d1*d0
    emit_fdiv,          // ()                    float div d0=d1/d0

    // ── Logical (6) ──
    // BINOP context (same convention as arith above): Wave 5.
    emit_and,           // (left_reg)            bitwise and
    emit_or,            // (left_reg)            bitwise or
    emit_xor,           // (left_reg)            bitwise xor
    emit_shl,           // (left_reg)            shift left
    emit_shr,           // (left_reg)            arithmetic shift right (ASR / SAR) — sign-extends
    emit_lshr,          // (left_reg)            logical shift right    (LSR / SHR) — zero-fills, :u_word family
    // Immediate-form shifts: the value being shifted is already in the
    // accumulator and the count is a compile-time constant, so no register
    // is materialised for the count and no variable shift is needed.
    emit_shl_imm,       // (amt)                 acc <<= amt
    emit_shr_imm,       // (amt)                 acc >>= amt  (arithmetic, sign-extends)
    emit_lshr_imm,      // (amt)                 acc >>= amt  (logical, zero-fills, :u_word family)
    emit_not,           // ()                    bitwise not (Wave 4)

    // ── Move / compare (7) ──
    emit_mov_zero,      // ()                    result reg ← 0
    emit_mov_imm,       // (imm)                 result reg ← imm
    emit_mov_reg,       // (rd, rs)
    emit_cmp,           // (rs1, rs2, size)      flags-setting (Wave 7+)
    emit_cmp_imm,       // (rs, imm, size)       flags vs immediate
    // BINOP comparison (Wave 6). Chip emits cmp + setcc/cset
    // and produces the boolean result in result reg (x0/rax).
    // cond_id is portable: 0=EQ 1=NE 2=LT 3=LE 4=GT 5=GE. The
    // chip's primitive maps to the native condition code.
    emit_cmp_int,       // (cond_id, left_reg)   int compare
    emit_cmp_flt,       // (cond_id)             float compare d1<>d0
    emit_cmp_flt_into,  // (dst_int_reg, l_freg, r_freg, cond_id) — float
                        // compute-in-place comparison: fcmp d<l_freg>,
                        // d<r_freg>; cset x<dst_int_reg>, <cc>. Same two
                        // instructions emit_cmp_flt already emits, just
                        // parameterized instead of hardcoded to d1/d0/x0.

    // ── Memory (10) ──
    emit_load,          // (rd, rbase, off, size, signed)  reserved
    emit_store,         // (rsrc, rbase, off, size)        reserved
    emit_load_local,    // (vi, off) — wraps chip's emit_load_var
                        //              with B3 promoted-reg + sub-word matrix
    emit_load_global,   // (name_p, is_float)
    emit_store_global,  // (name_p, is_float)
    emit_load_str_addr, // (str_id)
    // Wave 8: T_MEMLD / T_MEMST / T_ADDR. Field-hint carries
    // sub-word + bit-packed dispatch; the chip primitive owns
    // the matrix internally so the spine stays AST-level.
    emit_memld_load,    // (field_hint) — addr already in result reg
    emit_memst_store,   // (field_hint) — addr in result reg, val in
                        //                left-saved reg (x1 / rcx)
    emit_addr_local,    // (off)        — fp-relative address-of
    emit_addr_global,   // (name_p)     — global address (no load)

    // ── Control flow (8) ──
    // Wave 7 uses these for T_IF / T_WHILE / T_TERNARY / T_RET
    // / T_BREAK / T_CONTINUE. emit_branch_if_zero tests the
    // result reg and jumps when zero (handles both raw int
    // truth and post-fcond-normalisation truth). The dedicated
    // flag-consuming branches (emit_branch_eq etc.) stay
    // reserved for Wave 8+ where the spine drives cmp + branch
    // pairs without producing a boolean result.
    emit_new_label,     // ()           → label_id
    emit_label,         // (label_id)
    cur_text_pos,       // ()           → current byte offset in the code buffer,
                        //                or -1 in asm-text mode (no real offsets).
                        //                Used by the spine inline splicer to record
                        //                .bug inline ranges chip-agnostically.
    emit_jump,          // (label_id)
    emit_branch_if_zero,// (label_id)   branch to label if result reg == 0
    emit_call,          // (target_label) — reserved
    emit_branch_eq,     // (label_id)   reserved for Wave 8+
    emit_branch_ne,     // (label_id)   reserved
    emit_jump_to_epilogue, // ()        function return path

    // ── T_CALL ABI (Wave 9 scaffolding, body deferred to 9b) ──
    // 14 slots wired but spine cg_emit_node T_CALL remains
    // inactive. Chip's existing inline T_CALL keeps producing
    // identical output. Wave 9b session activates dispatch.
    arg_reg_int,        // (slot_idx) → physical GP reg, -1 if spills
    arg_reg_flt,        // (slot_idx) → physical FP reg, -1 if spills
    arg_reg_count_int,  // ()          → 8 (a64) or 6 (x64)
    arg_reg_count_flt,  // ()          → 8 (a64) or 8 (x64)
    emit_push_arg_int,  // (dst_or_off, is_spill)
    emit_push_arg_flt,  // (dst_or_off, is_spill)
    emit_pre_call_align,    // (stack_args) → bytes of padding
    emit_post_call_unalign, // (pad_bytes)
    emit_call_direct,   // (target_lbl)
    emit_call_extern,   // (ex_idx)
    emit_copy_ret_int,  // ()  no-op on most chips
    emit_copy_ret_flt,  // ()  no-op on most chips
    emit_save_caller_saved_int,    // ()
    emit_restore_caller_saved_int, // ()

    // Wave 9b fat-primitive (A.3/A.4): wraps the chip-local
    // <chip>_emit_call helper. The finer-grained T_CALL
    // primitives above (arg_reg_*, push_arg_*, etc.) stay
    // reserved for a future decomposition session where spine
    // owns the ABI scheduling. For now fat dispatch preserves
    // the inline pattern byte-for-byte (B2 inline splice,
    // push-then-pop-to-argregs, FFI register rearrangement).
    emit_call_full,                // (node) → ety (0 int, 1 float)

    // Commit B fat-primitive: wraps the chip-local
    // <chip>_emit_func helper. Spine cg_emit_func dispatches
    // through this. Same rationale as emit_call_full — frame
    // math + B3 select + arg copy are chip-entangled enough
    // that a fine-grained decomposition is its own session.
    emit_func_full,                // (fi) → void

    // ── Phase 3.5: emit_func (Waves 13-15 scaffolding) ──
    // Bodies wired but spine cg_emit_func not yet active —
    // chip's emit_func{_arm64,_x86_64} continues to handle
    // every function. Activations land in 9b/13b session.
    emit_fn_entry_label,    // (name_p, fn_lbl_id) Wave 13
    emit_frame_setup,       // (frame_size)        Wave 13
    emit_save_callee_saved, // (regs_arr, count, base_off) Wave 13
    b3_select,              // ()                  Wave 13
    regalloc_apply,         // (assigns) -> 1/0     RegAlloc v2 Stage E — replaces
                            // B3's integer-local decision with the linear-scan one
                            // when the chip can map every assigned slot to a real
                            // physical register (and re-runs constant promotion on
                            // the leftover budget). Returns 0 (B3's decision stays
                            // untouched) on any chip that can't yet do this — the
                            // "integer first, a64 first" rollout this stage is.
    regalloc_apply_float,   // (assigns) -> 1/0     Same shape as regalloc_apply,
                            // over the disjoint float pool (d8..d15) and
                            // cg_b3_eligible_float. Independent decision from the
                            // integer swap — a function can take one, the other,
                            // both, or neither.
    emit_arg_copy_int,      // (var_idx, abi_seq_idx, frame_off) — int param from x_<seq> / rdi-class to slot
    emit_arg_copy_flt,      // (var_idx, abi_seq_idx, frame_off) — float param from d_<seq> / xmm to slot
    emit_frame_teardown,    // (frame_size, regs_arr, count, base_off) Wave 15

    // ── Phase 4: emit_module + emit_all (Waves 16-17 scaffolding) ──
    emit_module_setup,      // ()                  Wave 16
    emit_module_finalize,   // ()                  Wave 16
    alloc_fn_labels,        // ()                  Wave 16
    emit_prelude,           // ()                  Wave 17
    emit_global_data,       // ()                  Wave 17
    emit_postlude,          // ()                  Wave 17

    // ── Stack (4) ──
    // (emit_frame_setup / emit_frame_teardown moved to
    // Phase 3.5 section above — the Wave 13/15 signatures take
    // register-list + spill-base args and supersede these stubs.)
    emit_push,          // (reg)                 GP push
    emit_pop,           // (reg)                 GP pop
    emit_fpush,         // (reg)                 FP push
    emit_fpop,          // (reg)                 FP pop

    // ── Syscall (1) ──
    emit_syscall,       // (num_args)            chip's ABI

    // ── Float (5) ──
    emit_load_float_const, // (flt_id)           load const → d0
    emit_fconst_into,      // (dreg, flt_id)     load const → d<dreg> —
                            //   compute-in-place twin of emit_load_float_const,
                            //   parameterized over the destination instead of
                            //   the fixed accumulator
    emit_fcmp,             // (rs1, rs2)         double compare
    emit_fneg,             // ()                 negate result fp reg
    // Type promotions used by T_IF/WHILE/TERNARY (normalize
    // float condition to int truth) and T_RET (match function's
    // declared return type). Result-reg in, result-reg out.
    emit_fcond_to_int_truth, // ()    if (fp != 0) int=1 else 0
    emit_promote_int_to_flt, // ()    int result → float result
    emit_demote_flt_to_int,  // ()    float result → int result

    // ── Register file metadata (5) ──
    arg_reg,            // (i) → reg index
    farg_reg,           // (i) → fp reg index
    return_reg,         // ()  → reg index
    freturn_reg,        // ()  → fp reg index
    word_size,          // ()  → 4 or 8

    // ── Wave 18 inline builtin dispatch (3) ──
    // Consumed by cg_builtin_dispatch for peek / poke / str_peek /
    // sys_* lifts. The spine evaluates arguments through emit_node
    // (the chip's tree walker exposed as a primitive), invokes
    // emit_coerce_float_to_int if the arg came out in a float
    // register, then calls emit_mem_read / emit_mem_write for the
    // final instruction. See Cap 23 (Battalions) in the book for
    // the full recipe and a worked peek example.
    emit_node,          // (node)  → ety (0 int, 1 float)
    emit_mem_read,      // (width) — load `width` bytes at [acc] into acc
    emit_mem_read_indexed, // (width) — load `width` bytes at [acc + scratch] into acc
    emit_mem_write,     // (val_reg, width) — store `width` bytes from val_reg into [acc]
    emit_push_acc,      // () — push accumulator onto stack
    emit_pop_scratch,   // () — pop stack top into scratch reg (x1/rcx)
    emit_coerce_float_to_int, // () — truncate float accumulator to int
    emit_floor_to_int,        // () — floor float (round to -inf), then cast to int
    emit_round_to_int,        // () — round float to nearest even, then cast to int
    emit_mem_barrier,   // () — full memory barrier + zero acc
    emit_shift_right_logical, // () — acc >>= scratch (unsigned)
    emit_ror32,         // () — 32-bit rotate right.
                        //   acc = (acc & 0xFFFFFFFF) ROR (scratch & 31)
                        //   Result zero-extended into the full 64-bit
                        //   destination. Uses the same `acc = value,
                        //   scratch = count` convention as
                        //   `emit_shift_right_logical` so the primitive
                        //   reads identically across chips (the BINOP
                        //   convention is asymmetric — a64 places LHS
                        //   in left_reg, x64 places LHS in acc — and
                        //   rotation needs a consistent operand order).
                        //   Sole consumer today is the `sha_rotr`
                        //   SHA-256 helper; future hash / crypto code
                        //   reuses without extending the chip ABI.
    emit_load_float_ret, // (slot) — load float return save slot (0 or 1)
    emit_trap_if_zero,  // () — if acc == 0, trap (brk/INT3)

    // ── Wave 18 runtime access ──
    // Runtime globals (_bpp_argc / _bpp_argv / _bpp_envp) are
    // populated by the platform's crt0 at program entry. The
    // spine no longer reads them through chip primitives — the
    // 2026-05-13 migration moved argc_get / argv_get / envp_get
    // to plain B++ source functions in src/bpp_args.bsm. Only
    // syscalls remain as chip-specific primitives here.
    emit_syscall,             // (num, argc, extra_slot, extra_val) — invoke syscall
    emit_syscall_norm_err,    // () — normalise syscall error convention

    // Wave 18 batch 5: fn_ptr(name) address loader. The spine resolves
    // the function name to its index via cg_find_fn and hands the index
    // to this primitive, which emits the chip-specific "load code
    // address" instruction (ADR on aarch64, LEA RIP-relative on x86_64)
    // and records any link-time relocation the target needs.
    emit_fn_ptr,              // (fn_idx) — acc ← address of function fn_idx

    // Wave 19 extras for spine takeover (batch 6): reset chip-specific
    // state at the start of emit_func (freelist, promoted-reg array),
    // and reserve the B3 spill area after b3_select runs so the chip
    // records its spill-base offset and reports how much to grow the
    // total variable bytes. Spine stays ignorant of the sign/layout.
    fn_reset_chip_state,      // () — clear promoted_regs + reset freelist
    fn_reserve_spill,         // (total) → new_total (total + promoted*8)
    fn_label_for,             // (fi) → chip-local label id for function fi
    emit_prologue_full,       // (name_p, fn_lbl_id, frame_size) — fat prologue

    // Wave 20: emit_stmt orchestration. Spine cg_emit_stmt owns the
    // 11 statement cases directly; the four supporting slots below
    // cover the chip-uniform pieces of T_ASSIGN and T_SWITCH that
    // resolve cleanly per backend. The previous fat `emit_stmt_full`
    // delegator slot was retired once the spine took T_ASSIGN /
    // T_MEMST / T_SWITCH inline (the chip walkers + wrappers became
    // dead code; cleanup commit follows the cg_emit_stmt rewrite).
    emit_struct_copy_word,    // (src_word_off, dst_frame_off_bytes) — 8B load+store
    emit_peek_cond,           // () — load saved cond from [sp] into scratch
    emit_cmp_scratch_acc,     // () — flags ← compare(scratch, acc)
    emit_branch_if_nonzero,   // (label_id) — branch when acc != 0

    // Wave 21: emit_node orchestration (endgame). Three primitives
    // support the T_BINOP left-save dance (freelist on aarch64 /
    // stack on x86_64) and T_VAR stack-struct address-of. Bodies
    // stay unwired for now — the chip's emit_node still handles
    // these cases inline — but the slots exist so the follow-up
    // session that decomposes the tree walker has a target surface.
    emit_binop_save_left,     // (has_call_right, lty) → save_token
    emit_binop_resolve,       // (save_token, use_flt, lty, rty) → left_reg_int
    emit_addr_stack_struct,   // (frame_off) — acc ← fp + frame_off (stack-struct addr-of)

    // Wave 20 stage 2: T_ASSIGN type-aware store into a local variable
    // (sub-word hints resolve here — `: half` / `: quarter` / struct
    // byte widths). rty is the RHS emit_node result (0=int, 1=float).
    emit_store_var_typed,     // (vi, off, rty)

    // T_MEMST paths. The spine makes the type-based decision (SIMD
    // vs scalar-float vs int) and delegates to the matching primitive;
    // each owns its own eval-push-eval-pop-store sequence because the
    // register file involved differs per shape.
    emit_memst_float_simd,    // (nd)          — `: double` 128-bit store
    emit_memst_float_scalar,  // (nd, fh_sl)   — `: half/quarter/full` scalar
    emit_memst_int,           // (nd, fh)      — int store, freelist-aware

    // T_SWITCH helpers. jtbl primitive delegates to the chip-local
    // dense-jump-table emitter (aarch64 only — x86_64 builds a jump
    // table in a different shape). pop_discard drops the saved cond
    // word between arms / on fall-through; aarch64 pops into x9
    // (freelist reg, guaranteed scratch), x86_64 pops into rcx.
    emit_switch_jtbl,         // (nd, end_lbl) — Form 1 dense dispatch
    emit_pop_discard,         // ()            — drop one word from stack top

    // ── Wave 19: function-frame orchestration primitives ──
    // The eight slots below are consumed by the portable cg_emit_func
    // (bpp_codegen.bsm) once it takes over from a64_emit_func /
    // x64_emit_func. Until then (pre-batch-6) the chip's emit_func
    // still calls its own helpers inline; the slots let the spine
    // orchestrate gradually without breaking byte identity.
    fn_pre_reg_vars,          // (body_arr, body_cnt) — walk body pre-declaring vars
    fn_compute_offsets,       // () → total_vars_bytes (fills cg_var_off)
    fn_scratch_base,          // () → hidden-scratch size (fp/lr + d0/d1 save etc)
    save_main_runtime_globals,// () — save argc/argv/envp from arg regs to _bpp_* globals
    emit_narrow_float_params, // (par_cnt) — a64 half/quarter fcvt pass, no-op on x64
    emit_implicit_ret_zero,   // () — mov return_reg, 0 for fallthrough return
    emit_body,                // (body_arr, body_cnt) — chip's body walker delegation

    // Float pointer builtins (pokefloat / pokefloat_h).
    emit_coerce_int_to_float, // () — x0/rax → d0/xmm0. Used when val arg is an integer.
    emit_float_store_scalar,  // (fh_sl, val_reg) — store float reg val_reg at [acc].
                              //   fh_sl ∈ {SL_HALF=32-bit, SL_FULL=64-bit}.
                              //   x86_64 limitation: SL_HALF stores bitcast bits (wrong for
                              //   sub-word float); full fix needs cvtsd2ss + movss.

    // Phase 6.2c — caller_pc(n). On entry, n is in result reg
    // (x0/rax). On exit, the chosen frame's PC is in result reg.
    // Semantics:
    //   n == 0 → current PC (a PC inside the calling function),
    //            obtained via ADR x0, . on ARM64 or LEA rax, [rip] on x86_64
    //   n >= 1 → walk (n-1) frames up the FP chain, then read the
    //            saved LR / return address at FP+8 of that frame.
    // So caller_name(caller_pc(0)) names the current function,
    // caller_name(caller_pc(1)) names its direct caller, etc.
    emit_caller_pc,           // () — n in result reg, PC out in result reg

    // ── F.2.c prototype: compute-in-place for pure float arithmetic ──
    // The spine's cg_emit_float_into walks a `+ - * /` tree whose leaves
    // are plain `: float` locals and emits destination-driven ops
    // (`fop d_dst, d_a, d_b`) instead of routing every value through the
    // d0 accumulator (the "shuttle"). These five slots are the chip hooks
    // it needs. A chip that returns 0 from simd_temp_count opts out and
    // keeps the accumulator path (x86_64 today).
    emit_fload_var_into,      // (dreg, off) — ldr d<dreg>, [fp, #off]
    emit_fload_promoted_into, // (dreg, base_reg, off) — ldr d<dreg>, [x<base_reg>, #off]
                              //   struct-field CIP leaf: base already promoted,
                              //   offset folded straight into the load
    emit_fload_mem_into,      // (dreg, addr_reg) — ldr d<dreg>, [x<addr_reg>]
                              //   struct-field CIP leaf: base computed into
                              //   addr_reg by cg_emit_int_into first
    emit_fop_into,            // (op_code, dreg, s1, s2) — d<dreg> = d<s1> OP d<s2>
                              //   op_code: 0=add 1=sub 2=mul 3=div
    emit_fma,                 // (op_code, dst, n, m, a) — fused multiply-add:
                              //   op 0: d<dst> = d<n>*d<m> + d<a>  (fmadd)
                              //   op 1: d<dst> = d<a> - d<n>*d<m>  (fmsub)
    emit_fmov_reg,            // (dst, src) — fmov d<dst>, d<src> (promoted read)
    emit_mov_reg_reg,         // (dst, src) — mov x<dst>, x<src> (banked return
                              //   placement / multi-value unpack — x64 maps the
                              //   operands through its return-bank position table)
    emit_mov_phys,            // (dst, src) — mov between PHYSICAL register numbers
                              //   (no bank remap); for B3 promoted-register reads
    emit_bank_push,           // (is_flt) — push acc (x0 / d0) to the value stack
    emit_bank_pop,            // (is_flt, reg) — pop value-stack top into x<reg>/d<reg>
                              //   (two-pass multi-return placement, scratch-safe)
    cap_multi_ret,            // () → 1 if this backend implements multi-value
                              //   return banking (a64), 0 otherwise (x86_64 /
                              //   C-emit — the spine diagnoses instead of
                              //   emitting silently wrong code)
    simd_temp_alloc,          // () → a caller-saved SIMD temp reg, or -1
    simd_temp_free,           // (reg) — return a temp to the pool
    simd_temp_count,          // () → temp-pool size (0 disables the path)

    // ── Integer compute-in-place (the int analog of the float CIP above) ──
    // cg_emit_int_into walks a `+ - * / & | ^` integer tree and emits
    // destination-driven ops instead of the x0 accumulator shuttle. Temps
    // come from the GP freelist; a chip that returns 0 from int_temp_count
    // opts out and keeps the accumulator path (x86_64 until ported).
    emit_iload_var_into,      // (dreg, off) — ldr x<dreg>, [fp, #off]
    emit_iconst_into,         // (dreg, val) — materialise immediate into x<dreg>
    emit_iop_into,            // (op_code, dreg, s1, s2) — x<dreg> = x<s1> OP x<s2>
                              //   op: 0=add 1=sub 2=mul 3=sdiv 4=and 5=orr 6=eor
    emit_iload_mem_into,      // (dreg) — ldr x<dreg>, [x<dreg>] (full-word load)
    emit_ishl_imm_into,       // (dreg, src, amt) — x<dreg> = x<src> << amt (strength-reduced multiply)
    emit_imadd,               // (op, dreg, n, m, a) — x<dreg> = a +/- n*m (integer fused multiply-add)
    int_temp_alloc,           // () → a free GP temp reg, or -1
    int_temp_free,            // (reg) — return a temp to the pool
    int_temp_count,           // () → CURRENT free temp count (0 disables)
    // Induction-variable pointer walk (a counted array loop walks a register
    // pointer instead of recomputing base + i*8 each iteration).
    emit_iv_load,             // (dreg, base_reg) — x<dreg> = *base_reg
    emit_iv_store,            // (base_reg) — *base_reg = x0
    emit_iv_advance,          // (base_reg) — base_reg += 8 (once per iteration, in the step)
    emit_iv_setup,            // (base_reg, idx_reg) — base_reg += idx_reg*8 (pre-loop)
    iv_supported,             // () → 1 if the chip supports the pointer walk (a64), else 0
    emit_self_op_imm,         // (reg, imm, is_sub) — x<reg> = x<reg> +/- imm (in place; `i = i + 1`)
    emit_cmp_branch,          // (cond_id, left_reg, lbl) — cmp + branch-to-lbl-when-false (no cset)
    emit_cmp_branch_rr,       // (cond_id, lreg, rreg, lbl) — cmp two registers directly + branch
    emit_cmp_flt_branch,      // (cond_id, l_freg, r_freg, lbl) — fcmp two registers directly +
                              //   branch-to-lbl-when-false (no cset); the float twin of
                              //   emit_cmp_branch_rr
}

// Active chip's primitive table. Allocated lazily on first call
// to `init_codegen_arm64()` or `init_codegen_x86_64()`. Read by
// the spine via `auto p: ChipPrimitives; p = cg_prim;
// call(p.emit_X, ...)`.
//
// Cross-compile note: when both inits run in the same compiler
// process (host targets one chip, then the other), the second
// init overwrites the first chip's slots. That's by design — the
// active target is whatever was initialised last, and bpp.bpp
// orders the inits to match the requested target triple.
extrn cg_prim;

// This file has otherwise relied on transitive availability (every
// real caller chain — a64_codegen.bsm / x64_codegen.bsm, imported from
// bpp.bpp — already pulls in bpp_array/bpp_arr/bpp_dispatch by the time
// this file's functions run). RegAlloc v2 Stage A introduced the first
// GENUINE new dependency this file calls directly
// (regalloc_build_cfg / regalloc_name_wants_dump / regalloc_dump_cfg,
// in cg_emit_func below) that isn't already guaranteed transitively —
// some lower-level compiler-internal tests assemble their own minimal
// import chain (e.g. tests/test_macho_only.bpp: bpp_dispatch.bsm then
// straight to a64_codegen.bsm, never through bpp.bpp's own list), so
// this needs its own explicit import rather than counting on bpp.bpp's
// chain again.
import "bpp_regalloc.bsm";

// Allocate cg_prim if it hasn't been yet. Idempotent — both
// init_codegen_<chip>() functions guard their own population
// behind this so the malloc happens exactly once per process.
cg_prim_alloc() {
    if (cg_prim != 0) { return; }
    cg_prim = malloc(sizeof(ChipPrimitives));
}

// Portable condition codes consumed by emit_cmp_int / emit_cmp_flt.
// Each chip's primitive maps these to its native cond encoding
// (a64 nzcv codes 0-15 vs x86_64 CC_E/NE/L/LE/G/GE etc.).
extrn CG_CC_EQ, CG_CC_NE, CG_CC_LT, CG_CC_LE, CG_CC_GT, CG_CC_GE;
// Unsigned ordering condition codes. Equality (EQ/NE) is signedness-
// agnostic, but the four ordering comparisons diverge between signed
// and unsigned exactly like / % >> — so `: u_word` routes them here and
// each chip maps them to its native unsigned set/branch condition
// (a64 cc/ls/hi/cs; x86 below / below-or-equal / above / above-or-equal).
extrn CG_CC_LO, CG_CC_LS, CG_CC_HI, CG_CC_HS;
void cg_init_cc() {
    CG_CC_EQ = 0;
    CG_CC_NE = 1;
    CG_CC_LT = 2;
    CG_CC_LE = 3;
    CG_CC_GT = 4;
    CG_CC_GE = 5;
    CG_CC_LO = 6;    // unsigned <   (lower)
    CG_CC_LS = 7;    // unsigned <=  (lower or same)
    CG_CC_HI = 8;    // unsigned >   (higher)
    CG_CC_HS = 9;    // unsigned >=  (higher or same)
}

// Portable syscall identifiers consumed by emit_syscall. The spine
// dispatches every lifted sys_* builtin through `cg_builtin_dispatch`
// passing one of these IDs; the chip's `_<chip>_sys_num` helper maps
// CG_SYS_* to BSYS_* on the active target so no OS-specific constant
// ever leaks into the portable dispatch table. A syscall that is not
// available on the running chip makes the chip's sys_num helper abort
// with a diagnostic instead of emitting a bogus syscall number.
//
// Only syscalls with a simple "args in regs, trap, optional csneg"
// shape are lifted here. Specials that build timevals on the stack
// (sys_usleep), fabricate extra zeros (sys_waitpid → wait4 with
// hardcoded status/options/rusage), or exist on only one OS
// (sys_ioctl / sys_nanosleep / sys_clock_gettime — all Linux-only
// in this tree) stay chip-local and are not listed here.
extrn CG_SYS_EXIT, CG_SYS_READ, CG_SYS_WRITE, CG_SYS_OPEN, CG_SYS_CLOSE,
      CG_SYS_FORK, CG_SYS_EXECVE, CG_SYS_WAIT4, CG_SYS_GETDENTS,
      CG_SYS_UNLINK, CG_SYS_PTRACE, CG_SYS_LSEEK, CG_SYS_FCHMOD,
      CG_SYS_SOCKET, CG_SYS_CONNECT, CG_SYS_MKDIR, CG_SYS_MMAP, CG_SYS_MUNMAP,
      CG_SYS_SELECT, CG_SYS_STAT;
void cg_init_sys_ids() {
    CG_SYS_EXIT     = 0;
    CG_SYS_READ     = 1;
    CG_SYS_WRITE    = 2;
    CG_SYS_OPEN     = 3;
    CG_SYS_CLOSE    = 4;
    CG_SYS_FORK     = 5;
    CG_SYS_EXECVE   = 6;
    CG_SYS_WAIT4    = 7;
    CG_SYS_GETDENTS = 8;
    CG_SYS_UNLINK   = 9;
    CG_SYS_PTRACE   = 10;
    CG_SYS_LSEEK    = 11;
    CG_SYS_FCHMOD   = 12;
    CG_SYS_SOCKET   = 13;
    CG_SYS_CONNECT  = 14;
    CG_SYS_MKDIR    = 15;
    CG_SYS_MMAP     = 16;
    CG_SYS_MUNMAP   = 17;
    CG_SYS_SELECT   = 18;
    CG_SYS_STAT     = 19;
}

// ── Phase 3.4 portable helpers (called from chip emit_node) ──
//
// Each helper owns the chip-invariant decision logic for one AST
// case and dispatches to chip primitives via cg_prim. Both chips'
// emit_node bodies replace the case body with a single call to
// the matching cg_emit_* function.

// T_LIT (Wave 2): integer / string / float literal. The packed
// (offset, length) into cg_sbuf carries the raw token text;
// cg_is_float_lit + the leading-quote test classify it. Returns
// 0 for int/string (result in result-int-reg) or 1 for float
// (result in result-fp-reg).
cg_emit_lit(packed) {
    auto p: ChipPrimitives;
    auto lit_s, lit_l, sid, str_p, fid;
    p = cg_prim;
    lit_s = unpack_s(packed);
    lit_l = unpack_l(packed);
    if (peek(cg_sbuf + lit_s) == '"') {
        // String literal: strip the surrounding quotes, register
        // it in cg_str_tbl, primitive emits the address load.
        sid = arr_len(cg_str_tbl);
        str_p = pack(lit_s + 1, lit_l - 2);
        cg_str_tbl = arr_push(cg_str_tbl, str_p);
        call(p.emit_load_str_addr, sid);
        return 0;
    }
    if (cg_is_float_lit(packed) == 1) {
        fid = arr_len(cg_flt_tbl);
        cg_flt_tbl = arr_push(cg_flt_tbl, packed);
        call(p.emit_load_float_const, fid);
        return 1;
    }
    // Stage 2a accumulator use-site: a promoted hot constant moves from its
    // callee-saved register into the accumulator instead of a fresh
    // movz/movk. (Only set on a64; mov-from-reg is sign-agnostic and works
    // for any non-CIP integer expression — shifts, division, etc.)
    auto _lcv, _lcx, _lcr;
    _lcv = cg_parse_int(packed);
    _lcx = cg_const_find(_lcv);
    if (_lcx >= 0) {
        _lcr = arr_get(cg_const_reg, _lcx);
        if (_lcr >= 0) { call(p.emit_mov_phys, 0, _lcr); return 0; }
    }
    call(p.emit_mov_imm, _lcv);
    return 0;
}

// T_VAR (Wave 3): variable reference. Three sub-cases:
//   1. Local var with cg_var_stack[vi] true: stack-allocated
//      struct; the address-of path is left INLINE in the chip's
//      emit_node body (chip-specific add-immediate, rare case)
//      and this helper is not called for it.
//   2. Local var (non-stack): delegates to the chip's load_local
//      primitive which carries the B3 promoted-register
//      short-circuit and the sub-word dispatch matrix.
//   3. Global var: dispatches via load_global with an is_float
//      flag picked from the inferred global type.
cg_emit_var(packed) {
    auto p: ChipPrimitives, vi, off;
    p = cg_prim;
    vi = cg_var_idx(packed);
    if (vi >= 0) {
        off = arr_get(cg_var_off, vi);
        // Caller must have peeled the stack-struct sub-case
        // before calling us — reaching here with cg_var_stack[vi]
        // set means the chip-side code didn't honour the protocol.
        return call(p.emit_load_local, vi, off);
    }
    // Else: global var. Inferred type drives the float vs int dispatch.
    if (is_float_type(ty_get_global_type(packed))) {
        call(p.emit_load_global, packed, 1);
        return 1;
    }
    call(p.emit_load_global, packed, 0);
    return 0;
}

// T_UNARY (Wave 4): bitwise NOT (~), integer negate (-), or
// float negate (- on a double-typed operand). The chip emits the
// operand recursively, captures its result type (0 = int, 1 =
// float), then calls this helper with the operator token + the
// operand type. Returns the result type of the unary expression.
cg_emit_unary(op_packed, operand_ty) {
    auto p: ChipPrimitives, op_s, op_l;
    p = cg_prim;
    op_s = unpack_s(op_packed);
    op_l = unpack_l(op_packed);
    // Bitwise NOT: result reg ← ~result reg.
    if (op_l == 1 && peek(cg_sbuf + op_s) == '~') {
        call(p.emit_not);
        return 0;
    }
    // Float negate: result fp reg ← -result fp reg.
    if (operand_ty == 1) {
        call(p.emit_fneg);
        return 1;
    }
    // Integer negate.
    call(p.emit_neg);
    return 0;
}

// ── Phase 1: shared globals ────────────────────────────────
//
// These replace per-chip duplicates. Each chip codegen imports
// this file and references the `cg_*` names directly. During
// Phase 1 the renames are applied one subgroup at a time with
// byte-identity validation after each.
//
// Switch-analysis state used by the dense jump-table pass. Set
// by `switch_is_dense` (portable analysis, moves in Phase 2),
// consumed by the chip-specific `emit_switch_jtbl`.
extrn cg_sw_min;     // Lowest arm value seen (signed 64-bit).
extrn cg_sw_max;     // Highest arm value seen.
extrn cg_sw_total;   // Total count of arm values.

// Parser's string buffer — every identifier and literal lives as
// a packed (offset, length) into this buffer. Shared across chips
// so the source-reading helpers below (cg_str_eq, cg_parse_int,
// etc.) don't need the chip prefix. Set once by bridge_data at
// codegen entry, read-only thereafter.
global cg_sbuf;

// ── Portable helpers: packed-string utilities ────────────────
//
// The parser packs identifiers, literals, and other tokens as a
// 64-bit (offset, length) pair via `pack()` + `unpack_s/l()`. The
// following helpers read that representation against `cg_sbuf`
// and work identically on every chip because they don't emit any
// instruction bytes — they just parse text the parser produced.

// Count how many entries in a 1-byte type-tag buffer between
// indices [lo, hi) match `match_val`. Used by the call() builtin's
// AAPCS64 / SysV register-routing pass: types_buf holds 0 (int) or
// 1 (float) per arg, and the count of each preceding the current
// arg is its destination register slot in the matching ABI bank.
// Pure index-based read, lives in the spine so both chips share it.
cg_count_tags(buf, lo, hi, match_val) {
    auto i, n;
    n = 0;
    for (i = lo; i < hi; i++) {
        if (peek(buf + i) == match_val) { n++; }
    }
    return n;
}


// Compare a packed source range against a C string literal.
// Returns 1 if the bytes match and the lengths are equal,
// 0 otherwise.
cg_str_eq(p, lit, litlen) {
    if (unpack_l(p) != litlen) { return 0; }
    return buf_eq(cg_sbuf + unpack_s(p), lit, litlen);
}

// Compare two packed source ranges byte by byte. Faster than
// materialising both to C strings since both already live in the
// same sbuf and the comparison is index-based.
// S3i — 8-byte-chunk compare loop. Same shape as `packed_eq` in
// bpp_internal.bsm; see that docstring for the endianness +
// alignment rationale.
cg_str_eq_packed(a, b) {
    auto as, al, bs, bl, i, pa, pb;
    al = unpack_l(a); bl = unpack_l(b);
    if (al != bl) { return 0; }
    as = unpack_s(a); bs = unpack_s(b);
    pa = cg_sbuf + as;
    pb = cg_sbuf + bs;
    i = 0;
    while (i + 8 <= al) {
        if (peek_w(pa + i) != peek_w(pb + i)) { return 0; }
        i += 8;
    }
    while (i < al) {
        if (peek(pa + i) != peek(pb + i)) { return 0; }
        i++;
    }
    return 1;
}

// Parse a packed numeric literal to a 64-bit integer. Handles
// hex (0x... / 0X...) and decimal. Invalid characters produce
// garbage upstream — the lexer is expected to have validated the
// literal's shape before this helper runs.
cg_parse_int(p) {
    auto s, l, i, ch, val;
    s = unpack_s(p); l = unpack_l(p); val = 0; i = 0;
    // Hex: 0x...
    if (l > 2) {
        if (peek(cg_sbuf + s) == '0') {
            if (peek(cg_sbuf + s + 1) == 'x' | peek(cg_sbuf + s + 1) == 'X') {
                i = 2;
                while (i < l) {
                    ch = peek(cg_sbuf + s + i); val *= 16;
                    if (ch >= '0' && ch <= '9') { val += ch - '0'; }
                    if (ch >= 'A' && ch <= 'F') { val += ch - 55; }
                    if (ch >= 'a' && ch <= 'f') { val += ch - 87; }
                    i++;
                }
                return val;
            }
        }
    }
    // Decimal.
    while (i < l) { ch = peek(cg_sbuf + s + i); val = val * 10 + ch - '0'; i++; }
    return val;
}

// Quick check: does the packed literal contain a '.'? Used by
// codegens to decide between emitting an integer constant load
// and a floating-point constant load.
cg_is_float_lit(p) {
    auto s, l, i;
    s = unpack_s(p); l = unpack_l(p);
    i = 0;
    while (i < l) {
        if (peek(cg_sbuf + s + i) == '.') { return 1; }
        i++;
    }
}

// Read the byte at packed-string offset `i`, or -1 when `i` has
// walked past the literal's length. Lets the float parser below stop
// cleanly without depending on the caller-supplied buffer being
// null-terminated past the literal — `cg_sbuf` packs many tokens
// contiguously and the byte after a literal is whatever the lexer
// happened to emit next.
static _cg_flt_ch(s, l, i) {
    if (i >= l) { return 0 - 1; }
    return peek(cg_sbuf + s + i);
}

// Parse a packed float literal (e.g. "3.14", "1.5e3", "2.0e-7") and
// return its IEEE 754 64-bit pattern. Pure integer arithmetic — no
// libc dependency, no FP register use, identical results on every
// chip. Both the Mach-O and ELF binary writers consume IEEE bits in
// their `__DATA` section, and the conversion is chip- and OS-agnostic
// — the function lives in the spine so a new chip / target backend
// inherits the right answer for free.
//
// Algorithm: parse `[-]int_part [. frac_part] [e[+/-]exp]` into a
// rational `num / den` and a decimal exponent. Each factor of 10 in
// the exponent splits as 5 * 2 — the factor-of-2 part folds into a
// binary exponent adjustment we add to `exp_bits` at the end, which
// lets us cover the full IEEE 754 range without overflowing the 64-bit
// rational. Factor-of-5 multiplications can still overflow `num` /
// `den`; we pre-shrink both by 1 bit when that risk appears. Halving
// both preserves the ratio (the value) up to a single low-bit
// truncation per shrink — well below the double's 52-bit mantissa
// precision floor.
cg_parse_float_bits(p) {
    auto s, l, i, ch, neg;
    auto int_part, frac_val, frac_scale;
    auto dec_exp, exp_neg;
    auto num, den, bin_adjust;
    auto px, scaled_den, mantissa, bit_idx, exp_bits;

    s = unpack_s(p); l = unpack_l(p);

    neg = 0;
    i = 0;
    ch = _cg_flt_ch(s, l, i);
    if (ch == '-') { neg = 1; i++; ch = _cg_flt_ch(s, l, i); }

    // Integer part.
    int_part = 0;
    while (ch >= '0' && ch <= '9') {
        int_part = int_part * 10 + ch - '0';
        i++;
        ch = _cg_flt_ch(s, l, i);
    }

    // Fractional part.
    frac_val = 0;
    frac_scale = 1;
    if (ch == '.') {
        i++;
        ch = _cg_flt_ch(s, l, i);
        while (ch >= '0' && ch <= '9') {
            frac_val = frac_val * 10 + ch - '0';
            frac_scale *= 10;
            i++;
            ch = _cg_flt_ch(s, l, i);
        }
    }

    // Optional scientific exponent suffix. The lexer guarantees a
    // literal here is well-formed — any e/E is followed by at least
    // one digit (with an optional sign in between).
    dec_exp = 0;
    if (ch == 'e' || ch == 'E') {
        i++;
        ch = _cg_flt_ch(s, l, i);
        exp_neg = 0;
        if (ch == '+') { i++; ch = _cg_flt_ch(s, l, i); }
        if (ch == '-') { exp_neg = 1; i++; ch = _cg_flt_ch(s, l, i); }
        while (ch >= '0' && ch <= '9') {
            dec_exp = dec_exp * 10 + ch - '0';
            i++;
            ch = _cg_flt_ch(s, l, i);
        }
        if (exp_neg) { dec_exp = 0 - dec_exp; }
    }

    // Combine mantissa decimal into rational num / den.
    num = int_part * frac_scale + frac_val;
    den = frac_scale;

    // Special case: zero. Returning early skips the bit-extraction
    // loop, which would otherwise spin forever on num == 0.
    if (num == 0) { return 0; }

    // Apply decimal exponent via 5-multiplication + binary adjust.
    bin_adjust = 0;
    while (dec_exp > 0) {
        // Pre-shrink num so num * 5 stays within 63 bits, leaving
        // headroom for the doubling inside the bit-extraction loop.
        while (num > 0x1FFFFFFFFFFFFFFF) {
            num = num >> 1;
            den = den >> 1;
            if (den == 0) { den = 1; }
        }
        num = num * 5;
        bin_adjust++;
        dec_exp--;
    }
    while (dec_exp < 0) {
        while (den > 0x1FFFFFFFFFFFFFFF) {
            num = num >> 1;
            den = den >> 1;
            if (num == 0) { num = 1; }
        }
        den = den * 5;
        bin_adjust--;
        dec_exp++;
    }

    // Find binary exponent px such that 2^px <= num/den < 2^(px+1).
    if (num >= den) {
        scaled_den = den;
        px = 0;
        while (scaled_den + scaled_den <= num) {
            scaled_den += scaled_den;
            px++;
        }
        num -= scaled_den;
    } else {
        px = 0 - 1;
        num += num;
        while (num < den) {
            num += num;
            px--;
        }
        num -= den;
        scaled_den = den;
    }

    // Extract 52 mantissa bits by successive doubling (MSB first).
    mantissa = 0;
    bit_idx = 0;
    while (bit_idx < 52) {
        num += num;
        mantissa += mantissa;
        if (num >= scaled_den) {
            mantissa++;
            num -= scaled_den;
        }
        bit_idx++;
    }

    // Round to nearest: check the 53rd bit.
    num += num;
    if (num >= scaled_den) { mantissa++; }

    // Assemble IEEE 754 double: sign(1) | exponent(11) | mantissa(52).
    // Adding 2048 to exp_bits sets bit 63 (sign) after the shift.
    exp_bits = px + 1023 + bin_adjust;
    if (neg) { exp_bits += 2048; }
    return (exp_bits << 52) + mantissa;
}

// ── Variable table ───────────────────────────────────────────
//
// Parallel dynamic arrays indexed by variable slot. Each function
// that a codegen emits has its own pass that walks locals, adds
// them here, and later queries their slot to emit loads/stores.
// Reset per function (arr_clear at the start of emit_func).
//
//   cg_vars              packed names
//   cg_var_stack         1 if struct-on-stack (vs reg-resident)
//   cg_var_struct_idx    struct definition index, or -1
//   cg_var_off           byte offset from frame pointer
//   cg_var_forced_ty     explicit type hint from `: word` etc, or 0
//   cg_var_refs          reference count (for B3 register promotion)
//   cg_var_addr_taken    1 if address-of operator applied
//   cg_var_promote       register assigned by B3, or -1

global cg_vars;
global cg_var_stack, cg_var_struct_idx, cg_var_off, cg_var_forced_ty;
global cg_var_refs;
global cg_var_addr_taken;
global cg_var_promote;

// ── Stage 2a: hot loop-invariant constant promotion ─────────
// Parallel arrays over DISTINCT large integer constants seen in the
// current function (those that cost a movz/movk chain). cg_const_wt is a
// loop-weighted occurrence count — a constant inside a loop counts far more
// than one in straight-line code, because it executes every iteration. The
// B3 const-select promotes the hottest to spare callee-saved registers,
// materialised once after the prologue; cg_const_reg holds the assigned
// register (or -1). cg_b3_loop_depth tracks loop nesting during the B3 walk.
global cg_const_val, cg_const_wt, cg_const_reg;
global cg_b3_loop_depth;
// Set by T_MEMLD/T_MEMST just before emitting an address, when that address
// is the canonical base+const-offset shape (struct field / fixed-index
// access) — see cg_try_const_offset. The chip's load/store primitive reads
// this instead of a hardcoded 0 so the offset folds into the instruction's
// own addressing mode (one `ldr [base, #off]`) instead of a separate
// `add` to compute the full address first. Always reset to 0 right after
// the primitive consumes it, so it never leaks into unrelated code.
global cg_addr_const_off;
// Companion to cg_addr_const_off: the BASE register to address through,
// or -1 (the sentinel) meaning "the base was evaluated into the
// accumulator as usual, use x0/rax." Set when T_MEMLD's base expression
// is a simple T_VAR that's ALREADY B3-promoted to a fixed integer
// register — in that case there is nothing to evaluate at all: the
// pointer value already lives in a register, so emit_node on it would
// just copy it into x0 for no reason (an ADD #0 / MOV, real CPU cost,
// not free) right before the load needed to read it right back out via
// THAT SAME register as its base. Skipping straight to "use the
// promoted register as the load's own base" removes that copy entirely.
global cg_addr_const_base;
// Set by the B3 walk: 1 if the function makes NO calls (a leaf). A leaf may
// promote locals into caller-saved registers too — nothing can clobber them
// mid-function — widening the budget beyond the callee-saved pool.
global cg_fn_leaf;

// Add a variable to the current scope. Initialises all parallel
// arrays to their defaults and returns the fresh slot index.
cg_var_add(name_p) {
    auto idx; idx = arr_len(cg_vars);
    cg_vars = arr_push(cg_vars, name_p);
    cg_var_stack = arr_push(cg_var_stack, 0);
    cg_var_struct_idx = arr_push(cg_var_struct_idx, -1);
    cg_var_off = arr_push(cg_var_off, 0);
    cg_var_forced_ty = arr_push(cg_var_forced_ty, 0);
    cg_var_refs = arr_push(cg_var_refs, 0);
    cg_var_addr_taken = arr_push(cg_var_addr_taken, 0);
    cg_var_promote = arr_push(cg_var_promote, -1);
    return idx;
}

// Find a variable index by packed name. Returns slot index or -1.
cg_var_idx(name_p) {
    auto i; i = 0;
    while (i < arr_len(cg_vars)) {
        if (cg_str_eq_packed(name_p, arr_get(cg_vars, i))) { return i; }
        i++;
    }
    return -1;
}

// Find a variable's frame offset by packed name. Thin shortcut
// for code that only cares about where the slot lives, not its
// index. Returns -1 if the name doesn't resolve.
cg_var_find(name_p) {
    auto i;
    i = cg_var_idx(name_p);
    if (i >= 0) { return arr_get(cg_var_off, i); }
    return -1;
}

// ── Function / global / extern tables ───────────────────────
//
// Populated by bridge_data at codegen entry (one entry per
// function/global/extern the parser saw). The codegen walks these
// to find declaration metadata during emission.
//
//   cg_fn_name    packed function names
//   cg_fn_par     parameter-name arrays (one array per function)
//   cg_fn_pcnt    parameter counts
//   cg_fn_body    AST-root pointers
//   cg_fn_bcnt    body statement counts
//   cg_fn_fidx    parser func_cnt index (for type queries)
//   cg_gl_name    global-variable names
//   cg_ex_name    extern function names (FFI declarations)
//   cg_ex_ret     extern return-type packed strings
//   cg_ex_args    extern arg-type arrays
//   cg_ex_acnt    extern arg counts

global cg_fn_name, cg_fn_par, cg_fn_pcnt, cg_fn_body, cg_fn_bcnt, cg_fn_fidx;
global cg_gl_name;
global cg_ex_name, cg_ex_ret, cg_ex_args, cg_ex_acnt;

// Function-name → emitter-index hash, lazy-built on first
// `cg_find_fn` query and rebuilt when `cg_fn_name` grows past
// the last-seen length. Slot value is `idx + 1` so 0 doubles
// as the hash's "absent" sentinel. Mirrors the S2 dispatch
// hash (`_dsp_func_hash` in `src/bpp_dispatch.bsm`) — same
// lazy-build + stale-count rebuild pattern, scoped to cg's
// own function table.
//
// Why hash: pre-S3k, `cg_find_fn` linear-scanned every
// `cg_fn_name` entry per call, costing ~O(N·M) where N is the
// number of function names and M is the average packed-string
// compare. Bootstrap profile (`bench_compile.sh --sample`)
// pinned cg_find_fn at 7-11 samples + `cg_str_eq_packed` at
// 17-20 from the same call chain. Hashing reduces both —
// every fn lookup becomes O(1) average.
static auto _cg_fn_hash;          // hash_str: name → (idx + 1)
static auto _cg_fn_hash_count;    // arr_len(cg_fn_name) at last build; -1 = unbuilt

static void _cg_build_fn_hash() {
    auto i, name_p, n;
    if (_cg_fn_hash == 0) { _cg_fn_hash = hash_str_new(256); }
    hash_str_clear(_cg_fn_hash);
    n = arr_len(cg_fn_name);
    for (i = 0; i < n; i++) {
        name_p = arr_get(cg_fn_name, i);
        hash_str_set(_cg_fn_hash,
                     cg_sbuf + unpack_s(name_p), unpack_l(name_p),
                     i + 1);
    }
    _cg_fn_hash_count = n;
}

// Find a B++ function's emitter index by packed name.
// Returns -1 if not declared.
cg_find_fn(name_p) {
    auto v, n;
    n = arr_len(cg_fn_name);
    // Lazy build + stale-count rebuild. `bridge_data` populates
    // cg_fn_name in stages and later passes may push synth
    // entries onto the array (smart-dispatch's worker
    // synthesizer is the canonical case); comparing the cached
    // length against the live array length catches every growth
    // without exposing the hash boundary to callers.
    if (_cg_fn_hash_count != n) { _cg_build_fn_hash(); }
    v = hash_str_get(_cg_fn_hash,
                     cg_sbuf + unpack_s(name_p), unpack_l(name_p));
    if (v == 0) { return -1; }
    return v - 1;
}

// Find an extern declaration by packed name alone. Returns the
// first match; for multi-signature scenarios see cg_find_ext_by_argc.
cg_find_ext(name_p) {
    auto i; i = 0;
    while (i < arr_len(cg_ex_name)) {
        if (cg_str_eq_packed(name_p, arr_get(cg_ex_name, i))) { return i; }
        i++;
    }
    return -1;
}

// Find an extern declaration by packed name AND argument count.
// Allows multiple declarations of the same name with different
// signatures (`objc_msgSend` is the canonical example). Falls back
// to name-only match when no signature matches.
cg_find_ext_by_argc(name_p, argc) {
    auto i; i = 0;
    while (i < arr_len(cg_ex_name)) {
        if (cg_str_eq_packed(name_p, arr_get(cg_ex_name, i))) {
            if (arr_get(cg_ex_acnt, i) == argc) { return i; }
        }
        i++;
    }
    return cg_find_ext(name_p);
}

// Does extern `exi` return `double`?
cg_ext_ret_is_float(exi) {
    auto tp;
    tp = arr_get(cg_ex_ret, exi);
    return cg_str_eq(tp, "double", 6);
}

// ── B3: reference-count walk + eligibility ──────────────────
//
// Phase B3 promotes hot locals into registers across the function
// body. The work splits in three:
//   - cg_b3_eligible: pure portable check (excludes stack structs,
//     address-taken vars, floats, and sub-word slices).
//   - cg_b3_walk: recursive AST walker that tallies var_refs and
//     flags address-taken vars. Portable — no register choice.
//   - chip_b3_select (a64_b3_select / x64_b3_select): the one
//     chip-specific piece. Picks actual register numbers from the
//     host's callee-saved pool and records them in the chip's
//     promoted_regs list.

cg_b3_eligible(vi) {
    auto fty;
    if (arr_get(cg_var_stack, vi)) { return 0; }
    if (arr_get(cg_var_addr_taken, vi)) { return 0; }
    fty = arr_get(cg_var_forced_ty, vi);
    if (is_float_type(fty)) { return 0; }
    if (ty_slice(fty) != SL_FULL) { return 0; }
    return 1;
}

// F.2.c Stage 2: the float counterpart of cg_b3_eligible. A plain
// 64-bit `: float` local that is neither address-taken nor a stack
// struct can be promoted to a callee-saved d-register. Sub-word floats
// (`: half` / `: quarter`) and 128-bit `: double` keep their frame slots
// because their load / store widths differ. The chip's float B3 pass
// uses this; the compute-in-place emitter then reads the promoted
// register directly (cg_float_leaf_kind).
cg_b3_eligible_float(vi) {
    auto fty, sl;
    if (arr_get(cg_var_stack, vi)) { return 0; }
    if (arr_get(cg_var_addr_taken, vi)) { return 0; }
    fty = arr_get(cg_var_forced_ty, vi);
    if (is_float_type(fty) == 0) { return 0; }
    sl = ty_slice(fty);
    if (sl == SL_HALF) { return 0; }
    if (sl == SL_QUARTER) { return 0; }
    if (sl == SL_DOUBLE) { return 0; }
    return 1;
}

// Return the constant-table index of `val`, or -1 if not present.
cg_const_find(val) {
    auto i, n;
    n = arr_len(cg_const_val);
    for (i = 0; i < n; i++) {
        if (arr_get(cg_const_val, i) == val) { return i; }
    }
    return 0 - 1;
}

// Record one occurrence of an integer-literal leaf, loop-weighted. Only
// constants that cost a movz/movk chain (not a single mov) are tracked —
// a value fitting one mov saves nothing by living in a register. String
// and float literals are ignored.
cg_const_record(packed) {
    auto lit_s, val, idx, w;
    lit_s = unpack_s(packed);
    if (peek(cg_sbuf + lit_s) == '"') { return 0; }
    if (cg_is_float_lit(packed) == 1) { return 0; }
    val = cg_parse_int(packed);
    if (val >= 0 && val < 65536) { return 0; }
    w = 1;
    if (cg_b3_loop_depth > 0) { w = 1000; }
    idx = cg_const_find(val);
    if (idx >= 0) {
        arr_set(cg_const_wt, idx, arr_get(cg_const_wt, idx) + w);
        return 0;
    }
    cg_const_val = arr_push(cg_const_val, val);
    cg_const_wt = arr_push(cg_const_wt, w);
    cg_const_reg = arr_push(cg_const_reg, 0 - 1);
    return 0;
}

cg_b3_walk(nd) {
    auto n: Node, t, vi, child: Node, arr, cnt, i, w;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_VAR) {
        vi = cg_var_idx(n.a);
        // Stage 2b: weight a reference inside a loop far above a
        // straight-line one. A param or local used even ONCE per iteration
        // (e.g. an array base or the loop bound) is loop-invariant but
        // reloaded from the frame every pass; loop-weighting lifts it over
        // B3's promotion threshold so it lives in a register instead.
        if (vi >= 0) {
            w = 1;
            if (cg_b3_loop_depth > 0) { w = 1000; }
            arr_set(cg_var_refs, vi, arr_get(cg_var_refs, vi) + w);
        }
        return 0;
    }
    if (t == T_LIT) {
        cg_const_record(n.a);
        return 0;
    }
    if (t == T_ADDR) {
        child = n.a;
        if (child != 0 && child.ntype == T_VAR) {
            vi = cg_var_idx(child.a);
            if (vi >= 0) { arr_set(cg_var_addr_taken, vi, 1); }
            return 0;
        }
        cg_b3_walk(child);
        return 0;
    }
    switch (t) {
    T_BINOP    { cg_b3_walk(n.b); cg_b3_walk(n.c); }
    T_ASSIGN   { cg_b3_walk(n.a); cg_b3_walk(n.b); }
    T_MEMST    { cg_b3_walk(n.a); cg_b3_walk(n.b); }
    T_UNARY    { cg_b3_walk(n.b); }
    T_MEMLD    { cg_b3_walk(n.a); }
    T_RET      { cg_b3_walk(n.a); }
    T_TERNARY  { cg_b3_walk(n.a); cg_b3_walk(n.b); cg_b3_walk(n.c); }
    T_CALL {
        cg_fn_leaf = 0;                  // a call disqualifies the leaf budget
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_b3_walk(arr[i]); }
    }
    T_IF {
        cg_b3_walk(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_b3_walk(arr[i]); }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) { cg_b3_walk(arr[i]); }
        }
    }
    T_WHILE {
        cg_b3_loop_depth = cg_b3_loop_depth + 1;
        cg_b3_walk(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_b3_walk(arr[i]); }
        if (n.e != 0) { cg_b3_walk(n.e); }
        cg_b3_loop_depth = cg_b3_loop_depth - 1;
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_b3_walk(arr[i]); }
    }
    else { }
    }
}

// ── Switch-jump-table eligibility analysis ───────────────────
//
// Walks the arm values of a switch node and decides whether a
// dense jump-table lowering is worthwhile. Fills cg_sw_min /
// cg_sw_max / cg_sw_total as a side effect so the chip-specific
// emit_switch_jtbl can use them without re-scanning.
//
// Gate conditions:
//   - All arm values must be integer literals
//   - At least 3 distinct values (fewer → plain compare chain)
//   - Range ≤ 512 (keeps worst-case table ≤ 2 KB of code)
//   - Density ≥ 50% (range < 2 × total)
//
// ── Per-function + loop state ────────────────────────────────
//
// All portable state that survives a single function's emit pass:
// counters, literal pools, nested-loop tracking, current-function
// context. Reset per function (or per module for literal pools)
// by the chip codegen's init sequence.
//
//   cg_flt_tbl           float literal entries (dynamic array)
//   cg_str_tbl           string literal entries (dynamic array)
//   cg_lbl_cnt           monotonic label-ID counter
//   cg_depth             current nesting level (for scope tracking)
//   cg_break_stack       stack of break-target label IDs
//   cg_continue_stack    stack of continue-target label IDs
//   cg_cur_fn_name       packed name of the function being emitted
//   cg_cur_fn_idx        parser funcs[] index for type queries

global cg_flt_tbl;
global cg_str_tbl;
global cg_lbl_cnt, cg_depth;
global cg_break_stack;
global cg_continue_stack;
extrn cg_cur_fn_name, cg_cur_fn_idx;

// Phase 6.3 v2 — set by `cg_emit_func` per function based on
// whether the body contains `@profile("...") { ... }` blocks.
// Read by:
//   - `cg_emit_func` to decide whether to emit a `_prof_save_enter`
//     call right after the prologue.
//   - The chip primitives' `emit_frame_teardown` to decide whether
//     to wrap the epilogue convergence point with a `_prof_save_drain`
//     call (preserving the return value across the call).
// Non-profiled functions pay zero per-call overhead — the flag is
// 0 and both injection sites no-op.
global cg_cur_fn_has_profile;

// Packed refs for the v2 save/drain helpers, interned in the parser
// the first time a `@profile` block is seen and read here when
// synthesising the epilogue/prologue calls. Both stay 0 until any
// function in this compilation unit uses `@profile`.
extrn _zone_save_enter_p;
extrn _zone_save_drain_p;

// Allocate a fresh label ID. Monotonic across the whole codegen
// pass — each call returns a distinct integer.
cg_new_lbl() { auto l; l = cg_lbl_cnt; cg_lbl_cnt++; return l; }

// Inferred type code of a local variable. Looks up the slot's
// packed name in the parser's per-function type map.
cg_var_type(vi) {
    return get_fn_var_type(cg_cur_fn_idx, arr_get(cg_vars, vi));
}

// Is the variable at slot `vi` a float in the current function?
// Explicit integer type hints (: word / byte / half / quarter)
// override float inference — the programmer's annotation wins.
cg_var_is_float(vi) {
    auto fty;
    fty = arr_get(cg_var_forced_ty, vi);
    if (fty > 0) {
        return is_float_type(fty);
    }
    return is_float_type(cg_var_type(vi));
}

// The explicit type hint for the j-th variable of a T_DECL.
//
// The parser records ONE hint per declared name in `n.e` (an array parallel
// to the name list `n.a`); `n.c` holds only the LAST hint seen on the
// declaration line. Stamping `n.c` onto every name floods the statement — a
// `: float` on one name would force the rest to float (pointer arithmetic
// through doubles -> crash) and a `: byte` would silently narrow them. So
// read the per-name array; fall back to `n.c` only when there is no array
// (`n.e == 0` means the declaration carried no hints at all, so `n.c` is 0
// too). The array is shared by value through `ast_clone_subst`, so inlined
// callee declarations resolve correctly as well.
cg_decl_var_hint(n: Node, j) {
    if (n.e != 0) { return arr_get(n.e, j); }
    return n.c;
}

// ── Bridge: parser state → codegen state ────────────────────
//
// Called once at codegen entry. Copies the parser's function /
// global / extern records into the cg_* parallel arrays that the
// rest of the codegen consumes. Handles forward-declaration
// overwrite (a function seen as `import` gets its body filled in
// later when the real definition is encountered) and global
// deduplication (the same name from different modules folds to
// one slot).
//
// The parser's dense record format (FN_NAME, FN_PARS, etc. in
// bpp_defs.bsm) is decoded here so the codegen can walk the
// arrays without knowing the record layout. When the parser
// changes its record shape, only this function needs updating.
void cg_bridge_data() {
    auto i, rec, name_p, idx, j;
    cg_sbuf = vbuf;

    // Functions — copy reachable, dedup against forward decls.
    arr_clear(cg_fn_name); arr_clear(cg_fn_par); arr_clear(cg_fn_pcnt);
    arr_clear(cg_fn_body); arr_clear(cg_fn_bcnt); arr_clear(cg_fn_fidx);
    i = 0;
    while (i < func_cnt) {
        // Lazy emit: skip functions not reachable from main.
        if (_lazy_emit_ready) {
            if (arr_get(fn_reachable, i) == 0) { i++; continue; }
        }
        rec = *(funcs + i * 8);
        name_p = *(rec + FN_NAME);
        idx = -1;
        j = 0;
        while (j < arr_len(cg_fn_name)) {
            if (cg_str_eq_packed(name_p, arr_get(cg_fn_name, j))) { idx = j; }
            j++;
        }
        if (idx < 0) {
            idx = arr_len(cg_fn_name);
            cg_fn_name = arr_push(cg_fn_name, name_p);
            cg_fn_par  = arr_push(cg_fn_par,  *(rec + FN_PARS));
            cg_fn_pcnt = arr_push(cg_fn_pcnt, *(rec + FN_PCNT));
            cg_fn_body = arr_push(cg_fn_body, *(rec + FN_BODY));
            cg_fn_bcnt = arr_push(cg_fn_bcnt, *(rec + FN_BCNT));
            cg_fn_fidx = arr_push(cg_fn_fidx, i);
        } else {
            // Forward declaration overwrite.
            arr_set(cg_fn_name, idx, name_p);
            arr_set(cg_fn_par,  idx, *(rec + FN_PARS));
            arr_set(cg_fn_pcnt, idx, *(rec + FN_PCNT));
            arr_set(cg_fn_body, idx, *(rec + FN_BODY));
            arr_set(cg_fn_bcnt, idx, *(rec + FN_BCNT));
            arr_set(cg_fn_fidx, idx, i);
        }
        i++;
    }

    // Globals — dedup by name; each unique name gets one data slot.
    arr_clear(cg_gl_name);
    i = 0;
    while (i < glob_cnt) {
        name_p = *(globals + i * 8);
        idx = -1;
        j = 0;
        while (j < arr_len(cg_gl_name)) {
            if (cg_str_eq_packed(name_p, arr_get(cg_gl_name, j))) { idx = j; }
            j++;
        }
        if (idx < 0) {
            cg_gl_name = arr_push(cg_gl_name, name_p);
        }
        i++;
    }

    // Externs — FFI declarations. No dedup (multiple signatures
    // with the same name are legal; the codegen picks by argc).
    arr_clear(cg_ex_name); arr_clear(cg_ex_ret);
    arr_clear(cg_ex_args); arr_clear(cg_ex_acnt);
    i = 0;
    while (i < ext_cnt) {
        rec = *(externs + i * 8);
        cg_ex_name = arr_push(cg_ex_name, *(rec + EX_NAME));
        cg_ex_ret  = arr_push(cg_ex_ret,  *(rec + EX_RET));
        cg_ex_args = arr_push(cg_ex_args, *(rec + EX_ARGS));
        cg_ex_acnt = arr_push(cg_ex_acnt, *(rec + EX_ACNT));
        i++;
    }
}

// ── Hidden argc/argv/envp symbols ────────────────────────────
//
// brt0 declares three globals (_bpp_argc/argv/envp) that main()'s
// prologue fills in and argc_get/argv_get/envp_get read back out.
// The codegen needs the packed-name pointers to emit relocations
// against those slots. Shared across chips because the names come
// from the parser's globals array, which is chip-agnostic.

global cg_argc_sym, cg_argv_sym, cg_envp_sym;

// Scan the parser's globals table for the three brt0-declared
// names and record their packed pointers. Called once after
// cg_bridge_data() during the codegen init sequence.
void cg_bind_startup_syms() {
    auto i, name_p;
    for (i = 0; i < glob_cnt; i++) {
        name_p = *(globals + i * 8);
        switch {
            cg_str_eq(name_p, "_bpp_argc", 9) { cg_argc_sym = name_p; }
            cg_str_eq(name_p, "_bpp_argv", 9) { cg_argv_sym = name_p; }
            cg_str_eq(name_p, "_bpp_envp", 9) { cg_envp_sym = name_p; }
            else { }
        }
    }
}

// Returns 1 if the switch qualifies, 0 otherwise.
cg_switch_is_dense(sw_arms, sw_cnt) {
    auto si, sk, sv_arr, sv_cnt, val, first, range;
    auto node: Node;
    first = 1;
    cg_sw_min = 0;
    cg_sw_max = 0;
    cg_sw_total = 0;
    for (si = 0; si < sw_cnt; si++) {
        sv_arr = sw_arms[si * 2];
        sv_cnt = sw_arms[si * 2 + 1];
        for (sk = 0; sk < sv_cnt; sk++) {
            node = sv_arr[sk];
            if (node.ntype != T_LIT) { return 0; }
            val = cg_parse_int(node.a);
            if (first) {
                cg_sw_min = val;
                cg_sw_max = val;
                first = 0;
            } else {
                if (val < cg_sw_min) { cg_sw_min = val; }
                if (val > cg_sw_max) { cg_sw_max = val; }
            }
            cg_sw_total++;
        }
    }
    if (cg_sw_total < 3) { return 0; }
    range = cg_sw_max - cg_sw_min;
    if (range < 0) { return 0; }
    if (range > 512) { return 0; }
    if (range >= 2 * cg_sw_total) { return 0; }
    return 1;
}

// ── Phase 3.4 Wave 9b step A.3: cg_emit_call ────────────────
//
// Portable T_CALL orchestrator. Fat-primitive dispatch: the
// chip's extracted emit_call helper (_a64_emit_call /
// _x64_emit_call) stays authoritative for the full call
// sequence — builtins + B2 inline splice + push-then-pop
// arg marshalling + FFI reg rearrangement + relocation
// emission — all in one chip-local helper. The spine's job
// here is just to route T_CALL through cg_prim so the
// production path is "spine dispatches, chip implements"
// uniformly with every other AST case.
//
// Future decomposition: break emit_call_full into finer
// primitives (arg_reg_int, emit_push_arg_int, etc. already
// reserved in the contract) so spine owns the ABI schedule
// and each chip implements its own alloc rules. That's a
// separate session with its own byte-identity gate.

// Wave 18 — inline builtin dispatch in the spine.
//
// Called from cg_emit_call before the chip's fat emit_call_full
// fallthrough. If the node's name matches a lifted builtin, spine
// handles argument evaluation + push/pop + coerce + final primitive
// emission, and returns 1 to signal "handled". If no match, returns
// 0 and cg_emit_call falls through to the chip's emit_call_full
// (which still owns the ~42 builtins not yet lifted).
//
// Each lifted builtin follows the recipe in Cap 23 (Battalions):
// spine evaluates args via cg_emit_node, coerces float to int via
// cg_prim.emit_coerce_float_to_int when the arg was float-valued,
// optionally orchestrates push/pop for multi-arg patterns, then
// calls the chip primitive (emit_mem_read, emit_mem_write,
// emit_syscall, etc.) for the ISA-specific final instruction.
//
// C emitter target: this function is not reached during C
// emission. C code goes through bpp_emitter.bsm's own emit_node
// path, which keeps its own 43-branch ladder until a separate
// future session unifies the C emitter pattern.
cg_builtin_dispatch(n) {
    auto p: ChipPrimitives, arr, ety;
    p = cg_prim;

    // Built-in: peek(addr) — load one byte from [addr].
    // Spine-lifted (Wave 18). See Cap 23 recipe §"peek as worked
    // example" for the step-by-step.
    if (cg_str_eq(n.a, "peek", 4)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_mem_read, 1);
        return 1;
    }

    // Excalibur Feature 2 — explicit float→int conversion builtins.
    // Each evaluates its arg as float, then lowers to a chip-specific
    // rounding+cast pair. Returning ety=0 (int) so the caller treats
    // the result as a normal integer accumulator value. The dispatch
    // returns ety+1 (so r=1 for ety=0) per cg_emit_call's contract.
    //
    // floor_int(x: float) — round toward minus infinity, then cast.
    // ARM: FRINTM + FCVTZS. x86: ROUNDSD imm=01 + CVTTSD2SI.
    if (cg_str_eq(n.a, "floor_int", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 0) { call(p.emit_coerce_int_to_float); }
        call(p.emit_floor_to_int);
        return 1;
    }
    // trunc_int(x: float) — truncate toward zero, then cast. Reuses
    // the existing emit_coerce_float_to_int primitive (FCVTZS / CVTTSD2SI
    // are already round-toward-zero), but the named builtin makes the
    // intent explicit at the call site instead of leaking it through
    // an implicit cast.
    if (cg_str_eq(n.a, "trunc_int", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 0) { call(p.emit_coerce_int_to_float); }
        call(p.emit_coerce_float_to_int);
        return 1;
    }
    // round_int(x: float) — round to nearest, ties to even, then cast.
    // ARM: FRINTN + FCVTZS. x86: CVTSD2SI (uses MXCSR, default = nearest).
    if (cg_str_eq(n.a, "round_int", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 0) { call(p.emit_coerce_int_to_float); }
        call(p.emit_round_to_int);
        return 1;
    }

    // Built-in: poke(addr, val) — store one byte at [addr].
    // Eval order: val → push → addr → pop val into scratch (x1/rcx) → store.
    // Same sequence as the chip ladders preserved verbatim.
    if (cg_str_eq(n.a, "poke", 4)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // val
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));  // addr
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);
        call(p.emit_mem_write, 1, 1);          // val_reg=1 (scratch) width=1
        return 1;
    }

    // Built-in: peek_q(addr) — load 2 bytes (quarter-word, 16-bit) from [addr].
    // Emits LDRH (ARM64) / MOVZX ax, word [ptr] (x86_64). Zero-extends to 64-bit.
    if (cg_str_eq(n.a, "peek_q", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_mem_read, 2);
        return 1;
    }

    // Built-in: peek_h(addr) — load 4 bytes (half-word, 32-bit) from [addr].
    // Emits LDR W (ARM64) / MOV eax, [ptr] (x86_64). Zero-extends to 64-bit.
    if (cg_str_eq(n.a, "peek_h", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_mem_read, 4);
        return 1;
    }

    // Built-in: peek_w(addr) — load 8 bytes (word, 64-bit) from [addr].
    // Emits LDR X (ARM64) / MOV rax, [ptr] (x86_64).
    if (cg_str_eq(n.a, "peek_w", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_mem_read, 8);
        return 1;
    }

    // Built-in: poke_q(addr, val) — store 2 bytes (quarter-word, 16-bit) at [addr].
    // Emits STRH (ARM64). Only the low 16 bits of val are written.
    if (cg_str_eq(n.a, "poke_q", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // val
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));  // addr
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);
        call(p.emit_mem_write, 1, 2);
        return 1;
    }

    // Built-in: poke_h(addr, val) — store 4 bytes (half-word, 32-bit) at [addr].
    // Emits STR W (ARM64). Only the low 32 bits of val are written.
    if (cg_str_eq(n.a, "poke_h", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // val
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));  // addr
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);
        call(p.emit_mem_write, 1, 4);
        return 1;
    }

    // Built-in: poke_w(addr, val) — store 8 bytes (word, 64-bit) at [addr].
    // Emits STR X (ARM64).
    if (cg_str_eq(n.a, "poke_w", 6)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // val
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));  // addr
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);
        call(p.emit_mem_write, 1, 8);
        return 1;
    }

    // Built-in: pokefloat(addr, val) — store 64-bit float (double) at [addr].
    // val must evaluate as float. Emits STR D (ARM64) / MOVSD [rax] (x86_64).
    if (cg_str_eq(n.a, "pokefloat", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));   // val → d0/xmm0
        if (ety == 0) { call(p.emit_coerce_int_to_float); }
        call(p.emit_fpush, 0);
        ety = call(p.emit_node, *(arr + 0));   // addr → x0/rax
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_fpop, 1);
        call(p.emit_float_store_scalar, SL_FULL, 1);
        return 1;
    }

    // Built-in: pokefloat_h(addr, val) — store 32-bit float (half float) at [addr].
    // ARM64: FCVT s1, d1 + STR S (correct). x86_64: bitcast limitation (stores
    // 64-bit double bits, not 32-bit float bits). Fix when cvtsd2ss is available.
    if (cg_str_eq(n.a, "pokefloat_h", 11)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));   // val → d0/xmm0
        if (ety == 0) { call(p.emit_coerce_int_to_float); }
        call(p.emit_fpush, 0);
        ety = call(p.emit_node, *(arr + 0));   // addr → x0/rax
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_fpop, 1);
        call(p.emit_float_store_scalar, SL_HALF, 1);
        return 1;
    }

    // Built-in: peekfloat(addr) — load 8 bytes as 64-bit float (double) from [addr].
    // Emits LDR D (ARM64) / MOVSD xmm0, [ptr] (x86_64). Result in float reg (d0/xmm0).
    // Native-endian (LE). For BE float data, load with peek_w and reinterpret bits.
    if (cg_str_eq(n.a, "peekfloat", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        cg_addr_const_off = 0; cg_addr_const_base = -1;
        return call(p.emit_memld_load, TY_FLOAT) + 1;    // +1: ety (0=int,1=float) → dispatch ret (1=int,2=float)
    }

    // Built-in: peekfloat_h(addr) — load 4 bytes as 32-bit float (half float) from [addr].
    // Emits LDR S + FCVT D (ARM64) — loads single, widens to double in d0.
    // x86_64: MOVSS xmm0 + CVTSS2SD. Result in float reg.
    // Native-endian (LE). For BE float data, load with peek_h, apply byteswap, then cast.
    if (cg_str_eq(n.a, "peekfloat_h", 11)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        cg_addr_const_off = 0; cg_addr_const_base = -1;
        return call(p.emit_memld_load, TY_FLOAT_H) + 1;  // +1: same ety→dispatch convention
    }

    // Built-in: str_peek(s, i) — byte at s[i]. Same semantic as
    // peek(s + i) but carries the pure-effect annotation the smart
    // dispatcher uses for parallel-for eligibility.
    // Eval: idx → push → base → pop idx into scratch → indexed read.
    if (cg_str_eq(n.a, "str_peek", 8)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // idx
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));  // base
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);
        call(p.emit_mem_read_indexed, 1);
        return 1;
    }

    // Built-in: arr_get(arr, i) — element i of an arr_new array
    // (or any 8-byte-element word buffer). Body is the trivial
    // `*(arr + i * 8)` — see `arr_get` in `bpp_array.bsm`. Hot-path
    // opt S3e (sidequest: arc 1): promotes the most-called wrapper
    // in the language to a Tier 1 builtin so the call frame
    // disappears and the load goes through the chip's indexed-
    // addressing primitive.
    //
    // Eval order — produces `acc = arr`, `scratch = i * 8`, then
    // `emit_mem_read_indexed(8)` does `acc = peek_w(acc + scratch)`:
    //   1. emit_node(i)       → acc = i
    //   2. push_acc           → stack = [i]
    //   3. mov_imm(8)         → acc = 8                (element size)
    //   4. pop_scratch        → scratch = i
    //   5. emit_mul(1)        → acc = i * 8 = byte_offset  (== i << 3)
    //   6. push_acc           → stack = [byte_offset]
    //   7. emit_node(arr)     → acc = arr              (base, re-eval AST)
    //   8. pop_scratch        → scratch = byte_offset
    //   9. mem_read_indexed(8)→ acc = *(acc + scratch) = arr[i]
    //
    // Byte offset via `i * 8`, not `i << 3`: emit_shl's operand order is
    // chip-specific (a64 does scratch<<acc via left_reg; x64 pins the value
    // to rax and shifts by cl, so the same manual arrangement yields `3 << i`
    // on x64 -- the exact crash arr_len hit). Multiplication commutes, so
    // `i * 8` lands correctly on both chips regardless of which operand each
    // parks in acc vs scratch, and equals i << 3 for any array index.
    //
    // Total: 9 spine calls vs the prior ~14-instr function-call
    // frame. The chip primitive uses ARM64's native register-offset
    // LDR (`LDR x0, [x0, x1]`) so the indexed load is a single
    // instruction on a64; x64 keeps its `add+load` shape since SIB
    // scaling here would require a new encoder. Future ports
    // implement `_emit_mem_read_indexed(8)` once and inherit fast
    // `arr_get`.
    if (cg_str_eq(n.a, "arr_get", 7)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));  // i (second arg)
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);                // stack = [i]
        call(p.emit_mov_imm, 8);              // acc = 8 (element size)
        call(p.emit_pop_scratch);             // scratch = i
        call(p.emit_mul, 1);                  // acc = i * 8 = byte offset (== i << 3)
        call(p.emit_push_acc);                // stack = [byte_offset]
        ety = call(p.emit_node, *(arr + 0));  // arr (base, re-eval AST)
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_pop_scratch);             // scratch = byte_offset
        call(p.emit_mem_read_indexed, 8);     // acc = *(acc + scratch)
        return 1;
    }

    // Built-in: sha_rotr(x, n) — 32-bit rotate right of the low
    // 32 bits of `x` by `n` bits, zero-extended. Body in
    // `src/backend/target/aarch64_macos/a64_macho.bsm:115` is
    // `return u32((x >> n) | ((x & 0xFFFFFFFF) << (32 - n)));` —
    // the canonical SHA-256 rotate idiom assembled out of two
    // shifts + an or + a mask. ARM64 + x86_64 both ship a single
    // instruction for this exact operation (RORV W on a64,
    // ROR r32 cl on x64); the new `emit_ror32` chip primitive
    // exposes it portably. S3j hot-path opt (~16 samples per
    // bootstrap run dominated by SHA-256 code signing — the
    // function runs a few thousand iterations per binary signed,
    // and each call paid a ~14-instruction frame around what is
    // now a 1-instruction body).
    //
    // Sequence — mirrors the `unpack_l` shape (value-in-acc,
    // count-in-scratch) so the chip primitive reads the same on
    // both backends:
    //   1. emit_node(n)       → acc = n        (count, RHS)
    //   2. push_acc           → stack = [n]
    //   3. emit_node(x)       → acc = x        (value, LHS)
    //   4. pop_scratch        → scratch = n
    //   5. emit_ror32         → acc = (x & 0xFFFFFFFF) ROR (n & 31)
    if (cg_str_eq(n.a, "sha_rotr", 8)) {
        arr = n.b;
        call(p.emit_node, *(arr + 8));   // n (count)
        call(p.emit_push_acc);
        call(p.emit_node, *(arr + 0));   // x (value)
        call(p.emit_pop_scratch);
        call(p.emit_ror32);
        return 1;
    }

    // Built-in: u32(x) — mask the low 32 bits of `x`. Body in
    // `src/backend/target/aarch64_macos/a64_macho.bsm:112` is
    // `return x & 0xFFFFFFFF;` — bit-for-bit equivalent to
    // unpack_s (the `% 0x100000000` form lowers to the same AND
    // through the int-only const-eval path), so the dispatch
    // reuses the unpack_s primitive sequence verbatim. Hot-path
    // opt S3h (sidequest arc): SHA-256 code-signing on the Mach-O
    // target calls u32 inside a tight per-block transform; the
    // sample(1) hot-list shows ~13 samples per bootstrap run
    // dominated by the call frame around a single AND. Lifting
    // it to the builtin lane removes ~9 instructions from each
    // call site (11 sites total, but most are in inner SHA loops
    // that run thousands of iterations per binary signed).
    if (cg_str_eq(n.a, "u32", 3)) {
        arr = n.b;
        call(p.emit_node, *(arr + 0));   // x
        call(p.emit_push_acc);
        call(p.emit_mov_imm, 0xFFFFFFFF);
        call(p.emit_pop_scratch);
        call(p.emit_and, 1);
        return 1;
    }

    // Built-in: arr_len(arr) — length field of an arr_new array
    // (or 0 for a null pointer). Body is the null-guarded
    // `*(arr - 16)` — see `arr_len` in `bpp_array.bsm`. Hot-path
    // opt S3f: builds on S3e by reusing the just-completed
    // emit_mem_read_indexed primitive matrix plus the existing
    // emit_branch_if_zero control-flow primitive. No new chip
    // ABI member — the dispatch shape "early-return guard inside
    // a builtin" generalises for any future accessor that wraps a
    // single load behind a null check (arr_cap, arr_last, etc).
    //
    // Sequence — produces `acc = arr-len-or-zero` via a single
    // conditional branch:
    //   1. emit_node(arr)         → acc = arr
    //   2. lbl = emit_new_label
    //   3. emit_branch_if_zero(lbl) → if acc == 0 jump (acc stays 0)
    //   4. push_acc               → stack = [arr]
    //   5. mov_imm(16)            → acc = 16
    //   6. emit_neg               → acc = -16
    //   7. pop_scratch            → scratch = arr
    //   8. emit_add(1)            → acc = arr + (-16) = arr - 16
    //   9. emit_mem_read(8)       → acc = *(arr - 16)
    //  10. emit_label(lbl)
    //
    // Why add-of-negative instead of a straight subtract: emit_sub's
    // operand order is chip-specific. On a64 the contract is
    // `acc = reg[left_reg] - acc` (LHS in left_reg), but on x64 the
    // LHS is pinned to rax and `emit_sub` ignores left_reg, emitting
    // `acc = acc - scratch`. A manual subtract dance therefore cannot
    // be written once for both chips (subtraction does not commute),
    // and the prior `emit_sub(1)` form silently computed `16 - arr` on
    // x64 -- a wild pointer that crashed the cross-compiled compiler in
    // `was_imported` the moment it ran. emit_add DOES commute, so
    // `arr + (-16)` lands as `arr - 16` regardless of which operand
    // each chip parks in acc vs scratch.
    //
    // Inline cost ≈ 6 instructions on a64 (cbz/str/movz/ldr/sub/
    // ldr) + 2 stack ops, vs the prior ~14-instr call frame around
    // a 4-instr body. ~50 % shrink at every call site. The C
    // emitter does not need a symmetric case — the original
    // `arr_len` B++ function still compiles to C and the C
    // compiler inlines the trivial body verbatim.
    if (cg_str_eq(n.a, "arr_len", 7)) {
        auto lbl_end;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));   // arr
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        lbl_end = call(p.emit_new_label);
        call(p.emit_branch_if_zero, lbl_end);  // if arr == 0 → acc=0, jump
        call(p.emit_push_acc);                 // stack = [arr]
        call(p.emit_mov_imm, 16);              // acc = 16
        call(p.emit_neg);                      // acc = -16
        call(p.emit_pop_scratch);              // scratch = arr
        call(p.emit_add, 1);                   // acc = arr + (-16) = arr - 16
        call(p.emit_mem_read, 8);              // acc = *(arr - 16)
        call(p.emit_label, lbl_end);
        return 1;
    }

    // Built-in: mem_barrier() — full memory barrier + zero acc.
    // Used by stbjob to order producer/consumer writes on SPSC
    // queues. 0 args.
    if (cg_str_eq(n.a, "mem_barrier", 11)) {
        call(p.emit_mem_barrier);
        return 1;
    }

    // Built-in: caller_pc(n) — PC at depth n on the FP chain.
    // n == 0 returns the current PC (a PC inside the calling
    // function); n >= 1 walks (n-1) frames up and returns that
    // frame's saved return address. Pairs with the regular
    // B++ function `caller_name(pc)` defined in bpp_runtime.bsm
    // so callers can render their own backtraces without the
    // runtime observer. Phase 6.2c — see _a64_emit_caller_pc /
    // _x64_emit_caller_pc for the inlined FP walk shape.
    if (cg_str_eq(n.a, "caller_pc", 9)) {
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_caller_pc);
        return 1;
    }

    // Built-in: shr(value, shift) — logical right shift (unsigned,
    // fills with zeros). Distinct from `>>` operator which is
    // arithmetic (sign-extending). Spine preserves the chip's
    // eval order: shift → push → value → pop shift into scratch → lsr.
    if (cg_str_eq(n.a, "shr", 3)) {
        arr = n.b;
        call(p.emit_node, *(arr + 8));   // shift amount
        call(p.emit_push_acc);
        call(p.emit_node, *(arr + 0));   // value
        call(p.emit_pop_scratch);
        call(p.emit_shift_right_logical);
        return 1;
    }

    // Built-in: unpack_l(p) — extract the upper 32 bits of a packed
    // string ref. Equivalent to `shr(p, 32)` but with the shift
    // count hardcoded so the spine can skip the second emit_node
    // pass. Hot-path opt sidequest (S3b): unpack_l shows ~20% of
    // bootstrap CPU in `bench_compile.sh --sample`; lifting it into
    // the builtin lane swaps a ~14-instruction function-call frame
    // for the 5 inline ops below.
    //
    // Sequence (same shape as `shr` but with the constant baked in):
    //   1. mov_imm(32) → acc = 32
    //   2. push_acc    → stack = [32]
    //   3. emit_node(p) → acc = p
    //   4. pop_scratch → scratch = 32
    //   5. shift_right_logical → acc = p >>u 32  (LSR on ARM64,
    //                                              SHR on x86_64)
    if (cg_str_eq(n.a, "unpack_l", 8)) {
        arr = n.b;
        call(p.emit_mov_imm, 32);
        call(p.emit_push_acc);
        call(p.emit_node, *(arr + 0));   // p (the packed ref)
        call(p.emit_pop_scratch);
        call(p.emit_shift_right_logical);
        return 1;
    }

    // Built-in: unpack_s(p) — extract the lower 32 bits of a packed
    // string ref. Equivalent to `p & 0xFFFFFFFF`. Hot-path opt
    // sidequest (S3c) — unpack_s is called inside packed_eq +
    // cg_str_eq_packed (each twice per invocation post-S3a CSE)
    // + many other lookup sites; the call frame around the trivial
    // AND was the cost.
    //
    // BINOP convention (chip primitive `emit_and(left_reg)`
    // expects right operand in acc / x0, left operand in
    // `left_reg`, emits `acc = left_reg & acc`):
    //   1. emit_node(p)    → acc = p (LHS)
    //   2. push_acc        → stack = [p]
    //   3. mov_imm(0xFFFFFFFF) → acc = mask (RHS)
    //   4. pop_scratch     → scratch (x1 / rcx) = p
    //   5. emit_and(1)     → acc = scratch & acc = p & mask
    if (cg_str_eq(n.a, "unpack_s", 8)) {
        arr = n.b;
        call(p.emit_node, *(arr + 0));   // p (the packed ref, LHS)
        call(p.emit_push_acc);
        call(p.emit_mov_imm, 0xFFFFFFFF); // mask (RHS) in acc
        call(p.emit_pop_scratch);        // p restored into scratch
        call(p.emit_and, 1);             // acc = (scratch) & acc
        return 1;
    }

    // Built-in: float_ret() / float_ret2() — read the saved float
    // return value from the frame slot set after an extern call.
    // Return 2 means "handled and result is float (ety=1)" — chip
    // branches returned 1 inline; spine needs a way to signal
    // that plus handled. Use return value 2 → cg_emit_call treats
    // anything truthy as handled and maps to ety=1 for floats.
    if (cg_str_eq(n.a, "float_ret", 9)) {
        call(p.emit_load_float_ret, 0);
        return 2;   // handled, float ety
    }
    if (cg_str_eq(n.a, "float_ret2", 10)) {
        call(p.emit_load_float_ret, 1);
        return 2;
    }

    // Built-in: assert(cond) — trap if cond is zero. The spine
    // evaluates cond through the chip's tree walker, coerces
    // float-valued conds back to integer (so d0/xmm0 conds still
    // route through the shared cbnz/test path), then hands off
    // the trap-and-label stanza to the chip's primitive.
    if (cg_str_eq(n.a, "assert", 6)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_trap_if_zero);
        return 1;
    }

    // argc_get / argv_get / envp_get used to dispatch here as
    // inline builtins reading the chip-saved runtime globals.
    // Migrated 2026-05-13 to plain B++ source functions in
    // src/bpp_args.bsm — the chip-specific SAVE side (storing
    // x0/x1/x2 to the globals at main()'s prologue) stays, only
    // the READ side moved to source. See docs/builtin_to_source_plan.md
    // for the rationale.

    // Built-in: sys_exit(code) — terminate the process. One argument
    // (the exit code) evaluated into the accumulator, no extra reg
    // slot, no error-normalisation (the kernel never returns). This
    // is Wave 18's first real syscall lift — validates the complete
    // Plan B path (CG_SYS enum → chip-local BSYS mapping → trap).
    if (cg_str_eq(n.a, "sys_exit", 8)) {
        auto arr;
        arr = n.b;
        call(p.emit_node, *(arr + 0));
        call(p.emit_syscall, CG_SYS_EXIT, 1, -1, 0);
        return 1;
    }

    // Built-in: sys_close(fd) — release a file descriptor. 1 arg,
    // returns -errno convention so the chip runs norm_err after.
    if (cg_str_eq(n.a, "sys_close", 9)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_CLOSE, 1, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_read(fd, buf, len) — read bytes from fd into buf.
    // 3 args. Evaluation order: args 2 and 1 pushed in reverse, arg 0
    // evaluated into the accumulator; the primitive pops args 1 and 2
    // back into the syscall register file on its way to the trap.
    if (cg_str_eq(n.a, "sys_read", 8)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_READ, 3, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_write(fd, buf, len) — write bytes from buf to fd.
    // Same shape as sys_read: 3 args, push-reverse-eval-last-in-acc,
    // primitive pops, traps, and the spine runs norm_err afterwards.
    if (cg_str_eq(n.a, "sys_write", 9)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_WRITE, 3, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_open(path, flags) — open a file and return fd.
    // 2 args in the B++ surface but the kernel syscall expects a mode
    // in the third slot (aarch64 x2 / x86_64 rdx). Hard-coded to 493
    // (0o755) to match the pre-lift chip behaviour verbatim; callers
    // who need a different mode stay on the chip-local special case
    // or open(2) via FFI.
    if (cg_str_eq(n.a, "sys_open", 8)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_OPEN, 2, 2, 493);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_stat(path, statbuf) — fill a struct-stat buffer. 2 args,
    // same eval shape as sys_open (push arg 2, eval arg 1 into acc). Returns
    // 0 on success, negative errno on failure. file_stat (bpp_file.bsm) wraps
    // this to read size / mtime / is_dir without touching file contents; the
    // per-OS struct-stat field offsets live in _core_<os>.bsm's _file_stat.
    if (cg_str_eq(n.a, "sys_stat", 8)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_STAT, 2, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_unlink(path) — remove a filesystem entry. 1 arg.
    if (cg_str_eq(n.a, "sys_unlink", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_UNLINK, 1, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_mkdir(path, mode) — create a directory. 2 args.
    if (cg_str_eq(n.a, "sys_mkdir", 9)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_MKDIR, 2, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_fchmod(fd, mode) — change file permissions on fd. 2 args.
    if (cg_str_eq(n.a, "sys_fchmod", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_FCHMOD, 2, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_munmap(addr, len) — release a mapping. 2 args.
    if (cg_str_eq(n.a, "sys_munmap", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_MUNMAP, 2, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: fn_ptr(name) — load the address of a B++ function.
    // Spine resolves the name to its table index (portable logic);
    // the chip primitive emits the ADR / LEA-RIP that computes the
    // runtime address. Validate runs first so the name is guaranteed
    // to exist; cg_find_fn returning -1 is therefore an internal bug.
    if (cg_str_eq(n.a, "fn_ptr", 6)) {
        auto arr, fn_name: Node, fi;
        arr = n.b;
        fn_name = *(arr + 0);
        fi = cg_find_fn(fn_name.a);
        if (fi < 0) {
            diag_str("internal error: fn_ptr target not found after validate\n");
            sys_exit(2);
        }
        call(p.emit_fn_ptr, fi);
        return 1;
    }

    // sys_lseek and sys_getdents stay chip-local: the x86_64 branch
    // evaluates arguments in forward order (arg 0 first pushed, arg 2
    // last into rax then moved to rdx) rather than the reverse-eval
    // convention every other syscall uses. Lifting them through the
    // standard spine pattern would emit different byte sequences and
    // break the self-host byte-identity check. A future cleanup pass
    // can normalise the chip-local order and re-lift uniformly.

    // Built-in: sys_socket(domain, type, protocol) — create a socket. 3 args.
    if (cg_str_eq(n.a, "sys_socket", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_SOCKET, 3, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_connect(fd, addr, addrlen) — connect a socket. 3 args.
    if (cg_str_eq(n.a, "sys_connect", 11)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_CONNECT, 3, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_wait4(pid, status, options, rusage) — wait for child. 4 args.
    if (cg_str_eq(n.a, "sys_wait4", 9)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 24));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_WAIT4, 4, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_ptrace(request, pid, addr, data) — trace a process. 4 args.
    if (cg_str_eq(n.a, "sys_ptrace", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 24));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_PTRACE, 4, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Built-in: sys_mmap(addr, len, prot, flags, fd, offset) — 6 args.
    // Skips emit_syscall_norm_err because high pointer addresses look
    // like negative numbers and csneg would corrupt them. Callers
    // check for MAP_FAILED (-1) directly if error-handling matters.
    if (cg_str_eq(n.a, "sys_mmap", 8)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 40));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 32));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 24));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_MMAP, 6, -1, 0);
        return 1;
    }

    // Built-in: sys_select(nfds, rfds, wfds, efds, tv) — wait for
    // file descriptors to become ready. 5 args. Returns the number
    // of ready descriptors, 0 on timeout, -1 on error. Used by the
    // bug debugger's async observer to peek the GDB socket without
    // blocking the GUI frame loop: select(nfds, &rfds, 0, 0, &{0,0})
    // polls instantly and reports whether the next read can proceed.
    if (cg_str_eq(n.a, "sys_select", 10)) {
        auto arr, ety;
        arr = n.b;
        ety = call(p.emit_node, *(arr + 32));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 24));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 16));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 8));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_push_acc);
        ety = call(p.emit_node, *(arr + 0));
        if (ety == 1) { call(p.emit_coerce_float_to_int); }
        call(p.emit_syscall, CG_SYS_SELECT, 5, -1, 0);
        call(p.emit_syscall_norm_err);
        return 1;
    }

    // Wave 18 syscall lifts: reverted. The BSYS_* constants
    // collide between _bsys_macos.bsm and _bsys_linux.bsm (every
    // shared name has a different number per OS), so the spine
    // cannot reference BSYS_* without disambiguating at the chip
    // level. Keeping syscall dispatch chip-local until a proper
    // portable syscall ID enum is introduced.
    return 0;
}

cg_emit_call(n) {
    auto p: ChipPrimitives, r;
    // cg_builtin_dispatch returns 0 (not handled, fall through) or
    // ety+1 (handled, caller's result ety is r - 1). Lets float-
    // returning builtins (float_ret) report ety=1 while int-
    // returning builtins (peek/poke/shr) report ety=0.
    r = cg_builtin_dispatch(n);
    if (r > 0) { return r - 1; }
    p = cg_prim;
    return call(p.emit_call_full, n);
}

// ── Commit B: cg_emit_func ─────────────────────────────────
//
// Portable function emitter. Fat-primitive dispatch to the
// chip-local <chip>_emit_func helper that owns frame math,
// B3 register selection, arg copying, and body emission. Same
// design as cg_emit_call — spine owns dispatch, chip owns
// implementation. Future decomposition into cg_emit_func_prologue
// / body / epilogue with finer primitives is a separate session.

// Wave 19 takeover: spine orchestrates the function emission end to
// end, calling chip primitives for every ISA-specific instruction.
// Replaces the pre-Wave-19 fat-primitive delegation that had each
// chip implement the whole recipe (prologue / arg copy / body /
// epilogue) on its own. Each step below is either portable (array
// management, metadata extraction, B3 walk) or a primitive call
// that wraps a single chip responsibility (prologue, register zero,
// syscall trap, etc.).
void cg_emit_func(fi) {
    auto p: ChipPrimitives;
    auto name_p, par_arr, par_cnt, body_arr, body_cnt;
    auto frame, i, total;
    auto hints, ph, fn_rec, pvi;
    auto stmt_i: Node;

    p = cg_prim;

    // 1. Metadata extraction.
    name_p = arr_get(cg_fn_name, fi);
    par_arr = arr_get(cg_fn_par, fi);
    par_cnt = arr_get(cg_fn_pcnt, fi);
    body_arr = arr_get(cg_fn_body, fi);
    body_cnt = arr_get(cg_fn_bcnt, fi);

    // 2. Reset portable variable-tracking arrays.
    arr_clear(cg_vars);
    arr_clear(cg_var_stack);
    arr_clear(cg_var_struct_idx);
    arr_clear(cg_var_off);
    arr_clear(cg_var_forced_ty);
    arr_clear(cg_var_refs);
    arr_clear(cg_var_addr_taken);
    arr_clear(cg_var_promote);
    arr_clear(cg_const_val);
    arr_clear(cg_const_wt);
    arr_clear(cg_const_reg);
    cg_b3_loop_depth = 0;

    // 3. Reset chip-specific state (freelist, promoted-reg array).
    call(p.fn_reset_chip_state);

    // 4. Install current function identity for downstream lookups.
    cg_cur_fn_name = name_p;
    cg_cur_fn_idx = arr_get(cg_fn_fidx, fi);

    // 4b. Phase 6.3 v2 — does this function contain `@profile`?
    // Decided once here so the prologue insertion (step 13b) and
    // the chip primitive's epilogue drain see the same answer.
    // Body scan walks every statement-bearing node type via
    // `cg_node_has_profile`, so nested @profile blocks under
    // if / while / for / switch are all detected. The helpers'
    // packed names must already be interned (parser side) when
    // any function reaches this point with the flag set.
    cg_cur_fn_has_profile = cg_body_has_profile_zones(body_arr, body_cnt);

    // 5. Register parameters as variables and apply type hints if any.
    fn_rec = arr_get(funcs, cg_cur_fn_idx);
    hints = *(fn_rec + 48);
    i = 0;
    while (i < par_cnt) {
        pvi = cg_var_add(*(par_arr + i * 8));
        if (hints != 0) {
            ph = *(hints + i * 8);
            if (ph > 0) { arr_set(cg_var_forced_ty, pvi, ph); }
        }
        i++;
    }

    // 6. Pre-register body-declared variables and compute offsets.
    // S4 P3b-2: reset the per-function inline call site counter
    // before pre_reg so each function rebuilds its own
    // _inl<N>_<orig> slot universe from id 1. The chip-specific
    // pre_reg_vars below also walks the body for inlineable
    // multi-stmt T_CALL sites and stamps T_CALL.e + registers
    // mangled slots via _inline_register_callsite.
    _inline_reset_callsite_id();
    call(p.fn_pre_reg_vars, body_arr, body_cnt);
    total = call(p.fn_compute_offsets);

    // 7. B3 reference walk and register-promotion selection. cg_fn_leaf starts
    // true and is cleared by any T_CALL the walk meets; a leaf function lets the
    // chip widen its promotion pool into caller-saved registers.
    cg_fn_leaf = 1;
    // Expose the function body + reset the induction state so the pointer-walk
    // pass (cg_iv_detect) can scan the whole function for unsafe base uses.
    cg_cur_body = body_arr;
    cg_cur_bcnt = body_cnt;
    cg_iv_active = 0;
    for (i = 0; i < body_cnt; i++) {
        stmt_i = body_arr[i];
        if (stmt_i != 0) { cg_b3_walk(stmt_i); }
    }
    call(p.b3_select);

    // RegAlloc v2, Stage A (docs/plans/compiler_boost_roadmap.md F.2):
    // build this function's CFG. Pure analysis — its output isn't
    // consumed by anything below yet (later stages add liveness,
    // intervals, and linear-scan before any of this touches a real
    // register decision) — so this runs unconditionally, same as
    // cg_b3_walk's own ref-count pass above, with zero effect on the
    // bytes this function compiles to. The dump-on-demand hook
    // (regalloc_name_wants_dump) is this stage's own verification tool,
    // since nothing else observes the CFG yet.
    auto _rg_cfg;
    _rg_cfg = regalloc_build_cfg(body_arr, body_cnt);
    if (regalloc_name_wants_dump(name_p)) {
        regalloc_dump_cfg(_rg_cfg, name_p);
    }

    // Stage B: liveness over the CFG just built. Same "runs
    // unconditionally, zero effect, dump-on-demand is the only
    // verification tool" shape as Stage A above — nothing reads
    // live_in/live_out yet either; Stage C (live intervals) is the
    // first consumer.
    regalloc_compute_liveness(_rg_cfg);
    if (regalloc_name_wants_live_dump(name_p)) {
        regalloc_dump_liveness(_rg_cfg, name_p);
    }

    // Stage C's prerequisite: RPO (a block's own allocation index isn't
    // faithful to real emission order — see regalloc_compute_rpo's own
    // comment). Same shape again: unconditional, zero effect, dump-on-
    // demand verification.
    auto _rg_rpo;
    _rg_rpo = regalloc_compute_rpo(_rg_cfg);
    if (regalloc_name_wants_rpo_dump(name_p)) {
        regalloc_dump_rpo(_rg_rpo, name_p);
    }

    // Stage C: live intervals, flattened from Stage B's per-block
    // liveness using Stage C's own RPO position units. Same shape
    // again: unconditional, zero effect, dump-on-demand verification.
    // Stage D (linear-scan) is the first consumer.
    auto _rg_ivl;
    _rg_ivl = regalloc_compute_intervals(_rg_cfg, _rg_rpo);
    if (regalloc_name_wants_ivl_dump(name_p)) {
        regalloc_dump_intervals(_rg_ivl, name_p);
    }

    // Stage D: linear-scan, in SHADOW MODE — computed and dumpable for
    // comparison against B3, but not yet wired into cg_var_promote or
    // anything else codegen reads (see regalloc_linear_scan's own
    // header comment). Int and float promotion are DISJOINT physical
    // pools (x19..x28/x9..x12 vs d8..d15), so each gets its own
    // intervals (filtered by cg_var_forced_ty), its own budget (the
    // int budget mirrors _a64_b3_reg_at's own table — 10 non-leaf / 14
    // leaf — so the systematic comparison below is apples-to-apples;
    // float is a flat 8, leaf/non-leaf makes no difference there), and
    // its own independent linear-scan run.
    auto _rg_ivl_int, _rg_ivl_flt, _rg_asn, _rg_asn_flt, _rg_budget;
    _rg_budget = 10;
    if (cg_fn_leaf) { _rg_budget = 14; }
    _rg_ivl_int = regalloc_filter_intervals_by_type(_rg_ivl, cg_var_forced_ty, 0);
    _rg_ivl_flt = regalloc_filter_intervals_by_type(_rg_ivl, cg_var_forced_ty, 1);
    _rg_asn = regalloc_linear_scan(_rg_ivl_int, _rg_budget);
    _rg_asn_flt = regalloc_linear_scan(_rg_ivl_flt, 8);
    if (regalloc_name_wants_asn_dump(name_p)) {
        regalloc_dump_assignments(_rg_asn, name_p);
        regalloc_dump_assignments(_rg_asn_flt, name_p);
    }

    // Stage D validation (docs/plans/compiler_boost_roadmap.md F.2's
    // own gate before Stage E may proceed): confirm linear-scan never
    // spills a variable B3 successfully promoted, across EVERY
    // function this binary ever compiles — the full test suite + every
    // real game sweep this for free since it runs unconditionally.
    // Int and float are validated SEPARATELY (want_float distinguishes
    // them) since they're two independent swap decisions below.
    auto _rg_worse, _rg_worse_flt, _rg_split, _rg_split_flt;
    _rg_worse = regalloc_compare_vs_b3(_rg_asn, cg_var_promote, cg_vars, cg_var_forced_ty, 0, name_p);
    _rg_worse_flt = regalloc_compare_vs_b3(_rg_asn_flt, cg_var_promote, cg_vars, cg_var_forced_ty, 1, name_p);

    // Stage E — wire it up, per function, with an automatic fallback.
    // Int and float swap INDEPENDENTLY of each other (a function can
    // take one, the other, both, or neither) — each only swaps when
    // ALL hold: (1) the systematic comparison just above found zero
    // regressions for that class in this exact function (linear-scan
    // promotes everything B3 promotes, here); (2) no variable of that
    // class needed live-range splitting (regalloc_has_any_split) — a
    // single physical register per variable can't represent a value
    // that moves between two different registers at a split boundary,
    // and codegen has no support for emitting that move yet
    // (separable future work, the same shape as coalescing); (3) no
    // mangled inline slot in THIS function is UNCOVERED by Stage A's
    // own analysis (regalloc_has_uncovered_mangled_promoted,
    // bpp_regalloc.bsm) -- a mangled slot B3 promoted that genuinely
    // has no interval anywhere is still invisible to the linear-scan
    // that just ran and could collide with one of its own variables;
    // the "RegAlloc v2 sees through inlined call sites" arc has since
    // taught Stage A to expand a wide and growing set of real
    // inlined-call shapes directly into real intervals for these
    // slots, so most of them ARE covered today (the original blunter
    // gate refused the swap for every mangled slot unconditionally;
    // found via `bug --disasm` on stb/stbfilter.bsm's moog_taps, 4
    // inlined flt_onepole_tick call sites: silently wrong output, no
    // crash, no diagnostic). The chip primitives themselves
    // (regalloc_apply / regalloc_apply_float) re-validate eligibility
    // before touching anything shared, and refuse entirely (returns 0,
    // leaving B3's decision untouched) on any chip that hasn't earned
    // this yet (x64 today — "integer first" rolls out a64 first; x64
    // has no float B3 pool at all).
    auto _rg_mangled, _rg_applied_int, _rg_applied_flt;
    _rg_mangled = regalloc_has_uncovered_mangled_promoted(cg_var_promote, cg_vars, _rg_ivl_int, _rg_ivl_flt);
    _rg_applied_int = 0; _rg_applied_flt = 0;

    if (_rg_worse == 0 && _rg_mangled == 0) {
        _rg_split = regalloc_has_any_split(_rg_ivl_int);
        if (_rg_split == 0) {
            _rg_applied_int = call(p.regalloc_apply, _rg_asn);
        }
    }
    if (_rg_worse_flt == 0 && _rg_mangled == 0) {
        _rg_split_flt = regalloc_has_any_split(_rg_ivl_flt);
        if (_rg_split_flt == 0) {
            _rg_applied_flt = call(p.regalloc_apply_float, _rg_asn_flt);
        }
    }
    if (regalloc_name_wants_swap_dump(name_p)) {
        regalloc_dump_swap(name_p, _rg_worse, _rg_worse_flt, _rg_mangled, _rg_split, _rg_split_flt, _rg_applied_int, _rg_applied_flt);
    }

    // 7b. Persist per-variable location info for the bug debugger.
    // After b3_select, cg_var_promote is settled: >= 0 for register-
    // promoted locals, -1 for stack-resident locals. The bug
    // debugger reads this from fn_vt_locs[func_idx] at SIGTRAP time
    // and dispatches register reads vs stack reads. Without this
    // the watch loop can only see globals correctly — locals that
    // got promoted into x19..x28 leave their stack slot uninitialised
    // and the gdb_read_mem(fp + offset, 8) returns whatever the
    // prior frame happened to leave there.
    //
    // Critical detail: the block is indexed in fn_vt_data order
    // (the type-inference table the bug emitter walks), NOT in
    // cg_vars order — the two indexings differ in general because
    // type inference and codegen each maintain their own variable
    // tables. Iterate the type-table block and look each name up
    // in cg_vars to fetch the matching kind / detail. Names that
    // are not found in cg_vars (e.g. globals captured into
    // fn_vt_data via assignment side-effect) stay kind 1 / detail
    // 0 — the watch loop's existing global-lookup path handles
    // them.
    //
    // Layout per local: 8-byte slot holding `kind` (1 byte at +0)
    // and `detail` (4 bytes LE at +1..+4). Kind 0 = register, kind
    // 1 = stack. For kind 0, detail is the GDB register number
    // (x19 = 19, x20 = 20, ...). For kind 1, detail is the byte
    // offset from x29 (= fp).
    auto _loc_block, _vi, _preg, _kind, _detail, _sid, _vt_cnt, _vt_block;
    auto _vt_name, _cg_idx, _sidx;
    _vt_cnt   = fn_meta_vt_count(cg_cur_fn_idx);
    _vt_block = fn_meta_vt_block(cg_cur_fn_idx);
    _loc_block = buf_byte(_vt_cnt * 8);
    _vi = 0;
    while (_vi < _vt_cnt) {
        _kind = 1;
        _detail = 0;
        _sid = 0;
        if (_vt_block != 0) {
            // Each fn_vt_data entry is 24 bytes (3 words: name,
            // type, elem); only the name matters here.
            _vt_name = *(_vt_block + _vi * 24);
            _cg_idx = cg_var_idx(_vt_name);
            if (_cg_idx >= 0) {
                _preg = arr_get(cg_var_promote, _cg_idx);
                if (_preg >= 0) {
                    _kind = 0;
                    _detail = _preg;
                } else {
                    _kind = 1;
                    _detail = arr_get(cg_var_off, _cg_idx);
                }
                // Per-function struct id, scoped via
                // get_var_type_in_fn so a same-named local in a
                // different function cannot leak its sid in. The
                // codegen-internal cg_var_struct_idx is only set
                // for `var` declarations; this scoped lookup also
                // covers `auto p: Player` (used by the watch loop
                // to walk struct fields). -1 means "no annotation
                // for this name in this function"; the +1
                // normalises to a 1-based sentinel (0 = none).
                _sidx = get_var_type_in_fn(_vt_name, cg_cur_fn_idx);
                _sid = _sidx + 1;
            }
        }
        // 8-byte slot: kind (u8) + detail (u32 LE) + sid (u16 LE)
        // + 1 padding byte.
        poke(_loc_block + _vi * 8,     _kind);
        poke(_loc_block + _vi * 8 + 1, _detail & 0xFF);
        poke(_loc_block + _vi * 8 + 2, (_detail >> 8)  & 0xFF);
        poke(_loc_block + _vi * 8 + 3, (_detail >> 16) & 0xFF);
        poke(_loc_block + _vi * 8 + 4, (_detail >> 24) & 0xFF);
        poke(_loc_block + _vi * 8 + 5, _sid & 0xFF);
        poke(_loc_block + _vi * 8 + 6, (_sid >> 8) & 0xFF);
        _vi++;
    }
    arr_set(fn_vt_locs, cg_cur_fn_idx, _loc_block);

    // 8. Reserve the spill area and compute final frame size.
    total = call(p.fn_reserve_spill, total);
    frame = call(p.fn_scratch_base) + total;
    frame = (frame + 15) / 16 * 16;

    // 9. Prologue.
    call(p.emit_prologue_full, name_p, call(p.fn_label_for, fi), frame);

    // 10. main() — save argc / argv / envp to the runtime globals.
    if (cg_str_eq(name_p, "main", 4)) {
        call(p.save_main_runtime_globals);
    }

    // 11. Incoming args → frame slots or promoted regs. AAPCS64 /
    // System V x86_64 use independent register banks for int and
    // float args — each tracked by its own counter, advancing only
    // when an arg of that class consumes a slot. `(int, float, int)`
    // pulls from x0 / d0 / x1 (aarch64) or rdi / xmm0 / rsi (x86_64).
    // The chip primitives receive the per-class sequence index and
    // turn it into the right `str x_<n>` / `str d_<n>` instruction.
    auto int_seq, flt_seq, ph_i, par_hint;
    int_seq = 0; flt_seq = 0;
    i = 0;
    while (i < par_cnt) {
        ph_i = 0;
        if (hints != 0) { ph_i = *(hints + i * 8); }
        if (is_float_type(ph_i)) {
            call(p.emit_arg_copy_flt, i, flt_seq, arr_get(cg_var_off, i));
            flt_seq++;
        } else {
            call(p.emit_arg_copy_int, i, int_seq, arr_get(cg_var_off, i));
            int_seq++;
        }
        i++;
    }

    // 12. (Removed — see RegAlloc v2 Stage E note below.) This used to
    // zero every promoted non-parameter local's register here in the
    // prologue, unconditionally. That assumed an invariant B3 always
    // held (one physical register, one owning variable, for the whole
    // function) which RegAlloc v2's linear-scan deliberately breaks
    // via slot-sharing: two variables with non-overlapping live ranges
    // can share a register. With that sharing in play, this loop would
    // zero a register a DIFFERENT variable already holds a real value
    // in (e.g. a parameter copied in step 11, just above, sharing a
    // slot with a later local) — found via `bug --disasm` on
    // __rg_asn_straightline once Stage E started swapping decisions
    // in: `a`'s value (copied from x0 into its promoted register one
    // instruction earlier) was overwritten by this exact loop zeroing
    // `y`'s register, which Stage E's linear-scan had assigned the
    // SAME physical register once `a` expired.
    //
    // Removed rather than patched with a sharing-aware exception:
    // stack-resident locals were NEVER zero-initialised by this
    // compiler (only promoted ones were), so removing this loop makes
    // "promoted" and "stack" locals behave consistently — both
    // uninitialised-until-written, which is what well-formed B++
    // source already assumes (no test in this repo reads a local
    // before writing it; confirmed by running the full suite after
    // removing this loop — see the commit this change ships in).
    // 12b. Stage 2a — materialise each promoted hot constant into its
    // callee-saved register, once, here in the prologue. cg_const_reg is
    // only ever set on backends whose b3_select_const ran (a64), so this
    // loop is a no-op elsewhere.
    auto _nc, _ci, _creg;
    _nc = arr_len(cg_const_val);
    for (_ci = 0; _ci < _nc; _ci++) {
        _creg = arr_get(cg_const_reg, _ci);
        if (_creg >= 0) { call(p.emit_iconst_into, _creg, arr_get(cg_const_val, _ci)); }
    }

    // 13. Narrow float params (aarch64 SL_HALF/SL_QUARTER; x64 no-op).
    call(p.emit_narrow_float_params, par_cnt);

    // 13b. Phase 6.3 v2 — push the live zone-stack depth onto the
    // save-stack as the very first body action of any function
    // that contains `@profile` blocks. Pairs with the
    // `_prof_save_drain` call that the chip primitive emits
    // immediately after the epilogue label. Synthesised T_CALL
    // routes through normal codegen so the call instruction,
    // arg setup (none), and AAPCS / SysV alignment all follow
    // the established path.
    if (cg_cur_fn_has_profile != 0) {
        auto save_enter_call: Node;
        save_enter_call = make_node(T_CALL);
        save_enter_call.a = _zone_save_enter_p;
        save_enter_call.b = 0;
        save_enter_call.c = 0;
        cg_emit_node(save_enter_call);
    }

    // 14. Body walk.
    cg_depth = 0;
    call(p.emit_body, body_arr, body_cnt);

    // 15. Implicit fallthrough return 0.
    call(p.emit_implicit_ret_zero);

    // 16. Epilogue.
    call(p.emit_frame_teardown, frame);
}

// Portable "does this AST subtree contain a T_CALL?" walker. Used by
// the T_MEMST path to decide between a freelist save (safe only if
// the right-hand pointer computation does not clobber caller-saved
// registers) and a stack push / pop (always safe, costlier). Lifted
// from the chip-local _a64_has_call / _x64_has_call which had two
// byte-identical copies.
cg_has_call(nd) {
    auto n: Node, t;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    switch (t) {
    T_CALL { return 1; }
    T_BINOP {
        if (cg_has_call(n.b)) { return 1; }
        return cg_has_call(n.c);
    }
    T_TERNARY {
        if (cg_has_call(n.a)) { return 1; }
        if (cg_has_call(n.b)) { return 1; }
        return cg_has_call(n.c);
    }
    T_ASSIGN, T_MEMST {
        if (cg_has_call(n.a)) { return 1; }
        return cg_has_call(n.b);
    }
    T_UNARY { return cg_has_call(n.b); }
    T_MEMLD, T_ADDR, T_RET { return cg_has_call(n.a); }
    else { return 0; }
    }
}

// Phase 6.3 v2 — does this AST subtree contain a `@profile` block?
// Detection runs on the parser's lowered shape, which is a T_CALL
// to `_prof_zone_enter` at the top of every synthesised T_BLOCK.
// One match anywhere in the body is enough — `cg_emit_func` only
// needs a yes/no answer to decide whether the function pays the
// save_enter / save_drain overhead. Walks every statement-bearing
// node type so the answer is the same regardless of nesting under
// if / while / for / switch / arbitrary blocks.
cg_node_has_profile(nd) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;
    if (t == T_CALL) {
        if (cg_str_eq(n.a, "_prof_zone_enter", 16)) { return 1; }
        return 0;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (cg_node_has_profile(arr[i])) { return 1; }
        }
        return 0;
    }
    if (t == T_IF) {
        if (cg_node_has_profile(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (cg_node_has_profile(arr[i])) { return 1; }
        }
        if (n.d != 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (cg_node_has_profile(arr[i])) { return 1; }
            }
        }
        return 0;
    }
    if (t == T_WHILE) {
        if (cg_node_has_profile(n.a)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (cg_node_has_profile(arr[i])) { return 1; }
        }
        return 0;
    }
    if (t == T_SWITCH) {
        // Switch arms live in n.b (values) + n.src_tok (bodies).
        // Walk every arm body.
        auto sw_bodies, sb_arr, sb_cnt, sk;
        sw_bodies = n.src_tok;
        cnt = n.c;
        for (i = 0; i < cnt; i++) {
            sb_arr = sw_bodies[i * 2];
            sb_cnt = sw_bodies[i * 2 + 1];
            for (sk = 0; sk < sb_cnt; sk++) {
                if (cg_node_has_profile(sb_arr[sk])) { return 1; }
            }
        }
        if (n.d != 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (cg_node_has_profile(arr[i])) { return 1; }
            }
        }
        return 0;
    }
    return 0;
}

cg_body_has_profile_zones(body_arr, body_cnt) {
    auto i;
    for (i = 0; i < body_cnt; i++) {
        if (cg_node_has_profile(body_arr[i])) { return 1; }
    }
    return 0;
}

// -- Inline-splice ranges for the .bug debug map (v5), shared by both chips --
// Each inlined body's [start, end) text offset + the callee's packed name.
// Recorded by cg_emit_inline_multi and the chips' single-return fast path via
// _bug_inl_record; read by bpp_bug.bsm's bug_write_inline. (Moved here from
// a64_codegen.bsm so x86_64 records inline ranges too.)
global bug_inl_start;   // arr<int>: text offset where each inlined body begins
global bug_inl_end;     // arr<int>: text offset where it ends (exclusive)
global bug_inl_callee;  // arr<packed>: packed name of the inlined callee
global bug_line_pc;     // arr<int>: text offset at the start of each statement
global bug_line_tok;    // arr<int>: that statement's source token (Node.src_tok)
extrn flag_bug;         // bpp_bug.bsm: set by --bug; gates line recording (matches .bug emission)

// Reset the range arrays at codegen init. Called from BOTH chip inits.
void init_bug_inl() {
    bug_inl_start  = arr_new();
    bug_inl_end    = arr_new();
    bug_inl_callee = arr_new();
    bug_line_pc    = arr_new();
    bug_line_tok   = arr_new();
}

// Record one inline-splice range. s/e come from the chip's cur_text_pos: -1 in
// asm-text mode (a64 --asm) where there is no real offset, so a negative start or
// an empty range is a no-op.
_bug_inl_record(s, e, fidx) {
    if (s < 0) { return 0; }
    if (e <= s) { return 0; }
    bug_inl_start  = arr_push(bug_inl_start, s);
    bug_inl_end    = arr_push(bug_inl_end, e);
    bug_inl_callee = arr_push(bug_inl_callee, *(funcs[fidx] + FN_NAME));
    return 0;
}

// .bug line table: record (text PC, source token) for one statement. The
// token -> (module, relative line) conversion is deferred to bug_write_lines
// in bpp_bug.bsm, where tok_lines / diag_file_line_start already live. Only
// called when flag_bug is set (see cg_emit_stmt), so a normal compile records
// nothing and stays byte-stable; pc < 0 is asm-text mode (no real offset).
_bug_line_record(pc, tok) {
    if (pc < 0) { return 0; }
    bug_line_pc  = arr_push(bug_line_pc, pc);
    bug_line_tok = arr_push(bug_line_tok, tok);
    return 0;
}

// Does the subtree `nd` WRITE the variable named `pname` — assign to it,
// or take its address (which lets it be written through a pointer)?
//
// The inliner uses this to stay both correct and fast. A parameter that
// is only READ may be substituted with the caller's argument directly
// (the SIMPLE strategy). A parameter that is WRITTEN must instead get
// its own per-callsite local (the BIND strategy): substituting the
// caller's variable for a written parameter would route the assignment
// back into the caller, breaking call-by-value (e.g. `f(x){ x = x+100; }`
// called as `f(n)` would change the caller's `n`). Reading `pname` —
// including using it as the base of a `*(pname + i) = v` store — is not
// a write, so the common read-only parameter keeps the fast path.
//
// The traversal mirrors ast_clone_subst (bpp_dispatch.bsm) field for
// field so the two stay in agreement about the shape of every node.
_inline_writes_param(nd, pname) {
    auto n: Node, t, arr, cnt, i, lhs: Node;
    if (nd == 0) { return 0; }
    n = nd;
    t = n.ntype;

    if (t == T_ASSIGN) {
        // A direct write `pname = ...`.
        lhs = n.a;
        if (lhs != 0 && lhs.ntype == T_VAR && packed_eq(lhs.a, pname)) { return 1; }
        if (_inline_writes_param(n.a, pname)) { return 1; }
        return _inline_writes_param(n.b, pname);
    }
    if (t == T_ADDR) {
        // `&pname` — the address escapes; conservatively a write.
        lhs = n.a;
        if (lhs != 0 && lhs.ntype == T_VAR && packed_eq(lhs.a, pname)) { return 1; }
        return _inline_writes_param(n.a, pname);
    }
    if (t == T_BINOP) {
        if (_inline_writes_param(n.b, pname)) { return 1; }
        return _inline_writes_param(n.c, pname);
    }
    if (t == T_UNARY) { return _inline_writes_param(n.b, pname); }
    if (t == T_MEMLD) { return _inline_writes_param(n.a, pname); }
    if (t == T_RET)   { return _inline_writes_param(n.a, pname); }
    if (t == T_MEMST) {
        // Store THROUGH an address — the base var is read, not written.
        // Recurse so a nested assignment inside either side is still seen.
        if (_inline_writes_param(n.a, pname)) { return 1; }
        return _inline_writes_param(n.b, pname);
    }
    if (t == T_TERNARY) {
        if (_inline_writes_param(n.a, pname)) { return 1; }
        if (_inline_writes_param(n.b, pname)) { return 1; }
        return _inline_writes_param(n.c, pname);
    }
    if (t == T_CALL) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_writes_param(arr[i], pname)) { return 1; }
        }
        return 0;
    }
    if (t == T_IF) {
        if (_inline_writes_param(n.a, pname)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_writes_param(arr[i], pname)) { return 1; }
        }
        if (n.e > 0) {
            arr = n.d; cnt = n.e;
            for (i = 0; i < cnt; i++) {
                if (_inline_writes_param(arr[i], pname)) { return 1; }
            }
        }
        return 0;
    }
    if (t == T_WHILE) {
        if (_inline_writes_param(n.a, pname)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_writes_param(arr[i], pname)) { return 1; }
        }
        if (n.e != 0) { return _inline_writes_param(n.e, pname); }
        return 0;
    }
    if (t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) {
            if (_inline_writes_param(arr[i], pname)) { return 1; }
        }
        return 0;
    }
    // T_LIT, T_VAR, T_DECL, T_NOP, T_BREAK, T_CONTINUE: no write to pname.
    return 0;
}

// Scan a whole callee body for any write to the parameter `pname`.
_inline_param_is_written(body_arr, bcnt, pname) {
    auto i;
    for (i = 0; i < bcnt; i++) {
        if (_inline_writes_param(body_arr[i], pname)) { return 1; }
    }
    return 0;
}

// Does parameter `i` of callee `fidx` need a real bound mangled slot
// (1), or can its argument `arg_node` be substituted directly in place
// of every reference (0)? THE single source of truth for this
// decision — used both by the real splice below (which then either
// binds or substitutes) and by bpp_regalloc.bsm's "see through inlined
// call sites" arc (which must know, for each parameter, whether a
// reference inside the callee's body resolves to a real mangled slot
// or to the caller's own argument expression, with no slot at all).
// The two were found to silently disagree once — RegAlloc v2's
// analysis always assumed every parameter was bound, when in fact a
// T_VAR/T_LIT (or const-offset T_MEMLD) argument to a never-written
// parameter is substituted with no slot ever created. The single-
// statement leaf bodies the arc shipped against first (flt_onepole_tick)
// never exposed the gap (no second statement existed for another
// variable to steal the "freed" register from); a void statement-level
// call site with more than one body statement did. Extracting this
// decision into its own function — called from both places — makes
// that kind of divergence structurally impossible going forward.
_inline_param_needs_bind(fidx, i, arg_node: Node, inl_body, inl_bcnt, inl_params) {
    auto arg_t, _sub_ok, _memld_ok, _memld_base: Node, _memld_off;
    arg_t = arg_node.ntype;
    _sub_ok = (arg_t == T_VAR || arg_t == T_LIT);
    if (_sub_ok == 0 && arg_t == T_MEMLD) {
        _memld_ok, _memld_base, _memld_off = cg_try_const_offset(arg_node.a, arg_node.b);
        if (_memld_ok && _memld_base.ntype == T_VAR) { _sub_ok = 1; }
    }
    if (_sub_ok && is_float_type(get_fn_par_type(fidx, i)) &&
        arg_node.itype != get_fn_par_type(fidx, i)) {
        _sub_ok = 0;
    }
    if (_sub_ok && _inline_param_is_written(inl_body, inl_bcnt, *(inl_params + i * 8)) == 0) {
        return 0;
    }
    return 1;
}

// Multi-statement / void inline splice, shared by both chips (was
// _a64_emit_inline_multi / _x64_emit_inline_multi). Binds non-trivial args into
// per-callsite mangled slots, alpha-renames params + locals, emits the body via
// cg_emit_stmt, and (for value bodies) emits the trailing return expression into
// acc; detects the void shape (last stmt not a T_RET) and emits all statements.
// .bug range recording goes through the cur_text_pos chip primitive.
// Shared prelude for both inline-splice tail shapes (Inc 5 — single-value/
// void via cg_emit_inline_multi, multi-value via cg_emit_inline_multi_assign):
// binds/substitutes the callee's params, builds the rename map, and emits
// every body statement except the last. Returns the rename map
// (names_buf, args_buf, total_names — the caller's tail clones the trailing
// statement's expression(s) through these) and the untouched last
// statement node. The caller's tail owns freeing names_buf/args_buf once
// done with them (mirrors the original single-function's own free()
// sequence — this split changes no allocation lifetimes, only where the
// code lives).
_cg_inline_splice_prelude(call_node, fidx) -> (word, word, word, ptr, word, word) {
    auto cn: Node;
    auto callsite_id, inl_callee, inl_body, inl_bcnt;
    auto inl_params, inl_pcnt;
    auto i, args_arr;
    auto (mp_node, bind_lhs, bind_assign): Node;
    auto mangled_params_buf;
    auto locals_buf, mangled_locals_buf, locals_cnt;
    auto names_buf, args_buf, total_names;
    auto si, cloned, ret_stmt: Node;
    auto arg_node: Node, arg_t;
    auto bind_needed;
    auto is_void_splice, last_emit;
    auto nested_ids, nested_found, nk, nested_node: Node;
    cn = call_node;
    callsite_id = cn.e;
    inl_callee = funcs[fidx];
    inl_body = *(inl_callee + FN_BODY);
    inl_bcnt = *(inl_callee + FN_BCNT);
    inl_params = *(inl_callee + FN_PARS);
    inl_pcnt = *(inl_callee + FN_PCNT);
    args_arr = cn.b;
    // Pre-build mangled names for every callee identifier so the
    // binding prologue and the rename map share the same packed
    // references (cheaper packed_eq downstream).
    mangled_params_buf = buf_word(inl_pcnt + 1);
    i = 0;
    while (i < inl_pcnt) {
        *(mangled_params_buf + i * 8) = _inline_pack_mangled_name(callsite_id, *(inl_params + i * 8));
        i++;
    }
    locals_buf = buf_word(64);
    locals_cnt = _inline_collect_locals(inl_body, inl_bcnt, locals_buf);
    mangled_locals_buf = buf_word(locals_cnt + 1);
    i = 0;
    while (i < locals_cnt) {
        *(mangled_locals_buf + i * 8) = _inline_pack_mangled_name(callsite_id, *(locals_buf + i * 8));
        i++;
    }
    // 1. Per-param strategy:
    //    - Arg is T_VAR or T_LIT (cheap, idempotent) AND the param is
    //      only READ in the body: SUBSTITUTE. Multiple refs re-emit the
    //      load/lit each time — same cost as a single ref with no
    //      binding overhead.
    //    - Param is WRITTEN in the body (`x = ...`, `&x`): BIND, even for
    //      a T_VAR/T_LIT arg. Substituting the caller's variable for a
    //      written param would route the assignment back into the caller
    //      and break call-by-value — see `_inline_writes_param`.
    //    - Arg is anything else (T_CALL, T_BINOP, etc.): BIND.
    //      Emit `_inl<N>_<param> = <arg_expr>` once via
    //      `cg_emit_stmt`, then the rename map uses the mangled
    //      slot. Arg evaluates exactly once, regardless of how
    //      many times the body touches the param.
    //
    //    The mixed strategy preserves correctness (no side-effect
    //    duplication) while avoiding the per-iteration store/load
    //    overhead that pure binding adds for simple-variable args
    //    — measured on `examples/tablah.bpp:gen_u64_worker` where
    //    `xorshift64(worker_id)` is the hot inner call: pure binding
    //    regressed phase 1 from ~10 ms to ~16 ms; substitute-when-
    //    simple closes the gap.
    //
    //    `cg_emit_stmt` (not `a64_emit_node`) is mandatory for the
    //    synth T_ASSIGN — the node dispatcher is expression-only
    //    and silently drops statement-typed nodes. Same pitfall as
    //    the body-prelude loop further down; see commit `6a7dcd5`.
    // Per-param bind-vs-substitute strategy — see _inline_param_needs_bind's
    // own header comment for the full rationale and for why this decision
    // now lives in ONE function shared with bpp_regalloc.bsm, instead of
    // inline here as it used to be.
    bind_needed = buf_word(inl_pcnt + 1);
    i = 0;
    while (i < inl_pcnt) {
        arg_node = *(args_arr + i * 8);
        if (_inline_param_needs_bind(fidx, i, arg_node, inl_body, inl_bcnt, inl_params) == 0) {
            *(bind_needed + i * 8) = 0;
        } else {
            *(bind_needed + i * 8) = 1;
            bind_lhs = make_node(T_VAR);
            bind_lhs.a = *(mangled_params_buf + i * 8);
            bind_assign = make_node(T_ASSIGN);
            bind_assign.a = bind_lhs;
            bind_assign.b = arg_node;
            cg_emit_stmt(bind_assign);
        }
        i++;
    }
    // 2. Build the rename map. For BIND-needed params, substitute
    //    to T_VAR(mangled). For SIMPLE params, substitute to the
    //    arg node directly (Phase B2 shape — read/load each ref).
    //    Locals always substitute to fresh T_VAR(mangled).
    total_names = inl_pcnt + locals_cnt;
    names_buf = buf_word(total_names + 1);
    args_buf  = buf_word(total_names + 1);
    i = 0;
    while (i < inl_pcnt) {
        *(names_buf + i * 8) = *(inl_params + i * 8);
        if (*(bind_needed + i * 8)) {
            auto _mp_vi;
            mp_node = make_node(T_VAR);
            mp_node.a = *(mangled_params_buf + i * 8);
            // The mangled slot is already registered (pre-reg phase,
            // _inline_register_callsite_slots) with its declared type in
            // cg_var_forced_ty — copy it onto this fresh node so a FURTHER
            // nested splice (this body itself calling another inlinable
            // function, Inc 6) sees a real itype here instead of TY_UNK.
            // Without this, the per-param substitution-eligibility check
            // above always finds a type mismatch for a renamed param used
            // as a nested call's argument and falls back to binding even
            // when substitution would have been safe — found
            // re-disassembling moog_taps -> flt_onepole_tick.
            _mp_vi = cg_var_idx(mp_node.a);
            if (_mp_vi >= 0) { mp_node.itype = arr_get(cg_var_forced_ty, _mp_vi); }
            *(args_buf + i * 8) = mp_node;
        } else {
            *(args_buf + i * 8) = *(args_arr + i * 8);
        }
        i++;
    }
    i = 0;
    while (i < locals_cnt) {
        auto _ml_vi;
        *(names_buf + (inl_pcnt + i) * 8) = *(locals_buf + i * 8);
        mp_node = make_node(T_VAR);
        mp_node.a = *(mangled_locals_buf + i * 8);
        // Same fix as the param case above, for a renamed LOCAL (e.g.
        // moog_taps's own `g`/`fb`/`a`/`b`/`c`/`d`) used as a nested
        // inlined call's argument.
        _ml_vi = cg_var_idx(mp_node.a);
        if (_ml_vi >= 0) { mp_node.itype = arr_get(cg_var_forced_ty, _ml_vi); }
        *(args_buf + (inl_pcnt + i) * 8) = mp_node;
        i++;
    }
    // Emit the body statements. STATEMENT-level emit via cg_emit_stmt —
    // a64_emit_node only handles expressions and would silently drop
    // T_ASSIGN / T_MEMST / T_DECL bodies.
    //
    // VI-2 — two splice shapes share this loop, told apart by the last
    // statement:
    //   * value body (ends in T_RET): emit statements 0..bcnt-2, then emit
    //     the trailing T_RET's EXPRESSION as the call's value (into acc).
    //   * void body (falls off the end, no trailing T_RET): emit ALL bcnt
    //     statements; the call is in statement position so there is no value.
    ret_stmt = inl_body[inl_bcnt - 1];
    is_void_splice = (ret_stmt.ntype != T_RET);
    if (is_void_splice != 0) {
        // Defensive: the void emit shape must agree with the classifier —
        // only an fn_void_inlineable callee should ever reach this branch,
        // and only in statement context (a void call has no usable value).
        assert(arr_get(fn_void_inlineable, fidx));
        last_emit = inl_bcnt;
    } else {
        last_emit = inl_bcnt - 1;
    }
    // Inc 6 (nested-inline architecture): if pre-reg found nested inlinable
    // calls in THIS callee's body (_inline_register_nested, keyed by this
    // exact callsite_id), `nk` tracks how many we've stamped so far —
    // shared ACROSS every statement in this loop, since multiple
    // statements can each carry one nested call (moog_taps's 4 separate
    // `flt_onepole_tick` calls, one per assignment) and they must consume
    // `nested_ids` in the same single left-to-right sequence pre-reg's
    // discovery walk produced it in, not restart per statement.
    nk = 0;
    if (callsite_id < arr_len(_inline_nested_ids)) {
        nested_ids = arr_get(_inline_nested_ids, callsite_id);
    } else {
        nested_ids = 0;
    }
    si = 0;
    while (si < last_emit) {
        cloned = ast_clone_subst(inl_body[si], names_buf, total_names, args_buf);
        // Stamp this statement's share of nested_ids onto its clone —
        // never the shared original. `_inline_find_nested_calls` visits
        // T_CALL nodes in the same deterministic order pre-reg's own
        // discovery walk did (ast_clone_subst preserves tree shape
        // exactly), so the next `nk` ids it finds are always the right
        // ones. Once `.e` is set, the nested call needs no further
        // special-casing — cg_emit_stmt below reaches it through the
        // ordinary T_CALL dispatch, which recurses into this same splice
        // machinery on its own.
        if (nested_ids != 0) {
            nested_found = arr_new();
            nested_found = _inline_find_nested_calls(cloned, nested_found);
            i = 0;
            while (i < arr_len(nested_found)) {
                nested_node = arr_get(nested_found, i);
                nested_node.e = arr_get(nested_ids, nk);
                nk++;
                i++;
            }
        }
        cg_emit_stmt(cloned);
        si++;
    }
    free(locals_buf);
    free(mangled_locals_buf);
    free(mangled_params_buf);
    free(bind_needed);
    // nested_ids/nk let the caller's own tail (cg_emit_inline_multi /
    // cg_emit_inline_multi_assign) continue stamping nested-call ids
    // onto its OWN clone of the trailing return expression(s) — see
    // _inline_stamp_nested and _inline_register_nested's matching
    // discovery-side extension. nk is wherever this loop's own
    // per-statement stamping left off; the tail picks up from there so
    // the two sides consume nested_ids in one continuous, agreed-upon
    // sequence.
    return names_buf, args_buf, total_names, ret_stmt, nested_ids, nk;
}

// Stamps any nested-call ids remaining in `nested_ids` (continuing from
// position `nk`) onto a freshly-cloned subtree — the trailing-return-
// expression twin of the stamping loop inside _cg_inline_splice_prelude
// (which only covers statements 0..bcnt-2). Used by both inline-splice
// tails below, right after each one's own `ast_clone_subst` call on a
// piece of the trailing return, so a nested call hiding inside the
// RETURN EXPRESSION itself (moon_filter.bsm's moon_process: `return
// moog_slope(...)`) gets the same treatment a nested call inside an
// earlier statement already does. Returns the advanced `nk`.
static _inline_stamp_nested(cloned, nested_ids, nk) {
    auto nested_found, i, nn: Node;
    if (nested_ids == 0) { return nk; }
    nested_found = arr_new();
    nested_found = _inline_find_nested_calls(cloned, nested_found);
    i = 0;
    while (i < arr_len(nested_found)) {
        nn = arr_get(nested_found, i);
        nn.e = arr_get(nested_ids, nk);
        nk++;
        i++;
    }
    return nk;
}

// Single-value / void inline splice (Phase B2 + S4 P3b + VI-2 unified).
// Thin wrapper over the shared prelude: binds args, splices every body
// statement but the last, then finishes with the ONE shape this call site
// expects — either no value (void splice) or the trailing T_RET's
// expression evaluated into acc/d0, exactly as a real call would leave it.
cg_emit_inline_multi(call_node, fidx) {
    auto names_buf, args_buf, total_names, ret_stmt: Node;
    auto pp: ChipPrimitives;
    auto _inl_s, ret_clone, final_ety, is_void_splice, nested_ids, nk;
    pp = cg_prim;
    _inl_s = call(pp.cur_text_pos);   // .bug: text offset where this inlined body begins
    names_buf, args_buf, total_names, ret_stmt, nested_ids, nk = _cg_inline_splice_prelude(call_node, fidx);
    is_void_splice = (ret_stmt.ntype != T_RET);
    if (is_void_splice != 0) {
        // No value to leave in acc — the statement-context caller discards it.
        final_ety = 0;
    } else {
        // Final T_RET expression — emit value into acc. Stamp any nested
        // call hiding inside it (e.g. `return moog_slope(...)`) before
        // emitting — see _inline_stamp_nested.
        ret_clone = ast_clone_subst(ret_stmt.a, names_buf, total_names, args_buf);
        nk = _inline_stamp_nested(ret_clone, nested_ids, nk);
        final_ety = call(pp.emit_node, ret_clone);
    }
    _bug_inl_record(_inl_s, call(pp.cur_text_pos), fidx);   // .bug: record this inlined range
    free(names_buf);
    free(args_buf);
    return final_ety;
}

// Multi-value inline splice (Inc 5, docs/plans/inliner_arc.md) — the tail
// for a multi-assign call site (`a, b, c, d = f();`) whose callee is
// inline-eligible. Shares the same prelude as cg_emit_inline_multi (param
// binding, body-statement splice); only the finish differs: instead of
// leaving ONE value in acc, walk the trailing multi-return's result list
// and store each cloned expression directly into its matching caller-side
// target — no bank push/pop at all, because inlining eliminates the
// function-call boundary those exist to cross in the first place. `targets`
// is the multi-assign's target-node array (T_ASSIGN.c), `tcount` its count
// (T_ASSIGN.d) — classify_inlineable's Inc 5 gate already guarantees
// ret_stmt is a matching multi-return T_RET whenever this is reached, so
// there is no void/single-value fallback to consider here.
cg_emit_inline_multi_assign(call_node, fidx, targets, tcount) {
    auto names_buf, args_buf, total_names, ret_stmt: Node;
    auto pp: ChipPrimitives;
    auto _inl_s, k, rexprs, rclone, rrty, tnode: Node, tvi, toff, tis_f;
    auto nested_ids, nk;
    pp = cg_prim;
    _inl_s = call(pp.cur_text_pos);
    names_buf, args_buf, total_names, ret_stmt, nested_ids, nk = _cg_inline_splice_prelude(call_node, fidx);
    rexprs = ret_stmt.b;
    k = 0;
    while (k < tcount) {
        rclone = ast_clone_subst(*(rexprs + k * 8), names_buf, total_names, args_buf);
        // Stamp any nested call hiding inside THIS result expression —
        // see _inline_stamp_nested. _inline_find_nested_calls's own
        // T_RET case (consulted by the matching discovery-side walk in
        // _inline_register_nested) visits results 0..tcount-1 in this
        // same order, so nk's running position stays in sync across
        // every iteration of this loop.
        nk = _inline_stamp_nested(rclone, nested_ids, nk);
        tnode = *(targets + k * 8);
        tvi = cg_var_idx(tnode.a);
        toff = arr_get(cg_var_off, tvi);
        tis_f = cg_var_is_float(tvi);
        rrty = call(pp.emit_node, rclone);
        // Convert to the TARGET's declared type, same authority the
        // existing real-call multi-assign unpack uses (bpp_codegen.bsm's
        // T_ASSIGN n.d > 1 handler) — not the callee's declared return
        // type, so both paths agree on who decides.
        if (tis_f) {
            if (rrty == 0) { call(pp.emit_promote_int_to_flt); }
        } else {
            if (rrty == 1) { call(pp.emit_demote_flt_to_int); }
        }
        call(pp.emit_store_var_typed, tvi, toff, tis_f);
        k++;
    }
    _bug_inl_record(_inl_s, call(pp.cur_text_pos), fidx);
    free(names_buf);
    free(args_buf);
    return 0;
}

// ── F.2.c: compute-in-place for pure float arithmetic trees ──────────
//
// cg_float_tree_need analyses whether a node is a pure `+ - * /` tree
// over plain `: float` locals, and if so returns how many SIMD temp
// registers the destination-driven emitter needs. The count uses the
// left-first Sethi-Ullman recurrence that mirrors how cg_emit_float_into
// allocates: a leaf costs 0 temps (it loads straight into its
// destination register); a binop costs max(need(left), 1 + need(right))
// because the left operand reuses the destination register down the
// whole left spine while each right operand occupies one fresh temp.
//
// Any node that is not such a tree (a call, an integer leaf, a promoted
// or address-taken local, a sub-word/SIMD float, a comparison) makes the
// function return the sentinel 999. The caller compares the result with
// the chip's temp-pool size, so the sentinel simply forces the fall-back
// to the accumulator path. (999 is far above any real register budget.)
// Classify a float-tree leaf. Returns -1 if nd is not an eligible float
// leaf (not a plain-double `: float` local), 0 if it is a FRAME-resident
// float local, or the promoted register number (8..15) when B3 has
// promoted it to a callee-saved d-register. The promoted case is the
// Stage-2 payoff: the op reads that register directly, with no load and
// no fmov.
cg_float_leaf_kind(nd) {
    auto n: Node, vi, fty, sl, preg;
    if (nd == 0) { return -1; }
    n = nd;
    if (n.ntype != T_VAR) { return -1; }
    vi = cg_var_idx(n.a);
    if (vi < 0) { return -1; }                       // global / unknown
    if (cg_var_is_float(vi) == 0) { return -1; }     // not a float local
    if (arr_get(cg_var_stack, vi)) { return -1; }    // address-taken / struct
    fty = arr_get(cg_var_forced_ty, vi);
    sl = ty_slice(fty);
    if (sl == SL_HALF) { return -1; }
    if (sl == SL_QUARTER) { return -1; }
    if (sl == SL_DOUBLE) { return -1; }
    preg = arr_get(cg_var_promote, vi);
    if (preg >= 0) { return preg; }                  // promoted d8..d15
    return 0;                                         // frame leaf
}

cg_float_tree_need(nd) {
    auto n: Node, t, c0, op_l, nl, nr, k, rc;
    auto p: ChipPrimitives, ok, base: Node, off, bvi, ineed;
    p = cg_prim;
    if (nd == 0) { return 999; }
    n = nd; t = n.ntype;
    // Float literal leaf. The third gap found re-disassembling rotary_tick
    // (the other two are above and below this case): a literal operand
    // (`r.cur + 0.0001`, `x > 1.5`) always bailed out of compute-in-place
    // entirely, on both the arithmetic and comparison paths, because
    // neither leaf check (cg_float_leaf_kind for T_VAR, the T_MEMLD case
    // below) recognized T_LIT at all. An int literal in a float tree is
    // out of scope here (needs a conversion, not just a load) — only a
    // genuine float literal qualifies.
    if (t == T_LIT) {
        if (cg_is_float_lit(n.a) == 0) { return 999; }
        return 0;             // always materializable directly into dreg
    }
    if (t == T_VAR) {
        if (cg_float_leaf_kind(nd) < 0) { return 999; }
        return 0;                                    // any leaf: 0 temps
    }
    // Struct-field / fixed-index float load. Mirrors cg_int_tree_need's own
    // T_MEMLD case (bpp_codegen.bsm, the integer CIP arc) — same leaf
    // shape, but the ADDRESS sub-expression (n.a) is always INTEGER/
    // pointer-typed even though the LOADED VALUE is float, so its cost is
    // checked against the INTEGER temp budget, never recursed into via
    // this (float) function. Found investigating rotary_tick: every
    // struct-field read bypassed compute-in-place entirely before this,
    // including pure arithmetic the gate already covers operator-wise.
    if (t == T_MEMLD) {
        if (is_float_type(n.b) == 0) { return 999; }
        if (ty_slice(n.b) != SL_FULL) { return 999; }  // half/quarter/double
                                                        // SIMD deferred, not
                                                        // in scope here
        // Cheapest case: base+const-offset address whose base is already
        // a promoted register (this session's earlier cg_try_const_offset/
        // cg_emit_addr work) — the float load reads straight through it,
        // no address computation, no temp of either pool needed at all.
        ok, base, off = cg_try_const_offset(n.a, n.b);
        if (ok) {
            bvi = -1;
            if (base.ntype == T_VAR) { bvi = cg_var_idx(base.a); }
            if (bvi >= 0 && cg_var_is_float(bvi) == 0 && arr_get(cg_var_promote, bvi) >= 0) {
                return 0;
            }
        }
        // General case: the address tree's cost comes from the INTEGER
        // pool, checked against the integer budget right here (the
        // caller only ever checks THIS function's return value against
        // the FLOAT/SIMD budget, so a cross-pool need must be validated
        // before returning, not after).
        ineed = cg_int_tree_need(n.a);
        if (ineed >= 999) { return 999; }
        if (ineed > call(p.int_temp_count)) { return 999; }
        return 0;   // the float load itself needs no SIMD temp
    }
    if (t == T_BINOP) {
        op_l = unpack_l(n.a);
        if (op_l != 1) { return 999; }
        c0 = peek(cg_sbuf + unpack_s(n.a));
        if (c0 != '+' && c0 != '-' && c0 != '*' && c0 != '/') { return 999; }
        nl = cg_float_tree_need(n.b);                // left computes into dreg
        if (nl >= 999) { return 999; }
        // Right cost: a promoted-leaf right is read directly (0 temps);
        // anything else needs one temp to hold it for the op.
        k = cg_float_leaf_kind(n.c);
        if (k > 0) {
            rc = 0;
        } else {
            nr = cg_float_tree_need(n.c);
            if (nr >= 999) { return 999; }
            rc = 1 + nr;
        }
        if (nl > rc) { return nl; }
        return rc;
    }
    return 999;
}

// Emit a pure float arithmetic tree (already validated and budgeted by
// cg_float_tree_need) directly into d<dreg>, computing in place. The left
// operand reuses dreg as its running accumulator down the entire left
// spine; each right operand lands in a freshly allocated SIMD temp; the
// op writes its destination directly. No value shuttles through the d0
// accumulator. Precondition: cg_float_tree_need(nd) <= simd_temp_count(),
// so simd_temp_alloc never returns -1 here.
cg_emit_float_into(nd, dreg) {
    auto p: ChipPrimitives;
    auto n: Node, t, vi, off, c0, op_code, lsrc, rsrc, tr, lk, rk;
    p = cg_prim;
    n = nd; t = n.ntype;
    // Float literal leaf — mirrors cg_float_tree_need's own T_LIT case
    // (above), which already validated this is a genuine float literal.
    // Registers it in the same const pool cg_emit_lit's generic path
    // uses (no dedup there either — mirrored, not introduced here), and
    // loads it directly into dreg instead of the fixed d0 accumulator.
    if (t == T_LIT) {
        auto _flid;
        _flid = arr_len(cg_flt_tbl);
        cg_flt_tbl = arr_push(cg_flt_tbl, n.a);
        call(p.emit_fconst_into, dreg, _flid);
        return 0;
    }
    if (t == T_VAR) {
        lk = cg_float_leaf_kind(nd);
        if (lk > 0) {
            // Promoted local: move the callee-saved d-register into dreg.
            call(p.emit_fmov_reg, dreg, lk);
        } else {
            vi = cg_var_idx(n.a);
            off = arr_get(cg_var_off, vi);
            call(p.emit_fload_var_into, dreg, off);
        }
        return 0;
    }
    // Struct-field / fixed-index float load — mirrors cg_float_tree_need's
    // own T_MEMLD case (above), which already validated this is safe to
    // reach here. Cheapest case: base+const-offset address whose base is
    // already promoted — read straight through it, offset folded into the
    // load, no temp at all. Otherwise the address (an INTEGER tree) is
    // computed into a borrowed int temp first, then the float load reads
    // through that.
    if (t == T_MEMLD) {
        auto _mok, _mbase: Node, _moff, _mbvi, _mbreg, _mitmp;
        _mok, _mbase, _moff = cg_try_const_offset(n.a, n.b);
        if (_mok) {
            _mbvi = -1;
            if (_mbase.ntype == T_VAR) { _mbvi = cg_var_idx(_mbase.a); }
            _mbreg = -1;
            if (_mbvi >= 0 && cg_var_is_float(_mbvi) == 0) {
                _mbreg = arr_get(cg_var_promote, _mbvi);
            }
            if (_mbreg >= 0) {
                call(p.emit_fload_promoted_into, dreg, _mbreg, _moff);
                return 1;
            }
        }
        _mitmp = call(p.int_temp_alloc);
        cg_emit_int_into(n.a, _mitmp);
        call(p.emit_fload_mem_into, dreg, _mitmp);
        if (_mitmp >= 0) { call(p.int_temp_free, _mitmp); }
        return 1;
    }
    // T_BINOP: dreg = (left) OP (right). A promoted-leaf operand is read
    // straight from its register — no load, no temp. Otherwise the left
    // computes into dreg and the right into a freshly allocated temp.
    c0 = peek(cg_sbuf + unpack_s(n.a));
    op_code = 0;
    if (c0 == '-') { op_code = 1; }
    if (c0 == '*') { op_code = 2; }
    if (c0 == '/') { op_code = 3; }

    // Fused multiply-add fusion: `(left) + (a*b)` → fmadd, `(left) - (a*b)`
    // → fmsub. Fires when this op is + or - and the RIGHT child is a `*`
    // binop — the left-associative shape of a filter tap chain
    // (`b0*x + b1*x1 + b2*x2 - …`). The addend is the left operand (its
    // register reused when promoted, else computed into dreg); the two
    // multiplicands go to registers (promoted direct or a temp). One fused
    // op replaces fmul+fadd, halving the FP-port work and rounding once.
    if (c0 == '+' || c0 == '-') {
        auto rn: Node;
        rn = n.c;
        if (rn != 0 && rn.ntype == T_BINOP && unpack_l(rn.a) == 1 && peek(cg_sbuf + unpack_s(rn.a)) == '*') {
            auto a_node: Node, b_node: Node, addr_reg, fasrc, fbsrc, fta, ftb, alk, blk, fllk, fma_op;
            a_node = rn.b; b_node = rn.c;
            fllk = cg_float_leaf_kind(n.b);
            if (fllk > 0) { addr_reg = fllk; }
            else { cg_emit_float_into(n.b, dreg); addr_reg = dreg; }
            alk = cg_float_leaf_kind(a_node);
            fta = -1;
            if (alk > 0) { fasrc = alk; }
            else { fta = call(p.simd_temp_alloc); cg_emit_float_into(a_node, fta); fasrc = fta; }
            blk = cg_float_leaf_kind(b_node);
            ftb = -1;
            if (blk > 0) { fbsrc = blk; }
            else { ftb = call(p.simd_temp_alloc); cg_emit_float_into(b_node, ftb); fbsrc = ftb; }
            fma_op = 0;
            if (c0 == '-') { fma_op = 1; }
            call(p.emit_fma, fma_op, dreg, fasrc, fbsrc, addr_reg);
            if (ftb >= 0) { call(p.simd_temp_free, ftb); }
            if (fta >= 0) { call(p.simd_temp_free, fta); }
            return 0;
        }
    }

    lk = cg_float_leaf_kind(n.b);
    if (lk > 0) {
        lsrc = lk;
    } else {
        cg_emit_float_into(n.b, dreg);
        lsrc = dreg;
    }

    rk = cg_float_leaf_kind(n.c);
    tr = -1;
    if (rk > 0) {
        rsrc = rk;
    } else {
        tr = call(p.simd_temp_alloc);
        cg_emit_float_into(n.c, tr);
        rsrc = tr;
    }

    call(p.emit_fop_into, op_code, dreg, lsrc, rsrc);
    if (tr >= 0) { call(p.simd_temp_free, tr); }
    return 0;
}

// ── Integer compute-in-place (the int analog of the float trio above) ──
// Same shape as cg_float_leaf_kind / cg_float_tree_need / cg_emit_float_into,
// extended for the two integer-only leaf kinds the float tree lacked: an
// integer constant (materialised straight into its register) and the same
// plain frame/promoted local. Ops are the sign-agnostic `+ - * & | ^`
// (division and shifts are deferred — sdiv vs udiv depends on the operand's
// signedness, and shifts arrive with the memory-load leaves in a later
// slice). Comparisons and 2-char ops fall through to the accumulator path.

// Classify an integer-tree leaf. -1 = not eligible; 0 = needs
// materialisation into a register (a frame local OR an integer constant);
// a positive value = the callee-saved register a B3-promoted local lives in
// (read directly, no load).
cg_int_leaf_kind(nd) {
    auto n: Node, vi, fty, preg, lit_s, cidx, creg;
    if (nd == 0) { return -1; }
    n = nd;
    if (n.ntype == T_LIT) {
        lit_s = unpack_s(n.a);
        if (peek(cg_sbuf + lit_s) == '"') { return -1; }   // string literal
        if (cg_is_float_lit(n.a) == 1) { return -1; }       // float literal
        // A promoted hot constant reads straight from its callee-saved
        // register (no per-use movz/movk), exactly like a promoted local.
        cidx = cg_const_find(cg_parse_int(n.a));
        if (cidx >= 0) {
            creg = arr_get(cg_const_reg, cidx);
            if (creg >= 0) { return creg; }
        }
        return 0;                                           // integer constant
    }
    if (n.ntype != T_VAR) { return -1; }
    vi = cg_var_idx(n.a);
    if (vi < 0) { return -1; }                       // global / unknown
    if (cg_var_is_float(vi)) { return -1; }          // float local, not int
    if (arr_get(cg_var_stack, vi)) { return -1; }    // address-taken / struct
    fty = arr_get(cg_var_forced_ty, vi);
    if (ty_slice(fty) != SL_FULL) { return -1; }     // sub-word ints: diff load width
    preg = arr_get(cg_var_promote, vi);
    if (preg >= 0) { return preg; }                  // B3-promoted int register
    return 0;                                         // frame leaf
}

// Gap 1 of the rotary_tick investigation (the struct-field leaf extension
// above is gap 2): a float comparison's emit_cmp_flt is hardcoded to
// `fcmp d1, d0` — a fixed register convention, not a hardware requirement
// (confirmed reading _a64_emit_cmp_flt directly; ARM64's FCMP/x64's
// UCOMISD accept any two FP registers). The save-left/resolve dance
// upstream of it exists ENTIRELY to shuttle the left operand into that
// fixed d1 slot. Reusing cg_emit_float_into (gap 2) to evaluate each side
// into an arbitrary temp and comparing those directly removes the shuttle
// without touching emit_cmp_flt or the old path at all — this is a new,
// narrow sibling, not a restructuring.
//
// Returns (ok, cc). Budget is conservative: reserves a slot for EACH
// side's own destination on top of its internal need, since both sides'
// results must be live simultaneously for the final fcmp (unlike
// arithmetic's single accumulating destination, where a child's temps are
// freed before the next child is evaluated).
cg_try_float_cmp(n, op_l, c0, c1) {
    auto p: ChipPrimitives;
    auto cc, lneed, rneed, budget;
    p = cg_prim;
    cc = -1;
    if (c0 == '=' && c1 == '=') { cc = CG_CC_EQ; }
    if (c0 == '!' && c1 == '=') { cc = CG_CC_NE; }
    if (c0 == '<' && c1 == '=') { cc = CG_CC_LE; }
    if (c0 == '<' && op_l == 1) { cc = CG_CC_LT; }
    if (c0 == '>' && c1 == '=') { cc = CG_CC_GE; }
    if (c0 == '>' && op_l == 1) { cc = CG_CC_GT; }
    if (cc < 0) { return 0, 0; }
    lneed = cg_float_tree_need(n.b);
    if (lneed >= 999) { return 0, 0; }
    rneed = cg_float_tree_need(n.c);
    if (rneed >= 999) { return 0, 0; }
    budget = call(p.simd_temp_count);
    if (1 + lneed + 1 + rneed > budget) { return 0, 0; }
    return 1, cc;
}

// Evaluates both sides of a comparison via compute-in-place into fresh
// SIMD temps the caller owns (and must free, in reverse order, after
// consuming them). Precondition: cg_try_float_cmp(n, ...) already
// validated this fits the budget. Shared by the boolean-materializing
// path (cg_emit_float_cmp_into) and the branch-fusion path
// (cg_emit_cmp_to_branch's float case) below.
cg_float_cmp_operands_into(n) {
    auto p: ChipPrimitives, lt, rt;
    p = cg_prim;
    lt = call(p.simd_temp_alloc);
    cg_emit_float_into(n.b, lt);
    rt = call(p.simd_temp_alloc);
    cg_emit_float_into(n.c, rt);
    return lt, rt;
}

// Emits n's two sides via compute-in-place into fresh SIMD temps, then
// compares those temps directly into int_dreg (0/1). Precondition:
// cg_try_float_cmp(n, ...) already validated this fits the budget.
cg_emit_float_cmp_into(n, int_dreg, cc) {
    auto p: ChipPrimitives, lt, rt;
    p = cg_prim;
    lt, rt = cg_float_cmp_operands_into(n);
    call(p.emit_cmp_flt_into, int_dreg, lt, rt, cc);
    call(p.simd_temp_free, rt);
    call(p.simd_temp_free, lt);
}

// Sethi-Ullman temp need for an eligible integer tree, or 999 (forces the
// accumulator fallback). Same left-first recurrence as the float pass.
cg_int_tree_need(nd) {
    auto n: Node, t, c0, op_l, nl, nr, k, rc;
    if (nd == 0) { return 999; }
    n = nd; t = n.ntype;
    if (t == T_LIT || t == T_VAR) {
        if (cg_int_leaf_kind(nd) < 0) { return 999; }
        return 0;
    }
    // Memory-load leaf (`arr[i]` / `*(p)`): full-word integer loads only. The
    // field hint n.b is a TYPE, not a byte count — a float load belongs to the
    // float CIP, and a sub-word slice needs the sign/zero extension the
    // accumulator path performs. A plain subscript or deref leaves the hint 0,
    // which is exactly the full-word integer type (is_float_type 0 == 0,
    // ty_slice 0 == SL_FULL); the old `n.b != 8` test compared a type against a
    // byte width and so wrongly rejected every subscript load. The load reuses
    // the address register, so its need is just the address tree's.
    if (t == T_MEMLD) {
        if (is_float_type(n.b)) { return 999; }
        if (ty_slice(n.b) != SL_FULL) { return 999; }
        return cg_int_tree_need(n.a);
    }
    if (t == T_BINOP) {
        op_l = unpack_l(n.a);
        if (op_l != 1) { return 999; }               // 2-char ops (<< >> == …) excluded
        c0 = peek(cg_sbuf + unpack_s(n.a));
        if (c0 != '+' && c0 != '-' && c0 != '*' && c0 != '&' && c0 != '|' && c0 != '^') { return 999; }
        nl = cg_int_tree_need(n.b);
        if (nl >= 999) { return 999; }
        k = cg_int_leaf_kind(n.c);
        if (k > 0) {
            rc = 0;                                  // promoted right: read directly
        } else {
            nr = cg_int_tree_need(n.c);
            if (nr >= 999) { return 999; }
            rc = 1 + nr;
        }
        if (nl > rc) { return nl; }
        return rc;
    }
    return 999;
}

// True iff the CIP would emit `rhs` into its destination register in a SINGLE
// instruction reading only direct register leaves — a madd `(a*b) +/- c` or a
// binop `l OP c` where every operand is a promoted register (leaf_kind > 0).
// In that case the destination can BE the assignment's promoted target (the
// lone instruction reads all sources, then writes the destination, so it can
// never clobber a not-yet-read source — even when the target itself is one of
// the sources). Lets `s = s*A + C` emit `madd s, s, A, C` with no copy-back.
cg_assign_into_dest_ok(rhs) {
    auto n: Node, c0, op_l, l: Node, r: Node;
    if (rhs == 0) { return 0; }
    n = rhs;
    if (n.ntype != T_BINOP) { return 0; }
    op_l = unpack_l(n.a);
    if (op_l != 1) { return 0; }
    c0 = peek(cg_sbuf + unpack_s(n.a));
    l = n.b; r = n.c;
    // madd shape: (a*b) +/- c  or  c + (a*b), a/b/c all promoted leaves.
    if (c0 == '+' || c0 == '-') {
        if (l != 0 && l.ntype == T_BINOP && unpack_l(l.a) == 1 && peek(cg_sbuf + unpack_s(l.a)) == '*' &&
            cg_int_leaf_kind(l.b) > 0 && cg_int_leaf_kind(l.c) > 0 && cg_int_leaf_kind(r) > 0 &&
            cg_const_pow2(l.c) < 0) { return 1; }
        if (c0 == '+' && r != 0 && r.ntype == T_BINOP && unpack_l(r.a) == 1 && peek(cg_sbuf + unpack_s(r.a)) == '*' &&
            cg_int_leaf_kind(r.b) > 0 && cg_int_leaf_kind(r.c) > 0 && cg_int_leaf_kind(l) > 0 &&
            cg_const_pow2(r.c) < 0) { return 1; }
    }
    // single binop over two promoted-register leaves.
    if (c0 == '+' || c0 == '-' || c0 == '*' || c0 == '&' || c0 == '|' || c0 == '^') {
        if (cg_int_leaf_kind(l) > 0 && cg_int_leaf_kind(r) > 0) { return 1; }
    }
    return 0;
}

// Does variable `vi` appear anywhere in `nd`? Used to prove a destination
// register is free of the assignment target before computing an expression
// straight into it (no aliasing with a not-yet-read source). Unknown node
// types return 1 (conservative — assume the variable could be used).
cg_node_uses_var(nd, vi) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_VAR) { if (cg_var_idx(n.a) == vi) { return 1; } return 0; }
    if (t == T_LIT || t == T_DECL || t == T_NOP || t == T_BREAK || t == T_CONTINUE) { return 0; }
    if (t == T_BINOP) {                                  // n.a is the operator
        if (cg_node_uses_var(n.b, vi)) { return 1; }
        return cg_node_uses_var(n.c, vi);
    }
    if (t == T_TERNARY) {
        if (cg_node_uses_var(n.a, vi)) { return 1; }
        if (cg_node_uses_var(n.b, vi)) { return 1; }
        return cg_node_uses_var(n.c, vi);
    }
    if (t == T_ASSIGN || t == T_MEMST) {                 // n.c is hint / targets
        if (cg_node_uses_var(n.a, vi)) { return 1; }
        return cg_node_uses_var(n.b, vi);
    }
    if (t == T_UNARY) { return cg_node_uses_var(n.b, vi); }
    if (t == T_MEMLD || t == T_ADDR || t == T_RET) { return cg_node_uses_var(n.a, vi); }
    if (t == T_CALL || t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (cg_node_uses_var(arr[i], vi)) { return 1; } }
        return 0;
    }
    return 1;
}

// If `nd` is an integer literal equal to 2^k for k in [1,63], return k;
// otherwise -1. Lets `x * 2^k` strength-reduce into `x << k` — a shift is
// cheaper than a multiply and skips materialising the constant.
cg_const_pow2(nd) {
    auto n: Node, v, k;
    if (nd == 0) { return -1; }
    n = nd;
    if (n.ntype != T_LIT) { return -1; }
    if (peek(cg_sbuf + unpack_s(n.a)) == '"') { return -1; }   // string literal
    if (cg_is_float_lit(n.a) == 1) { return -1; }               // float literal
    v = cg_parse_int(n.a);
    if (v < 2) { return -1; }
    if ((v & (v - 1)) != 0) { return -1; }                      // not a power of two
    k = 0;
    while (v > 1) { v = v >> 1; k++; }
    if (k > 63) { return -1; }
    return k;
}

// Emit an eligible integer tree (validated/budgeted by cg_int_tree_need)
// directly into x<dreg>: the left operand reuses dreg down the left spine,
// each right operand lands in a freshly allocated GP temp, the op writes
// its destination. No value shuttles through x0.
cg_emit_int_into(nd, dreg) {
    auto p: ChipPrimitives;
    auto n: Node, t, vi, off, c0, op_code, lsrc, rsrc, tr, lk, rk;
    p = cg_prim;
    n = nd; t = n.ntype;
    if (t == T_LIT) {
        auto _civ, _cix, _cir;
        _civ = cg_parse_int(n.a);
        _cix = cg_const_find(_civ);
        if (_cix >= 0) {
            _cir = arr_get(cg_const_reg, _cix);
            if (_cir >= 0) { call(p.emit_mov_reg_reg, dreg, _cir); return 0; }
        }
        call(p.emit_iconst_into, dreg, _civ);
        return 0;
    }
    if (t == T_VAR) {
        lk = cg_int_leaf_kind(nd);
        if (lk > 0) {
            call(p.emit_mov_reg_reg, dreg, lk);      // promoted: mov x<dreg>, x<lk>
        } else {
            vi = cg_var_idx(n.a);
            off = arr_get(cg_var_off, vi);
            call(p.emit_iload_var_into, dreg, off);
        }
        return 0;
    }
    if (t == T_MEMLD) {
        // Induction pointer walk: a `base[i]` leaf loads through the base's
        // walking register (post-incremented) instead of recomputing the
        // address. The CIP only sees full-word integer loads, so no hint check.
        auto _ivk;
        _ivk = cg_iv_match(n.a);
        if (_ivk >= 0) {
            call(p.emit_iv_load, dreg, arr_get(cg_iv_reg, _ivk));
            return 0;
        }
        // Compute the address tree into dreg, then load through it.
        cg_emit_int_into(n.a, dreg);
        call(p.emit_iload_mem_into, dreg);
        return 0;
    }
    // T_BINOP: dreg = (left) OP (right).
    c0 = peek(cg_sbuf + unpack_s(n.a));
    op_code = 0;
    if (c0 == '-') { op_code = 1; }
    if (c0 == '*') { op_code = 2; }
    if (c0 == '&') { op_code = 4; }
    if (c0 == '|') { op_code = 5; }
    if (c0 == '^') { op_code = 6; }
    // Integer fused multiply-add: `(a*b) + c` or `c + (a*b)` -> madd, and
    // `c - (a*b)` -> msub. One fused op replaces the mul + add/sub and reads
    // the promoted operands directly. The integer twin of the float CIP's
    // fmadd fusion. Addition is commutative so either side may hold the
    // product; subtraction only fuses when the product is the subtrahend
    // (msub computes addend - product, never product - addend).
    if (c0 == '+' || c0 == '-') {
        auto _ml: Node, _mr: Node, _prod: Node, _add: Node, _fop;
        _ml = n.b; _mr = n.c;
        _prod = 0; _add = 0; _fop = -1;
        if (c0 == '-') {
            if (_mr != 0 && _mr.ntype == T_BINOP && unpack_l(_mr.a) == 1 && peek(cg_sbuf + unpack_s(_mr.a)) == '*') {
                _prod = _mr; _add = _ml; _fop = 1;
            }
        } else {
            if (_ml != 0 && _ml.ntype == T_BINOP && unpack_l(_ml.a) == 1 && peek(cg_sbuf + unpack_s(_ml.a)) == '*') {
                _prod = _ml; _add = _mr; _fop = 0;
            } else if (_mr != 0 && _mr.ntype == T_BINOP && unpack_l(_mr.a) == 1 && peek(cg_sbuf + unpack_s(_mr.a)) == '*') {
                _prod = _mr; _add = _ml; _fop = 0;
            }
        }
        // Skip when the product is a strength-reducible `x * 2^k` — that lowers
        // to a cheaper shift (and array-index arithmetic `base + i*8` lives
        // here), so fusing it would lose the shift.
        if (_fop >= 0 && cg_const_pow2(_prod.c) < 0) {
            auto _fa: Node, _fb: Node, _asrc, _nsrc, _msrc, _ta, _tn, _tm, _alk, _nlk, _mlk;
            _fa = _prod.b; _fb = _prod.c;
            _alk = cg_int_leaf_kind(_add);
            if (_alk > 0) { _asrc = _alk; }
            else { cg_emit_int_into(_add, dreg); _asrc = dreg; }
            _nlk = cg_int_leaf_kind(_fa);
            _tn = -1;
            if (_nlk > 0) { _nsrc = _nlk; }
            else { _tn = call(p.int_temp_alloc); cg_emit_int_into(_fa, _tn); _nsrc = _tn; }
            _mlk = cg_int_leaf_kind(_fb);
            _tm = -1;
            if (_mlk > 0) { _msrc = _mlk; }
            else { _tm = call(p.int_temp_alloc); cg_emit_int_into(_fb, _tm); _msrc = _tm; }
            call(p.emit_imadd, _fop, dreg, _nsrc, _msrc, _asrc);
            if (_tm >= 0) { call(p.int_temp_free, _tm); }
            if (_tn >= 0) { call(p.int_temp_free, _tn); }
            return 0;
        }
    }
    // Strength reduction: `x * 2^k` is emitted as `x << k`. The left operand
    // (promoted leaf or computed into dreg) is shifted into dreg directly.
    if (c0 == '*') {
        auto _p2k;
        _p2k = cg_const_pow2(n.c);
        if (_p2k >= 0) {
            lk = cg_int_leaf_kind(n.b);
            if (lk > 0) { lsrc = lk; }
            else { cg_emit_int_into(n.b, dreg); lsrc = dreg; }
            call(p.emit_ishl_imm_into, dreg, lsrc, _p2k);
            return 0;
        }
    }
    lk = cg_int_leaf_kind(n.b);
    if (lk > 0) { lsrc = lk; }
    else { cg_emit_int_into(n.b, dreg); lsrc = dreg; }
    rk = cg_int_leaf_kind(n.c);
    tr = -1;
    if (rk > 0) { rsrc = rk; }
    else { tr = call(p.int_temp_alloc); cg_emit_int_into(n.c, tr); rsrc = tr; }
    call(p.emit_iop_into, op_code, dreg, lsrc, rsrc);
    if (tr >= 0) { call(p.int_temp_free, tr); }
    return 0;
}

// ── Induction-variable pointer walk ──────────────────────────
//
// A counted loop `for (i = 0; i < n; i++) { ...base[i]... }` recomputes
// `base + i*8` on every array access. When `base` is a promoted, loop-
// invariant variable used ONLY as `base[i]` (with the loop's induction
// variable) ANYWHERE in the function, its register becomes a walking pointer:
// each access loads/stores through `[base_reg]` and post-increments it by 8,
// so the per-iteration index math disappears — what gcc -O2 emits. Reusing the
// base's own register adds no register pressure. Gated hard (cg_iv_detect); any
// loop that does not match keeps the normal codegen. a64-only (post-index).

global cg_iv_active;       // count of live induction pointers for the current loop
global cg_iv_base;         // arr of base variable indices
global cg_iv_reg;          // arr of their promoted registers (walking pointers)
global cg_iv_idx;          // the induction variable index
global cg_iv_tmp_bases;    // scratch base-collection array (detection only)
global cg_cur_body;        // current function's statement array (whole-function scan)
global cg_cur_bcnt;        // current function's statement count

// Address shape `base + idx*8` for the active induction idx, base one of the
// active bases → returns the base's slot; else -1.
cg_iv_match(nd) {
    auto n: Node, l: Node, r: Node, rl: Node, rr: Node, bvi, k;
    if (cg_iv_active == 0 || nd == 0) { return -1; }
    n = nd;
    if (n.ntype != T_BINOP) { return -1; }
    if (unpack_l(n.a) != 1 || peek(cg_sbuf + unpack_s(n.a)) != '+') { return -1; }
    l = n.b; r = n.c;
    if (l == 0 || l.ntype != T_VAR || r == 0 || r.ntype != T_BINOP) { return -1; }
    if (unpack_l(r.a) != 1 || peek(cg_sbuf + unpack_s(r.a)) != '*') { return -1; }
    rl = r.b; rr = r.c;
    if (rl == 0 || rl.ntype != T_VAR || rr == 0 || rr.ntype != T_LIT) { return -1; }
    if (cg_parse_int(rr.a) != 8 || cg_var_idx(rl.a) != cg_iv_idx) { return -1; }
    bvi = cg_var_idx(l.a);
    for (k = 0; k < cg_iv_active; k++) {
        if (arr_get(cg_iv_base, k) == bvi) { return k; }
    }
    return -1;
}

// Count references to `bvi` that are NOT the base of a `bvi[idx]` access. Any
// such bare use makes the pointer-walk rewrite unsafe (the register no longer
// holds `base`). Mirrors cg_b3_walk's coverage; an unrecognised node type
// (e.g. T_SWITCH) is treated as unsafe so it can never produce a false "safe".
cg_iv_bare_uses(nd, bvi) {
    auto n: Node, t, c, arr, cnt, i, l: Node, r: Node, rl: Node, rr: Node;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_BINOP && unpack_l(n.a) == 1 && peek(cg_sbuf + unpack_s(n.a)) == '+') {
        l = n.b; r = n.c;
        if (l != 0 && l.ntype == T_VAR && cg_var_idx(l.a) == bvi &&
            r != 0 && r.ntype == T_BINOP && unpack_l(r.a) == 1 && peek(cg_sbuf + unpack_s(r.a)) == '*') {
            rl = r.b; rr = r.c;
            if (rl != 0 && rl.ntype == T_VAR && cg_var_idx(rl.a) == cg_iv_idx &&
                rr != 0 && rr.ntype == T_LIT && cg_parse_int(rr.a) == 8) {
                return cg_iv_bare_uses(r, bvi);     // safe indexed use: scan only the index
            }
        }
    }
    if (t == T_VAR) { if (cg_var_idx(n.a) == bvi) { return 1; } return 0; }
    if (t == T_LIT || t == T_DECL || t == T_NOP || t == T_BREAK || t == T_CONTINUE) { return 0; }
    c = 0;
    switch (t) {
    T_BINOP    { c = cg_iv_bare_uses(n.b, bvi) + cg_iv_bare_uses(n.c, bvi); }
    T_ASSIGN   {
        c = cg_iv_bare_uses(n.a, bvi) + cg_iv_bare_uses(n.b, bvi);
        // Multi-value assignment: the remaining LHS targets live in n.c[1..n.d].
        if (n.d > 1) { arr = n.c; cnt = n.d; for (i = 1; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); } }
    }
    T_MEMST    { c = cg_iv_bare_uses(n.a, bvi) + cg_iv_bare_uses(n.b, bvi); }
    T_UNARY    { c = cg_iv_bare_uses(n.b, bvi); }
    T_MEMLD    { c = cg_iv_bare_uses(n.a, bvi); }
    T_ADDR     { c = cg_iv_bare_uses(n.a, bvi); }
    T_RET      { c = cg_iv_bare_uses(n.a, bvi); }
    T_TERNARY  { c = cg_iv_bare_uses(n.a, bvi) + cg_iv_bare_uses(n.b, bvi) + cg_iv_bare_uses(n.c, bvi); }
    T_CALL {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); }
    }
    T_IF {
        c = cg_iv_bare_uses(n.a, bvi);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); }
        if (n.e > 0) { arr = n.d; cnt = n.e; for (i = 0; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); } }
    }
    T_WHILE {
        c = cg_iv_bare_uses(n.a, bvi);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); }
        if (n.e != 0) { c = c + cg_iv_bare_uses(n.e, bvi); }
    }
    T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { c = c + cg_iv_bare_uses(arr[i], bvi); }
    }
    else { c = 1000000; }
    }
    return c;
}

// True if the subtree contains a node of type `want` (used to reject loops with
// a nested loop or a `continue`, either of which breaks the walk's invariants).
cg_iv_subtree_has(nd, want) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == want) { return 1; }
    if (t == T_VAR || t == T_LIT || t == T_DECL || t == T_NOP || t == T_BREAK || t == T_CONTINUE) { return 0; }
    if (t == T_BINOP) {                                   // n.a is the operator, not a node
        if (cg_iv_subtree_has(n.b, want)) { return 1; }
        return cg_iv_subtree_has(n.c, want);
    }
    if (t == T_TERNARY) {
        if (cg_iv_subtree_has(n.a, want)) { return 1; }
        if (cg_iv_subtree_has(n.b, want)) { return 1; }
        return cg_iv_subtree_has(n.c, want);
    }
    if (t == T_ASSIGN || t == T_MEMST) {                  // n.c is a field hint / targets, not a node
        if (cg_iv_subtree_has(n.a, want)) { return 1; }
        return cg_iv_subtree_has(n.b, want);
    }
    if (t == T_UNARY) { return cg_iv_subtree_has(n.b, want); }
    if (t == T_MEMLD || t == T_ADDR || t == T_RET) { return cg_iv_subtree_has(n.a, want); }
    if (t == T_CALL || t == T_BLOCK) {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (cg_iv_subtree_has(arr[i], want)) { return 1; } }
        return 0;
    }
    if (t == T_IF) {
        if (cg_iv_subtree_has(n.a, want)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (cg_iv_subtree_has(arr[i], want)) { return 1; } }
        if (n.e > 0) { arr = n.d; cnt = n.e; for (i = 0; i < cnt; i++) { if (cg_iv_subtree_has(arr[i], want)) { return 1; } } }
        return 0;
    }
    if (t == T_WHILE) {
        if (cg_iv_subtree_has(n.a, want)) { return 1; }
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { if (cg_iv_subtree_has(arr[i], want)) { return 1; } }
        if (n.e != 0) { return cg_iv_subtree_has(n.e, want); }
        return 0;
    }
    return 1;        // unknown type → assume it could contain `want` (conservative)
}

// If `addr` is `base + idx*8` and `hint` is a full-word integer, record the
// base variable index in cg_iv_tmp_bases (deduplicated).
cg_iv_try_add_base(addr, hint) {
    auto a: Node, l: Node, r: Node, rl: Node, rr: Node, bvi, j;
    if (addr == 0) { return 0; }
    if (is_float_type(hint) || ty_slice(hint) != SL_FULL) { return 0; }
    a = addr;
    if (a.ntype != T_BINOP || unpack_l(a.a) != 1 || peek(cg_sbuf + unpack_s(a.a)) != '+') { return 0; }
    l = a.b; r = a.c;
    if (l == 0 || l.ntype != T_VAR || r == 0 || r.ntype != T_BINOP) { return 0; }
    if (unpack_l(r.a) != 1 || peek(cg_sbuf + unpack_s(r.a)) != '*') { return 0; }
    rl = r.b; rr = r.c;
    if (rl == 0 || rl.ntype != T_VAR || cg_var_idx(rl.a) != cg_iv_idx) { return 0; }
    if (rr == 0 || rr.ntype != T_LIT || cg_parse_int(rr.a) != 8) { return 0; }
    bvi = cg_var_idx(l.a);
    if (bvi < 0) { return 0; }
    for (j = 0; j < arr_len(cg_iv_tmp_bases); j++) {
        if (arr_get(cg_iv_tmp_bases, j) == bvi) { return 0; }
    }
    cg_iv_tmp_bases = arr_push(cg_iv_tmp_bases, bvi);
}

// Walk a subtree collecting candidate bases from `base[idx]` loads/stores.
cg_iv_collect(nd) {
    auto n: Node, t, arr, cnt, i;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    if (t == T_MEMLD) { cg_iv_try_add_base(n.a, n.b); cg_iv_collect(n.a); return 0; }
    if (t == T_MEMST) { cg_iv_try_add_base(n.a, n.c); cg_iv_collect(n.a); cg_iv_collect(n.b); return 0; }
    if (t == T_VAR || t == T_LIT || t == T_DECL || t == T_NOP || t == T_BREAK || t == T_CONTINUE || t == T_ADDR) { return 0; }
    switch (t) {
    T_BINOP { cg_iv_collect(n.b); cg_iv_collect(n.c); }   // n.a is the operator, not a node
    T_ASSIGN { cg_iv_collect(n.a); cg_iv_collect(n.b); }  // n.c is multi-assign targets, not a node
    T_TERNARY { cg_iv_collect(n.a); cg_iv_collect(n.b); cg_iv_collect(n.c); }
    T_UNARY { cg_iv_collect(n.b); }
    T_RET   { cg_iv_collect(n.a); }
    T_CALL, T_BLOCK {
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_iv_collect(arr[i]); }
    }
    T_IF {
        cg_iv_collect(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_iv_collect(arr[i]); }
        if (n.e > 0) { arr = n.d; cnt = n.e; for (i = 0; i < cnt; i++) { cg_iv_collect(arr[i]); } }
    }
    T_WHILE {
        cg_iv_collect(n.a);
        arr = n.b; cnt = n.c;
        for (i = 0; i < cnt; i++) { cg_iv_collect(arr[i]); }
    }
    else { }
    }
    return 0;
}

// Decide whether the counted loop `while_nd` can run as a pointer walk; if so,
// populate cg_iv_* and emit the pre-loop pointer setup, returning 1.
cg_iv_detect(while_nd) {
    auto p: ChipPrimitives, n: Node, step: Node, sl: Node, sr: Node, srl: Node, srr: Node;
    auto idxv, bvi, i, found, bi, j;
    p = cg_prim;
    cg_iv_active = 0;
    if (call(p.iv_supported) == 0) { return 0; }
    n = while_nd;
    step = n.e;
    if (step == 0 || step.ntype != T_ASSIGN) { return 0; }
    sl = step.a; sr = step.b;
    if (sl == 0 || sl.ntype != T_VAR) { return 0; }
    idxv = cg_var_idx(sl.a);
    if (idxv < 0 || arr_get(cg_var_promote, idxv) < 0) { return 0; }
    if (sr == 0 || sr.ntype != T_BINOP || unpack_l(sr.a) != 1 || peek(cg_sbuf + unpack_s(sr.a)) != '+') { return 0; }
    srl = sr.b; srr = sr.c;
    if (srl == 0 || srl.ntype != T_VAR || cg_var_idx(srl.a) != idxv) { return 0; }
    if (srr == 0 || srr.ntype != T_LIT || cg_parse_int(srr.a) != 1) { return 0; }
    // Reject anything that breaks the walk invariants: a nested loop (would
    // clobber cg_iv_*) or a `continue` (would skip an access's post-increment).
    for (i = 0; i < n.c; i++) {
        bi = *(n.b + i * 8);
        if (cg_iv_subtree_has(bi, T_WHILE)) { return 0; }
        if (cg_iv_subtree_has(bi, T_CONTINUE)) { return 0; }
    }
    cg_iv_idx = idxv;
    cg_iv_tmp_bases = arr_new();
    for (i = 0; i < n.c; i++) { cg_iv_collect(*(n.b + i * 8)); }
    cg_iv_base = arr_new();
    cg_iv_reg = arr_new();
    found = 0;
    for (i = 0; i < arr_len(cg_iv_tmp_bases); i++) {
        bvi = arr_get(cg_iv_tmp_bases, i);
        if (arr_get(cg_var_promote, bvi) < 0) { continue; }
        // Every reference to bvi in the WHOLE function must be a bvi[idx] access.
        j = 0;
        for (j = 0; j < cg_cur_bcnt; j++) {
            if (cg_iv_bare_uses(*(cg_cur_body + j * 8), bvi) != 0) { break; }
        }
        if (j < cg_cur_bcnt) { continue; }       // a bare use was found
        cg_iv_base = arr_push(cg_iv_base, bvi);
        cg_iv_reg  = arr_push(cg_iv_reg, arr_get(cg_var_promote, bvi));
        found++;
    }
    if (found == 0) { return 0; }
    cg_iv_active = found;
    for (i = 0; i < found; i++) {
        call(p.emit_iv_setup, arr_get(cg_iv_reg, i), arr_get(cg_var_promote, cg_iv_idx));
    }
    return 1;
}

// Loop/if condition fusion: if `cond_node` is a SIGNED INTEGER comparison,
// evaluate its operands and branch to `exit_lbl` when the comparison is FALSE
// (cmp + b.cc), returning 1. Otherwise return 0 and the caller emits the
// boolean then tests it (cmp + cset + cbz). Float (fcmp) and unsigned (LO/LS/
// HI/HS condition codes) comparisons keep the existing boolean path.
cg_emit_cmp_to_branch(cond_node, exit_lbl) {
    auto p: ChipPrimitives, n: Node, op_s, op_l, c0, c1, cond_id;
    auto lhs_n: Node, lhs_ty, lty, rty, save_token, left_reg, clk, crk;
    p = cg_prim;
    if (cond_node == 0) { return 0; }
    n = cond_node;
    if (n.ntype != T_BINOP) { return 0; }
    op_s = unpack_s(n.a); op_l = unpack_l(n.a);
    c0 = peek(cg_sbuf + op_s);
    c1 = 0; if (op_l > 1) { c1 = peek(cg_sbuf + op_s + 1); }
    cond_id = -1;
    if (c0 == '=' && c1 == '=') { cond_id = CG_CC_EQ; }
    if (c0 == '!' && c1 == '=') { cond_id = CG_CC_NE; }
    if (c0 == '<' && c1 == '=') { cond_id = CG_CC_LE; }
    if (c0 == '>' && c1 == '=') { cond_id = CG_CC_GE; }
    if (c0 == '<' && op_l == 1) { cond_id = CG_CC_LT; }
    if (c0 == '>' && op_l == 1) { cond_id = CG_CC_GT; }
    if (cond_id < 0) { return 0; }
    lhs_n = n.b;
    lhs_ty = lhs_n.itype;
    if (is_float_type(lhs_ty)) {
        // Float branch fusion — the same idea as the integer path below,
        // reusing the float-CIP machinery (cg_try_float_cmp validates the
        // shape + budget; cg_float_cmp_operands_into evaluates both sides
        // into arbitrary temps) to branch directly off fcmp's flags. No
        // cset, no boolean materialization: `if (r.cur < r.tgt)` becomes
        // fcmp + b.cc instead of fcmp + cset + cbz. Found re-disassembling
        // rotary_tick after the struct-field/comparison/literal float-CIP
        // trio shipped — these were the last fcmp/cset/cbz triplets left.
        auto _fb_ok, _fb_cc, _fb_lt, _fb_rt;
        _fb_ok, _fb_cc = cg_try_float_cmp(n, op_l, c0, c1);
        if (_fb_ok == 0) { return 0; }
        _fb_lt, _fb_rt = cg_float_cmp_operands_into(n);
        call(p.emit_cmp_flt_branch, _fb_cc, _fb_lt, _fb_rt, exit_lbl);
        call(p.simd_temp_free, _fb_rt);
        call(p.simd_temp_free, _fb_lt);
        return 1;
    }
    if (is_unsigned_type(lhs_ty)) { return 0; }
    // Both operands already in registers (promoted leaves): compare them
    // directly, no copy to scratch — `while (i < n)` becomes `cmp i, n; b.ge`.
    clk = cg_int_leaf_kind(n.b);
    crk = cg_int_leaf_kind(n.c);
    if (clk > 0 && crk > 0) {
        call(p.emit_cmp_branch_rr, cond_id, clk, crk, exit_lbl);
        return 1;
    }
    // Evaluate operands like the BINOP comparison path, then branch instead of
    // materialising a boolean.
    lty = call(p.emit_node, n.b);
    save_token = call(p.emit_binop_save_left, cg_has_call(n.c), lty);
    rty = call(p.emit_node, n.c);
    left_reg = call(p.emit_binop_resolve, save_token, 0, lty, rty);
    call(p.emit_cmp_branch, cond_id, left_reg, exit_lbl);
    return 1;
}

// Recognizes the canonical base+const-offset address shape
// (T_BINOP('+', base, T_LIT) — what struct-field access and fixed-index
// array access always parse to) and, when safe, returns the base node
// plus the offset value so the caller can emit ONE addressing-mode load/
// store instead of computing the address via a separate `add`.
//
// "Safe" means the offset fits EVERY access width's encoding: ARM64's
// LDR/STR unsigned-offset immediate is a 12-bit field scaled by the
// access size (so a uoff that's a multiple of 8 and under 32760 is fine
// for a double load, but the SAME numeric value divided by 4 might
// overflow 12 bits for a narrower access) — rather than track which
// width will be used here, this picks one bound that is safe for every
// width B++ has (byte through double): offset in 0..4095 and a multiple
// of 8. Real struct field offsets in this codebase are always far under
// this (every field is a full 8-byte word slot unless sliced, so
// offsets are 0, 8, 16, ... by construction) — the bound exists so a
// pathological future case falls back to the always-correct path
// (compute the full address via `add`) instead of risking a corrupted
// encoding, never so it can silently miscompile something large.
//
// `fh` is the access's field-hint (T_MEMLD.b / T_MEMST.c) — needed
// because ARM64's unsigned-offset immediate is scaled by the access
// width: 16 bytes for the SIMD `:double` q-register path, 8 for every
// scalar float/word width this primitive loads/stores (all <= 8 bytes,
// narrower slices use the same 8-aligned base load + a bitfield extract
// — see `_a64_emit_memld_load`'s SL_BIT..SL_BIT7 case). Dividing an
// offset by the wrong scale silently truncates it (8 / 16 == 0) instead
// of erroring, so this picks the alignment the ACTUAL access needs,
// not a single one-size-fits-all guess.
//
// Returns (ok, base_node, offset). When ok == 0, base_node/offset are
// not meaningful — caller must emit the ORIGINAL address node unchanged.
cg_try_const_offset(nd, fh) {
    auto n: Node, c: Node, off, need_align;
    if (nd == 0) { return 0, 0, 0; }
    n = nd;
    if (n.ntype != T_BINOP) { return 0, 0, 0; }
    if (cg_str_eq(n.a, "+", 1) == 0) { return 0, 0, 0; }
    if (n.c == 0) { return 0, 0, 0; }
    c = n.c;
    if (c.ntype != T_LIT) { return 0, 0, 0; }
    off = parse_int_lit_value(c.a);
    if (off < 0 || off > 4095) { return 0, 0, 0; }
    if (is_float_type(fh) && ty_slice(fh) == SL_DOUBLE) {
        need_align = 16;
    } else {
        need_align = 8;
    }
    if (off % need_align != 0) { return 0, 0, 0; }
    return 1, n.b, off;
}

// Shared by T_MEMLD and every T_MEMST store path (each chip's
// emit_memst_int / emit_memst_float_scalar / emit_memst_float_simd):
// resolves a load/store's address expression into the cg_addr_const_off
// / cg_addr_const_base convention those primitives read instead of
// hardcoding "address is in x0/rax, offset 0".
//
// Evaluates `addr` into the accumulator and returns its ety — UNLESS
// `addr` is the base+const-offset shape AND that base is already a
// B3-promoted register, in which case NOTHING is evaluated (ety
// returned as 0): the load/store will read straight through the
// promoted register as its own base, with the constant folded into its
// own addressing mode.
//
// Always sets the globals fresh (resets to the "use x0, offset 0"
// defaults, then overwrites if the fast path applies) — callers never
// need to reset before calling this. Callers DO still need to reset
// both globals back to their defaults once the load/store primitive
// that actually consumes them has run (mirrors free()-after-use; see
// every call site below) — this function only guarantees its OWN
// output is correct, not that some EARLIER, unrelated consumption left
// the globals clean walking in.
cg_emit_addr(addr, fh) {
    auto p: ChipPrimitives;
    auto _ok, _base: Node, _off, _bvi, _breg, ety;
    p = cg_prim;
    _ok, _base, _off = cg_try_const_offset(addr, fh);
    _breg = -1;
    if (_ok) {
        _bvi = -1;
        if (_base.ntype == T_VAR) { _bvi = cg_var_idx(_base.a); }
        if (_bvi >= 0 && cg_var_is_float(_bvi) == 0) {
            _breg = arr_get(cg_var_promote, _bvi);
        }
    }
    if (_breg >= 0) {
        ety = 0;
    } else if (_ok) {
        ety = call(p.emit_node, _base);
    } else {
        ety = call(p.emit_node, addr);
    }
    // Set AFTER the (possibly recursive) emit_node call above, never
    // before — the base can itself be another const-offset T_MEMLD
    // (`*(a.frames + 0)`, where the address of THIS access is
    // `a.frames`'s LOADED VALUE, itself a struct-field read), and that
    // nested call runs this exact same function, resetting both globals
    // to their defaults right before it returns. Setting this level's
    // values first and recursing afterward would let the nested call's
    // own cleanup silently clobber them — a real regression
    // (test_modulab_character), not a hypothetical one.
    cg_addr_const_off = 0;
    cg_addr_const_base = -1;
    if (_ok) {
        cg_addr_const_off = _off;
        if (_breg >= 0) { cg_addr_const_base = _breg; }
    }
    return ety;
}

// Wave 21 takeover: the spine owns expression emission for every
// AST case. Eight cases handled inline (T_LIT, T_VAR including
// stack-struct address-of via emit_addr_stack_struct, T_TERNARY,
// T_UNARY, T_CALL, T_MEMLD, T_ADDR, T_BINOP via emit_binop_save_left
// + emit_binop_resolve). The fallback at the end of this function
// is reachable only when validate lets through an ntype the parser
// shouldn't be emitting in expression position; treat it as a hard
// codegen-side bug and panic with the offending ntype so the
// regression is named.
cg_emit_node(nd) {
    auto p: ChipPrimitives;
    auto n: Node;
    auto t, vi, ety, ety_then, lbl_else, lbl_done;
    p = cg_prim;
    if (nd == 0) {
        call(p.emit_mov_zero);
        return 0;
    }
    n = nd; t = n.ntype;

    // T_LIT / T_VAR (non-stack) / T_UNARY all have established
    // portable helpers that route to cg_prim.
    if (t == T_LIT) { return cg_emit_lit(n.a); }
    if (t == T_VAR) {
        vi = cg_var_idx(n.a);
        // Stack-struct address-of uses the chip's emit_addr_stack_struct
        // primitive (add-imm on aarch64, lea on x86_64).
        if (vi >= 0 && arr_get(cg_var_stack, vi)) {
            call(p.emit_addr_stack_struct, arr_get(cg_var_off, vi));
            return 0;
        }
        return cg_emit_var(n.a);
    }

    // T_TERNARY: short-circuited conditional expression. The parser
    // lowers `&&` / `||` to this so codegen sees exactly one branch
    // evaluated per call. Both arms are expected to agree on type.
    if (t == T_TERNARY) {
        ety = call(p.emit_node, n.a);
        if (ety == 1) { call(p.emit_fcond_to_int_truth); }
        lbl_else = call(p.emit_new_label);
        lbl_done = call(p.emit_new_label);
        call(p.emit_branch_if_zero, lbl_else);
        ety_then = call(p.emit_node, n.b);
        call(p.emit_jump, lbl_done);
        call(p.emit_label, lbl_else);
        call(p.emit_node, n.c);
        call(p.emit_label, lbl_done);
        return ety_then;
    }

    // T_UNARY: walk operand, dispatch operator.
    if (t == T_UNARY) {
        auto uty;
        uty = call(p.emit_node, n.b);
        return cg_emit_unary(n.a, uty);
    }

    // T_CALL delegates to the existing spine orchestrator.
    if (t == T_CALL) { return cg_emit_call(n); }

    // T_MEMLD: *(ptr) — load with sub-word dispatch via field hint.
    if (t == T_MEMLD) {
        // Induction pointer walk: a full-word integer `base[i]` loads through
        // the base's walking register and post-increments it (no address math).
        auto _ivk;
        _ivk = cg_iv_match(n.a);
        if (_ivk >= 0 && is_float_type(n.b) == 0 && ty_slice(n.b) == SL_FULL) {
            call(p.emit_iv_load, 0, arr_get(cg_iv_reg, _ivk));
            return 0;
        }
        auto _mret;
        ety = cg_emit_addr(n.a, n.b);
        if (ety == 1) { call(p.emit_demote_flt_to_int); }
        _mret = call(p.emit_memld_load, n.b);
        cg_addr_const_off = 0;
        cg_addr_const_base = -1;
        return _mret;
    }

    // T_ADDR: &x. Locals / globals take straight primitive paths;
    // the stack-struct case arrives here via the T_VAR branch above
    // which already falls back to the chip walker.
    if (t == T_ADDR) {
        auto child: Node;
        child = n.a;
        if (child != 0 && child.ntype == T_VAR) {
            vi = cg_var_idx(child.a);
            if (vi >= 0) {
                call(p.emit_addr_local, arr_get(cg_var_off, vi));
                return 0;
            }
            call(p.emit_addr_global, child.a);
            return 0;
        }
        return 0;
    }

    // T_BINOP: evaluate left, save via chip primitive (picks freelist
    // on aarch64 / stack on x86_64), evaluate right, resolve via
    // chip primitive (which handles sub-word coercion + retrieves
    // left into the correct register). Operator dispatch lands on
    // the existing arithmetic / comparison primitives.
    if (t == T_BINOP) {
        auto op_s, op_l, c0, c1, is_io, lty, rty, use_flt;
        auto save_token, left_reg_int;

        // F.2.c: a pure float `+ - * /` tree computes in place, bypassing
        // the accumulator save/resolve dance below. The gate compares the
        // tree's temp need with the chip's pool size; a chip without an FP
        // freelist returns 0 and always falls through to the dance.
        if (cg_float_tree_need(n) <= call(p.simd_temp_count)) {
            cg_emit_float_into(n, 0);
            return 1;
        }

        // Integer compute-in-place: a pure `+ - * & | ^` integer tree whose
        // register need fits the currently-free GP temps emits
        // destination-driven into x0 (no accumulator shuttle). Same gate
        // shape; a chip that returns a negative int_temp_count opts out
        // (x86_64 today). Float trees already returned above, so this only
        // sees integer trees (cg_int_tree_need is 999 otherwise).
        if (cg_int_tree_need(n) <= call(p.int_temp_count)) {
            cg_emit_int_into(n, 0);
            return 0;
        }

        op_s = unpack_s(n.a); op_l = unpack_l(n.a);
        c0 = peek(cg_sbuf + op_s);
        c1 = 0; if (op_l > 1) { c1 = peek(cg_sbuf + op_s + 1); }

        // Stage A — shift by a constant amount. When the right operand of
        // `<<` / `>>` is an integer literal in [1,63], emit the immediate-form
        // shift (lsl/asr/lsr #amt) instead of materialising the count into a
        // register and doing a variable shift. Evaluating the left operand via
        // emit_node also lets a CIP-eligible subtree compute in place — the
        // shift root would otherwise force the whole tree onto the accumulator
        // path. Signedness of `>>` follows the left operand's type, exactly
        // like the variable-shift dispatch further below.
        if (op_l == 2 && ((c0 == '<' && c1 == '<') || (c0 == '>' && c1 == '>'))) {
            auto _sh_rhs: Node, _sh_lhs: Node, _sh_amt, _sh_s;
            _sh_rhs = n.c;
            if (_sh_rhs.ntype == T_LIT) {
                _sh_s = unpack_s(_sh_rhs.a);
                if (peek(cg_sbuf + _sh_s) != '"' && cg_is_float_lit(_sh_rhs.a) == 0) {
                    _sh_amt = cg_parse_int(_sh_rhs.a);
                    if (_sh_amt >= 1 && _sh_amt <= 63) {
                        call(p.emit_node, n.b);              // left value -> acc
                        if (c0 == '<') {
                            call(p.emit_shl_imm, _sh_amt);
                        } else {
                            _sh_lhs = n.b;
                            if (is_unsigned_type(_sh_lhs.itype)) {
                                call(p.emit_lshr_imm, _sh_amt);
                            } else {
                                call(p.emit_shr_imm, _sh_amt);
                            }
                        }
                        return 0;
                    }
                }
            }
        }

        // Float comparison compute-in-place (gap 1, see cg_try_float_cmp):
        // bypasses the save-left/resolve dance entirely when both sides
        // are CIP-eligible float trees. Checked before is_io/the generic
        // path since a comparison can never be an is_io operator.
        auto _fc_ok, _fc_cc;
        _fc_ok, _fc_cc = cg_try_float_cmp(n, op_l, c0, c1);
        if (_fc_ok) {
            cg_emit_float_cmp_into(n, 0, _fc_cc);
            return 0;
        }

        is_io = 0;
        if (c0 == '%' || c0 == '^') { is_io = 1; }
        if ((c0 == '&' || c0 == '|') && op_l == 1) { is_io = 1; }
        if ((c0 == '<' && c1 == '<') || (c0 == '>' && c1 == '>')) { is_io = 1; }

        lty = call(p.emit_node, n.b);
        save_token = call(p.emit_binop_save_left, cg_has_call(n.c), lty);

        rty = call(p.emit_node, n.c);

        use_flt = 0;
        if (is_io == 0) {
            if (lty == 1 || rty == 1) { use_flt = 1; }
        }

        left_reg_int = call(p.emit_binop_resolve, save_token, use_flt, lty, rty);

        if (use_flt == 1) {
            if (c0 == '+' && op_l == 1) { call(p.emit_fadd); return 1; }
            if (c0 == '-' && op_l == 1) { call(p.emit_fsub); return 1; }
            if (c0 == '*' && op_l == 1) { call(p.emit_fmul); return 1; }
            if (c0 == '/' && op_l == 1) { call(p.emit_fdiv); return 1; }
            if (c0 == '=' && c1 == '=') { call(p.emit_cmp_flt, CG_CC_EQ); return 0; }
            if (c0 == '!' && c1 == '=') { call(p.emit_cmp_flt, CG_CC_NE); return 0; }
            if (c0 == '<') {
                if (c1 == '=') { call(p.emit_cmp_flt, CG_CC_LE); return 0; }
                if (op_l == 1) { call(p.emit_cmp_flt, CG_CC_LT); return 0; }
            }
            if (c0 == '>') {
                if (c1 == '=') { call(p.emit_cmp_flt, CG_CC_GE); return 0; }
                if (op_l == 1) { call(p.emit_cmp_flt, CG_CC_GT); return 0; }
            }
            return 1;
        }
        // Smart dispatch: when LHS carries the BASE_UWORD family
        // (`: u_word` annotation), route /, %, >> AND the four ordering
        // comparisons (< <= > >=) through the unsigned path; the chip
        // maps the unsigned condition codes (LO/LS/HI/HS) to its native
        // set/branch. Only those seven operators diverge between signed
        // and unsigned two's-complement. The rest (+, -, *, &, |, ^, <<,
        // and equality == / !=) are bit-identical and stay on the
        // signed/shared path.
        // LHS-only rule mirrors B++'s float dispatch convention
        // (Unsigned annotations sidequest 2026-05-14). Ported to
        // the spine in Wave 21 Commit 3 — without this branch the
        // four test_unsigned_* tests regress because spine sends
        // unsigned ops through the signed primitives.
        auto lhs_n: Node, lhs_ty;
        lhs_n = n.b;
        lhs_ty = lhs_n.itype;
        if (is_unsigned_type(lhs_ty)) {
            if (c0 == '/' && op_l == 1) { call(p.emit_udiv, left_reg_int); return 0; }
            if (c0 == '%' && op_l == 1) { call(p.emit_umod, left_reg_int); return 0; }
            if (c0 == '>' && c1 == '>') { call(p.emit_lshr, left_reg_int); return 0; }
            // Ordering comparisons diverge by signedness too — route them
            // to the unsigned condition codes. (>> already returned above,
            // so the >= / > checks below never see a shift.) Equality
            // falls through to the shared EQ/NE dispatch — it is the same
            // for signed and unsigned.
            if (c0 == '<' && c1 == '=') { call(p.emit_cmp_int, CG_CC_LS, left_reg_int); return 0; }
            if (c0 == '>' && c1 == '=') { call(p.emit_cmp_int, CG_CC_HS, left_reg_int); return 0; }
            if (c0 == '<' && op_l == 1) { call(p.emit_cmp_int, CG_CC_LO, left_reg_int); return 0; }
            if (c0 == '>' && op_l == 1) { call(p.emit_cmp_int, CG_CC_HI, left_reg_int); return 0; }
        }
        if (c0 == '+' && op_l == 1) { call(p.emit_add, left_reg_int); return 0; }
        if (c0 == '-' && op_l == 1) { call(p.emit_sub, left_reg_int); return 0; }
        if (c0 == '*' && op_l == 1) { call(p.emit_mul, left_reg_int); return 0; }
        if (c0 == '/' && op_l == 1) { call(p.emit_div, left_reg_int); return 0; }
        if (c0 == '%' && op_l == 1) { call(p.emit_mod, left_reg_int); return 0; }
        if (c0 == '&' && op_l == 1) { call(p.emit_and, left_reg_int); return 0; }
        if (c0 == '|' && op_l == 1) { call(p.emit_or,  left_reg_int); return 0; }
        if (c0 == '^' && op_l == 1) { call(p.emit_xor, left_reg_int); return 0; }
        if (c0 == '>' && c1 == '>') { call(p.emit_shr, left_reg_int); return 0; }
        if (c0 == '<' && c1 == '<') { call(p.emit_shl, left_reg_int); return 0; }
        if (c0 == '=' && c1 == '=') { call(p.emit_cmp_int, CG_CC_EQ, left_reg_int); return 0; }
        if (c0 == '!' && c1 == '=') { call(p.emit_cmp_int, CG_CC_NE, left_reg_int); return 0; }
        if (c0 == '<') {
            if (c1 == '=') { call(p.emit_cmp_int, CG_CC_LE, left_reg_int); return 0; }
            if (op_l == 1) { call(p.emit_cmp_int, CG_CC_LT, left_reg_int); return 0; }
        }
        if (c0 == '>') {
            if (c1 == '=') { call(p.emit_cmp_int, CG_CC_GE, left_reg_int); return 0; }
            if (op_l == 1) { call(p.emit_cmp_int, CG_CC_GT, left_reg_int); return 0; }
        }
        return 0;
    }

    // Unreached by construction post-Wave 21. If we land here,
    // validate let through an ntype that cg_emit_node doesn't handle
    // — a frontend bug. Panic with the ntype so the diagnostic
    // names what slipped through, instead of silently emitting a
    // zero or falling into the chip walker (which Commit 3 will
    // delete entirely).
    put_err("codegen: cg_emit_node reached unhandled ntype ");
    putnum_err(n.ntype);
    putchar_err('\n');
    panic("codegen: unhandled expression ntype (frontend bug)");
    return 0;
}

// Wave 20 complete: spine owns the statement dispatcher for every
// AST case (T_DECL, T_NOP, T_BLOCK, T_BREAK, T_CONTINUE, T_IF,
// T_WHILE, T_RET, T_ASSIGN, T_MEMST, T_SWITCH, expression-stmt).
// T_ASSIGN, T_MEMST, and T_SWITCH — the previously tangled cases —
// resolved through dedicated primitives (emit_store_var_typed,
// emit_memst_float_simd/scalar/int, emit_switch_jtbl, emit_pop_discard,
// emit_peek_cond, emit_cmp_scratch_acc, emit_struct_copy_word). The
// chip-side a64_emit_stmt / x64_emit_stmt walkers + their full-fat
// wrappers were retired as dead code (commit follows this comment).
// Wave 21 picks up emit_node next.
void cg_emit_stmt(nd) {
    auto p: ChipPrimitives;
    auto n: Node;
    auto t, lbl, lbl2, ety, rty;
    if (nd == 0) { return 0; }
    n = nd; t = n.ntype;
    p = cg_prim;

    // Variables already pre-registered in emit_func — nothing to emit.
    if (t == T_DECL) { return 0; }
    if (t == T_NOP) { return 0; }

    // Parser-level DCE can collapse a constant-true if-branch into a
    // T_BLOCK wrapping the surviving statements; just walk them.
    if (t == T_BLOCK) { call(p.emit_body, n.b, n.c); return 0; }

    // .bug line table: record this statement's start PC + source token so the
    // debugger can map a runtime address back to its `.bpp` line. Gated on
    // flag_bug (matches .bug emission), so a normal compile pays nothing and
    // stays byte-stable. T_SWITCH is skipped — it reuses src_tok to hold its
    // arm bodies; the arm statements record their own lines via cg_emit_stmt.
    if (flag_bug != 0 && t != T_SWITCH) {
        _bug_line_record(call(p.cur_text_pos), n.src_tok);
    }

    // Control-flow break / continue patch through the current label
    // stacks. Empty stacks just drop the statement (the parser would
    // have rejected an illegal break, so this is defensive).
    if (t == T_BREAK) {
        if (arr_len(cg_break_stack) > 0) {
            call(p.emit_jump, arr_last(cg_break_stack));
        }
        return 0;
    }
    if (t == T_CONTINUE) {
        if (arr_len(cg_continue_stack) > 0) {
            call(p.emit_jump, arr_last(cg_continue_stack));
        }
        return 0;
    }

    // T_IF: evaluate condition, branch around the taken arm if zero,
    // jump past the else arm after the taken arm emits.
    if (t == T_IF) {
        lbl  = call(p.emit_new_label);
        lbl2 = call(p.emit_new_label);
        if (cg_emit_cmp_to_branch(n.a, lbl) == 0) {
            ety = call(p.emit_node, n.a);
            if (ety == 1) { call(p.emit_fcond_to_int_truth); }
            call(p.emit_branch_if_zero, lbl);
        }
        call(p.emit_body, n.b, n.c);
        call(p.emit_jump, lbl2);
        call(p.emit_label, lbl);
        if (n.e > 0) { call(p.emit_body, n.d, n.e); }
        call(p.emit_label, lbl2);
        return 0;
    }

    // T_WHILE: n.e carries the for-loop step expression (0 for plain
    // `while`). Continue label sits between body and step so `continue`
    // runs the step before re-testing.
    if (t == T_WHILE) {
        auto step_node, lbl3;
        auto _iv_sa, _iv_sb, _iv_sr, _iv_si;
        step_node = n.e;
        // Induction pointer walk: detect a counted array loop and emit the
        // pre-loop pointer setup. cg_iv_* is saved/restored so a loop nested
        // inside another (induction) loop can never corrupt the outer state.
        _iv_sa = cg_iv_active; _iv_sb = cg_iv_base; _iv_sr = cg_iv_reg; _iv_si = cg_iv_idx;
        cg_iv_detect(nd);
        lbl  = call(p.emit_new_label);
        lbl2 = call(p.emit_new_label);
        lbl3 = call(p.emit_new_label);
        cg_break_stack = arr_push(cg_break_stack, lbl2);
        cg_continue_stack = arr_push(cg_continue_stack, lbl3);
        call(p.emit_label, lbl);
        if (cg_emit_cmp_to_branch(n.a, lbl2) == 0) {
            ety = call(p.emit_node, n.a);
            if (ety == 1) { call(p.emit_fcond_to_int_truth); }
            call(p.emit_branch_if_zero, lbl2);
        }
        call(p.emit_body, n.b, n.c);
        call(p.emit_label, lbl3);
        if (step_node != 0) { cg_emit_stmt(step_node); }
        // Advance each induction pointer once per iteration. Emitting it here
        // (at the continue/step point) keeps it in lock-step with `i++` even
        // when the body hits `continue`.
        if (cg_iv_active > 0) {
            auto _ivi;
            for (_ivi = 0; _ivi < cg_iv_active; _ivi++) {
                call(p.emit_iv_advance, arr_get(cg_iv_reg, _ivi));
            }
        }
        call(p.emit_jump, lbl);
        call(p.emit_label, lbl2);
        arr_pop(cg_break_stack);
        arr_pop(cg_continue_stack);
        cg_iv_active = _iv_sa; cg_iv_base = _iv_sb; cg_iv_reg = _iv_sr; cg_iv_idx = _iv_si;
        return 0;
    }

    // T_RET: evaluate return expression, coerce to the function's
    // declared return type, jump to the epilogue.
    if (t == T_RET) {
        // Multi-value return `return e1, e2, …;` — integer slots fill
        // x0..x7, float slots fill d0..d7 independently (a slot's bank
        // position is its index among same-typed slots). Two passes keep
        // it correct for ANY result expression, including non-trivial
        // float arithmetic: pass 1 evaluates each result (coercing to its
        // declared slot type) and pushes it to the value stack; pass 2
        // pops the stack — LIFO, so reverse slot order — into each slot's
        // bank register. Because pass 2 does no evaluation it never touches
        // the FP scratch, so a placed float result can't be clobbered by a
        // later slot's expression.
        if (n.c > 1) {
            auto rexprs, ri, rdt, ris_f, rbpos, rbj, rrty;
            if (call(p.cap_multi_ret) == 0) {
                diag_error(266);
                diag_str("multi-value return needs register-bank support; this backend does not implement it (aarch64 and x86_64 do)");
                diag_newline();
                return 0;
            }
            rexprs = n.b;
            // Pass 1: evaluate left-to-right, coerce, push.
            ri = 0;
            while (ri < n.c) {
                rdt   = get_fn_ret_type_at(cg_cur_fn_idx, ri);
                ris_f = is_float_type(rdt);
                rrty  = call(p.emit_node, *(rexprs + ri * 8));
                if (ris_f) {
                    if (rrty == 0) { call(p.emit_promote_int_to_flt); }
                } else {
                    if (rrty == 1) { call(p.emit_demote_flt_to_int); }
                }
                call(p.emit_bank_push, ris_f);
                ri++;
            }
            // Pass 2: pop (reverse) into each slot's bank register.
            ri = n.c - 1;
            while (ri >= 0) {
                rdt   = get_fn_ret_type_at(cg_cur_fn_idx, ri);
                ris_f = is_float_type(rdt);
                rbpos = 0; rbj = 0;
                while (rbj < ri) {
                    if (is_float_type(get_fn_ret_type_at(cg_cur_fn_idx, rbj)) == ris_f) { rbpos++; }
                    rbj++;
                }
                call(p.emit_bank_pop, ris_f, rbpos);
                ri--;
            }
            call(p.emit_jump_to_epilogue);
            return 0;
        }
        rty = call(p.emit_node, n.a);
        if (is_float_type(get_fn_ret_type(cg_cur_fn_idx))) {
            if (rty == 0) { call(p.emit_promote_int_to_flt); }
        } else {
            if (rty == 1) { call(p.emit_demote_flt_to_int); }
        }
        call(p.emit_jump_to_epilogue);
        return 0;
    }

    // T_ASSIGN: stack struct copy takes a dedicated path (source
    // address in acc, emit per-word load/store via primitive); every
    // other shape evaluates the RHS then stores into a local (typed
    // primitive) or a global (primitive with float coercion).
    if (t == T_ASSIGN) {
        auto lhs: Node, vi, off;

        // Multi-value assignment `a, b, … = f()` — n.c is the array of
        // target T_VAR nodes, n.d the count. The call (n.b) leaves its
        // results in the banked registers (integers x0.., floats d0..);
        // each target's own type selects its bank and bank position. Bring
        // the source bank register down into the accumulator (x0 / d0) and
        // store; this clobbers only the accumulator, so the not-yet-read
        // higher bank registers survive each store.
        if (n.d > 1) {
            auto targets, mk, tnode: Node, tvi, toff, tis_f, tbpos, tbj, tbn: Node, tbvi;
            auto call_n: Node, fidx_m;

            // Inc 5 (docs/plans/inliner_arc.md): if the callee is inline-
            // eligible, splice instead of emitting a real call + unpacking
            // banked registers — inlining means there is no ABI boundary
            // to cross, so there is nothing to bank in the first place.
            // Without this check, n.b below would still reach the generic
            // T_CALL dispatch (the chip's single-value inline fast path),
            // which only knows how to emit ONE result into acc and silently
            // drops the rest — confirmed by direct testing before this
            // check existed. `call_n.e > 0` mirrors the existing single-
            // value inline check's own guard (the pre-reg walker must have
            // stamped a callsite id; it already descends into every
            // T_ASSIGN's n.b unconditionally, multi or not, so this fires
            // correctly with no walker change needed).
            call_n = n.b;
            if (call_n.ntype == T_CALL) {
                fidx_m = find_func_idx(call_n.a);
                if (fidx_m >= 0 && arr_get(fn_inlineable, fidx_m) && call_n.e > 0) {
                    cg_emit_inline_multi_assign(call_n, fidx_m, n.c, n.d);
                    return 0;
                }
            }

            if (call(p.cap_multi_ret) == 0) {
                diag_error(266);
                diag_str("multi-value assignment needs register-bank support; this backend does not implement it (aarch64 and x86_64 do)");
                diag_newline();
                return 0;
            }
            targets = n.c;
            call(p.emit_node, n.b);                  // call → banked results
            mk = 0;
            while (mk < n.d) {
                tnode = *(targets + mk * 8);
                tvi   = cg_var_idx(tnode.a);
                toff  = arr_get(cg_var_off, tvi);
                tis_f = cg_var_is_float(tvi);
                tbpos = 0; tbj = 0;
                while (tbj < mk) {
                    tbn  = *(targets + tbj * 8);
                    tbvi = cg_var_idx(tbn.a);
                    if (cg_var_is_float(tbvi) == tis_f) { tbpos++; }
                    tbj++;
                }
                if (tis_f) {
                    if (tbpos > 0) { call(p.emit_fmov_reg, 0, tbpos); }     // d0 = d_bpos
                    call(p.emit_store_var_typed, tvi, toff, 1);
                } else {
                    if (tbpos > 0) { call(p.emit_mov_reg_reg, 0, tbpos); }  // x0 = x_bpos
                    call(p.emit_store_var_typed, tvi, toff, 0);
                }
                mk++;
            }
            return 0;
        }

        lhs = n.a;
        if (lhs.ntype == T_VAR) {
            vi = cg_var_idx(lhs.a);
            if (vi >= 0) {
                if (arr_get(cg_var_stack, vi)) {
                    auto sidx, fc, j;
                    call(p.emit_node, n.b);
                    off = arr_get(cg_var_off, vi);
                    sidx = arr_get(cg_var_struct_idx, vi);
                    fc = (get_struct_size(sidx) + 7) / 8;
                    j = 0;
                    while (j < fc) {
                        call(p.emit_struct_copy_word, j * 8, off + j * 8);
                        j++;
                    }
                    return 0;
                }
            }
        }
        // Self-update with an immediate: `v = v + k` / `v = v - k` for a
        // promoted integer local and a small constant k updates the register
        // in place (`add/sub reg, reg, #k`) — the canonical `i++` / `i += k`
        // loop step — instead of materialising k, adding through the
        // accumulator, and storing back.
        if (lhs.ntype == T_VAR) {
            auto _su_vi, _su_reg, _su_rhs: Node, _su_l: Node, _su_r: Node, _su_c0, _su_rs, _su_k;
            _su_vi = cg_var_idx(lhs.a);
            if (_su_vi >= 0) {
                _su_reg = arr_get(cg_var_promote, _su_vi);
                _su_rhs = n.b;
                if (_su_reg >= 0 && cg_var_is_float(_su_vi) == 0 && arr_get(cg_var_stack, _su_vi) == 0 &&
                    _su_rhs != 0 && _su_rhs.ntype == T_BINOP && unpack_l(_su_rhs.a) == 1) {
                    _su_c0 = peek(cg_sbuf + unpack_s(_su_rhs.a));
                    if (_su_c0 == '+' || _su_c0 == '-') {
                        _su_l = _su_rhs.b; _su_r = _su_rhs.c;
                        if (_su_l != 0 && _su_l.ntype == T_VAR && cg_var_idx(_su_l.a) == _su_vi &&
                            _su_r != 0 && _su_r.ntype == T_LIT) {
                            _su_rs = unpack_s(_su_r.a);
                            if (peek(cg_sbuf + _su_rs) != '"' && cg_is_float_lit(_su_r.a) == 0) {
                                _su_k = cg_parse_int(_su_r.a);
                                if (_su_k >= 1 && _su_k <= 4095) {
                                    auto _su_sub;
                                    _su_sub = 0; if (_su_c0 == '-') { _su_sub = 1; }
                                    call(p.emit_self_op_imm, _su_reg, _su_k, _su_sub);
                                    return 0;
                                }
                            }
                        }
                    }
                }
            }
        }
        // Assign-into-destination-register: `promoted = <single-instruction CIP
        // expr over register leaves>` computes straight into the target's
        // register — no accumulator round-trip + copy-back (`s = s*A + C`
        // emits one `madd s, s, A, C`).
        if (lhs.ntype == T_VAR) {
            auto _ad_vi, _ad_reg;
            _ad_vi = cg_var_idx(lhs.a);
            if (_ad_vi >= 0) {
                _ad_reg = arr_get(cg_var_promote, _ad_vi);
                // int_temp_count >= 0 gates out backends without integer CIP
                // (x64 returns -1) — cg_emit_int_into uses the CIP primitives.
                if (_ad_reg >= 0 && cg_var_is_float(_ad_vi) == 0 && arr_get(cg_var_stack, _ad_vi) == 0 &&
                    call(p.int_temp_count) >= 0 && cg_assign_into_dest_ok(n.b)) {
                    cg_emit_int_into(n.b, _ad_reg);
                    return 0;
                }
            }
        }
        // Float assign-into-destination (the float twin): `promoted_float =
        // <float expr that does not read the target>` computes straight into
        // the target's d-register via the float CIP — no round-trip through d0
        // and no copy-back. The not-used-in-RHS check guarantees the
        // destination register is free of a not-yet-read source (so a multi-op
        // expression like a biquad's `y = b0*x + …` is safe). Naturally a64-only
        // — x64 has no float promotion (no callee-saved xmm), so _af_reg < 0.
        if (lhs.ntype == T_VAR) {
            auto _af_vi, _af_reg;
            _af_vi = cg_var_idx(lhs.a);
            if (_af_vi >= 0) {
                _af_reg = arr_get(cg_var_promote, _af_vi);
                if (_af_reg >= 0 && cg_var_is_float(_af_vi) == 1 && arr_get(cg_var_stack, _af_vi) == 0 &&
                    cg_float_tree_need(n.b) <= call(p.simd_temp_count) &&
                    cg_node_uses_var(n.b, _af_vi) == 0) {
                    cg_emit_float_into(n.b, _af_reg);
                    return 0;
                }
            }
        }
        rty = call(p.emit_node, n.b);
        if (lhs.ntype == T_VAR) {
            vi = cg_var_idx(lhs.a);
            if (vi >= 0) {
                off = arr_get(cg_var_off, vi);
                call(p.emit_store_var_typed, vi, off, rty);
            } else {
                if (is_float_type(ty_get_global_type(lhs.a))) {
                    if (rty == 0) { call(p.emit_promote_int_to_flt); }
                    call(p.emit_store_global, lhs.a, 1);
                } else {
                    if (rty == 1) { call(p.emit_demote_flt_to_int); }
                    call(p.emit_store_global, lhs.a, 0);
                }
            }
        }
        return 0;
    }

    // T_MEMST: `*(ptr) = val`. n.c carries the field-type hint; the
    // spine splits SIMD from scalar-float from int and delegates to
    // the per-path primitive that owns the exact register-file dance
    // (SIMD lives in v0/xmm0 with a vpush stack slot; scalar float
    // uses d0/xmm0 with the FP stack; int uses x0/rax with a freelist
    // save on aarch64, a plain push/pop on x86_64).
    if (t == T_MEMST) {
        auto fh, fh_sl, _ivk;
        fh = n.c;
        // Induction pointer walk: a full-word integer `base[i] = v` evaluates v
        // into the accumulator then stores through the base's walking register,
        // post-incrementing it (no address math).
        _ivk = cg_iv_match(n.a);
        if (_ivk >= 0 && is_float_type(fh) == 0 && ty_slice(fh) == SL_FULL) {
            call(p.emit_node, n.b);
            call(p.emit_iv_store, arr_get(cg_iv_reg, _ivk));
            return 0;
        }
        if (is_float_type(fh)) {
            fh_sl = ty_slice(fh);
            if (fh_sl == SL_DOUBLE) {
                call(p.emit_memst_float_simd, nd);
                return 0;
            }
            call(p.emit_memst_float_scalar, nd, fh_sl);
            return 0;
        }
        call(p.emit_memst_int, nd, fh);
        return 0;
    }

    // T_SWITCH: two forms.
    //   Form 1 (n.a != 0): value dispatch. Evaluate the condition
    //     once, push it, then for each arm value compare against the
    //     saved copy on the stack. A dense-value arm set short-
    //     circuits through the chip's jump-table primitive.
    //   Form 2 (n.a == 0): condition dispatch. Each arm expression
    //     is evaluated in sequence; truthy enters the body.
    // Bodies and the else fallthrough pop the saved cond (when
    // present) before running.
    if (t == T_SWITCH) {
        auto sw_arms, sw_bodies, sw_cnt, sw_end_lbl;
        auto si, sv_arr, sv_cnt, sb_arr, sb_cnt, snext_lbl;
        auto smatch_lbl, sk;
        sw_arms = n.b;
        sw_bodies = n.src_tok;
        sw_cnt = n.c;
        sw_end_lbl = call(p.emit_new_label);

        // Form 1 dense switches use the chip's jump-table emitter.
        if (n.a != 0) {
            if (cg_switch_is_dense(sw_arms, sw_cnt)) {
                call(p.emit_switch_jtbl, nd, sw_end_lbl);
                return 0;
            }
        }

        // Form 1: evaluate the condition once and push for later peeks.
        if (n.a != 0) {
            call(p.emit_node, n.a);
            call(p.emit_push_acc);
        }

        for (si = 0; si < sw_cnt; si++) {
            sv_arr = sw_arms[si * 2];
            sv_cnt = sw_arms[si * 2 + 1];
            sb_arr = sw_bodies[si * 2];
            sb_cnt = sw_bodies[si * 2 + 1];
            snext_lbl = call(p.emit_new_label);
            smatch_lbl = call(p.emit_new_label);

            if (n.a == 0) {
                // Form 2: condition dispatch.
                call(p.emit_node, sv_arr[0]);
                call(p.emit_branch_if_nonzero, smatch_lbl);
            } else {
                // Form 1: compare saved cond against each arm value.
                for (sk = 0; sk < sv_cnt; sk++) {
                    call(p.emit_node, sv_arr[sk]);
                    call(p.emit_peek_cond);
                    call(p.emit_cmp_scratch_acc);
                    call(p.emit_branch_eq, smatch_lbl);
                }
            }
            call(p.emit_jump, snext_lbl);

            call(p.emit_label, smatch_lbl);
            if (n.a != 0) { call(p.emit_pop_discard); }
            for (sk = 0; sk < sb_cnt; sk++) { cg_emit_stmt(sb_arr[sk]); }
            call(p.emit_jump, sw_end_lbl);

            call(p.emit_label, snext_lbl);
        }

        // Fell through all arms — pop saved cond before else body or end.
        if (n.a != 0) { call(p.emit_pop_discard); }

        if (n.d != 0) {
            auto ek;
            for (ek = 0; ek < n.e; ek++) { cg_emit_stmt(n.d[ek]); }
        }

        call(p.emit_label, sw_end_lbl);
        return 0;
    }

    // Expression statement (e.g., bare function call). Walk as node.
    call(p.emit_node, nd);
}
