// moog_demo.bpp — the basic example of the stbfilter Moog plugin.
//
// A Moog ladder filter is four one-pole low-passes in series with a resonant
// feedback path from the last stage back to the input. It is the classic warm,
// vocal, "wah" filter. This demo generates a 110 Hz sawtooth (A2) and sweeps a
// high-resonance cutoff across it, then writes a WAV you can listen to.
//
// The filter itself lives in `stb/stbfilter.bsm` (a reusable DSP cartridge, the
// same one the sound_fusion DAW uses) — this file just drives it. It is the small,
// read-it-in-one-sitting example; sound_fusion is the real consumer.
//
// Run:  ./bpp examples/moog_demo.bpp -o /tmp/moog && /tmp/moog
//       then play moog_demo.wav
import "stbsound.bsm";
import "stbfilter.bsm";

const SR        = 44100;          // sample rate (the engine's fixed rate)
const SECONDS   = 4;
const NF        = 176400;         // SR * SECONDS frames

main() {
    auto pcm, m, i, peak;
    auto phase: float, dphase: float, saw: float;
    auto lfo: float, cut: float, y: float;
    auto (pos, s): word;             // word: the float->s16 result converts here

    pcm = malloc(NF * 4);             // stereo s16, 4 bytes per frame
    m   = malloc(moog_sizeof());      // Moog state (zeroed by malloc)
    moog_reset(m);                    // explicit clear — fresh stage memories

    phase  = 0.0;
    dphase = 110.0 / 44100.0;         // 110 Hz sawtooth
    peak   = 0;

    for (i = 0; i < NF; i++) {
        // Naive sawtooth: phase ramps 0..1, output -1..+1. The aliasing is part
        // of the lofi charm.
        phase += dphase;
        if (phase >= 1.0) { phase -= 1.0; }
        saw = 2.0 * phase - 1.0;

        // Cutoff LFO: a triangle 0..1 over one second, sweeping 150..5000 Hz.
        pos = i - (i / 44100) * 44100;        // i mod SR  (integer)
        lfo = pos;                            // int -> float
        lfo = lfo / 44100.0;                  // 0..1
        if (lfo > 0.5) { lfo = 1.0 - lfo; }   // fold to a 0..0.5 ramp
        lfo = lfo + lfo;                      // back to 0..1 triangle
        cut = 150.0 + 4850.0 * lfo;
        moog_set(m, cut, 3.0, 44100.0);

        y = moog_tick(m, saw);

        // Float [-1,1] -> s16 with makeup gain (the low-pass attenuates), then
        // clamp. The clamp doubling as a soft ceiling is itself lofi-friendly.
        s = y * 52000.0;
        if (s >  32767) { s =  32767; }
        if (s < -32767) { s = -32767; }
        if (s > peak) { peak = s; }
        write_u16(pcm, i * 4 + 0, s);         // left
        write_u16(pcm, i * 4 + 2, s);         // right (mono)
    }

    sound_save_wav("moog_demo.wav", pcm, NF);
    put("wrote moog_demo.wav — ", NF, " frames, peak ", peak, "/32767\n");
    return 0;
}
