# Compiler binary (install via install.sh, not tracked in git)
#/bpp

# Build artifacts
build/
*.o
*.out
a.out

# Module cache contents (auto-generated, directory is tracked)
.bpp_cache/*.bo
.bpp_cache/hashes

# Legacy bootstrap (not needed, compiler is self-hosting)
#_legacy_bootstrap/

# macOS
.DS_Store
*.dylib

# Editors and tools
*~
\#*\#
.#*
.claude/

# Node (legobox-server, etc.)
node_modules/

# Temporary
/tmp/
*.tmp
hello.bpp
bpp2
bpp3

# Test binaries (compiled test outputs)
tests/out_test_*

# Game binaries (compiled from games/**/*.bpp)
#games/snake/snake
#games/pathfind/path
#games/platformer/plat_asset
#games/platformer/plat_noasset

# Bang 9 build output. Source is committed; only the binary stays local.
bang9/build/

# sound_fusion / moon_filter tool binaries + render outputs (built locally
# from the .bpp/.bsm sources, which ARE tracked). The DAW writes WAVs next to itself.
tools/sound_fusion/sf
tools/sound_fusion/sf_bench
tools/moon_filter/moon
**/sound_fusion_test.wav
**/moon_demo.wav
**/moog_demo.wav
# Pink-noise test tone — reproducible from tools/pink_noise/gen_pink_noise.bpp,
# too large (MBs) to track; regenerate locally when you need it.
**/pink_noise.wav

# Modulab user-state prefs file. Modulab writes to <exe_dir>/modulab_prefs.json
# every open/close — pure per-user state (window position, last preset, recent
# files), regenerates on first run. NOT a project asset (those live under
# <project>/assets/ and ARE tracked). Sidequest in docs/plans/todo.md to migrate
# writes into ~/.config/bpp/. Pattern matches the file in any directory the
# binary happens to run from.
**/modulab_prefs.json
tools/sound_fusion/sf_bench_flat
