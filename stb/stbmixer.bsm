// stbmixer.bsm — Polyphonic square-wave mixer over stbaudio.
//
// Sits above the SPSC ring from stbaudio. Maintains a fixed pool of
// 8 voice slots; each voice plays a square wave at its configured
// frequency until note_off is called. The main thread drives
// ticking via mixer_stream(n) which generates n mixed stereo
// frames and pushes them into the audio ring.
//
// ── Timing contract ──────────────────────────────────────────────
// stbmixer assumes a monotonic sample timeline anchored at
// init_beat(). The program's main() must call init_beat() before
// mixer_init — either directly, or indirectly via maestro_run or
// stbgame's game_init. All voice timing derives from
// beat_now_samples(44100) and is read fresh inside every fill
// call, so phase stays continuous across fill boundaries and the
// same timeline is observable by Rhythm Teacher's note scheduler.
//
// ── Polyphony ────────────────────────────────────────────────────
// 8 simultaneous voices. Per-voice amplitude is scaled by 1/N so
// the additive mix never clips s16. Release is instantaneous — the
// slot goes idle the moment mixer_note_off fires. An ADSR envelope
// is a future slice and lives in a separate voice kind.
//
// ── Waveform ─────────────────────────────────────────────────────
// Square only. The shape is fixed so synthkey and Snake's one-shot
// apple sample can share a uniform voice-state layout without
// branching inside the per-frame loop. Additional waveforms and
// sampled playback plug in as new voice kinds later.

import "stbaudio.bsm";
import "stbrotary.bsm";  // the Leslie rotary — stbmixer owns one instance for its master bus
import "stbenv.bsm";     // ADSR — de-clicks tone-voice note_off (docs/plans/audio_dsp_architecture.md item 3)

// ── Configuration ──────────────────────────────────────────────
// All set once inside mixer_init. Rule 1: static extrn for
// write-once module-private state.
static extrn _MX_MAX_VOICES;
static extrn _MX_SAMPLE_RATE;
static extrn _MX_VOICE_AMP;        // per-voice amplitude (s16 / MAX_VOICES)
static extrn _MX_FILL_BUF;         // scratch buffer for mixer_stream
static extrn _MX_FILL_BUF_FRAMES;  // capacity of _MX_FILL_BUF in frames

// ── Voice table (9 parallel arrays) ───────────────────────────
// Parallel arrays — not a struct. 8 voices × 9 arrays × 8 bytes =
// 576 bytes total, well under a single cache line family. The
// pointers here are write-once (set inside mixer_init). Array
// contents mutate via poke / subscript writes.
static extrn _mx_voice_active;   // arr[i] = 1 if voice i carries a live note
static extrn _mx_voice_kind;     // arr[i] = MX_KIND_* tag (tone / sample / music)
static extrn _mx_voice_key;      // arr[i] = key_id the caller passed to note_on
static extrn _mx_voice_hp;       // arr[i] = samples per half-period (tone)
static extrn _mx_voice_amp;      // arr[i] = per-voice amplitude
static extrn _mx_voice_phase;    // arr[i] = phase inside the period (tone)
static extrn _mx_voice_buf;      // arr[i] = sample buffer pointer (s16 stereo)
static extrn _mx_voice_pos;      // arr[i] = sample frame position
static extrn _mx_voice_frames;   // arr[i] = sample total frame count
static extrn _mx_voice_bus;      // arr[i] = MX_BUS_* tag (routes to a volume bus)
static extrn _mx_voice_loop;     // arr[i] = 1 if voice loops at end (music)
static extrn _mx_voice_env;      // arr[i] = an stbenv Envelope* (tone voices only;
                                 //   de-clicks note_off — see mixer_note_on/off)
static extrn _mx_voice_pan_l;    // arr[i] = left pan gain, float bits (0.0..1.0),
                                 //   read/written via peekfloat/pokefloat —
                                 //   the slot is still an 8-byte word buffer,
                                 //   only the bit interpretation is float
                                 //   (float-core migration S3).
static extrn _mx_voice_pan_r;    // arr[i] = right pan gain, float bits (0.0..1.0)
                                 //   unity centre = 1.0/1.0 (identity — a
                                 //   centred voice is unchanged from the old
                                 //   mono path). Set via mixer_set_voice_pan.

// Voice kinds — stored in _mx_voice_kind. MX_KIND_NONE means the
// slot is mixable as silence (legacy code paths that only check
// _mx_voice_active still work: a voice with kind NONE never has
// active=1).
static extrn MX_KIND_NONE;
static extrn MX_KIND_TONE;     // synthesized waveform via note_on
static extrn MX_KIND_SAMPLE;   // one-shot WAV playback
static extrn MX_KIND_MUSIC;    // looping WAV playback for BGM

// Audio buses — route voices to independent volume sliders. The
// final output is `sum * bus_vol * master_vol / (100 * 100)`.
static extrn MX_BUS_MASTER;
static extrn MX_BUS_MUSIC;
static extrn MX_BUS_SFX;
static extrn _MX_BUS_COUNT;

// Bus volumes: 0..100. master is at index MX_BUS_MASTER, etc.
static extrn _mx_bus_vol;

// Mute state arrays, one pair per bus. `_mx_bus_muted[bus]` is 0
// or 1; `_mx_bus_saved_vol[bus]` holds the pre-mute volume so
// unmute restores the exact prior level. Using two words per bus
// lets a user legitimately mute-from-zero without the toggle
// getting confused about state (same pattern as stbaudio's mute).
static extrn _mx_bus_muted;
static extrn _mx_bus_saved_vol;

// Master mute bookkeeping. Separate from bus mute because the
// master gain is its own knob (scales AFTER the MASTER bus
// multiplier) and callers might want to mute everything at once
// without losing the per-bus balance.
static extrn _mx_master_muted;
static extrn _mx_master_saved_vol;

// Waveform fader — blends across four waveforms from clean to dirty.
//   0   = pure sine (cleanest)
//   256 = pure triangle
//   512 = pure sawtooth
//   768 = pure square (dirtiest)
// Values between crossfade the two neighbors. Set via mixer_set_fader.
static extrn _mx_fader;

static extrn _mx_inited;

// Initialize the mixer. Idempotent — calling twice is a no-op.
// Allocates the voice arrays and the fill scratch buffer. Does NOT
// call init_beat (the program is responsible for anchoring the
// timeline). Does NOT open the audio device either — the caller
// opens it via audio_open before the first mixer_stream call.
void mixer_init() {
    if (_mx_inited != 0) { return; }
    // Sine waveform needs the 32-point trig table. Both calls are
    // idempotent so double-init from game_init + mixer_init is safe.
    init_math();
    math_trig_init();

    // Voice kinds and buses get their integer tag assigned here.
    MX_KIND_NONE   = 0;
    MX_KIND_TONE   = 1;
    MX_KIND_SAMPLE = 2;
    MX_KIND_MUSIC  = 3;

    MX_BUS_MASTER = 0;
    MX_BUS_MUSIC  = 1;
    MX_BUS_SFX    = 2;
    _MX_BUS_COUNT = 3;

    // Two extra voice slots reserved at the end: MUSIC always lives
    // on slot _MX_MAX_VOICES (index 8) so BGM can't be knocked out
    // by a flood of SFX. The slot beyond it is a spare for future
    // streaming voices. Total pool: 10 slots.
    _MX_MAX_VOICES   = 10;
    _MX_SAMPLE_RATE  = 44100;
    _MX_VOICE_AMP    = 8000;
    _MX_FILL_BUF_FRAMES = 512;
    _MX_FILL_BUF     = buf_byte(_MX_FILL_BUF_FRAMES * 8);

    // Phase D dogfood (2026-04-22): voice pool is 11 parallel arrays of
    // 10 word-slots each. Using arr_word + buf_fill instead of malloc
    // + manual loop makes the intent explicit and drops ~15 lines. Kind
    // and bus start at MX_KIND_NONE (=0) and MX_BUS_SFX respectively —
    // both happen to be zero, so a single bulk fill covers them; any
    // future non-zero default needs an explicit poke after.
    _mx_voice_active = buf_word(_MX_MAX_VOICES);
    _mx_voice_kind   = buf_word(_MX_MAX_VOICES);
    _mx_voice_key    = buf_word(_MX_MAX_VOICES);
    _mx_voice_hp     = buf_word(_MX_MAX_VOICES);
    _mx_voice_amp    = buf_word(_MX_MAX_VOICES);
    _mx_voice_phase  = buf_word(_MX_MAX_VOICES);
    _mx_voice_buf    = buf_word(_MX_MAX_VOICES);
    _mx_voice_pos    = buf_word(_MX_MAX_VOICES);
    _mx_voice_frames = buf_word(_MX_MAX_VOICES);
    _mx_voice_bus    = buf_word(_MX_MAX_VOICES);
    _mx_voice_loop   = buf_word(_MX_MAX_VOICES);
    _mx_voice_pan_l  = buf_word(_MX_MAX_VOICES);
    _mx_voice_pan_r  = buf_word(_MX_MAX_VOICES);

    buf_fill(_mx_voice_active, 0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_kind,   0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_key,    0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_hp,     0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_amp,    0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_phase,  0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_buf,    0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_pos,    0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_frames, 0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_bus,    0, _MX_MAX_VOICES * 8);
    buf_fill(_mx_voice_loop,   0, _MX_MAX_VOICES * 8);
    // Pan gains default to unity centre (1.0/1.0 float) — NOT zero — so an
    // unpanned voice is unchanged from the old mono path. (buf_fill can't seed
    // a non-zero pattern, and the float bits for 1.0 aren't all-zero anyway.)
    auto pv;
    for (pv = 0; pv < _MX_MAX_VOICES; pv++) {
        pokefloat(_mx_voice_pan_l + pv * 8, 1.0);
        pokefloat(_mx_voice_pan_r + pv * 8, 1.0);
    }

    // One Envelope per voice slot, allocated once (not per note_on — the
    // pool stays @safe-friendly, no malloc on the hot note-on/note-off
    // path). De-click shape only: fast attack/decay, full sustain (today's
    // sustained loudness is unchanged), short release — note_off ramps
    // instead of cutting (docs/plans/audio_dsp_architecture.md item 3). The
    // shape is the same for every tone voice; not yet exposed as a per-
    // voice API. Literals, not named consts — see Rule 12 (const demotes
    // float literals to 0).
    _mx_voice_env = buf_word(_MX_MAX_VOICES);
    for (pv = 0; pv < _MX_MAX_VOICES; pv++) {
        _mx_voice_env[pv] = env_new(44100.0);
        env_set(_mx_voice_env[pv], 2.0, 2.0, 1.0, 15.0);
    }

    _mx_bus_vol = buf_word(_MX_BUS_COUNT);
    _mx_bus_vol[MX_BUS_MASTER] = 100;
    _mx_bus_vol[MX_BUS_MUSIC]  = 80;
    _mx_bus_vol[MX_BUS_SFX]    = 100;

    // Bus mute state starts clear — no bus is muted at init. Saved
    // volumes default to the bus's initial volume so a mute-without-
    // prior-set-call has something sane to restore to.
    _mx_bus_muted     = buf_word(_MX_BUS_COUNT);
    _mx_bus_saved_vol = buf_word(_MX_BUS_COUNT);
    buf_fill(_mx_bus_muted, 0, _MX_BUS_COUNT * 8);
    auto i;
    for (i = 0; i < _MX_BUS_COUNT; i++) {
        _mx_bus_saved_vol[i] = _mx_bus_vol[i];
    }
    _mx_master_muted     = 0;
    _mx_master_saved_vol = 80;

    _mx_fader         = 768;
    _mx_master_vol    = 80;
    _mx_dirt          = 0;
    _mx_decim_counter = 0;
    _mx_held_l        = 0.0;
    _mx_held_r        = 0.0;

    // Rotary starts OFF, motor at rest (0 Hz) — mixer_set_rotary glides it
    // up. Bound to the same 44100 Hz timeline as the rest of the mixer (note
    // the literal: passing the _MX_SAMPLE_RATE word variable here would hit
    // E240 — a non-literal int can't silently widen to a float param; only
    // a literal does, per Rule 12). stbmixer owns exactly one Rotary
    // instance for its master bus; tools/sound_fusion/sf_channel.bsm owns one
    // per track (docs/plans/sound_fusion.md slice 5b).
    _mx_rotary = rotary_new(44100.0);

    _mx_inited        = 1;
}

// ── dB ↔ percent conversion ───────────────────────────────────
// Internal helpers shared by all mixer_*_volume_db functions.
// Real math now (db_to_amp_f / amp_to_db_f, bpp_math.bsm, added
// 2026-06-24) — this used to fake 10^(db/20) with a halving ladder
// + a 6-entry remainder table, the same workaround
// stbaudio.audio_set_volume_db carried (and has since dropped) for
// the same reason: no pow()/log()/exp() existed anywhere in the
// runtime yet. See docs/manual/audio_specs.md Cap 2.3.
//
// Precision caveat UNCHANGED by this swap: percent storage is
// integer 0..100, so values below ~-40 dB still lose to rounding —
// that is the STORAGE granularity, not the conversion math, and
// real math doesn't fix a storage choice. For plugin-grade
// precision (< 0.1 dB error across the full range) store per-voice
// or per-bus gain as raw amplitude instead of percent — a future
// refactor if a real DAW use case surfaces.

static _mx_db_to_pct(db) {
    // db_f/pct_f keep `: float`: int parameters widened by annotation-cast.
    auto db_f: float, pct_f: float, pct: word;
    if (db >= 0)        { return 100; }
    if (db <= 0 - 60)   { return 0; }
    db_f = db;
    pct_f = db_to_amp_f(db_f) * 100.0;
    pct_f = pct_f + 0.5;   // round to nearest — pct_f is always >= 0 here
    pct = pct_f;
    return pct;
}

static _mx_pct_to_db(pct) {
    auto pct_f: float, db_f: float, db: word;   // int->float casts (see above)
    if (pct <= 0)   { return 0 - 60; }
    if (pct >= 100) { return 0; }
    pct_f = pct;
    db_f = amp_to_db_f(pct_f / 100.0);
    db_f = db_f - 0.5;   // round to nearest — db_f is always < 0 here
    db = db_f;
    return db;
}

// Start a note with unique `key_id` at `freq_hz`. If a voice is already
// playing the same key AND still held (not yet released), returns that
// voice's slot without restarting it — the held note keeps sustaining. If
// the same key matches a voice that has already started its release tail
// (a key was pressed again after note_off but before the tail finished
// ringing out), retriggers that same slot instead of leaving a stale tail
// while a second voice for the same key starts elsewhere. Returns the
// voice slot on success, -1 if every slot is busy.
mixer_note_on(key_id: word, freq_hz: word) {
    auto i, hp;
    hp = _MX_SAMPLE_RATE / freq_hz / 2;
    if (hp < 1) { hp = 1; }

    // Already playing this key? Only tone voices carry a key_id, so
    // cross-kind collision is not possible.
    for (i = 0; i < _MX_MAX_VOICES; i++) {
        if (_mx_voice_active[i] != 0) {
            if (_mx_voice_kind[i] == MX_KIND_TONE) {
                if (_mx_voice_key[i] == key_id) {
                    if (env_is_held(_mx_voice_env[i])) { return i; }
                    _mx_voice_hp[i]    = hp;
                    _mx_voice_phase[i] = 0;
                    env_trigger(_mx_voice_env[i]);
                    return i;
                }
            }
        }
    }

    // First 8 slots are the SFX/tone pool. Slot 8 is reserved for
    // music, slot 9 is a spare — don't let tones land there.
    for (i = 0; i < 8; i++) {
        if (_mx_voice_active[i] == 0) {
            _mx_voice_kind[i]   = MX_KIND_TONE;
            _mx_voice_hp[i]     = hp;
            _mx_voice_amp[i]    = _MX_VOICE_AMP;
            _mx_voice_key[i]    = key_id;
            _mx_voice_phase[i]  = 0;
            _mx_voice_bus[i]    = MX_BUS_SFX;
            env_trigger(_mx_voice_env[i]);
            _mx_voice_active[i] = 1;
            return i;
        }
    }
    return -1;
}

// Play a decoded PCM buffer as a one-shot SFX. `buf` is a stereo
// s16 buffer (4 bytes per frame) of length `n_frames`. Typically
// the buffer comes from sound_load_wav — the mixer never copies,
// so the caller must keep it alive until playback finishes.
// Returns the voice slot used, or -1 if all SFX slots are busy.
mixer_play_sample(buf, n_frames: word) {
    auto i;
    // SFX pool: slots 0..7. Skip slot 8 (music) and beyond.
    for (i = 0; i < 8; i++) {
        if (_mx_voice_active[i] == 0) {
            _mx_voice_kind[i]   = MX_KIND_SAMPLE;
            _mx_voice_buf[i]    = buf;
            _mx_voice_pos[i]    = 0;
            _mx_voice_frames[i] = n_frames;
            _mx_voice_amp[i]    = _MX_VOICE_AMP;
            _mx_voice_bus[i]    = MX_BUS_SFX;
            _mx_voice_loop[i]   = 0;
            _mx_voice_active[i] = 1;
            return i;
        }
    }
    return -1;
}

// Start playing a decoded PCM buffer as background music. `loop`
// is 1 for looping, 0 for one-shot. Only one music voice plays at
// a time — calling mixer_play_music while music is already playing
// replaces the previous track. Returns 1 on success.
mixer_play_music(buf, n_frames: word, loop: word) {
    auto i;
    // Music lives on the dedicated slot 8.
    i = 8;
    _mx_voice_kind[i]   = MX_KIND_MUSIC;
    _mx_voice_buf[i]    = buf;
    _mx_voice_pos[i]    = 0;
    _mx_voice_frames[i] = n_frames;
    _mx_voice_amp[i]    = _MX_VOICE_AMP;
    _mx_voice_bus[i]    = MX_BUS_MUSIC;
    _mx_voice_loop[i]   = loop;
    _mx_voice_active[i] = 1;
    return 1;
}

// Stop the music voice. No-op when no music is playing.
void mixer_stop_music() {
    _mx_voice_active[8] = 0;
    _mx_voice_kind[8]   = MX_KIND_NONE;
}

// Return the playback position of the music voice in frames.
// Divide by the sample rate (44100) to convert to seconds — that
// gives the note-chart-synchronized `audio_time` that Rhythm
// Teacher schedules against.
mixer_music_frames() {
    if (_mx_voice_active[8] == 0) { return 0; }
    if (_mx_voice_kind[8] != MX_KIND_MUSIC) { return 0; }
    return _mx_voice_pos[8];
}

// Return current music time in milliseconds for convenience.
mixer_music_ms() {
    return mixer_music_frames() * 1000 / _MX_SAMPLE_RATE;
}

// Set a bus volume (0..100). `bus` is MX_BUS_MASTER / MX_BUS_MUSIC
// / MX_BUS_SFX. Clamped; out-of-range ids are silently ignored.
void mixer_set_bus_volume(bus: word, vol: word) {
    if (bus < 0) { return; }
    if (bus >= _MX_BUS_COUNT) { return; }
    if (vol < 0) { vol = 0; }
    if (vol > 100) { vol = 100; }
    _mx_bus_vol[bus] = vol;
}

mixer_get_bus_volume(bus: word) {
    if (bus < 0) { return 0; }
    if (bus >= _MX_BUS_COUNT) { return 0; }
    return _mx_bus_vol[bus];
}

// Set a bus volume in decibels (typical range 0..-60). Wraps
// mixer_set_bus_volume with integer dB → percent conversion. 0 dB
// maps to 100%, -6 dB halves (≈50%), -60 dB goes to 0. Useful
// for plugin-UI knobs that think in dB and for scripted mixing
// where percent is unintuitive.
void mixer_set_bus_volume_db(bus: word, db: word) {
    mixer_set_bus_volume(bus, _mx_db_to_pct(db));
}

// Read the bus volume as decibels. Inverse of set_bus_volume_db
// modulo integer percent storage rounding (see conversion caveat).
mixer_get_bus_volume_db(bus: word) {
    return _mx_pct_to_db(mixer_get_bus_volume(bus));
}

// Mute a specific bus. Remembers the pre-mute volume so
// mixer_unmute_bus restores it exactly. Calling mute on a
// currently-muted bus is a no-op — state stays consistent even
// on double-fire.
void mixer_mute_bus(bus: word) {
    if (bus < 0) { return; }
    if (bus >= _MX_BUS_COUNT) { return; }
    if (_mx_bus_muted[bus] != 0) { return; }
    _mx_bus_saved_vol[bus] = _mx_bus_vol[bus];
    _mx_bus_muted[bus]     = 1;
    _mx_bus_vol[bus]       = 0;
}

// Restore the pre-mute volume on a bus. No-op if the bus is not
// currently muted. Safe to call repeatedly.
void mixer_unmute_bus(bus: word) {
    if (bus < 0) { return; }
    if (bus >= _MX_BUS_COUNT) { return; }
    if (_mx_bus_muted[bus] == 0) { return; }
    _mx_bus_vol[bus]   = _mx_bus_saved_vol[bus];
    _mx_bus_muted[bus] = 0;
}

mixer_bus_is_muted(bus: word) {
    if (bus < 0) { return 0; }
    if (bus >= _MX_BUS_COUNT) { return 0; }
    return _mx_bus_muted[bus];
}

// Release every voice currently playing the given key_id. No-op when the
// key is not active. Starts the voice's envelope RELEASE stage rather than
// cutting it instantly — the slot stays active and audible (ringing out the
// short de-click tail) until mixer_fill ticks the envelope to idle. Rule 3:
// void because it only mutates global state.
void mixer_note_off(key_id: word) {
    auto i;
    for (i = 0; i < _MX_MAX_VOICES; i++) {
        if (_mx_voice_active[i] != 0) {
            if (_mx_voice_key[i] == key_id) {
                env_release(_mx_voice_env[i]);
            }
        }
    }
}

// Count voices currently sustaining. Handy for instrumentation and
// test assertions. Rule 4: pure read, Rule 11 ternary not useful
// here since we accumulate.
mixer_active_voices() {
    auto i, n;
    n = 0;
    for (i = 0; i < _MX_MAX_VOICES; i++) {
        if (_mx_voice_active[i] != 0) { n++; }
    }
    return n;
}

// Set the waveform fader. 0 = sine, 256 = triangle, 512 = saw,
// 768 = square. Clamped to [0, 768].
void mixer_set_fader(val: word) {
    if (val < 0)   { val = 0; }
    if (val > 768) { val = 768; }
    _mx_fader = val;
}

// Read the current fader position.
mixer_get_fader() { return _mx_fader; }

// Master volume (0..100). Scales the final mixed sum before pushing
// to the ring. Default 80 to leave headroom.
static extrn _mx_master_vol;

void mixer_set_master_volume(vol: word) {
    if (vol < 0)   { vol = 0; }
    if (vol > 100) { vol = 100; }
    _mx_master_vol = vol;
}

mixer_get_master_volume() { return _mx_master_vol; }

// Master volume in decibels. Same conversion as the bus dB
// helpers — wraps the percent setter with a dB → pct lookup.
// 0 dB = 100%, -6 = 50%, -12 = 25%, etc.
void mixer_set_master_volume_db(db: word) {
    mixer_set_master_volume(_mx_db_to_pct(db));
}

mixer_get_master_volume_db() {
    return _mx_pct_to_db(_mx_master_vol);
}

// Mute the master output. Remembers the pre-mute level so unmute
// restores it. Bus mutes are independent — muting master does not
// clear individual bus mutes. Effectively kills audio without
// altering the mixing ratios.
void mixer_mute_master() {
    if (_mx_master_muted != 0) { return; }
    _mx_master_saved_vol = _mx_master_vol;
    _mx_master_muted     = 1;
    _mx_master_vol       = 0;
}

void mixer_unmute_master() {
    if (_mx_master_muted == 0) { return; }
    _mx_master_vol   = _mx_master_saved_vol;
    _mx_master_muted = 0;
}

mixer_master_is_muted() { return _mx_master_muted; }

// ── Per-voice volume ────────────────────────────────────────────
// Each active voice stores its own amplitude. Normally set to
// _MX_VOICE_AMP (8000) when the voice lights up, but callers can
// re-tune individual voices at runtime — useful for fade-ins,
// ducking, or modulating a sustained note without touching the
// bus/master chain. Out-of-range slot IDs are ignored silently so
// callers can blindly apply volume changes from a key-handler.

// Set raw s16 peak amplitude for a specific voice slot. Clamped
// to 0..32767. The voice keeps this value until note_off or a
// subsequent set call — it does NOT reset to _MX_VOICE_AMP on
// the next note_on of a different key.
void mixer_set_voice_volume(slot: word, amp: word) {
    if (slot < 0) { return; }
    if (slot >= _MX_MAX_VOICES) { return; }
    if (amp < 0)     { amp = 0; }
    if (amp > 32767) { amp = 32767; }
    _mx_voice_amp[slot] = amp;
}

// Set the stereo pan of a voice. `pan` is -1 (hard left) .. 0 (centre) .. +1
// (hard right). A unity-centre balance law (centre = full gain both sides, the
// far side tapers to 0) so an unpanned voice is unchanged — panning never
// boosts, only attenuates one side. Gains are stored as float bits (0.0..1.0,
// the float-core migration's S3 — the mix loop is float now, so the gain IS
// the multiplier, no fixed-point conversion needed). Like voice volume, the
// pan persists until changed; out-of-range slots are ignored.
void mixer_set_voice_pan(slot: word, pan: float) {
    auto gl, gr;
    if (slot < 0) { return; }
    if (slot >= _MX_MAX_VOICES) { return; }
    if (pan < -1.0) { pan = -1.0; }
    if (pan >  1.0) { pan =  1.0; }
    gl = 1.0;
    gr = 1.0;
    if (pan > 0.0) { gl = 1.0 - pan; }   // panned right → attenuate L
    if (pan < 0.0) { gr = 1.0 + pan; }   // panned left  → attenuate R
    pokefloat(_mx_voice_pan_l + slot * 8, gl);
    pokefloat(_mx_voice_pan_r + slot * 8, gr);
}

// Read the current amplitude of a voice slot. Returns 0 if the
// slot is out of range.
mixer_get_voice_volume(slot: word) {
    if (slot < 0) { return 0; }
    if (slot >= _MX_MAX_VOICES) { return 0; }
    return _mx_voice_amp[slot];
}

// Set per-voice volume in decibels relative to full-scale (8000
// is roughly -12 dB of s16 peak). 0 dB maps to 32700 amp. Plugin-
// friendly override for voice-level fade curves.
void mixer_set_voice_volume_db(slot: word, db: word) {
    auto pct, amp;
    pct = _mx_db_to_pct(db);
    // Mirror stbaudio's 0 dB = 32700 convention so percent and
    // dB math agree with the platform-level set_amplitude.
    amp = pct * 327;
    mixer_set_voice_volume(slot, amp);
}

mixer_get_voice_volume_db(slot: word) {
    auto amp, pct;
    amp = mixer_get_voice_volume(slot);
    // Inverse of the setter: amp / 327 ≈ percent, then percent
    // → dB via the shared converter. The rounding means the
    // getter may differ from what the setter saw by ±1 dB at the
    // quiet end.
    pct = (amp + 163) / 327;
    return _mx_pct_to_db(pct);
}

// Dirt level (0..256). 0 = pristine clean, 256 = maximum crunch.
// Two effects stack: bitcrush (reduce bit depth of the final sum)
// and decimation (sample-and-hold, repeat each sample N frames).
// At 0 both are off and the output is the pure waveform. Moving
// the fader up introduces progressively harsher digital artifacts
// — the "fritação" the user heard from the integer sine table at
// low resolutions, now controllable.
static extrn _mx_dirt;
static extrn _mx_decim_counter;
static extrn _mx_held_l: float;  // decimation sample-and-hold, left channel
static extrn _mx_held_r: float;  // decimation sample-and-hold, right channel

// Rotary (Leslie) — a global auto-pan on the master mix, now a thin wrapper
// over a single `stbrotary` instance (`docs/plans/sound_fusion.md` slice 5b —
// the rotary graduated out of these inline globals into a Tier-2 effect any
// caller can instantiate; sound_fusion's sf_channel owns a SEPARATE instance
// per track). The public API below is unchanged on purpose — every existing
// caller (`mini_synth`, `tests/test_mixer_rotary.bpp`) keeps working without
// edits.
const MX_ROTARY_OFF     = ROTARY_OFF;       // motor stopped — no pan modulation
const MX_ROTARY_CHORALE = ROTARY_CHORALE;   // slow rotation (~48 RPM)
const MX_ROTARY_TREMOLO = ROTARY_TREMOLO;   // fast rotation (~400 RPM)

static extrn _mx_rotary;   // a Rotary handle (stbrotary.bsm) — the master-bus rotary

// Set the Leslie rotary speed: MX_ROTARY_OFF / MX_ROTARY_CHORALE /
// MX_ROTARY_TREMOLO. Delegates to stbrotary; out-of-range modes are ignored
// (current mode + rate keep playing) the same as before the graduation.
void mixer_set_rotary(mode: word) {
    rotary_set_mode(_mx_rotary, mode);
}

// Read the active rotary mode.
mixer_get_rotary() { return rotary_get_mode(_mx_rotary); }

void mixer_set_dirt(val: word) {
    if (val < 0)   { val = 0; }
    if (val > 256) { val = 256; }
    _mx_dirt = val;
}

mixer_get_dirt() { return _mx_dirt; }

// Fill `buf` with `n` stereo float32 frames of the current mix. Writes
// 8*n bytes — (left float32, right float32) per frame, Core Audio's own
// canonical format (docs/plans/legacy/audio_float_device_boundary.md — Part 2 of
// the float-core architecture). Returns n. Callers wanting to analyse or
// record raw samples use this primitive directly; the streaming wrapper
// below uses it too.
//
// The whole mix runs in float, -1.0..+1.0 full scale (the float-core
// migration, docs/plans/legacy/audio_float_core_migration.md) — s16 only shows up
// at the read of a sample/music buffer, which stays s16 on disk (the
// interchange-format boundary); the final write to `buf` is float now,
// straight through with no boundary conversion. Tone voices synthesize a
// float waveform per sample; sample voices read two s16s (stereo) from
// their buffer and normalize to float; music voices do the same but loop
// (or stop) at end-of-buffer.
mixer_fill(buf, n: word)@safe {
    auto f, v, phase, hp, amp, period;
    auto fader, si;
    auto kind, bus, bus_vol, sbuf, spos, sframes, left_s, right_s;
    auto master_bus_vol;
    auto master_gain_f;

    fader = _mx_fader;
    master_bus_vol = _mx_bus_vol[MX_BUS_MASTER];
    // master_vol/master_bus_vol stay the documented 0..100 percent API; the
    // float fraction is derived once per fill call, not per-sample (same
    // hoisting discipline as fader/master_bus_vol above).
    master_gain_f = _mx_master_vol / 100.0 * (master_bus_vol / 100.0);

    for (f = 0; f < n; f++) {
        auto left, right;
        left  = 0.0;
        right = 0.0;
        for (v = 0; v < _MX_MAX_VOICES; v++) {
            if (_mx_voice_active[v] == 0) { continue; }

            kind    = _mx_voice_kind[v];
            bus     = _mx_voice_bus[v];
            bus_vol = _mx_bus_vol[bus];

            // Pan gain for this voice — float bits stored in the same 8-byte
            // slot every other voice array uses, read via peekfloat (S3 of
            // the float-core migration; see mixer_set_voice_pan).
            auto pan_l_f, pan_r_f;
            pan_l_f = peekfloat(_mx_voice_pan_l + v * 8);
            pan_r_f = peekfloat(_mx_voice_pan_r + v * 8);

            if (kind == MX_KIND_TONE) {
                hp     = _mx_voice_hp[v];
                amp    = _mx_voice_amp[v];
                phase  = _mx_voice_phase[v];
                period = hp + hp;

                auto amp_f;
                amp_f = amp / 32768.0;

                auto sn_f, tri_f, saw_f, sq_f, sample_f, t_f;

                // Square: full-scale on/off.
                sq_f = phase < hp ? 1.0 : 0.0 - 1.0;

                // Sine: 32-point table lookup from bpp_math (fixed-point
                // x1024), normalized to [-1, 1].
                si = (phase * 32) / period;
                if (si > 31) { si = 31; }
                sn_f = math_sin(si) / 1024.0;

                // Triangle: ramp -1 -> +1 first half, +1 -> -1 second half.
                tri_f = phase < hp
                    ? 0.0 - 1.0 + phase * 2.0 / hp
                    : 3.0 - phase * 2.0 / hp;

                // Sawtooth: linear ramp -1 -> +1 over the full period.
                saw_f = 0.0 - 1.0 + phase * 2.0 / period;

                // Crossfade between adjacent waveform pairs (same shape as
                // before, blending float waveforms instead of int).
                //   0..256:   sine → triangle
                //   256..512: triangle → sawtooth
                //   512..768: sawtooth → square
                if (fader <= 256) {
                    t_f = fader;
                    sample_f = (sn_f * (256.0 - t_f) + tri_f * t_f) / 256.0;
                } else if (fader <= 512) {
                    t_f = fader - 256;
                    sample_f = (tri_f * (256.0 - t_f) + saw_f * t_f) / 256.0;
                } else {
                    t_f = fader - 512;
                    sample_f = (saw_f * (256.0 - t_f) + sq_f * t_f) / 256.0;
                }

                // Advance phase by exactly 1 per sample — same
                // discipline as _aud_square_cb. No wall-clock lookup,
                // no modulo, no jitter.
                phase++;
                if (phase >= period) { phase = 0; }
                _mx_voice_phase[v] = phase;

                // Apply per-voice amplitude + the ADSR envelope (de-click —
                // docs/plans/audio_dsp_architecture.md item 3) + the SFX bus
                // gain, then fold into L/R through the voice's float pan gain.
                auto env_lvl;
                env_lvl = env_tick(_mx_voice_env[v]);
                sample_f = sample_f * amp_f * env_lvl * (bus_vol / 100.0);
                left  = left  + sample_f * pan_l_f;
                right = right + sample_f * pan_r_f;

                // The envelope reaching IDLE is what actually frees the
                // slot now — note_off only started the release tail.
                if (env_is_active(_mx_voice_env[v]) == 0) {
                    _mx_voice_active[v] = 0;
                }

            } else if (kind == MX_KIND_SAMPLE) {
                // One-shot sample. Read one stereo s16 pair, normalize to
                // float, then advance position; deactivate at end of buffer.
                sbuf    = _mx_voice_buf[v];
                spos    = _mx_voice_pos[v];
                sframes = _mx_voice_frames[v];

                left_s  = peek_q(sbuf + spos * 4);
                right_s = peek_q(sbuf + spos * 4 + 2);
                // Sign-extend 16-bit samples.
                if (left_s  >= 32768) { left_s  = left_s  - 65536; }
                if (right_s >= 32768) { right_s -= 65536; }

                auto ls_f, rs_f;
                ls_f = left_s  / 32768.0 * (bus_vol / 100.0);
                rs_f = right_s / 32768.0 * (bus_vol / 100.0);
                left  = left  + ls_f * pan_l_f;
                right = right + rs_f * pan_r_f;

                spos++;
                if (spos >= sframes) {
                    _mx_voice_active[v] = 0;
                    _mx_voice_kind[v]   = MX_KIND_NONE;
                } else {
                    _mx_voice_pos[v] = spos;
                }

            } else if (kind == MX_KIND_MUSIC) {
                // Looping (or one-shot) streaming. Same read as SAMPLE
                // but wraps to 0 at end when loop flag is set.
                sbuf    = _mx_voice_buf[v];
                spos    = _mx_voice_pos[v];
                sframes = _mx_voice_frames[v];

                left_s  = peek_q(sbuf + spos * 4);
                right_s = peek_q(sbuf + spos * 4 + 2);
                if (left_s  >= 32768) { left_s  = left_s  - 65536; }
                if (right_s >= 32768) { right_s = right_s - 65536; }

                auto ls_f, rs_f;
                ls_f = left_s  / 32768.0 * (bus_vol / 100.0);
                rs_f = right_s / 32768.0 * (bus_vol / 100.0);
                left  = left  + ls_f * pan_l_f;
                right = right + rs_f * pan_r_f;

                spos++;
                if (spos >= sframes) {
                    if (_mx_voice_loop[v] != 0) {
                        spos = 0;
                    } else {
                        _mx_voice_active[v] = 0;
                        _mx_voice_kind[v]   = MX_KIND_NONE;
                    }
                }
                _mx_voice_pos[v] = spos;
            }
        }

        // ── Master stage (float throughout — left/right are already float,
        // no boundary conversion needed now that S2/S3 carry float all the
        // way from the per-voice loop) ────────────────────────────────────

        // Rotary (Leslie) — global auto-pan on the master sum. Delegates to
        // the stbrotary instance this mixer owns (`_mx_rotary`); the glide,
        // LFO tick, and unity-centre pan law all live there now
        // (docs/plans/sound_fusion.md slice 5b). Bypass-at-zero-cost when OFF
        // is `rotary_tick`'s own contract, not something this call site
        // needs to check first.
        left, right = rotary_tick(_mx_rotary, left, right);

        // Master gain, per channel — per-program master_vol (synthkey-era) then
        // the MASTER bus slider, as one float fraction (master_gain_f, hoisted
        // above the frame loop). A centred voice has left == right here, so the
        // output stays unchanged from the old mono path; a panned voice carries
        // a genuine stereo split.
        left  = left  * master_gain_f;
        right = right * master_gain_f;
        if (left  >  1.0) { left  =  1.0; }
        if (left  < 0.0 - 1.0) { left  = 0.0 - 1.0; }
        if (right >  1.0) { right =  1.0; }
        if (right < 0.0 - 1.0) { right = 0.0 - 1.0; }

        // Dirt: bitcrush + decimation (sample-and-hold). A deliberate
        // quantize-to-reduced-bit-depth-then-back-to-float detour (the real-
        // bitcrusher-plugin shape) rather than the engine's base precision —
        // the crush/decimate math itself is unchanged, just bracketed by the
        // s16 <-> float conversion at this one effect. The decimation counter
        // is shared so both channels hold/release on the same tick.
        if (_mx_dirt > 0) {
            auto crush, decim;
            auto il: word, ir: word;
            crush = _mx_dirt * 8 / 256;
            if (crush > 0) {
                il = left  * 32768.0;
                ir = right * 32768.0;
                il = (il >> crush) << crush;
                ir = (ir >> crush) << crush;
                left  = il / 32768.0;
                right = ir / 32768.0;
            }
            decim = 1 + _mx_dirt * 15 / 256;
            _mx_decim_counter++;
            if (_mx_decim_counter >= decim) {
                _mx_held_l = left;
                _mx_held_r = right;
                _mx_decim_counter = 0;
            }
            left  = _mx_held_l;
            right = _mx_held_r;
        }

        // The wire boundary — float32 now (docs/plans/audio_float_device_
        // boundary.md), Core Audio's own canonical format. `left`/`right`
        // are already the exact values the device wants; no conversion
        // needed here at all (Part 2 deletes a step Part 1 had to add).
        pokefloat_h(buf + f * 8 + 0, left);
        pokefloat_h(buf + f * 8 + 4, right);
    }
    return n;
}

// Generate up to `n` mixed frames and push them into the audio
// ring. `n` is clamped to the scratch buffer capacity
// (_MX_FILL_BUF_FRAMES). Returns the number of frames the ring
// actually accepted; fewer than the requested amount means the
// ring is full. Callers should typically pass min(audio_ring_space,
// 512) and sleep briefly between calls.
mixer_stream(n: word) {
    auto produced, pushed;
    if (n <= 0) { return 0; }
    if (n > _MX_FILL_BUF_FRAMES) { n = _MX_FILL_BUF_FRAMES; }
    produced = mixer_fill(_MX_FILL_BUF, n);
    pushed   = audio_push_frames(_MX_FILL_BUF, produced);
    return pushed;
}
