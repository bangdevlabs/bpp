// moon_filter.bsm — the moon filter plugin (a named effect for tiny_lofi).
//
// A resonant ladder low-pass you hang on a track. The DSP is the Moog ladder
// from the stbfilter cartridge; this wraps it as a self-contained plugin with
// its own state, a parameter setter, and a one-sample process call the host
// (a DAW track, or the standalone demo) drives. "moon" ~= moog — the house
// name for our filter. As more plugins arrive they follow the same shape:
// new / set / process / reset / free.
import "stbfilter.bsm";

// A plugin instance: the underlying Moog state plus the parameters the host
// edits — cutoff (Hz), resonance, the ladder slope (1..4 poles), and the
// sample rate the coefficients were computed for.
struct MoonFilter { flt, cutoff: float, reso: float, slope, sr: float }

moon_sizeof() { return 40; }   // 5 fields * 8 bytes

// Create a plugin instance for a given sample rate. Allocates the instance and
// its filter state and starts wide-open and gentle.
moon_new(sample_rate: float) -> ptr {
    auto p: MoonFilter;
    p = malloc(moon_sizeof());
    p.flt    = malloc(moog_sizeof());
    p.cutoff = 2000.0;
    p.reso   = 1.5;
    p.slope  = 4;
    p.sr     = sample_rate;
    moog_reset(p.flt);
    moog_set(p.flt, p.cutoff, p.reso, p.sr);
    return p;
}

// Set the plugin's parameters: cutoff (Hz), resonance, and slope (1..4 poles =
// -6..-24 dB/oct). Recomputes the filter coefficient.
void moon_set(p, cutoff: float, reso: float, slope) {
    auto pp: MoonFilter;
    pp = p;
    pp.cutoff = cutoff;
    pp.reso   = reso;
    pp.slope  = slope;
    moog_set(pp.flt, cutoff, reso, pp.sr);
}

// Clear the plugin's filter state (call when (re)starting playback).
void moon_reset(p) {
    auto pp: MoonFilter;
    pp = p;
    moog_reset(pp.flt);
}

// Process one sample: run it through the ladder at the chosen slope.
moon_process(p, in: float) -> float {
    auto pp: MoonFilter;
    pp = p;
    return moog_slope(pp.flt, in, pp.slope);
}

// Free the instance and its filter state.
void moon_free(p) {
    auto pp: MoonFilter;
    pp = p;
    free(pp.flt);
    free(p);
}
