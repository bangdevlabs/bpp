// moon_demo.bpp — standalone demo of the moon_filter plugin.
//
// Drives the plugin lifecycle (new / set / process / free) over a 110 Hz saw,
// and — unlike the lower-level moog_demo — shows the plugin's SLOPE parameter:
// the four seconds step through 1, 2, 3, 4 poles (-6/-12/-18/-24 dB/oct) at a
// fixed cutoff, so you can hear the ladder open up as the slope steepens.
//
// Run:  ./bpp tools/moon_filter/moon_demo.bpp -o /tmp/moon && /tmp/moon
//       then play moon_demo.wav
import "stbsound.bsm";
load "moon_filter.bsm";

const NF = 176400;          // 4 seconds at 44100

main() {
    auto pcm, f, i, peak;
    auto phase, dphase, saw, y;
    auto (sec, slope, s): word;

    pcm = malloc(NF * 4);            // stereo s16
    f   = moon_new(44100.0);

    phase  = 0.0;
    dphase = 110.0 / 44100.0;
    peak   = 0;

    for (i = 0; i < NF; i++) {
        // One slope per second: 1, 2, 3, 4 poles. Re-set only on a change.
        sec   = i / 44100;
        slope = sec + 1;
        if (i - sec * 44100 == 0) { moon_set(f, 1400.0, 2.4, slope); }

        phase += dphase;
        if (phase >= 1.0) { phase -= 1.0; }
        saw = 2.0 * phase - 1.0;

        y = moon_process(f, saw);

        s = y * 30000.0;            // makeup gain + clamp
        if (s >  32767) { s =  32767; }
        if (s < -32767) { s = -32767; }
        if (s > peak) { peak = s; }
        write_u16(pcm, i * 4 + 0, s);
        write_u16(pcm, i * 4 + 2, s);
    }

    sound_save_wav("moon_demo.wav", pcm, NF);
    moon_free(f);
    put("wrote moon_demo.wav — ", NF, " frames, slope sweep 1..4 poles, peak ", peak, "/32767\n");
    return 0;
}
