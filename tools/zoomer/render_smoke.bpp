// render_smoke.bpp — non-looping verification of the zoomer render path:
// capture -> BGRA texture -> compile/load the zoomer.metal pipeline ->
// report and exit (no window loop, so it never hangs).
import "stbgame.bsm";
import "stbrender.bsm";
import "stbshader.bsm";

main() {
    auto w, h, buf, tex, pipe;

    w = 0;
    h = 0;
    buf = _stb_screen_capture(&w, &h);
    if (buf == 0) { putstr("capture failed (permission?)\n"); return 1; }
    putstr("captured "); putnum(w); putstr(" x "); putnum(h); putchar('\n');

    game_init(640, 360, "zoomer-smoke", 60);
    render_init();

    tex = _stb_gpu_create_texture_bgra(buf, w, h);
    putstr("bgra texture handle = "); putnum(tex); putchar('\n');

    pipe = gpu_pipeline_load("tools/zoomer/zoomer.metal", "zoom_vert", "zoom_frag");
    if (pipe == 0) { putstr("PIPELINE FAILED to compile/load\n"); return 1; }
    putstr("pipeline OK (handle "); putnum(pipe); putstr(") — zoomer.metal compiled\n");

    return 0;
}
