// capture_smoke.bpp — first step of the zoomer port: prove the arm64
// screen-capture primitive compiles, links, and (when run with Screen
// Recording permission granted) returns real desktop pixels.
//
// Build + run from the repo root:
//   bpp tools/zoomer/capture_smoke.bpp -o /tmp/cap && /tmp/cap
//
// macOS will prompt for Screen Recording permission on first run
// (System Settings -> Privacy & Security -> Screen Recording). Grant it,
// then run again.
import "stbwindow.bsm";

main() {
    auto w, h, buf, i, sum;
    w = 0;
    h = 0;

    buf = screen_capture(&w, &h);
    if (buf == 0) {
        putstr("screen_capture failed (grant Screen Recording permission, or no display)\n");
        return 1;
    }

    putstr("captured "); putnum(w); putstr(" x "); putnum(h);
    putstr(" pixels (BGRA)\n");

    // Sanity: sum the blue channel across the first row so we can tell a
    // real capture from an all-zero buffer (blank = permission missing).
    sum = 0;
    i = 0;
    while (i < w) {
        sum = sum + read_u8(buf, i * 4);   // B of pixel i in the first row
        i = i + 1;
    }
    putstr("first-row blue sum = "); putnum(sum); putchar('\n');
    if (sum > 0) {
        putstr("looks like real pixels — capture works\n");
    } else {
        putstr("buffer is blank — Screen Recording permission likely not granted\n");
    }

    free(buf);
}
