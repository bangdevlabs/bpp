// blondie_amp.bsm — the Blondie amp plugin (a named effect for sound_fusion).
//
// A Fender-Bassman-style guitar amp you hang on a track: three cascaded tube
// stages, the FMV Treble/Middle/Bass tone stack, and a speaker cab — the warm,
// singing overdrive of a tweed amp, the other half of a spaghetti-western
// guitar rig (its partner is morricone_spring). The DSP is the `Amp` topology
// from the stbamp cartridge; this wraps it as a self-contained plugin with its
// own state, parameter setters, and a one-sample process call the host drives.
//
// The name is an homage: "Blondie" is Clint Eastwood's character in the
// Morricone-scored *The Good, the Bad and the Ugly* — not a product trademark,
// the same "named after a real-world reference" convention moon_filter (~Moog),
// zener_comp (~the Zener-diode limiter) and morricone_spring follow. Same plugin
// shape as its siblings: new / set / process / reset / free.
import "stbamp.bsm";

// A plugin instance: the underlying amp state plus the parameters the host
// edits — gain (preamp drive) and the three tone-stack knobs — and the sample
// rate the internal filters were sized for.
struct BlondieAmp { amp, gain: float, treble: float, mid: float, bass: float, sr: float }

// Create a plugin instance for a given sample rate. Allocates the instance and
// its amp state and starts at a crunchy-but-clear lead setting.
blondie_new(sample_rate: float) -> ptr {
    auto p: BlondieAmp;
    p = malloc(sizeof(BlondieAmp));
    p.amp    = amp_new(sample_rate);
    p.gain   = 0.5;
    p.treble = 0.6;
    p.mid    = 0.5;
    p.bass   = 0.6;
    p.sr     = sample_rate;
    amp_set_gain(p.amp, p.gain);
    amp_set_tone(p.amp, p.treble, p.mid, p.bass);
    return p;
}

// Set the plugin's parameters: gain (0..1, preamp drive) and the tone stack
// (treble, mid, bass — each 0..1). Forwards to the cartridge.
void blondie_set(p, gain: float, treble: float, mid: float, bass: float) {
    auto pp: BlondieAmp;
    pp = p;
    pp.gain   = gain;
    pp.treble = treble;
    pp.mid    = mid;
    pp.bass   = bass;
    amp_set_gain(pp.amp, gain);
    amp_set_tone(pp.amp, treble, mid, bass);
}

// Clear the amp's filter memory (call when (re)starting playback so it does not
// carry a transient across renders).
void blondie_reset(p) {
    auto pp: BlondieAmp;
    pp = p;
    amp_reset(pp.amp);
}

// Process one sample through the amp and return the output.
blondie_process(p, in: float) -> float {
    auto pp: BlondieAmp;
    pp = p;
    return amp_process(pp.amp, in);
}

// Free the instance and its amp state.
void blondie_free(p) {
    auto pp: BlondieAmp;
    pp = p;
    amp_free(pp.amp);
    free(p);
}
