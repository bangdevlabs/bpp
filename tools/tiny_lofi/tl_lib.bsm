// tl_lib.bsm — tiny_lofi engine aggregator.
//
// Pulls in the stb cartridges the DAW needs, then loads the engine modules in
// dependency order. The standalone entry (tiny_lofi.bpp) and a future Bang 9
// tab both reach the engine through this one file.
//
// Module map:
//   moon_filter — the insert plugin (a sibling tool, ../moon_filter), which
//                 itself imports the stbfilter DSP cartridge
//   tl_channel  — the mixer channels (volume + moon_filter insert)
//   tl_timeline — clips arranged over time + the offline mix/render
//   tl_io       — export to WAV (and, later, import a WAV as a clip)
//   tl_tools    — non-destructive edits (cut today; copy/paste/drag next)
import "stbsound.bsm";
load "../moon_filter/moon_filter.bsm";

// The channel count is shared by tl_channel + tl_timeline, which are parsed as
// their own units when `load`ed — a plain `const` (literal substitution) would
// not reach them, so this is a `global const` (a real cross-module slot the
// loaded modules resolve through the link graph).
global const TL_NTRACKS = 8;     // mixer channels

load "tl_channel.bsm";
load "tl_timeline.bsm";
load "tl_io.bsm";
load "tl_tools.bsm";

// Initialise the whole engine: channels first (they own the filter state),
// then the timeline's clip store. Call once before adding clips.
void tl_init() {
    tl_channel_init();
    tl_timeline_init();
}
