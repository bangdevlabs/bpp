// tl_io.bsm — render the arrangement to disk (and, later, import audio in).
//
// Today: export. The whole project is rendered to a stereo s16 buffer and
// written as a 44100 Hz WAV via stbsound. Import (loading a WAV into a clip
// buffer) lands with the clips slice.

// Render the whole project (`total_frames`, scaled by `master`) and write it
// to `path` as a WAV.
tl_export(path: ptr, total_frames, master: float) {
    auto out;
    out = malloc(total_frames * 4);     // stereo s16, 4 bytes per frame
    tl_render(out, total_frames, master);
    sound_save_wav(path, out, total_frames);
    free(out);
    return 0;
}
