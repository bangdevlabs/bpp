// tl_bench_flat.bpp — the SAME render as tl_bench, hand-inlined (zero function
// calls in the hot loop). This is what a perfect inliner would produce. If it
// lands near clang -O2, the 7x gap is 100% call overhead and our per-sample
// arithmetic codegen is already fine — which tells us the frontier is the
// inliner, not FP scheduling.
//
//   ./bpp tools/tiny_lofi/tl_bench_flat.bpp -o /tmp/tlf && /tmp/tlf

const TL_2PI  = 6.2831853;
const RENDERS = 400;

gen_sine(freq: float, frames) {
    auto buf, i, ph: float, dph: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = TL_2PI * freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        sw = 18000.0 * sin_f(ph);
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph > TL_2PI) { ph -= TL_2PI; }
    }
    return buf;
}

gen_saw(freq: float, frames) {
    auto buf, i, ph: float, dph: float, val: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        val = 2.0 * ph - 1.0;
        sw = 16000.0 * val;
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph >= 1.0) { ph -= 1.0; }
    }
    return buf;
}

main() {
    auto sine, saw, total, out, i, t0, t1, us, per, rtf;
    auto ct, cb, cs, cl, nclips;                 // parallel clip arrays
    auto vol;                                    // per-channel volume (s16-ish *1000)
    auto g: float, k: float, x: float;

    sine = gen_sine(220.0, 88200);
    saw  = gen_saw(330.0, 110250);
    total = 132300;
    out = malloc(total * 4);

    // Three clips (CH0 sine split in two at 1.0s + CH1 saw), as flat arrays.
    nclips = 3;
    ct = malloc(nclips * 8); cb = malloc(nclips * 8);
    cs = malloc(nclips * 8); cl = malloc(nclips * 8);
    poke_w(ct + 0, 0); poke_w(cb + 0, sine);            poke_w(cs + 0, 0);     poke_w(cl + 0, 44100);
    poke_w(ct + 8, 0); poke_w(cb + 8, sine + 44100*2);  poke_w(cs + 8, 44100); poke_w(cl + 8, 44100);
    poke_w(ct +16, 1); poke_w(cb +16, saw);             poke_w(cs +16, 22050); poke_w(cl +16, 110250);

    // Volumes (CH0 0.7, CH1 0.6, CH2..7 0.8) as floats in a buffer.
    vol = malloc(8 * 8);
    pokefloat(vol + 0, 0.7); pokefloat(vol + 8, 0.6);
    for (i = 2; i < 8; i++) { pokefloat(vol + i*8, 0.8); }

    // CH1 Moog coefficient (cutoff 1200, reso 2.6, sr 44100), slope 2 (tap b).
    x = TL_2PI * 1200.0 / 44100.0;
    g = x / (1.0 + x);
    k = 2.6;

    t0 = _stb_get_time_us();
    for (i = 0; i < RENDERS; i++) {
        auto t, tr, ci;
        auto s1: float, s2: float, s3: float, s4: float;
        auto master_v: float, ts: float, sf: float;
        auto a: float, b: float, c: float, d: float, fb: float;
        auto (rel, raw, si): word;
        s1 = 0.0; s2 = 0.0; s3 = 0.0; s4 = 0.0;     // fresh filter per render

        for (t = 0; t < total; t++) {
            master_v = 0.0;
            for (tr = 0; tr < 8; tr++) {
                ts = 0.0;
                for (ci = 0; ci < nclips; ci++) {
                    if (peek_w(ct + ci*8) != tr) { continue; }
                    if (t < peek_w(cs + ci*8))   { continue; }
                    rel = t - peek_w(cs + ci*8);
                    if (rel >= peek_w(cl + ci*8)) { continue; }
                    raw = peek_q(peek_w(cb + ci*8) + rel*2);
                    if (raw >= 32768) { raw -= 65536; }
                    sf = raw;
                    ts += sf / 32768.0;
                }
                if (tr == 1) {                       // CH1 Moog, slope 2 (tap b)
                    fb = ts - k * s4;
                    a  = s1 + g * (fb - s1);
                    b  = s2 + g * (a  - s2);
                    c  = s3 + g * (b  - s3);
                    d  = s4 + g * (c  - s4);
                    s1 = a; s2 = b; s3 = c; s4 = d;
                    ts = b;
                }
                ts = ts * peekfloat(vol + tr*8);
                master_v += ts;
            }
            master_v = master_v * 0.85;
            si = master_v * 32767.0;
            if (si >  32767) { si =  32767; }
            if (si < -32767) { si = -32767; }
            poke_q(out + t*4 + 0, si);
            poke_q(out + t*4 + 2, si);
        }
    }
    t1 = _stb_get_time_us();

    us  = t1 - t0;
    per = us / RENDERS;
    rtf = 3000000 / per;
    put("FLAT (hand-inlined) per 3s-render: ", per, " us   realtime: ", rtf, "x\n");
    return 0;
}
