// morricone_spring.bsm — the Morricone spring plugin (a named effect for sound_fusion).
//
// A spring-tank reverb you hang on a track: the wet, splashy, dispersive
// "drip" of a Fender amp's spring reverb — the signature sound of a spaghetti-
// western guitar. The DSP is the `spring` topology from the stbreverb cartridge
// (a dispersive allpass diffuser inside a damped feedback loop); this wraps it
// as a self-contained plugin with its own state, a parameter setter, and a
// one-sample process call the host (a DAW track, or a standalone demo) drives.
//
// The name is an homage to the composer Ennio Morricone — not a product
// trademark — the same "named after a real-world reference" convention
// moon_filter (~Moog) and zener_comp (~the Zener-diode limiter circuit) follow.
// As more plugins arrive they keep the same shape: new / set / process /
// reset / free.
import "stbreverb.bsm";

// A plugin instance: the underlying spring state plus the parameters the host
// edits — decay (tail length), damping (tone of the tail), the dry/wet mix,
// and the sample rate the delays were sized for.
struct MorriconeSpring { verb, decay: float, damp: float, mix: float, sr: float }

// Create a plugin instance for a given sample rate. Allocates the instance and
// its reverb state and starts with a medium tail suited to a lead guitar.
morricone_new(sample_rate: float) -> ptr {
    auto p: MorriconeSpring;
    p = malloc(sizeof(MorriconeSpring));
    p.verb  = spring_new(sample_rate);
    p.decay = 0.84;
    p.damp  = 0.2;
    p.mix   = 0.3;
    p.sr    = sample_rate;
    spring_set(p.verb, p.decay, p.damp, p.mix);
    return p;
}

// Set the plugin's parameters: decay (0..<1, tail length), damping (0 = bright,
// 1 = dark) and the dry/wet mix (0 = dry, 1 = wet). Forwards to the cartridge.
void morricone_set(p, decay: float, damp: float, mix: float) {
    auto pp: MorriconeSpring;
    pp = p;
    pp.decay = decay;
    pp.damp  = damp;
    pp.mix   = mix;
    spring_set(pp.verb, decay, damp, mix);
}

// Clear the reverb tail (call when (re)starting playback so the spring does not
// carry a wash across renders).
void morricone_reset(p) {
    auto pp: MorriconeSpring;
    pp = p;
    spring_reset(pp.verb);
}

// Process one sample: run it through the spring and return the dry/wet mix.
morricone_process(p, in: float) -> float {
    auto pp: MorriconeSpring;
    pp = p;
    return spring_process(pp.verb, in);
}

// Free the instance and its reverb state.
void morricone_free(p) {
    auto pp: MorriconeSpring;
    pp = p;
    spring_free(pp.verb);
    free(p);
}
