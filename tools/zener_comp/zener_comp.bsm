// zener_comp.bsm — the zener_comp plugin (a named effect for sound_fusion).
//
// A compressor/limiter in the spirit of the EMI TG12345's channel dynamics
// section (Abbey Road, 1968 — Beatles' Abbey Road, Pink Floyd's Dark Side
// of the Moon). The DSP is the dB-domain soft-knee compressor from the
// stbdynamics cartridge; this wraps it as a self-contained plugin with its
// own state, parameter setters, and a one-sample process call the host (a
// DAW track, or the standalone demo) drives. Named after the four matched
// Zener diodes that gave the original circuit its character — a real
// electronics term, not the trademarked product names ("TG12345 Channel
// Strip", "Zener Limiter") the commercial recreations use; same naming
// discipline moon_filter follows for the Moog ladder it wraps.
//
// As more plugins arrive they follow the same shape: new / set / process /
// reset / free — moon_filter is the precedent this mirrors field-for-field.
import "stbdynamics.bsm";

// A plugin instance: the underlying Compressor state plus the sample rate
// the coefficients were computed for (mirrors MoonFilter's own shape).
struct ZenerComp { comp, sr: float }

zener_sizeof() { return 16; }   // 2 fields * 8 bytes

// Create a plugin instance for a given sample rate. Allocates the instance
// and its compressor state; starts in COMPRESS mode at -6dB threshold
// (stbdynamics's own defaults).
zener_new(sample_rate: float) -> ptr {
    auto p: ZenerComp;
    p = malloc(zener_sizeof());
    p.comp = comp_new(sample_rate);
    p.sr   = sample_rate;
    return p;
}

// Set the mode: COMP_COMPRESS (2:1) or COMP_LIMIT (8:1).
void zener_set_mode(p, mode) {
    auto pp: ZenerComp;
    pp = p;
    comp_set_mode(pp.comp, mode);
}

// Set the release step: COMP_REL_100 .. COMP_REL_5000.
void zener_set_release(p, step) {
    auto pp: ZenerComp;
    pp = p;
    comp_set_release(pp.comp, step);
}

// Set the threshold in dB — how hard a signal must drive the channel
// before the compressor engages.
void zener_set_threshold_db(p, threshold_db: float) {
    auto pp: ZenerComp;
    pp = p;
    comp_set_threshold_db(pp.comp, threshold_db);
}

zener_get_mode(p) {
    auto pp: ZenerComp;
    pp = p;
    return comp_get_mode(pp.comp);
}

zener_get_release(p) {
    auto pp: ZenerComp;
    pp = p;
    return comp_get_release(pp.comp);
}

zener_get_threshold_db(p) -> float {
    auto pp: ZenerComp;
    pp = p;
    return comp_get_threshold_db(pp.comp);
}

// Clear the plugin's envelope state (call when (re)starting playback).
void zener_reset(p) {
    auto pp: ZenerComp;
    pp = p;
    comp_reset(pp.comp);
}

// Process one sample through the compressor.
zener_process(p, in: float) -> float {
    auto pp: ZenerComp;
    pp = p;
    return comp_process(pp.comp, in);
}

// Free the instance and its compressor state.
void zener_free(p) {
    auto pp: ZenerComp;
    pp = p;
    comp_free(pp.comp);
    free(p);
}
