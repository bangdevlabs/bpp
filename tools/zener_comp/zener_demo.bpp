// zener_demo.bpp — standalone demo of the zener_comp plugin.
//
// Drives the plugin lifecycle (new / set / process / free) over a loud,
// sustained 220 Hz tone, switching mode every 2 seconds: COMPRESS (2:1)
// for the first half, LIMIT (8:1) for the second — so you can hear the
// limiter bite down harder on the exact same signal, the same A/B the
// TG12345's own mode switch gave an engineer.
//
// Run:  ./bpp tools/zener_comp/zener_demo.bpp -o /tmp/zener && /tmp/zener
//       then play zener_demo.wav
import "stbsound.bsm";
load "zener_comp.bsm";

const NF = 176400;          // 4 seconds at 44100

main() {
    auto pcm, i, peak;
    auto phase: float, dphase: float, tone: float, y: float;
    auto (sec, s): word;
    auto p;

    pcm = malloc(NF * 4);            // stereo s16
    p   = zener_new(44100.0);
    zener_set_mode(p, COMP_COMPRESS);

    phase  = 0.0;
    dphase = 220.0 / 44100.0;
    peak   = 0;

    for (i = 0; i < NF; i++) {
        // Switch mode at the 2-second mark, once.
        sec = i / 44100;
        if (sec == 2 && i - sec * 44100 == 0) {
            zener_set_mode(p, COMP_LIMIT);
            put("-- switching to LIMIT (8:1) at t=2s --\n");
        }

        phase += dphase;
        if (phase >= 1.0) { phase -= 1.0; }
        tone = 0.9 * (2.0 * phase - 1.0);   // loud sawtooth, well past -6dB

        y = zener_process(p, tone);

        s = y * 32000.0;
        if (s >  32767) { s =  32767; }
        if (s < -32767) { s = -32767; }
        if (s > peak) { peak = s; }
        write_u16(pcm, i * 4 + 0, s);
        write_u16(pcm, i * 4 + 2, s);
    }

    sound_save_wav("zener_demo.wav", pcm, NF);
    zener_free(p);
    put("wrote zener_demo.wav — ", NF, " frames, COMPRESS->LIMIT at t=2s, peak ", peak, "/32767\n");
    return 0;
}
