// tl_tools.bsm — non-destructive timeline edits.
//
// The editing tool belt: cut (scissors) today, and — as the timeline grows —
// copy, paste, and drag. Every edit works on the clip store through the
// timeline's accessors, so the tools never touch the audio buffers directly.

// Split clip `ci` into two at timeline frame `at` (the scissors). The original
// is shortened to end at `at`; a new clip carries the remainder, reading the
// same buffer from the matching offset. Lossless: playing the two halves is
// identical to playing the original. A cut at or outside the clip's span is a
// no-op.
void tl_clip_split(ci, at) {
    auto cl: Clip, head_len, tail_off;
    cl = tl_clip_at(ci);
    if (at <= cl.start)          { return; }   // cut before the clip
    if (at >= cl.start + cl.len) { return; }   // cut after the clip
    head_len = at - cl.start;                  // frames kept in the original
    tail_off = head_len;                       // ... and skipped by the tail
    // Add the tail first — its arguments read the still-valid original clip.
    // The tail's buffer pointer is advanced tail_off samples (2 bytes each,
    // s16 mono) so it reads the region after the cut.
    tl_add_clip(cl.track, cl.buf + tail_off * 2, cl.frames - tail_off,
                at, cl.len - head_len);
    // arr_struct_alloc inside tl_add_clip may have grown (and moved) the clip
    // store, so re-fetch the original before shrinking it in place.
    cl = tl_clip_at(ci);
    cl.len = head_len;
}
