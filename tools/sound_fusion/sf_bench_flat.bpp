// sf_bench_flat.bpp — the SAME render as sf_bench, hand-inlined (zero function
// calls in the hot loop). This is what a perfect inliner would produce. If it
// lands near clang -O2, the gap is 100% call overhead and our per-sample
// arithmetic codegen is already fine — which tells us the frontier is the
// inliner, not FP scheduling.
//
// Mirrors sf_bench's CURRENT demo project exactly (docs/plans/inliner_arc.md
// re-decomposition, 2026-06-22): CH0 bass (centre pan, no insert), CH1 lead
// (Moog @ slope 2 + constant-power pan + the rotary insert, ROTARY_CHORALE).
// The rotary was added to sf_bench the same day this file was updated — it
// used to be mono-only and never modelled pan or the rotary at all, which
// quietly made the inliner-arc gap decomposition stale once stereo (2026-06-19)
// and the rotary insert (slice 5, 2026-06-22) shipped on the real engine
// without a matching update here.
//
//   ./bpp tools/sound_fusion/sf_bench_flat.bpp -o /tmp/sff && /tmp/sff

const SF_2PI  = 6.2831853;
const RENDERS = 400;

gen_sine(freq: float, frames) {
    auto buf, i, ph: float, dph: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = SF_2PI * freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        sw = 18000.0 * sin_f(ph);
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph > SF_2PI) { ph -= SF_2PI; }
    }
    return buf;
}

gen_saw(freq: float, frames) {
    auto buf, i, ph: float, dph: float, val: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        val = 2.0 * ph - 1.0;
        sw = 16000.0 * val;
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph >= 1.0) { ph -= 1.0; }
    }
    return buf;
}

main() {
    auto sine, saw, total, out, i, t0, t1, us, per, rtf;
    auto ct, cb, cs, cl, nclips;                 // parallel clip arrays
    auto vol;                                    // per-channel volume
    auto g: float, k: float, x: float;
    auto gl0: float, gr0: float, gl1: float, gr1: float;   // precomputed pan gains
    auto theta: float;
    auto r_cur: float, r_tgt: float, r_inc_base: float;    // rotary state that
                                                            // PERSISTS across
                                                            // renders (only phase
                                                            // resets — matches
                                                            // sf_channel_reset_
                                                            // filters' rotary_reset,
                                                            // which only resets
                                                            // LFO phase)

    sine = gen_sine(220.0, 88200);
    saw  = gen_saw(330.0, 110250);
    total = 132300;
    out = malloc(total * 8);                     // stereo float32 — sf_render's device-wire output

    // Three clips (CH0 sine split in two at 1.0s + CH1 saw), as flat arrays.
    nclips = 3;
    ct = malloc(nclips * 8); cb = malloc(nclips * 8);
    cs = malloc(nclips * 8); cl = malloc(nclips * 8);
    poke_w(ct + 0, 0); poke_w(cb + 0, sine);            poke_w(cs + 0, 0);     poke_w(cl + 0, 44100);
    poke_w(ct + 8, 0); poke_w(cb + 8, sine + 44100*2);  poke_w(cs + 8, 44100); poke_w(cl + 8, 44100);
    poke_w(ct +16, 1); poke_w(cb +16, saw);             poke_w(cs +16, 22050); poke_w(cl +16, 110250);

    // Volumes (CH0 0.7, CH1 0.6, CH2..7 0.8) as floats in a buffer.
    vol = malloc(8 * 8);
    pokefloat(vol + 0, 0.7); pokefloat(vol + 8, 0.6);
    for (i = 2; i < 8; i++) { pokefloat(vol + i*8, 0.8); }

    // CH1 Moog coefficient (cutoff 1200, reso 2.6, sr 44100), slope 2 (tap b).
    x = SF_2PI * 1200.0 / 44100.0;
    g = x / (1.0 + x);
    k = 2.6;

    // Precomputed constant-power pan gains (_sf_apply_pan's math) — CH0 pan
    // 0.0 (centre), CH1 pan 0.5 (right-leaning). Computed once, same as the
    // real engine: pan is constant per track, the trig never runs per sample.
    theta = (0.0 + 1.0) * 0.78539816;
    gl0 = cos_f(theta); gr0 = sin_f(theta);
    theta = (0.5 + 1.0) * 0.78539816;
    gl1 = cos_f(theta); gr1 = sin_f(theta);

    // Rotary on CH1: ROTARY_CHORALE (target rate 0.8 Hz). cur/tgt persist
    // across the RENDERS loop exactly like the real engine's Rotary instance
    // does (sf_track_set_rotary is called once, outside sf_bench's render
    // loop, same as here).
    r_cur = 0.0;
    r_tgt = 0.8;

    t0 = _stb_get_time_us();
    for (i = 0; i < RENDERS; i++) {
        auto t, tr, ci;
        auto s1: float, s2: float, s3: float, s4: float;
        auto master_l: float, master_r: float, ts: float, sf: float;
        auto a: float, b: float, c: float, d: float, fb: float;
        auto (rel, raw): word;
        auto l1: float, r1: float;                       // CH1's post-pan stereo pair
        auto r_phase: float, rm: float, rgl: float, rgr: float;
        s1 = 0.0; s2 = 0.0; s3 = 0.0; s4 = 0.0;     // fresh filter per render
        r_phase = 0.0;                              // fresh LFO phase per render

        for (t = 0; t < total; t++) {
            master_l = 0.0; master_r = 0.0;
            for (tr = 0; tr < 8; tr++) {
                ts = 0.0;
                for (ci = 0; ci < nclips; ci++) {
                    if (peek_w(ct + ci*8) != tr) { continue; }
                    if (t < peek_w(cs + ci*8))   { continue; }
                    rel = t - peek_w(cs + ci*8);
                    if (rel >= peek_w(cl + ci*8)) { continue; }
                    raw = peek_q(peek_w(cb + ci*8) + rel*2);
                    if (raw >= 32768) { raw -= 65536; }
                    sf = raw;
                    ts += sf / 32768.0;
                }
                if (tr == 1) {                       // CH1 Moog, slope 2 (tap b)
                    fb = ts - k * s4;
                    a  = s1 + g * (fb - s1);
                    b  = s2 + g * (a  - s2);
                    c  = s3 + g * (b  - s3);
                    d  = s4 + g * (c  - s4);
                    s1 = a; s2 = b; s3 = c; s4 = d;
                    ts = b;
                }
                ts = ts * peekfloat(vol + tr*8);

                if (tr == 1) {
                    // Pan (constant-power, precomputed gains).
                    l1 = ts * gl1;
                    r1 = ts * gr1;
                    // Rotary insert (rotary_tick, inlined): glide cur toward
                    // tgt, advance the LFO, apply the unity-centre pan law.
                    if (r_cur < r_tgt) {
                        r_cur += 0.0001;
                        if (r_cur > r_tgt) { r_cur = r_tgt; }
                    } else if (r_cur > r_tgt) {
                        r_cur -= 0.0001;
                        if (r_cur < r_tgt) { r_cur = r_tgt; }
                    }
                    rm = sin_f(r_phase * SF_2PI);
                    r_phase += r_cur / 44100.0;
                    if (r_phase >= 1.0) { r_phase -= 1.0; }
                    rgl = 1.0; rgr = 1.0;
                    if (rm > 0.0) { rgl = 1.0 - rm; }
                    if (rm < 0.0) { rgr = 1.0 + rm; }
                    l1 = l1 * rgl; r1 = r1 * rgr;
                    master_l += l1; master_r += r1;
                } else {
                    // CH0 (and the silent CH2..7) — pan only, no insert.
                    master_l += ts * gl0;
                    master_r += ts * gr0;
                }
            }
            master_l = master_l * 0.85; master_r = master_r * 0.85;
            if (master_l >  1.0)      { master_l =  1.0; }
            if (master_l < 0.0 - 1.0) { master_l = 0.0 - 1.0; }
            if (master_r >  1.0)      { master_r =  1.0; }
            if (master_r < 0.0 - 1.0) { master_r = 0.0 - 1.0; }
            pokefloat_h(out + t*8 + 0, master_l);
            pokefloat_h(out + t*8 + 4, master_r);
        }
    }
    t1 = _stb_get_time_us();

    us  = t1 - t0;
    per = us / RENDERS;
    rtf = 3000000 / per;
    put("FLAT (hand-inlined) per 3s-render: ", per, " us   realtime: ", rtf, "x\n");
    return 0;
}
