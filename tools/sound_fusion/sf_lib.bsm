// sf_lib.bsm — sound_fusion engine aggregator.
//
// Pulls in the stb cartridges the DAW needs, then loads the engine modules in
// dependency order. The standalone entry (sound_fusion.bpp) and a future Bang 9
// tab both reach the engine through this one file.
//
// Module map:
//   moon_filter  — the insert plugin (a sibling tool, ../moon_filter), which
//                  itself imports the stbfilter DSP cartridge
//   stbrotary    — the rotary insert (Tier-2, graduated out of stbmixer's
//                  single global instance — docs/plans/sound_fusion.md slice 5b)
//   zener_comp   — the compressor insert (a sibling tool, ../zener_comp,
//                  TG12345-style channel dynamics — docs/plans/sound_fusion.md
//                  slice 8), which itself imports the stbdynamics DSP cartridge
//   morricone_spring — the spring-reverb insert (a sibling tool,
//                  ../morricone_spring), which itself imports the stbreverb
//                  cartridge (a Morricone-style guitar spring)
//   sf_channel   — the mixer channels (volume + a fixed Moog-then-compressor-
//                  then-spring-then-rotary four-slot insert chain)
//   sf_timeline  — clips arranged over time + the offline mix/render
//   sf_io        — export to WAV (and, later, import a WAV as a clip)
//   sf_tools     — non-destructive edits (cut today; copy/paste/drag next)
import "stbsound.bsm";
import "stbrotary.bsm";
load "../moon_filter/moon_filter.bsm";
load "../zener_comp/zener_comp.bsm";
load "../morricone_spring/morricone_spring.bsm";
load "../blondie_amp/blondie_amp.bsm";      // Fender Bassman amp (imports stbamp)

// The channel count is shared by sf_channel + sf_timeline, which are parsed as
// their own units when `load`ed — a plain `const` (literal substitution) would
// not reach them, so this is a `global const` (a real cross-module slot the
// loaded modules resolve through the link graph).
global const SF_NTRACKS = 8;     // mixer channels

load "sf_channel.bsm";
load "sf_timeline.bsm";
load "sf_io.bsm";
load "sf_tools.bsm";

// Initialise the whole engine: channels first (they own the filter state),
// then the timeline's clip store. Call once before adding clips.
void sf_init() {
    sf_channel_init();
    sf_timeline_init();
}
