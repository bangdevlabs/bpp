// sf_timeline.bsm — clips arranged over time + the offline mix.
//
// A clip is a slice of an s16 mono buffer placed on a channel at a start frame
// (s16 stays the on-disk/source interchange format — see Clip below). This
// module owns the clip store and the render: a frame-outer, channel-inner
// mix that sums each channel's active clips, runs them through the channel
// strip (sf_channel_process), and writes the master to a stereo FLOAT32
// buffer — Core Audio's own device-wire format, see sf_render's own header.

// One clip: `len` frames of s16 mono `buf`, placed at `start` on the timeline.
// `frames` is the buffer's own length, so a split clip can point part-way into
// a shared buffer without copying it.
struct Clip { track, buf, frames, start, len }

static auto _sf_clips;      // arr_struct<Clip>

void sf_timeline_init() {
    _sf_clips = arr_struct_new(sizeof(Clip), 64);
}

// Place a clip on `track` starting at timeline frame `start`, playing `len`
// frames of `buf` (an s16 mono buffer of `frames` samples).
void sf_add_clip(track, buf, frames, start, len) {
    auto idx, cl: Clip;
    // alloc reserves a slot and returns its INDEX; `at` turns that into the
    // pointer we fill in (the canonical alloc-then-at pattern).
    idx = arr_struct_alloc(_sf_clips);
    cl  = arr_struct_at(_sf_clips, idx);
    cl.track  = track;
    cl.buf    = buf;
    cl.frames = frames;
    cl.start  = start;
    cl.len    = len;
}

// How many clips are on the timeline, and the pointer to clip `i`. The tools
// and the render reach the clip store only through these two accessors.
sf_clip_count() { return arr_struct_count(_sf_clips); }
sf_clip_at(i)   { return arr_struct_at(_sf_clips, i); }

// Remove clip `i` from the timeline — a swap-remove (arr_struct_remove), so
// the clip that was LAST is now at index `i`. Fine here: a Clip's identity
// is its own (track, start, len) fields, not its position in the store, and
// nothing iterates the store assuming index order. Callers that cached
// index `i` for any other reason (the GUI's selection) must clear it after
// removing, the same way any swap-remove invalidates "the thing I was
// tracking by index."
void sf_remove_clip(i) {
    arr_struct_remove(_sf_clips, i);
}

// Render `total_frames` of the whole arrangement into `out_buf` — STEREO
// FLOAT32 (8 bytes/frame), scaled by `master`. Frame-outer, channel-inner
// so each channel's stateful filter sees consecutive samples.
//
// Float32 is Core Audio's own device-wire format
// (docs/plans/legacy/audio_float_device_boundary.md) — the same format
// `stbaudio.audio_push_frames` has read since that migration shipped. This
// function used to write s16 directly, which made `sf_gui_run`'s live
// Play path (the only caller that ever fed this buffer straight to
// `audio_push_frames`) a THIRD hand-rolled-wire-format bug of the exact
// shape the migration's own "Found and fixed" list already named twice:
// reinterpreting s16 integer bit patterns as IEEE-754 float32 decodes to
// huge/NaN magnitudes — audible as harsh, ear-hurting broadband noise, not
// a subtle glitch. `sf_export` converts to s16 itself, at the WAV
// interchange-format boundary, the same place every other s16-on-disk
// conversion in the repo happens (mini_synth's recording loop is the
// other worked example).
// Render `n` frames of the arrangement starting at absolute timeline frame
// `start_frame` into `out_buf` (block-relative: out_buf[0] is start_frame).
// Does NOT reset the channel inserts — their state (filter memory, compressor
// envelope, rotary LFO phase) MUST carry across consecutive blocks for the
// realtime playback path to sound continuous. The caller resets once at
// transport start (sf_render does it for the full offline render; the GUI's
// Play does it for live playback). Reading the clip store, mute/solo, and the
// channel params fresh each call is exactly what makes live edits audible
// mid-playback.
void sf_render_block(out_buf, start_frame, n, master: float) {
    auto i, t, tr, ci, nclips, cl: Clip, any_solo;
    auto (master_l, master_r, ts, sf, chl, chr): float;
    auto (rel, raw): word;

    nclips   = arr_struct_count(_sf_clips);
    any_solo = sf_any_solo();

    for (i = 0; i < n; i++) {
        t = start_frame + i;
        master_l = 0.0; master_r = 0.0;
        for (tr = 0; tr < SF_NTRACKS; tr++) {
            // Mute/solo: skip a muted channel, and — when any channel is
            // soloed — skip every channel that is not itself soloed. Skipping
            // entirely (rather than multiplying by 0) means the channel's
            // insert state simply doesn't advance, which is correct and cheaper.
            if (sf_channel_muted(tr) != 0) { continue; }
            if (any_solo != 0 && sf_channel_solo(tr) == 0) { continue; }
            ts = 0.0;
            // Sum this channel's clips that are active at frame t.
            for (ci = 0; ci < nclips; ci++) {
                cl = arr_struct_at(_sf_clips, ci);
                if (cl.track != tr) { continue; }
                if (t < cl.start)   { continue; }
                rel = t - cl.start;
                if (rel >= cl.len)  { continue; }
                raw = read_u16(cl.buf, rel * 2);
                if (raw >= 32768) { raw -= 65536; }   // u16 -> s16
                sf = raw;                              // int -> float
                ts += sf / 32768.0;
            }
            // The channel strip returns its STEREO (L, R) contribution — the
            // multi-return consumer. Accumulate each side into the master bus.
            chl, chr = sf_channel_process(tr, ts);
            master_l += chl;
            master_r += chr;
        }
        master_l *= master; master_r *= master;
        if (master_l >  1.0)       { master_l =  1.0; }
        if (master_l < 0.0 - 1.0)  { master_l = 0.0 - 1.0; }
        if (master_r >  1.0)       { master_r =  1.0; }
        if (master_r < 0.0 - 1.0)  { master_r = 0.0 - 1.0; }
        pokefloat_h(out_buf + i * 8 + 0, master_l);    // L (block-relative)
        pokefloat_h(out_buf + i * 8 + 4, master_r);    // R
    }
}

// Full offline render (Export / headless / the audio-correctness md5 baseline):
// reset the inserts, then render the whole arrangement from frame 0. A thin
// wrapper over sf_render_block so the offline and realtime paths share one mix
// loop — and byte-identical to the pre-refactor behaviour (reset + render 0..N).
void sf_render(out_buf, total_frames, master: float) {
    sf_channel_reset_filters();
    sf_render_block(out_buf, 0, total_frames, master);
}
