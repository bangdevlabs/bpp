// sound_fusion.bpp — an 8/16-bit mini DAW (standalone entry).
//
// Builds a hardcoded test project on the engine, then opens the DAW window
// (sf_gui). The engine is split into modules (channel / timeline / io / tools)
// kept window-agnostic in sf_lib.bsm, so a Bang 9 tab can later drive the same
// engine without this file's window loop.
//
// Run:  ./bpp tools/sound_fusion/sound_fusion.bpp -o /tmp/sf && (cd /tmp && /tmp/sf)
//         opens the DAW window.
//       ./sf --render   writes sound_fusion_test.wav headlessly (no window).
import "stbwindow.bsm";       // window + frame loop
import "stbui.bsm";           // draw + input stack
import "stbaudio.bsm";        // audio device for playback
load "sf_lib.bsm";            // the engine (channel / timeline / io / tools)
load "sf_gui.bsm";            // the DAW window

const SF_2PI = 6.2831853;     // for the test-signal generators (float const)

// ── Test signal generators (scaffolding until WAV import lands) ──────

gen_sine(freq: float, frames) {
    auto buf, i, ph: float, dph: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = SF_2PI * freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        sw = 18000.0 * sin_f(ph);
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph > SF_2PI) { ph -= SF_2PI; }
    }
    return buf;
}

gen_saw(freq: float, frames) {
    auto buf, i, ph: float, dph: float, val: float;
    buf = malloc(frames * 2);
    ph = 0.0; dph = freq / 44100.0;
    for (i = 0; i < frames; i++) {
        auto sw: word;
        val = 2.0 * ph - 1.0;
        sw = 16000.0 * val;
        write_u16(buf, i * 2, sw);
        ph += dph;
        if (ph >= 1.0) { ph -= 1.0; }
    }
    return buf;
}

// ── The hardcoded test project: prove the engine end to end ─────────

main() {
    auto sine, saw, total;
    sf_init();

    // Channel 0: a clean 220 Hz sine (a bass note), no filter, slope unused.
    sf_track_set(0, 0.7, 0, 0.0, 0.0, 4, 0.0);     // bass — centre pan
    sine = gen_sine(220.0, 88200);                 // 2 seconds
    sf_add_clip(0, sine, 88200, 0, 88200);         // plays 0.0 .. 2.0 s

    // Scissors: cut the bass clip in half at 1.0 s. Playing the two halves is
    // identical to the whole — the cut is lossless (this dogfoods sf_tools).
    sf_clip_split(0, 44100);

    // Channel 1: a 330 Hz sawtooth through the Moog at a 2-pole (12 dB/oct)
    // slope — an open, buzzy lofi lead. The slope is selected from the filter's
    // four ladder taps, which moog_taps returns in one multi-value call.
    sf_track_set(1, 0.6, 1, 1200.0, 2.6, 2, 0.5);  // lead — panned right (stereo)
    // Rotary on top of the Moog — the lead spins through a slow Leslie swirl
    // (docs/plans/sound_fusion.md slice 5a/5b: this is the dogfood proof that
    // the insert chain is real and stacks, not just the Moog alone).
    sf_track_set_rotary(1, 1, ROTARY_CHORALE);
    saw = gen_saw(330.0, 110250);                  // 2.5 seconds
    sf_add_clip(1, saw, 110250, 22050, 110250);    // plays 0.5 .. 3.0 s

    // Channel 2: dogfood WAV import (docs/plans/sound_fusion.md slice 6a). Save
    // the bass's dry mono signal out to a real WAV file, then import it
    // straight back in as a fresh clip — proving the round-trip a recorded
    // take (mini_synth's own SPACE-to-WAV, or any external sample) needs to
    // become a normal Clip with zero special-casing. Placed hard left so
    // it's audibly distinct from the centred original.
    auto stereo_tmp, i2, sw: word;
    stereo_tmp = malloc(44100 * 4);                // 1 second, stereo s16
    for (i2 = 0; i2 < 44100; i2++) {
        sw = read_u16(sine, i2 * 2);
        write_u16(stereo_tmp, i2 * 4 + 0, sw);
        write_u16(stereo_tmp, i2 * 4 + 2, sw);
    }
    sound_save_wav("sf_import_dogfood.wav", stereo_tmp, 44100);
    free(stereo_tmp);
    sf_track_set(2, 0.5, 0, 0.0, 0.0, 4, 0.0 - 1.0);     // hard left, no insert
    sf_import_clip(2, "sf_import_dogfood.wav", 44100);   // plays 1.0 .. 2.0 s

    total = 132300;                                // 3 seconds

    // `./tl --render` writes the WAV headlessly (CI / quick check); with no
    // args it opens the DAW window over the same project.
    if (argc_get() > 1 && str_eq(argv_get(1), "--render")) {
        sf_export("sound_fusion_test.wav", total, 0.85);
        put("rendered sound_fusion_test.wav (headless) — ", total, " frames\n");
        return 0;
    }

    sf_gui_run(total, 0.85);
    return 0;
}
