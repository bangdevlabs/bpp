// Exercise 1-3. Greatest common divisor by Euclid's algorithm.
//
// `gcd` keeps its inputs `a` and `b` and does its work in the locals
// `x` and `y` — one clear way to write it. Since arguments are passed
// by value (§1.8), it could equally well count `a` and `b` down
// directly; both are correct.
gcd(a, b) {
    auto x, y, t;
    x = a;
    y = b;
    while (y != 0) {
        t = x % y;
        x = y;
        y = t;
    }
    return x;
}

main() {
    assert(gcd(48, 36) == 12);
    assert(gcd(17, 5)  == 1);
    assert(gcd(100, 10) == 10);
    put("gcd ok\n");
}
