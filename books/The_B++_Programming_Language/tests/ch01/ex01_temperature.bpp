// Exercise 1-1. Print a Celsius-to-Fahrenheit table from 0 to 100 in
// steps of 10, using a function for the conversion. The asserts check
// the integer arithmetic at a few points (B++ divides integers, so the
// fractional part is dropped).
c2f(c) {
    auto f;
    f = c * 9 / 5 + 32;
    return f;
}

main() {
    auto c;
    for (c = 0; c <= 100; c = c + 10) {
        putnum(c); putchar('\t'); putnum(c2f(c)); putchar('\n');
    }
    assert(c2f(0)   == 32);
    assert(c2f(100) == 212);
    assert(c2f(37)  == 98);   // 37*9/5 + 32 = 66 + 32
}
