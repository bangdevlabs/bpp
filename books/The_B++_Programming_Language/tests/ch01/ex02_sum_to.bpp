// Exercise 1-2. Write a function that adds the integers 1..n and
// verify it against the well-known total for n = 100.
sum_to(n) {
    auto i, s;
    s = 0;
    for (i = 1; i <= n; i = i + 1) {
        s = s + i;
    }
    return s;
}

main() {
    assert(sum_to(100) == 5050);
    assert(sum_to(1)   == 1);
    assert(sum_to(0)   == 0);
    putstr("sum_to ok\n");
}
