// Exercise 1-5. Reverse the decimal digits of a non-negative number,
// peeling off one digit at a time with `% 10` and `/ 10`.
reverse(n) {
    auto v, r;
    v = n;
    r = 0;
    while (v > 0) {
        r = r * 10 + v % 10;
        v = v / 10;
    }
    return r;
}

main() {
    assert(reverse(1234) == 4321);
    assert(reverse(100)  == 1);     // trailing zeros disappear
    assert(reverse(7)    == 7);
    putstr("reverse ok\n");
}
