// Exercise 1-6. The n-th Fibonacci number, computed iteratively with
// two running values rather than recursion.
fib(n) {
    auto a, b, t, i;
    a = 0;
    b = 1;
    for (i = 0; i < n; i = i + 1) {
        t = a + b;
        a = b;
        b = t;
    }
    return a;
}

main() {
    assert(fib(0)  == 0);
    assert(fib(1)  == 1);
    assert(fib(10) == 55);
    assert(fib(20) == 6765);
    put("fib ok\n");
}
