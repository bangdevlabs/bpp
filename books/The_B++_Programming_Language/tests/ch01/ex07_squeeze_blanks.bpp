// Exercise 1-7. Copy input to output, replacing each run of one or
// more blanks (spaces or tabs) with a single space. This is a stdin
// filter; the book runner feeds it sample text and checks it exits
// cleanly. Try it by hand:  echo "a    b   c" | ./ex07_squeeze_blanks
main() {
    auto c, prev;
    prev = 0;

    c = getchar();
    while (c != -1) {
        if (c == ' ' || c == '\t') {
            if (prev != ' ') {
                putchar(' ');
            }
            prev = ' ';
        } else {
            putchar(c);
            prev = c;
        }
        c = getchar();
    }
}
