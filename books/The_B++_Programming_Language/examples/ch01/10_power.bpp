// A function of our own. `power` raises `base` to the `n`-th power for
// n >= 0, and `main` uses it to print a table of powers of 2 and 3.
//
// A function names a piece of work so it can be reused. It receives
// its arguments, does its work, and hands back one value with
// `return`.
power(base, n) {
    auto result, i;
    result = 1;
    for (i = 0; i < n; i = i + 1) {
        result = result * base;
    }
    return result;
}

main() {
    auto i;
    for (i = 0; i < 10; i = i + 1) {
        put(i, "\t", power(2, i), "\t", power(3, i), "\n");
    }
}
