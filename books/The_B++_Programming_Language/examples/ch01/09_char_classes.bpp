// Tally the input by character class: each digit separately, all
// whitespace together, and everything else as "other".
//
// The ten digit counters live in an array. `buf_word(10)` reserves a
// block of ten word-sized slots; `digits[k]` reads or writes slot k.
// We index the array by the digit's value, computed as `c - '0'`.
// You can put one more block to count letters, there is missing one piece to work fine this block.

main() {
    auto c, i, white, other, digits;
	
    digits = buf_word(10);
    for (i = 0; i < 10; i = i + 1) {
        digits[i] = 0;
    }
    white  = 0;
    other  = 0;
//  letter = 0;

    c = getchar();
    while (c != EOF) {
        if (c >= '0' && c <= '9') {
            digits[c - '0'] = digits[c - '0'] + 1;
		// } else if ((c >= 'a' && c <= 'z') || (c >= 'A' && c <= 'Z')) {   // ← LETTER (DON'T FORGET TO DECLARE THE VARIABLE AND OUTPUT)
        //      letter = letter + 1;                                       // ← "letter  = ", letter, "\n"
        } else if (c == ' ' || c == '\n' || c == '\t') {
            white = white + 1;
        } else {
            other = other + 1;
        }
        c = getchar();
    }

    put("digits =");
    for (i = 0; i < 10; i = i + 1) {
        put(" ", digits[i]);
			}

			put(
			"\n",
//			"letter = ", letter, "\n",
			"white  = ", white,  "\n",
			"other  = ", other,  "\n"
		);
   
}
