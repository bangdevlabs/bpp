// Count the lines on standard input. A line ends with a newline
// character, so we simply count the newlines we see.
main() {
    auto c, lines;
    lines = 0;

    c = getchar();
    while (c != -1) {
        if (c == '\n') {
            lines = lines + 1;
        }
        c = getchar();
    }

    put(lines, " lines \n");
}
