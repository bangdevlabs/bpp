// Copy standard input to standard output, one byte at a time.
//
// `getchar` reads a single byte and returns its value (0..255), or -1
// when the input runs out. The loop reads, then writes, until that -1
// arrives. This is the skeleton of every input-processing program in
// the chapter.
main() {
    auto c;

    c = getchar();
    while (c != -1) {
        putchar(c);
        c = getchar();
    }
}
