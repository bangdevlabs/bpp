// Magic numbers in code are hard to read and easy to get wrong. A
// `const` at file scope gives a value a name. The name is substituted
// for the value at compile time, so it costs nothing at run time.
//
// Change the table's range by editing one line each, not by hunting
// for every `1` and `8` in the loop.
const LOWER = 1;    // first value in the table
const UPPER = 16;    // last value in the table
const STEP  = 1;    // distance between rows

main() {
    auto n;

    for (n = LOWER; n <= UPPER; n = n + STEP) {
        put(n, "\t", n * n, "\t", n * n * n, "\n");
    }
}
