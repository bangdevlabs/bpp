// The same table written with a `for` loop. A `for` gathers the three
// parts of a counted loop — initialise, test, advance — onto one line,
// so the body is left to do just the work.
main() {
    auto n;

    for (n = 1; n <= 8; n = n + 1) {
        putnum(n);          putchar('\t');
        putnum(n * n);      putchar('\t');
        putnum(n * n * n);  putchar('\n');
    }
}
