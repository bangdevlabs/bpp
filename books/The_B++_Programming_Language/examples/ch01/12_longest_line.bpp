// Read standard input line by line and print the longest line seen.
//
// A line is stored in a byte buffer — a "character array". `get_line`
// fills the buffer one byte at a time with `write_u8(buf, i, value)`,
// keeps the terminating newline, and writes a final 0 so the text can
// be printed with `putstr`. `buf_move` copies the winning line aside.
const MAXLINE = 1000;

// Read one line into `buf` (at most limit-1 bytes, then a 0).
// Returns the number of characters read, including the newline.
// Returns 0 at end of input.
get_line(buf, limit) {
    auto c, i;
    i = 0;

    c = getchar();
    while (c != -1 && c != '\n') {
        if (i < limit - 1) { write_u8(buf, i, c); }
        i = i + 1;
        c = getchar();
    }
    if (c == '\n') {
        if (i < limit - 1) { write_u8(buf, i, '\n'); }
        i = i + 1;
    }
    write_u8(buf, i, 0);   // terminate so putstr knows where to stop
    return i;
}

main() {
    auto line, longest, len, max;
    line    = buf_byte(MAXLINE);
    longest = buf_byte(MAXLINE);
    max = 0;
    write_u8(longest, 0, 0);   // longest starts empty

    len = get_line(line, MAXLINE);
    while (len > 0) {
        if (len > max) {
            max = len;
            buf_move(longest, line, len + 1);   // copy text and the 0
        }
        len = get_line(line, MAXLINE);
    }

    if (max > 0) {
        put("longest (", max, "): ");
        putstr(longest);   // a byte-buffer pointer — putstr prints the text
    }
}
