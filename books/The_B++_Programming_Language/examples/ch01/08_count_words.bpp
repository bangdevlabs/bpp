// Count the words on standard input. A "word" is any run of
// characters with no blanks inside it; blanks are spaces, tabs, and
// newlines.
//
// The trick is a small state machine: we remember whether we are
// currently inside a word. We count a word at the moment we cross
// from OUT to IN.
const IN  = 1;   // the scanner is inside a word
const OUT = 0;   // the scanner is between words

main() {
    auto c, words, state;
    words = 0;
    state = OUT;

    c = getchar();
    while (c != -1) {
        if (c == ' ' || c == '\n' || c == '\t') {
            state = OUT;
        } else if (state == OUT) {
            state = IN;
            words = words + 1;
        }
        c = getchar();
    }

    put(words, " words \n");
}
