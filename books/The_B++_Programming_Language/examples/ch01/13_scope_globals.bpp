// External variables and scope. A variable declared with `global` at
// file scope is visible to every function in the file, for the whole
// run of the program. Use it for state that several functions share,
// instead of threading the same value through call after call.
//
// Here `g_max` and `g_longest` hold the best line so far. `main` fills
// them and `save_longest` reads and updates them directly — no extra
// parameters needed.
const MAXLINE = 1000;

global g_max;       // length of the longest line seen so far
global g_longest;   // buffer holding that line

get_line(buf, limit) {
    auto c, i;
    i = 0;
    c = getchar();
    while (c != -1 && c != '\n') {
        if (i < limit - 1) { write_u8(buf, i, c); }
        i = i + 1;
        c = getchar();
    }
    if (c == '\n') {
        if (i < limit - 1) { write_u8(buf, i, '\n'); }
        i = i + 1;
    }
    write_u8(buf, i, 0);
    return i;
}

// Note: no g_max / g_longest parameters — they are shared globals.
save_longest(line, len) {
    if (len > g_max) {
        g_max = len;
        buf_move(g_longest, line, len + 1);
    }
}

main() {
    auto line, len;
    line      = buf_byte(MAXLINE);
    g_longest = buf_byte(MAXLINE);
    g_max     = 0;
    write_u8(g_longest, 0, 0);

    len = get_line(line, MAXLINE);
    while (len > 0) {
        save_longest(line, len);
        len = get_line(line, MAXLINE);
    }

    if (g_max > 0) {
        putstr("longest ("); putnum(g_max); putstr("): ");
        putstr(g_longest);
    }
}
