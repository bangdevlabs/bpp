// B++ passes arguments by value: each function receives a private copy
// of what the caller passed in. A function may treat a parameter as an
// ordinary working variable and change it freely — the caller's value
// is untouched. Only the returned value carries a result back out.
//
// `countdown_sum` adds n + (n-1) + ... + 1 by counting its own
// parameter `n` down to zero. That is convenient and perfectly safe:
// the `n` it decrements is its own copy, not the caller's.
countdown_sum(n) {
    auto sum;
    sum = 0;
    while (n > 0) {
        sum = sum + n;
        n = n - 1;        // changing the parameter is fine — it is our copy
    }
    return sum;
}

main() {
    auto k, total;
    k = 5;
    total = countdown_sum(k);

    putstr("total = "); putnum(total); putchar('\n');   // 5+4+3+2+1 = 15
    putstr("k     = "); putnum(k);     putchar('\n');   // still 5
}
