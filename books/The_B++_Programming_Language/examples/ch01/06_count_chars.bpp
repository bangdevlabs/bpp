// Count the characters arriving on standard input.
//
// Same read loop as the echo program, but instead of writing each
// byte we add one to a running total and print it at the end.
main() {
    auto c, count;
    count = 0;

    c = getchar();
    while (c != -1) {
        count = count + 1;
        c = getchar();
    }

    putnum(count);
    putchar('\n');
}
