// Print a small table: each integer alongside its square and cube.
//
// This introduces variables (`auto`), assignment, arithmetic, and the
// `while` loop. Each row is one `put`: it takes any number of
// arguments and prints each in order, picking the right format for its
// type — the numbers as digits, the "\t" / "\n" strings as text.
main() {
    auto n, last;
    n = 1;
    last = 8;

    while (n <= last) {
        put(n, "\t", n * n, "\t", n * n * n, "\n");
        n = n + 1;
    }
}
