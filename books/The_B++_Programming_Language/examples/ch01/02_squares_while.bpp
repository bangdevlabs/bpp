// Print a small table: each integer alongside its square and cube.
//
// This introduces variables (`auto`), assignment, arithmetic, and the
// `while` loop. We print integers with `putnum` (not `put`): on a
// plain `auto` value `put` would warn that it cannot tell a number
// from a string, so we say "this is a number" explicitly.
main() {
    auto n, last;
    n = 1;
    last = 8;

    while (n <= last) {
        putnum(n);          putchar('\t');
        putnum(n * n);      putchar('\t');
        putnum(n * n * n);  putchar('\n');
        n = n + 1;
    }
}
