// test_float_nan_cmp.bpp — IEEE 754 comparison semantics with NaN and ±inf.
//
// Locks in the x64 UCOMISD lowering fix (2026-07-03): any comparison with
// NaN must be FALSE except `!=`, which must be TRUE. x86's UCOMISD reports
// "unordered" as ZF = PF = CF = 1, so a bare setcc lies for EQ (sete reads
// ZF -> NaN == NaN gave 1), NE (setne -> NaN != NaN gave 0) and LT/LE
// (setb/setbe read CF -> NaN < x gave 1). The fix swaps operands + uses the
// ABOVE family for LT/LE and folds PF into EQ/NE. a64's FCMP has always
// been correct by ISA design; this test keeps the two backends agreeing —
// the `x != x` NaN idiom underpins the DSP totality guards on every chip.
//
// NaN and ±inf are manufactured at runtime (1.0/0.0, inf - inf) so no
// constant-folding path can pre-answer the comparisons.

main() {
    auto (z, inf, nan, one): float;
    z = 0.0;
    inf = 1.0 / z;
    nan = inf - inf;
    one = 1.0;

    // ── NaN vs itself: only != is true ────────────────────────────────
    if ((nan == nan ? 1 : 0) != 0) { putmsg("FAIL: NaN == NaN must be false"); return 1; }
    if ((nan != nan ? 1 : 0) != 1) { putmsg("FAIL: NaN != NaN must be true");  return 2; }

    // ── NaN vs a number: every ordering is false, != is true ──────────
    if ((nan <  one ? 1 : 0) != 0) { putmsg("FAIL: NaN < 1 must be false");   return 3; }
    if ((nan <= one ? 1 : 0) != 0) { putmsg("FAIL: NaN <= 1 must be false");  return 4; }
    if ((nan >  one ? 1 : 0) != 0) { putmsg("FAIL: NaN > 1 must be false");   return 5; }
    if ((nan >= one ? 1 : 0) != 0) { putmsg("FAIL: NaN >= 1 must be false");  return 6; }
    if ((one <  nan ? 1 : 0) != 0) { putmsg("FAIL: 1 < NaN must be false");   return 7; }
    if ((one == nan ? 1 : 0) != 0) { putmsg("FAIL: 1 == NaN must be false");  return 8; }
    if ((one != nan ? 1 : 0) != 1) { putmsg("FAIL: 1 != NaN must be true");   return 9; }

    // ── the totality-guard idiom: inf - inf is NaN, NaN != 0 is true ──
    if (((inf - inf) != 0.0 ? 1 : 0) != 1) { putmsg("FAIL: inf-inf != 0 must be true"); return 10; }

    // ── ±inf itself is ORDERED — normal comparisons must still work ───
    if ((inf > 1000000000.0 ? 1 : 0) != 1)  { putmsg("FAIL: inf > 1e9 must be true");   return 11; }
    if (((-inf) < -1000000000.0 ? 1 : 0) != 1) { putmsg("FAIL: -inf < -1e9 must be true"); return 12; }
    if ((inf == inf ? 1 : 0) != 1)  { putmsg("FAIL: inf == inf must be true");  return 13; }
    if ((inf != inf ? 1 : 0) != 0)  { putmsg("FAIL: inf != inf must be false"); return 14; }

    // ── finite comparisons unchanged by the new lowering ──────────────
    if ((1.5 <  2.5 ? 1 : 0) != 1) { putmsg("FAIL: 1.5 < 2.5");   return 15; }
    if ((2.5 <= 2.5 ? 1 : 0) != 1) { putmsg("FAIL: 2.5 <= 2.5");  return 16; }
    if ((2.5 <  1.5 ? 1 : 0) != 0) { putmsg("FAIL: 2.5 < 1.5");   return 17; }
    if ((1.5 == 1.5 ? 1 : 0) != 1) { putmsg("FAIL: 1.5 == 1.5");  return 18; }
    if ((1.5 != 2.5 ? 1 : 0) != 1) { putmsg("FAIL: 1.5 != 2.5");  return 19; }

    putmsg("PASS: IEEE NaN/inf comparison semantics correct");
    return 0;
}
