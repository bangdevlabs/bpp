// test_float_cip_lit.bpp — the third gap of the rotary_tick investigation
// (after struct-field leaves and comparison operators): a float literal
// operand (`r.cur + 0.0001`, `x > 1.5`) always bailed out of compute-in-
// place entirely, on both the arithmetic and comparison paths, because
// neither cg_float_tree_need leaf check recognized T_LIT. Exercises a
// literal as: the right operand of arithmetic, the right operand of a
// comparison, mixed with a struct-field operand (the realistic
// `r.cur += 0.0001`-style shape), and on a promoted plain local too.

struct Filt { a: float, b: float }

// `f` promoted (referenced enough times); exercises struct-field +
// literal arithmetic AND struct-field-vs-literal comparison together —
// the exact rotary_tick shape.
hot_lit(fp) -> word {
    auto f: Filt, r: float, n: word;
    f = fp;
    n = 0;
    r = f.a + 0.5;
    if (r != 2.5) { n = n + 1; }
    if (f.b > 1.5) { n = n + 1; }
    if (f.a == 2.0) { n = n + 1; }
    r = f.b - 0.25;
    if (r != 2.75) { n = n + 1; }
    return n;
}

// Plain promoted float local (no struct field at all) against a literal —
// isolates the T_LIT leaf from the T_MEMLD leaf this builds on.
hot_lit_plain(x: float) -> word {
    auto s: float, n: word;
    n = 0;
    s = x;
    s = s + s + 1.25;
    if (s != 6.25) { n = n + 1; }
    if (s >= 6.25) { n = n + 1; }
    if (s < 6.25) { n = n + 1; }
    return n;
}

main() {
    auto f: Filt, n: word;
    f = malloc(16);
    f.a = 2.0;
    f.b = 3.0;

    // r=2.5(eq,no inc); f.b=3.0>1.5(T,+1); f.a==2.0(T,+1); r=2.75(eq,no inc) -> 2
    n = hot_lit(f);
    if (n != 2) { return 1; }

    // x=2.5: s=2.5+2.5+1.25=6.25; s!=6.25(F); s>=6.25(T,+1); s<6.25(F) -> 1
    n = hot_lit_plain(2.5);
    if (n != 1) { return 2; }

    return 0;
}
