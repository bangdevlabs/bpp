// test_stbrotary.bpp — exercise the instanced Leslie rotary directly,
// independent of stbmixer (which now just wraps one instance of this for
// its own master bus — see docs/plans/tiny_lofi.md slice 5b).
//
// Covers:
//   1. A fresh instance defaults to OFF — rotary_tick is a pure passthrough.
//   2. rotary_set_mode(CHORALE) eventually makes L diverge from R.
//   3. Out-of-range modes are ignored.
//   4. Two independent instances do not share state (the whole point of
//      graduating out of stbmixer's single global).

import "stbrotary.bsm";

main() {
    auto r1, r2, i, diverged;
    auto (l, rr, l2, r2v): float;

    // (1) Fresh instance defaults to OFF; tick is an exact passthrough.
    r1 = rotary_new(44100.0);
    if (rotary_get_mode(r1) != ROTARY_OFF) {
        putmsg("FAIL: fresh rotary should default to OFF");
        return 1;
    }
    l, rr = rotary_tick(r1, 0.5, 0.5);
    if (l != 0.5 || rr != 0.5) {
        putmsg("FAIL: OFF rotary should pass (L,R) through unchanged");
        return 2;
    }

    // (2) CHORALE — the glide + LFO should eventually swing L away from R.
    rotary_set_mode(r1, ROTARY_CHORALE);
    if (rotary_get_mode(r1) != ROTARY_CHORALE) {
        putmsg("FAIL: get_mode should report CHORALE");
        return 3;
    }
    diverged = 0;
    for (i = 0; i < 30000; i++) {
        l, rr = rotary_tick(r1, 0.5, 0.5);
        if (l != rr) { diverged = 1; break; }
    }
    if (diverged == 0) {
        putmsg("FAIL: rotary CHORALE never made L diverge from R");
        return 4;
    }

    // (3) Out-of-range modes are ignored — last valid mode keeps playing.
    rotary_set_mode(r1, 99);
    if (rotary_get_mode(r1) != ROTARY_CHORALE) {
        putmsg("FAIL: out-of-range mode should be ignored");
        return 5;
    }
    rotary_set_mode(r1, 0 - 1);
    if (rotary_get_mode(r1) != ROTARY_CHORALE) {
        putmsg("FAIL: negative mode should be ignored");
        return 6;
    }

    // (4) A second, independent instance does not inherit r1's state — the
    // whole point of the graduation out of stbmixer's single global.
    r2 = rotary_new(44100.0);
    if (rotary_get_mode(r2) != ROTARY_OFF) {
        putmsg("FAIL: a second instance should start OFF regardless of r1");
        return 7;
    }
    l2, r2v = rotary_tick(r2, 0.3, 0.3);
    if (l2 != 0.3 || r2v != 0.3) {
        putmsg("FAIL: r2 should still be an exact OFF passthrough while r1 spins");
        return 8;
    }

    rotary_reset(r1);
    rotary_free(r1);
    rotary_free(r2);

    putmsg("stbrotary: passed");
    return 0;
}
