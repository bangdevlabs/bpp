// test_float_cip_cmp.bpp — gap 1 of the rotary_tick investigation: float
// comparisons (< > <= >= == !=) now reuse compute-in-place to evaluate
// their operands, instead of the save-left/evaluate-right/resolve dance
// that always shuttled the left operand into a fixed d1 slot even when
// nothing in between could clobber it. Mirrors test_float_cip_memld.bpp's
// promoted/non-promoted split so both cg_try_float_cmp's fast paths get
// exercised, but for comparisons specifically.

struct Filt { a: float, b: float, c: float, d: float }

// `f` is referenced enough times to get B3-promoted.
hot_cmp(fp, x: float) -> word {
    auto f: Filt, n: word;
    f = fp;
    n = 0;
    if (f.a < f.b) { n = n + 1; }
    if (f.c >= f.d) { n = n + 1; }
    if (f.a == x) { n = n + 1; }
    if (f.b != x) { n = n + 1; }
    if (f.d > f.c - 0.5) { n = n + 1; }
    return n;
}

// `f` is referenced exactly once — never promoted.
cold_cmp(fp) -> word {
    auto f: Filt;
    f = fp;
    if (f.a <= f.b) { return 1; }
    return 0;
}

main() {
    auto f: Filt, n: word;
    f = malloc(32);
    f.a = 2.0;
    f.b = 3.0;
    f.c = 4.0;
    f.d = 5.0;

    // f.a<f.b(T) f.c>=f.d(F) f.a==2.0(T) f.b!=2.0(T) f.d>f.c-0.5=3.5(T) -> 4
    n = hot_cmp(f, 2.0);
    if (n != 4) { return 1; }

    // x=3.0: f.a<f.b(T) f.c>=f.d(F) f.a==3.0(F) f.b!=3.0(F) f.d>3.5(T) -> 2
    n = hot_cmp(f, 3.0);
    if (n != 2) { return 2; }

    n = cold_cmp(f);
    if (n != 1) { return 3; }

    // Array of structs — comparisons against a non-const-offset base
    // (loop-varying), feeding into the const-offset field comparisons.
    auto arr, i, hits;
    arr = malloc(3 * 32);
    for (i = 0; i < 3; i++) {
        auto e: Filt;
        e = arr + i * 32;
        e.a = i + 1.0;
        e.b = i + 5.0;
        e.c = i + 3.0;
        e.d = i + 3.0;
    }
    hits = 0;
    for (i = 0; i < 3; i++) {
        auto e2: Filt;
        e2 = arr + i * 32;
        if (e2.a < e2.b) { hits = hits + 1; }   // always true (a = i+1, b = i+5)
        if (e2.c == e2.d) { hits = hits + 1; }  // always true (c == d)
    }
    if (hits != 6) { return 4; }

    return 0;
}
