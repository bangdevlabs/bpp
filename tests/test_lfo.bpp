// test_lfo.bpp — stblfo: a sine LFO reaches +-1 and stays in range; a square
// LFO is +1 in the first half of the cycle and -1 in the second.
import "stblfo.bsm";

myabs(x: float) -> float { return x < 0.0 ? 0.0 - x : x; }

main() {
    auto lf: Lfo, i, ok;
    auto (v, mn, mx): float;
    ok = 1;

    // Sine, 1 Hz at sr 8 → 8 samples per cycle. Over two cycles it must reach
    // ~+1 and ~-1 and never leave [-1, 1].
    lf = lfo_new(8.0);
    lfo_set(lf, 1.0, LFO_SIN);
    mn = 2.0;
    mx = 0.0 - 2.0;
    for (i = 0; i < 16; i++) {
        v = lfo_tick(lf);
        if (v < mn) { mn = v; }
        if (v > mx) { mx = v; }
        if (v >  1.001)       { ok = 0; }
        if (v <  0.0 - 1.001) { ok = 0; }
    }
    if (myabs(mx - 1.0) > 0.05) { ok = 0; }
    if (myabs(mn + 1.0) > 0.05) { ok = 0; }
    lfo_free(lf);

    // Square: first half of the cycle = +1, second half = -1.
    lf = lfo_new(8.0);
    lfo_set(lf, 1.0, LFO_SQUARE);
    v = lfo_tick(lf);                          // phase 0.0 → +1
    if (myabs(v - 1.0) > 0.001) { ok = 0; }
    for (i = 0; i < 3; i++) { lfo_tick(lf); }  // advance to phase 0.5
    v = lfo_tick(lf);                          // phase 0.5 → -1
    if (myabs(v + 1.0) > 0.001) { ok = 0; }
    lfo_free(lf);

    if (ok) { put("stblfo: PASS\n"); } else { put("stblfo: FAIL\n"); }
    return 0;
}
