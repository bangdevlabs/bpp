// test_inline_bind.bpp — single-return multi-use-param inlining via the binding
// splice (inliner Inc 2). A param used more than once can no longer take the
// fast substitute path; it routes through cg_emit_inline_multi, which BINDS a
// side-effecting arg to a temp once. The danger this guards against: evaluating
// the arg once per param use. Self-verifying — each mismatch returns a distinct
// non-zero code.
auto _ctr;

// Side-effecting: each call bumps the global and returns the new value.
next() { _ctr = _ctr + 1; return _ctr; }

// Multi-use params (x twice; a twice, b once) — these are the Inc 2 candidates.
sq(x)    { return x * x; }
mix(a, b) { return a * b + a; }

main() {
    auto r, i, sum;

    // 1. Simple-var / literal args (substitute path): no side effects.
    if (sq(5)    != 25) { return 1; }    // 5*5
    if (mix(3, 4) != 15) { return 2; }   // 3*4+3

    // 2. Side-effecting arg (bind path): the arg must run EXACTLY ONCE.
    _ctr = 0;
    r = sq(next());                      // next()->1, 1*1 = 1
    if (r    != 1) { return 3; }
    if (_ctr != 1) { return 4; }         // double-eval would leave _ctr == 2

    _ctr = 10;
    r = mix(next(), 2);                  // next()->11, 11*2+11 = 33
    if (r    != 33) { return 5; }
    if (_ctr != 11) { return 6; }        // double-eval of `a` would leave 12

    // 3. Hot-loop shape: sum of squares 0..9 = 285.
    sum = 0;
    for (i = 0; i < 10; i++) { sum = sum + sq(i); }
    if (sum != 285) { return 7; }

    return 0;
}
