// `: u_word` must make the four ORDERING comparisons (< <= > >=) unsigned,
// the same way it already makes / % >> unsigned. Equality (== / !=) is
// signedness-agnostic and is covered by test_unsigned_arith_shared.
//
// The discriminating value is 2^63 (0x8000000000000000): as a signed word
// it is INT64_MIN (negative); as an unsigned word it is the larger half of
// the range. A signed compare and an unsigned compare therefore give the
// OPPOSITE answer for it — which is exactly what makes this a real test.
//
// Surfaced 2026-06-12 while studying the book's power() example: putnum's
// `m >= 10` loop guard mis-fired on 2^63 because ordering comparisons
// ignored the u_word annotation and stayed on the signed path.
main() {
    auto s, big_u: u_word, lo_u: u_word, v;

    big_u = 1; big_u = big_u << 63;   // 0x8000000000000000
    lo_u  = 10;

    // Unsigned ordering across the sign-bit boundary.
    if ((big_u >  lo_u)  != 1) { return 1; }   // 2^63 >  10  → true
    if ((big_u >= lo_u)  != 1) { return 2; }   // 2^63 >= 10  → true
    if ((lo_u  <  big_u) != 1) { return 3; }   // 10   <  2^63 → true
    if ((lo_u  <= big_u) != 1) { return 4; }   // 10   <= 2^63 → true
    if ((big_u <  lo_u)  != 0) { return 5; }   // 2^63 <  10  → false
    if ((big_u <= lo_u)  != 0) { return 6; }   // 2^63 <= 10  → false

    // Value context (the result feeds an assignment, not just a branch).
    v = big_u >= lo_u;
    if (v != 1) { return 7; }

    // Regression guard: a plain (signed) word must still compare signed.
    // Same bits as big_u, but no u_word annotation → INT64_MIN semantics.
    s = 1; s = s << 63;
    if ((s > 10) != 0) { return 8; }   // signed: INT64_MIN >  10 → false
    if ((s < 10) != 1) { return 9; }   // signed: INT64_MIN <  10 → true

    // Ordinary small unsigned values still behave.
    lo_u = 5;
    if ((lo_u < big_u) != 1) { return 10; }
    if ((big_u < lo_u) != 0) { return 11; }

    return 0;
}
