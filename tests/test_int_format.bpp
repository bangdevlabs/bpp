// str_from_int must format every int64 correctly — including the two
// boundary values the naive "negate, then loop while > 0" approach breaks
// on: INT64_MIN (cannot be negated in two's-complement) and 0. The fix
// formats the magnitude through a u_word, which relies on `: u_word`
// driving the unsigned `> 0`, `% 10`, `/ 10` in the digit loop.
//
// Companion to test_unsigned_cmp: that test pins the comparison codegen;
// this one pins the user-visible consumer that motivated the fix
// (putnum / str_from_int printed "-(" / a lone "-" for INT64_MIN).
import "bpp_str.bsm";

main() {
    auto buf, imin;
    buf = malloc(32);

    imin = 1; imin = imin << 63;                 // INT64_MIN = -9223372036854775808
    str_from_int(imin, buf);
    if (str_eq(buf, "-9223372036854775808") != 1) { return 1; }

    str_from_int(9223372036854775807, buf);      // INT64_MAX
    if (str_eq(buf, "9223372036854775807") != 1) { return 2; }

    str_from_int(0, buf);
    if (str_eq(buf, "0") != 1) { return 3; }

    str_from_int(0 - 1, buf);
    if (str_eq(buf, "-1") != 1) { return 4; }

    str_from_int(123456, buf);
    if (str_eq(buf, "123456") != 1) { return 5; }

    str_from_int(0 - 123456, buf);
    if (str_eq(buf, "-123456") != 1) { return 6; }

    return 0;
}
