// test_regalloc_intervals.bpp — Stage C verification fixture (RegAlloc
// v2). Functions named __rg_ivl_* trigger bpp_regalloc.bsm's interval
// debug dump at compile time (regalloc_name_wants_ivl_dump) — this
// file's PURPOSE is the compiler's own stdout while compiling it,
// captured and checked by tests/test_regalloc_intervals.sh.
//
// Same three shapes as test_regalloc_liveness.bpp (Stage B) — their
// use/def/live_in/live_out were already hand-traced and verified
// there; this file's own comments re-derive the [start_pos, end_pos]
// intervals from those already-confirmed bitsets plus each function's
// RPO (hand-traced separately, following regalloc_compute_rpo's own
// 3-colour-DFS algorithm), so the expected numbers below are derived,
// not guessed.

// vi: a=0, b=1, x=2, y=3. Two blocks (0=body, 1=unreachable tail after
// the T_RET) — RPO = [0] only (the tail is unreachable, correctly
// absent). Every variable is touched only at block 0 -> every interval
// is [0,0].
__rg_ivl_straightline(a, b) -> word {
    auto x, y;
    x = a + 1;
    y = b + x;
    return y;
}

// vi: n=0, i=1, sum=2. RPO = [0,1,3,2,4] (entry, header, exit, body,
// continue — exit lands at position 2 because the DFS fully explores
// the header's succ_a (body/continue) branch before backtracking to
// its succ_b (exit), confirmed by hand-tracing the same 3-colour DFS
// the RPO sidequest verified). n and i are touched everywhere except
// the exit block (which only reads sum) -> [0,4] each; sum is touched
// at every position including the exit -> also [0,4].
__rg_ivl_loop(n) -> word {
    auto i, sum;
    i = 0;
    sum = 0;
    while (i < n) {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

// vi: a=0, p=1, q=2. RPO = [0,3,1] (cond, else/join-content, if-arm —
// the if-arm's own unreachable tail, block 2, is never linked to
// anything since block 1 ends in a direct T_RET, so it's correctly
// absent too). `a` is touched at every position -> [0,2]. `p` is
// touched ONLY at position 2 (the if-arm) -> [2,2]. `q` is touched
// ONLY at position 1 (the else/join content) -> [1,1]. p and q's
// intervals do NOT overlap — the exact non-overlapping-live-range
// property this whole arc exists to let a future stage (linear-scan)
// notice and share a register for.
__rg_ivl_nonoverlap(a) -> word {
    auto p, q;
    if (a > 0) {
        p = a + 1;
        return p;
    }
    q = a - 1;
    return q;
}

main() {
    auto r;
    r = __rg_ivl_straightline(10, 20);
    if (r != 31) { return 1; }
    r = __rg_ivl_loop(5);
    if (r != 10) { return 2; }
    r = __rg_ivl_nonoverlap(5);
    if (r != 6) { return 3; }
    r = __rg_ivl_nonoverlap(0 - 5);
    if (r != 0 - 6) { return 4; }
    return 0;
}
