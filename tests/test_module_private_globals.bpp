// test_module_private_globals.bpp — two modules each declare a `static` global
// with the SAME name. Module-private means they must be INDEPENDENT: writing
// one may not disturb the other. Before distinct per-module slots landed
// (2026-07-07), same-named globals shared one data slot, so these would alias
// and this test would see the helper's write clobber main's value. Now each
// gets its own mangled slot.
import "test_module_private_helper.bsm";

static auto _shared_scratch;

main() {
    _shared_scratch = 100;          // main's private copy
    mpg_helper_set(999);            // the helper writes ITS private copy
    if (_shared_scratch != 100) {   // if they aliased, this is now 999
        putmsg("FAIL: static globals aliased across modules (helper clobbered main)");
        return 1;
    }
    if (mpg_helper_get() != 999) {
        putmsg("FAIL: helper's private static did not hold its own value");
        return 2;
    }
    // And main's write must not have disturbed the helper's slot either.
    _shared_scratch = 7;
    if (mpg_helper_get() != 999) {
        putmsg("FAIL: main's write leaked into the helper's static");
        return 3;
    }
    putmsg("PASS: same-named static globals are module-private (distinct slots)");
    return 0;
}
