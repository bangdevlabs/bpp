// test_panzoom.bpp — headless checks for the stbpanzoom navigation engine
// (pure state + math, no GPU/platform/input — runs anywhere).
import "stbpanzoom.bsm";

main() {
    auto pz, ubuf, i;
    auto sc: float, cx: float;

    pz = panzoom_new();
    ubuf = buf_byte(16);

    // Fresh viewport: scale ~1, look-at centred at 0.5.
    panzoom_uniform(pz, ubuf);
    sc = read_f32(ubuf, 8);
    cx = read_f32(ubuf, 0);
    assert(sc > 0.99); assert(sc < 1.01);
    assert(cx > 0.49); assert(cx < 0.51);

    // Zoom in toward the centre: scale grows past 1 and rides out.
    panzoom_zoom_at(pz, 2.0, 0.5, 0.5);
    for (i = 0; i < 5; i++) { panzoom_update(pz); }
    panzoom_uniform(pz, ubuf);
    sc = read_f32(ubuf, 8);
    assert(sc > 1.5);

    // Reset: back to ~1.
    panzoom_reset(pz);
    panzoom_update(pz);
    panzoom_uniform(pz, ubuf);
    sc = read_f32(ubuf, 8);
    assert(sc > 0.99); assert(sc < 1.2);

    // Clamp: a huge impulse cannot exceed max_scale (40).
    panzoom_zoom_at(pz, 1000.0, 0.5, 0.5);
    for (i = 0; i < 10; i++) { panzoom_update(pz); }
    panzoom_uniform(pz, ubuf);
    sc = read_f32(ubuf, 8);
    assert(sc <= 40.1);

    panzoom_free(pz);
    putstr("panzoom ok\n");
}
