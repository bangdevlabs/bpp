// test_exp_f.bpp — exp_f against known e^x values across a wide range,
// including the small-magnitude region the compressor's envelope-follower
// coefficient formula actually exercises (coefficient = 1 - exp(-t) for
// tiny t). Pure leaf: no imports beyond the auto-injected prelude.

main() {
    auto x: float, got: float, want: float, diff: float, tol: float;

    tol = 0.0001;

    // e^0 = 1
    x = 0.0; want = 1.0;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(0) wrong"); return 1; }

    // e^1 = 2.718281828...
    x = 1.0; want = 2.718281828;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(1) wrong"); return 2; }

    // e^-1 = 0.367879441...
    x = 0.0 - 1.0; want = 0.367879441;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(-1) wrong"); return 3; }

    // e^2 = 7.389056099...
    x = 2.0; want = 7.389056099;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(2) wrong"); return 4; }

    // e^10 = 22026.4657948...  (loosen tolerance — large magnitude)
    x = 10.0; want = 22026.4657948;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.01) { putmsg("FAIL: exp_f(10) wrong"); return 5; }

    // e^-10 = 0.0000453999...
    x = 0.0 - 10.0; want = 0.0000453999;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(-10) wrong"); return 6; }

    // Tiny-magnitude region — exactly the shape the compressor's
    // `1 - exp(-1/(tau*sr))` formula evaluates (tau in [0.008, 5] seconds,
    // sr = 44100 -> t in roughly [4.5e-6, 0.00284]).
    x = 0.0 - 0.00284; want = 0.99716195;
    got = exp_f(x);
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: exp_f(tiny negative) wrong"); return 7; }

    putmsg("test_exp_f: passed");
    return 0;
}
