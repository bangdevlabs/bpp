// test_stbdynamics.bpp — exercise the TG12345-style dB-domain compressor.
//
// Covers:
//   1. A fresh instance defaults to COMPRESS mode, release step 500ms,
//      threshold -6dB.
//   2. A signal well below the knee passes through unchanged.
//   3. COMPRESS (2:1) on a sustained loud tone converges to the
//      hand-derived dB-domain target (level~-0.915dB, over~5.085dB,
//      outside the 6dB knee -> gr_db=(0.5-1)*5.085=-2.5425dB ->
//      gain~0.7466 -> out~0.672).
//   4. LIMIT (8:1) on the same tone reduces MORE (gr_db=(0.125-1)*5.085=
//      -4.449dB -> gain~0.599 -> out~0.539) — proves the ratio switch
//      is real, not just a label.
//   5. Out-of-range modes are ignored.
//   6. comp_reset clears the envelope so a fresh tone starts uncompressed
//      again (same discipline rotary_reset/moon_reset already follow).
//   7. Two independent instances do not share envelope state.

import "stbdynamics.bsm";

main() {
    auto c1, c2, i;
    auto (out_v, diff, thr): float;

    // (1) Fresh instance defaults.
    c1 = comp_new(44100.0);
    if (comp_get_mode(c1) != COMP_COMPRESS) {
        putmsg("FAIL: fresh compressor should default to COMP_COMPRESS");
        return 1;
    }
    if (comp_get_release(c1) != COMP_REL_500) {
        putmsg("FAIL: fresh compressor should default to COMP_REL_500");
        return 2;
    }
    thr = comp_get_threshold_db(c1);
    diff = thr - (0.0 - 6.0); if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.01) {
        putmsg("FAIL: fresh compressor should default to -6dB threshold");
        return 3;
    }

    // (2) Well below the knee (threshold -6dB, knee +/-3dB -> engages
    // above -9dB; 0.05 linear is about -26dB) — exact passthrough.
    out_v = comp_process(c1, 0.05);
    if (out_v != 0.05) {
        putmsg("FAIL: signal well below the knee should pass through unchanged");
        return 4;
    }
    comp_reset(c1);

    // (3) COMPRESS (2:1): drive a sustained 0.9 tone until the envelope
    // settles, then check the gain-reduced output lands near the
    // hand-derived dB-domain target (~0.672).
    for (i = 0; i < 10000; i++) { out_v = comp_process(c1, 0.9); }
    diff = out_v - 0.672; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.005) {
        putmsg("FAIL: COMPRESS settled output far from expected ~0.672");
        return 5;
    }
    comp_reset(c1);

    // (4) Switch to LIMIT (8:1) on the SAME instance — the settled
    // output should land near a lower target (~0.539), proving the
    // mode switch changed the ratio, not just a label.
    comp_set_mode(c1, COMP_LIMIT);
    for (i = 0; i < 10000; i++) { out_v = comp_process(c1, 0.9); }
    diff = out_v - 0.539; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.005) {
        putmsg("FAIL: LIMIT settled output far from expected ~0.539");
        return 6;
    }

    // (5) Out-of-range modes are ignored — LIMIT keeps playing.
    comp_set_mode(c1, 99);
    if (comp_get_mode(c1) != COMP_LIMIT) {
        putmsg("FAIL: out-of-range mode should be ignored");
        return 7;
    }

    // (6) Reset clears the envelope — a fresh tone starts uncompressed.
    comp_reset(c1);
    out_v = comp_process(c1, 0.9);
    if (out_v != 0.9) {
        putmsg("FAIL: comp_reset should clear envelope (first sample uncompressed)");
        return 8;
    }

    // (7) Two independent instances do not share envelope state.
    c2 = comp_new(44100.0);
    for (i = 0; i < 10000; i++) { out_v = comp_process(c1, 0.9); }
    out_v = comp_process(c2, 0.9);
    if (out_v != 0.9) {
        putmsg("FAIL: c2's first sample should be uncompressed regardless of c1's state");
        return 9;
    }

    comp_free(c1);
    comp_free(c2);

    putmsg("test_stbdynamics: passed");
    return 0;
}
