// test_db_swap.bpp — verify stbaudio/stbmixer's dB<->amplitude
// conversions after the integer-table hack was replaced by real
// log_f/exp_f math (docs/manual/audio_specs.md Cap 2.3).
//
// Covers:
//   1. stbaudio round-trip is EXACT for every integer dB from -1 to
//      -73 (the limit is the integer amplitude storage 0..32700, not
//      the math — verified by exhaustive scan; the OLD table-based
//      implementation broke down 11dB earlier, at -63, confirmed by
//      running the identical scan against it before this swap).
//   2. 0dB and the -96dB silence floor are exact sentinels.
//   3. stbmixer's bus-volume dB readback (coarser integer-percent
//      storage, a separate documented limitation) lands within 4dB of
//      the requested value at -6dB and -20dB — a sanity range, not an
//      exact-round-trip claim (the percent-storage caveat predates and
//      is unrelated to this swap).

import "stbaudio.bsm";
import "stbmixer.bsm";

const MX_BUS_MASTER = 0;

main() {
    auto i, got;

    for (i = 0 - 1; i >= 0 - 73; i--) {
        audio_set_volume_db(i);
        got = audio_get_volume_db();
        if (got != i) {
            putmsg("FAIL: stbaudio dB round-trip broke before -73");
            return 1;
        }
    }

    audio_set_volume_db(0);
    if (audio_get_volume_db() != 0) {
        putmsg("FAIL: 0dB sentinel wrong");
        return 2;
    }

    audio_set_volume_db(0 - 96);
    if (audio_get_volume_db() != 0 - 96) {
        putmsg("FAIL: -96dB silence floor sentinel wrong");
        return 3;
    }

    mixer_init();
    mixer_set_bus_volume_db(MX_BUS_MASTER, 0 - 6);
    got = mixer_get_bus_volume_db(MX_BUS_MASTER);
    if (got > 0 - 4 || got < 0 - 8) {
        putmsg("FAIL: stbmixer -6dB readback out of sanity range");
        return 4;
    }
    mixer_set_bus_volume_db(MX_BUS_MASTER, 0 - 20);
    got = mixer_get_bus_volume_db(MX_BUS_MASTER);
    if (got > 0 - 17 || got < 0 - 23) {
        putmsg("FAIL: stbmixer -20dB readback out of sanity range");
        return 5;
    }

    putmsg("test_db_swap: passed");
    return 0;
}
