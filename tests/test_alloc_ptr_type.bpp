// test_alloc_ptr_type.bpp — round-4 scrutiny: the allocator family types
// TY_PTR end to end.
//
// Root cause pinned here: the Phase D.4 parser inlining rewrites
// buf_byte/buf_word calls into direct `malloc` calls, and malloc — a
// TRUE builtin with no B++ source — had no registered return type, so
// the whole expression degraded to WORD and `auto p: ptr = buf_byte(4);`
// fired E053 while the identical user-defined `-> ptr` chain compiled
// fine. malloc/malloc_aligned/realloc now live in _builtin_ret_type
// (their one honest home), and arena_new carries `-> ptr` on its own
// signature. Safe SINCE increment D only: put(malloc(...)) prints the
// address (putstr keys on STR), so typing the allocator can no longer
// turn heap bytes into fake text.

main() {
    auto a: ptr;
    a = malloc(64);
    if (a == 0)  { putmsg("FAIL: malloc into : ptr");        return 1; }

    auto b: ptr;
    b = buf_byte(32);
    if (b == 0)  { putmsg("FAIL: buf_byte into : ptr");      return 2; }

    auto w: ptr;
    w = buf_word(8);
    if (w == 0)  { putmsg("FAIL: buf_word into : ptr");      return 3; }

    auto ar: ptr;
    ar = arena_new(128);
    if (ar == 0) { putmsg("FAIL: arena_new into : ptr");     return 4; }

    auto m2: ptr;
    m2 = malloc_aligned(64, 16);
    if (m2 == 0) { putmsg("FAIL: malloc_aligned into : ptr"); return 5; }

    auto r: ptr;
    r = realloc(a, 128);
    if (r == 0)  { putmsg("FAIL: realloc into : ptr");       return 6; }

    // The bare-local flow keeps working, and the slot behaves as memory.
    auto p;
    p = malloc(16);
    poke(p, 65);
    if (peek(p) != 65) { putmsg("FAIL: bare malloc local");   return 7; }

    free(r); free(b); free(w); free(m2); free(p);
    arena_free(ar);
    putmsg("PASS: the allocator family is TY_PTR end to end");
    return 0;
}
