// test_log_f.bpp — log_f and the amp_to_db_f/db_to_amp_f decibel
// conversions against known values, plus a round-trip check across the
// range the compressor's threshold/metering actually uses.

main() {
    auto got: float, want: float, diff: float, tol: float;

    tol = 0.001;

    // ln(1) = 0
    got = log_f(1.0); want = 0.0;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: log_f(1) wrong"); return 1; }

    // ln(e) = 1
    got = log_f(2.718281828459045); want = 1.0;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: log_f(e) wrong"); return 2; }

    // ln(10) = 2.302585093
    got = log_f(10.0); want = 2.302585093;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: log_f(10) wrong"); return 3; }

    // ln(0.5) = -0.693147181
    got = log_f(0.5); want = 0.0 - 0.693147181;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: log_f(0.5) wrong"); return 4; }

    // ln(0.001) = -6.907755279 — exercises several halving steps in the
    // range reduction.
    got = log_f(0.001); want = 0.0 - 6.907755279;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: log_f(0.001) wrong"); return 5; }

    // amp_to_db_f: unity gain is 0dB; halving amplitude is -6.0206dB;
    // a tenth is exactly -20dB (the textbook reference points).
    got = amp_to_db_f(1.0); want = 0.0;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: amp_to_db_f(1.0) wrong"); return 6; }

    got = amp_to_db_f(0.5); want = 0.0 - 6.0206;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.001) { putmsg("FAIL: amp_to_db_f(0.5) wrong"); return 7; }

    got = amp_to_db_f(0.1); want = 0.0 - 20.0;
    diff = got - want; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > tol) { putmsg("FAIL: amp_to_db_f(0.1) wrong"); return 8; }

    // db_to_amp_f is the exact inverse — round-trip across a realistic
    // range (silence floor to +20dB headroom) should return to the
    // original amplitude within float-precision tolerance.
    auto amp_val: float;
    amp_val = 0.001; got = db_to_amp_f(amp_to_db_f(amp_val));
    diff = got - amp_val; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.0001) { putmsg("FAIL: round-trip 0.001 wrong"); return 9; }

    amp_val = 0.5; got = db_to_amp_f(amp_to_db_f(amp_val));
    diff = got - amp_val; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.0001) { putmsg("FAIL: round-trip 0.5 wrong"); return 10; }

    amp_val = 1.0; got = db_to_amp_f(amp_to_db_f(amp_val));
    diff = got - amp_val; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.0001) { putmsg("FAIL: round-trip 1.0 wrong"); return 11; }

    amp_val = 2.0; got = db_to_amp_f(amp_to_db_f(amp_val));
    diff = got - amp_val; if (diff < 0.0) { diff = 0.0 - diff; }
    if (diff > 0.0001) { putmsg("FAIL: round-trip 2.0 wrong"); return 12; }

    // Silence floor: amp_to_db_f(0.0) must NOT read back as 0dB (the
    // exact-backwards bug the floor guard exists to prevent) — it must
    // be a large negative number.
    got = amp_to_db_f(0.0);
    if (got > 0.0 - 50.0) {
        putmsg("FAIL: amp_to_db_f(0.0) should floor to a large negative, not read as ~0dB");
        return 13;
    }

    putmsg("test_log_f: passed");
    return 0;
}
