// test_float_branch_fusion.bpp — cg_emit_cmp_to_branch's float case: an
// if/while condition that is a float comparison now branches directly
// off fcmp's flags (fcmp + b.cc) instead of materializing a boolean
// first (fcmp + cset + cbz). Reuses the float-CIP machinery (struct-
// field/comparison/literal trio, all shipped earlier this session), so
// this is mostly a wiring test: the condition decode + the inverse
// condition code (cc ^ 1) must be exactly right for every operator,
// including the boundary (equal) case where getting the inversion wrong
// would silently flip which branch runs.

struct Filt { a: float, b: float }

hot_if(fp, x: float) -> word {
    auto f: Filt, n: word;
    f = fp;
    n = 0;
    if (f.a < f.b)   { n = n + 1; }    // struct field vs struct field
    if (f.a <= 2.0)  { n = n + 10; }   // struct field vs literal, boundary case
    if (f.b > 1.5)   { n = n + 100; }
    if (f.b >= 3.0)  { n = n + 1000; } // boundary case
    if (f.a == x)    { n = n + 10000; }
    if (f.b != x)    { n = n + 100000; }
    return n;
}

// while-condition fusion (cg_emit_cmp_to_branch is also called from
// T_WHILE) — counts down using a float comparison as the loop guard.
sum_while(start: float) -> float {
    auto s: float, total: float;
    s = start;
    total = 0.0;
    while (s > 0.0) {
        total = total + s;
        s = s - 1.0;
    }
    return total;
}

main() {
    auto f: Filt, n: word, r: float;
    f = malloc(16);
    f.a = 2.0;
    f.b = 3.0;

    // f.a<f.b(T,+1) f.a<=2.0(T,+10) f.b>1.5(T,+100) f.b>=3.0(T,+1000)
    // f.a==2.0(T,+10000) f.b!=2.0(T,+100000) -> 111111
    n = hot_if(f, 2.0);
    if (n != 111111) { return 1; }

    // x=3.0: f.a<f.b(T,+1) f.a<=2.0(T,+10) f.b>1.5(T,+100) f.b>=3.0(T,+1000)
    // f.a==3.0(F) f.b!=3.0(F) -> 1111
    n = hot_if(f, 3.0);
    if (n != 1111) { return 2; }

    // sum 4+3+2+1 = 10
    r = sum_while(4.0);
    if (r != 10.0) { return 3; }

    // Array of structs in a loop — non-const-offset base feeding the
    // const-offset field comparisons, inside an if (the exact rotary_tick
    // shape: per-iteration struct-field comparisons driving control flow).
    auto arr, i, hits;
    arr = malloc(3 * 16);
    for (i = 0; i < 3; i++) {
        auto e: Filt;
        e = arr + i * 16;
        e.a = i + 1.0;
        e.b = i + 5.0;
    }
    hits = 0;
    for (i = 0; i < 3; i++) {
        auto e2: Filt;
        e2 = arr + i * 16;
        if (e2.a < e2.b) { hits = hits + 1; }   // always true
    }
    if (hits != 3) { return 4; }

    return 0;
}
