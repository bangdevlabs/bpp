// test_float_cip_memld.bpp — Inc 6 follow-on: extends F.2.c float
// compute-in-place to struct-field (T_MEMLD) leaves. Found investigating
// stb/stbrotary.bsm's rotary_tick: cg_float_tree_need's only leaf was
// T_VAR, so ANY expression touching a struct field bypassed compute-in-
// place entirely, including plain arithmetic the gate already covers
// operator-wise (`r.cur += 0.0001` still went through the old save/
// resolve dance). Exercises both the cheapest path (promoted base, offset
// folded straight into the load) and the general path (non-promoted base,
// address computed into a borrowed int temp first).

struct Filt { a: float, b: float, c: float, d: float }

// `f` is referenced enough times to get B3-promoted — forces the
// promoted-base fast path for every f.* access below.
hot_calc(fp, x: float) -> float {
    auto f: Filt, r: float;
    f = fp;
    r = f.a + f.b * x;
    r = r - f.c / 2.0;
    r = r * f.d;
    return r;
}

// `f` is referenced exactly once — never promoted, forces the general
// (address-into-int-temp) path for every f.* access.
cold_calc(fp) -> float {
    auto f: Filt;
    f = fp;
    return f.a + f.b - f.c * f.d;
}

main() {
    auto f: Filt, r: float;
    f = malloc(32);
    f.a = 2.0;
    f.b = 3.0;
    f.c = 4.0;
    f.d = 5.0;

    // hot_calc(f, 10.0): r = 2 + 3*10 = 32; r = 32 - 4/2 = 30; r = 30*5 = 150
    r = hot_calc(f, 10.0);
    if (r != 150.0) { return 1; }

    // cold_calc(f): 2 + 3 - 4*5 = 5 - 20 = -15
    r = cold_calc(f);
    if (r != 0.0 - 15.0) { return 2; }

    // Array of structs — base varies per iteration, exercises the
    // non-const-offset-base shape (arr + i*32) feeding INTO the
    // const-offset field access (.a/.b/.c/.d at fixed offsets from
    // whatever the iteration's base turns out to be).
    auto arr, i, total: float;
    arr = malloc(3 * 32);
    for (i = 0; i < 3; i++) {
        auto e: Filt;
        e = arr + i * 32;
        e.a = i + 1.0;
        e.b = i + 2.0;
        e.c = i + 3.0;
        e.d = i + 4.0;
    }
    total = 0.0;
    for (i = 0; i < 3; i++) {
        auto e2: Filt;
        e2 = arr + i * 32;
        total = total + e2.a + e2.b * e2.c - e2.d;
    }
    // i=0: 1 + 2*3 - 4 = 3;  i=1: 2 + 3*4 - 5 = 9;  i=2: 3 + 4*5 - 6 = 17
    // total = 3+9+17 = 29
    if (total != 29.0) { return 3; }

    return 0;
}
