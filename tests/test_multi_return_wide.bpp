// skip-c: native multi-value return banking (a64 x0..x7/d0..d7, x64 register window)
// test_multi_return_wide.bpp — exercise the FULL multi-return register window.
//
// The base test (test_multi_return.bpp) only reaches int bank position 2.
// This one returns eight integers and six floats so every bank slot is
// used: on x64 that drives the REX.B registers r8/r9/r10 and the SysV
// argument registers rsi/rdi as RESULT registers, and xmm0..xmm5. Each
// value is distinct, so a mis-mapped slot returns a distinct failure code.

import "bpp_io.bsm";

// Eight integer results — positions 0..7.
// x64: rax, rdx, rcx, rsi, rdi, r8, r9, r10.
eight() -> (word, word, word, word, word, word, word, word) {
    return 11, 22, 33, 44, 55, 66, 77, 88;
}

// Six float results — positions 0..5 (xmm0..xmm5). Multiples of an exact
// value so `!=` equality is reliable.
sixf(x: float) -> (float, float, float, float, float, float) {
    return x, x * 2.0, x * 3.0, x * 4.0, x * 5.0, x * 6.0;
}

main() {
    auto a, b, c, d, e, f, g, h;
    a, b, c, d, e, f, g, h = eight();
    if (a != 11) { return 1; }
    if (b != 22) { return 2; }
    if (c != 33) { return 3; }
    if (d != 44) { return 4; }
    if (e != 55) { return 5; }
    if (f != 66) { return 6; }
    if (g != 77) { return 7; }
    if (h != 88) { return 8; }

    auto f0: float, f1: float, f2: float, f3: float, f4: float, f5: float;
    f0, f1, f2, f3, f4, f5 = sixf(1.0);
    if (f0 != 1.0) { return 11; }
    if (f1 != 2.0) { return 12; }
    if (f2 != 3.0) { return 13; }
    if (f3 != 4.0) { return 14; }
    if (f4 != 5.0) { return 15; }
    if (f5 != 6.0) { return 16; }

    putmsg("OK: 8-int + 6-float multi-return correct across the full register window");
    return 0;
}
