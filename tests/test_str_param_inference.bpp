// test_str_param_inference.bpp — T2 increment E: parameter str-inference
// by whole-program call-site CONSENSUS.
//
// The utopia this pins: NO annotation below — a parameter is a string
// because every direct caller passes one, and the knowledge flows down
// call chains one link per consensus round. The negatives pin the
// poison rules: mixed call sites, fn_ptr-taken functions, and explicit
// annotations all keep today's behaviour. Dispatch correctness
// (putstr vs putnum) is asserted VIA the compiler's own choices being
// re-fired on re-inference — observable here through str semantics
// (str_len / str_eq on params) plus the probes in the commit record.

len_of(who) {                        // consensus: str (both callers)
    return str_len(who);
}
relay(text) {                        // chain link 1
    return second(text);
}
second(msg) {                        // chain link 2 — needs round 2
    return str_len(msg);
}
mixed(x) {                           // poisoned: called with str AND int
    return x;
}
fnptr_target(s) {                    // poisoned: address taken below
    return s;
}
into_annotated(p: str) {             // explicit annotation, untouched
    return str_len(p);
}
pass_down(q) {                       // consensus str, flows into : str param
    return into_annotated(q);
}

main() {
    auto fp;
    if (len_of("world") != 5)        { putmsg("FAIL: direct consensus");   return 1; }
    if (len_of("b++") != 3)          { putmsg("FAIL: second site");        return 2; }
    if (relay("chained") != 7)       { putmsg("FAIL: chain round 2");      return 3; }
    if (mixed(42) != 42)             { putmsg("FAIL: poisoned int site");  return 4; }
    if (str_eq(mixed("s"), "s") == 0){ putmsg("FAIL: poisoned str site");  return 5; }
    fp = fn_ptr(fnptr_target);
    if (str_eq(call(fp, "ind"), "ind") == 0) { putmsg("FAIL: fn_ptr path"); return 6; }
    if (pass_down("deep") != 4)      { putmsg("FAIL: str into : str");     return 7; }
    putmsg("PASS: str params infer by consensus; mixed/fn_ptr/annotated stay put");
    return 0;
}
