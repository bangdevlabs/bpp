// test_stbtonestack.bpp — pin the FMV (Fender Bassman) tone stack by its
// defining properties: it blocks DC exactly, it stays bounded at every knob
// extreme, and each of its three interacting controls moves the band it is
// named for (treble → highs, bass → lows, mid → mids). The numbers come from
// measuring the filter's own gain at a test frequency, not from a reference
// implementation — the tone stack's transfer function is the public Yeh & Smith
// result, and these checks verify it behaves like a real tone control.

import "stbtonestack.bsm";

fabs_f(x: float) -> float {
    if (x < 0.0) { return 0.0 - x; }
    return x;
}

// Peak steady-state amplitude of a unit sine at `freq` through the (already
// configured) tone stack. Resets the filter memory, warms past the transient,
// then tracks the largest output magnitude over the final samples. Since the
// input peak is 1.0, the return value IS the gain at that frequency.
static _ts_gain(ts, freq: float, fs: float) -> float {
    auto n;
    auto (w, x, y, mx): float;
    tonestack_reset(ts);
    w = 6.2831853 * freq / fs;
    mx = 0.0;
    for (n = 0; n < 4000; n++) {
        x = sin_f(w * n);
        y = tonestack_tick(ts, x);
        if (n >= 3000) { if (fabs_f(y) > mx) { mx = fabs_f(y); } }
    }
    return mx;
}

main() {
    auto ts: ToneStack;
    auto fs: float;
    auto (g_lo, g_hi, dc_sum): float;
    auto n;
    auto (x, y, mx): float;

    fs = 44100.0;
    ts = tonestack_new(fs);

    // ── (1) exact DC block: numerator coefficients sum to zero ───────
    // H(0) = 0 by construction (series input cap, no constant numerator term);
    // in the digital filter that is nb0+nb1+nb2+nb3 == 0. This is exact up to
    // float rounding, and it is the strongest single invariant of the network.
    tonestack_set(ts, 0.6, 0.5, 0.7, fs);
    dc_sum = ts.nb0 + ts.nb1 + ts.nb2 + ts.nb3;
    if (fabs_f(dc_sum) > 0.0001) { putmsg("FAIL: tone stack does not block DC (numerator sum != 0)"); return 1; }

    // ── (2) a real constant decays to silence at the output ──────────
    // The time-domain twin of (1): feed DC, the step response must settle to ~0.
    tonestack_reset(ts);
    mx = 0.0;
    for (n = 0; n < 8000; n++) {
        y = tonestack_tick(ts, 1.0);
        if (n >= 7000) { if (fabs_f(y) > mx) { mx = fabs_f(y); } }
    }
    if (mx > 0.02) { putmsg("FAIL: DC input did not decay to silence"); return 2; }

    // ── (3) bounded + finite at both knob extremes ───────────────────
    // Every control hard down, then hard up: the passive network can only
    // attenuate, so a unit sine can never come out bigger than it went in, and
    // must never blow up or NaN.
    tonestack_set(ts, 0.0, 0.0, 0.0, fs);
    g_hi = _ts_gain(ts, 1000.0, fs);
    if (g_hi != g_hi) { putmsg("FAIL: NaN output at knobs=0"); return 3; }
    if (g_hi > 1.01)  { putmsg("FAIL: passive tone stack amplified at knobs=0"); return 4; }
    tonestack_set(ts, 1.0, 1.0, 1.0, fs);
    g_hi = _ts_gain(ts, 1000.0, fs);
    if (g_hi != g_hi) { putmsg("FAIL: NaN output at knobs=1"); return 5; }
    if (g_hi > 1.01)  { putmsg("FAIL: passive tone stack amplified at knobs=1"); return 6; }

    // ── (4) treble control moves the highs ───────────────────────────
    // Hold mid + bass at noon, sweep treble; a 5 kHz tone must get louder.
    tonestack_set(ts, 0.1, 0.5, 0.5, fs);
    g_lo = _ts_gain(ts, 5000.0, fs);
    tonestack_set(ts, 0.9, 0.5, 0.5, fs);
    g_hi = _ts_gain(ts, 5000.0, fs);
    if (g_hi <= g_lo) { putmsg("FAIL: raising treble did not raise the highs"); return 7; }

    // ── (5) bass control moves the lows ──────────────────────────────
    // Hold treble + mid at noon, sweep bass; an 80 Hz tone must get louder.
    tonestack_set(ts, 0.5, 0.5, 0.1, fs);
    g_lo = _ts_gain(ts, 80.0, fs);
    tonestack_set(ts, 0.5, 0.5, 0.9, fs);
    g_hi = _ts_gain(ts, 80.0, fs);
    if (g_hi <= g_lo) { putmsg("FAIL: raising bass did not raise the lows"); return 8; }

    // ── (6) mid control fills the scoop ──────────────────────────────
    // Hold treble + bass at noon, sweep mid; a 600 Hz tone must get louder
    // (turning mid up is exactly what fills the Fender mid scoop).
    tonestack_set(ts, 0.5, 0.1, 0.5, fs);
    g_lo = _ts_gain(ts, 600.0, fs);
    tonestack_set(ts, 0.5, 0.9, 0.5, fs);
    g_hi = _ts_gain(ts, 600.0, fs);
    if (g_hi <= g_lo) { putmsg("FAIL: raising mid did not raise the mids"); return 9; }

    tonestack_free(ts);
    putmsg("PASS: stbtonestack — blocks DC, stays passive, and each control moves its own band");
    return 0;
}
