// xfail-warn: W033
// '@safe' loop host whose body is rejected by the real dispatch-safety
// walk (log_tick is neither PHASE_BASE nor @safe, so the call inside
// tick_all's loop body fails _fdc_subtree_safe) must never become a
// dispatch_candidates entry — W033 must fire. Compile must succeed
// (warnings are non-blocking); runner asserts on the W033 line in stderr.
import "bpp_io.bsm";

auto counter;

static void log_tick(idx) {
    counter = counter + idx;
    put(idx);
    putchar('\n');
}

static void tick_all() @safe {
    auto i;
    for (i = 0; i < 100; i = i + 1) {
        log_tick(i);
    }
}

main() {
    counter = 0;
    tick_all();
    put(counter);
    putchar('\n');
    return 0;
}
