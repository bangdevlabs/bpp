// test_regalloc_cfg.bpp — Stage A verification fixture (RegAlloc v2).
// Functions named __rg_dump_* trigger bpp_regalloc.bsm's debug dump at
// compile time (see regalloc_name_wants_dump) — this file's PURPOSE is
// the compiler's own stdout while compiling it, captured and checked by
// tests/test_regalloc_cfg.sh, not this program's runtime behavior. It
// still needs to compile and run cleanly (the real verification gate
// covers that too), so each function is a real, valid, runnable body.

__rg_dump_straightline(a, b) -> word {
    auto x, y;
    x = a + b;
    y = x * 2;
    return x + y;
}

__rg_dump_ifelse(a) -> word {
    auto r;
    if (a > 0) {
        r = 1;
    } else {
        r = 0 - 1;
    }
    return r;
}

__rg_dump_ifnoelse(a) -> word {
    auto r;
    r = 0;
    if (a > 0) {
        r = 1;
    }
    return r;
}

__rg_dump_whileloop(n) -> word {
    auto i, sum;
    i = 0;
    sum = 0;
    while (i < n) {
        sum = sum + i;
        i = i + 1;
    }
    return sum;
}

// Deliberately NOT the function's trailing statement (a `return` comes
// after it) — _inline_normalize_switch_ret (today's earlier inliner
// work) only rewrites a switch that IS the body's last statement, so
// this shape reaches the CFG builder as a real T_SWITCH node instead of
// already being normalised away into a ternary-wrapped return before
// codegen ever sees it.
__rg_dump_switchret(poles) -> word {
    auto r;
    switch (poles) {
        1    { r = 10; }
        2    { r = 20; }
        3    { r = 30; }
        else { r = 40; }
    }
    return r;
}

main() {
    auto r;
    r = __rg_dump_straightline(2, 3);
    if (r != 15) { return 1; }
    r = __rg_dump_ifelse(5);
    if (r != 1) { return 2; }
    r = __rg_dump_ifelse(0 - 5);
    if (r != 0 - 1) { return 3; }
    r = __rg_dump_ifnoelse(5);
    if (r != 1) { return 4; }
    r = __rg_dump_ifnoelse(0 - 5);
    if (r != 0) { return 5; }
    r = __rg_dump_whileloop(5);
    if (r != 10) { return 6; }
    r = __rg_dump_switchret(2);
    if (r != 20) { return 7; }
    r = __rg_dump_switchret(99);
    if (r != 40) { return 8; }
    return 0;
}
