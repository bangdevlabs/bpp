// test_audio_tone.bpp — Proof-of-life for the stbaudio direct-tone path.
//
// Verifies end-to-end that the AudioQueue setup, the FFI symbol resolver,
// and the realtime callback wiring all work, while emitting a brief
// audible blip so a human listening can confirm by ear. Programmatic
// assertions catch the failure modes that ear cannot:
//
//   1. audio_tone_test returns rc == 0 (CoreAudio accepted the queue)
//   2. _stb_audio_fn_probe(0..6) all resolve non-zero (every FFI symbol
//      bound; framework loaded; callback function pointer captured)
//   3. _stb_audio_cb_count() > 0 (the realtime thread actually invoked
//      the callback after AudioQueueStart, not just during priming)
//
// The tone path is the mixer-free siblings of test_audio_pipe (which
// covers the mixer + SPSC ring layer). Together they pin both paths
// the audio stack supports.
//
// Audible — but quiet. Raw amplitude 1000 is ~3% of s16 full scale
// (about -30 dB below peak). Long enough at 250 ms to perceive the
// pitch, short enough that a startled engineer can shrug it off, and
// quiet enough on a system at moderate volume to sound like a tap on
// a cup rather than a buzz. To run an interactive audible version,
// raise TEST_AMP towards 8000 (~ -12 dB) and TEST_MS to 2000 ms.

import "bpp_io.bsm";
import "stbaudio.bsm";

const TEST_AMP = 1000;
const TEST_MS  = 250;

main() {
    auto i, p, rc, cb;
    auto t0, t1, elapsed_ms: float, buf_ms: float;
    auto elapsed_i: word, floor_n: word, ceiling: word;

    audio_set_amplitude(TEST_AMP);

    t0 = _stb_get_time_us();
    rc = audio_tone_test(440, TEST_MS);
    t1 = _stb_get_time_us();
    if (rc != 0) {
        putmsg("FAIL: audio_tone_test rc = ");
        putnum(rc);
        putline();
        return rc;
    }

    // Every FFI probe must be non-zero. Index 0 is the framework
    // handle, 1..6 are the AudioQueue function pointers.
    for (i = 0; i < 7; i++) {
        p = _stb_audio_fn_probe(i);
        if (p == 0) {
            putmsg("FAIL: ffi probe ");
            putnum(i);
            putmsg(" unresolved");
            putline();
            return 10 + i;
        }
    }

    // The callback fires once per buffer; with 1024-frame buffers at
    // 44100 Hz the period is ~23.22 ms. The bound USED TO be a fixed
    // 8-16 window derived from the requested TEST_MS — investigated
    // 2026-06-22 after an intermittent failure (cb_count = 17). FIRST
    // hypothesis, ruled out: a recurrence of the 2026-06-21 float-
    // device-boundary bug below (frames widened 4 -> 8 bytes without
    // rescaling the per-buffer allocation, which doubled the callback
    // rate to ~85 Hz instead of ~43 Hz). Ruled out because the shape
    // didn't match — that bug is a ~2x effect (cb_count ~30+), not a
    // borderline 1-over-ceiling overage. ACTUAL cause, confirmed by
    // measurement: 15/15 fresh single-shot runs under otherwise-quiet
    // conditions measured cb_count == 16 EXACTLY, i.e. the common case
    // already sat AT the old ceiling with zero slack, because
    // `_stb_audio_sleep_ms` calls `usleep`, which is a MINIMUM wait, not
    // a guarantee — under system load it legitimately overran by a few
    // ms, and a fixed ceiling with no margin trips on that alone.
    //
    // The fix is asymmetric, NOT "derive both bounds from elapsed time" —
    // that first attempt broke under tests/run_all_c.sh's 6-way parallel
    // worker pool: elapsed_ms ballooned to ~415 ms there (this thread's
    // OWN usleep starved by 5 sibling compiles+runs competing for CPU),
    // but cb_count stayed at 16 — CoreAudio's realtime callback thread
    // was throttled by the SAME contention, so more wall-clock time
    // passing did NOT mean more callbacks should have fired. A floor
    // derived from elapsed time grows with that stall and false-fails;
    // a ceiling derived from elapsed time does not have this problem
    // (more legitimate time can only ever justify MORE callbacks, never
    // fewer, so inflated elapsed_ms only ever loosens the ceiling).
    //   - FLOOR stays anchored to the REQUESTED TEST_MS (what the test
    //     intended to wait, not how long the OS actually took to honour
    //     it) — proves the callback fires at all, independent of how
    //     loaded the host happens to be.
    //   - CEILING is anchored to the ACTUAL elapsed time — proves the
    //     RATE is right. The 2026-06-21 bug ruled out above would STILL
    //     be caught by this ceiling in any scenario, contended or not —
    //     its ~2x effect blows past an elapsed-time-derived bound
    //     regardless of how much slack contention adds to it.
    buf_ms = 1024.0 * 1000.0 / 44100.0;
    elapsed_ms = (t1 - t0) / 1000.0;
    // 3 priming calls happen synchronously in _stb_audio_tone_start,
    // before the queue even starts — never time-gated, always exactly 3.
    floor_n = 3.0 + (TEST_MS + 0.0) / buf_ms - 5.0;
    // +4 (not +3): float->word truncation rounds toward zero, so a
    // measured value like 16.98 (the common case) would otherwise lose
    // almost a full unit of the intended margin.
    ceiling = 3.0 + elapsed_ms / buf_ms + 4.0;
    if (floor_n < 1) { floor_n = 1; }
    elapsed_i = elapsed_ms;

    cb = _stb_audio_cb_count();
    if (cb < floor_n) {
        putmsg("FAIL: cb_count = ");
        putnum(cb);
        putmsg(" (expected >= ");
        putnum(floor_n);
        putmsg(" from elapsed ");
        putnum(elapsed_i);
        putmsg("ms — too few; CoreAudio took the queue but never drained it)");
        putline();
        return 20;
    }
    if (cb > ceiling) {
        putmsg("FAIL: cb_count = ");
        putnum(cb);
        putmsg(" (expected <= ");
        putnum(ceiling);
        putmsg(" from elapsed ");
        putnum(elapsed_i);
        putmsg("ms; this many means the callback is firing too often — check");
        putmsg(" the per-buffer byte size vs the wire's frame width)");
        putline();
        return 21;
    }

    return 0;
}
