// Multi-value return — Phase A slice 1 (banked integer results).
//
// A function may declare `-> (t1, t2, …)` and `return e1, e2, …;`; the
// caller unpacks the banked result registers with `a, b, … = f();`. This
// is the arity-8 "register-window transformer" ABI (Go/Odin/Jai-style
// genuine multiple values, not a tuple object) — see
// docs/plans/multi_value_return_plan.md. Slice 1 covers integer results
// up to a handful of values; the float / mixed banks land next.
//
// Self-verifying: each mismatch returns a distinct non-zero code so
// run_all.sh's exit-code check names the failing case.

divmod(a, b) -> (word, word) {
    return a / b, a % b;
}

// Reorders three values — proves each result lands in the right slot.
swap3(a, b, c) -> (word, word, word) {
    return c, a, b;
}

// Results computed from a loop-carried local, returned together.
sum_and_count(n) -> (word, word) {
    auto i, s;
    s = 0;
    for (i = 0; i < n; i = i + 1) { s = s + i; }
    return s, n;
}

// Float results — banked in d0 / d1 (the stereo-pair shape). Values are
// exactly representable so `!=` equality is reliable.
fscale(x: float, y: float) -> (float, float) {
    return x * 0.5, y * 0.25;
}

// Mixed int / float — each slot banks by its own type (x0, d0, x1).
imix(n) -> (word, float, word) {
    auto h: float;
    h = n * 0.5;
    return n, h, n + n;
}

main() {
    auto q, r, x, y, z, s, c;

    q, r = divmod(17, 5);
    if (q != 3) { return 1; }
    if (r != 2) { return 2; }

    x, y, z = swap3(10, 20, 30);
    if (x != 30) { return 3; }
    if (y != 10) { return 4; }
    if (z != 20) { return 5; }

    // Reuse existing targets — assignment (not declaration) form.
    s, c = sum_and_count(5);
    if (s != 10) { return 6; }   // 0+1+2+3+4
    if (c != 5)  { return 7; }

    // Float multi-return — banked in d0 / d1.
    auto fa: float, fb: float;
    fa, fb = fscale(1.0, 1.0);
    if (fa != 0.5)  { return 8; }
    if (fb != 0.25) { return 9; }

    // Mixed int / float multi-return.
    auto mi, mf: float, mj;
    mi, mf, mj = imix(4);
    if (mi != 4)   { return 10; }
    if (mf != 2.0) { return 11; }
    if (mj != 8)   { return 12; }

    return 0;
}
