// test_buf_find.bpp — correctness gate for buf_find_byte (SIMD memchr).
//
// Exercises the 16-byte SIMD region, the group boundaries (lanes 0 and 15,
// first lane of the next group), a deep mid-buffer hit, the scalar tail
// (len not a multiple of 16), first-of-many, a short sub-16 buffer (pure
// scalar path), out-of-range, and len 0. Asserts the EXACT index; exits 0
// when all pass, 1 on the first wrong value. Runs on every backend.

import "bpp_buf.bsm";
import "bpp_io.bsm";

static fail(msg, got, want) {
    putstr(msg); putstr(" got="); putnum(got); putstr(" want="); putnum(want); putchar(10);
    return 1;
}

main() {
    auto buf, i, r;
    buf = malloc(100);
    for (i = 0; i < 100; i++) { poke(buf + i, 0x2E); }   // fill with '.'

    r = buf_find_byte(buf, 100, 0x21);                   // absent everywhere
    if (r != 0 - 1) { return fail("C1 absent", r, 0 - 1); }

    poke(buf + 0, 0x21);                                 // first SIMD lane
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 0) { return fail("C2 at-0", r, 0); }
    poke(buf + 0, 0x2E);

    poke(buf + 15, 0x21);                                // last lane of group 0
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 15) { return fail("C3 at-15", r, 15); }
    poke(buf + 15, 0x2E);

    poke(buf + 16, 0x21);                                // first lane of group 1
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 16) { return fail("C4 at-16", r, 16); }
    poke(buf + 16, 0x2E);

    poke(buf + 50, 0x21);                                // deep mid-buffer
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 50) { return fail("C5 at-50", r, 50); }
    poke(buf + 50, 0x2E);

    poke(buf + 99, 0x21);                                // last byte (scalar tail)
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 99) { return fail("C6 at-99-tail", r, 99); }
    poke(buf + 99, 0x2E);

    poke(buf + 30, 0x21); poke(buf + 60, 0x21);          // first of many
    r = buf_find_byte(buf, 100, 0x21);
    if (r != 30) { return fail("C7 first-of-many", r, 30); }
    poke(buf + 30, 0x2E); poke(buf + 60, 0x2E);

    poke(buf + 5, 0x21);                                 // short buffer (< 16)
    r = buf_find_byte(buf, 10, 0x21);
    if (r != 5) { return fail("C8 short-buf", r, 5); }
    r = buf_find_byte(buf, 3, 0x21);                     // hit is outside len
    if (r != 0 - 1) { return fail("C9 short-absent", r, 0 - 1); }
    poke(buf + 5, 0x2E);

    r = buf_find_byte(buf, 0, 0x2E);                     // len 0
    if (r != 0 - 1) { return fail("C10 len-0", r, 0 - 1); }

    putmsg("OK: buf_find_byte correct across SIMD region, boundaries, scalar tail, short + empty");
    free(buf);
    return 0;
}
