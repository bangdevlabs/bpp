// xfail: E271
// test_e271_static_global_collision.bpp — a `static` global must not silently
// alias a same-named global in another module. Same-named globals share one
// data slot today (dedup by name), so `static` cannot keep this one private;
// the compiler rejects the collision instead of aliasing (the 2026-07-07
// storage cleanup — the class of bug that hid cross-target constant collisions
// before). Two modules, same static name: the second file is imported so both
// land in one program.
import "test_e271_helper.bsm";

static auto _shared_scratch;

main() {
    _shared_scratch = 1;
    return e271_touch();
}
