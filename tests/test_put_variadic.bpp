// test_put_variadic.bpp — variadic put / put_err (parser-only smart-dispatch
// concat). A `put(a, b, c, ...)` statement prints each argument in order, each
// routed through the existing per-type dispatch (string -> putstr, word ->
// putnum, float -> putfloat). No format string, no separator, no auto-newline.
// Single-arg put(x) is unchanged.
//
// The suite gates a clean exit; a .sh wrapper locking exact stdout is the P0
// follow-up. (Word args trip the existing per-arg W032 — expected.)

power_label(base, n) {
    // A warning-free variadic line: string literals + a returned word.
    put("power(", base, ", ", n, ")\n");
    return 0;
}

main() {
    auto n, a, b;
    auto f: float;
    n = 7;
    a = 1;
    b = 2;
    f = 3.5;

    put("single\n");                          // 1 arg — unchanged
    put("count: ", n, "\n");                  // str + word + str
    put(a, b, "\n");                          // word + word + str
    put("a=", a, " b=", b, " f=", f, "\n");   // mixed, many args
    power_label(2, 8);                        // variadic inside another fn
    put_err("err[", n, "]\n");                // stderr mirror

    putstr("done\n");
}
