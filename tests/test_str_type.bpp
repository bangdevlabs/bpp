// test_str_type.bpp — T2 inc 2: the TY_STR / TY_PTR split (increments A-C).
//
// `: str` is a pointer whose bytes are a NUL-terminated C string —
// TY_PTR plus a meaning flag (bit 8), so every mechanical path (slot
// width, arithmetic, is_ptr_type, promote's stickiness) rides the ptr
// machinery unchanged and ONLY smart dispatch reads the flag. The
// utopian rule this pins: str-ness enters ONCE at a producer's
// signature (`str_dup -> str`) or a literal, and FLOWS — bare locals
// never annotate. The purity guard keeps `s = 0;` (the universal
// release idiom) from turning a compiler-written hint into an E053.

main() {
    // ── literal through a bare local ──────────────────────────────────
    auto s;
    s = "forty two";
    if (str_len(s) != 9)              { putmsg("FAIL: literal via bare local"); return 1; }

    // ── producer flow: str_dup -> str -> bare local ───────────────────
    auto d;
    d = str_dup("hello dup");
    if (str_eq(d, "hello dup") == 0)  { putmsg("FAIL: str_dup flow");           return 2; }

    // ── stickiness: s + k is still a string (promote keeps the flag) ──
    auto tail;
    tail = d + 6;
    if (str_eq(tail, "dup") == 0)     { putmsg("FAIL: str arithmetic");         return 3; }

    // ── purity guard: the release idiom must stay legal ───────────────
    auto m;
    m = str_dup("temp");
    free(m);
    m = 0;                             // word store — m must NOT be str-hinted
    if (m != 0)                        { putmsg("FAIL: release idiom");         return 4; }

    // ── explicit `: str` annotation parses and behaves ────────────────
    auto e: str;
    e = "explicit";
    if (str_len(e) != 8)              { putmsg("FAIL: explicit : str");         return 5; }

    // ── path_asset -> str compiles as consumer contract ───────────────
    // (behavioral use lives in the tools; here the annotation parsing +
    // assignment compatibility is the pin.)
    free(d);
    putmsg("PASS: str type flows from literals and producers; ptr stays opaque");
    return 0;
}
